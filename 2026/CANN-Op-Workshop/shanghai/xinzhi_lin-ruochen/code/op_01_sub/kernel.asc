#include <cstdint>
#include "kernel_operator.h"

// Included by the test harness, which defines TensorInfo / TensorGroupInfo.
// dtype: 0 = float32, 1 = float16. Inputs and output are contiguous ND tensors.
struct SubCustomTilingData {
    uint32_t totalLength;
    uint32_t blockLength;
    uint32_t tileLength;
    int32_t dtype;
};

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                const SubCustomTilingData& tiling)
    {
        const uint32_t blockOffset = AscendC::GetBlockIdx() * tiling.blockLength;
        const uint32_t remaining = tiling.totalLength - blockOffset;
        blockLength_ = remaining < tiling.blockLength ? remaining : tiling.blockLength;
        tileLength_ = tiling.tileLength;

        xGm_.SetGlobalBuffer((__gm__ T*)x + blockOffset, blockLength_);
        yGm_.SetGlobalBuffer((__gm__ T*)y + blockOffset, blockLength_);
        zGm_.SetGlobalBuffer((__gm__ T*)z + blockOffset, blockLength_);

        pipe_.InitBuffer(inQueueX_, BUFFER_NUM, tileLength_ * sizeof(T));
        pipe_.InitBuffer(inQueueY_, BUFFER_NUM, tileLength_ * sizeof(T));
        pipe_.InitBuffer(outQueueZ_, BUFFER_NUM, tileLength_ * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        uint32_t offset = 0;
        while (offset < blockLength_) {
            const uint32_t remaining = blockLength_ - offset;
            const uint32_t count = remaining < tileLength_ ? remaining : tileLength_;
            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
            offset += count;
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX_.template AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY_.template AllocTensor<T>();

        if (count % ALIGN_NUM == 0) {
            AscendC::DataCopy(xLocal, xGm_[offset], count);
            AscendC::DataCopy(yLocal, yGm_[offset], count);
        } else {
            // DataCopy rounds down to 32 bytes. Use exact byte counts for a tail.
            const AscendC::DataCopyExtParams copyParams{
                1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
            const AscendC::DataCopyPadExtParams<T> padParams{
                true, 0, static_cast<uint8_t>(ALIGN_NUM - count % ALIGN_NUM),
                static_cast<T>(0)};
            AscendC::DataCopyPad(xLocal, xGm_[offset], copyParams, padParams);
            AscendC::DataCopyPad(yLocal, yGm_[offset], copyParams, padParams);
        }

        inQueueX_.template EnQue<T>(xLocal);
        inQueueY_.template EnQue<T>(yLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX_.template DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY_.template DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ_.template AllocTensor<T>();

        AscendC::Sub(zLocal, xLocal, yLocal, static_cast<int32_t>(count));

        outQueueZ_.template EnQue<T>(zLocal);
        inQueueX_.FreeTensor(xLocal);
        inQueueY_.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ_.template DeQue<T>();

        if (count % ALIGN_NUM == 0) {
            AscendC::DataCopy(zGm_[offset], zLocal, count);
        } else {
            const AscendC::DataCopyExtParams copyParams{
                1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
            AscendC::DataCopyPad(zGm_[offset], zLocal, copyParams);
        }

        outQueueZ_.FreeTensor(zLocal);
    }

    static constexpr int32_t BUFFER_NUM = 2;
    static constexpr uint32_t ALIGN_NUM = 32 / sizeof(T);
    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inQueueX_;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inQueueY_;
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_NUM> outQueueZ_;
    AscendC::GlobalTensor<T> xGm_, yGm_, zGm_;
    uint32_t blockLength_ = 0;
    uint32_t tileLength_ = 0;
};

__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                      SubCustomTilingData tiling)
{
    if (tiling.dtype == 0) {
        KernelSub<float> op;
        op.Init(x, y, z, tiling);
        op.Process();
    } else if (tiling.dtype == 1) {
        KernelSub<half> op;
        op.Init(x, y, z, tiling);
        op.Process();
    }
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    if (info_x.numTensors != 1 || info_y.numTensors != 1 || info_z.numTensors != 1 ||
        info_x.tensors == nullptr || info_y.tensors == nullptr || info_z.tensors == nullptr) {
        return;
    }

    const TensorInfo& tx = info_x.tensors[0];
    const TensorInfo& ty = info_y.tensors[0];
    const TensorInfo& tz = info_z.tensors[0];
    if ((tx.dtype != 0 && tx.dtype != 1) || ty.dtype != tx.dtype || tz.dtype != tx.dtype ||
        tx.numDims < 0 || ty.numDims != tx.numDims || tz.numDims != tx.numDims) {
        return;
    }
    if (tx.numDims > 0 && (tx.shape == nullptr || ty.shape == nullptr || tz.shape == nullptr)) {
        return;
    }

    uint64_t totalLength = 1;
    for (int64_t dim = 0; dim < tx.numDims; ++dim) {
        if (tx.shape[dim] <= 0 || tx.shape[dim] != ty.shape[dim] ||
            tx.shape[dim] != tz.shape[dim]) {
            return;
        }
        const uint64_t dimLength = static_cast<uint64_t>(tx.shape[dim]);
        if (totalLength > static_cast<uint64_t>(UINT32_MAX) / dimLength) {
            return;
        }
        totalLength *= dimLength;
    }
    if (x == nullptr || y == nullptr || z == nullptr) {
        return;
    }

    // Assign contiguous, 32-byte-aligned ranges to the available vector cores.
    const uint64_t alignNum = tx.dtype == 0 ? 8 : 16;
    const uint64_t alignedBlocks = (totalLength + alignNum - 1) / alignNum;
    uint64_t blockNum = availableCoreNum > 0 ? static_cast<uint64_t>(availableCoreNum) : 1;
    blockNum = blockNum < alignedBlocks ? blockNum : alignedBlocks;
    const uint64_t blocksPerCore = (alignedBlocks + blockNum - 1) / blockNum;
    uint64_t blockLength = blocksPerCore * alignNum;
    blockLength = blockLength < totalLength ? blockLength : totalLength;
    blockNum = (totalLength + blockLength - 1) / blockLength;

    SubCustomTilingData tiling{};
    tiling.totalLength = static_cast<uint32_t>(totalLength);
    tiling.blockLength = static_cast<uint32_t>(blockLength);
    // Three queues x two buffers x 1024 x sizeof(float) = 24 KiB of UB.
    tiling.tileLength = 1024;
    tiling.dtype = tx.dtype;

    sub_custom<<<static_cast<uint32_t>(blockNum), nullptr, stream>>>(x, y, z, tiling);
}
