#include <cmath>
#include "kernel_operator.h"

struct SubCustomTilingData {
    uint32_t totalLength;
    uint32_t tileNum;
};

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        const SubCustomTilingData& tiling)
    {
        blockLength = tiling.totalLength / AscendC::GetBlockNum();

        uint32_t offset =
            blockLength * AscendC::GetBlockIdx();

        xGm.SetGlobalBuffer(
            (__gm__ T*)x + offset,
            blockLength);

        yGm.SetGlobalBuffer(
            (__gm__ T*)y + offset,
            blockLength);

        zGm.SetGlobalBuffer(
            (__gm__ T*)z + offset,
            blockLength);
    }

    __aicore__ inline void Process()
    {
        uint32_t xAddr = 0;
        uint32_t yAddr =
            blockLength * sizeof(T);
        uint32_t zAddr =
            blockLength * sizeof(T) * 2;

        AscendC::LocalTensor<T> xLocal(
            AscendC::TPosition::VECIN,
            xAddr,
            blockLength);

        AscendC::LocalTensor<T> yLocal(
            AscendC::TPosition::VECIN,
            yAddr,
            blockLength);

        AscendC::LocalTensor<T> zLocal(
            AscendC::TPosition::VECOUT,
            zAddr,
            blockLength);

        AscendC::DataCopy(
            xLocal,
            xGm,
            blockLength);

        AscendC::DataCopy(
            yLocal,
            yGm,
            blockLength);

        AscendC::SetFlag<
            AscendC::HardEvent::MTE2_V>(0);

        AscendC::WaitFlag<
            AscendC::HardEvent::MTE2_V>(0);

        AscendC::Sub(
            zLocal,
            xLocal,
            yLocal,
            blockLength);

        AscendC::SetFlag<
            AscendC::HardEvent::V_MTE3>(0);

        AscendC::WaitFlag<
            AscendC::HardEvent::V_MTE3>(0);

        AscendC::DataCopy(
            zGm,
            zLocal,
            blockLength);
    }

private:
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    uint32_t blockLength;
};

template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    AscendC::InitSocState();

    KernelSub<T> op;

    op.Init(
        x,
        y,
        z,
        tiling);

    op.Process();
}

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    constexpr uint32_t blockDim = 8;

    const TensorInfo& t0 =
        info_x.tensors[0];

    int64_t totalLength = 1;

    for (int64_t i = 0;
         i < t0.numDims;
         i++) {
        totalLength *= t0.shape[i];
    }

    SubCustomTilingData tiling = {
        static_cast<uint32_t>(totalLength),
        1
    };

    if (t0.dtype == 1) {
        sub_custom<half>
            <<<blockDim, nullptr, stream>>>(
                x,
                y,
                z,
                tiling);
    } else {
        sub_custom<float>
            <<<blockDim, nullptr, stream>>>(
                x,
                y,
                z,
                tiling);
    }
}