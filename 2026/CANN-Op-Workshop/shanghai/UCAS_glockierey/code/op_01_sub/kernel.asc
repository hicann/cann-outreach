#include <cmath>
#include "kernel_operator.h"

// ---------------------------------------------------------------------------
// Tiling 参数：由 host 侧 run_kernel 计算后按值传给核函数
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint32_t totalLength; // 待处理数据总长度（单位：元素个数），例如 8 * 2048
    uint32_t tileNum;     // 单核内将数据进一步切分为多少块（Tile），例如 8
};

constexpr uint32_t BUFFER_NUM = 2;
constexpr uint32_t QUEUE_DEPTH = 1;

// ---------------------------------------------------------------------------
// KernelSub：z = x - y
// 每核按 tileNum × BUFFER_NUM 分块循环计算
// 模板化，支持 float / half 等类型
// ---------------------------------------------------------------------------
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        const SubCustomTilingData& tiling)
    {
        uint32_t totalLength = tiling.totalLength;
        uint32_t tileNum = tiling.tileNum;

        // 每个核处理的数据长度
        this->blockLength =
            totalLength / AscendC::GetBlockNum();

        // 单核内分块数
        this->tileNum = tileNum;

        // 每次处理的数据长度
        this->tileLength =
            this->blockLength / tileNum / BUFFER_NUM;

        // -------------------------------------------------------------------
        // 根据 blockIdx 给每个核分配自己的 Global Memory 区间
        // -------------------------------------------------------------------
        xGm.SetGlobalBuffer(
            (__gm__ T *)x
                + this->blockLength * AscendC::GetBlockIdx(),
            this->blockLength);

        yGm.SetGlobalBuffer(
            (__gm__ T *)y
                + this->blockLength * AscendC::GetBlockIdx(),
            this->blockLength);

        zGm.SetGlobalBuffer(
            (__gm__ T *)z
                + this->blockLength * AscendC::GetBlockIdx(),
            this->blockLength);

        // -------------------------------------------------------------------
        // 给输入输出队列分配 UB Buffer
        // -------------------------------------------------------------------
        pipe.InitBuffer(
            inQueueX,
            BUFFER_NUM,
            this->tileLength * sizeof(T));

        pipe.InitBuffer(
            inQueueY,
            BUFFER_NUM,
            this->tileLength * sizeof(T));

        pipe.InitBuffer(
            outQueueZ,
            BUFFER_NUM,
            this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // tileLength 已经除以 BUFFER_NUM
        // 因此总循环数为 tileNum * BUFFER_NUM
        int32_t loopCount =
            this->tileNum * BUFFER_NUM;

        for (int32_t i = 0; i < loopCount; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:

    // -----------------------------------------------------------------------
    // GM -> UB
    // -----------------------------------------------------------------------
    __aicore__ inline void CopyIn(int32_t progress)
    {
        AscendC::LocalTensor<T> xLocal =
            inQueueX.AllocTensor<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.AllocTensor<T>();

        AscendC::DataCopy(
            xLocal,
            xGm[progress * this->tileLength],
            this->tileLength);

        AscendC::DataCopy(
            yLocal,
            yGm[progress * this->tileLength],
            this->tileLength);

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    // -----------------------------------------------------------------------
    // Vector Compute：z = x - y
    // -----------------------------------------------------------------------
    __aicore__ inline void Compute(int32_t progress)
    {
        AscendC::LocalTensor<T> xLocal =
            inQueueX.DeQue<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.DeQue<T>();

        AscendC::LocalTensor<T> zLocal =
            outQueueZ.AllocTensor<T>();

        // ================================================================
        // 与 Add 版本唯一真正涉及数学计算的区别
        //
        // Add:
        // AscendC::Add(zLocal, xLocal, yLocal, this->tileLength);
        //
        // Sub:
        // ================================================================
        AscendC::Sub(
            zLocal,
            xLocal,
            yLocal,
            this->tileLength);

        outQueueZ.EnQue<T>(zLocal);

        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    // -----------------------------------------------------------------------
    // UB -> GM
    // -----------------------------------------------------------------------
    __aicore__ inline void CopyOut(int32_t progress)
    {
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.DeQue<T>();

        AscendC::DataCopy(
            zGm[progress * this->tileLength],
            zLocal,
            this->tileLength);

        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;

    AscendC::TQue<
        AscendC::QuePosition::VECIN,
        QUEUE_DEPTH> inQueueX, inQueueY;

    AscendC::TQue<
        AscendC::QuePosition::VECOUT,
        QUEUE_DEPTH> outQueueZ;

    AscendC::GlobalTensor<T> xGm, yGm, zGm;

    uint32_t blockLength;
    uint32_t tileNum;
    uint32_t tileLength;
};

// ---------------------------------------------------------------------------
// Kernel 入口
// ---------------------------------------------------------------------------
template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    KernelSub<T> op;

    op.Init(x, y, z, tiling);

    op.Process();
}

// ---------------------------------------------------------------------------
// Host 侧启动函数
// ---------------------------------------------------------------------------
extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    constexpr uint32_t blockDim = 8;

    // -----------------------------------------------------------------------
    // 1. 获取 Tensor 总元素数量
    // -----------------------------------------------------------------------
    const TensorInfo& t0 = info_x.tensors[0];

    int64_t totalLength = 1;

    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }

    // -----------------------------------------------------------------------
    // 2. 获取 dtype
    //
    // 0 = fp32
    // 1 = fp16
    // 2 = bf16 ...
    // -----------------------------------------------------------------------
    int32_t dtype = t0.dtype;

    // 每核划分 8 个 tile
    uint32_t tileNum = 8;

    SubCustomTilingData tiling = {
        (uint32_t)totalLength,
        tileNum
    };

    // -----------------------------------------------------------------------
    // 3. 根据 dtype 选择模板实例
    // -----------------------------------------------------------------------
    if (dtype == 1) {

        // FP16
        sub_custom<half><<<blockDim, nullptr, stream>>>(x,y,z,tiling);

    } else {

        // FP32
        sub_custom<float><<<blockDim, nullptr, stream>>>(x,y,z,tiling);
    }
}