#include <cmath>
#include "kernel_operator.h"

using namespace AscendC;

// ============================================================================
// Tiling 参数结构体：由 host 侧 run_kernel 计算后按值传给核函数
// ============================================================================
struct SubCustomTilingData {
    uint32_t totalLength;   // 待处理数据总长度（元素个数），例如 8 * 2048
    uint32_t tileNum;       // 单核内将数据进一步切分为多少块（Tile）
};

constexpr uint32_t BUFFER_NUM = 2;    // 每队列 buffer 块数（Double Buffer）
constexpr uint32_t QUEUE_DEPTH = 1;   // 队列深度

// ============================================================================
// KernelSub：z = x - y，每核按 tileNum × BUFFER_NUM 分块循环计算
// 模板化，支持 float / half 等类型
// ============================================================================
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                const SubCustomTilingData& tiling) {
        uint32_t totalLength = tiling.totalLength;
        uint32_t tileNum = tiling.tileNum;

        // 每个核处理的数据长度（多核并行）
        this->blockLength = totalLength / AscendC::GetBlockNum();
        // 单核内分块数
        this->tileNum = tileNum;
        // 单次处理的元素数（每块长度），已按 BUFFER_NUM 折半
        this->tileLength = this->blockLength / tileNum / BUFFER_NUM;

        // 设置每个核的 Global Memory 起始地址（多核切分）
        xGm.SetGlobalBuffer((__gm__ T*)x + this->blockLength * AscendC::GetBlockIdx(),
                            this->blockLength);
        yGm.SetGlobalBuffer((__gm__ T*)y + this->blockLength * AscendC::GetBlockIdx(),
                            this->blockLength);
        zGm.SetGlobalBuffer((__gm__ T*)z + this->blockLength * AscendC::GetBlockIdx(),
                            this->blockLength);

        // 为队列分配 UB 内存
        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process() {
        // 循环次数 = tileNum × BUFFER_NUM
        int32_t loopCount = this->tileNum * BUFFER_NUM;
        for (int32_t i = 0; i < loopCount; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress) {
        // 分配 LocalTensor 内存
        LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();

        // 从 Global Memory 搬入数据到 Local Memory
        DataCopy(xLocal, xGm[progress * this->tileLength], this->tileLength);
        DataCopy(yLocal, yGm[progress * this->tileLength], this->tileLength);

        // 将数据放入队列
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(int32_t progress) {
        // 从输入队列取出数据
        LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        LocalTensor<T> yLocal = inQueueY.DeQue<T>();

        // 分配输出 LocalTensor
        LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();

        // 向量减法：z = x - y
        Sub(zLocal, xLocal, yLocal, this->tileLength);

        // 将结果放入输出队列
        outQueueZ.EnQue(zLocal);

        // 释放输入队列资源
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int32_t progress) {
        // 从输出队列取出数据
        LocalTensor<T> zLocal = outQueueZ.DeQue<T>();

        // 将结果从 Local Memory 搬回 Global Memory
        DataCopy(zGm[progress * this->tileLength], zLocal, this->tileLength);

        // 释放输出队列资源
        outQueueZ.FreeTensor(zLocal);
    }

private:
    TPipe pipe;
    TQue<QuePosition::VECIN, QUEUE_DEPTH> inQueueX;
    TQue<QuePosition::VECIN, QUEUE_DEPTH> inQueueY;
    TQue<QuePosition::VECOUT, QUEUE_DEPTH> outQueueZ;

    GlobalTensor<T> xGm;
    GlobalTensor<T> yGm;
    GlobalTensor<T> zGm;

    uint32_t blockLength;
    uint32_t tileNum;
    uint32_t tileLength;
};

// ============================================================================
// 核函数入口：实例化 KernelSub 并执行
// T 由 run_kernel 按输入 dtype 选择
// ============================================================================
template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                      SubCustomTilingData tiling) {
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

// ============================================================================
// Host 侧启动函数：从 TensorGroupInfo 推导 tiling 并启动核函数
// ============================================================================
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream) {
    constexpr uint32_t blockDim = 8;  // 固定 8 核

    // 1. 取总元素数（x/y/z 形状一致）
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }

    // 2. 构建 Tiling 参数
    SubCustomTilingData tiling;
    tiling.totalLength = static_cast<uint32_t>(totalLength);
    // tileNum 设置为 8（参考官方模板），实际可按需调整
    tiling.tileNum = 8;

    // 3. 按输入 dtype 选择核函数实例
    // dtype: 0=fp32, 1=fp16, 2=bf16, 3=int8, 4=int16, 5=int32, 6=int64
    int32_t dtype = t0.dtype;

    if (dtype == 0) {       // float32
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else if (dtype == 1) { // float16
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        // 其他数据类型可根据需要扩展
        // 默认按 float32 处理（或报错）
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}