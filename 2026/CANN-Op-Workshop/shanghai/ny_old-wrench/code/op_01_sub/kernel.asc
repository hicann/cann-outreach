#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel (Optimized) — Ascend C Direct Invocation
 * z = x - y   逐元素矢量减法
 *
 * 相比初版的优化：
 *   1. 吃满 availableCoreNum（初版写死 blockDim=8，其余 AI Core 闲置）
 *   2. 大块搬运：tileLength 按 UB 容量取最大值，取代固定 tileNum=8 造成的 16 个碎块
 *   3. 软件流水：CopyIn(i+1) 提前发射，与 Compute(i)/CopyOut(i) 重叠（MTE2↔VECTOR↔MTE3）
 *   4. Tiling 全部 host 侧算好，核内不做整数除法
 *   5. 空闲核直接 return，不分配 UB、不进循环
 *   6. 支持任意长度：非 32B 对齐的尾部用"末窗口重算"兜底，不触发非对齐 DMA
 *   7. 修正初版 dtype==1 却实例化 float 的问题
 *
 * 注意：该文件被 #include，不要加 main() / #pragma once / include guard
 */

// ===================== 可调参数（按芯片调整） =====================
constexpr uint32_t BUFFER_NUM  = 2;   // Double Buffer 深度
constexpr uint32_t QUEUE_DEPTH = 1;

// 单核 UB 预算：910 系列约 192KB，取 7/8 留余量给栈等；
// 3 个队列 × BUFFER_NUM 份 buffer 平分，再向下对齐到 32B。若编译报 UB 溢出，把 192 调小即可。
constexpr uint32_t UB_BYTES_PER_CORE = 192 * 1024;
constexpr uint32_t UB_TILE_BYTES     = ((UB_BYTES_PER_CORE * 7 / 8) / (3 * BUFFER_NUM)) & ~31U;

// ===================== Tiling =====================
struct SubCustomTilingData {
    uint32_t totalLength;  // 参与计算的总元素数
    uint32_t blockLength;  // 每个 AI Core 的基准长度
    uint32_t tileLength;   // 每个数据块长度（32B 对齐，受 UB 限制）
    uint32_t tileNum;      // 基准核的块数（核内还会按实际长度重算）
};

// ===================== Kernel 类 =====================
template <typename T>
class KernelSub {
public:
    // 一次 DataCopy 的字节数必须是 32B 整数倍 → 元素数按 32/sizeof(T) 对齐
    static constexpr uint32_t ALIGN_ELEM = 32U / sizeof(T);

    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling)
    {
        uint32_t blockIdx = AscendC::GetBlockIdx();
        uint64_t gmOffset = static_cast<uint64_t>(blockIdx) * tiling.blockLength;

        // 分不到数据的核直接退出：不分配 UB，也不进流水
        if (gmOffset >= static_cast<uint64_t>(tiling.totalLength)) {
            this->coreLength = 0;
            return;
        }
        uint32_t remain = static_cast<uint32_t>(static_cast<uint64_t>(tiling.totalLength) - gmOffset);
        uint32_t blockLen = tiling.blockLength;
        this->coreLength = (remain < blockLen) ? remain : blockLen;

        // host 侧已保证每个活跃核 ≥ ALIGN_ELEM 个元素
        ASSERT(this->coreLength >= ALIGN_ELEM && "per-core length must be 32B aligned at least");

        // GM 地址按本核偏移，后续全部使用核内相对下标
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x) + gmOffset, this->coreLength);
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y) + gmOffset, this->coreLength);
        zGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z) + gmOffset, this->coreLength);

        // 主循环只处理 32B 对齐的部分；不足一个 ALIGN 的尾巴走"末窗口重算"
        uint32_t alignedLen = this->coreLength - (this->coreLength % ALIGN_ELEM);
        uint32_t tailLen    = this->coreLength - alignedLen;

        // 块长：受 UB 限制，同时不超过本核实际数据量（省 UB）
        uint32_t tile = tiling.tileLength;
        if (alignedLen > 0 && tile > alignedLen) {
            tile = alignedLen;                       // alignedLen 本身已 32B 对齐
        }
        if (tile < ALIGN_ELEM) {
            tile = ALIGN_ELEM;                       // 至少装得下尾部窗口
        }
        this->tileLength = tile;
        this->tileNum    = (tile == 0) ? 0 : (alignedLen + tile - 1) / tile;
        this->totalTiles = this->tileNum + ((tailLen > 0) ? 1u : 0u);
        // 末块长度：有尾巴时末块固定是一个 ALIGN 窗口
        this->lastTileLen = (tailLen > 0) ? ALIGN_ELEM
                                          : (alignedLen - (this->tileNum - 1) * tile);

        pipe.InitBuffer(inQueueX,  BUFFER_NUM, tile * sizeof(T));
        pipe.InitBuffer(inQueueY,  BUFFER_NUM, tile * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, tile * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        if (this->coreLength == 0) {
            return;
        }
        uint32_t tiles = this->totalTiles;
        if (tiles == 0) {
            return;
        }

        // ---------- prologue：先把第 0 块的 MTE2 打出去 ----------
        CopyIn(0, TileLen(0));

        // ---------- steady：下一块的搬入 与 当前块的计算/搬出 重叠 ----------
        for (uint32_t i = 0; i + 1 < tiles; ++i) {
            CopyIn(i + 1, TileLen(i + 1));   // 提前发射 MTE2
            Compute(i,    TileLen(i));       // Vector 计算
            CopyOut(i,    TileLen(i));       // 发射 MTE3
        }

        // ---------- epilogue：收尾最后一块 ----------
        Compute(tiles - 1, TileLen(tiles - 1));
        CopyOut(tiles - 1, TileLen(tiles - 1));
    }

private:
    // 块起始偏移：末块（尾部窗口）从"本核末尾往前推一个 ALIGN"开始，
    // 会与上一块重叠 ALIGN-tailLen 个元素，重算写回的是相同结果，无副作用。
    __aicore__ inline uint32_t TileOffset(uint32_t i) const
    {
        return (i < this->tileNum) ? (i * this->tileLength)
                                   : (this->coreLength - ALIGN_ELEM);
    }

    __aicore__ inline uint32_t TileLen(uint32_t i) const
    {
        return (i + 1 == this->totalTiles) ? this->lastTileLen : this->tileLength;
    }

    __aicore__ inline void CopyIn(uint32_t idx, uint32_t len)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();

        uint32_t offset = TileOffset(idx);
        AscendC::DataCopy(xLocal, xGm[offset], len);
        AscendC::DataCopy(yLocal, yGm[offset], len);

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t idx, uint32_t len)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();

        AscendC::Sub(zLocal, xLocal, yLocal, len);   // z = x - y

        outQueueZ.EnQue<T>(zLocal);

        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t idx, uint32_t len)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();

        uint32_t offset = TileOffset(idx);
        AscendC::DataCopy(zGm[offset], zLocal, len);

        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN,  BUFFER_NUM, QUEUE_DEPTH> inQueueX;
    AscendC::TQue<AscendC::TPosition::VECIN,  BUFFER_NUM, QUEUE_DEPTH> inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_NUM, QUEUE_DEPTH> outQueueZ;

    AscendC::GlobalTensor<T> xGm;  // 输入 x（本核视口）
    AscendC::GlobalTensor<T> yGm;  // 输入 y（本核视口）
    AscendC::GlobalTensor<T> zGm;  // 输出 z（本核视口）

    uint32_t coreLength;   // 本核实际元素数
    uint32_t tileLength;   // 每块长度
    uint32_t tileNum;      // 对齐部分的块数
    uint32_t totalTiles;   // 含尾部窗口的总块数
    uint32_t lastTileLen;  // 末块长度
};

// ===================== 核函数入口 =====================
template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

// ===================== Host 侧启动 =====================
template <typename T>
static inline void LaunchSub(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                             int64_t totalLength, int64_t availableCoreNum, aclrtStream stream)
{
    constexpr uint32_t ALIGN = 32U / sizeof(T);   // fp32 → 8, fp16 → 16
    if (totalLength <= 0) {
        return;
    }
    ASSERT(totalLength >= static_cast<int64_t>(ALIGN) && "totalLength too small");

    // 1) 单块最大元素数：受 UB 限制，并按 ALIGN 向下对齐
    uint32_t maxTile = (UB_TILE_BYTES / sizeof(T)) / ALIGN * ALIGN;
    if (maxTile < ALIGN) {
        maxTile = ALIGN;
    }

    // 2) 核数：吃满可用核，但保证每个核至少分到一个 ALIGN 窗口
    uint32_t blockDim = (availableCoreNum > 0) ? static_cast<uint32_t>(availableCoreNum) : 8U;
    uint32_t maxBlocks = static_cast<uint32_t>(totalLength / ALIGN);
    if (maxBlocks == 0) {
        maxBlocks = 1;
    }
    if (blockDim > maxBlocks) {
        blockDim = maxBlocks;
    }

    // 3) 每核长度：收敛到"最后一个核也拿得到 ≥ ALIGN 个元素"
    uint32_t blockLength = 0;
    while (true) {
        blockLength = static_cast<uint32_t>((totalLength + blockDim - 1) / blockDim);
        uint32_t lastLen = static_cast<uint32_t>(totalLength - static_cast<int64_t>(blockDim - 1) * blockLength);
        if (lastLen >= ALIGN || blockDim == 1) {
            break;
        }
        --blockDim;    // 末核数据太少，减一个核再算
    }

    // 4) 块长与块数：不超 UB、不超过单核数据量
    uint32_t tileLength = (maxTile < blockLength) ? maxTile : (blockLength / ALIGN * ALIGN);
    if (tileLength < ALIGN) {
        tileLength = ALIGN;
    }
    uint32_t tileNum = (blockLength + tileLength - 1) / tileLength;

    // 5) 组装 tiling 并启动（所有除法都在 host 侧完成）
    SubCustomTilingData tiling = {
        static_cast<uint32_t>(totalLength), blockLength, tileLength, tileNum
    };
    sub_custom<T><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    // 1. 取总元素数（x / y / z 形状一致）
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }

    // 2. 按 dtype 选择实例（0=fp32 1=fp16 2=bf16 ...）
    int32_t dtype = t0.dtype;
    if (dtype == 1) {
        LaunchSub<half>(x, y, z, totalLength, availableCoreNum, stream);   // fp16
    } else {
        LaunchSub<float>(x, y, z, totalLength, availableCoreNum, stream);  // fp32 及默认
    }
}