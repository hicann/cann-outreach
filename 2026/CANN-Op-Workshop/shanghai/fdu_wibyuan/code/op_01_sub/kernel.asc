#include <cmath>
#include "kernel_operator.h"

using namespace AscendC;

// 单核每次处理的 buffer 大小（按 32 字节对齐，此处取 2048 个 float = 8KB）
constexpr int32_t BUFFER_NUM = 2; // 双 buffer 乒乓机制

class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum, uint32_t tileSize) {
        this->totalLength = totalLength;
        this->tileNum = tileNum;
        this->tileSize = tileSize;

        // 根据当前核的 Block 索引计算当前核要处理的数据偏移与长度
        uint32_t coreOffset = GetBlockIdx() * (totalLength / GetBlockNum());
        
        xGm.SetGlobalBuffer((__gm__ float*)x + coreOffset, tileSize * tileNum);
        yGm.SetGlobalBuffer((__gm__ float*)y + coreOffset, tileSize * tileNum);
        zGm.SetGlobalBuffer((__gm__ float*)z + coreOffset, tileSize * tileNum);

        // 初始化队列
        pipe.InitBuffer(inQueueX, BUFFER_NUM, tileSize * sizeof(float));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, tileSize * sizeof(float));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, tileSize * sizeof(float));
    }

    __aicore__ inline void Process() {
        for (int32_t i = 0; i < tileNum; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress) {
        LocalTensor<float> xLocal = inQueueX.AllocTensor<float>();
        LocalTensor<float> yLocal = inQueueY.AllocTensor<float>();
        
        DataCopy(xLocal, xGm[progress * tileSize], tileSize);
        DataCopy(yLocal, yGm[progress * tileSize], tileSize);
        
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(int32_t progress) {
        LocalTensor<float> xLocal = inQueueX.DeQue<float>();
        LocalTensor<float> yLocal = inQueueY.DeQue<float>();
        LocalTensor<float> zLocal = outQueueZ.AllocTensor<float>();

        // 矢量逐元素减法: z = x - y
        Sub(zLocal, xLocal, yLocal, tileSize);

        outQueueZ.EnQue<float>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int32_t progress) {
        LocalTensor<float> zLocal = outQueueZ.DeQue<float>();
        DataCopy(zGm[progress * tileSize], zLocal, tileSize);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    TPipe pipe;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueX, inQueueY;
    TQue<QuePosition::VECOUT, BUFFER_NUM> outQueueZ;
    GlobalTensor<float> xGm, yGm, zGm;

    uint32_t totalLength;
    uint32_t tileNum;
    uint32_t tileSize;
};

// 1. 核函数定义
extern "C" __global__ __aicore__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum, uint32_t tileSize)
{
    KernelSub op;
    op.Init(x, y, z, totalLength, tileNum, tileSize);
    op.Process();
}

// 2. 算子发射函数定义
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    // 计算元素总数：8 * 2048 = 16384
    int64_t totalLength = 1;
    for (int64_t i = 0; i < info_x.tensors[0].numDims; ++i) {
        totalLength *= info_x.tensors[0].shape[i];
    }

    // 简单分块策略（Tiling）:
    // 测试数据 16384 个元素，分配到 8 个 Block/Core 上处理，每个核处理 2048 个 float
    uint32_t blockDim = 8;
    if (availableCoreNum < 8) {
        blockDim = availableCoreNum;
    }

    uint32_t lengthPerCore = totalLength / blockDim;
    uint32_t tileSize = 2048; // 单次处理大小 (需 32 字节对齐，2048*4B=8KB，完全满足对齐)
    uint32_t tileNum = lengthPerCore / tileSize;

    if (tileNum == 0) {
        tileSize = lengthPerCore;
        tileNum = 1;
    }

    // 启动核函数
    sub_custom<<<blockDim, nullptr, stream>>>(x, y, z, totalLength, tileNum, tileSize);
}