#include <cmath>
#include "kernel_operator.h"

/*
 * Sub Kernel — Ascend C Direct Invocation
 *
 * TensorGroupInfo / TensorInfo are predefined by the platform.
 *
 * dtype:
 *   0 = fp32
 *   1 = fp16
 *
 * z = x - y
 */

constexpr uint32_t BUFFER_NUM = 2;
constexpr uint32_t TILE_NUM = 8;

/*
 * Host -> Kernel tiling data.
 */
struct SubCustomTilingData {
    uint32_t totalLength;   // total number of elements
    uint32_t tileNum;       // tiles per core
    int32_t dtype;          // 0 = fp32, 1 = fp16
};


/*
 * Device-side implementation.
 *
 * T is float or half.
 */
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        uint32_t totalLength,
        uint32_t tileNum)
    {
        /*
         * First-level tiling:
         *
         * totalLength
         *      |
         *      +---- core 0
         *      +---- core 1
         *      ...
         *
         * GetBlockNum() is the blockNum passed by <<< >>>.
         */
        blockLength = totalLength / AscendC::GetBlockNum();

        /*
         * Second-level tiling:
         *
         * Each core:
         * blockLength -> TILE_NUM -> BUFFER_NUM
         *
         * Example:
         *
         * 16384 elements / 8 cores = 2048 elements/core
         *
         * 2048 / 8 tiles / 2 buffers
         *      = 128 elements for each CopyIn/Compute/CopyOut.
         */
        this->tileNum = tileNum;
        tileLength = blockLength / tileNum / BUFFER_NUM;

        uint32_t blockOffset =
            blockLength * AscendC::GetBlockIdx();

        /*
         * Each core points to its own slice in GM.
         */
        xGm.SetGlobalBuffer(
            (__gm__ T *)x + blockOffset,
            blockLength);

        yGm.SetGlobalBuffer(
            (__gm__ T *)y + blockOffset,
            blockLength);

        zGm.SetGlobalBuffer(
            (__gm__ T *)z + blockOffset,
            blockLength);

        /*
         * Double Buffer.
         */
        pipe.InitBuffer(
            inQueueX,
            BUFFER_NUM,
            tileLength * sizeof(T));

        pipe.InitBuffer(
            inQueueY,
            BUFFER_NUM,
            tileLength * sizeof(T));

        pipe.InitBuffer(
            outQueueZ,
            BUFFER_NUM,
            tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        /*
         * tileNum × BUFFER_NUM.
         *
         * For normal case:
         * 8 × 2 = 16 iterations/core.
         */
        int32_t loopCount =
            static_cast<int32_t>(tileNum * BUFFER_NUM);

        for (int32_t i = 0; i < loopCount; ++i) {
            CopyIn(i);
            Compute();
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        AscendC::LocalTensor<T> xLocal =
            inQueueX.AllocTensor<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.AllocTensor<T>();

        uint32_t offset =
            static_cast<uint32_t>(progress) * tileLength;

        /*
         * GM -> UB
         */
        AscendC::DataCopy(
            xLocal,
            xGm[offset],
            tileLength);

        AscendC::DataCopy(
            yLocal,
            yGm[offset],
            tileLength);

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> xLocal =
            inQueueX.DeQue<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.DeQue<T>();

        AscendC::LocalTensor<T> zLocal =
            outQueueZ.AllocTensor<T>();

        /*
         * Core operation:
         *
         * z = x - y
         */
        AscendC::Sub(
            zLocal,
            xLocal,
            yLocal,
            tileLength);

        outQueueZ.EnQue<T>(zLocal);

        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int32_t progress)
    {
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.DeQue<T>();

        uint32_t offset =
            static_cast<uint32_t>(progress) * tileLength;

        /*
         * UB -> GM
         */
        AscendC::DataCopy(
            zGm[offset],
            zLocal,
            tileLength);

        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;

    AscendC::TQue<
        AscendC::TPosition::VECIN,
        BUFFER_NUM> inQueueX;

    AscendC::TQue<
        AscendC::TPosition::VECIN,
        BUFFER_NUM> inQueueY;

    AscendC::TQue<
        AscendC::TPosition::VECOUT,
        BUFFER_NUM> outQueueZ;

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    uint32_t blockLength;
    uint32_t tileNum;
    uint32_t tileLength;
};


/*
 * Device kernel entry.
 *
 * One entry supports both:
 *   dtype 0 -> float32
 *   dtype 1 -> float16
 */
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    if (tiling.dtype == 0) {
        KernelSub<float> op;
        op.Init(
            x,
            y,
            z,
            tiling.totalLength,
            tiling.tileNum);
        op.Process();
    } else if (tiling.dtype == 1) {
        KernelSub<half> op;
        op.Init(
            x,
            y,
            z,
            tiling.totalLength,
            tiling.tileNum);
        op.Process();
    }
}


/*
 * Host-side launch function.
 *
 * x / y / z are already device GM addresses.
 * stream is already created by the judge framework.
 */
extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    /*
     * Get tensor information.
     *
     * For this problem:
     *
     * shape = (8, 2048)
     * totalLength = 16384
     */
    const TensorInfo& xInfo = info_x.tensors[0];

    uint32_t totalLength = 1;

    for (int64_t i = 0; i < xInfo.numDims; ++i) {
        totalLength *=
            static_cast<uint32_t>(xInfo.shape[i]);
    }

    /*
     * The official example uses 8 blocks for (8, 2048):
     *
     * 16384 / 8 = 2048 elements/core.
     *
     * Use the largest power-of-two <= 8 and <= availableCoreNum,
     * so totalLength remains evenly divisible even if fewer cores
     * are exposed by the environment.
     */
    uint32_t blockNum = 1;

    uint32_t maxCore =
        availableCoreNum > 0
            ? static_cast<uint32_t>(availableCoreNum)
            : 1;

    while ((blockNum << 1) <= 8 &&
           (blockNum << 1) <= maxCore) {
        blockNum <<= 1;
    }

    /*
     * 8 tiles/core + double buffer.
     *
     * With normal blockNum = 8:
     *
     * blockLength = 16384 / 8 = 2048
     * tileLength  = 2048 / 8 / 2 = 128
     *
     * fp32:
     *   128 × 4 = 512 bytes
     *
     * fp16:
     *   128 × 2 = 256 bytes
     *
     * Both satisfy DataCopy alignment requirements.
     */
    SubCustomTilingData tiling;
    tiling.totalLength = totalLength;
    tiling.tileNum = TILE_NUM;
    tiling.dtype = xInfo.dtype;

    /*
     * Launch Vector kernel.
     */
    sub_custom<<<blockNum, nullptr, stream>>>(
        x,
        y,
        z,
        tiling);
}