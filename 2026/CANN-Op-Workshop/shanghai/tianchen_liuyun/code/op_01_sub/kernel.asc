#include <cmath>
#include "kernel_operator.h"

/*
 * Sub Kernel — Ascend C Direct Invocation
 * z = x - y
 */

// ---------------------------------------------------------------------------
// Tiling 参数
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    // 输入输出总元素个数
    uint32_t totalLength;

    // 每个核内部划分的 Tile 数
    uint32_t tileNum;
};

constexpr uint32_t BUFFER_NUM = 2;
constexpr uint32_t QUEUE_DEPTH = 1;


// ---------------------------------------------------------------------------
// KernelSub：z = x - y
// ---------------------------------------------------------------------------
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        const SubCustomTilingData& tiling)
    {
        // 获取 tiling 参数
        uint32_t totalLength = tiling.totalLength;
        this->tileNum = tiling.tileNum;

        // 每个核处理的数据长度
        this->blockLength =
            totalLength / AscendC::GetBlockNum();

        // 每个核每次处理的数据长度
        this->tileLength =
            this->blockLength / this->tileNum / BUFFER_NUM;

        // 设置当前核对应的 GM 地址
        xGm.SetGlobalBuffer(
            (__gm__ T*)x +
            this->blockLength * AscendC::GetBlockIdx(),
            this->blockLength);

        yGm.SetGlobalBuffer(
            (__gm__ T*)y +
            this->blockLength * AscendC::GetBlockIdx(),
            this->blockLength);

        zGm.SetGlobalBuffer(
            (__gm__ T*)z +
            this->blockLength * AscendC::GetBlockIdx(),
            this->blockLength);

        // 初始化 UB Buffer
        pipe.InitBuffer(
            inQueueX,
            BUFFER_NUM,
            this->tileLength * sizeof(T));

        pipe.InitBuffer(
            inQueueY,
            BUFFER_NUM,
            this->tileLength * sizeof(T));

        pipe.InitBuffer(
            outQueueZ,
            BUFFER_NUM,
            this->tileLength * sizeof(T));
    }


    // -----------------------------------------------------------------------
    // 主处理流程
    // -----------------------------------------------------------------------
    __aicore__ inline void Process()
    {
        // tileNum * BUFFER_NUM
        int32_t loopCount =
            this->tileNum * BUFFER_NUM;

        for (int32_t i = 0; i < loopCount; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }


private:

    // -----------------------------------------------------------------------
    // GM -> UB
    // -----------------------------------------------------------------------
    __aicore__ inline void CopyIn(int32_t progress)
    {
        AscendC::LocalTensor<T> xLocal =
            inQueueX.AllocTensor<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.AllocTensor<T>();

        // x 搬入 UB
        AscendC::DataCopy(
            xLocal,
            xGm[progress * this->tileLength],
            this->tileLength);

        // y 搬入 UB
        AscendC::DataCopy(
            yLocal,
            yGm[progress * this->tileLength],
            this->tileLength);

        // 放入输入队列
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }


    // -----------------------------------------------------------------------
    // UB 中执行向量减法
    // z = x - y
    // -----------------------------------------------------------------------
    __aicore__ inline void Compute(int32_t progress)
    {
        // 从输入队列取数据
        AscendC::LocalTensor<T> xLocal =
            inQueueX.DeQue<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.DeQue<T>();

        // 创建输出 Tensor
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.AllocTensor<T>();

        // 向量减法
        AscendC::Sub(
            zLocal,
            xLocal,
            yLocal,
            this->tileLength);

        // 输出进入队列
        outQueueZ.EnQue<T>(zLocal);

        // 释放输入 Tensor
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }


    // -----------------------------------------------------------------------
    // UB -> GM
    // -----------------------------------------------------------------------
    __aicore__ inline void CopyOut(int32_t progress)
    {
        // 从输出队列取结果
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.DeQue<T>();

        // 写回 GM
        AscendC::DataCopy(
            zGm[progress * this->tileLength],
            zLocal,
            this->tileLength);

        // 释放输出 Tensor
        outQueueZ.FreeTensor(zLocal);
    }


private:

    // TPipe
    AscendC::TPipe pipe;

    // 输入队列
    AscendC::TQue<
        AscendC::QuePosition::VECIN,
        QUEUE_DEPTH> inQueueX;

    AscendC::TQue<
        AscendC::QuePosition::VECIN,
        QUEUE_DEPTH> inQueueY;

    // 输出队列
    AscendC::TQue<
        AscendC::QuePosition::VECOUT,
        QUEUE_DEPTH> outQueueZ;

    // GM Tensor
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    // 每个核处理的数据量
    uint32_t blockLength;

    // 每个核划分的 Tile 数
    uint32_t tileNum;

    // 每个 Tile 实际处理的数据量
    uint32_t tileLength;
};


// ---------------------------------------------------------------------------
// Kernel 入口
// ---------------------------------------------------------------------------
template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    KernelSub<T> op;

    op.Init(x, y, z, tiling);

    op.Process();
}


// ---------------------------------------------------------------------------
// Host 侧启动
// ---------------------------------------------------------------------------
extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    // 本题固定使用 8 个核
    constexpr uint32_t blockDim = 8;

    // -----------------------------------------------------------------------
    // 1. 获取输入 Tensor
    // -----------------------------------------------------------------------
    const TensorInfo& t0 = info_x.tensors[0];

    // 计算总元素数
    int64_t totalLength = 1;

    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }

    // -----------------------------------------------------------------------
    // 2. 获取 dtype
    // -----------------------------------------------------------------------
    int32_t dtype = t0.dtype;

    // 每个核内部划分 8 个 Tile
    constexpr uint32_t tileNum = 8;

    // -----------------------------------------------------------------------
    // 3. 构造 tiling 参数
    // -----------------------------------------------------------------------
    SubCustomTilingData tiling = {
        (uint32_t)totalLength,
        tileNum
    };

    // -----------------------------------------------------------------------
    // 4. 根据 dtype 选择 kernel
    // dtype:
    // 0 = float32
    // 1 = float16
    // -----------------------------------------------------------------------
    if (dtype == 1) {
        // float16
        sub_custom<half>
            <<<blockDim, nullptr, stream>>>(
                x, y, z, tiling);
    } else {
        // float32
        sub_custom<float>
            <<<blockDim, nullptr, stream>>>(
                x, y, z, tiling);
    }
}