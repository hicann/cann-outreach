#include <cstdint>

#include "kernel_operator.h"

constexpr uint32_t SUB_TILE_LENGTH = 2048U;
constexpr uint32_t SUB_DOUBLE_BUFFER = 2U;
constexpr int32_t SUB_DTYPE_FLOAT = 0;
constexpr int32_t SUB_DTYPE_FLOAT16 = 1;

struct SubCustomTilingData {
    uint64_t totalLength;
    uint64_t elementsPerCore;
    uint32_t blockNum;
    uint32_t tileLength;
    int32_t dtype;
};

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub(AscendC::TPipe* pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling)
    {
        const uint64_t blockIdx = AscendC::GetBlockIdx();
        const uint64_t offset = blockIdx * tiling.elementsPerCore;
        if (offset >= tiling.totalLength) {
            totalLength_ = 0U;
            return;
        }

        totalLength_ = tiling.totalLength - offset;
        if (totalLength_ > tiling.elementsPerCore) {
            totalLength_ = tiling.elementsPerCore;
        }
        tileLength_ = tiling.tileLength;
        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x) + offset, totalLength_);
        yGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y) + offset, totalLength_);
        zGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z) + offset, totalLength_);
        pipe_->InitBuffer(inQueueX_, SUB_DOUBLE_BUFFER, tileLength_ * sizeof(T));
        pipe_->InitBuffer(inQueueY_, SUB_DOUBLE_BUFFER, tileLength_ * sizeof(T));
        pipe_->InitBuffer(outQueueZ_, SUB_DOUBLE_BUFFER, tileLength_ * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        uint64_t offset = 0U;
        while (offset < totalLength_) {
            uint32_t count = static_cast<uint32_t>(totalLength_ - offset);
            if (count > tileLength_) {
                count = tileLength_;
            }
            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
            offset += count;
        }
    }

private:
    __aicore__ inline void CopyIn(uint64_t offset, uint32_t count)
    {
        const AscendC::DataCopyExtParams copyParams{
            1U, static_cast<uint32_t>(count * sizeof(T)), 0U, 0U, 0U};
        const AscendC::DataCopyPadExtParams<T> padParams{false, 0U, 0U, static_cast<T>(0)};
        AscendC::LocalTensor<T> xLocal = inQueueX_.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY_.AllocTensor<T>();
        AscendC::DataCopyPad(xLocal, xGm_[offset], copyParams, padParams);
        AscendC::DataCopyPad(yLocal, yGm_[offset], copyParams, padParams);
        inQueueX_.EnQue(xLocal);
        inQueueY_.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX_.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY_.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ_.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, count);
        outQueueZ_.EnQue(zLocal);
        inQueueX_.FreeTensor(xLocal);
        inQueueY_.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint64_t offset, uint32_t count)
    {
        const AscendC::DataCopyExtParams copyParams{
            1U, static_cast<uint32_t>(count * sizeof(T)), 0U, 0U, 0U};
        AscendC::LocalTensor<T> zLocal = outQueueZ_.DeQue<T>();
        AscendC::DataCopyPad(zGm_[offset], zLocal, copyParams);
        outQueueZ_.FreeTensor(zLocal);
    }

    AscendC::TPipe* pipe_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueX_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueY_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueZ_;
    AscendC::GlobalTensor<T> xGm_;
    AscendC::GlobalTensor<T> yGm_;
    AscendC::GlobalTensor<T> zGm_;
    uint64_t totalLength_ = 0U;
    uint32_t tileLength_ = SUB_TILE_LENGTH;
};

extern "C" __global__ __vector__ void sub_custom(
    GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    AscendC::TPipe pipe;
    if (tiling.dtype == SUB_DTYPE_FLOAT) {
        KernelSub<float> op(&pipe);
        op.Init(x, y, z, tiling);
        op.Process();
    } else if (tiling.dtype == SUB_DTYPE_FLOAT16) {
        KernelSub<half> op(&pipe);
        op.Init(x, y, z, tiling);
        op.Process();
    }
}

static inline bool HasMatchingTensorShape(const TensorInfo& lhs, const TensorInfo& rhs)
{
    if (lhs.numDims != rhs.numDims) {
        return false;
    }
    for (int64_t dim = 0; dim < lhs.numDims; ++dim) {
        if (lhs.shape[dim] != rhs.shape[dim]) {
            return false;
        }
    }
    return true;
}

static inline uint64_t GetTensorElementCount(const TensorInfo& tensor)
{
    uint64_t elementCount = 1U;
    for (int64_t dim = 0; dim < tensor.numDims; ++dim) {
        if (tensor.shape[dim] <= 0) {
            return 0U;
        }
        elementCount *= static_cast<uint64_t>(tensor.shape[dim]);
    }
    return elementCount;
}

extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y,
    GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    if (info_x.numTensors != 1 || info_y.numTensors != 1 || info_z.numTensors != 1 ||
        info_x.tensors == nullptr || info_y.tensors == nullptr || info_z.tensors == nullptr ||
        availableCoreNum <= 0) {
        return;
    }

    const TensorInfo& tensorX = info_x.tensors[0];
    const TensorInfo& tensorY = info_y.tensors[0];
    const TensorInfo& tensorZ = info_z.tensors[0];
    if (tensorX.shape == nullptr || tensorY.shape == nullptr || tensorZ.shape == nullptr ||
        tensorX.dtype != tensorY.dtype || tensorX.dtype != tensorZ.dtype ||
        !HasMatchingTensorShape(tensorX, tensorY) || !HasMatchingTensorShape(tensorX, tensorZ) ||
        (tensorX.dtype != SUB_DTYPE_FLOAT && tensorX.dtype != SUB_DTYPE_FLOAT16)) {
        return;
    }

    const uint64_t totalLength = GetTensorElementCount(tensorX);
    if (totalLength == 0U) {
        return;
    }

    uint64_t blockNum = (totalLength + SUB_TILE_LENGTH - 1U) / SUB_TILE_LENGTH;
    const uint64_t maxBlockNum = static_cast<uint64_t>(availableCoreNum);
    if (blockNum > maxBlockNum) {
        blockNum = maxBlockNum;
    }
    if (blockNum == 0U) {
        return;
    }

    SubCustomTilingData tiling{};
    tiling.totalLength = totalLength;
    tiling.elementsPerCore = (totalLength + blockNum - 1U) / blockNum;
    tiling.blockNum = static_cast<uint32_t>(blockNum);
    tiling.tileLength = SUB_TILE_LENGTH;
    tiling.dtype = tensorX.dtype;
    sub_custom<<<tiling.blockNum, nullptr, stream>>>(x, y, z, tiling);
}
