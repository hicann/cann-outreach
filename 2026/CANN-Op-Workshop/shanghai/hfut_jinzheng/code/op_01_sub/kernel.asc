#include "kernel_operator.h"

constexpr uint32_t BLOCK_SIZE = 32;
constexpr uint32_t VEC_REPEAT_BYTES = 256;
constexpr uint32_t MAX_TILE_NUM = 8;
constexpr uint32_t UB_LIMIT = 160 * 1024;
constexpr uint32_t FLOAT16_DTYPE = 1;
constexpr uint32_t FLOAT_BYTES = 4;
constexpr uint32_t FLOAT16_BYTES = 2;

static inline uint32_t GetElementSize(uint32_t dtype)
{
    return dtype == FLOAT16_DTYPE ? FLOAT16_BYTES : FLOAT_BYTES;
}

static inline uint32_t GetAlignNum(uint32_t dtype)
{
    return BLOCK_SIZE / GetElementSize(dtype);
}

static inline uint32_t AlignToBlockSize(uint32_t length, uint32_t dtype)
{
    const uint32_t alignNum = GetAlignNum(dtype);
    return (length + alignNum - 1U) / alignNum * alignNum;
}

struct SubCustomTilingData {
    uint32_t totalLength;
    uint32_t tileNum;
    uint32_t dtype;
};

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {
        this->blockLength = totalLength / AscendC::GetBlockNum();
        this->tileNum = tileNum;
        this->tileLength = this->blockLength / tileNum;

        xGm.SetGlobalBuffer((__gm__ T *)x + this->blockLength * AscendC::GetBlockIdx(), this->blockLength);
        yGm.SetGlobalBuffer((__gm__ T *)y + this->blockLength * AscendC::GetBlockIdx(), this->blockLength);
        zGm.SetGlobalBuffer((__gm__ T *)z + this->blockLength * AscendC::GetBlockIdx(), this->blockLength);

        pipe.InitBuffer(xBuf, this->tileLength * sizeof(T));
        pipe.InitBuffer(yBuf, this->tileLength * sizeof(T));
        pipe.InitBuffer(zBuf, this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalTensor<T> xLocal = xBuf.Get<T>();
        AscendC::LocalTensor<T> yLocal = yBuf.Get<T>();
        AscendC::LocalTensor<T> zLocal = zBuf.Get<T>();

        for (uint32_t i = 0; i < this->tileNum; ++i) {
            const uint32_t offset = i * this->tileLength;
            AscendC::DataCopy(xLocal, xGm[offset], this->tileLength);
            AscendC::DataCopy(yLocal, yGm[offset], this->tileLength);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

            AscendC::Sub(zLocal, xLocal, yLocal, this->tileLength);
            AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

            AscendC::DataCopy(zGm[offset], zLocal, this->tileLength);
            if (i + 1 < this->tileNum) {
                AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
            }
        }
    }

private:
    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECIN> xBuf;
    AscendC::TBuf<AscendC::TPosition::VECIN> yBuf;
    AscendC::TBuf<AscendC::TPosition::VECOUT> zBuf;
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;
    uint32_t blockLength;
    uint32_t tileNum;
    uint32_t tileLength;
};

extern "C" __global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub<float> op;
    op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    op.Process();
}

extern "C" __global__ __vector__ void sub_custom_fp16(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub<half> op;
    op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    op.Process();
}

static inline uint32_t ComputeTotalLength(const TensorGroupInfo &info)
{
    int64_t total = 1;
    const TensorInfo &tensor = info.tensors[0];
    for (int64_t i = 0; i < tensor.numDims; ++i) {
        total *= tensor.shape[i];
    }
    return static_cast<uint32_t>(total);
}

static inline uint32_t ChooseBlockNum(uint32_t totalLength, int64_t availableCoreNum, uint32_t dtype)
{
    uint32_t blockNum = availableCoreNum > 0 ? static_cast<uint32_t>(availableCoreNum) : 1U;
    const uint32_t alignNum = GetAlignNum(dtype);
    while (blockNum > 1U &&
           (totalLength % blockNum != 0U || (totalLength / blockNum) % alignNum != 0U)) {
        --blockNum;
    }
    return blockNum;
}

static inline uint32_t ChooseTileNum(uint32_t blockLength, uint32_t dtype)
{
    const uint32_t alignNum = GetAlignNum(dtype);
    const uint32_t elemSize = GetElementSize(dtype);
    const uint32_t vecAlign = VEC_REPEAT_BYTES / elemSize;
    uint32_t maxTile = UB_LIMIT / (3U * elemSize);
    maxTile = maxTile / vecAlign * vecAlign;
    if (maxTile < alignNum) {
        maxTile = alignNum;
    }

    for (uint32_t tileNum = 1U; tileNum <= MAX_TILE_NUM; ++tileNum) {
        if (blockLength % tileNum != 0U) {
            continue;
        }
        const uint32_t tileLength = blockLength / tileNum;
        if (tileLength <= maxTile && (tileLength % alignNum) == 0U) {
            return tileNum;
        }
    }
    return 1U;
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo &info_x, GM_ADDR y, const TensorGroupInfo &info_y,
                           GM_ADDR z, const TensorGroupInfo &info_z, int64_t availableCoreNum, aclrtStream stream)
{
    (void)info_y;
    (void)info_z;

    const uint32_t dtype = static_cast<uint32_t>(info_x.tensors[0].dtype);
    const uint32_t totalLength = AlignToBlockSize(ComputeTotalLength(info_x), dtype);
    const uint32_t blockNum = ChooseBlockNum(totalLength, availableCoreNum, dtype);
    const uint32_t blockLength = totalLength / blockNum;

    SubCustomTilingData tiling;
    tiling.totalLength = totalLength;
    tiling.tileNum = ChooseTileNum(blockLength, dtype);
    tiling.dtype = dtype;

    if (tiling.dtype == FLOAT16_DTYPE) {
        sub_custom_fp16<<<blockNum, nullptr, stream>>>(x, y, z, tiling);
    } else {
        sub_custom<<<blockNum, nullptr, stream>>>(x, y, z, tiling);
    }
}
