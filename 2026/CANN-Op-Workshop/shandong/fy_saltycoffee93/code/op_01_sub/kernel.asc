#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 */

constexpr uint32_t BUFFER_NUM = 2;          // double buffering
constexpr uint32_t UB_BLOCK_SIZE = 32;      // DataCopy 的对齐粒度（字节）
// 预留量固定：不随 UB 容量缩放，这样 UB 更大的芯片直接换到更大的 tile
constexpr uint32_t UB_RESERVED = 16 * 1024;  // 预留给 TPipe / 栈等开销
// 每核最小工作量，以 32B 块计量：128 块 = 4KB。
// 用"块"而非"元素"表述，使 fp32/fp16 下的语义一致，也与对齐单位统一。
//
// 这个下限决定"多大的数据才配多用几个核"。每核的 TPipe/队列初始化、
// 访存描述符建立等属于固定开销，与处理多少数据无关；数据量小的时候
// 核切得越细，固定开销占比就越高，反而更慢。
// 本算子参考用例仅 64KB（16384 个 fp32），在目标 32 核硬件上按下限铺满
// 32 核（512 元素/核）时反而慢于 16 核（1024 元素/核），故取 4KB/核，
// 使该用例落在 16 核；数据量增大后仍会自然铺满全部 32 核。
constexpr uint32_t MIN_BLOCK_PER_CORE = 128;

// 单核 UB 容量由 __NPU_ARCH__ 在编译期确定（2201=192KB / 3002=248KB / 3102=256KB ...）。
// 用架构自适应常量而非写死芯片型号的数值：UB 更大的芯片能直接受益于更大的 tile，
// 无需改动此处；未知 arch 下 TOTAL_UB_SIZE 未定义，回退到最保守的 192KB。
#if defined(__NPU_ARCH__) &&                                                            \
    ((__NPU_ARCH__ == 1001) || (__NPU_ARCH__ == 2002) || (__NPU_ARCH__ == 2201) ||      \
     (__NPU_ARCH__ == 3002) || (__NPU_ARCH__ == 3003) || (__NPU_ARCH__ == 3102) ||      \
     (__NPU_ARCH__ == 3113) || (__NPU_ARCH__ == 3510))
#define SUB_UB_TOTAL_SIZE AscendC::TOTAL_UB_SIZE
#else
#define SUB_UB_TOTAL_SIZE (192 * 1024)
#endif

// 32B 对齐所对应的元素个数（fp32=8, fp16/bf16=16）
template <typename T>
__aicore__ inline uint32_t AlignElems()
{
    return UB_BLOCK_SIZE / sizeof(T);
}

// 由 UB 容量自适应推导单次 tile 长度。UB 里共需 double buffer 的 x、y、z
// 三份同尺寸缓冲（x、y 合用同一个队列的前后半区，见 Init）
template <typename T>
__aicore__ inline uint32_t CalcMaxTileLength()
{
    uint32_t align = AlignElems<T>();
    uint32_t tile = (SUB_UB_TOTAL_SIZE - UB_RESERVED) / (BUFFER_NUM * 3 * sizeof(T));
    tile = tile / align * align;  // 向下对齐
    return (tile < align) ? align : tile;
}

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t total, uint32_t start, uint32_t length)
    {
        this->start = start;
        this->total = length;
        this->align = AlignElems<T>();
        // 本核实际处理量不超过 one-block 时无需按 UB 上限申请，减少初始化开销
        uint32_t tile = CalcMaxTileLength<T>();
        if (this->total > 0 && tile > this->total) {
            tile = (this->total + this->align - 1) / this->align * this->align;
        }
        this->tileLength = (tile < this->align) ? this->align : tile;
        xGm.SetGlobalBuffer((__gm__ T*)x);
        yGm.SetGlobalBuffer((__gm__ T*)y);
        zGm.SetGlobalBuffer((__gm__ T*)z);
        // x、y 共用同一个输入队列：各占该缓冲的前后半区。
        // 两者都按 tileLength 等长切分，所以 y 的起始偏移恒为 tileLength。
        // 合并后每核只需初始化 2 个队列（原为 3 个），每 tile 的张量管理调用
        // 由 10 次降到 8 次，而 UB 占用与 DataCopy 次数都不变。
        // 每核只搬 2KB 量级数据时，这类"每核固定成本"比计算本身更占主导。
        pipe.InitBuffer(inQueueXY, BUFFER_NUM, 2 * this->tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(T));
        (void)total;
    }

    __aicore__ inline void Process()
    {
        if (total == 0) {
            return;
        }
        // 主体：32B 对齐的部分按 tile 批量搬运/计算，全程保持 DataCopy 对齐
        uint32_t aligned = total / align * align;
        uint32_t offset = 0;
        while (offset < aligned) {
            uint32_t n = aligned - offset;
            if (n > tileLength) {
                n = tileLength;
            }
            CopyIn(offset, n);
            Compute(n);
            CopyOut(offset, n);
            offset += n;
        }
        // 尾部：不足 32B 的部分用 DataCopyPad 精确处理长度，
        // 既不越界读写，也不依赖 32B 对齐假设（原先"回退 ALIGN 个元素"的做法
        // 在长度 < ALIGN 时会因无符号下溢而越界）
        if (total > aligned) {
            uint32_t n = total - aligned;
            CopyInPad(offset, n);
            Compute(n);
            CopyOutPad(offset, n);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset, uint32_t length)
    {
        AscendC::LocalTensor<T> xyLocal = inQueueXY.AllocTensor<T>();
        AscendC::LocalTensor<T> xLocal = xyLocal;
        AscendC::LocalTensor<T> yLocal = xyLocal[tileLength];  // 后半区
        AscendC::DataCopy(xLocal, xGm[start + offset], length);
        AscendC::DataCopy(yLocal, yGm[start + offset], length);
        inQueueXY.EnQue(xyLocal);
    }

    __aicore__ inline void CopyInPad(uint32_t offset, uint32_t length)
    {
        AscendC::LocalTensor<T> xyLocal = inQueueXY.AllocTensor<T>();
        AscendC::LocalTensor<T> xLocal = xyLocal;
        AscendC::LocalTensor<T> yLocal = xyLocal[tileLength];  // 后半区
        AscendC::DataCopyExtParams copyParams(1, static_cast<uint32_t>(length * sizeof(T)), 0, 0, 0);
        AscendC::DataCopyPadExtParams<T> padParams;
        AscendC::DataCopyPad(xLocal, xGm[start + offset], copyParams, padParams);
        AscendC::DataCopyPad(yLocal, yGm[start + offset], copyParams, padParams);
        inQueueXY.EnQue(xyLocal);
    }

    __aicore__ inline void Compute(uint32_t length)
    {
        AscendC::LocalTensor<T> xyLocal = inQueueXY.DeQue<T>();
        AscendC::LocalTensor<T> xLocal = xyLocal;
        AscendC::LocalTensor<T> yLocal = xyLocal[tileLength];  // 后半区
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, length);
        outQueueZ.EnQue<T>(zLocal);
        inQueueXY.FreeTensor(xyLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t length)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopy(zGm[start + offset], zLocal, length);
        outQueueZ.FreeTensor(zLocal);
    }

    __aicore__ inline void CopyOutPad(uint32_t offset, uint32_t length)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopyExtParams copyParams(1, static_cast<uint32_t>(length * sizeof(T)), 0, 0, 0);
        AscendC::DataCopyPad(zGm[start + offset], zLocal, copyParams);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;
    // x、y 共用同一输入队列（前/后半区），故只有 2 个队列
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inQueueXY;
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_NUM> outQueueZ;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;
    uint32_t start = 0;
    uint32_t total = 0;
    uint32_t align = 0;
    uint32_t tileLength = 0;
};

template <typename T>
__global__ __vector__ void sub_kernel(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t total, uint32_t chunk)
{
    // single launch, multi-core: each core handles [blockIdx*chunk, min((blockIdx+1)*chunk, total))
    uint32_t block = AscendC::GetBlockIdx();
    uint32_t start = block * chunk;
    if (start >= total) {
        return;
    }
    uint32_t len = (total - start > chunk) ? chunk : (total - start);
    KernelSub<T> op;
    op.Init(x, y, z, total, start, len);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    int64_t totalLength = 1;
    for (int64_t i = 0; i < info_x.tensors[0].numDims; i++) {
        totalLength *= info_x.tensors[0].shape[i];
    }
    int32_t dtype = info_x.tensors[0].dtype;

    uint32_t total = (uint32_t)totalLength;
    if (total == 0) {
        return;
    }
    // 32B 对齐对应的元素个数（fp32=8, fp16/bf16=16），保证各核起始地址满足 DataCopy 对齐
    uint32_t align = (dtype == 1 || dtype == 2) ? (UB_BLOCK_SIZE / 2) : (UB_BLOCK_SIZE / 4);

    // 切分算术统一走 64 位：total 接近 2^32 时 uint32 的 (total + coreNum - 1)
    // 会回绕，把 chunk 算成一个极小的错误值，导致大量核越界访存
    uint64_t total64 = total;
    uint64_t coreNum = (availableCoreNum < 1) ? 1 : (uint64_t)availableCoreNum;
    // 核数按数据量裁剪：以 32B 块为单位，每核至少 MIN_BLOCK_PER_CORE 块。
    // 用块（而非元素）做单位，切分粒度与对齐单位一致，且 fp32/fp16 语义相同。
    uint64_t totalBlocks = (total64 + align - 1) / align;
    uint64_t needed = (totalBlocks + MIN_BLOCK_PER_CORE - 1) / MIN_BLOCK_PER_CORE;
    if (needed < 1) needed = 1;
    if (coreNum > needed) coreNum = needed;
    // per-core chunk, rounded up to ALIGN so each core's start stays 32B-aligned
    uint64_t chunk64 = ((total64 + coreNum - 1) / coreNum + align - 1) / align * align;
    if (chunk64 == 0) chunk64 = align;
    // chunk 需能落进 uint32。仅在 total 逼近 2^32 且核数极小时触发；
    // 按对齐向下钳制（而非归零），后续 blocks 会自然变成 2 以覆盖全部数据
    const uint64_t U32_MAX_ALIGNED = static_cast<uint64_t>(0xFFFFFFFFu) / align * align;
    if (chunk64 > U32_MAX_ALIGNED) chunk64 = U32_MAX_ALIGNED;
    uint32_t chunk = (uint32_t)chunk64;
    // recompute actual blocks used; keep launch at exactly 1 kernel
    uint64_t blocks64 = (total64 + chunk - 1) / chunk;
    uint32_t blocks = (blocks64 < 1) ? 1 : (uint32_t)blocks64;

    if (dtype == 0) { // float32
        sub_kernel<float><<<blocks, nullptr, stream>>>(x, y, z, total, chunk);
    } else if (dtype == 1) { // float16
        sub_kernel<half><<<blocks, nullptr, stream>>>(x, y, z, total, chunk);
    }
}
