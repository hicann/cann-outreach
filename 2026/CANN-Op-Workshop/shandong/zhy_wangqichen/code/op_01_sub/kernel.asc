#include <cmath>
#include "kernel_operator.h"

using namespace AscendC;

constexpr int32_t TOTAL_ELEMENTS = 8 * 2048;   // 16384
constexpr int32_t TILE_LENGTH = 2048;          // 每个 tile 元素数
constexpr int32_t BUFFER_NUM = 2;              // 双缓冲

template<typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, int64_t coreNum) {
        int64_t perCore = TOTAL_ELEMENTS / coreNum;
        int64_t offset = GetBlockIdx() * perCore;

        xGm.SetGlobalBuffer((__gm__ T*)x + offset, perCore);
        yGm.SetGlobalBuffer((__gm__ T*)y + offset, perCore);
        zGm.SetGlobalBuffer((__gm__ T*)z + offset, perCore);

        this->tileNum = perCore / TILE_LENGTH;
        this->tailLen = perCore % TILE_LENGTH;

        pipe.InitBuffer(inQueueX, BUFFER_NUM, TILE_LENGTH * sizeof(T));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, TILE_LENGTH * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, TILE_LENGTH * sizeof(T));
    }

    __aicore__ inline void Process() {
        for (int32_t i = 0; i < tileNum; i++) {
            CopyIn(i, TILE_LENGTH);
            Compute(TILE_LENGTH);
            CopyOut(i, TILE_LENGTH);
        }
        if (tailLen > 0) {
            CopyIn(tileNum, tailLen);
            Compute(tailLen);
            CopyOut(tileNum, tailLen);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t idx, int32_t len) {
        LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        DataCopy(xLocal, xGm[idx * TILE_LENGTH], len);
        DataCopy(yLocal, yGm[idx * TILE_LENGTH], len);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(int32_t len) {
        LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        Sub(zLocal, xLocal, yLocal, len);
        outQueueZ.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int32_t idx, int32_t len) {
        LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        DataCopy(zGm[idx * TILE_LENGTH], zLocal, len);
        outQueueZ.FreeTensor(zLocal);
    }

    TPipe pipe;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueX;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueY;
    TQue<TPosition::VECOUT, BUFFER_NUM> outQueueZ;
    GlobalTensor<T> xGm;
    GlobalTensor<T> yGm;
    GlobalTensor<T> zGm;
    int32_t tileNum;
    int32_t tailLen;
};

__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, int32_t dtype, int64_t coreNum) {
    if (dtype == 0) {
        KernelSub<float> op;
        op.Init(x, y, z, coreNum);
        op.Process();
    } else if (dtype == 1) {
        KernelSub<half> op;
        op.Init(x, y, z, coreNum);
        op.Process();
    }
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    int64_t dtypeCode = info_x.tensors[0].dtype;
    int64_t coreNum = availableCoreNum > 0 ? availableCoreNum : 8;
    if (coreNum > 8) coreNum = 8;

    sub_custom<<<coreNum, nullptr, stream>>>(x, y, z, (int32_t)dtypeCode, coreNum);
}