#include "kernel_operator.h"
#include <cstdint>

namespace inplace_difference {
using AscendC::TPosition;
constexpr uint32_t kElements = 16384;
constexpr uint32_t kUnit = 256;
constexpr uint32_t kCapacity = 1024;

template <typename Scalar>
__aicore__ inline void Run(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    const uint32_t rank = AscendC::GetBlockIdx();
    const uint32_t workers = AscendC::GetBlockNum();
    const uint32_t units = kElements / kUnit;
    uint32_t cursor = (units * rank / workers) * kUnit;
    const uint32_t limit = (units * (rank + 1) / workers) * kUnit;

    AscendC::TPipe pipe;
    AscendC::TQue<TPosition::VECIN, 1> leftQueue;
    AscendC::TQueBind<TPosition::VECIN, TPosition::VECOUT, 1> rightAndResult;
    pipe.InitBuffer(leftQueue, 1, kCapacity * sizeof(Scalar));
    pipe.InitBuffer(rightAndResult, 1, kCapacity * sizeof(Scalar));

    AscendC::GlobalTensor<Scalar> leftGm, rightGm, resultGm;
    leftGm.SetGlobalBuffer((__gm__ Scalar *)x, kElements);
    rightGm.SetGlobalBuffer((__gm__ Scalar *)y, kElements);
    resultGm.SetGlobalBuffer((__gm__ Scalar *)z, kElements);

    while (cursor < limit) {
        const uint32_t remaining = limit - cursor;
        const uint32_t count = remaining < kCapacity ? remaining : kCapacity;
        auto leftLoad = leftQueue.AllocTensor<Scalar>();
        auto rightLoad = rightAndResult.AllocTensor<Scalar>();
        AscendC::DataCopy(leftLoad, leftGm[cursor], count);
        AscendC::DataCopy(rightLoad, rightGm[cursor], count);
        leftQueue.EnQue(leftLoad);
        rightAndResult.EnQue<TPosition::GM, TPosition::VECIN, Scalar>(rightLoad);

        auto lhs = leftQueue.DeQue<Scalar>();
        auto rhs = rightAndResult.DeQue<TPosition::GM, TPosition::VECIN, Scalar>();
        // Reuse the second operand's UB storage. Global input y stays unchanged.
        AscendC::Sub(rhs, lhs, rhs, count);
        leftQueue.FreeTensor(lhs);

        // Explicit queue directions select MTE2 -> V and V -> MTE3 synchronization.
        rightAndResult.EnQue<TPosition::VECOUT, TPosition::GM, Scalar>(rhs);
        auto ready = rightAndResult.DeQue<TPosition::VECOUT, TPosition::GM, Scalar>();
        AscendC::DataCopy(resultGm[cursor], ready, count);
        rightAndResult.FreeTensor(ready);
        cursor += count;
    }
}

inline bool Matches(const TensorGroupInfo &group, int32_t dtype)
{
    if (group.numTensors < 1 || group.tensors == nullptr) return false;
    const TensorInfo &tensor = group.tensors[0];
    return tensor.dtype == dtype && tensor.shape != nullptr && tensor.numDims == 2 &&
           tensor.shape[0] == 8 && tensor.shape[1] == 2048;
}
} // namespace inplace_difference

__global__ __vector__ void subtract_reusing_input(GM_ADDR x, GM_ADDR y, GM_ADDR z, int32_t dtype)
{
    if (dtype == 0) {
        inplace_difference::Run<float>(x, y, z);
    } else if (dtype == 1) {
        inplace_difference::Run<half>(x, y, z);
    }
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo &info_x,
                           GM_ADDR y, const TensorGroupInfo &info_y,
                           GM_ADDR z, const TensorGroupInfo &info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    if (info_x.tensors == nullptr || info_x.numTensors < 1) return;
    const int32_t dtype = info_x.tensors[0].dtype;
    if (dtype != 0 && dtype != 1) return;
    if (!inplace_difference::Matches(info_x, dtype) ||
        !inplace_difference::Matches(info_y, dtype) ||
        !inplace_difference::Matches(info_z, dtype)) return;

    const uint32_t blocks = availableCoreNum <= 0 ? 1 :
        (availableCoreNum >= 32 ? 32 : static_cast<uint32_t>(availableCoreNum));
    subtract_reusing_input<<<blocks, nullptr, stream>>>(x, y, z, dtype);
}
