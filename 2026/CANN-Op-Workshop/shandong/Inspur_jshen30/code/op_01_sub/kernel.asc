#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64
 *          7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 */

constexpr int32_t BUFFER_NUM = 2;
constexpr int64_t TILE_LENGTH = 4096; // elements per tile
constexpr int64_t ALIGN = 16;         // 32B / sizeof(fp16), safe for fp32 too

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, int64_t totalLength, int64_t blockLength)
    {
        int64_t start = blockLength * AscendC::GetBlockIdx();
        int64_t remain = totalLength - start;
        this->myLength = remain < blockLength ? remain : blockLength;
        if (this->myLength < 0) {
            this->myLength = 0;
        }
        xGm.SetGlobalBuffer((__gm__ T *)x + start, this->myLength);
        yGm.SetGlobalBuffer((__gm__ T *)y + start, this->myLength);
        zGm.SetGlobalBuffer((__gm__ T *)z + start, this->myLength);
        pipe.InitBuffer(inQueueX, BUFFER_NUM, TILE_LENGTH * sizeof(T));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, TILE_LENGTH * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, TILE_LENGTH * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        int64_t loopCount = (this->myLength + TILE_LENGTH - 1) / TILE_LENGTH;
        for (int64_t i = 0; i < loopCount; ++i) {
            int64_t len = TILE_LENGTH;
            if (i == loopCount - 1) {
                len = this->myLength - i * TILE_LENGTH;
            }
            CopyIn(i, len);
            Compute(i, len);
            CopyOut(i, len);
        }
    }

private:
    __aicore__ inline void CopyIn(int64_t progress, int64_t len)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm[progress * TILE_LENGTH], len);
        AscendC::DataCopy(yLocal, yGm[progress * TILE_LENGTH], len);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(int64_t progress, int64_t len)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, len);
        outQueueZ.EnQue(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int64_t progress, int64_t len)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopy(zGm[progress * TILE_LENGTH], zLocal, len);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, BUFFER_NUM> inQueueX;
    AscendC::TQue<AscendC::QuePosition::VECIN, BUFFER_NUM> inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, BUFFER_NUM> outQueueZ;
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;
    int64_t myLength = 0;
};

extern "C" __global__ __vector__ void sub_custom_f32(GM_ADDR x, GM_ADDR y, GM_ADDR z, int64_t totalLength, int64_t blockLength)
{
    KernelSub<float> op;
    op.Init(x, y, z, totalLength, blockLength);
    op.Process();
}

extern "C" __global__ __vector__ void sub_custom_f16(GM_ADDR x, GM_ADDR y, GM_ADDR z, int64_t totalLength, int64_t blockLength)
{
    KernelSub<half> op;
    op.Init(x, y, z, totalLength, blockLength);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    int64_t totalLength = 1;
    for (int64_t i = 0; i < info_x.tensors[0].numDims; ++i) {
        totalLength *= info_x.tensors[0].shape[i];
    }
    if (totalLength <= 0) {
        return;
    }

    int64_t blockNum = availableCoreNum;
    int64_t blockLength = (totalLength + blockNum - 1) / blockNum;
    blockLength = (blockLength + ALIGN - 1) / ALIGN * ALIGN;
    blockNum = (totalLength + blockLength - 1) / blockLength;
    uint32_t blockNumU = static_cast<uint32_t>(blockNum);

    switch (info_x.tensors[0].dtype) {
        case 1: // fp16
            sub_custom_f16<<<blockNumU, nullptr, stream>>>(x, y, z, totalLength, blockLength);
            break;
        case 0: // fp32
        default:
            sub_custom_f32<<<blockNumU, nullptr, stream>>>(x, y, z, totalLength, blockLength);
            break;
    }
}
