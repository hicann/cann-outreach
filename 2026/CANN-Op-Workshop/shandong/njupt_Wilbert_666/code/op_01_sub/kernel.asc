#include <cstdint>
#include "kernel_operator.h"

namespace row_sub {
constexpr uint32_t kRows = 8;
constexpr uint32_t kWidth = 2048;

// One queue entry holds both operands of a complete row.
template <typename T>
__aicore__ inline void Execute(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> operands;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> results;
    pipe.InitBuffer(operands, 1, 2 * kWidth * sizeof(T));
    pipe.InitBuffer(results, 1, kWidth * sizeof(T));

    AscendC::GlobalTensor<T> gx, gy, gz;
    gx.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x), kRows * kWidth);
    gy.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(y), kRows * kWidth);
    gz.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(z), kRows * kWidth);

    for (uint32_t row = AscendC::GetBlockIdx(); row < kRows;
         row += AscendC::GetBlockNum()) {
        const uint32_t offset = row * kWidth;
        auto packed = operands.AllocTensor<T>();
        AscendC::DataCopy(packed, gx[offset], kWidth);
        AscendC::DataCopy(packed[kWidth], gy[offset], kWidth);
        operands.EnQue(packed);

        auto input = operands.DeQue<T>();
        auto output = results.AllocTensor<T>();
        AscendC::Sub(output, input, input[kWidth], kWidth);
        results.EnQue(output);
        operands.FreeTensor(input);

        auto ready = results.DeQue<T>();
        AscendC::DataCopy(gz[offset], ready, kWidth);
        results.FreeTensor(ready);
    }
}

inline bool Accepts(const TensorGroupInfo &group, int32_t dtype)
{
    if (group.numTensors < 1 || group.tensors == nullptr) return false;
    const TensorInfo &t = group.tensors[0];
    return t.dtype == dtype && t.numDims == 2 && t.shape != nullptr &&
           t.shape[0] == kRows && t.shape[1] == kWidth;
}
} // namespace row_sub

__global__ __vector__ void subtract_rows(GM_ADDR x, GM_ADDR y, GM_ADDR z, int32_t dtype)
{
    if (dtype == 0) row_sub::Execute<float>(x, y, z);
    else row_sub::Execute<half>(x, y, z);
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo &info_x,
                           GM_ADDR y, const TensorGroupInfo &info_y,
                           GM_ADDR z, const TensorGroupInfo &info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    if (info_x.numTensors < 1 || info_x.tensors == nullptr) return;
    const int32_t dtype = info_x.tensors[0].dtype;
    if (dtype != 0 && dtype != 1) return;
    if (!row_sub::Accepts(info_x, dtype) || !row_sub::Accepts(info_y, dtype) ||
        !row_sub::Accepts(info_z, dtype)) return;

    const uint32_t cores = availableCoreNum <= 0 ? 1 :
        static_cast<uint32_t>(availableCoreNum < 8 ? availableCoreNum : 8);
    subtract_rows<<<cores, nullptr, stream>>>(x, y, z, dtype);
}
