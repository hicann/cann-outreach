#include "kernel_operator.h"
#include <cstdint>

namespace streamed_difference {
constexpr uint32_t TileSize = 512;
constexpr uint32_t TileCount = 32;

template <class Element>
class Stream {
    AscendC::TPipe pipeline;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> input;
    AscendC::TQue<AscendC::TPosition::VECOUT, 2> output;
    AscendC::GlobalTensor<Element> lhs, rhs, dst;

    __aicore__ inline void Prefetch(uint32_t tile)
    {
        auto pair = input.AllocTensor<Element>();
        AscendC::DataCopy(pair, lhs[tile * TileSize], TileSize);
        AscendC::DataCopy(pair[TileSize], rhs[tile * TileSize], TileSize);
        input.EnQue(pair);
    }

    __aicore__ inline void Consume(uint32_t tile)
    {
        auto pair = input.DeQue<Element>();
        auto difference = output.AllocTensor<Element>();
        AscendC::Sub(difference, pair, pair[TileSize], TileSize);
        output.EnQue(difference);
        input.FreeTensor(pair);

        auto completed = output.DeQue<Element>();
        AscendC::DataCopy(dst[tile * TileSize], completed, TileSize);
        output.FreeTensor(completed);
    }

public:
    __aicore__ inline void Run(GM_ADDR a, GM_ADDR b, GM_ADDR c)
    {
        lhs.SetGlobalBuffer((__gm__ Element *)a, TileCount * TileSize);
        rhs.SetGlobalBuffer((__gm__ Element *)b, TileCount * TileSize);
        dst.SetGlobalBuffer((__gm__ Element *)c, TileCount * TileSize);
        pipeline.InitBuffer(input, 2, 2 * TileSize * sizeof(Element));
        pipeline.InitBuffer(output, 2, TileSize * sizeof(Element));

        const uint32_t rank = AscendC::GetBlockIdx();
        const uint32_t workers = AscendC::GetBlockNum();
        const uint32_t begin = TileCount * rank / workers;
        const uint32_t end = TileCount * (rank + 1) / workers;
        if (begin == end) return;

        Prefetch(begin);
        for (uint32_t tile = begin; tile < end; ++tile) {
            // Stage the next tile before consuming the current one.
            if (tile + 1 < end) Prefetch(tile + 1);
            Consume(tile);
        }
    }
};
} // namespace streamed_difference

__global__ __vector__ void subtract_stream(GM_ADDR a, GM_ADDR b, GM_ADDR c, int32_t kind)
{
    if (kind == 1) {
        streamed_difference::Stream<half> stream;
        stream.Run(a, b, c);
    } else {
        streamed_difference::Stream<float> stream;
        stream.Run(a, b, c);
    }
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo &info_x,
                           GM_ADDR y, const TensorGroupInfo &info_y,
                           GM_ADDR z, const TensorGroupInfo &info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    const TensorGroupInfo *groups[] = {&info_x, &info_y, &info_z};
    for (const TensorGroupInfo *group : groups) {
        if (!group->tensors || group->numTensors < 1) return;
        const TensorInfo &t = group->tensors[0];
        if (!t.shape || t.numDims != 2 || t.shape[0] != 8 || t.shape[1] != 2048) return;
        if (t.dtype != 0 && t.dtype != 1) return;
    }
    const int32_t kind = info_x.tensors[0].dtype;
    if (info_y.tensors[0].dtype != kind || info_z.tensors[0].dtype != kind) return;

    int64_t workers = availableCoreNum;
    if (workers < 1) workers = 1;
    if (workers > streamed_difference::TileCount) workers = streamed_difference::TileCount;
    subtract_stream<<<static_cast<uint32_t>(workers), nullptr, stream>>>(x, y, z, kind);
}
