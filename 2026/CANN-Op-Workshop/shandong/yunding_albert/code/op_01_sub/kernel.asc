#include <cmath>
#include "kernel_operator.h"

// ---------------------------------------------------------------------------
// Tiling 参数：由 host 侧 run_kernel 计算后按值传给核函数
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint32_t totalLength; // 待处理数据总长度（单位：元素个数）
    uint32_t tileNum;     // 单核内将数据进一步切分为多少块（Tile）
};

constexpr uint32_t BUFFER_NUM = 2;   // double buffer
constexpr uint32_t QUEUE_DEPTH = 1;

// ---------------------------------------------------------------------------
// KernelSub：z = x - y，每核分块循环计算（模板化，支持 float / half 等类型）
// ---------------------------------------------------------------------------
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        const SubCustomTilingData& tiling)
    {
        // 1. 获取 Tiling 参数
        uint32_t totalLength = tiling.totalLength;
        uint32_t tileNum = tiling.tileNum;

        // 2. 计算每个核需要处理的数据长度
        this->blockLength =
            totalLength / AscendC::GetBlockNum();

        // 3. 保存单核内 Tile 数量
        this->tileNum = tileNum;

        // 4. 计算每个 Tile 的元素数量
        //    blockLength / tileNum / BUFFER_NUM
        this->tileLength =
            this->blockLength / tileNum / BUFFER_NUM;

        // 5. 设置当前核对应的 Global Memory 地址
        uint32_t blockIdx = AscendC::GetBlockIdx();

        xGm.SetGlobalBuffer(
            (__gm__ T*)x + this->blockLength * blockIdx,
            this->blockLength);

        yGm.SetGlobalBuffer(
            (__gm__ T*)y + this->blockLength * blockIdx,
            this->blockLength);

        zGm.SetGlobalBuffer(
            (__gm__ T*)z + this->blockLength * blockIdx,
            this->blockLength);

        // 6. 初始化输入 / 输出队列
        pipe.InitBuffer(
            inQueueX,
            BUFFER_NUM,
            this->tileLength * sizeof(T));

        pipe.InitBuffer(
            inQueueY,
            BUFFER_NUM,
            this->tileLength * sizeof(T));

        pipe.InitBuffer(
            outQueueZ,
            BUFFER_NUM,
            this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // 循环次数 = tileNum × BUFFER_NUM
        int32_t loopCount = this->tileNum * BUFFER_NUM;

        for (int32_t i = 0; i < loopCount; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        // 1. 从输入队列申请 Local Tensor
        AscendC::LocalTensor<T> xLocal =
            inQueueX.AllocTensor<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.AllocTensor<T>();

        // 2. 从 Global Memory 搬运到 Local Memory
        AscendC::DataCopy(
            xLocal,
            xGm[progress * this->tileLength],
            this->tileLength);

        AscendC::DataCopy(
            yLocal,
            yGm[progress * this->tileLength],
            this->tileLength);

        // 3. 放入输入队列
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(int32_t progress)
    {
        // 1. 从输入队列取出数据
        AscendC::LocalTensor<T> xLocal =
            inQueueX.DeQue<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.DeQue<T>();

        // 2. 为输出申请 Local Tensor
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.AllocTensor<T>();

        // 3. 执行减法
        //    z = x - y
        AscendC::Sub(
            zLocal,
            xLocal,
            yLocal,
            this->tileLength);

        // 4. 将结果放入输出队列
        outQueueZ.EnQue<T>(zLocal);

        // 5. 释放输入 Tensor
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int32_t progress)
    {
        // 1. 从输出队列获取计算结果
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.DeQue<T>();

        // 2. 从 Local Memory 搬运到 Global Memory
        AscendC::DataCopy(
            zGm[progress * this->tileLength],
            zLocal,
            this->tileLength);

        // 3. 释放输出 Tensor
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;

    AscendC::TQue<
        AscendC::QuePosition::VECIN,
        QUEUE_DEPTH> inQueueX, inQueueY;

    AscendC::TQue<
        AscendC::QuePosition::VECOUT,
        QUEUE_DEPTH> outQueueZ;

    AscendC::GlobalTensor<T> xGm, yGm, zGm;

    uint32_t blockLength;
    uint32_t tileNum;
    uint32_t tileLength;
};

// ---------------------------------------------------------------------------
// 核函数入口
// ---------------------------------------------------------------------------
template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    KernelSub<T> op;

    op.Init(x, y, z, tiling);
    op.Process();
}

// ---------------------------------------------------------------------------
// host 侧启动函数
// ---------------------------------------------------------------------------
extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    constexpr uint32_t blockDim = 8;

    // 1. 获取 Tensor 信息
    const TensorInfo& t0 = info_x.tensors[0];

    // 2. 计算 Tensor 总元素数量
    int64_t totalLength = 1;

    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }

    // 3. 根据 dtype 选择 Kernel 类型
    int32_t dtype = t0.dtype;

    // 4. 设置 Tile 数量
    uint32_t tileNum = 8;

    // 5. 构造 Tiling 参数
    SubCustomTilingData tiling = {
        (uint32_t)totalLength,
        tileNum
    };

    // 6. 启动 Kernel
    if (dtype == 1) {
        // FP16
        sub_custom<half>
            <<<blockDim, nullptr, stream>>>(
                x,
                y,
                z,
                tiling);
    } else {
        // FP32
        sub_custom<float>
            <<<blockDim, nullptr, stream>>>(
                x,
                y,
                z,
                tiling);
    }
}