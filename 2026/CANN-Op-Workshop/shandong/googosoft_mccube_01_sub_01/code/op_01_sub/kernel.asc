#include <cstdint>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 *
 */

// The problem specifies contiguous ND tensors with shape (8, 2048).
constexpr uint32_t SUB_TOTAL_LENGTH = 8 * 2048;
constexpr uint32_t SUB_TILE_LENGTH = 2048;
constexpr uint32_t SUB_TILE_COUNT = SUB_TOTAL_LENGTH / SUB_TILE_LENGTH;
constexpr int32_t SUB_BUFFER_NUM = 2;

template <typename T>
class KernelSub {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z)
    {
        xGm.SetGlobalBuffer((__gm__ T*)x, SUB_TOTAL_LENGTH);
        yGm.SetGlobalBuffer((__gm__ T*)y, SUB_TOTAL_LENGTH);
        zGm.SetGlobalBuffer((__gm__ T*)z, SUB_TOTAL_LENGTH);
        pipe.InitBuffer(inQueueX, SUB_BUFFER_NUM, SUB_TILE_LENGTH * sizeof(T));
        pipe.InitBuffer(inQueueY, SUB_BUFFER_NUM, SUB_TILE_LENGTH * sizeof(T));
        pipe.InitBuffer(outQueueZ, SUB_BUFFER_NUM, SUB_TILE_LENGTH * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // Strided tile assignment also handles core counts that do not divide 8.
        for (uint32_t tile = AscendC::GetBlockIdx(); tile < SUB_TILE_COUNT;
             tile += AscendC::GetBlockNum()) {
            const uint32_t offset = tile * SUB_TILE_LENGTH;
            CopyIn(offset);
            Compute();
            CopyOut(offset);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm[offset], SUB_TILE_LENGTH);
        AscendC::DataCopy(yLocal, yGm[offset], SUB_TILE_LENGTH);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, SUB_TILE_LENGTH);
        outQueueZ.EnQue(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopy(zGm[offset], zLocal, SUB_TILE_LENGTH);
        outQueueZ.FreeTensor(zLocal);
    }

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, SUB_BUFFER_NUM> inQueueX, inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, SUB_BUFFER_NUM> outQueueZ;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;
};

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    KernelSub<T> op;
    op.Init(x, y, z);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    if (availableCoreNum <= 0) {
        return;
    }
    const uint32_t blockNum = availableCoreNum < SUB_TILE_COUNT
        ? static_cast<uint32_t>(availableCoreNum) : SUB_TILE_COUNT;
    if (info_x.tensors[0].dtype == 0) {
        sub_custom<float><<<blockNum, nullptr, stream>>>(x, y, z);
    } else if (info_x.tensors[0].dtype == 1) {
        sub_custom<half><<<blockNum, nullptr, stream>>>(x, y, z);
    }
}
