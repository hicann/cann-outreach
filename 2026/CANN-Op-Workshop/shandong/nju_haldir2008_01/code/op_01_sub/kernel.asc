#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 *
 * 计算功能：z = x - y
 *   实现方式：每个核处理一段连续数据，核内按 tile 做 CopyIn -> Compute(Sub) -> CopyOut 流水。
 *
 * 核函数：
 *   __global__ __vector__ void sub_custom_fp32(GM_ADDR x, GM_ADDR y, GM_ADDR z,
 *                                              uint32_t totalLength, uint32_t blockLength)
 *   __global__ __vector__ void sub_custom_fp16(GM_ADDR x, GM_ADDR y, GM_ADDR z,
 *                                              uint32_t totalLength, uint32_t blockLength)
 *   - totalLength: 整个 tensor 的元素个数
 *   - blockLength: 每个核负责的元素个数，核内起始下标 = GetBlockIdx() * blockLength
 */

using namespace AscendC;

constexpr int32_t BUFFER_NUM = 2;       // 双缓冲，让搬运与计算流水起来
constexpr uint32_t TILE_LENGTH = 2048;  // 单个 tile 的元素个数
constexpr uint32_t ALIGN_ELEM = 16;     // 32 字节对齐的元素数（fp16 下 16 个元素 = 32B）

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    // start: 本核在本 tensor 中的起始元素下标；length: 本核负责的元素个数
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t start, uint32_t length)
    {
        this->length = length;
        this->tileLength = (length < TILE_LENGTH) ? length : TILE_LENGTH;
        if (this->tileLength == 0) {
            this->tileLength = TILE_LENGTH;
        }

        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x) + start, length);
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(y) + start, length);
        zGm.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(z) + start, length);

        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        uint32_t fullTiles = length / tileLength;
        uint32_t tail = length - fullTiles * tileLength;
        uint32_t offset = 0;
        for (uint32_t i = 0; i < fullTiles; ++i) {
            CopyIn(offset, tileLength);
            Compute(tileLength);
            CopyOut(offset, tileLength);
            offset += tileLength;
        }
        if (tail > 0) {
            CopyIn(offset, tail);
            Compute(tail);
            CopyOut(offset, tail);
        }
    }

private:
    // 搬运长度非 32 字节对齐时改用 DataCopyPad（对齐场景走更高效的 DataCopy）
    __aicore__ inline bool NeedPad(uint32_t count)
    {
        return (count * sizeof(T)) % 32 != 0;
    }

    __aicore__ inline void CopyIn(uint32_t offset, uint32_t count)
    {
        LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        if (NeedPad(count)) {
            DataCopyExtParams copyParams{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
            DataCopyPadExtParams<T> padParams{};
            DataCopyPad(xLocal, xGm[offset], copyParams, padParams);
            DataCopyPad(yLocal, yGm[offset], copyParams, padParams);
        } else {
            DataCopy(xLocal, xGm[offset], count);
            DataCopy(yLocal, yGm[offset], count);
        }
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        Sub(zLocal, xLocal, yLocal, static_cast<int32_t>(count));
        outQueueZ.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t count)
    {
        LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        if (NeedPad(count)) {
            DataCopyExtParams copyParams{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
            DataCopyPad(zGm[offset], zLocal, copyParams);
        } else {
            DataCopy(zGm[offset], zLocal, count);
        }
        outQueueZ.FreeTensor(zLocal);
    }

private:
    TPipe pipe;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueX;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueY;
    TQue<TPosition::VECOUT, BUFFER_NUM> outQueueZ;
    GlobalTensor<T> xGm;
    GlobalTensor<T> yGm;
    GlobalTensor<T> zGm;
    uint32_t length = 0;
    uint32_t tileLength = 0;
};

// 每个核：从 blockIdx * blockLength 开始，处理 min(blockLength, 剩余) 个元素
template <typename T>
__aicore__ inline void SubKernelImpl(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t blockLength)
{
    uint32_t start = AscendC::GetBlockIdx() * blockLength;
    if (start >= totalLength) {
        return;  // 该核无数据可算
    }
    uint32_t length = totalLength - start;
    if (length > blockLength) {
        length = blockLength;
    }

    KernelSub<T> op;
    op.Init(x, y, z, start, length);
    op.Process();
}

extern "C" __global__ __vector__ void sub_custom_fp32(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                                      uint32_t totalLength, uint32_t blockLength)
{
    SubKernelImpl<float>(x, y, z, totalLength, blockLength);
}

extern "C" __global__ __vector__ void sub_custom_fp16(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                                      uint32_t totalLength, uint32_t blockLength)
{
    SubKernelImpl<half>(x, y, z, totalLength, blockLength);
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    if (availableCoreNum <= 0 || info_x.numTensors <= 0) {
        return;
    }

    const TensorInfo &tx = info_x.tensors[0];
    uint64_t totalLength = 1;
    for (int64_t i = 0; i < tx.numDims; ++i) {
        totalLength *= static_cast<uint64_t>(tx.shape[i]);
    }
    if (totalLength == 0) {
        return;
    }

    uint32_t blockNum = static_cast<uint32_t>(availableCoreNum);

    // 每个核负责的元素数：向上取整后再对齐到 32 字节，保证 GM 起始地址与搬运长度对齐
    uint64_t perCore = (totalLength + blockNum - 1) / blockNum;
    perCore = (perCore + ALIGN_ELEM - 1) / ALIGN_ELEM * ALIGN_ELEM;
    if (perCore > totalLength) {
        perCore = totalLength;
    }
    uint32_t blockLength = static_cast<uint32_t>(perCore);

    if (tx.dtype == 0) {  // float32
        sub_custom_fp32<<<blockNum, nullptr, stream>>>(x, y, z, static_cast<uint32_t>(totalLength), blockLength);
    } else if (tx.dtype == 1) {  // float16
        sub_custom_fp16<<<blockNum, nullptr, stream>>>(x, y, z, static_cast<uint32_t>(totalLength), blockLength);
    }
}
