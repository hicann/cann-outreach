#include <cmath>
#include <cstdint>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 *
 * z = x - y
 */

// ---------------------------------------------------------------------------
// Tiling 参数：由 host 侧 run_kernel 计算后按值传给核函数
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint32_t totalLength;  // 待处理数据总长度（元素个数），例如 8 * 2048 = 16384
    uint32_t tileNum;      // 单核内将数据进一步切分为多少块（Tile），例如 8
};

constexpr uint32_t BUFFER_NUM = 2;   // 每队列 buffer 块数：num=2 打开 Double Buffer
constexpr uint32_t QUEUE_DEPTH = 1;  // TQue 模板深度（双缓冲在 InitBuffer 的 num 参数上设置）

// ---------------------------------------------------------------------------
// KernelSub：z = x - y
//   多核切分按 32B 数据块（block）为单位均分，保证每个核的 GM 起始地址天然 32B 对齐；
//   单核内再按 tileNum × BUFFER_NUM 分块，由 TQue 双缓冲实现搬运与计算流水。
//   模板化以同时支持 float / half 两种数据类型。
// ---------------------------------------------------------------------------
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling)
    {
        // 32 字节对齐所需的元素个数：fp32 = 8，fp16 = 16
        constexpr uint32_t ALIGN_ELEM = 32 / sizeof(T);

        const uint32_t blockNum = AscendC::GetBlockNum();
        const uint32_t blockIdx = AscendC::GetBlockIdx();
        const uint32_t totalLength = tiling.totalLength;

        // --- 多核切分：以 32B 数据块为单位均分，余数分给前 remBlocks 个核 ---
        const uint32_t totalBlocks = (totalLength + ALIGN_ELEM - 1) / ALIGN_ELEM;
        const uint32_t baseBlocks = totalBlocks / blockNum;
        const uint32_t remBlocks = totalBlocks % blockNum;
        const uint32_t startBlock = blockIdx * baseBlocks + (blockIdx < remBlocks ? blockIdx : remBlocks);
        const uint32_t coreBlocks = baseBlocks + (blockIdx < remBlocks ? 1u : 0u);

        const uint32_t start = startBlock * ALIGN_ELEM;   // 必为 32B 对齐
        const uint32_t capacity = coreBlocks * ALIGN_ELEM;
        const uint32_t remaining = (totalLength > start) ? (totalLength - start) : 0u;
        this->coreLength = (remaining < capacity) ? remaining : capacity;

        // --- 单核内 tile 切分：tileLength 向下取整到 32B 对齐，保证 DataCopy 快路径 ---
        uint32_t tileLength = this->coreLength / (tiling.tileNum * BUFFER_NUM);
        tileLength = (tileLength / ALIGN_ELEM) * ALIGN_ELEM;
        if (tileLength == 0) {
            tileLength = ALIGN_ELEM;
        }
        this->tileLength = tileLength;
        this->processDataNum = tileLength;

        // 每个核只管辖自己那一段 Global Memory
        xGm.SetGlobalBuffer((__gm__ T *)x + start, this->coreLength);
        yGm.SetGlobalBuffer((__gm__ T *)y + start, this->coreLength);
        zGm.SetGlobalBuffer((__gm__ T *)z + start, this->coreLength);

        // 为三个队列分配 UB 内存（每个队列 BUFFER_NUM 块，构成 Double Buffer）
        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // 主体循环：每块 tileLength 个元素，长度严格 32B 对齐，走 DataCopy 快路径
        const uint32_t loopCount = this->coreLength / this->tileLength;
        this->processDataNum = this->tileLength;
        for (uint32_t i = 0; i < loopCount; i++) {
            CopyIn((int32_t)i);
            Compute((int32_t)i);
            CopyOut((int32_t)i);
        }

        // 尾部残块：长度不足 tileLength 且可能非 32B 对齐，走 DataCopyPad 避免 GM 越界
        const uint32_t processed = loopCount * this->tileLength;
        if (processed < this->coreLength) {
            this->processDataNum = this->coreLength - processed;
            CopyIn((int32_t)loopCount);
            Compute((int32_t)loopCount);
            CopyOut((int32_t)loopCount);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        // 为 LocalTensor 分配 UB 内存
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        const uint32_t offset = static_cast<uint32_t>(progress) * this->tileLength;

        constexpr uint32_t ALIGN_ELEM = 32 / sizeof(T);
        if ((this->processDataNum % ALIGN_ELEM) == 0) {
            // 32B 对齐：DataCopy 即可，性能最优
            AscendC::DataCopy(xLocal, xGm[offset], this->processDataNum);
            AscendC::DataCopy(yLocal, yGm[offset], this->processDataNum);
        } else {
            // 非对齐残块：blockLen 是有效字节数，只搬有效数据
            AscendC::DataCopyExtParams copyParams{
                1, static_cast<uint32_t>(this->processDataNum * sizeof(T)), 0, 0, 0};
            AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
            AscendC::DataCopyPad(xLocal, xGm[offset], copyParams, padParams);
            AscendC::DataCopyPad(yLocal, yGm[offset], copyParams, padParams);
        }

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(int32_t progress)
    {
        (void)progress;
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();

        // 矢量减法：z = x - y
        AscendC::Sub(zLocal, xLocal, yLocal, this->processDataNum);

        outQueueZ.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int32_t progress)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        const uint32_t offset = static_cast<uint32_t>(progress) * this->tileLength;

        constexpr uint32_t ALIGN_ELEM = 32 / sizeof(T);
        if ((this->processDataNum % ALIGN_ELEM) == 0) {
            AscendC::DataCopy(zGm[offset], zLocal, this->processDataNum);
        } else {
            AscendC::DataCopyExtParams copyParams{
                1, static_cast<uint32_t>(this->processDataNum * sizeof(T)), 0, 0, 0};
            AscendC::DataCopyPad(zGm[offset], zLocal, copyParams);
        }

        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;  // TPipe 内存管理对象
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueX, inQueueY;   // 输入队列
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH> outQueueZ;           // 输出队列
    AscendC::GlobalTensor<T> xGm, yGm, zGm;  // 输入 x/y，输出 z

    uint32_t coreLength;      // 本核负责的元素个数
    uint32_t tileLength;      // 单块元素个数（32B 对齐）
    uint32_t processDataNum;  // 本次实际搬运/计算的元素个数
};

// ---------------------------------------------------------------------------
// 核函数入口：实例化 KernelSub<T> 并执行（T 由 run_kernel 按输入 dtype 选择）
// ---------------------------------------------------------------------------
template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

// ---------------------------------------------------------------------------
// host 侧启动函数：从 TensorGroupInfo 推导 tiling 并启动核函数
// ---------------------------------------------------------------------------
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    (void)info_y;
    (void)info_z;

    // 1. 取总元素数（x/y/z 形状一致）
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }
    if (totalLength <= 0) {
        return;
    }

    // 2. 按输入 dtype 选择核函数实例（0=fp32 1=fp16 2=bf16 ...）
    const int32_t dtype = t0.dtype;
    const uint32_t typeSize = (dtype == 1) ? 2u : 4u;   // fp16 占 2 字节，其余按 4 字节处理
    const uint32_t alignElem = 32u / typeSize;
    const int64_t totalBlocks = (totalLength + alignElem - 1) / alignElem;

    // 3. 核数：默认 8（与参考实现一致），不超过可用核数，也不超过 32B 数据块总数
    int64_t blockDim = 8;
    if (availableCoreNum > 0 && availableCoreNum < blockDim) {
        blockDim = availableCoreNum;
    }
    if (blockDim > totalBlocks) {
        blockDim = totalBlocks;
    }
    if (blockDim < 1) {
        blockDim = 1;
    }

    // 为了简化计算，tileNum 设置为 8
    const uint32_t tileNum = 8;

    SubCustomTilingData tiling = {(uint32_t)totalLength, tileNum};
    if (dtype == 1) {
        // fp16：half 实例
        sub_custom<half><<<(uint32_t)blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        // fp32 及其他类型默认走 float 实例
        sub_custom<float><<<(uint32_t)blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}