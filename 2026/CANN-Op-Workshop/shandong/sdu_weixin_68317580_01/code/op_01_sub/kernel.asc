#include <cmath>
#include <cstdint>
#include "kernel_operator.h"

namespace {
constexpr uint32_t SUB_TILE_LENGTH = 2048;
constexpr uint32_t SUB_BUFFER_NUM = 2;

template <typename T>
class SubKernel {
public:
    __aicore__ inline SubKernel() {}

    __aicore__ inline void Init(
        GM_ADDR x, GM_ADDR y, GM_ADDR z, uint64_t totalLength)
    {
        totalLength_ = totalLength;

        xGm_.SetGlobalBuffer((__gm__ T*)x, totalLength);
        yGm_.SetGlobalBuffer((__gm__ T*)y, totalLength);
        zGm_.SetGlobalBuffer((__gm__ T*)z, totalLength);

        pipe_.InitBuffer(
            xQueue_, SUB_BUFFER_NUM, SUB_TILE_LENGTH * sizeof(T));
        pipe_.InitBuffer(
            yQueue_, SUB_BUFFER_NUM, SUB_TILE_LENGTH * sizeof(T));
        pipe_.InitBuffer(
            zQueue_, SUB_BUFFER_NUM, SUB_TILE_LENGTH * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // 每个核处理互不重叠的 tile。
        const uint64_t step =
            static_cast<uint64_t>(AscendC::GetBlockNum()) *
            SUB_TILE_LENGTH;

        for (uint64_t offset =
                 static_cast<uint64_t>(AscendC::GetBlockIdx()) *
                 SUB_TILE_LENGTH;
             offset < totalLength_;
             offset += step) {
            const uint64_t remaining = totalLength_ - offset;
            const uint32_t count =
                remaining < SUB_TILE_LENGTH
                    ? static_cast<uint32_t>(remaining)
                    : SUB_TILE_LENGTH;

            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
        }
    }

private:
    __aicore__ inline void CopyIn(uint64_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = xQueue_.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = yQueue_.AllocTensor<T>();

        // blockLen 的单位是字节，尾块只读取有效元素。
        AscendC::DataCopyExtParams copyParams = {
            1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0
        };
        AscendC::DataCopyPadExtParams<T> padParams = {
            false, 0, 0, static_cast<T>(0)
        };

        AscendC::DataCopyPad(
            xLocal, xGm_[offset], copyParams, padParams);
        AscendC::DataCopyPad(
            yLocal, yGm_[offset], copyParams, padParams);

        xQueue_.EnQue<T>(xLocal);
        yQueue_.EnQue<T>(yLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = xQueue_.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = yQueue_.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = zQueue_.AllocTensor<T>();

        AscendC::Sub(zLocal, xLocal, yLocal, count);

        zQueue_.EnQue<T>(zLocal);
        xQueue_.FreeTensor(xLocal);
        yQueue_.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint64_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> zLocal = zQueue_.DeQue<T>();

        AscendC::DataCopyExtParams copyParams = {
            1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0
        };

        // 只写回有效数据，不覆盖尾块之外的内存。
        AscendC::DataCopyPad(zGm_[offset], zLocal, copyParams);

        zQueue_.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe_;

    AscendC::TQue<AscendC::QuePosition::VECIN, 1> xQueue_;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> yQueue_;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> zQueue_;

    AscendC::GlobalTensor<T> xGm_, yGm_, zGm_;
    uint64_t totalLength_;
};
} // namespace

template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x, GM_ADDR y, GM_ADDR z, uint64_t totalLength)
{
    SubKernel<T> op;
    op.Init(x, y, z, totalLength);
    op.Process();
}

extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR y, const TensorGroupInfo& info_y,
    GM_ADDR z, const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    if (info_x.numTensors < 1 ||
        info_y.numTensors < 1 ||
        info_z.numTensors < 1) {
        return;
    }

    const TensorInfo& tx = info_x.tensors[0];
    const TensorInfo& ty = info_y.tensors[0];
    const TensorInfo& tz = info_z.tensors[0];

    // 本实现要求输入输出形状、类型一致。
    if (tx.dtype != ty.dtype || tx.dtype != tz.dtype ||
        tx.numDims != ty.numDims || tx.numDims != tz.numDims) {
        return;
    }

    // 仅支持 fp32 和 fp16。
    if (tx.dtype != 0 && tx.dtype != 1) {
        return;
    }

    uint64_t totalLength = 1;
    for (int64_t i = 0; i < tx.numDims; ++i) {
        if (tx.shape[i] <= 0 ||
            tx.shape[i] != ty.shape[i] ||
            tx.shape[i] != tz.shape[i]) {
            return;
        }

        const uint64_t dim = static_cast<uint64_t>(tx.shape[i]);
        if (totalLength > UINT64_MAX / dim) {
            return;
        }
        totalLength *= dim;
    }

    if (availableCoreNum <= 0) {
        return;
    }

    const uint64_t tileCount =
        totalLength / SUB_TILE_LENGTH +
        (totalLength % SUB_TILE_LENGTH != 0);

    uint64_t coreCount = static_cast<uint64_t>(availableCoreNum);
    if (coreCount > tileCount) {
        coreCount = tileCount;
    }
    if (coreCount > UINT32_MAX) {
        return;
    }

    const uint32_t blockNum = static_cast<uint32_t>(coreCount);

    if (tx.dtype == 1) {
        sub_custom<half><<<blockNum, nullptr, stream>>>(
            x, y, z, totalLength);
    } else {
        sub_custom<float><<<blockNum, nullptr, stream>>>(
            x, y, z, totalLength);
    }
}
