#include <cstdint>
#include "kernel_operator.h"

namespace explicit_sub {
constexpr uint32_t elements = 8 * 2048;
constexpr uint32_t batch = 1024;

template <typename Value>
__aicore__ inline void Evaluate(GM_ADDR a, GM_ADDR b, GM_ADDR c)
{
    AscendC::TPipe resources;
    AscendC::TBuf<AscendC::TPosition::VECIN> inputStorage;
    AscendC::TBuf<AscendC::TPosition::VECOUT> outputStorage;
    resources.InitBuffer(inputStorage, 2 * batch * sizeof(Value));
    resources.InitBuffer(outputStorage, batch * sizeof(Value));

    auto left = inputStorage.Get<Value>();
    auto right = left[batch];
    auto result = outputStorage.Get<Value>();
    AscendC::GlobalTensor<Value> sourceA, sourceB, destination;
    sourceA.SetGlobalBuffer(reinterpret_cast<__gm__ Value *>(a), elements);
    sourceB.SetGlobalBuffer(reinterpret_cast<__gm__ Value *>(b), elements);
    destination.SetGlobalBuffer(reinterpret_cast<__gm__ Value *>(c), elements);

    const auto loaded = resources.FetchEventID(AscendC::HardEvent::MTE2_V);
    const auto computed = resources.FetchEventID(AscendC::HardEvent::V_MTE3);
    const auto stored = resources.FetchEventID(AscendC::HardEvent::MTE3_MTE2);
    const uint32_t step = AscendC::GetBlockNum() * batch;

    for (uint32_t start = AscendC::GetBlockIdx() * batch; start < elements; start += step) {
        AscendC::DataCopy(left, sourceA[start], batch);
        AscendC::DataCopy(right, sourceB[start], batch);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(loaded);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(loaded);

        AscendC::Sub(result, left, right, batch);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(computed);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(computed);

        AscendC::DataCopy(destination[start], result, batch);
        // Complete the store before this storage is reused in the next round.
        AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(stored);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(stored);
    }
}

inline bool ValidTensor(const TensorGroupInfo &info)
{
    if (info.tensors == nullptr || info.numTensors < 1) return false;
    const auto &tensor = info.tensors[0];
    if (tensor.numDims != 2 || tensor.shape == nullptr) return false;
    return tensor.shape[0] == 8 && tensor.shape[1] == 2048 &&
           (tensor.dtype == 0 || tensor.dtype == 1);
}
} // namespace explicit_sub

__global__ __vector__ void subtract_with_events(GM_ADDR a, GM_ADDR b, GM_ADDR c, int32_t dtype)
{
    switch (dtype) {
        case 0: explicit_sub::Evaluate<float>(a, b, c); break;
        case 1: explicit_sub::Evaluate<half>(a, b, c); break;
    }
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo &info_x,
                           GM_ADDR y, const TensorGroupInfo &info_y,
                           GM_ADDR z, const TensorGroupInfo &info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    if (!explicit_sub::ValidTensor(info_x) || !explicit_sub::ValidTensor(info_y) ||
        !explicit_sub::ValidTensor(info_z)) return;
    const int32_t dtype = info_x.tensors[0].dtype;
    if (dtype != info_y.tensors[0].dtype || dtype != info_z.tensors[0].dtype) return;

    uint32_t blocks = 1;
    if (availableCoreNum > 0) {
        blocks = availableCoreNum >= 16 ? 16 : static_cast<uint32_t>(availableCoreNum);
    }
    subtract_with_events<<<blocks, nullptr, stream>>>(x, y, z, dtype);
}
