#include "kernel_operator.h"

// Host 侧完成所有能够提前完成的 Tiling 计算
struct SubCustomTilingData {
    uint32_t blockLength;
};

constexpr uint32_t BUFFER_NUM = 1;
constexpr uint32_t QUEUE_DEPTH = 1;

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        const SubCustomTilingData& tiling)
    {
        blockLength = tiling.blockLength;

        const uint32_t blockIdx = AscendC::GetBlockIdx();
        const uint32_t offset = blockIdx * blockLength;

        xGm.SetGlobalBuffer(
            reinterpret_cast<__gm__ T*>(x) + offset,
            blockLength);

        yGm.SetGlobalBuffer(
            reinterpret_cast<__gm__ T*>(y) + offset,
            blockLength);

        zGm.SetGlobalBuffer(
            reinterpret_cast<__gm__ T*>(z) + offset,
            blockLength);

        // 每核整个 block 一次进入 UB
        pipe.InitBuffer(
            inQueueX,
            BUFFER_NUM,
            blockLength * sizeof(T));

        pipe.InitBuffer(
            inQueueY,
            BUFFER_NUM,
            blockLength * sizeof(T));

        pipe.InitBuffer(
            outQueueZ,
            BUFFER_NUM,
            blockLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        CopyIn();
        Compute();
        CopyOut();
    }

private:
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<T> xLocal =
            inQueueX.AllocTensor<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.AllocTensor<T>();

        AscendC::DataCopy(
            xLocal,
            xGm,
            blockLength);

        AscendC::DataCopy(
            yLocal,
            yGm,
            blockLength);

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> xLocal =
            inQueueX.DeQue<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.DeQue<T>();

        AscendC::LocalTensor<T> zLocal =
            outQueueZ.AllocTensor<T>();

        AscendC::Sub(
            zLocal,
            xLocal,
            yLocal,
            blockLength);

        outQueueZ.EnQue(zLocal);

        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.DeQue<T>();

        AscendC::DataCopy(
            zGm,
            zLocal,
            blockLength);

        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;

    AscendC::TQue<
        AscendC::QuePosition::VECIN,
        QUEUE_DEPTH> inQueueX;

    AscendC::TQue<
        AscendC::QuePosition::VECIN,
        QUEUE_DEPTH> inQueueY;

    AscendC::TQue<
        AscendC::QuePosition::VECOUT,
        QUEUE_DEPTH> outQueueZ;

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    uint32_t blockLength;
};


template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}


extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    constexpr uint32_t BLOCK_DIM = 8;

    const TensorInfo& t0 = info_x.tensors[0];

    uint32_t totalLength = 1;

    for (int64_t i = 0; i < t0.numDims; ++i) {
        totalLength *= static_cast<uint32_t>(t0.shape[i]);
    }

    // 当前测试数据保证可以被 8 核整除
    const uint32_t blockLength =
        totalLength / BLOCK_DIM;

    SubCustomTilingData tiling {
        blockLength
    };

    if (t0.dtype == 1) {
        sub_custom<half>
            <<<BLOCK_DIM, nullptr, stream>>>(
                x, y, z, tiling);
    } else {
        sub_custom<float>
            <<<BLOCK_DIM, nullptr, stream>>>(
                x, y, z, tiling);
    }
}