#include <cstdint>
#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 *
 * z = x - y, shape (8, 2048), dtype float32 / float16, format ND.
 */

constexpr int32_t BUFFER_NUM = 2;
// 2048 elements: 32-byte aligned for both fp32 (8 elems) and fp16 (16 elems).
constexpr int32_t TILE_LENGTH = 2048;

struct SubCustomTilingData {
    uint32_t totalLength;
    uint32_t blockNum;
    uint32_t formerNum;
    uint32_t formerLength;
    uint32_t tailLength;
    uint32_t tileLength;
    int32_t dtype;
};

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData &tiling)
    {
        this->tileLength = (tiling.tileLength > 0) ? tiling.tileLength : static_cast<uint32_t>(TILE_LENGTH);
        const uint32_t blockIdx = AscendC::GetBlockIdx();

        uint32_t start = 0;
        if (blockIdx < tiling.formerNum) {
            this->coreLength = tiling.formerLength;
            start = blockIdx * this->coreLength;
        } else {
            this->coreLength = tiling.tailLength;
            start = tiling.formerNum * tiling.formerLength +
                    (blockIdx - tiling.formerNum) * this->coreLength;
        }

        if (this->coreLength > 0) {
            xGm.SetGlobalBuffer((__gm__ T *)x + start, this->coreLength);
            yGm.SetGlobalBuffer((__gm__ T *)y + start, this->coreLength);
            zGm.SetGlobalBuffer((__gm__ T *)z + start, this->coreLength);
        }

        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        uint32_t offset = 0;
        while (offset < this->coreLength) {
            uint32_t count = this->coreLength - offset;
            if (count > this->tileLength) {
                count = this->tileLength;
            }
            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
            offset += count;
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm[offset], count);
        AscendC::DataCopy(yLocal, yGm[offset], count);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, count);
        outQueueZ.EnQue(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopy(zGm[offset], zLocal, count);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, BUFFER_NUM> inQueueX;
    AscendC::TQue<AscendC::QuePosition::VECIN, BUFFER_NUM> inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, BUFFER_NUM> outQueueZ;
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;
    uint32_t tileLength = 0;
    uint32_t coreLength = 0;
};

extern "C" __global__ __aicore__ void sub_custom(
    GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t formerNum, uint32_t formerLength,
    uint32_t tailLength, uint32_t tileLength, int32_t dtype)
{
    SubCustomTilingData tiling;
    tiling.totalLength = 0;
    tiling.blockNum = 0;
    tiling.formerNum = formerNum;
    tiling.formerLength = formerLength;
    tiling.tailLength = tailLength;
    tiling.tileLength = tileLength;
    tiling.dtype = dtype;

    if (dtype == 1) {
        KernelSub<half> op;
        op.Init(x, y, z, tiling);
        op.Process();
    } else {
        KernelSub<float> op;
        op.Init(x, y, z, tiling);
        op.Process();
    }
}

static inline uint32_t AlignDownLen(uint32_t value, uint32_t align)
{
    return (align == 0) ? value : (value / align * align);
}

static inline uint32_t TensorNumel(const TensorInfo &info)
{
    uint32_t numel = 1;
    for (int64_t i = 0; i < info.numDims; ++i) {
        numel *= static_cast<uint32_t>(info.shape[i]);
    }
    return numel;
}

void run_kernel(GM_ADDR x, TensorGroupInfo info_x, GM_ADDR y, TensorGroupInfo info_y,
                GM_ADDR z, TensorGroupInfo info_z, uint32_t availableCoreNum, void *stream)
{
    (void)info_y;
    (void)info_z;

    const TensorInfo &tin = info_x.tensors[0];
    const uint32_t totalLength = TensorNumel(tin);
    const int32_t dtype = tin.dtype;
    const uint32_t elemBytes = (dtype == 1) ? 2u : 4u;
    const uint32_t align = 32 / elemBytes;

    uint32_t tileLength = static_cast<uint32_t>(TILE_LENGTH);
    if (tileLength > totalLength) {
        tileLength = AlignDownLen(totalLength, align);
        if (tileLength == 0) {
            tileLength = align;
        }
    }

    uint32_t units = (align == 0) ? totalLength : (totalLength / align);
    if (units == 0) {
        units = 1;
    }

    uint32_t blockNum = availableCoreNum;
    if (blockNum < 1) {
        blockNum = 1;
    }
    if (blockNum > units) {
        blockNum = units;
    }
    while (blockNum > 1 && (units % blockNum) != 0) {
        --blockNum;
    }

    const uint32_t formerLength = totalLength / blockNum;
    const uint32_t formerNum = blockNum;
    const uint32_t tailLength = formerLength;

    sub_custom<<<blockNum, nullptr, stream>>>(
        x, y, z, formerNum, formerLength, tailLength, tileLength, dtype);
}

