#include <cmath>
#include "kernel_operator.h"

// ---------------------------------------------------------------------------
// Tiling 参数：由 host 侧 run_kernel 计算后按值传给核函数
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint32_t totalLength; // 待处理数据总长度（单位：元素个数），例如 8 * 2048
    uint32_t tileNum;     // 单核内将数据进一步切分为多少块（Tile），例如 8
};

constexpr uint32_t BUFFER_NUM = 2;   // 每队列 buffer 块数
constexpr uint32_t QUEUE_DEPTH = 1;

// ---------------------------------------------------------------------------
// KernelSub：z = x - y
// ---------------------------------------------------------------------------
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling)
    {
        uint32_t totalLength = tiling.totalLength;
        uint32_t tileNum = tiling.tileNum;
        
        // 计算每个核处理的数据长度（多核并行）
        uint32_t blockNum = AscendC::GetBlockNum();
        this->blockLength = totalLength / blockNum;
        
        // 处理最后一个核可能处理更多数据的情况
        if (AscendC::GetBlockIdx() == blockNum - 1) {
            this->blockLength = totalLength - this->blockLength * (blockNum - 1);
        }
        
        // 单核内分块数
        this->tileNum = tileNum;
        
        // 单次处理的元素数（每块长度），确保不会小于1
        uint32_t tempTileLength = this->blockLength / tileNum / BUFFER_NUM;
        this->tileLength = tempTileLength > 0 ? tempTileLength : 1;
        
        // 重新调整tileNum以确保覆盖所有数据
        uint32_t totalTiles = this->blockLength / this->tileLength;
        this->tileNum = totalTiles > tileNum ? totalTiles : tileNum;
        
        // 设置每个核的 Global Memory 起始地址
        xGm.SetGlobalBuffer((__gm__ T *)x + this->blockLength * AscendC::GetBlockIdx(), this->blockLength);
        yGm.SetGlobalBuffer((__gm__ T *)y + this->blockLength * AscendC::GetBlockIdx(), this->blockLength);
        zGm.SetGlobalBuffer((__gm__ T *)z + this->blockLength * AscendC::GetBlockIdx(), this->blockLength);
        
        // 为队列分配 UB 内存
        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // 计算实际需要的循环次数
        uint32_t totalLength = this->blockLength;
        uint32_t processedLength = 0;
        
        while (processedLength < totalLength) {
            uint32_t currentTileLength = this->tileLength;
            // 处理最后一块可能不足tileLength的情况
            if (processedLength + currentTileLength > totalLength) {
                currentTileLength = totalLength - processedLength;
            }
            
            CopyIn(processedLength, currentTileLength);
            Compute(currentTileLength);
            CopyOut(processedLength, currentTileLength);
            
            processedLength += currentTileLength;
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset, uint32_t length)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        
        AscendC::DataCopy(xLocal, xGm[offset], length);
        AscendC::DataCopy(yLocal, yGm[offset], length);
        
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t length)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        
        AscendC::Sub(zLocal, xLocal, yLocal, length);
        
        outQueueZ.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t length)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopy(zGm[offset], zLocal, length);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueX, inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH> outQueueZ;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;

    uint32_t blockLength;
    uint32_t tileNum;
    uint32_t tileLength;
};

// ---------------------------------------------------------------------------
// 核函数入口：修正 __vector__ 为 __aicore__
// ---------------------------------------------------------------------------
template <typename T>
__global__ __aicore__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

// ---------------------------------------------------------------------------
// host 侧启动函数
// ---------------------------------------------------------------------------
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    constexpr uint32_t blockDim = 8;
    const TensorInfo& t0 = info_x.tensors[0];
    
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }
    
    int32_t dtype = t0.dtype;
    
    // 动态计算tileNum，避免硬编码为8导致小数据量时tileLength为0
    uint32_t tileNum = 8;
    if (totalLength < blockDim * tileNum * BUFFER_NUM) {
        tileNum = 1;
    }
    
    SubCustomTilingData tiling = {(uint32_t)totalLength, tileNum};
    
    if (dtype == 1) {
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}