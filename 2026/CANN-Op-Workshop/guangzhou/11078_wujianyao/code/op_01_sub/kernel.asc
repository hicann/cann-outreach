#include <cmath>
#include "kernel_operator.h"

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
#endif

using namespace AscendC;

constexpr int BUFFER_NUM = 2;

// z=x-y
// shape: (8,2048), total elements=16384

template<typename T>
__global__ __aicore__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, int64_t total)
{
    TPipe pipe;

    int64_t blockId = GetBlockIdx();
    int64_t blockNum = GetBlockNum();

    int64_t blockLength = (total + blockNum - 1) / blockNum;
    int64_t offset = blockId * blockLength;
    int64_t length = blockLength;
    if (offset + length > total) {
        length = total - offset;
    }
    if (length <= 0) {
        return;
    }

    GlobalTensor<T> xGm;
    GlobalTensor<T> yGm;
    GlobalTensor<T> zGm;

    xGm.SetGlobalBuffer((__gm__ T*)x + offset, length);
    yGm.SetGlobalBuffer((__gm__ T*)y + offset, length);
    zGm.SetGlobalBuffer((__gm__ T*)z + offset, length);

    TQue<QuePosition::VECIN, BUFFER_NUM> xQueue;
    TQue<QuePosition::VECIN, BUFFER_NUM> yQueue;
    TQue<QuePosition::VECOUT, BUFFER_NUM> zQueue;

    pipe.InitBuffer(xQueue, BUFFER_NUM, length * sizeof(T));
    pipe.InitBuffer(yQueue, BUFFER_NUM, length * sizeof(T));
    pipe.InitBuffer(zQueue, BUFFER_NUM, length * sizeof(T));

    LocalTensor<T> xLocal = xQueue.AllocTensor<T>();
    LocalTensor<T> yLocal = yQueue.AllocTensor<T>();
    LocalTensor<T> zLocal = zQueue.AllocTensor<T>();

    DataCopy(xLocal, xGm, length);
    DataCopy(yLocal, yGm, length);

    xQueue.EnQue(xLocal);
    yQueue.EnQue(yLocal);

    xLocal = xQueue.DeQue<T>();
    yLocal = yQueue.DeQue<T>();

    Sub(zLocal, xLocal, yLocal, length);

    zQueue.EnQue(zLocal);
    zLocal = zQueue.DeQue<T>();

    DataCopy(zGm, zLocal, length);

    xQueue.FreeTensor(xLocal);
    yQueue.FreeTensor(yLocal);
    zQueue.FreeTensor(zLocal);
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                            GM_ADDR y, const TensorGroupInfo& info_y,
                            GM_ADDR z, const TensorGroupInfo& info_z,
                            int64_t availableCoreNum, aclrtStream stream)
{
    int64_t total = 8 * 2048;
    int32_t dtype = info_x.tensors[0].dtype;

    int blockNum = availableCoreNum;
    if (blockNum > 8) blockNum = 8;

    if (dtype == 0) {
        sub_custom<float><<<blockNum, nullptr, stream>>>(x, y, z, total);
    } else if (dtype == 1) {
        sub_custom<half><<<blockNum, nullptr, stream>>>(x, y, z, total);
    }
}
