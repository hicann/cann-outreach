#include "kernel_operator.h"

template<typename T>
__global__ __vector__ void sub_custom_kernel(GM_ADDR x, GM_ADDR y, GM_ADDR z, int64_t totalLength)
{
    uint32_t blockIdx = AscendC::GetBlockIdx();
    uint32_t blockNum = AscendC::GetBlockNum();
    
    // 计算当前核处理的数据量
    uint32_t elementsPerBlock = totalLength / blockNum;
    if (blockIdx == blockNum - 1) {
        elementsPerBlock = totalLength - elementsPerBlock * (blockNum - 1);
    }
    uint32_t startOffset = blockIdx * (totalLength / blockNum);

    if (elementsPerBlock == 0) return;

    // 设置 GlobalTensors
    AscendC::GlobalTensor<T> xGlobal, yGlobal, zGlobal;
    xGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x) + startOffset, elementsPerBlock);
    yGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y) + startOffset, elementsPerBlock);
    zGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z) + startOffset, elementsPerBlock);

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueX, inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueZ;

    // 在 UB 中分配内存 (注意使用 sizeof(T) 兼容 float16 和 float32)
    pipe.InitBuffer(inQueueX, 1, elementsPerBlock * sizeof(T));
    pipe.InitBuffer(inQueueY, 1, elementsPerBlock * sizeof(T));
    pipe.InitBuffer(outQueueZ, 1, elementsPerBlock * sizeof(T));

    // 从 GM 搬运到 UB
    AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
    AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
    
    AscendC::DataCopy(xLocal, xGlobal, elementsPerBlock);
    AscendC::DataCopy(yLocal, yGlobal, elementsPerBlock);

    inQueueX.EnQue(xLocal);
    inQueueY.EnQue(yLocal);

    xLocal = inQueueX.DeQue<T>();
    yLocal = inQueueY.DeQue<T>();

    // 执行减法计算
    AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
    AscendC::Sub(zLocal, xLocal, yLocal, elementsPerBlock);

    outQueueZ.EnQue(zLocal);
    zLocal = outQueueZ.DeQue<T>();
    
    // 将结果搬运回 GM
    AscendC::DataCopy(zGlobal, zLocal, elementsPerBlock);

    // 释放 Tensor
    inQueueX.FreeTensor(xLocal);
    inQueueY.FreeTensor(yLocal);
    outQueueZ.FreeTensor(zLocal);
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    // 1. 计算总元素数量
    int64_t totalLength = 1;
    for (int64_t i = 0; i < info_x.tensors[0].numDims; ++i) {
        totalLength *= info_x.tensors[0].shape[i];
    }

    // 2. 获取数据类型 (0=fp32 1=fp16)
    int32_t dtype = info_x.tensors[0].dtype;
    
    // 3. 使用 1 个核，保证绝对安全，避免数据切分对齐问题（数据量很小，单核足够）
    uint32_t blockNum = 1; 

    if (dtype == 0) { // FLOAT32
        sub_custom_kernel<float><<<blockNum, nullptr, stream>>>(x, y, z, totalLength);
    } else if (dtype == 1) { // FLOAT16
        sub_custom_kernel<half><<<blockNum, nullptr, stream>>>(x, y, z, totalLength);
    }
}