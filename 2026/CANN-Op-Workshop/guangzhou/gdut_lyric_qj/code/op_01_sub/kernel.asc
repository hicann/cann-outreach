#include <climits>
#include <cstdint>
#include "kernel_operator.h"

// ---------------------------------------------------------------------------
// Tiling 参数：由 host 侧 run_kernel 计算后按值传给核函数
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint32_t blockLength; // 每个核处理的元素个数
    uint32_t tileLength;  // 每次流水处理的元素个数
    uint32_t loopCount;   // 每个核的流水循环次数
};

constexpr uint32_t BUFFER_NUM = 2;   // double buffer
constexpr uint32_t QUEUE_DEPTH = 1;
constexpr uint32_t MAX_BLOCK_DIM = 8;
constexpr uint32_t TILE_NUM = 8;

// ---------------------------------------------------------------------------
// KernelSub：z = x - y，每核分块循环计算（模板化，支持 float / half 等类型）
// ---------------------------------------------------------------------------
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling)
    {
        this->blockLength = tiling.blockLength;
        this->tileLength = tiling.tileLength;
        this->loopCount = tiling.loopCount;
        // 设置每个核的 Global Memory 起始地址（关键的多核切分逻辑）
        xGm.SetGlobalBuffer((__gm__ T *)x + this->blockLength * AscendC::GetBlockIdx(), this->blockLength);
        yGm.SetGlobalBuffer((__gm__ T *)y + this->blockLength * AscendC::GetBlockIdx(), this->blockLength);
        zGm.SetGlobalBuffer((__gm__ T *)z + this->blockLength * AscendC::GetBlockIdx(), this->blockLength);
        // 为队列分配内存（单核内流水并行的基础）
        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // 依次处理每个数据块
        for (uint32_t i = 0; i < this->loopCount; i++) {
            CopyIn(i);    // 搬入第 i 块数据
            Compute();    // 计算第 i 块数据
            CopyOut(i);   // 搬出第 i 块结果
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t progress)
    {
        // 为 LocalTensor 分配内存
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        // 计算当前数据块的起始位置，从 Global Memory 搬入数据到 Local Memory
        AscendC::DataCopy(xLocal, xGm[progress * this->tileLength], this->tileLength);
        AscendC::DataCopy(yLocal, yGm[progress * this->tileLength], this->tileLength);
        // 将数据放入队列，通知 Compute 任务
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        // 从输入队列获取数据
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        // 为计算结果分配内存
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        // 执行矢量减法计算
        AscendC::Sub(zLocal, xLocal, yLocal, this->tileLength);
        // 将计算结果放入输出队列，通知 CopyOut 任务
        outQueueZ.EnQue<T>(zLocal);
        // 释放输入数据内存（重要：避免内存泄漏）
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t progress)
    {
        // 从输出队列获取计算结果
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        // 计算当前数据块的输出位置，将结果从 Local Memory 搬出到 Global Memory
        AscendC::DataCopy(zGm[progress * this->tileLength], zLocal, this->tileLength);
        // 释放输出数据内存
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;  // TPipe 内存管理对象
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueX, inQueueY;  // 输入数据队列管理对象，VECIN 位置
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH> outQueueZ;  // 输出数据队列管理对象，VECOUT 位置
    AscendC::GlobalTensor<T> xGm, yGm, zGm; // 管理输入输出 Global Memory 地址的对象，其中 xGm、yGm 为输入，zGm 为输出

    uint32_t blockLength; // 每个核的计算数据长度
    uint32_t tileLength; // 每个核内每次流水处理的元素数
    uint32_t loopCount; // 每个核的流水循环次数
};

// ---------------------------------------------------------------------------
// 核函数入口：实例化 KernelSub<T> 并执行（T 由 run_kernel 按输入 dtype 选择）
// ---------------------------------------------------------------------------
template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

// ---------------------------------------------------------------------------
// host 侧启动函数：从 TensorGroupInfo 推导 tiling 并启动核函数
// ---------------------------------------------------------------------------
inline bool IsValidTensorGroup(const TensorGroupInfo& info)
{
    return info.tensors != nullptr && info.numTensors == 1 &&
           info.tensors[0].shape != nullptr && info.tensors[0].numDims > 0;
}

inline bool HasSameShapeAndDtype(const TensorInfo& lhs, const TensorInfo& rhs)
{
    if (lhs.dtype != rhs.dtype || lhs.numDims != rhs.numDims) {
        return false;
    }
    for (int64_t i = 0; i < lhs.numDims; ++i) {
        if (lhs.shape[i] != rhs.shape[i]) {
            return false;
        }
    }
    return true;
}

// 返回 0 表示启动成功，非 0 表示输入或 tiling 不受支持。
extern "C" int run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    if (x == nullptr || y == nullptr || z == nullptr || stream == nullptr ||
        availableCoreNum <= 0 || !IsValidTensorGroup(info_x) ||
        !IsValidTensorGroup(info_y) || !IsValidTensorGroup(info_z)) {
        return 1;
    }

    const TensorInfo& xInfo = info_x.tensors[0];
    if (!HasSameShapeAndDtype(xInfo, info_y.tensors[0]) ||
        !HasSameShapeAndDtype(xInfo, info_z.tensors[0])) {
        return 2;
    }
    if (xInfo.numDims != 2 || xInfo.shape[0] != 8 || xInfo.shape[1] != 2048) {
        return 3;
    }
    // 当前实现只实例化 FP32 与 FP16，拒绝把其他 dtype 静默解释为 float。
    if (xInfo.dtype != 0 && xInfo.dtype != 1) {
        return 4;
    }

    uint64_t totalLength = 1;
    for (int64_t i = 0; i < xInfo.numDims; ++i) {
        if (xInfo.shape[i] <= 0 ||
            totalLength > static_cast<uint64_t>(UINT32_MAX) /
                              static_cast<uint64_t>(xInfo.shape[i])) {
            return 5;
        }
        totalLength *= static_cast<uint64_t>(xInfo.shape[i]);
    }

    // 从可用核数向下选择能整除数据的核数，避免静默遗漏尾部元素。
    uint32_t blockDim = static_cast<uint32_t>(availableCoreNum);
    if (blockDim > MAX_BLOCK_DIM) {
        blockDim = MAX_BLOCK_DIM;
    }
    const uint32_t loopCount = TILE_NUM * BUFFER_NUM;
    while (blockDim > 1 && totalLength % (blockDim * loopCount) != 0) {
        --blockDim;
    }
    if (totalLength % (blockDim * loopCount) != 0) {
        return 6;
    }

    const uint32_t blockLength = static_cast<uint32_t>(totalLength / blockDim);
    const uint32_t tileLength = blockLength / loopCount;
    // DataCopy 的数据块按 32 字节对齐；不满足时应使用专门的非对齐搬运实现。
    const uint32_t elementSize = xInfo.dtype == 1 ? sizeof(half) : sizeof(float);
    if ((tileLength * elementSize) % 32 != 0) {
        return 7;
    }

    SubCustomTilingData tiling = {blockLength, tileLength, loopCount};
    if (xInfo.dtype == 1) {
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
    return 0;
}