#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 */

// Shape is fixed at (8, 2048) = 16384 elements; 8 cores x 2048 elements each.
constexpr uint32_t SUB_NUM_BLOCKS = 8;
constexpr uint32_t SUB_BLOCK_LENGTH = 2048;

template <typename T>
__vector__ __global__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    AscendC::InitSocState();

    AscendC::GlobalTensor<T> xGm, yGm, zGm;
    xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x) + block_idx * SUB_BLOCK_LENGTH, SUB_BLOCK_LENGTH);
    yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y) + block_idx * SUB_BLOCK_LENGTH, SUB_BLOCK_LENGTH);
    zGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z) + block_idx * SUB_BLOCK_LENGTH, SUB_BLOCK_LENGTH);

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<T> xLocal = ubAllocator.Alloc<T, SUB_BLOCK_LENGTH>();
    AscendC::LocalTensor<T> yLocal = ubAllocator.Alloc<T, SUB_BLOCK_LENGTH>();
    AscendC::LocalTensor<T> zLocal = ubAllocator.Alloc<T, SUB_BLOCK_LENGTH>();

    AscendC::DataCopy(xLocal, xGm, SUB_BLOCK_LENGTH);
    AscendC::DataCopy(yLocal, yGm, SUB_BLOCK_LENGTH);
    AscendC::PipeBarrier<PIPE_ALL>();

    AscendC::Sub(zLocal, xLocal, yLocal, SUB_BLOCK_LENGTH);
    AscendC::PipeBarrier<PIPE_ALL>();

    AscendC::DataCopy(zGm, zLocal, SUB_BLOCK_LENGTH);
    AscendC::PipeBarrier<PIPE_ALL>();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    const int32_t dtype = info_x.tensors[0].dtype;
    if (dtype == 0) {
        sub_custom<float><<<SUB_NUM_BLOCKS, 0, stream>>>(x, y, z);
    } else if (dtype == 1) {
        sub_custom<half><<<SUB_NUM_BLOCKS, 0, stream>>>(x, y, z);
    }
}
