#include <cmath>
#include "kernel_operator.h"

struct SubCustomTilingData {
    uint32_t totalLength; 
    uint32_t tileNum;     
};

constexpr uint32_t BUF_NUM = 2;
constexpr uint32_t QDEPTH = 1;

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling) {
        uint32_t totalLen = tiling.totalLength;
        uint32_t tnum = tiling.tileNum;
        this->blkLen = totalLen / AscendC::GetBlockNum();
        this->tn = tnum;
        this->tlen = this->blkLen / tnum / BUF_NUM;
        xGm.SetGlobalBuffer((__gm__ T *)x + this->blkLen * AscendC::GetBlockIdx(), this->blkLen);
        yGm.SetGlobalBuffer((__gm__ T *)y + this->blkLen * AscendC::GetBlockIdx(), this->blkLen);
        zGm.SetGlobalBuffer((__gm__ T *)z + this->blkLen * AscendC::GetBlockIdx(), this->blkLen);
        pipe.InitBuffer(inQX, BUF_NUM, this->tlen * sizeof(T));
        pipe.InitBuffer(inQY, BUF_NUM, this->tlen * sizeof(T));
        pipe.InitBuffer(outQZ, BUF_NUM, this->tlen * sizeof(T));
    }
    __aicore__ inline void Process() {
        int32_t loopCnt = this->tn * BUF_NUM;
        for (int32_t i = 0; i < loopCnt; i++) {
            LoadIn(i);
            Calc(i);
            StoreOut(i);
        }
    }
private:
    __aicore__ inline void LoadIn(int32_t prog) {
        AscendC::LocalTensor<T> xLoc = inQX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLoc = inQY.AllocTensor<T>();
        AscendC::DataCopy(xLoc, xGm[prog * this->tlen], this->tlen);
        AscendC::DataCopy(yLoc, yGm[prog * this->tlen], this->tlen);
        inQX.EnQue(xLoc);
        inQY.EnQue(yLoc);
    }
    __aicore__ inline void Calc(int32_t prog) {
        AscendC::LocalTensor<T> xLoc = inQX.DeQue<T>();
        AscendC::LocalTensor<T> yLoc = inQY.DeQue<T>();
        AscendC::LocalTensor<T> zLoc = outQZ.AllocTensor<T>();
        AscendC::Sub(zLoc, xLoc, yLoc, this->tlen);
        outQZ.EnQue<T>(zLoc);
        inQX.FreeTensor(xLoc);
        inQY.FreeTensor(yLoc);
    }
    __aicore__ inline void StoreOut(int32_t prog) {
        AscendC::LocalTensor<T> zLoc = outQZ.DeQue<T>();
        AscendC::DataCopy(zGm[prog * this->tlen], zLoc, this->tlen);
        outQZ.FreeTensor(zLoc);
    }
private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, QDEPTH> inQX, inQY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, QDEPTH> outQZ;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;
    uint32_t blkLen;
    uint32_t tn;
    uint32_t tlen;
};

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling) {
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream) {
    constexpr uint32_t blockDim = 8;
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLen = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLen *= t0.shape[i];
    }
    int32_t dtype = t0.dtype;
    uint32_t tn = 8;
    SubCustomTilingData tiling = {(uint32_t)totalLen, tn};
    if (dtype == 1) {
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}