#include <cmath>
#include "kernel_operator.h"

// ---------------------------------------------------------------------------
// Tiling 参数：由 host 侧 run_kernel 计算后按值传给核函数
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint32_t totalLength; // 待处理数据总长度（单位：元素个数），例如 8 * 2048
    uint32_t tileNum;     // 保留字段（兼容原接口），当前实现按 UB 容量自动决定分块
};

constexpr uint32_t BUFFER_NUM = 2;            // double buffer
constexpr uint32_t QUEUE_DEPTH = 1;
constexpr uint32_t ALIGN_BYTES = 32;          // DataCopy 要求地址与长度均按 32B 对齐
constexpr uint32_t MAX_TILE_BYTES = 8192;     // 单个 Tile 字节上限：每核数据尽量一次搬完
constexpr uint32_t MIN_ELEMS_PER_CORE = 3800; // 每核至少处理的元素数，避免核多数据少

// ---------------------------------------------------------------------------
// KernelSub：z = x - y，每核分块循环计算（模板化，支持 float / half 等类型）
// ---------------------------------------------------------------------------
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling)
    {
        const uint32_t alignElems = ALIGN_BYTES / sizeof(T);
        const uint32_t blockNum = AscendC::GetBlockNum();
        const uint32_t blockIdx = AscendC::GetBlockIdx();
        const uint32_t totalLength = tiling.totalLength;

        this->xPtr = (__gm__ T *)x;
        this->yPtr = (__gm__ T *)y;
        this->zPtr = (__gm__ T *)z;

        // 32B 对齐的主区间 + 不足 32B 的尾部（尾部由最后一个核标量处理）
        this->mainLength = totalLength / alignElems * alignElems;
        this->tailLength = totalLength - this->mainLength;

        // 多核切分：每核长度向上取整到 alignElems，保证各核 GM 起始地址 32B 对齐
        uint32_t perCore = (this->mainLength + blockNum - 1) / blockNum;
        perCore = (perCore + alignElems - 1) / alignElems * alignElems;
        const uint32_t start = blockIdx * perCore;
        if (start < this->mainLength) {
            const uint32_t remain = this->mainLength - start;
            this->blockLength = (remain < perCore) ? remain : perCore;
        } else {
            this->blockLength = 0;
        }

        // 大块搬运：每核数据尽量一次搬完（大块 MTE 有效带宽远高于小块）
        uint32_t tileLen = this->blockLength;
        const uint32_t maxTileElems = MAX_TILE_BYTES / sizeof(T) / alignElems * alignElems;
        if (tileLen > maxTileElems) {
            tileLen = maxTileElems;
        }
        this->tileLength = tileLen;
        this->tileCount = (tileLen == 0) ? 0 : (this->blockLength + tileLen - 1) / tileLen;

        // 设置每个核的 Global Memory 起始地址（关键的多核切分逻辑）
        xGm.SetGlobalBuffer(this->xPtr + start, this->blockLength);
        yGm.SetGlobalBuffer(this->yPtr + start, this->blockLength);
        zGm.SetGlobalBuffer(this->zPtr + start, this->blockLength);

        // 为队列分配内存（单核内流水并行的基础）
        if (this->blockLength > 0) {
            pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(T));
            pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(T));
            pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(T));
        }
    }

    __aicore__ inline void Process()
    {
        // 通常 tileCount == 1（一次搬完），大张量时才走多次循环 + double buffer 流水
        for (uint32_t i = 0; i < this->tileCount; i++) {
            CopyIn(i);    // 搬入第 i 块数据
            Compute(i);   // 计算第 i 块数据
            CopyOut(i);   // 搬出第 i 块结果
        }
        // 不足 32B 的全局尾部由最后一个核补齐，保证任意长度都不丢数据
        ProcessTail();
    }

private:
    __aicore__ inline uint32_t TileLength(uint32_t progress) const
    {
        const uint32_t offset = progress * this->tileLength;
        const uint32_t remain = this->blockLength - offset;
        return (remain < this->tileLength) ? remain : this->tileLength;
    }

    __aicore__ inline void CopyIn(uint32_t progress)
    {
        // 为 LocalTensor 分配内存
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        // 计算当前数据块的起始位置与长度，从 Global Memory 搬入数据到 Local Memory
        const uint32_t offset = progress * this->tileLength;
        const uint32_t len = TileLength(progress);
        AscendC::DataCopy(xLocal, xGm[offset], len);
        AscendC::DataCopy(yLocal, yGm[offset], len);
        // 将数据放入队列，通知 Compute 任务
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t progress)
    {
        // 从输入队列获取数据
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        // 为计算结果分配内存
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        // 执行矢量减法计算
        AscendC::Sub(zLocal, xLocal, yLocal, TileLength(progress));
        // 将计算结果放入输出队列，通知 CopyOut 任务
        outQueueZ.EnQue<T>(zLocal);
        // 释放输入数据内存（重要：避免内存泄漏）
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t progress)
    {
        // 从输出队列获取计算结果
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        // 计算当前数据块的输出位置与长度，将结果从 Local Memory 搬出到 Global Memory
        const uint32_t offset = progress * this->tileLength;
        AscendC::DataCopy(zGm[offset], zLocal, TileLength(progress));
        // 释放输出数据内存
        outQueueZ.FreeTensor(zLocal);
    }

    // 不足 32B 的全局尾部由最后一个核用标量计算，保证任意长度都完整处理
    __aicore__ inline void ProcessTail()
    {
        if (this->tailLength == 0 || AscendC::GetBlockIdx() != AscendC::GetBlockNum() - 1) {
            return;
        }
        const uint32_t base = this->mainLength;
        for (uint32_t i = 0; i < this->tailLength; i++) {
            const float xv = (float)this->xPtr[base + i];
            const float yv = (float)this->yPtr[base + i];
            this->zPtr[base + i] = (T)(xv - yv);
        }
    }

private:
    AscendC::TPipe pipe;  // TPipe 内存管理对象
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueX, inQueueY;  // 输入数据队列管理对象，VECIN 位置
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH> outQueueZ;  // 输出数据队列管理对象，VECOUT 位置
    AscendC::GlobalTensor<T> xGm, yGm, zGm; // 管理输入输出 Global Memory 地址的对象，其中 xGm、yGm 为输入，zGm 为输出
    __gm__ T *xPtr; // 原始 GM 指针，用于尾部标量处理
    __gm__ T *yPtr;
    __gm__ T *zPtr;

    uint32_t mainLength;  // 32B 对齐的主区间长度
    uint32_t tailLength;  // 不足 32B 的尾部长度
    uint32_t blockLength; // 每个核的计算数据长度（32B 对齐）
    uint32_t tileLength;  // 每个核内每个数据块的长度（32B 对齐）
    uint32_t tileCount;   // 每个核实际的数据块个数
};

// ---------------------------------------------------------------------------
// 核函数入口：实例化 KernelSub<T> 并执行（T 由 run_kernel 按输入 dtype 选择）
// ---------------------------------------------------------------------------
template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

// ---------------------------------------------------------------------------
// host 侧启动函数：从 TensorGroupInfo 推导 tiling 并启动核函数
// ---------------------------------------------------------------------------
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    // 1. 取总元素数（x/y/z 形状一致）
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }
    if (totalLength <= 0) {
        return;
    }

    // 2. 按输入 dtype 选择核函数实例（dtype 定义见 TensorInfo：0=fp32 1=fp16 2=bf16 ...）
    const int32_t dtype = t0.dtype;

    // 3. 核数：优先用 availableCoreNum；<=0 时回退到 8（原模板默认值）。
    //    再按数据量收敛，保证每核至少处理 MIN_ELEMS_PER_CORE 个元素：
    //    核开得过多时每核数据只有几十~几百字节，block 调度/流水线建立等固定开销远超有效搬运。
    uint32_t blockDim = (availableCoreNum > 0) ? (uint32_t)availableCoreNum : 8;
    const uint64_t usefulCores = ((uint64_t)totalLength + MIN_ELEMS_PER_CORE - 1) / MIN_ELEMS_PER_CORE;
    if (usefulCores < (uint64_t)blockDim) {
        blockDim = (uint32_t)usefulCores;
    }
    if (blockDim == 0) {
        blockDim = 1;
    }

    // 为了简化计算，tileNum 设置为 8
    const uint32_t tileNum = 8;
    SubCustomTilingData tiling = {(uint32_t)totalLength, tileNum};

    if (dtype == 1) {
        // fp16：half 实例
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        // fp32 及其他类型默认走 float 实例
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}