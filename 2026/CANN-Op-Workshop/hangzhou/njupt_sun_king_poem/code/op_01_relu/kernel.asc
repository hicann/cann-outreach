#include <cmath>
#include "kernel_operator.h"

// ---------------------------------------------------------------------------
// Tiling：host 侧算好后按值传入
// ---------------------------------------------------------------------------
struct ReluCustomTilingData {
    uint32_t totalLength; // 总元素数，例如 8 * 2048
    uint32_t tileNum;     // 单核内 tile 数（本题取 1：一次搬完）
};

// 本题数据量小：单缓冲即可，避免双缓冲额外同步
constexpr uint32_t BUFFER_NUM = 1;

// ---------------------------------------------------------------------------
// KernelRelu：y = max(0, x)
// - TQueBind 把同一块 UB 绑成 VECIN/VECOUT，支持原地 Relu，省一半 UB
// - 队列负责 MTE2 -> V -> MTE3 同步
// ---------------------------------------------------------------------------
template <typename T>
class KernelRelu {
public:
    __aicore__ inline KernelRelu() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, const ReluCustomTilingData& tiling)
    {
        this->blockLength = tiling.totalLength / AscendC::GetBlockNum();
        this->tileNum = tiling.tileNum;
        // BUFFER_NUM=1：tileLength == 每核一次处理的元素数
        this->tileLength = this->blockLength / this->tileNum / BUFFER_NUM;

        const uint32_t offset = this->blockLength * AscendC::GetBlockIdx();
        xGm.SetGlobalBuffer((__gm__ T *)x + offset, this->blockLength);
        yGm.SetGlobalBuffer((__gm__ T *)y + offset, this->blockLength);

        pipe.InitBuffer(dataQueue, BUFFER_NUM, this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        const int32_t loopCount = static_cast<int32_t>(this->tileNum * BUFFER_NUM);
        for (int32_t i = 0; i < loopCount; ++i) {
            CopyIn(i);
            Compute();
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        AscendC::LocalTensor<T> local = dataQueue.AllocTensor<T>();
        AscendC::DataCopy(local, xGm[progress * this->tileLength], this->tileLength);
        // GM -> UB(VECIN)
        dataQueue.template EnQue<AscendC::QuePosition::GM, AscendC::QuePosition::VECIN, T>(local);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> local =
            dataQueue.template DeQue<AscendC::QuePosition::GM, AscendC::QuePosition::VECIN, T>();
        // 原地：dst 与 src 同一块 UB
        AscendC::Relu(local, local, this->tileLength);
        // UB(VECOUT) -> 等待写回 GM
        dataQueue.template EnQue<AscendC::QuePosition::VECOUT, AscendC::QuePosition::GM, T>(local);
    }

    __aicore__ inline void CopyOut(int32_t progress)
    {
        AscendC::LocalTensor<T> local =
            dataQueue.template DeQue<AscendC::QuePosition::VECOUT, AscendC::QuePosition::GM, T>();
        AscendC::DataCopy(yGm[progress * this->tileLength], local, this->tileLength);
        dataQueue.FreeTensor(local);
    }

private:
    AscendC::TPipe pipe;
    // 同一物理缓冲兼作输入/输出队列
    AscendC::TQueBind<AscendC::QuePosition::VECIN, AscendC::QuePosition::VECOUT, BUFFER_NUM> dataQueue;
    AscendC::GlobalTensor<T> xGm, yGm;

    uint32_t blockLength;
    uint32_t tileNum;
    uint32_t tileLength;
};

template <typename T>
__global__ __vector__ void relu_custom(GM_ADDR x, GM_ADDR y, ReluCustomTilingData tiling)
{
    KernelRelu<T> op;
    op.Init(x, y, tiling);
    op.Process();
}

// ---------------------------------------------------------------------------
// Host：动态核数 + 单次大块（tileNum=1）+ 32B 对齐
// ---------------------------------------------------------------------------
namespace {
inline uint32_t ChooseBlockDim(int64_t totalLength, int64_t availableCoreNum)
{
    uint32_t blockDim = 8;
    if (availableCoreNum > 0 && availableCoreNum < static_cast<int64_t>(blockDim)) {
        blockDim = static_cast<uint32_t>(availableCoreNum);
    }
    while (blockDim > 1 && (totalLength % blockDim) != 0) {
        --blockDim;
    }
    return blockDim;
}

inline uint32_t ChooseTileNum(uint32_t blockLength, uint32_t alignNum)
{
    // BUFFER_NUM=1 时优先 tileNum=1 → 每核一次搬入/计算/搬出
    for (uint32_t tileNum = 1; tileNum <= blockLength; ++tileNum) {
        if ((blockLength % (tileNum * BUFFER_NUM)) != 0) {
            continue;
        }
        const uint32_t tileLength = blockLength / tileNum / BUFFER_NUM;
        if (tileLength > 0 && (tileLength % alignNum) == 0) {
            return tileNum;
        }
    }
    return 1;
}
} // namespace

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y,
    int64_t availableCoreNum, aclrtStream stream)
{
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; ++i) {
        totalLength *= t0.shape[i];
    }

    const uint32_t blockDim = ChooseBlockDim(totalLength, availableCoreNum);
    const uint32_t blockLength = static_cast<uint32_t>(totalLength / blockDim);
    const uint32_t alignNum = (t0.dtype == 1) ? 16U : 8U;
    const uint32_t tileNum = ChooseTileNum(blockLength, alignNum);

    ReluCustomTilingData tiling = {static_cast<uint32_t>(totalLength), tileNum};
    if (t0.dtype == 1) {
        relu_custom<half><<<blockDim, nullptr, stream>>>(x, y, tiling);
    } else {
        relu_custom<float><<<blockDim, nullptr, stream>>>(x, y, tiling);
    }
}
