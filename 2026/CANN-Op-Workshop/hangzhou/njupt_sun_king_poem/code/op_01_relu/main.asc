// Local test main — runs the first test case
// Usage: ./relu_custom

#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cmath>
#include "acl/acl.h"

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
// Dtype enum for TensorInfo.dtype:
// 0=float32 1=float16 2=bfloat16 3=int8 4=int16 5=int32 6=int64
// 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#include <vector>
#include "data_utils.h"

#define ACL_CHECK(expr) do { aclError _ret = (expr); if (_ret != 0) { fprintf(stderr, "[ERROR] %s failed at %s:%d, ret=%d\n", #expr, __FILE__, __LINE__, _ret); return 1; } } while(0)
#define FILE_CHECK(expr) do { if (!(expr)) { fprintf(stderr, "[ERROR] File I/O failed at %s:%d\n", __FILE__, __LINE__); return 1; } } while(0)

#include "kernel.asc"

int main()
{
    int32_t deviceId = 0;
    int64_t availableCoreNum = 0;
    aclrtStream stream = nullptr;

    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(deviceId));
    ACL_CHECK(aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum));
    if (availableCoreNum <= 0) {
        return 1;
    }
    ACL_CHECK(aclrtCreateStream(&stream));

    int64_t x_0_shape[] = {8, 2048};
    TensorInfo x_tensors[] = {{x_0_shape, 2, 0}};
    TensorGroupInfo info_x = {x_tensors, 1};
    int64_t y_0_shape[] = {8, 2048};
    TensorInfo y_tensors[] = {{y_0_shape, 2, 0}};
    TensorGroupInfo info_y = {y_tensors, 1};



    uint8_t *inputHost_x = nullptr, *inputDevice_x = nullptr;

    uint8_t *outputHost_y = nullptr, *outputDevice_y = nullptr;

    ACL_CHECK(aclrtMallocHost((void **)&inputHost_x, 65536));
    ACL_CHECK(aclrtMalloc((void **)&inputDevice_x, 65536, ACL_MEM_MALLOC_HUGE_FIRST));
    FILE_CHECK(ReadFile("./input/x.bin", 65536, inputHost_x, 65536));
    ACL_CHECK(aclrtMemcpy(inputDevice_x, 65536, inputHost_x, 65536, ACL_MEMCPY_HOST_TO_DEVICE));

    ACL_CHECK(aclrtMallocHost((void **)&outputHost_y, 65536));
    ACL_CHECK(aclrtMalloc((void **)&outputDevice_y, 65536, ACL_MEM_MALLOC_HUGE_FIRST));

    run_kernel((GM_ADDR)inputDevice_x, info_x, (GM_ADDR)outputDevice_y, info_y, availableCoreNum, stream);
    auto sync_ret_ = aclrtSynchronizeStreamWithTimeout(stream, 3000);
    if (sync_ret_ != 0) { fprintf(stderr, "[ERROR] aclrtSynchronizeStreamWithTimeout failed, ret=%d\n", sync_ret_); return 1; }

    ACL_CHECK(aclrtMemcpy(outputHost_y, 65536, outputDevice_y, 65536, ACL_MEMCPY_DEVICE_TO_HOST));
    FILE_CHECK(WriteFile("./output/y.bin", outputHost_y, 65536));

    if (inputDevice_x) aclrtFree(inputDevice_x);
    if (inputHost_x) aclrtFreeHost(inputHost_x);
    if (outputDevice_y) aclrtFree(outputDevice_y);
    if (outputHost_y) aclrtFreeHost(outputHost_y);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
