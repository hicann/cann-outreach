#include <cmath>
#include "kernel_operator.h"

// ReLU for the exercise's (8, 2048) ND float32/float16 tensors.
// This file is included by the judge; do not define main().
template <typename T>
class KernelRelu {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, uint32_t totalLength)
    {
        totalLength_ = totalLength;
        xGm_.SetGlobalBuffer((__gm__ T*)x, totalLength);
        yGm_.SetGlobalBuffer((__gm__ T*)y, totalLength);
        pipe_.InitBuffer(inQueue_, 1, kTileLength * sizeof(T));
        pipe_.InitBuffer(outQueue_, 1, kTileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // Cyclic tile assignment also handles core counts that do not divide 64.
        for (uint32_t offset = AscendC::GetBlockIdx() * kTileLength;
             offset < totalLength_;
             offset += AscendC::GetBlockNum() * kTileLength) {
            AscendC::LocalTensor<T> input = inQueue_.AllocTensor<T>();
            AscendC::DataCopy(input, xGm_[offset], kTileLength);
            inQueue_.EnQue(input);

            input = inQueue_.DeQue<T>();
            AscendC::LocalTensor<T> output = outQueue_.AllocTensor<T>();
            AscendC::Relu(output, input, kTileLength);
            outQueue_.EnQue(output);
            inQueue_.FreeTensor(input);

            output = outQueue_.DeQue<T>();
            AscendC::DataCopy(yGm_[offset], output, kTileLength);
            outQueue_.FreeTensor(output);
        }
    }

private:
    static constexpr uint32_t kTileLength = 256;
    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inQueue_;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> outQueue_;
    AscendC::GlobalTensor<T> xGm_, yGm_;
    uint32_t totalLength_;
};

template <typename T>
__global__ __vector__ void relu_custom(GM_ADDR x, GM_ADDR y, uint32_t totalLength)
{
    KernelRelu<T> op;
    op.Init(x, y, totalLength);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           int64_t availableCoreNum, aclrtStream stream)
{
    const TensorInfo& input = info_x.tensors[0];
    uint32_t totalLength = 1;
    for (int64_t i = 0; i < input.numDims; ++i) {
        totalLength *= static_cast<uint32_t>(input.shape[i]);
    }
    // The specified 16384 elements form 64 complete, 32-byte-aligned tiles.
    uint32_t blockNum = availableCoreNum > 0
        ? static_cast<uint32_t>(availableCoreNum > 8 ? 8 : availableCoreNum) : 1;
    if (input.dtype == 0) {
        relu_custom<float><<<blockNum, nullptr, stream>>>(x, y, totalLength);
    } else if (input.dtype == 1) {
        relu_custom<half><<<blockNum, nullptr, stream>>>(x, y, totalLength);
    }
}
