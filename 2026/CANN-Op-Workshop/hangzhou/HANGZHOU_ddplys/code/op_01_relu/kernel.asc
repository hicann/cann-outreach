#include <cmath>
#include "kernel_operator.h"

// Fixed problem shape: (8, 2048), FP32 or FP16.
constexpr uint32_t RELU_TOTAL_LENGTH = 8 * 2048;
constexpr uint32_t RELU_TILE_LENGTH = 256;
constexpr uint32_t RELU_TILE_COUNT = RELU_TOTAL_LENGTH / RELU_TILE_LENGTH;

template <typename T>
class KernelRelu {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y)
    {
        xGm.SetGlobalBuffer((__gm__ T*)x, RELU_TOTAL_LENGTH);
        yGm.SetGlobalBuffer((__gm__ T*)y, RELU_TOTAL_LENGTH);
        pipe.InitBuffer(inQueue, 1, RELU_TILE_LENGTH * sizeof(T));
        pipe.InitBuffer(outQueue, 1, RELU_TILE_LENGTH * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // Assign complete tiles, including when the core count is not a divisor.
        for (uint32_t tile = AscendC::GetBlockIdx(); tile < RELU_TILE_COUNT;
             tile += AscendC::GetBlockNum()) {
            const uint32_t offset = tile * RELU_TILE_LENGTH;
            CopyIn(offset);
            Compute();
            CopyOut(offset);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset)
    {
        AscendC::LocalTensor<T> xLocal = inQueue.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm[offset], RELU_TILE_LENGTH);
        inQueue.EnQue<T>(xLocal);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> xLocal = inQueue.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = outQueue.AllocTensor<T>();
        AscendC::Relu(yLocal, xLocal, RELU_TILE_LENGTH);
        outQueue.EnQue<T>(yLocal);
        inQueue.FreeTensor(xLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset)
    {
        AscendC::LocalTensor<T> yLocal = outQueue.DeQue<T>();
        AscendC::DataCopy(yGm[offset], yLocal, RELU_TILE_LENGTH);
        outQueue.FreeTensor(yLocal);
    }

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inQueue;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> outQueue;
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
};

template <typename T>
__global__ __vector__ void relu_custom(GM_ADDR x, GM_ADDR y)
{
    KernelRelu<T> op;
    op.Init(x, y);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                          GM_ADDR y, const TensorGroupInfo& info_y,
                          int64_t availableCoreNum, aclrtStream stream)
{
    if (x == nullptr || y == nullptr || availableCoreNum <= 0 ||
        info_x.numTensors != 1 || info_y.numTensors != 1 ||
        info_x.tensors == nullptr || info_y.tensors == nullptr) {
        return;
    }
    const TensorInfo& input = info_x.tensors[0];
    const TensorInfo& output = info_y.tensors[0];
    if (input.numDims != 2 || output.numDims != 2 ||
        input.shape == nullptr || output.shape == nullptr ||
        input.shape[0] != 8 || input.shape[1] != 2048 ||
        output.shape[0] != 8 || output.shape[1] != 2048 ||
        input.dtype != output.dtype || (input.dtype != 0 && input.dtype != 1)) {
        return;
    }
    const uint32_t blockNum = static_cast<uint32_t>(availableCoreNum < 8 ? availableCoreNum : 8);
    if (input.dtype == 1) {
        relu_custom<half><<<blockNum, nullptr, stream>>>(x, y);
    } else {
        relu_custom<float><<<blockNum, nullptr, stream>>>(x, y);
    }
}
