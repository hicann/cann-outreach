#include <cstdint>
#include "kernel_operator.h"

struct ReluCustomTilingData {
    uint64_t totalLength;
    uint64_t blockLength;
    uint32_t tileLength;
};

constexpr uint32_t BUFFER_NUM = 2;
constexpr uint32_t QUEUE_DEPTH = 1;

template <typename T>
class KernelRelu {
public:
    __aicore__ inline KernelRelu() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y,
                                const ReluCustomTilingData& tiling)
    {
        const uint64_t offset = static_cast<uint64_t>(AscendC::GetBlockIdx()) *
                                tiling.blockLength;
        blockLength = 0;
        tileLength = tiling.tileLength;
        if (offset >= tiling.totalLength) {
            return;
        }

        const uint64_t remaining = tiling.totalLength - offset;
        blockLength = remaining < tiling.blockLength ? remaining : tiling.blockLength;
        xGm.SetGlobalBuffer((__gm__ T*)x + offset, blockLength);
        yGm.SetGlobalBuffer((__gm__ T*)y + offset, blockLength);
        // 队列深度为 1，通过分配两个 buffer 开启双缓冲。
        pipe.InitBuffer(inQueueX, BUFFER_NUM, tileLength * sizeof(T));
        pipe.InitBuffer(outQueueY, BUFFER_NUM, tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        for (uint64_t offset = 0; offset < blockLength; offset += tileLength) {
            const uint64_t remaining = blockLength - offset;
            const uint32_t count = remaining < tileLength ?
                                   static_cast<uint32_t>(remaining) : tileLength;
            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
        }
    }

private:
    __aicore__ inline void CopyIn(uint64_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        // 按实际字节数搬运，支持不足 32 字节的尾块。
        AscendC::DataCopyExtParams copyParams{
            1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, static_cast<T>(0)};
        AscendC::DataCopyPad(xLocal, xGm[offset], copyParams, padParams);
        inQueueX.EnQue(xLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = outQueueY.AllocTensor<T>();
        AscendC::Relu(yLocal, xLocal, count);
        outQueueY.EnQue(yLocal);
        inQueueX.FreeTensor(xLocal);
    }

    __aicore__ inline void CopyOut(uint64_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> yLocal = outQueueY.DeQue<T>();
        AscendC::DataCopyExtParams copyParams{
            1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPad(yGm[offset], yLocal, copyParams);
        outQueueY.FreeTensor(yLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueX;
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH> outQueueY;
    AscendC::GlobalTensor<T> xGm, yGm;
    uint64_t blockLength;
    uint32_t tileLength;
};

template <typename T>
__global__ __vector__ void relu_custom(GM_ADDR x, GM_ADDR y, ReluCustomTilingData tiling)
{
    KernelRelu<T> op;
    op.Init(x, y, tiling);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           int64_t availableCoreNum, aclrtStream stream)
{
    (void)info_y;
    const TensorInfo& t0 = info_x.tensors[0];
    uint64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; ++i) {
        totalLength *= static_cast<uint64_t>(t0.shape[i]);
    }
    if (totalLength == 0 || availableCoreNum <= 0) {
        return;
    }
    // 与模板一致，支持 fp32 和 fp16。
    if (t0.dtype != 0 && t0.dtype != 1) {
        return;
    }

    const uint32_t typeSize = t0.dtype == 1 ? sizeof(half) : sizeof(float);
    const uint32_t alignLength = 32 / typeSize;
    const uint64_t alignedBlocks = (totalLength + alignLength - 1) / alignLength;
    uint32_t blockDim = availableCoreNum < 8 ?
                        static_cast<uint32_t>(availableCoreNum) : 8;
    if (alignedBlocks < blockDim) {
        blockDim = static_cast<uint32_t>(alignedBlocks);
    }
    const uint64_t blockLength =
        ((alignedBlocks + blockDim - 1) / blockDim) * alignLength;

    // 参考模板每核分成 8 × BUFFER_NUM 块，并限制单块大小。
    // 最大 UB 用量为 4096 × sizeof(float) × 2 个队列 × 2 个 buffer = 64 KiB。
    const uint32_t targetTiles = 8 * BUFFER_NUM;
    uint64_t tileLength = (blockLength + targetTiles - 1) / targetTiles;
    tileLength = ((tileLength + alignLength - 1) / alignLength) * alignLength;
    if (tileLength > 4096) {
        tileLength = 4096;
    }

    ReluCustomTilingData tiling{
        totalLength, blockLength, static_cast<uint32_t>(tileLength)};
    if (t0.dtype == 1) {
        relu_custom<half><<<blockDim, nullptr, stream>>>(x, y, tiling);
    } else {
        relu_custom<float><<<blockDim, nullptr, stream>>>(x, y, tiling);
    }
}
