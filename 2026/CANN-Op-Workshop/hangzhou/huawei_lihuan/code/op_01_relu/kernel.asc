#include <cmath>
#include "kernel_operator.h"
/*
 * Relu Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * 算子功能: 逐元素 ReLU 激活  y = max(0, x)
 *   x / y : shape (8, 2048), dtype float32 | float16, 格式 ND
 *   总元素数 = 8 * 2048 = 16384 (按一维扁平化处理, 逐元素运算与形状无关)
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 */

using namespace AscendC;

namespace {
constexpr int32_t  BUFFER_NUM      = 2;          // double buffer
constexpr uint32_t ALIGN_BYTES     = 32;         // DataCopy 要求 32 Byte 对齐
constexpr uint32_t UB_BUDGET_BYTES = 96 * 1024;  // 两个队列占用的 UB 预算
}  // namespace

template <typename T>
__global__ __vector__ void relu_custom(GM_ADDR x, GM_ADDR y,
                                       uint32_t perCoreCount, uint32_t totalLength)
{
    constexpr uint32_t alignElems = ALIGN_BYTES / sizeof(T);

    // ---- 1. 多核切分: 每个 core 处理 [start, start + count) 的连续区间 ----
    const uint32_t blockIdx = (uint32_t)GetBlockIdx();
    const uint32_t start    = blockIdx * perCoreCount;
    if (start >= totalLength) {
        return;
    }
    uint32_t count = perCoreCount;
    if (start + count > totalLength) {
        count = totalLength - start;
    }

    GlobalTensor<T> xGm;
    GlobalTensor<T> yGm;
    xGm.SetGlobalBuffer((__gm__ T*)x + start, count);
    yGm.SetGlobalBuffer((__gm__ T*)y + start, count);

    // ---- 2. 核内切分: tile 长度按 UB 预算与 32B 对齐计算 ----
    uint32_t tileLength = UB_BUDGET_BYTES / (2u * BUFFER_NUM * sizeof(T));
    if (tileLength > count) {
        tileLength = count;
    }
    tileLength = tileLength / alignElems * alignElems;  // 向下对齐
    if (tileLength == 0) {
        tileLength = alignElems;
    }

    TPipe pipe;
    TQue<QuePosition::VECIN,  BUFFER_NUM> inQueueX;
    TQue<QuePosition::VECOUT, BUFFER_NUM> outQueueY;

    pipe.InitBuffer(inQueueX,  BUFFER_NUM, tileLength * sizeof(T));
    pipe.InitBuffer(outQueueY, BUFFER_NUM, tileLength * sizeof(T));

    // ---- 3. 分块搬运 + 计算 + 搬出 ----
    const uint32_t tileCount = (count + tileLength - 1) / tileLength;
    for (uint32_t i = 0; i < tileCount; ++i) {
        const uint32_t offset = i * tileLength;
        uint32_t curLength = tileLength;
        if (offset + curLength > count) {
            curLength = count - offset;
        }

        // GM -> UB
        LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        DataCopy(xLocal, xGm[offset], curLength);
        inQueueX.EnQue(xLocal);

        // 计算 y = max(0, x)
        LocalTensor<T> xIn    = inQueueX.DeQue<T>();
        LocalTensor<T> yLocal = outQueueY.AllocTensor<T>();
        Relu(yLocal, xIn, curLength);
        outQueueY.EnQue(yLocal);
        inQueueX.FreeTensor(xIn);

        // UB -> GM
        LocalTensor<T> yOut = outQueueY.DeQue<T>();
        DataCopy(yGm[offset], yOut, curLength);
        outQueueY.FreeTensor(yOut);
    }
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, int64_t availableCoreNum, aclrtStream stream)
{
    const TensorInfo& tx = info_x.tensors[0];

    // ---- 计算总元素数 (扁平化) ----
    int64_t totalLength = 1;
    for (int64_t i = 0; i < tx.numDims; ++i) {
        totalLength *= tx.shape[i];
    }
    if (totalLength <= 0) {
        return;
    }

    const int32_t dtype     = tx.dtype;
    const int64_t elemBytes = (dtype == 1) ? 2 : 4;               // fp16 -> 2B, fp32 -> 4B
    const int64_t alignElem = ALIGN_BYTES / elemBytes;            // 32B 对齐的元素个数

    // ---- 确定使用核数, 每核元素数向上对齐到 32B ----
    int64_t coreNum = availableCoreNum;
    if (coreNum <= 0) {
        coreNum = 1;
    }
    if (coreNum > totalLength) {
        coreNum = totalLength;
    }
    int64_t perCore = (totalLength + coreNum - 1) / coreNum;
    perCore = ((perCore + alignElem - 1) / alignElem) * alignElem;

    const uint32_t perCoreCount = (uint32_t)perCore;
    const uint32_t total        = (uint32_t)totalLength;

    // ---- 按数据类型分发并启动 Kernel ----
    if (dtype == 0) {          // float32
        relu_custom<float><<<(uint32_t)coreNum, nullptr, stream>>>(x, y, perCoreCount, total);
    } else if (dtype == 1) {   // float16
        relu_custom<half><<<(uint32_t)coreNum, nullptr, stream>>>(x, y, perCoreCount, total);
    }
}