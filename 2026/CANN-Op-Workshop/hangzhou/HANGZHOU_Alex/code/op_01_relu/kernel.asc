#include <cmath>
#include "kernel_operator.h"

/*
 * Relu Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 */

using namespace AscendC;

namespace {
constexpr int32_t BUFFER_NUM  = 2;    // double buffer
constexpr int32_t TILE_LENGTH = 128;  // 单次迭代元素数 (fp32:512B / fp16:256B)
}

// ============================================================
// 核函数：y = max(0, x)
//   每个 AI Core 处理 blockLength 个元素，内部按 TILE_LENGTH 循环
// ============================================================
template <typename T>
__global__ __vector__ void relu_custom(GM_ADDR x, GM_ADDR y, int64_t blockLength)
{
    TPipe pipe;
    TQue<QuePosition::VECIN,  BUFFER_NUM> inQueueX;
    TQue<QuePosition::VECOUT, BUFFER_NUM> outQueueY;
    pipe.InitBuffer(inQueueX,  BUFFER_NUM, TILE_LENGTH * sizeof(T));
    pipe.InitBuffer(outQueueY, BUFFER_NUM, TILE_LENGTH * sizeof(T));

    int64_t blockIdx = GetBlockIdx();
    GlobalTensor<T> xGm, yGm;
    xGm.SetGlobalBuffer((__gm__ T*)x + blockIdx * blockLength, blockLength);
    yGm.SetGlobalBuffer((__gm__ T*)y + blockIdx * blockLength, blockLength);

    int64_t loopCount = blockLength / TILE_LENGTH;

    for (int64_t i = 0; i < loopCount; i++) {
        // -------- CopyIn --------
        LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        DataCopy(xLocal, xGm[i * TILE_LENGTH], TILE_LENGTH);
        inQueueX.EnQue(xLocal);

        // -------- Compute --------
        LocalTensor<T> xIn  = inQueueX.DeQue<T>();
        LocalTensor<T> yOut = outQueueY.AllocTensor<T>();
        Relu(yOut, xIn, TILE_LENGTH);          // y = max(0, x)
        outQueueY.EnQue(yOut);
        inQueueX.FreeTensor(xIn);

        // -------- CopyOut --------
        LocalTensor<T> yLocal = outQueueY.DeQue<T>();
        DataCopy(yGm[i * TILE_LENGTH], yLocal, TILE_LENGTH);
        outQueueY.FreeTensor(yLocal);
    }
}

// ============================================================
// Host 侧启动入口：main.asc 中 #include 后直接调用
// ============================================================
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           int64_t availableCoreNum, aclrtStream stream)
{
    // 1. 计算总元素数
    int64_t totalLength = 1;
    for (int64_t i = 0; i < info_x.tensors[0].numDims; i++) {
        totalLength *= info_x.tensors[0].shape[i];
    }

    // 2. 确定 blockNum：不超过硬件可用核数，同时保证 blockLength 能被 TILE_LENGTH 整除
    int64_t blockNum = (availableCoreNum < 8) ? availableCoreNum : 8;
    while (blockNum > 1 &&
           ((totalLength % blockNum != 0) ||
            ((totalLength / blockNum) % TILE_LENGTH != 0))) {
        blockNum--;
    }
    int64_t blockLength = totalLength / blockNum;

    // 3. 按 dtype 分派模板实例
    int32_t dtype = info_x.tensors[0].dtype;
    if (dtype == 0) {          // fp32
        relu_custom<float><<<blockNum, nullptr, stream>>>(x, y, blockLength);
    } else if (dtype == 1) {   // fp16
        relu_custom<half><<<blockNum, nullptr, stream>>>(x, y, blockLength);
    }
}