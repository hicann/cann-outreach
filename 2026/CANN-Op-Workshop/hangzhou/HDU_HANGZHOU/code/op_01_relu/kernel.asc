#include <cmath>
#include "kernel_operator.h"

using namespace AscendC;

// 每次在一个 Vector Core 上处理 2048 个元素。
// 当前题目总元素数 8 * 2048 = 16384，因此正好 8 个 tile。
constexpr uint32_t TILE_LENGTH = 2048;

// ============================================================================
// Kernel implementation
// ============================================================================

template <typename T>
class KernelRelu {
public:
    __aicore__ inline KernelRelu() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, uint32_t totalLength)
    {
        this->totalLength = totalLength;

        // 将 Host 传进来的 GM_ADDR 转换成真正的数据类型，
        // 并建立 GlobalTensor 对 Global Memory 的视图。
        xGm.SetGlobalBuffer((__gm__ T *)x, totalLength);
        yGm.SetGlobalBuffer((__gm__ T *)y, totalLength);

        // 给输入/输出 Queue 分配 Unified Buffer。
        //
        // inQueue  : GM -> VECIN
        // outQueue : VECOUT -> GM
        pipe.InitBuffer(inQueue, 1, TILE_LENGTH * sizeof(T));
        pipe.InitBuffer(outQueue, 1, TILE_LENGTH * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        uint32_t loopCount = totalLength / TILE_LENGTH;

        for (uint32_t i = 0; i < loopCount; ++i) {
            CopyIn(i);
            Compute();
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t tileIndex)
    {
        // 从输入 Queue 申请一块 LocalTensor。
        LocalTensor<T> xLocal = inQueue.AllocTensor<T>();

        uint32_t offset = tileIndex * TILE_LENGTH;

        // Global Memory -> Unified Buffer(VECIN)
        DataCopy(xLocal, xGm[offset], TILE_LENGTH);

        // 告诉 Queue：这个输入 tile 已经准备好了。
        inQueue.EnQue(xLocal);
    }

    __aicore__ inline void Compute()
    {
        // 取出 CopyIn 已经准备好的输入。
        LocalTensor<T> xLocal = inQueue.DeQue<T>();

        // 为结果申请 VECOUT LocalTensor。
        LocalTensor<T> yLocal = outQueue.AllocTensor<T>();

        // 真正执行：
        //
        //     y = max(0, x)
        //
        // Vector Unit 一次处理整个 LocalTensor。
        Relu(yLocal, xLocal, TILE_LENGTH);

        // 输出已经计算完成。
        outQueue.EnQue(yLocal);

        // 输入 LocalTensor 后续不再使用，可以归还。
        inQueue.FreeTensor(xLocal);
    }

    __aicore__ inline void CopyOut(uint32_t tileIndex)
    {
        LocalTensor<T> yLocal = outQueue.DeQue<T>();

        uint32_t offset = tileIndex * TILE_LENGTH;

        // Unified Buffer(VECOUT) -> Global Memory
        DataCopy(yGm[offset], yLocal, TILE_LENGTH);

        outQueue.FreeTensor(yLocal);
    }

private:
    // Global Memory tensor views
    GlobalTensor<T> xGm;
    GlobalTensor<T> yGm;

    // Unified Buffer / pipeline resource manager
    TPipe pipe;

    // Input and output queues
    TQue<QuePosition::VECIN, 1> inQueue;
    TQue<QuePosition::VECOUT, 1> outQueue;

    uint32_t totalLength = 0;
};


// ============================================================================
// Device kernel entry
// ============================================================================

extern "C" __global__ __vector__ void relu_custom(
    GM_ADDR x,
    GM_ADDR y,
    uint32_t totalLength,
    int32_t dtype)
{
    // dtype:
    //   0 = float32
    //   1 = float16

    if (dtype == 0) {
        KernelRelu<float> op;
        op.Init(x, y, totalLength);
        op.Process();
    } else if (dtype == 1) {
        KernelRelu<half> op;
        op.Init(x, y, totalLength);
        op.Process();
    }
}


// ============================================================================
// Host launch function
// ============================================================================

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    // 当前算子只有一个输入 Tensor。
    if (info_x.numTensors <= 0 || info_x.tensors == nullptr) {
        return;
    }

    const TensorInfo& xInfo = info_x.tensors[0];

    if (xInfo.numDims <= 0 || xInfo.shape == nullptr) {
        return;
    }

    // 根据 shape 计算元素总数。
    uint64_t totalLength64 = 1;

    for (int64_t i = 0; i < xInfo.numDims; ++i) {
        totalLength64 *= static_cast<uint64_t>(xInfo.shape[i]);
    }

    if (totalLength64 == 0 || totalLength64 > 0xffffffffULL) {
        return;
    }

    // 本题只要求 float32 / float16。
    if (xInfo.dtype != 0 && xInfo.dtype != 1) {
        return;
    }

    uint32_t totalLength = static_cast<uint32_t>(totalLength64);

    uint32_t blockNum = 1;

    relu_custom<<<blockNum, nullptr, stream>>>(
        x,
        y,
        totalLength,
        xInfo.dtype);
}