#include <cmath>
#include "kernel_operator.h"
/*
 * Relu Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 */

namespace {

constexpr uint32_t BUFFER_NUM = 2;
constexpr uint32_t TILE_LENGTH = 2048;
constexpr uint32_t DATA_COPY_ALIGNMENT = 32;
constexpr uint32_t MAX_VECTOR_BLOCKS = 8;

template <typename T>
class KernelRelu {
public:
    __aicore__ inline KernelRelu() = default;

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, uint32_t blockLength)
    {
        blockLength_ = blockLength;
        const uint32_t blockOffset = AscendC::GetBlockIdx() * blockLength_;

        xGm_.SetGlobalBuffer((__gm__ T *)x + blockOffset, blockLength_);
        yGm_.SetGlobalBuffer((__gm__ T *)y + blockOffset, blockLength_);

        pipe_.InitBuffer(inputQueue_, BUFFER_NUM, TILE_LENGTH * sizeof(T));
        pipe_.InitBuffer(outputQueue_, BUFFER_NUM, TILE_LENGTH * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t offset = 0; offset < blockLength_; offset += TILE_LENGTH) {
            const uint32_t remaining = blockLength_ - offset;
            const uint32_t count = remaining < TILE_LENGTH ? remaining : TILE_LENGTH;
            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inputQueue_.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm_[offset], count);
        inputQueue_.EnQue(xLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inputQueue_.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = outputQueue_.AllocTensor<T>();
        AscendC::Relu(yLocal, xLocal, static_cast<int32_t>(count));
        outputQueue_.EnQue(yLocal);
        inputQueue_.FreeTensor(xLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> yLocal = outputQueue_.DeQue<T>();
        AscendC::DataCopy(yGm_[offset], yLocal, count);
        outputQueue_.FreeTensor(yLocal);
    }

private:
    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inputQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_NUM> outputQueue_;
    AscendC::GlobalTensor<T> xGm_;
    AscendC::GlobalTensor<T> yGm_;
    uint32_t blockLength_ = 0;
};

} // namespace

template <typename T>
__global__ __vector__ void relu_custom(GM_ADDR x, GM_ADDR y, uint32_t blockLength)
{
    KernelRelu<T> op;
    op.Init(x, y, blockLength);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y,
                           const TensorGroupInfo& info_y, int64_t availableCoreNum,
                           aclrtStream stream)
{
    if (x == nullptr || y == nullptr || stream == nullptr || availableCoreNum <= 0) {
        return;
    }
    if (info_x.tensors == nullptr || info_y.tensors == nullptr ||
        info_x.numTensors != 1 || info_y.numTensors != 1) {
        return;
    }

    const TensorInfo& xInfo = info_x.tensors[0];
    const TensorInfo& yInfo = info_y.tensors[0];
    if (xInfo.shape == nullptr || yInfo.shape == nullptr ||
        xInfo.numDims <= 0 || xInfo.numDims != yInfo.numDims ||
        xInfo.dtype != yInfo.dtype || (xInfo.dtype != 0 && xInfo.dtype != 1)) {
        return;
    }

    int64_t totalElements = 1;
    for (int64_t i = 0; i < xInfo.numDims; ++i) {
        if (xInfo.shape[i] <= 0 || xInfo.shape[i] != yInfo.shape[i] ||
            totalElements > static_cast<int64_t>(UINT32_MAX) / xInfo.shape[i]) {
            return;
        }
        totalElements *= xInfo.shape[i];
    }

    const uint32_t elementSize = xInfo.dtype == 0 ? sizeof(float) : sizeof(half);
    if ((totalElements * elementSize) % DATA_COPY_ALIGNMENT != 0) {
        return;
    }

    uint32_t blockNum = static_cast<uint32_t>(
        availableCoreNum < MAX_VECTOR_BLOCKS ? availableCoreNum : MAX_VECTOR_BLOCKS);
    while (blockNum > 1 &&
           (totalElements % blockNum != 0 ||
            ((totalElements / blockNum) * elementSize) % DATA_COPY_ALIGNMENT != 0)) {
        --blockNum;
    }

    const uint32_t blockLength = static_cast<uint32_t>(totalElements / blockNum);
    if (xInfo.dtype == 0) {
        relu_custom<float><<<blockNum, nullptr, stream>>>(x, y, blockLength);
    } else {
        relu_custom<half><<<blockNum, nullptr, stream>>>(x, y, blockLength);
    }
}
