#include "kernel_operator.h"

// ---------------------------------------------------------------------------
// Tiling 参数
// ---------------------------------------------------------------------------
struct ReluCustomTilingData {
    uint32_t totalLength;
    uint32_t tileNum;
};

constexpr uint32_t BUFFER_NUM = 2;


// ---------------------------------------------------------------------------
// KernelRelu
// y = max(0, x)
// ---------------------------------------------------------------------------
template <typename T>
class KernelRelu {
public:
    __aicore__ inline KernelRelu() {}

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        const ReluCustomTilingData& tiling)
    {
        // 每个 AI Core 处理的数据长度
        this->blockLength =
            tiling.totalLength / AscendC::GetBlockNum();

        // 每核 tile 数
        this->tileNum =
            (tiling.tileNum == 0) ? 1 : tiling.tileNum;

        // Double Buffer 下每次真正处理的数据长度
        this->tileLength =
            this->blockLength / this->tileNum / BUFFER_NUM;

        // ---------------------------------------------------------------
        // 为当前 AI Core 划分 GM 数据
        // ---------------------------------------------------------------
        xGm.SetGlobalBuffer(
            (__gm__ T*)x
                + this->blockLength * AscendC::GetBlockIdx(),
            this->blockLength);

        yGm.SetGlobalBuffer(
            (__gm__ T*)y
                + this->blockLength * AscendC::GetBlockIdx(),
            this->blockLength);

        // ---------------------------------------------------------------
        // 分配 UB Buffer
        // InitBuffer 第三个参数单位是 byte
        // ---------------------------------------------------------------
        pipe.InitBuffer(
            inQueueX,
            BUFFER_NUM,
            this->tileLength * sizeof(T));

        pipe.InitBuffer(
            outQueueY,
            BUFFER_NUM,
            this->tileLength * sizeof(T));
    }


    __aicore__ inline void Process()
    {
        // Double Buffer：
        // 实际循环次数 = tileNum * BUFFER_NUM
        int32_t loopCount =
            this->tileNum * BUFFER_NUM;

        for (int32_t i = 0; i < loopCount; ++i) {
            CopyIn(i);
            Compute();
            CopyOut(i);
        }
    }


private:

    // -----------------------------------------------------------------------
    // GM -> UB
    // -----------------------------------------------------------------------
    __aicore__ inline void CopyIn(int32_t progress)
    {
        AscendC::LocalTensor<T> xLocal =
            inQueueX.AllocTensor<T>();

        AscendC::DataCopy(
            xLocal,
            xGm[progress * this->tileLength],
            this->tileLength);

        inQueueX.EnQue(xLocal);
    }


    // -----------------------------------------------------------------------
    // ReLU
    // -----------------------------------------------------------------------
    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> xLocal =
            inQueueX.DeQue<T>();

        AscendC::LocalTensor<T> yLocal =
            outQueueY.AllocTensor<T>();

        // y = max(0, x)
        AscendC::Relu(
            yLocal,
            xLocal,
            this->tileLength);

        outQueueY.EnQue<T>(yLocal);

        inQueueX.FreeTensor(xLocal);
    }


    // -----------------------------------------------------------------------
    // UB -> GM
    // -----------------------------------------------------------------------
    __aicore__ inline void CopyOut(int32_t progress)
    {
        AscendC::LocalTensor<T> yLocal =
            outQueueY.DeQue<T>();

        AscendC::DataCopy(
            yGm[progress * this->tileLength],
            yLocal,
            this->tileLength);

        outQueueY.FreeTensor(yLocal);
    }


private:

    AscendC::TPipe pipe;

    // ReLU 只有一个输入和一个输出
    AscendC::TQue<
        AscendC::QuePosition::VECIN,
        BUFFER_NUM> inQueueX;

    AscendC::TQue<
        AscendC::QuePosition::VECOUT,
        BUFFER_NUM> outQueueY;

    // x：输入
    // y：输出
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;

    uint32_t blockLength;
    uint32_t tileNum;
    uint32_t tileLength;
};


// ---------------------------------------------------------------------------
// Kernel 入口
// ---------------------------------------------------------------------------
template <typename T>
__global__ __vector__ void relu_custom(
    GM_ADDR x,
    GM_ADDR y,
    ReluCustomTilingData tiling)
{
    KernelRelu<T> op;

    op.Init(x, y, tiling);
    op.Process();
}


// ---------------------------------------------------------------------------
// Host 启动函数
// ---------------------------------------------------------------------------
extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    constexpr uint32_t blockDim = 8;

    // -----------------------------------------------------------------------
    // 1. 计算总元素数
    // -----------------------------------------------------------------------
    const TensorInfo& t0 = info_x.tensors[0];

    int64_t totalLength = 1;

    for (int64_t i = 0; i < t0.numDims; ++i) {
        totalLength *= t0.shape[i];
    }

    // -----------------------------------------------------------------------
    // 2. dtype
    //
    // 根据你的 TensorInfo 定义：
    // 0 -> float32
    // 1 -> float16
    // -----------------------------------------------------------------------
    int32_t dtype = t0.dtype;

    // 每个核划分 8 个 tile group
    constexpr uint32_t tileNum = 8;

    ReluCustomTilingData tiling {
        static_cast<uint32_t>(totalLength),
        tileNum
    };

    // -----------------------------------------------------------------------
    // 3. Launch
    // -----------------------------------------------------------------------
    if (dtype == 1) {

        // FP16
        relu_custom<half>
            <<<blockDim, nullptr, stream>>>(
                x,
                y,
                tiling);

    } else if (dtype == 0) {

        // FP32
        relu_custom<float>
            <<<blockDim, nullptr, stream>>>(
                x,
                y,
                tiling);

    } else {
        // 不要把未知类型默认当 float
        // 此处根据你的运行框架增加错误处理
        return;
    }
}