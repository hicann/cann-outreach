#include <cmath>
#include "kernel_operator.h"

constexpr uint32_t TILE_LENGTH = 2048;

template <typename T>
__global__ __vector__ void relu_custom(GM_ADDR x, GM_ADDR y, uint32_t totalLength)
{
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueX;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueY;

    uint32_t blockNum = static_cast<uint32_t>(AscendC::GetBlockNum());
    uint32_t blockIdx = static_cast<uint32_t>(AscendC::GetBlockIdx());

    uint32_t baseLength = totalLength / blockNum;
    uint32_t remainder = totalLength % blockNum;
    uint32_t blockLength = baseLength + (blockIdx < remainder ? 1U : 0U);
    uint32_t blockOffset = blockIdx * baseLength + (blockIdx < remainder ? blockIdx : remainder);

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    xGm.SetGlobalBuffer((__gm__ T *)x + blockOffset, blockLength);
    yGm.SetGlobalBuffer((__gm__ T *)y + blockOffset, blockLength);

    pipe.InitBuffer(inQueueX, 1, TILE_LENGTH * sizeof(T));
    pipe.InitBuffer(outQueueY, 1, TILE_LENGTH * sizeof(T));

    uint32_t tileNum = (blockLength + TILE_LENGTH - 1) / TILE_LENGTH;
    for (uint32_t i = 0; i < tileNum; ++i) {
        uint32_t offset = i * TILE_LENGTH;
        uint32_t currLen = (offset + TILE_LENGTH <= blockLength) ? TILE_LENGTH : (blockLength - offset);

        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm[offset], currLen);
        inQueueX.EnQue(xLocal);

        xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = outQueueY.AllocTensor<T>();
        AscendC::Relu(yLocal, xLocal, static_cast<int32_t>(currLen));
        outQueueY.EnQue(yLocal);
        inQueueX.FreeTensor(xLocal);

        yLocal = outQueueY.DeQue<T>();
        AscendC::DataCopy(yGm[offset], yLocal, currLen);
        outQueueY.FreeTensor(yLocal);
    }
}

static uint32_t GetTotalLength(const TensorGroupInfo &info)
{
    uint32_t totalLength = 1;
    if (info.numTensors > 0 && info.tensors[0].shape != nullptr) {
        for (int64_t i = 0; i < info.tensors[0].numDims; ++i) {
            totalLength *= static_cast<uint32_t>(info.tensors[0].shape[i]);
        }
    }
    return totalLength;
}

static uint32_t GetBlockNum(int64_t availableCoreNum)
{
    uint32_t blockNum = 1;
    if (availableCoreNum >= 8) {
        blockNum = 8;
    } else if (availableCoreNum >= 4) {
        blockNum = 4;
    } else if (availableCoreNum >= 2) {
        blockNum = 2;
    }
    return blockNum;
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo &info_x, GM_ADDR y, const TensorGroupInfo &info_y,
                           int64_t availableCoreNum, aclrtStream stream)
{
    uint32_t totalLength = GetTotalLength(info_x);
    uint32_t blockNum = GetBlockNum(availableCoreNum);
    int32_t dtype = (info_x.numTensors > 0) ? info_x.tensors[0].dtype : 0;

    if (dtype == 1) {
        relu_custom<half><<<blockNum, nullptr, stream>>>(x, y, totalLength);
    } else {
        relu_custom<float><<<blockNum, nullptr, stream>>>(x, y, totalLength);
    }
}