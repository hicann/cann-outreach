#include <cmath>
#include "kernel_operator.h"
/*
 * Relu Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 *
 * y = Relu(x) = max(0, x), element-wise.
 */

constexpr uint32_t BUFFER_NUM = 1;
constexpr uint32_t TILE_LENGTH = 2048;

struct ReluCustomTilingData {
    uint32_t totalLength;
    uint32_t perCoreLen;
    uint32_t tileLength;
    int32_t dtype;
};

template <typename T>
class KernelRelu {
public:
    __aicore__ inline KernelRelu() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, const ReluCustomTilingData &tiling)
    {
        const uint32_t blockIdx = AscendC::GetBlockIdx();
        const uint32_t blockNum = AscendC::GetBlockNum();
        this->tileLength = (tiling.tileLength > 0) ? tiling.tileLength : TILE_LENGTH;
        this->offset = blockIdx * tiling.perCoreLen;
        if (blockIdx + 1 == blockNum) {
            this->coreLength = (tiling.totalLength > this->offset) ?
                               (tiling.totalLength - this->offset) : 0;
        } else {
            this->coreLength = tiling.perCoreLen;
        }

        if (this->coreLength > 0) {
            xGm.SetGlobalBuffer((__gm__ T *)x + this->offset, this->coreLength);
            yGm.SetGlobalBuffer((__gm__ T *)y + this->offset, this->coreLength);
        }
        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(outQueueY, BUFFER_NUM, this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        uint32_t loopOffset = 0;
        while (loopOffset < this->coreLength) {
            uint32_t count = this->coreLength - loopOffset;
            if (count > this->tileLength) {
                count = this->tileLength;
            }
            const uint32_t calcCount = AlignUp(count);
            CopyIn(loopOffset, calcCount);
            Compute(calcCount);
            CopyOut(loopOffset, calcCount);
            loopOffset += count;
        }
    }

private:
    __aicore__ inline uint32_t AlignUp(uint32_t count)
    {
        const uint32_t alignElems = static_cast<uint32_t>(32 / sizeof(T));
        return (count + alignElems - 1) / alignElems * alignElems;
    }

    __aicore__ inline void CopyIn(uint32_t gmOffset, uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm[gmOffset], count);
        inQueueX.EnQue(xLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = outQueueY.AllocTensor<T>();
        AscendC::Relu(yLocal, xLocal, count);
        outQueueY.EnQue(yLocal);
        inQueueX.FreeTensor(xLocal);
    }

    __aicore__ inline void CopyOut(uint32_t gmOffset, uint32_t count)
    {
        AscendC::LocalTensor<T> yLocal = outQueueY.DeQue<T>();
        AscendC::DataCopy(yGm[gmOffset], yLocal, count);
        outQueueY.FreeTensor(yLocal);
    }

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inQueueX;
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_NUM> outQueueY;
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    uint32_t coreLength = 0;
    uint32_t tileLength = 0;
    uint32_t offset = 0;
};

__global__ __vector__ void relu_custom(GM_ADDR x, GM_ADDR y, ReluCustomTilingData tiling)
{
    if (tiling.dtype == 1) {
        KernelRelu<half> op;
        op.Init(x, y, tiling);
        op.Process();
    } else if (tiling.dtype == 5) {
        KernelRelu<int32_t> op;
        op.Init(x, y, tiling);
        op.Process();
    } else {
        KernelRelu<float> op;
        op.Init(x, y, tiling);
        op.Process();
    }
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo &info_x, GM_ADDR y,
                           const TensorGroupInfo &info_y, int64_t availableCoreNum,
                           aclrtStream stream)
{
    (void)info_y;
    if (info_x.tensors == nullptr || info_x.numTensors < 1) {
        return;
    }

    const TensorInfo &tensorInfo = info_x.tensors[0];
    int64_t totalLength = 1;
    if (tensorInfo.shape != nullptr) {
        for (int64_t i = 0; i < tensorInfo.numDims; ++i) {
            if (tensorInfo.shape[i] <= 0) {
                return;
            }
            totalLength *= tensorInfo.shape[i];
        }
    }
    if (totalLength <= 0) {
        return;
    }

    const int64_t elemSize = (tensorInfo.dtype == 1) ? 2 : 4;
    const int64_t alignElems = 32 / elemSize;

    int64_t coreNum = (availableCoreNum > 0) ? availableCoreNum : 1;
    if (coreNum > totalLength) {
        coreNum = totalLength;
    }
    if (coreNum < 1) {
        coreNum = 1;
    }

    int64_t perCoreLen = (totalLength / coreNum / alignElems) * alignElems;
    if (perCoreLen <= 0) {
        coreNum = 1;
        perCoreLen = totalLength;
    }

    ReluCustomTilingData tiling;
    tiling.totalLength = static_cast<uint32_t>(totalLength);
    tiling.perCoreLen = static_cast<uint32_t>(perCoreLen);
    tiling.tileLength = TILE_LENGTH;
    tiling.dtype = tensorInfo.dtype;

    relu_custom<<<static_cast<uint32_t>(coreNum), nullptr, stream>>>(x, y, tiling);
}
