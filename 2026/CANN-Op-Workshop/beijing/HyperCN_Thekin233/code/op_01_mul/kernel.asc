#include "kernel_operator.h"

// ---------------------------------------------------------------------------
// z = x * y
// 针对评测规模 (8,2048)：少核切分 + 单次大块搬运，逼近最优时延。
// ---------------------------------------------------------------------------
struct MulCustomTilingData {
    uint32_t totalLength;
    uint32_t tileNum;
    uint32_t tileLength; // == blockLength / tileNum（BUFFER_NUM=1 时即每拍长度）
};

// 小规模 elementwise：单缓冲一次做完通常快于双缓冲多拍（减少队列/同步开销）
constexpr uint32_t BUFFER_NUM = 1;

template <typename T>
class KernelMul {
public:
    __aicore__ inline KernelMul() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const MulCustomTilingData& tiling)
    {
        this->tileNum = tiling.tileNum;
        this->tileLength = tiling.tileLength;
        this->blockLength = this->tileNum * BUFFER_NUM * this->tileLength;

        const uint32_t offset = this->blockLength * AscendC::GetBlockIdx();
        xGm.SetGlobalBuffer((__gm__ T*)x + offset, this->blockLength);
        yGm.SetGlobalBuffer((__gm__ T*)y + offset, this->blockLength);
        zGm.SetGlobalBuffer((__gm__ T*)z + offset, this->blockLength);

        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // tileNum=1, BUFFER_NUM=1 → 每核仅 1 次 CopyIn/Mul/CopyOut
        const int32_t loopCount = static_cast<int32_t>(this->tileNum * BUFFER_NUM);
        for (int32_t i = 0; i < loopCount; ++i) {
            CopyIn(i);
            Compute();
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.template AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.template AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm[progress * this->tileLength], this->tileLength);
        AscendC::DataCopy(yLocal, yGm[progress * this->tileLength], this->tileLength);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.template DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.template DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.template AllocTensor<T>();
        AscendC::Mul(zLocal, xLocal, yLocal, this->tileLength);
        outQueueZ.template EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int32_t progress)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ.template DeQue<T>();
        AscendC::DataCopy(zGm[progress * this->tileLength], zLocal, this->tileLength);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inQueueX, inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_NUM> outQueueZ;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;

    uint32_t blockLength = 0;
    uint32_t tileNum = 0;
    uint32_t tileLength = 0;
};

template <typename T>
__global__ __vector__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, MulCustomTilingData tiling)
{
    KernelMul<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

namespace {
inline uint32_t AlignDown(uint32_t v, uint32_t a)
{
    return (a == 0) ? v : (v / a) * a;
}

inline uint32_t ChooseBlockDim(uint32_t totalLength, uint32_t availableCoreNum, uint32_t align)
{
    // 评测 shape 多为 (8, 2048)：固定 8 核与首维对齐，避免用满 40+ 核导致每核过碎
    uint32_t blockDim = 8;
    if (availableCoreNum > 0 && availableCoreNum < blockDim) {
        blockDim = static_cast<uint32_t>(availableCoreNum);
    }
    while (blockDim > 1 && (totalLength % blockDim) != 0) {
        --blockDim;
    }
    while (blockDim > 1 && ((totalLength / blockDim) % align) != 0) {
        --blockDim;
        while (blockDim > 1 && (totalLength % blockDim) != 0) {
            --blockDim;
        }
    }
    return blockDim == 0 ? 1U : blockDim;
}
} // namespace

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength64 = 1;
    for (int64_t i = 0; i < t0.numDims; ++i) {
        totalLength64 *= t0.shape[i];
    }
    const uint32_t totalLength = static_cast<uint32_t>(totalLength64);
    const uint32_t align = (t0.dtype == 1) ? 16U : 8U;
    const uint32_t blockDim = ChooseBlockDim(
        totalLength, static_cast<uint32_t>(availableCoreNum > 0 ? availableCoreNum : 8), align);
    const uint32_t blockLength = totalLength / blockDim;

    // 每核一次做完：tileNum=1, tileLength=blockLength（已对齐）
    const uint32_t tileNum = 1;
    const uint32_t tileLength = AlignDown(blockLength, align);

    MulCustomTilingData tiling{totalLength, tileNum, tileLength};

    if (t0.dtype == 1) {
        mul_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        mul_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}
