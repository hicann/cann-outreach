#include <cmath>
#include "kernel_operator.h"
/*
 * Mul Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 ...
 *
 * 数学定义:  z_i = x_i * y_i
 *
 * 关键设计（沿用上一题 Sub 的排错结论）:
 *   本环境里双目 SIMD 以 half / bfloat16_t 实例化会编译失败（vmul 不接受对应指针类型），
 *   以 float 实例化则正常。因此：
 *     - float    : 原生 Mul，一条指令，最快。
 *     - half/bf16: 升到 fp32 做乘法，再 RNE 舍回原精度。
 *
 *   fp32 中转对乘法同样是「逐位正确」的，不是降精度妥协：
 *     fp16 有效尾数 11 位，两数之积的精确尾数 <= 22 位，而 fp32 有 24 位尾数，
 *     故 fp32 乘法的结果即「精确积」，无任何中间舍入；
 *     再按 round-to-nearest-even 舍回 fp16，正是 IEEE 对原生 fp16 乘法的定义。
 *     bf16 有效尾数 8 位，积 <= 16 位，同理。
 *   指数域同理安全：fp16 的溢出/下溢在 fp32 中不会发生，
 *     最终由 Cast 一次性舍入到 fp16 的 inf / subnormal，与硬件原生行为一致。
 */

using namespace AscendC;

/* ------------------------------ 常量配置 ------------------------------ */
constexpr int32_t  AG_BUFFER_NUM  = 2;      // 输入/输出队列双缓冲
constexpr uint32_t AG_ALIGN_BYTES = 32;     // GM <-> UB 搬运对齐粒度
constexpr uint32_t AG_TILE_ELEMS  = 1024;   // 单 tile 元素个数
constexpr float    AG_ZERO        = 0.0f;

/* ------------------------- 是否可用原生 Mul ------------------------- *
 * float 可用；half / bfloat16_t 不可用，走 fp32 中转。                  */
template <typename T> struct AgMulNative { enum { value = 0 }; };
template <>           struct AgMulNative<float> { enum { value = 1 }; };

/* ------------------------- 精度转换 helper ------------------------- *
 * 低 -> 高（half/bf16 -> fp32）：无损，CAST_NONE。
 * fp32 -> fp32：Cast 不支持同类型转换，用 Adds +0 等价拷贝。
 * 高 -> 低（fp32 -> half/bf16）：显式 CAST_RINT（四舍六入五成双），
 *      与 numpy astype / 硬件原生乘法语义一致；
 *      注意 bfloat16_t 的 Cast 不支持 CAST_NONE。 */
__aicore__ inline void AgToF32(const LocalTensor<float>& dst, const LocalTensor<float>& src, const int32_t& count)
{
    Adds(dst, src, AG_ZERO, count);
}
__aicore__ inline void AgToF32(const LocalTensor<float>& dst, const LocalTensor<half>& src, const int32_t& count)
{
    Cast(dst, src, RoundMode::CAST_NONE, count);
}
__aicore__ inline void AgToF32(const LocalTensor<float>& dst, const LocalTensor<bfloat16_t>& src, const int32_t& count)
{
    Cast(dst, src, RoundMode::CAST_NONE, count);
}

__aicore__ inline void AgFromF32(const LocalTensor<float>& dst, const LocalTensor<float>& src, const int32_t& count)
{
    Adds(dst, src, AG_ZERO, count);
}
__aicore__ inline void AgFromF32(const LocalTensor<half>& dst, const LocalTensor<float>& src, const int32_t& count)
{
    Cast(dst, src, RoundMode::CAST_RINT, count);
}
__aicore__ inline void AgFromF32(const LocalTensor<bfloat16_t>& dst, const LocalTensor<float>& src, const int32_t& count)
{
    Cast(dst, src, RoundMode::CAST_RINT, count);
}

/* ------------------------------ Kernel 主体 ------------------------------ */
template <typename T, int NATIVE>
class KernelMul;

/* ---- NATIVE=1：float，原生 Mul ---- */
template <typename T>
class KernelMul<T, 1> {
public:
    __aicore__ inline KernelMul() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                uint64_t totalLength, uint64_t blockLength, uint32_t tileLength)
    {
        this->tileLength = tileLength;
        this->alignElems = AG_ALIGN_BYTES / sizeof(T);

        uint64_t startIdx = static_cast<uint64_t>(GetBlockIdx()) * blockLength;
        this->length = (startIdx >= totalLength) ? 0
                     : (totalLength - startIdx < blockLength) ? (totalLength - startIdx) : blockLength;

        uint64_t bufLen = (this->length == 0) ? 1 : this->length;   // 避免 0 长度 SetGlobalBuffer
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x) + startIdx, bufLen);
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y) + startIdx, bufLen);
        zGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z) + startIdx, bufLen);

        pipe.InitBuffer(inQueueX, AG_BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, AG_BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, AG_BUFFER_NUM, this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        if (this->length == 0) {
            return;
        }
        uint32_t loopCount = (static_cast<uint32_t>(this->length) + this->tileLength - 1) / this->tileLength;
        for (uint32_t i = 0; i < loopCount; ++i) {
            uint32_t offset = i * this->tileLength;
            uint32_t count  = static_cast<uint32_t>(this->length) - offset;
            if (count > this->tileLength) {
                count = this->tileLength;
            }
            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset, uint32_t count)
    {
        LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();

        if ((count % this->alignElems) == 0) {
            DataCopy(xLocal, xGm[offset], count);
            DataCopy(yLocal, yGm[offset], count);
        } else {
            DataCopyExtParams copyParams{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
            DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
            DataCopyPad(xLocal, xGm[offset], copyParams, padParams);
            DataCopyPad(yLocal, yGm[offset], copyParams, padParams);
        }
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();

        const int32_t cnt = static_cast<int32_t>(count);   // 具名左值，避免绑定临时量
        Mul(zLocal, xLocal, yLocal, cnt);

        outQueueZ.EnQue(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t count)
    {
        LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        if ((count % this->alignElems) == 0) {
            DataCopy(zGm[offset], zLocal, count);
        } else {
            DataCopyParams copyParams;
            copyParams.blockCount = 1;
            copyParams.blockLen   = static_cast<uint16_t>(count * sizeof(T));
            copyParams.srcStride  = 0;
            copyParams.dstStride  = 0;
            DataCopyPad(zGm[offset], zLocal, copyParams);
        }
        outQueueZ.FreeTensor(zLocal);
    }

private:
    TPipe pipe;
    TQue<QuePosition::VECIN,  AG_BUFFER_NUM> inQueueX, inQueueY;
    TQue<QuePosition::VECOUT, AG_BUFFER_NUM> outQueueZ;
    GlobalTensor<T> xGm, yGm, zGm;
    uint64_t length     = 0;
    uint32_t tileLength = 0;
    uint32_t alignElems = 8;
};

/* ---- NATIVE=0：half / bfloat16_t，fp32 中转 ---- */
template <typename T>
class KernelMul<T, 0> {
public:
    __aicore__ inline KernelMul() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                uint64_t totalLength, uint64_t blockLength, uint32_t tileLength)
    {
        this->tileLength = tileLength;
        this->alignElems = AG_ALIGN_BYTES / sizeof(T);

        uint64_t startIdx = static_cast<uint64_t>(GetBlockIdx()) * blockLength;
        this->length = (startIdx >= totalLength) ? 0
                     : (totalLength - startIdx < blockLength) ? (totalLength - startIdx) : blockLength;

        uint64_t bufLen = (this->length == 0) ? 1 : this->length;
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x) + startIdx, bufLen);
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y) + startIdx, bufLen);
        zGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(z) + startIdx, bufLen);

        pipe.InitBuffer(inQueueX, AG_BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, AG_BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, AG_BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(tmpFA,   this->tileLength * sizeof(float));
        pipe.InitBuffer(tmpFB,   this->tileLength * sizeof(float));
        pipe.InitBuffer(tmpFOut, this->tileLength * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        if (this->length == 0) {
            return;
        }
        uint32_t loopCount = (static_cast<uint32_t>(this->length) + this->tileLength - 1) / this->tileLength;
        for (uint32_t i = 0; i < loopCount; ++i) {
            uint32_t offset = i * this->tileLength;
            uint32_t count  = static_cast<uint32_t>(this->length) - offset;
            if (count > this->tileLength) {
                count = this->tileLength;
            }
            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset, uint32_t count)
    {
        LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();

        if ((count % this->alignElems) == 0) {
            DataCopy(xLocal, xGm[offset], count);
            DataCopy(yLocal, yGm[offset], count);
        } else {
            DataCopyExtParams copyParams{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
            DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
            DataCopyPad(xLocal, xGm[offset], copyParams, padParams);
            DataCopyPad(yLocal, yGm[offset], copyParams, padParams);
        }
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        LocalTensor<T>   xLocal = inQueueX.DeQue<T>();
        LocalTensor<T>   yLocal = inQueueY.DeQue<T>();
        LocalTensor<T>   zLocal = outQueueZ.AllocTensor<T>();
        LocalTensor<float> fa   = tmpFA.Get<float>();
        LocalTensor<float> fb   = tmpFB.Get<float>();
        LocalTensor<float> fout = tmpFOut.Get<float>();

        const int32_t cnt = static_cast<int32_t>(count);
        AgToF32(fa, xLocal, cnt);
        AgToF32(fb, yLocal, cnt);
        Mul(fout, fa, fb, cnt);        // 只在 float 上实例化 Mul
        AgFromF32(zLocal, fout, cnt);

        outQueueZ.EnQue(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t count)
    {
        LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        if ((count % this->alignElems) == 0) {
            DataCopy(zGm[offset], zLocal, count);
        } else {
            DataCopyParams copyParams;
            copyParams.blockCount = 1;
            copyParams.blockLen   = static_cast<uint16_t>(count * sizeof(T));
            copyParams.srcStride  = 0;
            copyParams.dstStride  = 0;
            DataCopyPad(zGm[offset], zLocal, copyParams);
        }
        outQueueZ.FreeTensor(zLocal);
    }

private:
    TPipe pipe;
    TQue<QuePosition::VECIN,  AG_BUFFER_NUM> inQueueX, inQueueY;
    TQue<QuePosition::VECOUT, AG_BUFFER_NUM> outQueueZ;
    TBuf<TPosition::VECCALC> tmpFA, tmpFB, tmpFOut;
    GlobalTensor<T> xGm, yGm, zGm;
    uint64_t length     = 0;
    uint32_t tileLength = 0;
    uint32_t alignElems = 8;
};

/* ------------------------------ 核函数与分发 ------------------------------ */
template <typename T>
__aicore__ inline void MulImpl(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                               uint64_t totalLength, uint64_t blockLength, uint32_t tileLength)
{
    KernelMul<T, AgMulNative<T>::value> op;
    op.Init(x, y, z, totalLength, blockLength, tileLength);
    op.Process();
}

__global__ __vector__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                      uint64_t totalLength, uint64_t blockLength,
                                      uint32_t tileLength, int32_t dtype)
{
    if (dtype == 1) {                  // fp16
        MulImpl<half>(x, y, z, totalLength, blockLength, tileLength);
    } else if (dtype == 2) {           // bf16
        MulImpl<bfloat16_t>(x, y, z, totalLength, blockLength, tileLength);
    } else {                           // fp32
        MulImpl<float>(x, y, z, totalLength, blockLength, tileLength);
    }
}

/* ------------------------------ Host 侧 Launch ------------------------------ */
static inline int64_t AgCountElems(const TensorGroupInfo& info)
{
    if (info.numTensors <= 0) {
        return -1;
    }
    const TensorInfo& t = info.tensors[0];
    int64_t n = 1;
    for (int64_t i = 0; i < t.numDims; ++i) {
        n *= t.shape[i];
    }
    return n;
}

static inline uint32_t AgElemSize(int32_t dtype)
{
    return (dtype == 1 || dtype == 2) ? 2U : 4U;   // fp16/bf16:2B  fp32:4B
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    (void)info_y;
    (void)z;

    if (info_x.numTensors <= 0) {
        return;
    }

    // 元素数以输出 z 为准：输出必须被完整写满；拿不到时退回输入
    int64_t totalLength = AgCountElems(info_z);
    if (totalLength <= 0) {
        totalLength = AgCountElems(info_x);
    }
    if (totalLength <= 0) {
        return;
    }

    const int32_t  dtype      = info_x.tensors[0].dtype;
    const uint32_t elemSize   = AgElemSize(dtype);
    const uint32_t alignElems = AG_ALIGN_BYTES / elemSize;   // fp32:8  fp16/bf16:16

    // 核数裁剪：保证每个核至少分到一个 tile，避免空跑
    const uint32_t tileLength = AG_TILE_ELEMS;
    const uint64_t maxTiles   = (static_cast<uint64_t>(totalLength) + tileLength - 1) / tileLength;
    int64_t blockNum = availableCoreNum;
    if (blockNum > static_cast<int64_t>(maxTiles)) {
        blockNum = static_cast<int64_t>(maxTiles);
    }
    if (blockNum < 1) {
        blockNum = 1;
    }

    uint64_t perCore = (static_cast<uint64_t>(totalLength) + static_cast<uint64_t>(blockNum) - 1) /
                       static_cast<uint64_t>(blockNum);
    uint64_t blockLength = ((perCore + alignElems - 1) / alignElems) * alignElems;

    mul_custom<<<static_cast<uint32_t>(blockNum), nullptr, stream>>>(
        x, y, z, static_cast<uint64_t>(totalLength), blockLength, tileLength, dtype);
}
