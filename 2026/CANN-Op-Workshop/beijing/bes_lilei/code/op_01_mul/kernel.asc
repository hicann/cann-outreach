#include <cmath>
#include "kernel_operator.h"

// ---------------------------------------------------------------------------
// Tiling 参数：由 host 侧 run_kernel 计算后按值传给核函数
// ---------------------------------------------------------------------------
struct MulCustomTilingData {
    uint32_t totalLength; // 总元素个数
    uint32_t tileNum;     // 每个核需要处理的数据块数量（题目固定为8）
};

constexpr uint32_t BUFFER_NUM = 2;   // double buffer
constexpr uint32_t QUEUE_DEPTH = 1;

// ---------------------------------------------------------------------------
// KernelMul：z = x * y
// ---------------------------------------------------------------------------
template <typename T>
class KernelMul {
public:
    __aicore__ inline KernelMul() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const MulCustomTilingData& tiling)
    {
        // 1. 初始化 Global Memory 地址
        xGm.SetGlobalBuffer((__gm__ T*)x);
        yGm.SetGlobalBuffer((__gm__ T*)y);
        zGm.SetGlobalBuffer((__gm__ T*)z);

        // 2. 解析 Tiling 参数
        this->tileNum = tiling.tileNum;
        
        // 3. 计算每个核负责的总长度和每个 Tile 的长度
        // 获取当前核索引
        uint32_t coreId = AscendC::GetBlockIdx();
        // 假设数据在所有核间均匀切分（简化策略）
        // blockLength = totalLength / blockDim (这里blockDim在host侧是8)
        // 注意：实际生产中需考虑对齐，此处按赛题简化逻辑实现
        uint32_t blockDim = 8; 
        this->blockLength = tiling.totalLength / blockDim;
        this->tileLength = this->blockLength / this->tileNum;

        // 4. 初始化 Pipe 内存队列
        // 为输入X、Y分配 VECIN 缓冲区，为输出Z分配 VECOUT 缓冲区
        // Double Buffer 需要分配 BUFFER_NUM 份空间
        pipe.InitBuffer(inQueueX, BUFFER_NUM, tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        int32_t loopCount = this->tileNum * BUFFER_NUM;
        for (int32_t i = 0; i < loopCount; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        // 计算当前进度对应的实际 Tile 索引
        // Double Buffer 下，progress 0,2,4... 对应 Tile 0,1,2... (Buffer 0)
        // progress 1,3,5... 对应 Tile 0,1,2... (Buffer 1)
        uint32_t tileIdx = progress / BUFFER_NUM;
        
        // 边界保护：如果超出该核负责的范围则跳过
        if (tileIdx >= tileNum) return;

        // 计算当前核在全局数据中的起始偏移
        uint32_t coreId = AscendC::GetBlockIdx();
        uint32_t globalOffset = coreId * blockLength + tileIdx * tileLength;

        // 从 GM 搬运数据到 Local Memory (VECIN)
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        
        AscendC::DataCopy(xLocal, xGm[globalOffset], tileLength);
        AscendC::DataCopy(yLocal, yGm[globalOffset], tileLength);
        
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(int32_t progress)
    {
        uint32_t tileIdx = progress / BUFFER_NUM;
        if (tileIdx >= tileNum) return;

        // 从队列中取出输入数据
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();

        // 执行矢量乘法: z = x * y
        AscendC::Mul(zLocal, xLocal, yLocal, tileLength);

        // 结果入队
        outQueueZ.EnQue(zLocal);
        
        // 释放输入缓冲区供下次使用
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int32_t progress)
    {
        uint32_t tileIdx = progress / BUFFER_NUM;
        if (tileIdx >= tileNum) return;

        uint32_t coreId = AscendC::GetBlockIdx();
        uint32_t globalOffset = coreId * blockLength + tileIdx * tileLength;

        // 从 VECOUT 队列取出结果并写回 GM
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopy(zGm[globalOffset], zLocal, tileLength);
        
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueX, inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH> outQueueZ;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;

    uint32_t blockLength;
    uint32_t tileNum;
    uint32_t tileLength;
};

// ---------------------------------------------------------------------------
// 核函数入口：实例化 KernelMul<T> 并执行（T 由 run_kernel 按输入 dtype 选择）
// ---------------------------------------------------------------------------
template <typename T>
__global__ __vector__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, MulCustomTilingData tiling)
{
    KernelMul<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

// ---------------------------------------------------------------------------
// host 侧启动函数：从 TensorGroupInfo 推导 tiling 并启动核函数
// ---------------------------------------------------------------------------
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    constexpr uint32_t blockDim = 8;
    // 1. 取总元素数（x/y/z 形状一致）
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }
    // 2. 按输入 dtype 选择核函数实例（dtype 定义见 TensorInfo：0=fp32 1=fp16 2=bf16 ...）
    int32_t dtype = t0.dtype;
    // 为了简化计算，tileNum 设置为 8
    uint32_t tileNum = 8;

    MulCustomTilingData tiling = {(uint32_t)totalLength, tileNum};
    if (dtype == 1) {
        // fp16：half 实例
        mul_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        // fp32 及其他类型默认走 float 实例
        mul_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}
