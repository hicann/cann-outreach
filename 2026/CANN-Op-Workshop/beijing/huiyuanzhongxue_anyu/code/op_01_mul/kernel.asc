#include <cmath>
#include "kernel_operator.h"

using namespace AscendC;

constexpr uint32_t TILE_LENGTH = 2048;

template <typename T>
class KernelMul
{
public:
    __aicore__ inline KernelMul() {}

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        uint32_t offset,
        uint32_t totalCount)
    {
        this->totalCount = totalCount;

        xGm.SetGlobalBuffer((__gm__ T *)x + offset);
        yGm.SetGlobalBuffer((__gm__ T *)y + offset);
        zGm.SetGlobalBuffer((__gm__ T *)z + offset);

        pipe.InitBuffer(xQueue, 1, TILE_LENGTH * sizeof(T));
        pipe.InitBuffer(yQueue, 1, TILE_LENGTH * sizeof(T));
        pipe.InitBuffer(zQueue, 1, TILE_LENGTH * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        uint32_t loopCount =
            (totalCount + TILE_LENGTH - 1) / TILE_LENGTH;

        for (uint32_t index = 0; index < loopCount; ++index)
        {
            uint32_t tileOffset = index * TILE_LENGTH;
            uint32_t remaining = totalCount - tileOffset;
            uint32_t count =
                remaining < TILE_LENGTH ? remaining : TILE_LENGTH;

            CopyIn(tileOffset, count);
            Compute(count);
            CopyOut(tileOffset, count);
        }
    }

private:
    __aicore__ inline void CopyIn(
        uint32_t tileOffset,
        uint32_t count)
    {
        LocalTensor<T> xLocal = xQueue.AllocTensor<T>();
        LocalTensor<T> yLocal = yQueue.AllocTensor<T>();

        DataCopy(xLocal, xGm[tileOffset], count);
        DataCopy(yLocal, yGm[tileOffset], count);

        xQueue.EnQue(xLocal);
        yQueue.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        LocalTensor<T> xLocal = xQueue.DeQue<T>();
        LocalTensor<T> yLocal = yQueue.DeQue<T>();
        LocalTensor<T> zLocal = zQueue.AllocTensor<T>();

        Mul(zLocal, xLocal, yLocal, count);

        zQueue.EnQue(zLocal);
        xQueue.FreeTensor(xLocal);
        yQueue.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(
        uint32_t tileOffset,
        uint32_t count)
    {
        LocalTensor<T> zLocal = zQueue.DeQue<T>();

        DataCopy(zGm[tileOffset], zLocal, count);

        zQueue.FreeTensor(zLocal);
    }

private:
    TPipe pipe;
    TQue<TPosition::VECIN, 1> xQueue;
    TQue<TPosition::VECIN, 1> yQueue;
    TQue<TPosition::VECOUT, 1> zQueue;

    GlobalTensor<T> xGm;
    GlobalTensor<T> yGm;
    GlobalTensor<T> zGm;

    uint32_t totalCount = 0;
};

extern "C" __global__ __vector__ void mul_custom_half(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    uint32_t totalCount,
    uint32_t perBlock)
{
    uint32_t offset = (uint32_t)GetBlockIdx() * perBlock;

    if (offset >= totalCount)
    {
        return;
    }

    uint32_t remaining = totalCount - offset;
    uint32_t count = remaining < perBlock ? remaining : perBlock;

    KernelMul<half> op;
    op.Init(x, y, z, offset, count);
    op.Process();
}

extern "C" __global__ __vector__ void mul_custom_float(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    uint32_t totalCount,
    uint32_t perBlock)
{
    uint32_t offset = (uint32_t)GetBlockIdx() * perBlock;

    if (offset >= totalCount)
    {
        return;
    }

    uint32_t remaining = totalCount - offset;
    uint32_t count = remaining < perBlock ? remaining : perBlock;

    KernelMul<float> op;
    op.Init(x, y, z, offset, count);
    op.Process();
}

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo &info_x,
    GM_ADDR y,
    const TensorGroupInfo &info_y,
    GM_ADDR z,
    const TensorGroupInfo &info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    const TensorInfo &xInfo = info_x.tensors[0];

    int64_t total = 1;
    for (int64_t dimension = 0;
         dimension < xInfo.numDims;
         ++dimension)
    {
        total *= xInfo.shape[dimension];
    }

    if (total <= 0)
    {
        return;
    }

    uint32_t totalCount = (uint32_t)total;
    uint32_t totalTiles =
        (totalCount + TILE_LENGTH - 1) / TILE_LENGTH;

    uint32_t blockNum =
        availableCoreNum > 0 ? (uint32_t)availableCoreNum : 1;

    if (blockNum > totalTiles)
    {
        blockNum = totalTiles;
    }

    uint32_t tilesPerBlock =
        (totalTiles + blockNum - 1) / blockNum;
    uint32_t perBlock = tilesPerBlock * TILE_LENGTH;

    if (xInfo.dtype == 0)
    {
        mul_custom_float<<<blockNum, nullptr, stream>>>(
            x, y, z, totalCount, perBlock);
    }
    else
    {
        mul_custom_half<<<blockNum, nullptr, stream>>>(
            x, y, z, totalCount, perBlock);
    }
}