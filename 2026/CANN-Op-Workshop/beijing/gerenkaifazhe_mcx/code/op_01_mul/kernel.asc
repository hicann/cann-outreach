#include <cstdint>
#include <cmath>
#include "kernel_operator.h"
/*
 * Mul Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 *
 * z = x * y, 多核分块 + 双缓冲流水, 支持 fp32/fp16/bf16。
 */

namespace MulCustom {

using namespace AscendC;

// 单次搬入UB的元素数（16的整数倍，fp32/fp16下均能保证32B对齐）
constexpr uint32_t TILE_LENGTH = 2048;
// 队列深度（双缓冲）
constexpr uint32_t BUFFER_NUM = 2;

template <typename T>
class KernelMul {
public:
    __aicore__ inline KernelMul() {}

    __aicore__ inline void Init(__gm__ uint8_t* x, __gm__ uint8_t* y, __gm__ uint8_t* z,
                                uint32_t totalNum, uint32_t blockNum, TPipe* pipeIn)
    {
        uint32_t alignedElem = AlignElems();
        uint32_t blockIdx = GetBlockIdx();
        // 以32B对齐块为单位切分，保证各核起始偏移32B对齐；
        // 末尾不足一个对齐块的元素由最后一个核用DataCopyPad处理
        uint32_t chunkNum = totalNum / alignedElem;
        uint32_t tailNum = totalNum - chunkNum * alignedElem;
        uint32_t perCore = chunkNum / blockNum;
        uint32_t rem = chunkNum % blockNum;
        uint32_t startChunk = 0;
        if (blockIdx < rem) {
            startChunk = blockIdx * (perCore + 1);
            this->length = (perCore + 1) * alignedElem;
        } else {
            startChunk = rem * (perCore + 1) + (blockIdx - rem) * perCore;
            this->length = perCore * alignedElem;
        }
        if (blockIdx == blockNum - 1) {
            this->length += tailNum;
        }
        this->offset = startChunk * alignedElem;

        xGm.SetGlobalBuffer((__gm__ T*)x, totalNum);
        yGm.SetGlobalBuffer((__gm__ T*)y, totalNum);
        zGm.SetGlobalBuffer((__gm__ T*)z, totalNum);

        pipe = pipeIn;
        pipe->InitBuffer(inQueueX, BUFFER_NUM, TILE_LENGTH * sizeof(T));
        pipe->InitBuffer(inQueueY, BUFFER_NUM, TILE_LENGTH * sizeof(T));
        pipe->InitBuffer(outQueueZ, BUFFER_NUM, TILE_LENGTH * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t done = 0; done < this->length; done += TILE_LENGTH) {
            uint32_t curLen = TILE_LENGTH;
            if (done + curLen > this->length) {
                curLen = this->length - done;
            }
            CopyIn(done, curLen);
            Compute(curLen);
            CopyOut(done, curLen);
        }
    }

private:
    // 32B对齐对应的元素数：fp32=8，fp16/bf16=16
    static __aicore__ inline uint32_t AlignElems()
    {
        return (sizeof(T) == 4) ? 8U : 16U;
    }

    __aicore__ inline void CopyIn(uint32_t done, uint32_t curLen)
    {
        LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        if (curLen % AlignElems() == 0) {
            DataCopy(xLocal, xGm[this->offset + done], curLen);
            DataCopy(yLocal, yGm[this->offset + done], curLen);
        } else {
            DataCopyExtParams extParams(1U, static_cast<uint32_t>(curLen * sizeof(T)), 0U, 0U, 0U);
            DataCopyPadExtParams<T> padParams;
            DataCopyPad(xLocal, xGm[this->offset + done], extParams, padParams);
            DataCopyPad(yLocal, yGm[this->offset + done], extParams, padParams);
        }
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t curLen)
    {
        LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        Mul(zLocal, xLocal, yLocal, curLen);
        outQueueZ.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t done, uint32_t curLen)
    {
        LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        if (curLen % AlignElems() == 0) {
            DataCopy(zGm[this->offset + done], zLocal, curLen);
        } else {
            DataCopyExtParams extParams(1U, static_cast<uint32_t>(curLen * sizeof(T)), 0U, 0U, 0U);
            DataCopyPad(zGm[this->offset + done], zLocal, extParams);
        }
        outQueueZ.FreeTensor(zLocal);
    }

private:
    TPipe* pipe;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueX;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueY;
    TQue<TPosition::VECOUT, BUFFER_NUM> outQueueZ;
    GlobalTensor<T> xGm;
    GlobalTensor<T> yGm;
    GlobalTensor<T> zGm;

    uint32_t offset = 0;
    uint32_t length = 0;
};

} // namespace MulCustom

using MulCustom::KernelMul;

__global__ __vector__ void mul_custom(__gm__ uint8_t* x, __gm__ uint8_t* y, __gm__ uint8_t* z,
                                      uint32_t totalNum, uint32_t blockNum)
{
    if ASCEND_IS_AIC {
        return;
    }
    AscendC::TPipe pipe;
    KernelMul<float> op;
    op.Init(x, y, z, totalNum, blockNum, &pipe);
    op.Process();
}

__global__ __vector__ void mul_custom_fp16(__gm__ uint8_t* x, __gm__ uint8_t* y, __gm__ uint8_t* z,
                                           uint32_t totalNum, uint32_t blockNum)
{
    if ASCEND_IS_AIC {
        return;
    }
    AscendC::TPipe pipe;
    KernelMul<half> op;
    op.Init(x, y, z, totalNum, blockNum, &pipe);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    int64_t totalNum = 1;
    const TensorInfo& zInfo = info_z.tensors[0];
    for (int64_t i = 0; i < zInfo.numDims; ++i) {
        totalNum *= zInfo.shape[i];
    }
    int64_t blockNum = availableCoreNum;
    if (blockNum > totalNum) {
        blockNum = totalNum;
    }
    if (blockNum < 1) {
        blockNum = 1;
    }
    if (info_z.tensors[0].dtype == 1) {
        mul_custom_fp16<<<(uint32_t)blockNum, nullptr, stream>>>(x, y, z, (uint32_t)totalNum, (uint32_t)blockNum);
    } else {
        mul_custom<<<(uint32_t)blockNum, nullptr, stream>>>(x, y, z, (uint32_t)totalNum, (uint32_t)blockNum);
    }
}
