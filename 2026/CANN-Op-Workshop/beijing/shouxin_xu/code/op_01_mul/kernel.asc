#include <cstdint>
#include "kernel_operator.h"
constexpr uint32_t MUL_TILE_LENGTH = 1024;
constexpr int32_t MUL_BUFFER_NUM = 2;
template <typename T>
class KernelMul {
public:
    __aicore__ inline KernelMul() {}
        __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint64_t n) {
                totalLength_ = n;
                        xGm_.SetGlobalBuffer((__gm__ T*)x, n);
                                yGm_.SetGlobalBuffer((__gm__ T*)y, n);
                                        zGm_.SetGlobalBuffer((__gm__ T*)z, n);
                                                pipe_.InitBuffer(inQueueX_, MUL_BUFFER_NUM, MUL_TILE_LENGTH * sizeof(T));
                                                        pipe_.InitBuffer(inQueueY_, MUL_BUFFER_NUM, MUL_TILE_LENGTH * sizeof(T));
                                                                pipe_.InitBuffer(outQueueZ_, MUL_BUFFER_NUM, MUL_TILE_LENGTH * sizeof(T));
                                                                    }
                                                                        __aicore__ inline void Process() {
                                                                                uint64_t stride = uint64_t(AscendC::GetBlockNum()) * MUL_TILE_LENGTH;
                                                                                        for (uint64_t offset = uint64_t(AscendC::GetBlockIdx()) * MUL_TILE_LENGTH;
                                                                                                     offset < totalLength_; offset += stride) {
                                                                                                                 uint64_t remaining = totalLength_ - offset;
                                                                                                                             uint32_t count = remaining < MUL_TILE_LENGTH ? uint32_t(remaining) : MUL_TILE_LENGTH;
                                                                                                                                         CopyIn(offset, count);
                                                                                                                                                     Compute(count);
                                                                                                                                                                 CopyOut(offset, count);
                                                                                                                                                                         }
                                                                                                                                                                             }
                                                                                                                                                                             private:
                                                                                                                                                                                 __aicore__ inline void CopyIn(uint64_t offset, uint32_t count) {
                                                                                                                                                                                         AscendC::LocalTensor<T> a = inQueueX_.AllocTensor<T>();
                                                                                                                                                                                                 AscendC::LocalTensor<T> b = inQueueY_.AllocTensor<T>();
                                                                                                                                                                                                         if (count * sizeof(T) % 32 == 0) {
                                                                                                                                                                                                                     AscendC::DataCopy(a, xGm_[offset], count);
                                                                                                                                                                                                                                 AscendC::DataCopy(b, yGm_[offset], count);
                                                                                                                                                                                                                                         } else {
                                                                                                                                                                                                                                                     AscendC::DataCopyExtParams p = {1, uint32_t(count * sizeof(T)), 0, 0, 0};
                                                                                                                                                                                                                                                                 AscendC::DataCopyPadExtParams<T> pad = {false, 0, 0, 0};
                                                                                                                                                                                                                                                                             AscendC::DataCopyPad(a, xGm_[offset], p, pad);
                                                                                                                                                                                                                                                                                         AscendC::DataCopyPad(b, yGm_[offset], p, pad);
                                                                                                                                                                                                                                                                                                 }
                                                                                                                                                                                                                                                                                                         inQueueX_.EnQue(a);
                                                                                                                                                                                                                                                                                                                 inQueueY_.EnQue(b);
                                                                                                                                                                                                                                                                                                                     }
                                                                                                                                                                                                                                                                                                                         __aicore__ inline void Compute(uint32_t count) {
                                                                                                                                                                                                                                                                                                                                 AscendC::LocalTensor<T> a = inQueueX_.DeQue<T>();
                                                                                                                                                                                                                                                                                                                                         AscendC::LocalTensor<T> b = inQueueY_.DeQue<T>();
                                                                                                                                                                                                                                                                                                                                                 AscendC::LocalTensor<T> c = outQueueZ_.AllocTensor<T>();
                                                                                                                                                                                                                                                                                                                                                         AscendC::Mul(c, a, b, count);
                                                                                                                                                                                                                                                                                                                                                                 outQueueZ_.EnQue(c);
                                                                                                                                                                                                                                                                                                                                                                         inQueueX_.FreeTensor(a);
                                                                                                                                                                                                                                                                                                                                                                                 inQueueY_.FreeTensor(b);
                                                                                                                                                                                                                                                                                                                                                                                     }
                                                                                                                                                                                                                                                                                                                                                                                         __aicore__ inline void CopyOut(uint64_t offset, uint32_t count) {
                                                                                                                                                                                                                                                                                                                                                                                                 AscendC::LocalTensor<T> c = outQueueZ_.DeQue<T>();
                                                                                                                                                                                                                                                                                                                                                                                                         if (count * sizeof(T) % 32 == 0) {
                                                                                                                                                                                                                                                                                                                                                                                                                     AscendC::DataCopy(zGm_[offset], c, count);
                                                                                                                                                                                                                                                                                                                                                                                                                             } else {
                                                                                                                                                                                                                                                                                                                                                                                                                                         AscendC::DataCopyExtParams p = {1, uint32_t(count * sizeof(T)), 0, 0, 0};
                                                                                                                                                                                                                                                                                                                                                                                                                                                     AscendC::DataCopyPad(zGm_[offset], c, p);
                                                                                                                                                                                                                                                                                                                                                                                                                                                             }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                     outQueueZ_.FreeTensor(c);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                         }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                             AscendC::TPipe pipe_;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 AscendC::TQue<AscendC::QuePosition::VECIN, MUL_BUFFER_NUM> inQueueX_, inQueueY_;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     AscendC::TQue<AscendC::QuePosition::VECOUT, MUL_BUFFER_NUM> outQueueZ_;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         AscendC::GlobalTensor<T> xGm_, yGm_, zGm_;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             uint64_t totalLength_;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             };
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             template <typename T>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             __global__ __vector__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint64_t n) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 KernelMul<T> op;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     op.Init(x, y, z, n);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         op.Process();
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    GM_ADDR y, const TensorGroupInfo& info_y,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               GM_ADDR z, const TensorGroupInfo& info_z,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          int64_t availableCoreNum, aclrtStream stream) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              (void)info_y;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  (void)info_z;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      const TensorInfo& tensor = info_x.tensors[0];
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          uint64_t n = 1;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              for (int64_t i = 0; i < tensor.numDims; ++i) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      if (tensor.shape[i] <= 0) return;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              n *= uint64_t(tensor.shape[i]);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      uint64_t tiles = (n + MUL_TILE_LENGTH - 1) / MUL_TILE_LENGTH;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          uint64_t cores = availableCoreNum > 0 ? uint64_t(availableCoreNum) : 1;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              uint32_t blocks = uint32_t(tiles < cores ? tiles : cores);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  if (tensor.dtype == 0) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          mul_custom<float><<<blocks, nullptr, stream>>>(x, y, z, n);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              } else if (tensor.dtype == 1) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      mul_custom<half><<<blocks, nullptr, stream>>>(x, y, z, n);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          