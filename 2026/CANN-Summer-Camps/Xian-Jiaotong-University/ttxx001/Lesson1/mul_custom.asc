// mul_custom.asc

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

constexpr uint32_t BUFFER_NUM = 2; // tensor num for each queue

struct MulCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelMul {
public:
    __aicore__ inline KernelMul(){}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {
        this->totalLength = totalLength;
        this->tileNum = tileNum;
        
        uint32_t blockNum = GetBlockNum();
        uint32_t blockLength = totalLength / blockNum;
        uint32_t blockOffset = blockLength * this->block_idx;
        
        xGm.SetGlobalBuffer((__gm__ float*)x + blockOffset, blockLength);
        yGm.SetGlobalBuffer((__gm__ float*)y + blockOffset, blockLength);
        zGm.SetGlobalBuffer((__gm__ float*)z + blockOffset, blockLength);
        
        this->blockLength = blockLength;
        this->tileLength = blockLength / tileNum;
        
        pipe.Init();
        queueX.Init(pipe, BUFFER_NUM, this->tileLength * sizeof(float));
        queueY.Init(pipe, BUFFER_NUM, this->tileLength * sizeof(float));
        queueZ.Init(pipe, BUFFER_NUM, this->tileLength * sizeof(float));
    }
    __aicore__ inline void Process()
    {
        uint32_t tileNum = this->blockLength / this->tileLength;
        for (uint32_t i = 0; i < tileNum; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        LocalTensor<float> xLocal = queueX.AllocTensor<float>();
        LocalTensor<float> yLocal = queueY.AllocTensor<float>();
        DataCopy(xLocal, xGm[progress * this->tileLength], this->tileLength);
        DataCopy(yLocal, yGm[progress * this->tileLength], this->tileLength);
        queueX.EnQue(xLocal);
        queueY.EnQue(yLocal);
    }
    __aicore__ inline void Compute(int32_t progress)
    {
        LocalTensor<float> xLocal = queueX.DeQue<float>();
        LocalTensor<float> yLocal = queueY.DeQue<float>();
        LocalTensor<float> zLocal = queueZ.AllocTensor<float>();
        Mul(zLocal, xLocal, yLocal, this->tileLength);
        queueZ.EnQue(zLocal);
        queueX.FreeTensor(xLocal);
        queueY.FreeTensor(yLocal);
    }
    __aicore__ inline void CopyOut(int32_t progress)
    {
        LocalTensor<float> zLocal = queueZ.DeQue<float>();
        DataCopy(zGm[progress * this->tileLength], zLocal, this->tileLength);
        queueZ.FreeTensor(zLocal);
    }

private:
    TPipe pipe;
    TQue<QuePosition::VECIN, BUFFER_NUM> queueX;
    TQue<QuePosition::VECIN, BUFFER_NUM> queueY;
    TQue<QuePosition::VECOUT, BUFFER_NUM> queueZ;
    GlobalTensor<float> xGm;
    GlobalTensor<float> yGm;
    GlobalTensor<float> zGm;
    uint32_t totalLength;
    uint32_t tileNum;
    uint32_t tileLength;
    uint32_t blockLength;
    uint32_t block_idx = GetBlockIdx();
};

__global__ __aicore__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, MulCustomTilingData tiling)
{
    KernelMul op;
    op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    op.Process();
}

std::vector<float> kernel_mul(std::vector<float> &x, std::vector<float> &y)
{
    uint32_t totalLength = x.size();
    uint32_t tileNum = 8;
    MulCustomTilingData tiling;
    tiling.totalLength = totalLength;
    tiling.tileNum = tileNum;
    std::vector<float> z(totalLength);
    
    // 初始化ACL
    if (aclInit(nullptr) != ACL_SUCCESS) {
        std::cout << "aclInit failed" << std::endl;
        return z;
    }
    
    // 设置设备
    auto ret = aclrtSetDevice(0);
    if (ret != ACL_SUCCESS) {
        std::cout << "aclrtSetDevice failed" << std::endl;
        aclFinalize();
        return z;
    }
    
    void *xDevice = nullptr;
    void *yDevice = nullptr;
    void *zDevice = nullptr;
    auto size = totalLength * sizeof(float);
    
    // 分配设备内存并检查返回值
    if (aclrtMalloc(&xDevice, size, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        std::cout << "aclrtMalloc xDevice failed" << std::endl;
        aclrtResetDevice(0);
        aclFinalize();
        return z;
    }
    if (aclrtMalloc(&yDevice, size, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        std::cout << "aclrtMalloc yDevice failed" << std::endl;
        aclrtFree(xDevice);
        aclrtResetDevice(0);
        aclFinalize();
        return z;
    }
    if (aclrtMalloc(&zDevice, size, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        std::cout << "aclrtMalloc zDevice failed" << std::endl;
        aclrtFree(xDevice);
        aclrtFree(yDevice);
        aclrtResetDevice(0);
        aclFinalize();
        return z;
    }
    
    // 拷贝输入数据到设备并检查返回值
    if (aclrtMemcpy(xDevice, size, x.data(), size, ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) {
        std::cout << "aclrtMemcpy x failed" << std::endl;
        aclrtFree(xDevice);
        aclrtFree(yDevice);
        aclrtFree(zDevice);
        aclrtResetDevice(0);
        aclFinalize();
        return z;
    }
    if (aclrtMemcpy(yDevice, size, y.data(), size, ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) {
        std::cout << "aclrtMemcpy y failed" << std::endl;
        aclrtFree(xDevice);
        aclrtFree(yDevice);
        aclrtFree(zDevice);
        aclrtResetDevice(0);
        aclFinalize();
        return z;
    }
    
    // 创建流
    uint32_t blockDim = 4;
    aclrtStream stream = nullptr;
    if (aclrtCreateStream(&stream) != ACL_SUCCESS) {
        std::cout << "aclrtCreateStream failed" << std::endl;
        aclrtFree(xDevice);
        aclrtFree(yDevice);
        aclrtFree(zDevice);
        aclrtResetDevice(0);
        aclFinalize();
        return z;
    }
    
    // 启动kernel
    mul_custom<<<blockDim, nullptr, stream>>>(xDevice, yDevice, zDevice, tiling);
    
    // 同步流并检查返回值
    if (aclrtSynchronizeStream(stream) != ACL_SUCCESS) {
        std::cout << "aclrtSynchronizeStream failed" << std::endl;
        aclrtFree(xDevice);
        aclrtFree(yDevice);
        aclrtFree(zDevice);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();
        return z;
    }
    
    // 拷贝结果回主机并检查返回值
    if (aclrtMemcpy(z.data(), size, zDevice, size, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) {
        std::cout << "aclrtMemcpy z failed" << std::endl;
        aclrtFree(xDevice);
        aclrtFree(yDevice);
        aclrtFree(zDevice);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();
        return z;
    }
    
    // 清理资源
    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFree(zDevice);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return z;
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
    return 0;
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    auto output = kernel_mul(x, y);

    std::vector<float> golden(totalLength, valueX * valueY);
    return VerifyResult(output, golden);
}