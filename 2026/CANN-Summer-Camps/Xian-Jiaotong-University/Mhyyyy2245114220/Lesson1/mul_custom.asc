// mul_custom.asc
// 基于 Ascend C 实现逐元素矢量乘法算子
// 输入 x, y: float32, shape = (8, 2048), ND format
// 输出 z:     float32, shape = (8, 2048), ND format
// z[i] = x[i] * y[i]

#include <cstdint>
#include <cmath>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

constexpr uint32_t BUFFER_NUM = 2; // 每个 TQue 的 buffer 数 (双缓冲)

// Tiling 参数：总长度 + tile 数
struct MulCustomTilingData {
    uint32_t totalLength;
    uint32_t tileNum;
};

// 算子核心类
class KernelMul {
public:
    __aicore__ inline KernelMul() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                uint32_t totalLength, uint32_t tileNum)
    {
        this->totalLength = totalLength;
        this->tileNum     = tileNum;
        // 每个 tile 的元素个数 (向下取整)
        this->tileLength  = totalLength / tileNum;
        // 向上取整，用于分配 UB buffer 保证能容纳最大 tile
        this->tileBufSize = (totalLength + tileNum - 1) / tileNum;

        // 绑定全局内存 (GM)
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(x), totalLength);
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), totalLength);
        zGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(z), totalLength);

        // 分配 UB buffer (VECIN / VECOUT)
        pipe.InitBuffer(xQue, BUFFER_NUM, tileBufSize * sizeof(float));
        pipe.InitBuffer(yQue, BUFFER_NUM, tileBufSize * sizeof(float));
        pipe.InitBuffer(zQue, BUFFER_NUM, tileBufSize * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < tileNum; i++) {
            // 最后一个 tile 处理剩余元素 (可能不足 tileLength)
            uint32_t curLength = (i == tileNum - 1)
                ? totalLength - i * tileLength
                : tileLength;
            CopyIn(i, curLength);
            Compute(i, curLength);
            CopyOut(i, curLength);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t progress, uint32_t length)
    {
        LocalTensor<float> xLocal = xQue.AllocTensor<float>();
        LocalTensor<float> yLocal = yQue.AllocTensor<float>();

        DataCopy(xLocal, xGm[progress * tileLength], length);
        DataCopy(yLocal, yGm[progress * tileLength], length);

        xQue.EnQue(xLocal);
        yQue.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t progress, uint32_t length)
    {
        (void)progress;
        LocalTensor<float> xLocal = xQue.DeQue<float>();
        LocalTensor<float> yLocal = yQue.DeQue<float>();
        LocalTensor<float> zLocal = zQue.AllocTensor<float>();

        // 调用 Ascend C 内建矢量乘法
        Mul(zLocal, xLocal, yLocal, length);

        zQue.EnQue<float>(zLocal);
        xQue.FreeTensor(xLocal);
        yQue.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t progress, uint32_t length)
    {
        LocalTensor<float> zLocal = zQue.DeQue<float>();
        DataCopy(zGm[progress * tileLength], zLocal, length);
        zQue.FreeTensor(zLocal);
    }

private:
    TPipe pipe;
    TQue<QuePosition::VECIN,  BUFFER_NUM> xQue, yQue;
    TQue<QuePosition::VECOUT, BUFFER_NUM> zQue;
    GlobalTensor<float> xGm, yGm, zGm;
    uint32_t totalLength;
    uint32_t tileNum;
    uint32_t tileLength;
    uint32_t tileBufSize;
};

// 设备端 kernel 入口 (多核支持)
__global__ __aicore__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                      MulCustomTilingData tiling)
{
    uint32_t blockNum = GetBlockNum();
    uint32_t blockIdx = GetBlockIdx();

    // 每核处理元素数
    uint32_t perCoreLength = tiling.totalLength / blockNum;
    uint32_t offset = blockIdx * perCoreLength;

    // 末核兜底剩余元素
    if (blockIdx == blockNum - 1) {
        perCoreLength = tiling.totalLength - offset;
    }

    __gm__ float* xPtr = reinterpret_cast<__gm__ float*>(x) + offset;
    __gm__ float* yPtr = reinterpret_cast<__gm__ float*>(y) + offset;
    __gm__ float* zPtr = reinterpret_cast<__gm__ float*>(z) + offset;

    KernelMul op;
    op.Init(reinterpret_cast<GM_ADDR>(xPtr),
            reinterpret_cast<GM_ADDR>(yPtr),
            reinterpret_cast<GM_ADDR>(zPtr),
            perCoreLength, tiling.tileNum);
    op.Process();
}

// Host 端封装：ACL 完整生命周期
std::vector<float> kernel_mul(const std::vector<float> &x, const std::vector<float> &y)
{
    if (x.size() != y.size()) {
        std::cerr << "[Error] x.size() != y.size()" << std::endl;
        return {};
    }

    int32_t ret = ACL_SUCCESS;
    uint32_t totalLength = static_cast<uint32_t>(x.size());
    uint32_t tileNum  = 2;  // 每核内的 tile 数
    uint32_t blockDim = 1;  // 启用的 AI Core 数
    size_t   byteSize = totalLength * sizeof(float);

    int32_t      deviceId = 0;
    aclrtContext context  = nullptr;
    aclrtStream  stream   = nullptr;
    void *devX = nullptr, *devY = nullptr, *devZ = nullptr;
    std::vector<float> output;

    ret = aclInit(nullptr);
    if (ret != ACL_SUCCESS) { goto cleanup; }

    ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) { goto cleanup; }

    ret = aclrtCreateContext(&context, deviceId);
    if (ret != ACL_SUCCESS) { goto cleanup; }

    ret = aclrtCreateStream(&stream);
    if (ret != ACL_SUCCESS) { goto cleanup; }

    ret = aclrtMalloc(&devX, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    if (ret != ACL_SUCCESS) { goto cleanup; }

    ret = aclrtMalloc(&devY, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    if (ret != ACL_SUCCESS) { goto cleanup; }

    ret = aclrtMalloc(&devZ, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    if (ret != ACL_SUCCESS) { goto cleanup; }

    ret = aclrtMemcpy(devX, byteSize, x.data(), byteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    if (ret != ACL_SUCCESS) { goto cleanup; }

    ret = aclrtMemcpy(devY, byteSize, y.data(), byteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    if (ret != ACL_SUCCESS) { goto cleanup; }

    {
        MulCustomTilingData tiling = { totalLength, tileNum };
        mul_custom<<<blockDim, nullptr, stream>>>(
            reinterpret_cast<GM_ADDR>(devX),
            reinterpret_cast<GM_ADDR>(devY),
            reinterpret_cast<GM_ADDR>(devZ),
            tiling);
    }

    ret = aclrtSynchronizeStream(stream);
    if (ret != ACL_SUCCESS) { goto cleanup; }

    output.resize(totalLength);
    ret = aclrtMemcpy(output.data(), byteSize, devZ, byteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    if (ret != ACL_SUCCESS) { output.clear(); }

cleanup:
    if (devZ    != nullptr) { aclrtFree(devZ); }
    if (devY    != nullptr) { aclrtFree(devY); }
    if (devX    != nullptr) { aclrtFree(devX); }
    if (stream  != nullptr) { aclrtDestroyStream(stream); }
    if (context != nullptr) { aclrtDestroyContext(context); }
    aclrtResetDevice(deviceId);
    aclFinalize();
    return output;
}

// 结果校验
uint32_t VerifyResult(const std::vector<float> &output, const std::vector<float> &golden)
{
    if (output.size() != golden.size()) {
        std::cout << "[Failed] Size mismatch: output=" << output.size()
                  << " golden=" << golden.size() << std::endl;
        return 1;
    }

    auto printTensor = [](const std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(),
                  tensor.begin() + std::min(tensor.size(), maxPrintSize),
                  std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) { std::cout << "..."; }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden,  "Golden");

    constexpr float epsilon = 1e-5f;
    bool equal = std::equal(golden.begin(), golden.end(), output.begin(),
        [epsilon](float a, float b) {
            return std::fabs(a - b) < epsilon;
        });

    if (equal) {
        std::cout << "[Success] Case accuracy verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy verification failed!" << std::endl;
        return 1;
    }
}

// 主函数：shape = (8, 2048) = 16384
int32_t main(int32_t argc, char *argv[])
{
    (void)argc; (void)argv;
    constexpr uint32_t M = 8, N = 2048;
    constexpr uint32_t totalLength = M * N;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;

    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    std::vector<float> output = kernel_mul(x, y);

    std::vector<float> golden(totalLength, valueX * valueY);
    return VerifyResult(output, golden);
}
