
#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

using namespace AscendC;

constexpr uint32_t BUFFER_NUM = 2;
constexpr uint32_t TILE_NUM = 4;

struct MulCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelMul {
public:
    __aicore__ inline KernelMul(){}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {
        ASSERT(GetBlockNum() != 0 && "block dim can not be zero!");
        ASSERT(tileNum != 0 && "tile num can not be zero!");

        uint32_t blockNum = GetBlockNum();
        uint32_t blockIdx = GetBlockIdx();
        uint32_t baseLength = totalLength / blockNum;
        uint32_t remainder = totalLength % blockNum;
        
        this->blockLength = baseLength + (blockIdx < remainder ? 1U : 0U);
        this->blockOffset = blockIdx * baseLength + (blockIdx < remainder ? blockIdx : remainder);
        
        this->tileNum = tileNum;
        // 计算所有 tile 的实际长度
        this->normalTileLength = this->blockLength / this->tileNum;
        // 最后一个 tile 的长度 = normalTileLength + 余数
        this->tailLength = this->blockLength - this->normalTileLength * (this->tileNum - 1);
        // 缓冲区大小 = 所有 tile 中的最大长度（即 tailLength）
        this->maxTileLength = this->tailLength;

        xGm.SetGlobalBuffer((__gm__ float*)x + this->blockOffset, this->blockLength);
        yGm.SetGlobalBuffer((__gm__ float*)y + this->blockOffset, this->blockLength);
        zGm.SetGlobalBuffer((__gm__ float*)z + this->blockOffset, this->blockLength);

        // 缓冲区大小按 maxTileLength 分配
        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->maxTileLength * sizeof(float));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->maxTileLength * sizeof(float));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->maxTileLength * sizeof(float));
    }
    
    __aicore__ inline void Process()
    {
        for (int32_t i = 0; i < this->tileNum; i++) {
            // 计算当前 tile 的实际长度
            uint32_t currTileLen = (i == this->tileNum - 1) 
                                    ? this->tailLength 
                                    : this->normalTileLength;
            if (currTileLen == 0) continue;
            
            CopyIn(i, currTileLen);
            Compute(i, currTileLen);
            CopyOut(i, currTileLen);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress, uint32_t len)
    {
        LocalTensor<float> xLocal = inQueueX.AllocTensor<float>();
        LocalTensor<float> yLocal = inQueueY.AllocTensor<float>();
        DataCopy(xLocal, xGm[progress * this->normalTileLength], len);
        DataCopy(yLocal, yGm[progress * this->normalTileLength], len);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }
    
    __aicore__ inline void Compute(int32_t progress, uint32_t len)
    {
        LocalTensor<float> xLocal = inQueueX.DeQue<float>();
        LocalTensor<float> yLocal = inQueueY.DeQue<float>();
        LocalTensor<float> zLocal = outQueueZ.AllocTensor<float>();
        Mul(zLocal, xLocal, yLocal, len);
        outQueueZ.EnQue<float>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }
    
    __aicore__ inline void CopyOut(int32_t progress, uint32_t len)
    {
        LocalTensor<float> zLocal = outQueueZ.DeQue<float>();
        DataCopy(zGm[progress * this->normalTileLength], zLocal, len);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    TPipe pipe;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueX;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueY;
    TQue<QuePosition::VECOUT, BUFFER_NUM> outQueueZ;
    GlobalTensor<float> xGm;
    GlobalTensor<float> yGm;
    GlobalTensor<float> zGm;
    uint32_t blockLength;
    uint32_t blockOffset;
    uint32_t tileNum;
    uint32_t maxTileLength;      // 所有 tile 中最大长度 = tailLength
    uint32_t normalTileLength;   // 前 (tileNum-1) 个 tile 的固定长度
    uint32_t tailLength;         // 最后一个 tile 的实际长度（= blockLength - normalTileLength * (tileNum - 1)）
};

extern "C" __global__ __vector__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, MulCustomTilingData tiling)
{
    KernelMul op;
    op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    op.Process();
}

std::vector<float> kernel_mul(std::vector<float> &x, std::vector<float> &y)
{
    if (x.size() != y.size()) {
        std::cerr << "Input size mismatch." << std::endl;
        return {};
    }

    std::vector<float> output(x.size(), 0.0f);
    if (x.empty()) {
        return output;
    }

    const size_t byteSize = x.size() * sizeof(float);
    const int32_t deviceId = 0;
    bool deviceSet = false;
    uint8_t *xDevice = nullptr;
    uint8_t *yDevice = nullptr;
    uint8_t *zDevice = nullptr;
    aclrtStream stream = nullptr;

    auto cleanup = [&]() {
        if (xDevice != nullptr) {
            aclrtFree(xDevice);
        }
        if (yDevice != nullptr) {
            aclrtFree(yDevice);
        }
        if (zDevice != nullptr) {
            aclrtFree(zDevice);
        }
        if (stream != nullptr) {
            aclrtDestroyStream(stream);
        }
        if (deviceSet) {
            aclrtResetDevice(deviceId);
        }
        aclFinalize();
    };

    aclError ret = aclInit(nullptr);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclInit failed, ret=" << ret << std::endl;
        return {};
    }

    ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtSetDevice failed, ret=" << ret << std::endl;
        cleanup();
        return {};
    }
    deviceSet = true;

    int64_t availableCoreNum = 0;
    ret = aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtGetDeviceInfo failed, ret=" << ret << std::endl;
        cleanup();
        return {};
    }

    ret = aclrtCreateStream(&stream);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtCreateStream failed, ret=" << ret << std::endl;
        cleanup();
        return {};
    }

    ret = aclrtMalloc((void **)&xDevice, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtMalloc x failed, ret=" << ret << std::endl;
        cleanup();
        return {};
    }
    ret = aclrtMalloc((void **)&yDevice, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtMalloc y failed, ret=" << ret << std::endl;
        cleanup();
        return {};
    }
    ret = aclrtMalloc((void **)&zDevice, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtMalloc z failed, ret=" << ret << std::endl;
        cleanup();
        return {};
    }

    ret = aclrtMemcpy(xDevice, byteSize, x.data(), byteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtMemcpy x failed, ret=" << ret << std::endl;
        cleanup();
        return {};
    }
    ret = aclrtMemcpy(yDevice, byteSize, y.data(), byteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtMemcpy y failed, ret=" << ret << std::endl;
        cleanup();
        return {};
    }

    uint32_t blockNum = 1;
    if (availableCoreNum >= 8) {
        blockNum = 8;
    } else if (availableCoreNum >= 4) {
        blockNum = 4;
    } else if (availableCoreNum >= 2) {
        blockNum = 2;
    }

    MulCustomTilingData tiling {
        static_cast<uint32_t>(x.size()),
        TILE_NUM
    };

    mul_custom<<<blockNum, nullptr, stream>>>(xDevice, yDevice, zDevice, tiling);
    ret = aclrtSynchronizeStream(stream);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtSynchronizeStream failed, ret=" << ret << std::endl;
        cleanup();
        return {};
    }

    ret = aclrtMemcpy(output.data(), byteSize, zDevice, byteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtMemcpy output failed, ret=" << ret << std::endl;
        cleanup();
        return {};
    }

    cleanup();
    return output;
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (output.size() != golden.size()) {
        std::cout << "[Failed] Output size mismatch." << std::endl;
        return 1;
    }
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
    return 0;
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    std::vector<float> output = kernel_mul(x, y);
    if (output.size() != totalLength) {
        std::cout << "[Failed] kernel_mul did not produce valid output." << std::endl;
        return 1;
    }

    std::vector<float> golden(totalLength, valueX * valueY);
    return VerifyResult(output, golden);
}