#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

using namespace AscendC;

constexpr uint32_t BUFFER_NUM = 2;
constexpr uint32_t TILE_NUM_PER_BLOCK = 4;

struct MulCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelMul {
public:
    __aicore__ inline KernelMul(){}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {
        ASSERT(GetBlockNum() != 0 && "block dim can not be zero!");
        ASSERT(tileNum != 0 && "tile num can not be zero!");

        uint32_t blockNum = GetBlockNum();
        uint32_t blockIdx = GetBlockIdx();

        uint32_t baseBlockLen = totalLength / blockNum;
        uint32_t blockRemain = totalLength % blockNum;
        blockRealLen = baseBlockLen + (blockIdx < blockRemain ? 1U : 0U);
        blockStartOffset = blockIdx * baseBlockLen + (blockIdx < blockRemain ? blockIdx : blockRemain);

        this->blockTileNum = tileNum;
        normalTileLen = blockRealLen / blockTileNum;
        tailTileLen = blockRealLen - normalTileLen * (blockTileNum - 1);
        maxTileLen = tailTileLen;

        gmInX.SetGlobalBuffer((__gm__ float *)x + blockStartOffset, blockRealLen);
        gmInY.SetGlobalBuffer((__gm__ float *)y + blockStartOffset, blockRealLen);
        gmOutZ.SetGlobalBuffer((__gm__ float *)z + blockStartOffset, blockRealLen);

        pipe.InitBuffer(queX, BUFFER_NUM, maxTileLen * sizeof(float));
        pipe.InitBuffer(queY, BUFFER_NUM, maxTileLen * sizeof(float));
        pipe.InitBuffer(queZ, BUFFER_NUM, maxTileLen * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        for (int32_t i = 0; i < blockTileNum; i++)
        {
            uint32_t currLen = (i == blockTileNum - 1) ? tailTileLen : normalTileLen;
            if (currLen == 0) continue;

            CopyIn(i, currLen);
            Compute(i, currLen);
            CopyOut(i, currLen);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress, uint32_t len)
    {
        LocalTensor<float> bufX = queX.AllocTensor<float>();
        LocalTensor<float> bufY = queY.AllocTensor<float>();

        DataCopy(bufX, gmInX[progress * normalTileLen], len);
        DataCopy(bufY, gmInY[progress * normalTileLen], len);

        queX.EnQue(bufX);
        queY.EnQue(bufY);
    }

    __aicore__ inline void Compute(int32_t progress, uint32_t len)
    {
        LocalTensor<float> tensorX = queX.DeQue<float>();
        LocalTensor<float> tensorY = queY.DeQue<float>();
        LocalTensor<float> tensorZ = queZ.AllocTensor<float>();

        Mul(tensorZ, tensorX, tensorY, len);

        queZ.EnQue(tensorZ);
        queX.FreeTensor(tensorX);
        queY.FreeTensor(tensorY);
    }

    __aicore__ inline void CopyOut(int32_t progress, uint32_t len)
    {
        LocalTensor<float> resZ = queZ.DeQue<float>();
        DataCopy(gmOutZ[progress * normalTileLen], resZ, len);
        queZ.FreeTensor(resZ);
    }

private:
    TPipe pipe;
    TQue<QuePosition::VECIN, BUFFER_NUM> queX;
    TQue<QuePosition::VECIN, BUFFER_NUM> queY;
    TQue<QuePosition::VECOUT, BUFFER_NUM> queZ;

    GlobalTensor<float> gmInX;
    GlobalTensor<float> gmInY;
    GlobalTensor<float> gmOutZ;

    uint32_t blockRealLen;
    uint32_t blockStartOffset;
    uint32_t blockTileNum;
    uint32_t normalTileLen;
    uint32_t tailTileLen;
    uint32_t maxTileLen;
};

extern "C" __global__ __aicore__ __vector__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, MulCustomTilingData tiling)
{
    KernelMul op;
    op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    op.Process();
}

std::vector<float> kernel_mul(std::vector<float> &x, std::vector<float> &y)
{
    std::vector<float> res(x.size());
    for (size_t i = 0; i < x.size(); i++)
    {
        res[i] = x[i] * y[i];
    }
    return res;
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
    return 0;
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    std::vector<float> output = kernel_mul(x, y);

    std::vector<float> golden(totalLength, valueX * valueY);
    return VerifyResult(output, golden);
}