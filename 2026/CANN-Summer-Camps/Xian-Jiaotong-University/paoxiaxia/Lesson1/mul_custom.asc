// mul_custom.asc

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

constexpr uint32_t BUFFER_NUM = 2; // tensor num for each queue

struct MulCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelMul {
public:
    __aicore__ inline KernelMul(){}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {
        uint32_t blockDim = AscendC::GetBlockNum();
        this->blockLength = (totalLength + blockDim - 1) / blockDim;
        this->tileNum = tileNum;
        this->tileLength = (this->blockLength + tileNum - 1) / tileNum;

        uint32_t blockOffset = this->blockLength * AscendC::GetBlockIdx();
        uint32_t remaining = (blockOffset + this->blockLength <= totalLength)
            ? this->blockLength
            : (totalLength > blockOffset ? totalLength - blockOffset : 0);
        xGm.SetGlobalBuffer((__gm__ float*)x + blockOffset, remaining);
        yGm.SetGlobalBuffer((__gm__ float*)y + blockOffset, remaining);
        zGm.SetGlobalBuffer((__gm__ float*)z + blockOffset, remaining);

        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(float));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(float));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(float));
    }
    __aicore__ inline void Process()
    {
        for (int32_t i = 0; i < this->tileNum; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline uint32_t GetTileLength(int32_t progress)
    {
        uint32_t offset = this->tileLength * progress;
        uint32_t remaining = this->blockLength - offset;
        return (remaining < this->tileLength) ? remaining : this->tileLength;
    }
    __aicore__ inline void CopyIn(int32_t progress)
    {
        AscendC::LocalTensor<float> xLocal = inQueueX.AllocTensor<float>();
        AscendC::LocalTensor<float> yLocal = inQueueY.AllocTensor<float>();
        uint32_t len = GetTileLength(progress);
        
        AscendC::DataCopy(xLocal, xGm[progress * this->tileLength], len);
        AscendC::DataCopy(yLocal, yGm[progress * this->tileLength], len);
        
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }
    __aicore__ inline void Compute(int32_t progress)
    {
        AscendC::LocalTensor<float> xLocal = inQueueX.DeQue<float>();
        AscendC::LocalTensor<float> yLocal = inQueueY.DeQue<float>();
        AscendC::LocalTensor<float> zLocal = outQueueZ.AllocTensor<float>();
        uint32_t len = GetTileLength(progress);
        
        AscendC::Mul(zLocal, xLocal, yLocal, len);
        
        outQueueZ.EnQue<float>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }
    __aicore__ inline void CopyOut(int32_t progress)
    {
        AscendC::LocalTensor<float> zLocal = outQueueZ.DeQue<float>();
        uint32_t len = GetTileLength(progress);
        AscendC::DataCopy(zGm[progress * this->tileLength], zLocal, len);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, BUFFER_NUM> inQueueX, inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, BUFFER_NUM> outQueueZ;
    AscendC::GlobalTensor<float> xGm;
    AscendC::GlobalTensor<float> yGm;
    AscendC::GlobalTensor<float> zGm;
    uint32_t blockLength;
    uint32_t tileNum;
    uint32_t tileLength;
};

__global__ __aicore__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, MulCustomTilingData tiling)
{
    KernelMul op;
    op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    op.Process();
}

std::vector<float> kernel_mul(std::vector<float> &x, std::vector<float> &y)
{
    size_t totalLength = x.size();
    if (totalLength != y.size()) {
        std::cerr << "[Error] Input size mismatch: x=" << totalLength << ", y=" << y.size() << std::endl;
        return {};
    }
    if (totalLength > UINT32_MAX) {
        std::cerr << "[Error] totalLength " << totalLength << " exceeds uint32_t max" << std::endl;
        return {};
    }
    std::vector<float> z(totalLength, 0.0f);
    size_t byteSize = totalLength * sizeof(float);
    
    aclrtStream stream = nullptr;
    float *xDevice = nullptr;
    float *yDevice = nullptr;
    float *zDevice = nullptr;
    int32_t deviceId = 0;
    bool deviceInitialized = false;
    bool streamCreated = false;

    auto cleanup = [&]() {
        if (xDevice) { aclrtFree(xDevice); xDevice = nullptr; }
        if (yDevice) { aclrtFree(yDevice); yDevice = nullptr; }
        if (zDevice) { aclrtFree(zDevice); zDevice = nullptr; }
        if (streamCreated) { aclrtDestroyStream(stream); streamCreated = false; }
        if (deviceInitialized) { aclrtResetDevice(deviceId); deviceInitialized = false; }
        aclFinalize();
    };

    int32_t ret = aclInit(nullptr);
    if (ret != ACL_SUCCESS) {
        std::cerr << "[Error] aclInit failed: " << ret << std::endl;
        return {};
    }

    ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) {
        std::cerr << "[Error] aclrtSetDevice failed: " << ret << std::endl;
        aclFinalize();
        return {};
    }
    deviceInitialized = true;

    ret = aclrtCreateStream(&stream);
    if (ret != ACL_SUCCESS) {
        std::cerr << "[Error] aclrtCreateStream failed: " << ret << std::endl;
        cleanup();
        return {};
    }
    streamCreated = true;

    ret = aclrtMalloc((void **)&xDevice, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    if (ret != ACL_SUCCESS || xDevice == nullptr) {
        std::cerr << "[Error] aclrtMalloc for xDevice failed: " << ret << std::endl;
        cleanup();
        return {};
    }
    ret = aclrtMalloc((void **)&yDevice, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    if (ret != ACL_SUCCESS || yDevice == nullptr) {
        std::cerr << "[Error] aclrtMalloc for yDevice failed: " << ret << std::endl;
        cleanup();
        return {};
    }
    ret = aclrtMalloc((void **)&zDevice, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    if (ret != ACL_SUCCESS || zDevice == nullptr) {
        std::cerr << "[Error] aclrtMalloc for zDevice failed: " << ret << std::endl;
        cleanup();
        return {};
    }

    ret = aclrtMemcpy(xDevice, byteSize, x.data(), byteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    if (ret != ACL_SUCCESS) {
        std::cerr << "[Error] aclrtMemcpy host->device for x failed: " << ret << std::endl;
        cleanup();
        return {};
    }
    ret = aclrtMemcpy(yDevice, byteSize, y.data(), byteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    if (ret != ACL_SUCCESS) {
        std::cerr << "[Error] aclrtMemcpy host->device for y failed: " << ret << std::endl;
        cleanup();
        return {};
    }

    uint32_t blockDim = 8;
    MulCustomTilingData tiling;
    tiling.totalLength = static_cast<uint32_t>(totalLength);
    tiling.tileNum = 8; 
    
    mul_custom<<<blockDim, nullptr, stream>>>((uint8_t*)xDevice, (uint8_t*)yDevice, (uint8_t*)zDevice, tiling);
    
    ret = aclrtSynchronizeStream(stream);
    if (ret != ACL_SUCCESS) {
        std::cerr << "[Error] aclrtSynchronizeStream failed: " << ret << std::endl;
        cleanup();
        return {};
    }

    ret = aclrtMemcpy(z.data(), byteSize, zDevice, byteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    if (ret != ACL_SUCCESS) {
        std::cerr << "[Error] aclrtMemcpy device->host for z failed: " << ret << std::endl;
        cleanup();
        return {};
    }
    
    cleanup();
    return z;
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
    return 0;
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    std::vector<float> output = kernel_mul(x, y);

    std::vector<float> golden(totalLength, valueX * valueY);
    return VerifyResult(output, golden);
}