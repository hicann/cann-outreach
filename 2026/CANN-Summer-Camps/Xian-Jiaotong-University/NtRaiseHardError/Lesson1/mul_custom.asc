// mul_custom.asc
#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

using namespace AscendC;

constexpr uint32_t BUFFER_NUM = 2;

struct MulCustomTilingData {
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelMul {
public:
    __aicore__ inline KernelMul() {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(x), totalLength);
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), totalLength);
        zGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(z), totalLength);

        blockIdx = GetBlockIdx();
        // 基础每个 core 处理的元素数（向下取整）
        uint32_t baseCoreLength = totalLength / tileNum;
        uint32_t coreOffset = blockIdx * baseCoreLength;
        if (blockIdx == tileNum - 1) {
            coreLength = totalLength - coreOffset;   // 最后一个 core 处理余数
        } else {
            coreLength = baseCoreLength;
        }

        this->coreOffset = coreOffset;
        this->coreLength = coreLength;

        // 每个 slice 固定长度 256，最后一个 slice 可能不足
        tileLength = 256;
        loopNum = (coreLength + tileLength - 1) / tileLength;

        // 初始化双缓冲队列
        pipe.InitBuffer(inQueueX, BUFFER_NUM, tileLength * sizeof(float));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, tileLength * sizeof(float));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, tileLength * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        for (int32_t i = 0; i < loopNum; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        uint32_t offset = coreOffset + progress * tileLength;
        uint32_t len = (progress == loopNum - 1) ? (coreLength - progress * tileLength) : tileLength;

        LocalTensor<float> xLocal = inQueueX.AllocTensor<float>();
        LocalTensor<float> yLocal = inQueueY.AllocTensor<float>();

        DataCopy(xLocal, xGm[offset], len);
        DataCopy(yLocal, yGm[offset], len);

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(int32_t progress)
    {
        LocalTensor<float> xLocal = inQueueX.DeQue<float>();
        LocalTensor<float> yLocal = inQueueY.DeQue<float>();

        LocalTensor<float> zLocal = outQueueZ.AllocTensor<float>();

        uint32_t len = (progress == loopNum - 1) ? (coreLength - progress * tileLength) : tileLength;
        Mul(zLocal, xLocal, yLocal, len);

        outQueueZ.EnQue<float>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int32_t progress)
    {
        uint32_t offset = coreOffset + progress * tileLength;
        uint32_t len = (progress == loopNum - 1) ? (coreLength - progress * tileLength) : tileLength;

        LocalTensor<float> zLocal = outQueueZ.DeQue<float>();

        DataCopy(zGm[offset], zLocal, len);

        outQueueZ.FreeTensor(zLocal);
    }

private:
    GlobalTensor<float> xGm, yGm, zGm;
    TPipe pipe;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueX, inQueueY;
    TQue<TPosition::VECOUT, BUFFER_NUM> outQueueZ;

    uint32_t blockIdx;
    uint32_t coreOffset;
    uint32_t coreLength;
    uint32_t tileLength;
    uint32_t loopNum;
};

extern "C" __global__ __aicore__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, MulCustomTilingData tiling)
{
    KernelMul op;
    op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    op.Process();
}

// 辅助函数：释放所有已分配的资源
static void cleanup_resources(aclrtStream &stream,
                              void *&devX, void *&devY, void *&devZ,
                              aclError &finalRet)
{
    if (devZ) { aclrtFree(devZ); devZ = nullptr; }
    if (devY) { aclrtFree(devY); devY = nullptr; }
    if (devX) { aclrtFree(devX); devX = nullptr; }
    if (stream) {
        aclrtDestroyStream(stream);
        stream = nullptr;
    }
}

std::vector<float> kernel_mul(std::vector<float> &x, std::vector<float> &y)
{
    size_t size = x.size() * sizeof(float);
    std::vector<float> z;                // 默认空，失败时返回

    aclrtStream stream = nullptr;
    aclError ret = aclrtCreateStream(&stream);
    if (ret != ACL_SUCCESS) {
        return z;   // 流创建失败
    }

    void *devX = nullptr, *devY = nullptr, *devZ = nullptr;
    // 依次分配，任何一步失败则跳转清理
    ret = aclrtMalloc(&devX, size, ACL_MEM_MALLOC_NORMAL_ONLY);
    if (ret != ACL_SUCCESS) goto cleanup_stream;

    ret = aclrtMalloc(&devY, size, ACL_MEM_MALLOC_NORMAL_ONLY);
    if (ret != ACL_SUCCESS) goto cleanup_devX;

    ret = aclrtMalloc(&devZ, size, ACL_MEM_MALLOC_NORMAL_ONLY);
    if (ret != ACL_SUCCESS) goto cleanup_devY;

    // 拷贝主机数据到设备
    ret = aclrtMemcpy(devX, size, x.data(), size, ACL_MEMCPY_HOST_TO_DEVICE);
    if (ret != ACL_SUCCESS) goto cleanup_all;
    ret = aclrtMemcpy(devY, size, y.data(), size, ACL_MEMCPY_HOST_TO_DEVICE);
    if (ret != ACL_SUCCESS) goto cleanup_all;

    // 配置 Tiling 参数
    MulCustomTilingData tiling;
    tiling.totalLength = x.size();
    tiling.tileNum = 8;

    // 启动内核
    mul_custom<<<tiling.tileNum, nullptr, stream>>>((GM_ADDR)devX, (GM_ADDR)devY, (GM_ADDR)devZ, tiling);

    ret = aclrtSynchronizeStream(stream);
    if (ret != ACL_SUCCESS) goto cleanup_all;

    // 分配输出缓冲区并拷贝回主机
    z.resize(x.size());
    ret = aclrtMemcpy(z.data(), size, devZ, size, ACL_MEMCPY_DEVICE_TO_HOST);
    if (ret != ACL_SUCCESS) {
        z.clear();
    }

cleanup_all:
    aclrtFree(devZ);
cleanup_devY:
    aclrtFree(devY);
cleanup_devX:
    aclrtFree(devX);
cleanup_stream:
    aclrtDestroyStream(stream);
    stream = nullptr;

    return z;
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) std::cout << "...";
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
    return 0;
}

int32_t main(int32_t argc, char *argv[])
{
    // ACL 初始化
    aclError ret = aclInit(nullptr);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclInit failed" << std::endl;
        return 1;
    }
    ret = aclrtSetDevice(0);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtSetDevice failed" << std::endl;
        aclFinalize();
        return 1;
    }

    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    std::vector<float> output = kernel_mul(x, y);
    if (output.empty()) {
        std::cerr << "Kernel execution failed, output is empty." << std::endl;
        aclFinalize();
        return 1;
    }

    std::vector<float> golden(totalLength, valueX * valueY);
    uint32_t res = VerifyResult(output, golden);

    aclFinalize();
    return res;
}