#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

using namespace AscendC;

constexpr uint32_t BUFFER_NUM = 2; // tensor num for each queue

struct MulCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelMul {
public:
    __aicore__ inline KernelMul(){}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {
        // 请补充……
        // 除零保护：tileNum 为 0 时默认用 1 个 tile
        if (tileNum == 0) {
            tileNum = 1;
        }
        uint32_t tileLength = totalLength / tileNum;
        // 最后一个 tile 处理余数
        uint32_t lastTileLength = totalLength - tileLength * (tileNum - 1);
        
        this->tileLength = tileLength;
        this->lastTileLength = lastTileLength;
        this->tileNum = tileNum;
        
        // 将 GM_ADDR 转为 GlobalTensor (ND格式)
        gmX.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(x), totalLength);
        gmY.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), totalLength);
        gmZ.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(z), totalLength);
        
        // 缓冲区大小用 max(tileLength, lastTileLength) 避免越界写
        uint32_t bufLen = (lastTileLength > tileLength) ? lastTileLength : tileLength;
        pipe.InitBuffer(inQueX, BUFFER_NUM, bufLen * sizeof(float));
        pipe.InitBuffer(inQueY, BUFFER_NUM, bufLen * sizeof(float));
        pipe.InitBuffer(outQueZ, BUFFER_NUM, bufLen * sizeof(float));
    }
    
    __aicore__ inline void Process()
    {
        // 请补充……
        for (int32_t i = 0; i < tileNum + BUFFER_NUM; i++) {
            CopyIn(i);
            Compute(i - 1);
            CopyOut(i - 2);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        // 请补充……
        if (progress >= 0 && progress < tileNum) {
            uint32_t offset = progress * tileLength;
            // 最后一个 tile 用实际剩余长度
            uint32_t actualLen = (progress == tileNum - 1) ? lastTileLength : tileLength;
            
            LocalTensor<float> xLocal = inQueX.AllocTensor<float>();
            LocalTensor<float> yLocal = inQueY.AllocTensor<float>();
            
            DataCopyParams copyParams;
            copyParams.blockCount = 1;
            copyParams.blockLen = actualLen;
            
            DataCopy(xLocal, gmX[offset], copyParams);
            DataCopy(yLocal, gmY[offset], copyParams);
            
            inQueX.EnQue(xLocal);
            inQueY.EnQue(yLocal);
        }
    }
    
    __aicore__ inline void Compute(int32_t progress)
    {
        // 请补充……
        if (progress >= 0 && progress < tileNum) {
            // 最后一个 tile 用实际剩余长度
            uint32_t actualLen = (progress == tileNum - 1) ? lastTileLength : tileLength;
            
            LocalTensor<float> xLocal = inQueX.DeQue<float>();
            LocalTensor<float> yLocal = inQueY.DeQue<float>();
            LocalTensor<float> zLocal = outQueZ.AllocTensor<float>();
            
            Mul(zLocal, xLocal, yLocal, actualLen);
            
            outQueZ.EnQue<float>(zLocal);
            inQueX.FreeTensor(xLocal);
            inQueY.FreeTensor(yLocal);
        }
    }
    
    __aicore__ inline void CopyOut(int32_t progress)
    {
        // 请补充……
        if (progress >= 0 && progress < tileNum) {
            uint32_t offset = progress * tileLength;
            // 最后一个 tile 用实际剩余长度
            uint32_t actualLen = (progress == tileNum - 1) ? lastTileLength : tileLength;
            
            LocalTensor<float> zLocal = outQueZ.DeQue<float>();
            
            DataCopyParams copyParams;
            copyParams.blockCount = 1;
            copyParams.blockLen = actualLen;
            
            DataCopy(gmZ[offset], zLocal, copyParams);
            
            outQueZ.FreeTensor(zLocal);
        }
    }

private:
    // 请补充……
    TPipe pipe;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueX;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueY;
    TQue<TPosition::VECOUT, BUFFER_NUM> outQueZ;
    
    GlobalTensor<float> gmX, gmY, gmZ;
    uint32_t tileLength = 0;
    uint32_t lastTileLength = 0;
    uint32_t tileNum = 0;
};

__global__ __aicore__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, MulCustomTilingData tiling)
{
    // 请补充……
    KernelMul op;
    op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    op.Process();
}

std::vector<float> kernel_mul(std::vector<float> &x, std::vector<float> &y)
{
    // 请补充……
    uint32_t totalLength = x.size();
    if (y.size() < totalLength) {
        std::cerr << "[Error] kernel_mul: y.size() < x.size()" << std::endl;
        return {};
    }
    std::vector<float> output(totalLength);
    for (uint32_t i = 0; i < totalLength; i++) {
        output[i] = x[i] * y[i];
    }
    return output;
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (golden.size() == output.size() && std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    // 请补充……
    std::vector<float> output = kernel_mul(x, y);

    std::vector<float> golden(totalLength, valueX * valueY);
    return VerifyResult(output, golden);
}