// mul_custom.asc
#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cmath>
#include "acl/acl.h"
#include "kernel_operator.h"

using namespace AscendC;

constexpr uint32_t BUFFER_NUM = 1;      // 单缓冲，简单可靠
constexpr uint32_t BLOCK_NUM  = 8;      // 至少 8 核
constexpr uint32_t TILE_NUM   = 8;      // 每核拆分的 tile 数
constexpr uint32_t FLOAT_PER_32B = 32 / sizeof(float);   // 8

struct MulCustomTilingData {
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelMul {
public:
    __aicore__ inline KernelMul() {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                uint32_t totalLength, uint32_t tileNum) {
        // ---------- 多核分工 ----------
        uint32_t blockIdx = GetBlockIdx();
        uint32_t blockNum = GetBlockNum();
        uint32_t baseLen  = totalLength / blockNum;
        uint32_t tailNum  = totalLength % blockNum;
        blockLength = baseLen + (blockIdx < tailNum ? 1 : 0);
        blockOffset = blockIdx * baseLen + (blockIdx < tailNum ? blockIdx : tailNum);

        // ---------- 计算每个 tile 的长度 ----------
        this->tileNum   = tileNum;
        loopCount       = tileNum * BUFFER_NUM;   // 实际循环次数 = tile 数
        tileLength      = (blockLength + loopCount - 1) / loopCount;  // 向上取整
        tileLengthAligned = ((tileLength + FLOAT_PER_32B - 1) / FLOAT_PER_32B) * FLOAT_PER_32B; // 对齐到 8

        // ---------- 绑定全局内存 ----------
        xGm.SetGlobalBuffer((__gm__ float*)x + blockOffset, blockLength);
        yGm.SetGlobalBuffer((__gm__ float*)y + blockOffset, blockLength);
        zGm.SetGlobalBuffer((__gm__ float*)z + blockOffset, blockLength);

        // ---------- 初始化队列（单缓冲） ----------
        pipe.InitBuffer(inQueueX, BUFFER_NUM, tileLengthAligned * sizeof(float));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, tileLengthAligned * sizeof(float));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, tileLengthAligned * sizeof(float));
    }

    __aicore__ inline void Process() {
        for (uint32_t i = 0; i < loopCount; ++i) {
            uint32_t offset = i * tileLength;
            if (offset >= blockLength) break;
            uint32_t length = (offset + tileLength <= blockLength) ? tileLength
                                                                   : (blockLength - offset);
            CopyIn(i, length);
            Compute(i, length);
            CopyOut(i, length);
        }
    }

private:
    // ----- 搬入：申请 buffer → 对齐拷入 → 放回队列供 Compute 消费 -----
    __aicore__ inline void CopyIn(uint32_t progress, uint32_t length) {
        LocalTensor<float> xLocal = inQueueX.AllocTensor<float>();
        LocalTensor<float> yLocal = inQueueY.AllocTensor<float>();
        uint32_t alignedLen = ((length + FLOAT_PER_32B - 1) / FLOAT_PER_32B) * FLOAT_PER_32B;
        DataCopyExtParams copyParam{1, (uint32_t)(length * sizeof(float)), 0, 0, 0};
        DataCopyPadExtParams<float> padParam{true, 0, (uint8_t)(alignedLen - length), 0.0f};
        DataCopyPad(xLocal, xGm[progress * tileLength], copyParam, padParam);
        DataCopyPad(yLocal, yGm[progress * tileLength], copyParam, padParam);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    // ----- 计算：取出数据 → 乘法 → 输出 EnQue → 释放输入 -----
    __aicore__ inline void Compute(uint32_t progress, uint32_t length) {
        LocalTensor<float> xLocal = inQueueX.DeQue<float>();
        LocalTensor<float> yLocal = inQueueY.DeQue<float>();
        LocalTensor<float> zLocal = outQueueZ.AllocTensor<float>();
        Mul(zLocal, xLocal, yLocal, length);   // 只计算有效长度
        outQueueZ.EnQue<float>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    // ----- 搬出：取出结果 → 拷回 GM → 释放 -----
    __aicore__ inline void CopyOut(uint32_t progress, uint32_t length) {
        LocalTensor<float> zLocal = outQueueZ.DeQue<float>();
        DataCopyExtParams copyParam{1, (uint32_t)(length * sizeof(float)), 0, 0, 0};
        DataCopyPad(zGm[progress * tileLength], zLocal, copyParam);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    TPipe pipe;
    TQue<QuePosition::VECIN, BUFFER_NUM>  inQueueX, inQueueY;
    TQue<QuePosition::VECOUT, BUFFER_NUM> outQueueZ;
    GlobalTensor<float> xGm, yGm, zGm;
    uint32_t blockLength, blockOffset;
    uint32_t tileNum, loopCount, tileLength, tileLengthAligned;
};

// ============= 算子核函数入口 =============
__global__ __aicore__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, MulCustomTilingData tiling) {
    KernelMul op;
    op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    op.Process();
}

// ============= Host 端代码（保留你原有的风格） =============
std::vector<float> kernel_mul(std::vector<float>& x, std::vector<float>& y) {
    uint32_t totalLength = x.size();
    size_t totalByteSize = totalLength * sizeof(float);
    MulCustomTilingData tiling{totalLength, TILE_NUM};

    int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    aclInit(nullptr);
    aclrtSetDevice(deviceId);
    aclrtCreateStream(&stream);

    // Host 端内存（使用 aclrtMallocHost 保证对齐）
    uint8_t* xHost = reinterpret_cast<uint8_t*>(x.data());
    uint8_t* yHost = reinterpret_cast<uint8_t*>(y.data());
    uint8_t* zHost;
    aclrtMallocHost((void**)&zHost, totalByteSize);

    // Device 内存
    uint8_t *xDev, *yDev, *zDev;
    aclrtMalloc((void**)&xDev, totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDev, totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&zDev, totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(xDev, totalByteSize, xHost, totalByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(yDev, totalByteSize, yHost, totalByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    // 启动算子（8 核）
    mul_custom<<<BLOCK_NUM, nullptr, stream>>>(xDev, yDev, zDev, tiling);
    aclrtSynchronizeStream(stream);

    // 拷回结果
    aclrtMemcpy(zHost, totalByteSize, zDev, totalByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> z(reinterpret_cast<float*>(zHost),
                         reinterpret_cast<float*>(zHost) + totalLength);

    // 释放资源
    aclrtFree(xDev); aclrtFree(yDev); aclrtFree(zDev);
    aclrtFreeHost(zHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return z;
}

// ============= 验证函数（保留你原有的浮点误差容忍） =============
uint32_t VerifyResult(std::vector<float>& output, std::vector<float>& golden) {
    if (output.size() != golden.size()) {
        std::cout << "[Failed] size mismatch" << std::endl;
        return 1;
    }
    float atol = 1e-5f, rtol = 1e-5f;
    for (size_t i = 0; i < golden.size(); ++i) {
        float diff = fabs(output[i] - golden[i]);
        float tol  = atol + rtol * fabs(golden[i]);
        if (diff > tol) {
            std::cout << "[Failed] at " << i << " output=" << output[i]
                      << " golden=" << golden[i] << std::endl;
            return 1;
        }
    }
    std::cout << "[Success] verification passed." << std::endl;
    return 0;
}

// ============= 主函数（与你原来逻辑一致，加了多组测试） =============
int32_t main(int32_t argc, char* argv[]) {
    std::vector<uint32_t> lengths = {1, 7, 8, 13, 257, 8*2048, 8*2048+3};
    for (auto len : lengths) {
        std::cout << "Testing length=" << len << std::endl;
        std::vector<float> x(len), y(len), golden(len);
        for (uint32_t i = 0; i < len; ++i) {
            x[i] = (i % 17 - 8) * 0.25f + 1.2f;
            y[i] = (i % 13 - 6) * -0.125f + 2.3f;
            golden[i] = x[i] * y[i];
        }
        auto output = kernel_mul(x, y);
        if (VerifyResult(output, golden) != 0) return 1;
    }
    return 0;
}