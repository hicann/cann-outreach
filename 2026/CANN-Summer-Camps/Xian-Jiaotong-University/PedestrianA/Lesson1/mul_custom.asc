// mul_custom.asc
#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

constexpr uint32_t BUFFER_NUM = 2; // tensor num for each queue

struct MulCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelMul {
public:
    __aicore__ inline KernelMul(){}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {
        // 保存全局内存地址与分块信息
        x_gm_ = x;
        y_gm_ = y;
        z_gm_ = z;
        total_len_ = totalLength;
        tile_num_ = tileNum;

        // 【修复1】除零保护：在除法执行前检查tileNum，避免未定义行为
        if (tileNum == 0) {
            tile_len_ = 0;
            return;
        }
        tile_len_ = totalLength / tileNum;
    }

    __aicore__ inline void Process()
    {
        if (tile_num_ == 0) return;

        // 预取第0块数据
        CopyIn(0);

        // 【修复2】调整流水线顺序：计算→回写→预取，实现真正双缓冲并行
        // 避免Compute被下一块的拷贝任务阻塞，计算与访存重叠执行
        for (uint32_t i = 1; i < tile_num_; ++i) {
            uint32_t cur_idx = i - 1;
            Compute(cur_idx); // 计算当前tile，仅等待当前tile的输入拷贝完成
            CopyOut(cur_idx); // 异步写出当前tile结果
            CopyIn(i);        // 异步预取下一个tile，与下一轮计算并行
        }

        // 处理最后一个tile
        uint32_t last_idx = tile_num_ - 1;
        Compute(last_idx);
        CopyOut(last_idx);

        // 等待所有输出拷贝完成
        aic::wait(aic::CopyQueue);
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        uint32_t buf_idx = progress % BUFFER_NUM;
        uint32_t elem_offset = progress * tile_len_;

        // 异步拷贝：从全局内存GM搬入片上缓存UB
        aic::memcpy_async(
            x_ub_[buf_idx],
            reinterpret_cast<const float*>(x_gm_) + elem_offset,
            tile_len_ * sizeof(float),
            aic::MemcpyKind::GM_TO_UB
        );
        aic::memcpy_async(
            y_ub_[buf_idx],
            reinterpret_cast<const float*>(y_gm_) + elem_offset,
            tile_len_ * sizeof(float),
            aic::MemcpyKind::GM_TO_UB
        );
    }

    __aicore__ inline void Compute(int32_t progress)
    {
        uint32_t buf_idx = progress % BUFFER_NUM;
        // 等待当前块输入数据拷贝完成
        aic::wait(aic::CopyQueue);

        // 逐元素相乘计算
        for (uint32_t i = 0; i < tile_len_; ++i) {
            z_ub_[buf_idx][i] = x_ub_[buf_idx][i] * y_ub_[buf_idx][i];
        }
    }

    __aicore__ inline void CopyOut(int32_t progress)
    {
        uint32_t buf_idx = progress % BUFFER_NUM;
        uint32_t elem_offset = progress * tile_len_;

        // 异步拷贝：结果从片上UB搬回全局内存GM
        aic::memcpy_async(
            reinterpret_cast<float*>(z_gm_) + elem_offset,
            z_ub_[buf_idx],
            tile_len_ * sizeof(float),
            aic::MemcpyKind::UB_TO_GM
        );
    }

private:
    // 全局内存地址（输入输出指针）
    GM_ADDR x_gm_;
    GM_ADDR y_gm_;
    GM_ADDR z_gm_;
    // 分块信息
    uint32_t total_len_;
    uint32_t tile_num_;
    uint32_t tile_len_;
    // 单块最大元素数（与tiling匹配）
    static constexpr uint32_t TILE_SIZE = 2048;
    // 片上UB双缓冲
    __ubuf__ float x_ub_[BUFFER_NUM][TILE_SIZE];
    __ubuf__ float y_ub_[BUFFER_NUM][TILE_SIZE];
    __ubuf__ float z_ub_[BUFFER_NUM][TILE_SIZE];
};

__global__ __aicore__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, MulCustomTilingData tiling)
{
    KernelMul op;
    op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    op.Process();
}

std::vector<float> kernel_mul(std::vector<float> &x, std::vector<float> &y)
{
    // 主机侧初始化ACL与设备（仅首次执行）
    static bool is_init = false;
    if (!is_init) {
        aclError ret = aclInit(nullptr);
        if (ret != ACL_SUCCESS) {
            std::cerr << "[ERROR] aclInit failed, error code: " << ret << std::endl;
            return {};
        }
        ret = aclrtSetDevice(0);
        if (ret != ACL_SUCCESS) {
            std::cerr << "[ERROR] aclrtSetDevice failed, error code: " << ret << std::endl;
            return {};
        }
        is_init = true;
    }

    size_t data_bytes = x.size() * sizeof(float);
    void *dev_x = nullptr;
    void *dev_y = nullptr;
    void *dev_z = nullptr;
    std::vector<float> output(x.size());
    aclError ret;

    // 1. 在NPU设备上分配内存
    ret = aclrtMalloc(&dev_x, data_bytes, ACL_MEM_MALLOC_NORMAL_ONLY);
    if (ret != ACL_SUCCESS) {
        std::cerr << "[ERROR] aclrtMalloc dev_x failed, error code: " << ret << std::endl;
        goto cleanup;
    }
    ret = aclrtMalloc(&dev_y, data_bytes, ACL_MEM_MALLOC_NORMAL_ONLY);
    if (ret != ACL_SUCCESS) {
        std::cerr << "[ERROR] aclrtMalloc dev_y failed, error code: " << ret << std::endl;
        goto cleanup;
    }
    ret = aclrtMalloc(&dev_z, data_bytes, ACL_MEM_MALLOC_NORMAL_ONLY);
    if (ret != ACL_SUCCESS) {
        std::cerr << "[ERROR] aclrtMalloc dev_z failed, error code: " << ret << std::endl;
        goto cleanup;
    }

    // 2. 输入数据从主机内存拷贝到设备内存
    ret = aclrtMemcpy(dev_x, data_bytes, x.data(), data_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    if (ret != ACL_SUCCESS) {
        std::cerr << "[ERROR] aclrtMemcpy H2D x failed, error code: " << ret << std::endl;
        goto cleanup;
    }
    ret = aclrtMemcpy(dev_y, data_bytes, y.data(), data_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    if (ret != ACL_SUCCESS) {
        std::cerr << "[ERROR] aclrtMemcpy H2D y failed, error code: " << ret << std::endl;
        goto cleanup;
    }

    // 3. 构造分块tiling参数
    MulCustomTilingData tiling;
    tiling.totalLength = x.size();
    tiling.tileNum = 8;

    // 4. 准备核函数参数与参数大小表
    void* args[] = { &dev_x, &dev_y, &dev_z, &tiling };
    size_t args_size[] = { sizeof(dev_x), sizeof(dev_y), sizeof(dev_z), sizeof(tiling) };

    // 5. 启动AI Core核函数，同步等待执行完成
    ret = aclrtLaunchKernel("mul_custom", 1, 1, args, args_size, nullptr);
    if (ret != ACL_SUCCESS) {
        std::cerr << "[ERROR] aclrtLaunchKernel failed, error code: " << ret << std::endl;
        goto cleanup;
    }
    ret = aclrtSynchronizeStream(nullptr);
    if (ret != ACL_SUCCESS) {
        std::cerr << "[ERROR] aclrtSynchronizeStream failed, error code: " << ret << std::endl;
        goto cleanup;
    }

    // 6. 计算结果从设备拷回主机
    ret = aclrtMemcpy(output.data(), data_bytes, dev_z, data_bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    if (ret != ACL_SUCCESS) {
        std::cerr << "[ERROR] aclrtMemcpy D2H failed, error code: " << ret << std::endl;
        output.clear();
        goto cleanup;
    }

cleanup:
    // 【修复3】统一资源释放：任意步骤失败都安全释放已分配内存，避免泄漏
    if (dev_x != nullptr) aclrtFree(dev_x);
    if (dev_y != nullptr) aclrtFree(dev_y);
    if (dev_z != nullptr) aclrtFree(dev_z);

    return output;
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
    // 【修复4】删除冗余死代码：分支已全部return，末尾return 0为不可达代码
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    std::vector<float> output = kernel_mul(x, y);

    std::vector<float> golden(totalLength, valueX * valueY);
    return VerifyResult(output, golden);
}
