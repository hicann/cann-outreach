// mul_custom.asc

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

using namespace AscendC;

constexpr uint32_t BUFFER_NUM = 2; // tensor num for each queue
constexpr uint32_t TILE_BLOCKS = 4; // 改名：原 TILE_NUM

struct MulCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelMul {
public:
    __aicore__ inline KernelMul(){}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {
        ASSERT(GetBlockNum() != 0 && "block dim can not be zero!");
        ASSERT(tileNum != 0 && "tile num can not be zero!");

        blkLen_       = totalLength / GetBlockNum();
        numTiles_     = tileNum;
        tileDataLen_  = blkLen_ / numTiles_ / BUFFER_NUM;

        gmX_.SetGlobalBuffer((__gm__ float*)x + blkLen_ * GetBlockIdx(), blkLen_);
        gmY_.SetGlobalBuffer((__gm__ float*)y + blkLen_ * GetBlockIdx(), blkLen_);
        gmZ_.SetGlobalBuffer((__gm__ float*)z + blkLen_ * GetBlockIdx(), blkLen_);

        pipeline_.InitBuffer(qInX_, BUFFER_NUM, tileDataLen_ * sizeof(float));
        pipeline_.InitBuffer(qInY_, BUFFER_NUM, tileDataLen_ * sizeof(float));
        pipeline_.InitBuffer(qOutZ_, BUFFER_NUM, tileDataLen_ * sizeof(float));
    }
    __aicore__ inline void Process()
    {
        int32_t steps = numTiles_ * BUFFER_NUM;
        for (int32_t i = 0; i < steps; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        LocalTensor<float> xTile = qInX_.AllocTensor<float>();
        LocalTensor<float> yTile = qInY_.AllocTensor<float>();
        DataCopy(xTile, gmX_[progress * tileDataLen_], tileDataLen_);
        DataCopy(yTile, gmY_[progress * tileDataLen_], tileDataLen_);
        qInX_.EnQue(xTile);
        qInY_.EnQue(yTile);
    }
    __aicore__ inline void Compute(int32_t progress)
    {
        LocalTensor<float> xTile = qInX_.DeQue<float>();
        LocalTensor<float> yTile = qInY_.DeQue<float>();
        LocalTensor<float> zTile = qOutZ_.AllocTensor<float>();
        Mul(zTile, xTile, yTile, tileDataLen_);
        qOutZ_.EnQue<float>(zTile);
        qInX_.FreeTensor(xTile);
        qInY_.FreeTensor(yTile);
    }
    __aicore__ inline void CopyOut(int32_t progress)
    {
        LocalTensor<float> zTile = qOutZ_.DeQue<float>();
        DataCopy(gmZ_[progress * tileDataLen_], zTile, tileDataLen_);
        qOutZ_.FreeTensor(zTile);
    }

private:
    TPipe pipeline_;
    TQue<QuePosition::VECIN, BUFFER_NUM>  qInX_;
    TQue<QuePosition::VECIN, BUFFER_NUM>  qInY_;
    TQue<QuePosition::VECOUT, BUFFER_NUM> qOutZ_;
    GlobalTensor<float> gmX_;
    GlobalTensor<float> gmY_;
    GlobalTensor<float> gmZ_;
    uint32_t blkLen_      = 0;
    uint32_t numTiles_    = 0;
    uint32_t tileDataLen_ = 0;
};

extern "C" __global__ __vector__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, MulCustomTilingData tiling)
{
    KernelMul op;
    op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    op.Process();
}

std::vector<float> kernel_mul(std::vector<float> &x, std::vector<float> &y)
{
    if (x.size() != y.size()) {
        std::cerr << "Error: input sizes differ." << std::endl;
        return {};
    }

    std::vector<float> result(x.size(), 0.0f);
    if (x.empty()) {
        return result;
    }

    const size_t nBytes = x.size() * sizeof(float);
    const int32_t device = 0;
    bool needReset = false;
    uint8_t *dX = nullptr;
    uint8_t *dY = nullptr;
    uint8_t *dZ = nullptr;
    aclrtStream stream = nullptr;

    // 资源统一回收
    auto release = [&]() {
        if (dX)     aclrtFree(dX);
        if (dY)     aclrtFree(dY);
        if (dZ)     aclrtFree(dZ);
        if (stream) aclrtDestroyStream(stream);
        if (needReset) aclrtResetDevice(device);
        aclFinalize();
    };

    // 错误检查宏（避免重复代码）
    auto check = [&](aclError ret, const char* msg) {
        if (ret != ACL_SUCCESS) {
            std::cerr << msg << " error: " << ret << std::endl;
            release();
            return false;
        }
        return true;
    };

    if (!check(aclInit(nullptr), "aclInit")) return {};

    if (!check(aclrtSetDevice(device), "aclrtSetDevice")) return {};
    needReset = true;

    int64_t vCores = 0;
    if (!check(aclrtGetDeviceInfo(device, ACL_DEV_ATTR_VECTOR_CORE_NUM, &vCores),
               "get device info")) return {};

    if (!check(aclrtCreateStream(&stream), "aclrtCreateStream")) return {};

    if (!check(aclrtMalloc((void**)&dX, nBytes, ACL_MEM_MALLOC_HUGE_FIRST), "malloc x")) return {};
    if (!check(aclrtMalloc((void**)&dY, nBytes, ACL_MEM_MALLOC_HUGE_FIRST), "malloc y")) return {};
    if (!check(aclrtMalloc((void**)&dZ, nBytes, ACL_MEM_MALLOC_HUGE_FIRST), "malloc z")) return {};

    if (!check(aclrtMemcpy(dX, nBytes, x.data(), nBytes, ACL_MEMCPY_HOST_TO_DEVICE),
               "memcpy H2D x")) return {};
    if (!check(aclrtMemcpy(dY, nBytes, y.data(), nBytes, ACL_MEMCPY_HOST_TO_DEVICE),
               "memcpy H2D y")) return {};

    // 动态选择 block 数量
    uint32_t blkCnt = 1;
    if (vCores >= 8)      blkCnt = 8;
    else if (vCores >= 4) blkCnt = 4;
    else if (vCores >= 2) blkCnt = 2;

    MulCustomTilingData tiling {
        static_cast<uint32_t>(x.size()),
        TILE_BLOCKS
    };

    mul_custom<<<blkCnt, nullptr, stream>>>(dX, dY, dZ, tiling);

    if (!check(aclrtSynchronizeStream(stream), "sync stream")) return {};

    if (!check(aclrtMemcpy(result.data(), nBytes, dZ, nBytes, ACL_MEMCPY_DEVICE_TO_HOST),
               "memcpy D2H")) return {};

    release();
    return result;
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printVec = [](std::vector<float> &vec, const char *label) {
        constexpr size_t maxShow = 20;
        std::cout << label << ": ";
        for (size_t i = 0; i < vec.size() && i < maxShow; ++i)
            std::cout << vec[i] << " ";
        if (vec.size() > maxShow) std::cout << "...";
        std::cout << std::endl;
    };
    printVec(output, "Output ");
    printVec(golden, "Golden ");

    if (output.size() != golden.size()) {
        std::cout << "[Failed] Size mismatch." << std::endl;
        return 1;
    }
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Validation passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Validation failed!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    std::vector<float> output = kernel_mul(x, y);
    if (output.size() != totalLength) {
        std::cout << "[Failed] Output size invalid." << std::endl;
        return 1;
    }

    std::vector<float> golden(totalLength, valueX * valueY);
    return VerifyResult(output, golden);
}