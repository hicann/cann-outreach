// ========== mul_custom.asc 完整代码 ==========
// 矢量乘法算子：z = x * y，数据类型 float，Shape (8, 2048)

#include "kernel_operator.h"

extern "C" __global__ __aicore__ void mul_custom(
    __gm__ float* x,
    __gm__ float* y,
    __gm__ float* z,
    __gm__ uint32_t* tiling_gm
) {
    uint32_t totalElements = 8 * 2048;
    uint32_t coreId = GetBlockIdx();
    uint32_t coreNum = GetBlockNum();
    
    uint32_t elemPerCore = totalElements / coreNum;
    uint32_t startIdx = coreId * elemPerCore;
    uint32_t endIdx = (coreId == coreNum - 1) ? totalElements : startIdx + elemPerCore;
    uint32_t localTotal = endIdx - startIdx;
    
    const uint32_t TILE_SIZE = 32;
    uint32_t tileNum = localTotal / TILE_SIZE;
    
    TPipe pipe;
    TQue<QuePosition::VECIN, 2> queX, queY;
    TQue<QuePosition::VECOUT, 2> queZ;
    pipe.InitBuffer(queX, 2 * TILE_SIZE * sizeof(float));
    pipe.InitBuffer(queY, 2 * TILE_SIZE * sizeof(float));
    pipe.InitBuffer(queZ, 2 * TILE_SIZE * sizeof(float));
    
    float* x_gm = x + startIdx;
    float* y_gm = y + startIdx;
    float* z_gm = z + startIdx;
    
    for (uint32_t i = 0; i < tileNum; i++) {
        DataCopy(queX.Alloc(), x_gm + i * TILE_SIZE, TILE_SIZE * sizeof(float));
        DataCopy(queY.Alloc(), y_gm + i * TILE_SIZE, TILE_SIZE * sizeof(float));
        Mul(queZ.Alloc(), queX.Get(), queY.Get(), TILE_SIZE * sizeof(float));
        DataCopy(z_gm + i * TILE_SIZE, queZ.Get(), TILE_SIZE * sizeof(float));
    }
}