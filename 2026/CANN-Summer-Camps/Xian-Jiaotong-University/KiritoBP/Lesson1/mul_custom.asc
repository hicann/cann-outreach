// mul_custom.asc
// Lesson 1: 矢量乘法算子 mul_custom
// 功能: z = x * y，逐元素乘法
// 数据类型: float，Shape: (8, 2048)，Format: ND

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

constexpr uint32_t BUFFER_NUM = 2; // tensor num for each queue

struct MulCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelMul {
public:
    __aicore__ inline KernelMul(){}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {
        this->totalLen = totalLength;
        this->singleTileNum = tileNum;

        uint32_t coreNum = AscendC::GetBlockNum();
        uint32_t coreIdx = AscendC::GetBlockIdx();

        uint32_t basePerCore = totalLen / coreNum;
        uint32_t remainElem  = totalLen % coreNum;
        this->coreDataLen = basePerCore + (coreIdx < remainElem ? 1 : 0);

        uint32_t gmOffset = coreIdx * basePerCore + (coreIdx < remainElem ? coreIdx : remainElem);

        xGm.SetGlobalBuffer((__gm__ float*)x + gmOffset, this->coreDataLen);
        yGm.SetGlobalBuffer((__gm__ float*)y + gmOffset, this->coreDataLen);
        zGm.SetGlobalBuffer((__gm__ float*)z + gmOffset, this->coreDataLen);

        this->tileBaseLen  = this->coreDataLen / singleTileNum;
        this->tileRemainLen= this->coreDataLen % singleTileNum;

        uint32_t maxTileSize = tileBaseLen + (tileRemainLen > 0 ? 1 : 0);
        uint32_t bufByteSize = maxTileSize * sizeof(float);

        pipe.InitBuffer(inQueX,  BUFFER_NUM, bufByteSize);
        pipe.InitBuffer(inQueY,  BUFFER_NUM, bufByteSize);
        pipe.InitBuffer(outQueZ, BUFFER_NUM, bufByteSize);
    }
    __aicore__ inline void Process()
    {
        for (int32_t i = 0; i < (int32_t)singleTileNum; ++i)
        {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        uint32_t tileOffset = progress * tileBaseLen;
        uint32_t copyLen    = tileBaseLen;
        if (progress == (int32_t)singleTileNum - 1 && tileRemainLen > 0)
        {
            copyLen = tileRemainLen;
        }

        AscendC::LocalTensor<float> xLocal = inQueX.AllocTensor<float>();
        AscendC::LocalTensor<float> yLocal = inQueY.AllocTensor<float>();

        AscendC::DataCopy(xLocal, xGm[tileOffset], copyLen);
        AscendC::DataCopy(yLocal, yGm[tileOffset], copyLen);

        inQueX.EnQue(xLocal);
        inQueY.EnQue(yLocal);
    }
    __aicore__ inline void Compute(int32_t progress)
    {
        uint32_t computeLen = tileBaseLen;
        if (progress == (int32_t)singleTileNum - 1 && tileRemainLen > 0)
        {
            computeLen = tileRemainLen;
        }

        AscendC::LocalTensor<float> xLocal = inQueX.DeQue<float>();
        AscendC::LocalTensor<float> yLocal = inQueY.DeQue<float>();
        AscendC::LocalTensor<float> zLocal = outQueZ.AllocTensor<float>();

        AscendC::Mul(zLocal, xLocal, yLocal, computeLen);

        outQueZ.EnQue(zLocal);
        inQueX.FreeTensor(xLocal);
        inQueY.FreeTensor(yLocal);
    }
    __aicore__ inline void CopyOut(int32_t progress)
    {
        uint32_t tileOffset = progress * tileBaseLen;
        uint32_t copyLen    = tileBaseLen;
        if (progress == (int32_t)singleTileNum - 1 && tileRemainLen > 0)
        {
            copyLen = tileRemainLen;
        }

        AscendC::LocalTensor<float> zLocal = outQueZ.DeQue<float>();
        AscendC::DataCopy(zGm[tileOffset], zLocal, copyLen);
        outQueZ.FreeTensor(zLocal);
    }

private:
    AscendC::GlobalTensor<float> xGm, yGm, zGm;
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN,  BUFFER_NUM> inQueX;
    AscendC::TQue<AscendC::QuePosition::VECIN,  BUFFER_NUM> inQueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, BUFFER_NUM> outQueZ;

    uint32_t totalLen;        
    uint32_t singleTileNum;   
    uint32_t coreDataLen;    
    uint32_t tileBaseLen;   
    uint32_t tileRemainLen; 
};

__global__ __aicore__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, MulCustomTilingData tiling)
{
    KernelMul op;
    op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    op.Process();
}

std::vector<float> kernel_mul(std::vector<float> &x, std::vector<float> &y)
{
    static bool g_acl_inited = false;
    if (!g_acl_inited)
    {
        aclInit(nullptr);
        aclrtSetDevice(0);
        g_acl_inited = true;
    }

    uint32_t elemNum = x.size();
    uint32_t dataByteSize = elemNum * sizeof(float);

    void* devX = nullptr;
    void* devY = nullptr;
    void* devZ = nullptr;
    aclrtMalloc(&devX, dataByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&devY, dataByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&devZ, dataByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(devX, dataByteSize, x.data(), dataByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(devY, dataByteSize, y.data(), dataByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    MulCustomTilingData tiling{};
    tiling.totalLength = elemNum;
    tiling.tileNum     = 8;  

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    mul_custom<<<8, nullptr, stream>>>((GM_ADDR)devX, (GM_ADDR)devY, (GM_ADDR)devZ, tiling);

    aclrtSynchronizeStream(stream);

    std::vector<float> output(elemNum);
    aclrtMemcpy(output.data(), dataByteSize, devZ, dataByteSize, ACL_MEMCPY_DEVICE_TO_HOST);

    aclrtDestroyStream(stream);
    aclrtFree(devX);
    aclrtFree(devY);
    aclrtFree(devZ);

    return output;
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
    return 0;
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    std::vector<float> output = kernel_mul(x, y);

    std::vector<float> golden(totalLength, valueX * valueY);
    return VerifyResult(output, golden);
}
