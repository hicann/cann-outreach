// mul_custom.asc

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include <cmath>
#include "acl/acl.h"
#include "kernel_operator.h"

constexpr uint32_t BUFFER_NUM = 2; // tensor num for each queue
constexpr uint32_t BLOCK_NUM = 8;
constexpr uint32_t TILE_NUM = 8;
constexpr uint32_t ALIGN_FLOAT_NUM = 32 / sizeof(float);

__aicore__ inline uint32_t CeilDiv(uint32_t value, uint32_t factor)
{
    return factor == 0 ? 0 : (value + factor - 1) / factor;
}

__aicore__ inline uint32_t AlignUp(uint32_t value, uint32_t factor)
{
    return CeilDiv(value, factor) * factor;
}

struct MulCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelMul {
public:
    __aicore__ inline KernelMul(){}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {
        ASSERT(AscendC::GetBlockNum() != 0 && "block dim can not be zero!");
        const uint32_t blockNum = AscendC::GetBlockNum();
        const uint32_t blockIdx = AscendC::GetBlockIdx();
        const uint32_t baseLength = totalLength / blockNum;
        const uint32_t tailBlockNum = totalLength % blockNum;

        this->blockLength = baseLength + (blockIdx < tailBlockNum ? 1 : 0);
        this->blockOffset = blockIdx * baseLength + (blockIdx < tailBlockNum ? blockIdx : tailBlockNum);
        this->tileNum = tileNum;
        ASSERT(this->tileNum != 0 && "tile num can not be zero!");
        this->loopCount = this->tileNum * BUFFER_NUM;
        this->tileLength = CeilDiv(this->blockLength, this->loopCount);
        this->tileLengthAligned = AlignUp(this->tileLength, ALIGN_FLOAT_NUM);

        xGm.SetGlobalBuffer((__gm__ float*)x + this->blockOffset, this->blockLength);
        yGm.SetGlobalBuffer((__gm__ float*)y + this->blockOffset, this->blockLength);
        zGm.SetGlobalBuffer((__gm__ float*)z + this->blockOffset, this->blockLength);

        if (this->tileLengthAligned != 0) {
            pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLengthAligned * sizeof(float));
            pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLengthAligned * sizeof(float));
            pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLengthAligned * sizeof(float));
        }
    }
    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < this->loopCount; ++i) {
            const uint32_t offset = i * this->tileLength;
            if (offset >= this->blockLength) {
                return;
            }
            const uint32_t length = (offset + this->tileLength <= this->blockLength) ?
                this->tileLength : (this->blockLength - offset);
            CopyIn(i, length);
            Compute(i, length);
            CopyOut(i, length);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t progress, uint32_t length)
    {
        AscendC::LocalTensor<float> xLocal = inQueueX.AllocTensor<float>();
        AscendC::LocalTensor<float> yLocal = inQueueY.AllocTensor<float>();
        const uint32_t currentLengthAligned = AlignUp(length, ALIGN_FLOAT_NUM);
        AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(length * sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<float> padParams{
            true, 0, static_cast<uint8_t>(currentLengthAligned - length), 0.0f};
        AscendC::DataCopyPad(xLocal, xGm[progress * this->tileLength], copyParams, padParams);
        AscendC::DataCopyPad(yLocal, yGm[progress * this->tileLength], copyParams, padParams);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }
    __aicore__ inline void Compute(uint32_t progress, uint32_t length)
    {
        AscendC::LocalTensor<float> xLocal = inQueueX.DeQue<float>();
        AscendC::LocalTensor<float> yLocal = inQueueY.DeQue<float>();
        AscendC::LocalTensor<float> zLocal = outQueueZ.AllocTensor<float>();
        AscendC::Mul(zLocal, xLocal, yLocal, length);
        outQueueZ.EnQue<float>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }
    __aicore__ inline void CopyOut(uint32_t progress, uint32_t length)
    {
        AscendC::LocalTensor<float> zLocal = outQueueZ.DeQue<float>();
        AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(length * sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPad(zGm[progress * this->tileLength], zLocal, copyParams);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, BUFFER_NUM> inQueueX;
    AscendC::TQue<AscendC::QuePosition::VECIN, BUFFER_NUM> inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, BUFFER_NUM> outQueueZ;
    AscendC::GlobalTensor<float> xGm;
    AscendC::GlobalTensor<float> yGm;
    AscendC::GlobalTensor<float> zGm;
    uint32_t blockOffset;
    uint32_t blockLength;
    uint32_t tileNum;
    uint32_t loopCount;
    uint32_t tileLength;
    uint32_t tileLengthAligned;
};

__global__ __aicore__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, MulCustomTilingData tiling)
{
    KernelMul op;
    op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    op.Process();
}

std::vector<float> kernel_mul(std::vector<float> &x, std::vector<float> &y)
{
    const uint32_t totalLength = static_cast<uint32_t>(x.size());
    const size_t totalByteSize = totalLength * sizeof(float);
    const MulCustomTilingData tiling{totalLength, TILE_NUM};

    int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    uint8_t *xHost = reinterpret_cast<uint8_t*>(x.data());
    uint8_t *yHost = reinterpret_cast<uint8_t*>(y.data());
    uint8_t *zHost = nullptr;
    uint8_t *xDevice = nullptr;
    uint8_t *yDevice = nullptr;
    uint8_t *zDevice = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(deviceId);
    aclrtCreateStream(&stream);

    aclrtMallocHost(reinterpret_cast<void**>(&zHost), totalByteSize);
    aclrtMalloc(reinterpret_cast<void**>(&xDevice), totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&yDevice), totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&zDevice), totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(xDevice, totalByteSize, xHost, totalByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(yDevice, totalByteSize, yHost, totalByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    mul_custom<<<BLOCK_NUM, nullptr, stream>>>(xDevice, yDevice, zDevice, tiling);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(zHost, totalByteSize, zDevice, totalByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> z(reinterpret_cast<float*>(zHost), reinterpret_cast<float*>(zHost + totalByteSize));

    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(zHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return z;
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (output.size() != golden.size()) {
        std::cout << "[Failed] Output size mismatch, output is " << output.size()
            << ", golden is " << golden.size() << std::endl;
        return 1;
    }
    constexpr float atol = 1e-5f;
    constexpr float rtol = 1e-5f;
    for (size_t i = 0; i < golden.size(); ++i) {
        const float diff = std::abs(output[i] - golden[i]);
        const float tolerance = atol + rtol * std::abs(golden[i]);
        if (diff > tolerance) {
            std::cout << "[Failed] Case accuracy is verification failed at index " << i
                << ", output is " << output[i] << ", golden is " << golden[i] << std::endl;
            return 1;
        }
    }
    std::cout << "[Success] Case accuracy is verification passed." << std::endl;
    return 0;
}

int32_t main(int32_t argc, char *argv[])
{
    const std::vector<uint32_t> caseLengths = {
        1,          // small tensor, smaller than one 32B block
        7,          // unaligned tail
        8,          // exactly one 32B block for float
        13,         // unaligned multi-block tail
        257,        // medium tensor with uneven core split
        8 * 2048,   // assignment shape
        8 * 2048 + 3
    };

    for (uint32_t totalLength : caseLengths) {
        std::cout << "Running case, totalLength = " << totalLength << std::endl;
        std::vector<float> x(totalLength);
        std::vector<float> y(totalLength);
        std::vector<float> golden(totalLength);
        for (uint32_t i = 0; i < totalLength; ++i) {
            x[i] = (static_cast<int32_t>(i % 17) - 8) * 0.25f + 1.2f;
            y[i] = (static_cast<int32_t>(i % 13) - 6) * -0.125f + 2.3f;
            golden[i] = x[i] * y[i];
        }

        std::vector<float> output = kernel_mul(x, y);
        if (VerifyResult(output, golden) != 0) {
            return 1;
        }
    }

    return 0;
}
