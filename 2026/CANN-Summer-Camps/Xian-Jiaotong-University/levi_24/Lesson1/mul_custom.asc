// mul_operator.asc

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

namespace AscendKernelSpace
{
using namespace AscendC;

constexpr uint32_t DATA_BUFFER_COUNT = 2;

struct MulTaskSplitParam
{
    uint32_t dataTotalLen;
    uint32_t singleBlockTileCnt;
};

class VectorMulKernel
{
public:
    __aicore__ inline VectorMulKernel() = default;

    __aicore__ inline void KernelInit(GM_ADDR inputXAddr, GM_ADDR inputYAddr, GM_ADDR outputZAddr, uint32_t totalDataLen, uint32_t tileCount)
    {
        uint32_t coreNumber = AscendC::GetBlockNum();
        coreDataLength = totalDataLen / coreNumber;
        tileAmount = tileCount;
        uint32_t singleBufTileLen = coreDataLength / tileAmount / DATA_BUFFER_COUNT;
        perTileDataLength = singleBufTileLen;

        uint32_t coreIndex = AscendC::GetBlockIdx();
        xGlobalBuf.SetGlobalBuffer((__gm__ float *)inputXAddr + coreDataLength * coreIndex, coreDataLength);
        yGlobalBuf.SetGlobalBuffer((__gm__ float *)inputYAddr + coreDataLength * coreIndex, coreDataLength);
        zGlobalBuf.SetGlobalBuffer((__gm__ float *)outputZAddr + coreDataLength * coreIndex, coreDataLength);

        dataPipe.InitBuffer(inputQueueX, DATA_BUFFER_COUNT, perTileDataLength * sizeof(float));
        dataPipe.InitBuffer(inputQueueY, DATA_BUFFER_COUNT, perTileDataLength * sizeof(float));
        dataPipe.InitBuffer(outputQueueZ, DATA_BUFFER_COUNT, perTileDataLength * sizeof(float));
    }

    __aicore__ inline void KernelExecute()
    {
        int32_t totalLoopTimes = tileAmount * DATA_BUFFER_COUNT;
        for (int32_t step = 0; step < totalLoopTimes; step++)
        {
            DataFetch(step);
            DataCalculate(step);
            DataWriteBack(step);
        }
    }

private:
    __aicore__ inline void DataFetch(int32_t stepId)
    {
        AscendC::LocalTensor<float> localX = inputQueueX.AllocTensor<float>();
        AscendC::LocalTensor<float> localY = inputQueueY.AllocTensor<float>();

        uint32_t dataOffset = stepId * perTileDataLength;
        AscendC::DataCopy(localX, xGlobalBuf[dataOffset], perTileDataLength);
        AscendC::DataCopy(localY, yGlobalBuf[dataOffset], perTileDataLength);

        inputQueueX.EnQue(localX);
        inputQueueY.EnQue(localY);
    }

    __aicore__ inline void DataCalculate(int32_t stepId)
    {
        (void)stepId;
        AscendC::LocalTensor<float> regX = inputQueueX.DeQue<float>();
        AscendC::LocalTensor<float> regY = inputQueueY.DeQue<float>();
        AscendC::LocalTensor<float> regZ = outputQueueZ.AllocTensor<float>();

        AscendC::Mul(regZ, regX, regY, perTileDataLength);

        outputQueueZ.EnQue(regZ);
        inputQueueX.FreeTensor(regX);
        inputQueueY.FreeTensor(regY);
    }

    __aicore__ inline void DataWriteBack(int32_t stepId)
    {
        AscendC::LocalTensor<float> localResult = outputQueueZ.DeQue<float>();
        uint32_t writeOffset = stepId * perTileDataLength;
        AscendC::DataCopy(zGlobalBuf[writeOffset], localResult, perTileDataLength);
        outputQueueZ.FreeTensor(localResult);
    }

private:
    AscendC::TPipe dataPipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, DATA_BUFFER_COUNT> inputQueueX;
    AscendC::TQue<AscendC::QuePosition::VECIN, DATA_BUFFER_COUNT> inputQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, DATA_BUFFER_COUNT> outputQueueZ;

    AscendC::GlobalTensor<float> xGlobalBuf;
    AscendC::GlobalTensor<float> yGlobalBuf;
    AscendC::GlobalTensor<float> zGlobalBuf;

    uint32_t coreDataLength;
    uint32_t tileAmount;
    uint32_t perTileDataLength;
};
}

extern "C" __global__ __vector__ void mul_custom(GM_ADDR xBase, GM_ADDR yBase, GM_ADDR zBase, GM_ADDR splitParamAddr)
{
    using namespace AscendKernelSpace;
    MulTaskSplitParam taskParam;
    const __gm__ MulTaskSplitParam *rawParamPtr = reinterpret_cast<const __gm__ MulTaskSplitParam *>(splitParamAddr);
    taskParam.dataTotalLen = rawParamPtr->dataTotalLen;
    taskParam.singleBlockTileCnt = rawParamPtr->singleBlockTileCnt;

    VectorMulKernel computeKernel;
    computeKernel.KernelInit(xBase, yBase, zBase, taskParam.dataTotalLen, taskParam.singleBlockTileCnt);
    computeKernel.KernelExecute();
}

std::vector<float> run_mul_compute(std::vector<float> &hostXData, std::vector<float> &hostYData)
{
    const uint32_t computeBlockNum = 8;
    const uint32_t tileSplitNumber = 8;

    uint32_t totalElemNum = static_cast<uint32_t>(hostXData.size());
    std::vector<float> hostOutputData(totalElemNum, 0.0f);
    if (hostXData.size() != hostYData.size() || totalElemNum == 0U)
    {
        return hostOutputData;
    }

    int32_t usedDevice = 0;
    aclInit(nullptr);
    aclrtSetDevice(usedDevice);

    aclrtStream computeStream = nullptr;
    aclrtCreateStream(&computeStream);

    size_t singleElemByte = sizeof(float);
    size_t totalDataBytes = totalElemNum * singleElemByte;

    uint8_t *devXMem = nullptr;
    uint8_t *devYMem = nullptr;
    uint8_t *devZMem = nullptr;
    uint8_t *devParamMem = nullptr;

    aclrtMalloc(reinterpret_cast<void **>(&devXMem), totalDataBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void **>(&devYMem), totalDataBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void **>(&devZMem), totalDataBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void **>(&devParamMem), sizeof(AscendKernelSpace::MulTaskSplitParam), ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(devXMem, totalDataBytes, hostXData.data(), totalDataBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(devYMem, totalDataBytes, hostYData.data(), totalDataBytes, ACL_MEMCPY_HOST_TO_DEVICE);

    AscendKernelSpace::MulTaskSplitParam configParam{totalElemNum, tileSplitNumber};
    aclrtMemcpy(devParamMem, sizeof(configParam), &configParam, sizeof(configParam), ACL_MEMCPY_HOST_TO_DEVICE);

    mul_custom<<<computeBlockNum, nullptr, computeStream>>>(devXMem, devYMem, devZMem, devParamMem);
    aclrtSynchronizeStream(computeStream);

    aclrtMemcpy(hostOutputData.data(), totalDataBytes, devZMem, totalDataBytes, ACL_MEMCPY_DEVICE_TO_HOST);

    aclrtFree(devXMem);
    aclrtFree(devYMem);
    aclrtFree(devZMem);
    aclrtFree(devParamMem);
    aclrtDestroyStream(computeStream);
    aclrtResetDevice(usedDevice);
    aclFinalize();

    return hostOutputData;
}

uint32_t check_correct_result(std::vector<float> &calcResult, std::vector<float> &stdGoldenVal)
{
    auto print_vector_info = [](std::vector<float> &dataVec, const char *vecTag)
    {
        constexpr size_t showMaxCnt = 20;
        std::cout << vecTag << " values: ";
        size_t printCnt = std::min(dataVec.size(), showMaxCnt);
        std::copy(dataVec.begin(), dataVec.begin() + printCnt, std::ostream_iterator<float>(std::cout, " "));
        if (dataVec.size() > showMaxCnt)
        {
            std::cout << "......";
        }
        std::cout << std::endl;
    };

    print_vector_info(calcResult, "Actual Output");
    print_vector_info(stdGoldenVal, "Standard Golden");

    bool dataMatch = std::equal(stdGoldenVal.begin(), stdGoldenVal.end(), calcResult.begin());
    if (dataMatch)
    {
        std::cout << "[PASS] Calculation result verification succeeded!" << std::endl;
        return 0U;
    }
    else
    {
        std::cout << "[FAIL] Calculation result verification failed!" << std::endl;
        return 1U;
    }
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t fullDataLength = 8 * 2048;
    constexpr float constXVal = 1.2f;
    constexpr float constYVal = 2.3f;

    std::vector<float> inputX(fullDataLength, constXVal);
    std::vector<float> inputY(fullDataLength, constYVal);
    std::vector<float> computeRes = run_mul_compute(inputX, inputY);
    std::vector<float> standardRes(fullDataLength, constXVal * constYVal);

    return check_correct_result(computeRes, standardRes);
}