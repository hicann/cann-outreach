#include <algorithm>
#include <cstdint>
#include <iostream>
#include <vector>

#include "acl/acl.h"
#include "kernel_operator.h"

// 输入 Shape：(8, 2048)
constexpr uint32_t TOTAL_LENGTH = 8 * 2048;

// 使用 8 个 Vector Core。
constexpr uint32_t BLOCK_NUM = 8;

// 每个核处理的元素数量：16384 / 8 = 2048。
constexpr uint32_t BLOCK_LENGTH =
    TOTAL_LENGTH / BLOCK_NUM;

// 每个核的数据划分为 8 个 tile。
constexpr uint32_t TILE_NUM = 8;

// 每个队列申请两个 Buffer，实现双缓冲。
constexpr uint32_t BUFFER_NUM = 2;

// 单个实际处理块包含的元素数量：
// 2048 / 8 / 2 = 128。
constexpr uint32_t TILE_LENGTH =
    BLOCK_LENGTH / TILE_NUM / BUFFER_NUM;


/**
 * Ascend C 逐元素乘法 Kernel。
 *
 * 计算公式：
 *     z[i] = x[i] * y[i]
 */
class KernelMul {
public:
    __aicore__ inline KernelMul()
    {
    }

    /**
     * 初始化当前核的 GM 地址和 Local Memory 队列。
     */
    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z)
    {
        // 每个核只处理属于自己的 BLOCK_LENGTH 个元素。
        const uint32_t blockOffset =
            BLOCK_LENGTH * AscendC::GetBlockIdx();

        xGm_.SetGlobalBuffer(
            (__gm__ float *)x + blockOffset,
            BLOCK_LENGTH);

        yGm_.SetGlobalBuffer(
            (__gm__ float *)y + blockOffset,
            BLOCK_LENGTH);

        zGm_.SetGlobalBuffer(
            (__gm__ float *)z + blockOffset,
            BLOCK_LENGTH);

        // 为输入队列和输出队列申请 Local Memory。
        pipe_.InitBuffer(
            inputQueueX_,
            BUFFER_NUM,
            TILE_LENGTH * sizeof(float));

        pipe_.InitBuffer(
            inputQueueY_,
            BUFFER_NUM,
            TILE_LENGTH * sizeof(float));

        pipe_.InitBuffer(
            outputQueueZ_,
            BUFFER_NUM,
            TILE_LENGTH * sizeof(float));
    }

    /**
     * 执行 CopyIn -> Compute -> CopyOut 流水。
     */
    __aicore__ inline void Process()
    {
        // 每个核处理 8 * 2 = 16 个实际数据块。
        constexpr int32_t loopCount =
            TILE_NUM * BUFFER_NUM;

        for (int32_t progress = 0;
             progress < loopCount;
             ++progress) {
            CopyIn(progress);
            Compute();
            CopyOut(progress);
        }
    }

private:
    /**
     * 将输入数据从 Global Memory 搬入 Local Memory。
     */
    __aicore__ inline void CopyIn(
        int32_t progress)
    {
        AscendC::LocalTensor<float> xLocal =
            inputQueueX_.AllocTensor<float>();

        AscendC::LocalTensor<float> yLocal =
            inputQueueY_.AllocTensor<float>();

        const uint32_t offset =
            static_cast<uint32_t>(progress) *
            TILE_LENGTH;

        AscendC::DataCopy(
            xLocal,
            xGm_[offset],
            TILE_LENGTH);

        AscendC::DataCopy(
            yLocal,
            yGm_[offset],
            TILE_LENGTH);

        inputQueueX_.EnQue(xLocal);
        inputQueueY_.EnQue(yLocal);
    }

    /**
     * 执行逐元素乘法。
     */
    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<float> xLocal =
            inputQueueX_.DeQue<float>();

        AscendC::LocalTensor<float> yLocal =
            inputQueueY_.DeQue<float>();

        AscendC::LocalTensor<float> zLocal =
            outputQueueZ_.AllocTensor<float>();

        // 对 TILE_LENGTH 个 float 元素进行逐元素乘法：
        //
        // zLocal[i] = xLocal[i] * yLocal[i]
        AscendC::Mul(
            zLocal,
            xLocal,
            yLocal,
            TILE_LENGTH);

        outputQueueZ_.EnQue<float>(zLocal);

        inputQueueX_.FreeTensor(xLocal);
        inputQueueY_.FreeTensor(yLocal);
    }

    /**
     * 将结果从 Local Memory 搬回 Global Memory。
     */
    __aicore__ inline void CopyOut(
        int32_t progress)
    {
        AscendC::LocalTensor<float> zLocal =
            outputQueueZ_.DeQue<float>();

        const uint32_t offset =
            static_cast<uint32_t>(progress) *
            TILE_LENGTH;

        AscendC::DataCopy(
            zGm_[offset],
            zLocal,
            TILE_LENGTH);

        outputQueueZ_.FreeTensor(zLocal);
    }

private:
    // Local Memory 管理对象。
    AscendC::TPipe pipe_;

    // 输入队列。
    AscendC::TQue<
        AscendC::TPosition::VECIN,
        BUFFER_NUM> inputQueueX_;

    AscendC::TQue<
        AscendC::TPosition::VECIN,
        BUFFER_NUM> inputQueueY_;

    // 输出队列。
    AscendC::TQue<
        AscendC::TPosition::VECOUT,
        BUFFER_NUM> outputQueueZ_;

    // Global Memory Tensor。
    AscendC::GlobalTensor<float> xGm_;
    AscendC::GlobalTensor<float> yGm_;
    AscendC::GlobalTensor<float> zGm_;
};


/**
 * Ascend C Kernel 入口。
 *
 * mul_custom 是 Vector Kernel，因此使用 __vector__。
 */
__global__ __vector__ void mul_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z)
{
    KernelMul kernel;

    kernel.Init(x, y, z);
    kernel.Process();
}


/**
 * Host 侧启动 Kernel。
 */
std::vector<float> kernel_mul(
    const std::vector<float> &x,
    const std::vector<float> &y)
{
    if (x.size() != y.size()) {
        std::cerr
            << "[Failed] x and y have different sizes."
            << std::endl;

        return {};
    }

    if (x.size() != TOTAL_LENGTH) {
        std::cerr
            << "[Failed] Input length must be "
            << TOTAL_LENGTH
            << ", but received "
            << x.size()
            << "."
            << std::endl;

        return {};
    }

    const size_t totalByteSize =
        TOTAL_LENGTH * sizeof(float);

    constexpr int32_t deviceId = 0;

    aclrtStream stream = nullptr;

    uint8_t *xDevice = nullptr;
    uint8_t *yDevice = nullptr;
    uint8_t *zDevice = nullptr;

    uint8_t *zHost = nullptr;

    // 初始化 ACL。
    aclInit(nullptr);

    // 选择 NPU 设备。
    aclrtSetDevice(deviceId);

    // 创建执行流。
    aclrtCreateStream(&stream);

    // 申请锁页 Host 内存，用于接收输出结果。
    aclrtMallocHost(
        reinterpret_cast<void **>(&zHost),
        totalByteSize);

    // 申请 NPU 侧 Global Memory。
    aclrtMalloc(
        reinterpret_cast<void **>(&xDevice),
        totalByteSize,
        ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMalloc(
        reinterpret_cast<void **>(&yDevice),
        totalByteSize,
        ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMalloc(
        reinterpret_cast<void **>(&zDevice),
        totalByteSize,
        ACL_MEM_MALLOC_HUGE_FIRST);

    // 输入数据：Host -> Device。
    aclrtMemcpy(
        xDevice,
        totalByteSize,
        x.data(),
        totalByteSize,
        ACL_MEMCPY_HOST_TO_DEVICE);

    aclrtMemcpy(
        yDevice,
        totalByteSize,
        y.data(),
        totalByteSize,
        ACL_MEMCPY_HOST_TO_DEVICE);

    // 启动 8 个 Vector Core 执行 Kernel。
    mul_custom<<<BLOCK_NUM, nullptr, stream>>>(
        xDevice,
        yDevice,
        zDevice);

    // 等待 Kernel 执行完成。
    aclrtSynchronizeStream(stream);

    // 输出数据：Device -> Host。
    aclrtMemcpy(
        zHost,
        totalByteSize,
        zDevice,
        totalByteSize,
        ACL_MEMCPY_DEVICE_TO_HOST);

    const float *resultBegin =
        reinterpret_cast<const float *>(zHost);

    std::vector<float> result(
        resultBegin,
        resultBegin + TOTAL_LENGTH);

    // 释放 Device 内存。
    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFree(zDevice);

    // 释放 Host 内存。
    aclrtFreeHost(zHost);

    // 销毁 Stream。
    aclrtDestroyStream(stream);

    // 重置设备并结束 ACL。
    aclrtResetDevice(deviceId);
    aclFinalize();

    return result;
}


/**
 * 打印并验证计算结果。
 */
uint32_t VerifyResult(
    const std::vector<float> &output,
    const std::vector<float> &golden)
{
    constexpr size_t maxPrintCount = 20;
    constexpr float tolerance = 1e-5f;

    if (output.size() != golden.size()) {
        std::cerr
            << "[Failed] Output size is incorrect. "
            << "Output size: "
            << output.size()
            << ", golden size: "
            << golden.size()
            << "."
            << std::endl;

        return 1;
    }

    std::cout << "Output: ";

    for (size_t index = 0;
         index < std::min(
             output.size(),
             maxPrintCount);
         ++index) {
        std::cout
            << output[index]
            << " ";
    }

    if (output.size() > maxPrintCount) {
        std::cout << "...";
    }

    std::cout << std::endl;

    std::cout << "Golden: ";

    for (size_t index = 0;
         index < std::min(
             golden.size(),
             maxPrintCount);
         ++index) {
        std::cout
            << golden[index]
            << " ";
    }

    if (golden.size() > maxPrintCount) {
        std::cout << "...";
    }

    std::cout << std::endl;

    uint32_t errorCount = 0;

    for (size_t index = 0;
         index < output.size();
         ++index) {
        float difference =
            output[index] - golden[index];

        if (difference < 0.0f) {
            difference = -difference;
        }

        if (difference > tolerance) {
            if (errorCount < 10) {
                std::cerr
                    << "[Mismatch] index="
                    << index
                    << ", output="
                    << output[index]
                    << ", golden="
                    << golden[index]
                    << ", difference="
                    << difference
                    << std::endl;
            }

            ++errorCount;
        }
    }

    if (errorCount == 0) {
        std::cout
            << "[Success] Case accuracy is "
            << "verification passed."
            << std::endl;

        return 0;
    }

    std::cerr
        << "[Failed] Case accuracy is "
        << "verification failed. Error count: "
        << errorCount
        << std::endl;

    return 1;
}


/**
 * 测试入口。
 */
int32_t main(
    int32_t argc,
    char *argv[])
{
    (void)argc;
    (void)argv;

    constexpr float xValue = 1.2f;
    constexpr float yValue = 2.3f;

    // Shape：(8, 2048)，总元素数 16384。
    std::vector<float> x(
        TOTAL_LENGTH,
        xValue);

    std::vector<float> y(
        TOTAL_LENGTH,
        yValue);

    // 调用 NPU Kernel。
    std::vector<float> output =
        kernel_mul(x, y);

    // 计算 CPU 侧真值。
    std::vector<float> golden(
        TOTAL_LENGTH);

    for (uint32_t index = 0;
         index < TOTAL_LENGTH;
         ++index) {
        golden[index] =
            x[index] * y[index];
    }

    return static_cast<int32_t>(
        VerifyResult(output, golden));
}