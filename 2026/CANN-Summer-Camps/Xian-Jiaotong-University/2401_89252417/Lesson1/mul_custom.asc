// mul_custom.asc

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>

#include "acl/acl.h"
#include "kernel_operator.h"

constexpr uint32_t BUFFER_NUM = 2;  // Double Buffer

struct MulCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelMul {
public:
    __aicore__ inline KernelMul() {}

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        uint32_t totalLength,
        uint32_t tileNum)
    {
        this->totalLength = totalLength;
        this->tileNum = tileNum;
        this->tileLength = totalLength / tileNum;

        // 将输入、输出的GM地址封装为GlobalTensor
        xGm.SetGlobalBuffer((__gm__ float *)x, totalLength);
        yGm.SetGlobalBuffer((__gm__ float *)y, totalLength);
        zGm.SetGlobalBuffer((__gm__ float *)z, totalLength);

        // 为输入和输出队列申请Local Memory
        // 每个队列包含两个Tensor，实现Double Buffer
        pipe.InitBuffer(
            inQueueX,
            BUFFER_NUM,
            tileLength * sizeof(float));

        pipe.InitBuffer(
            inQueueY,
            BUFFER_NUM,
            tileLength * sizeof(float));

        pipe.InitBuffer(
            outQueueZ,
            BUFFER_NUM,
            tileLength * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        // 每次处理一个Tile
        for (int32_t progress = 0;
             progress < static_cast<int32_t>(tileNum);
             progress++) {
            CopyIn(progress);
            Compute(progress);
            CopyOut(progress);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        // 从输入队列申请LocalTensor
        AscendC::LocalTensor<float> xLocal =
            inQueueX.AllocTensor<float>();

        AscendC::LocalTensor<float> yLocal =
            inQueueY.AllocTensor<float>();

        uint32_t offset = progress * tileLength;

        // 将数据从Global Memory搬入Local Memory
        AscendC::DataCopy(
            xLocal,
            xGm[offset],
            tileLength);

        AscendC::DataCopy(
            yLocal,
            yGm[offset],
            tileLength);

        // 放入输入队列，供Compute阶段使用
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(int32_t progress)
    {
        // 从输入队列取出数据
        AscendC::LocalTensor<float> xLocal =
            inQueueX.DeQue<float>();

        AscendC::LocalTensor<float> yLocal =
            inQueueY.DeQue<float>();

        // 从输出队列申请结果Tensor
        AscendC::LocalTensor<float> zLocal =
            outQueueZ.AllocTensor<float>();

        // 执行逐元素乘法：z = x * y
        AscendC::Mul(
            zLocal,
            xLocal,
            yLocal,
            tileLength);

        // 将计算结果放入输出队列
        outQueueZ.EnQue(zLocal);

        // 释放输入Tensor
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int32_t progress)
    {
        // 从输出队列中取出计算结果
        AscendC::LocalTensor<float> zLocal =
            outQueueZ.DeQue<float>();

        uint32_t offset = progress * tileLength;

        // 将结果从Local Memory搬回Global Memory
        AscendC::DataCopy(
            zGm[offset],
            zLocal,
            tileLength);

        // 释放输出Tensor
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;

    // 输入和输出队列
    AscendC::TQue<AscendC::QuePosition::VECIN, BUFFER_NUM> inQueueX;
    AscendC::TQue<AscendC::QuePosition::VECIN, BUFFER_NUM> inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, BUFFER_NUM> outQueueZ;

    // Global Memory Tensor
    AscendC::GlobalTensor<float> xGm;
    AscendC::GlobalTensor<float> yGm;
    AscendC::GlobalTensor<float> zGm;

    uint32_t totalLength;
    uint32_t tileNum;
    uint32_t tileLength;
};

extern "C" __global__ __aicore__ void mul_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    MulCustomTilingData tiling)
{
    KernelMul op;
    op.Init(
        x,
        y,
        z,
        tiling.totalLength,
        tiling.tileNum);

    op.Process();
}

std::vector<float> kernel_mul(
    std::vector<float> &x,
    std::vector<float> &y)
{
    uint32_t totalLength = static_cast<uint32_t>(x.size());
    size_t dataSize = totalLength * sizeof(float);

    std::vector<float> output(totalLength, 0.0f);

    // 初始化ACL
    aclError ret = aclInit(nullptr);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclInit failed, error code: "
                  << ret << std::endl;
        return output;
    }

    constexpr int32_t deviceId = 0;

    ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtSetDevice failed, error code: "
                  << ret << std::endl;
        aclFinalize();
        return output;
    }

    aclrtStream stream = nullptr;
    ret = aclrtCreateStream(&stream);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtCreateStream failed, error code: "
                  << ret << std::endl;
        aclrtResetDevice(deviceId);
        aclFinalize();
        return output;
    }

    uint8_t *xDevice = nullptr;
    uint8_t *yDevice = nullptr;
    uint8_t *zDevice = nullptr;

    ret = aclrtMalloc(
        reinterpret_cast<void **>(&xDevice),
        dataSize,
        ACL_MEM_MALLOC_HUGE_FIRST);

    if (ret != ACL_SUCCESS) {
        std::cerr << "Allocate xDevice failed." << std::endl;
        aclrtDestroyStream(stream);
        aclrtResetDevice(deviceId);
        aclFinalize();
        return output;
    }

    ret = aclrtMalloc(
        reinterpret_cast<void **>(&yDevice),
        dataSize,
        ACL_MEM_MALLOC_HUGE_FIRST);

    if (ret != ACL_SUCCESS) {
        std::cerr << "Allocate yDevice failed." << std::endl;
        aclrtFree(xDevice);
        aclrtDestroyStream(stream);
        aclrtResetDevice(deviceId);
        aclFinalize();
        return output;
    }

    ret = aclrtMalloc(
        reinterpret_cast<void **>(&zDevice),
        dataSize,
        ACL_MEM_MALLOC_HUGE_FIRST);

    if (ret != ACL_SUCCESS) {
        std::cerr << "Allocate zDevice failed." << std::endl;
        aclrtFree(xDevice);
        aclrtFree(yDevice);
        aclrtDestroyStream(stream);
        aclrtResetDevice(deviceId);
        aclFinalize();
        return output;
    }

    // 将输入从Host复制到Device
    ret = aclrtMemcpy(
        xDevice,
        dataSize,
        x.data(),
        dataSize,
        ACL_MEMCPY_HOST_TO_DEVICE);

    if (ret != ACL_SUCCESS) {
        std::cerr << "Copy x to device failed." << std::endl;
    }

    ret = aclrtMemcpy(
        yDevice,
        dataSize,
        y.data(),
        dataSize,
        ACL_MEMCPY_HOST_TO_DEVICE);

    if (ret != ACL_SUCCESS) {
        std::cerr << "Copy y to device failed." << std::endl;
    }

    MulCustomTilingData tiling;
    tiling.totalLength = totalLength;

    // Shape为(8, 2048)，划分成8个Tile
    // 每个Tile处理2048个float
    tiling.tileNum = 8;

    constexpr uint32_t blockDim = 1;

    // 启动 Ascend C 核函数
    mul_custom<<<blockDim, nullptr, stream>>>(
        xDevice,
        yDevice,
        zDevice,
        tiling);

    // 等待核函数执行完成
    ret = aclrtSynchronizeStream(stream);
    if (ret != ACL_SUCCESS) {
        std::cerr << "Synchronize stream failed, error code: "
                  << ret << std::endl;
    }

    // 将结果从Device复制回Host
    ret = aclrtMemcpy(
        output.data(),
        dataSize,
        zDevice,
        dataSize,
        ACL_MEMCPY_DEVICE_TO_HOST);

    if (ret != ACL_SUCCESS) {
        std::cerr << "Copy result to host failed, error code: "
                  << ret << std::endl;
    }

    // 释放资源
    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFree(zDevice);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return output;
}

uint32_t VerifyResult(
    std::vector<float> &output,
    std::vector<float> &golden)
{
    auto printTensor = [](
        std::vector<float> &tensor,
        const char *name) {
        constexpr size_t maxPrintSize = 20;

        std::cout << name << ": ";

        std::copy(
            tensor.begin(),
            tensor.begin() +
                std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(
                std::cout,
                " "));

        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }

        std::cout << std::endl;
    };

    printTensor(output, "Output");
    printTensor(golden, "Golden");

    if (std::equal(
            golden.begin(),
            golden.end(),
            output.begin())) {
        std::cout
            << "[Success] Case accuracy is verification passed."
            << std::endl;
        return 0;
    } else {
        std::cout
            << "[Failed] Case accuracy is verification failed!"
            << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;

    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    // 调用自定义Ascend C乘法算子
    std::vector<float> output = kernel_mul(x, y);

    // 生成CPU侧正确结果
    std::vector<float> golden(
        totalLength,
        valueX * valueY);

    return VerifyResult(output, golden);
}