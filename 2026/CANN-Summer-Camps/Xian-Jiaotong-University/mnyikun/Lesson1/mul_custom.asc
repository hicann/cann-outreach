// mul_custom.asc

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

using namespace AscendC;

constexpr uint32_t BUFFER_NUM = 2;

struct MulCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelMul {
public:
    __aicore__ inline KernelMul(){}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {
        xGlobal.SetGlobalBuffer((__gm__ float*)x);
        yGlobal.SetGlobalBuffer((__gm__ float*)y);
        zGlobal.SetGlobalBuffer((__gm__ float*)z);

        this->totalLength = totalLength;
        this->tileNum = tileNum;
        this->maxTileLength = (totalLength + tileNum - 1) / tileNum;

        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->maxTileLength * sizeof(float));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->maxTileLength * sizeof(float));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->maxTileLength * sizeof(float));
    }
    __aicore__ inline void Process()
    {
        for (int32_t i = 0; i < tileNum; ++i) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        uint32_t offset = progress * maxTileLength;
        uint32_t currLength = (progress == tileNum - 1) ? (totalLength - offset) : maxTileLength;

        LocalTensor<float> xLocal = inQueueX.AllocTensor<float>();
        LocalTensor<float> yLocal = inQueueY.AllocTensor<float>();

        DataCopy(xLocal, xGlobal[offset], currLength);
        DataCopy(yLocal, yGlobal[offset], currLength);

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }
    __aicore__ inline void Compute(int32_t progress)
    {
        uint32_t offset = progress * maxTileLength;
        uint32_t currLength = (progress == tileNum - 1) ? (totalLength - offset) : maxTileLength;

        LocalTensor<float> xLocal = inQueueX.DeQue<float>();
        LocalTensor<float> yLocal = inQueueY.DeQue<float>();
        LocalTensor<float> zLocal = outQueueZ.AllocTensor<float>();

        Mul(zLocal, xLocal, yLocal, currLength);

        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
        outQueueZ.EnQue(zLocal);
    }
    __aicore__ inline void CopyOut(int32_t progress)
    {
        uint32_t offset = progress * maxTileLength;
        uint32_t currLength = (progress == tileNum - 1) ? (totalLength - offset) : maxTileLength;

        LocalTensor<float> zLocal = outQueueZ.DeQue<float>();
        DataCopy(zGlobal[offset], zLocal, currLength);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    GlobalTensor<float> xGlobal, yGlobal, zGlobal;
    TPipe pipe;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueX, inQueueY;
    TQue<QuePosition::VECOUT, BUFFER_NUM> outQueueZ;

    uint32_t totalLength;
    uint32_t tileNum;
    uint32_t maxTileLength;
};

// 关键修复1：添加 __aicore__ 标记，消除 "kernel type not marked" 警告
__global__ __aicore__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, MulCustomTilingData tiling)
{
    KernelMul op;
    op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    op.Process();
}

std::vector<float> kernel_mul(std::vector<float> &x, std::vector<float> &y)
{
    uint32_t totalLength = x.size();
    std::vector<float> output(totalLength);

    aclInit(nullptr);
    aclrtContext context;
    aclrtCreateContext(&context, 0);
    aclrtStream stream;
    aclrtCreateStream(&stream);

    void *xDevice, *yDevice, *zDevice;
    size_t size = totalLength * sizeof(float);

    aclrtMalloc(&xDevice, size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&yDevice, size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&zDevice, size, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(xDevice, size, x.data(), size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(yDevice, size, y.data(), size, ACL_MEMCPY_HOST_TO_DEVICE);

    constexpr uint32_t tileLength = 256;
    uint32_t tileNum = (totalLength + tileLength - 1) / tileLength;
    MulCustomTilingData tiling = {totalLength, tileNum};

    // 关键修复2：恢复 (GM_ADDR) 强制转换，保证类型匹配
    mul_custom<<<1, nullptr, stream>>>((GM_ADDR)xDevice, (GM_ADDR)yDevice, (GM_ADDR)zDevice, tiling);

    aclrtSynchronizeStream(stream);

    aclrtMemcpy(output.data(), size, zDevice, size, ACL_MEMCPY_DEVICE_TO_HOST);

    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFree(zDevice);
    aclrtDestroyStream(stream);
    aclrtDestroyContext(context);
    aclFinalize();

    return output;
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
    return 0;
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    std::vector<float> output = kernel_mul(x, y);

    std::vector<float> golden(totalLength, valueX * valueY);
    return VerifyResult(output, golden);
}