// mul_custom.asc

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

constexpr uint32_t BUFFER_NUM = 2; // tensor num for each queue

struct MulCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelMul {
public:
    __aicore__ inline KernelMul(){}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {
        this->totalLength = totalLength;
        this->tileNum = tileNum;
        tileLength = totalLength / tileNum;

        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(x), totalLength);
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), totalLength);
        zGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(z), totalLength);

        xLm.Init(tileLength * BUFFER_NUM);
        yLm.Init(tileLength * BUFFER_NUM);
        zLm.Init(tileLength * BUFFER_NUM);

        pipe.InitBuffer(xLm, yLm, zLm);
    }

    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < tileNum; ++i) {
            CopyIn(i);    
            Compute(i);   
            CopyOut(i);   
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        uint32_t offset = progress * tileLength;

        xGm.DataCopy(xLm, offset, tileLength, progress % BUFFER_NUM);
        yGm.DataCopy(yLm, offset, tileLength, progress % BUFFER_NUM);
    }

    __aicore__ inline void Compute(int32_t progress)
    {
        uint32_t bufIdx = progress % BUFFER_NUM;
        uint32_t base = bufIdx * tileLength;

        uint32_t i = 0;
        for (; i + 256 <= tileLength; i += 256) {
            auto xv = xLm.Load(base + i, 256);
            auto yv = yLm.Load(base + i, 256);
            auto zv = xv * yv; 
            zLm.Store(base + i, zv, 256);
        }
        if (i < tileLength) {
            uint32_t remain = tileLength - i;
            auto xv = xLm.Load(base + i, remain);
            auto yv = yLm.Load(base + i, remain);
            auto zv = xv * yv;
            zLm.Store(base + i, zv, remain);
        }
    }

    __aicore__ inline void CopyOut(int32_t progress)
    {
        uint32_t offset = progress * tileLength;
        zLm.DataCopy(zGm, offset, tileLength, progress % BUFFER_NUM);
    }

private:
    GlobalTensor<float> xGm;   
    GlobalTensor<float> yGm;   
    GlobalTensor<float> zGm;  

    LocalTensor<float> xLm;    
    LocalTensor<float> yLm;   
    LocalTensor<float> zLm;    

    TPipe pipe;  

    uint32_t totalLength;  
    uint32_t tileLength;   
    uint32_t tileNum;      
};

__global__ __aicore__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, MulCustomTilingData tiling)
{
    KernelMul op;
    op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    op.Process();
}

std::vector<float> kernel_mul(std::vector<float> &x, std::vector<float> &y)
{
    uint32_t totalLength = x.size();
    std::vector<float> output(totalLength);

    uint32_t tileLength = 2048;
    uint32_t tileNum = (totalLength + tileLength - 1) / tileLength; 

    MulCustomTilingData tiling;
    tiling.totalLength = totalLength;
    tiling.tileNum = tileNum;

    void *xDev = nullptr;
    void *yDev = nullptr;
    void *zDev = nullptr;

    aclrtMalloc(&xDev, totalLength * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&yDev, totalLength * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&zDev, totalLength * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(xDev, totalLength * sizeof(float), x.data(),
                totalLength * sizeof(float), ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(yDev, totalLength * sizeof(float), y.data(),
                totalLength * sizeof(float), ACL_MEMCPY_HOST_TO_DEVICE);

    aclrtLaunchKernel(
        reinterpret_cast<void*>(mul_custom),  
        1,    
        1,    
        nullptr,  
        0,    
        nullptr,  
        xDev, yDev, zDev, tiling  
    );

    aclrtSynchronizeStream(nullptr);

    aclrtMemcpy(output.data(), totalLength * sizeof(float), zDev,
                totalLength * sizeof(float), ACL_MEMCPY_DEVICE_TO_HOST);

    aclrtFree(xDev);
    aclrtFree(yDev);
    aclrtFree(zDev);

    return output;
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
    return 0;
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;  // 16384个元素
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    std::vector<float> output = kernel_mul(x, y);

    std::vector<float> golden(totalLength, valueX * valueY);
    return VerifyResult(output, golden);
}