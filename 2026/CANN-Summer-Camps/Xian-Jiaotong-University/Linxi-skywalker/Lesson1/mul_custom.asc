// mul_custom.asc

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

constexpr uint32_t BUFFER_NUM = 2; // tensor num for each queue

struct MulCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelMul {
public:
    __aicore__ inline KernelMul(){}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {
        // 请补充……
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(x), totalLength);
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), totalLength);
        zGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(z), totalLength);
        this->totalLength = totalLength;
        this->tileNum = tileNum;
        uint32_t maxTileLength = (totalLength + tileNum - 1) / tileNum;
        pipe.InitBuffer(queInX, BUFFER_NUM, maxTileLength * sizeof(float));
        pipe.InitBuffer(queInY, BUFFER_NUM, maxTileLength * sizeof(float));
        pipe.InitBuffer(queOutZ, BUFFER_NUM, maxTileLength * sizeof(float));
    }
    __aicore__ inline void Process()
    {
        // 请补充……
        for (int32_t i = 0; i < tileNum; ++i) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        // 请补充……

        uint32_t offset, length;
        GetTileParams(progress, offset, length);
        AscendC::LocalTensor<float> xLocal = queInX.AllocTensor<float>();
        AscendC::LocalTensor<float> yLocal = queInY.AllocTensor<float>();
        AscendC::DataCopy(xLocal, xGm[offset], length);
        AscendC::DataCopy(yLocal, yGm[offset], length);
        queInX.EnQue(xLocal);
        queInY.EnQue(yLocal);
    }
    __aicore__ inline void Compute(int32_t progress)
    {
        // 请补充……
        uint32_t offset, length;
        GetTileParams(progress, offset, length);
        AscendC::LocalTensor<float> xLocal = queInX.DeQue<float>();
        AscendC::LocalTensor<float> yLocal = queInY.DeQue<float>();
        AscendC::LocalTensor<float> zLocal = queOutZ.AllocTensor<float>();
        AscendC::Mul(zLocal, xLocal, yLocal, length);
        queInX.FreeTensor(xLocal);
        queInY.FreeTensor(yLocal);
        queOutZ.EnQue(zLocal);
    }
    __aicore__ inline void CopyOut(int32_t progress)
    {
        // 请补充……
        uint32_t offset, length;
        GetTileParams(progress, offset, length);
        AscendC::LocalTensor<float> zLocal = queOutZ.DeQue<float>();
        AscendC::DataCopy(zGm[offset], zLocal, length);
        queOutZ.FreeTensor(zLocal);
    }

private:
    // 请补充……
    AscendC::GlobalTensor<float> xGm, yGm, zGm;
    AscendC::TQue<AscendC::QuePosition::VECIN, BUFFER_NUM> queInX, queInY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, BUFFER_NUM> queOutZ;
    AscendC::TPipe pipe;
    uint32_t totalLength;
    uint32_t tileNum;
    
    __aicore__ inline void GetTileParams(int32_t progress, uint32_t &offset, uint32_t &length) {
        uint32_t avgTileLength = totalLength / tileNum;
        offset = progress * avgTileLength;
        length = (progress == tileNum - 1) ? (totalLength - offset) : avgTileLength;
    }
};

__global__ __aicore__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, MulCustomTilingData tiling)
{
    // 请补充……
    KernelMul op;
    op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    op.Process();
}

std::vector<float> kernel_mul(std::vector<float> &x, std::vector<float> &y)
{
    // 请补充……
    uint32_t totalLength = x.size();
    size_t bytes = totalLength * sizeof(float);

    int32_t devId = 0;
    aclrtContext ctx;
    aclrtSetDevice(devId);
    aclrtCreateContext(&ctx, devId);
    aclrtStream stream;
    aclrtCreateStream(&stream);

    void *dX, *dY, *dZ;
    aclrtMalloc(&dX, bytes, ACL_MEM_MALLOC_NORMAL_ONLY);
    aclrtMalloc(&dY, bytes, ACL_MEM_MALLOC_NORMAL_ONLY);
    aclrtMalloc(&dZ, bytes, ACL_MEM_MALLOC_NORMAL_ONLY);
    aclrtMemcpy(dX, bytes, x.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dY, bytes, y.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE);

    MulCustomTilingData tiling;
    tiling.totalLength = totalLength;
    constexpr uint32_t FIXED_TILE_ELEM = 2048;         
    tiling.tileNum = (totalLength + FIXED_TILE_ELEM - 1) / FIXED_TILE_ELEM;

    uint8_t* devX_addr = reinterpret_cast<uint8_t*>(dX);
    uint8_t* devY_addr = reinterpret_cast<uint8_t*>(dY);
    uint8_t* devZ_addr = reinterpret_cast<uint8_t*>(dZ);
    mul_custom<<<1, nullptr, stream>>>(devX_addr, devY_addr, devZ_addr, tiling);  
    aclrtSynchronizeStream(stream);

    std::vector<float> output(totalLength);
    aclrtMemcpy(output.data(), bytes, dZ, bytes, ACL_MEMCPY_DEVICE_TO_HOST);

    aclrtFree(dX);
    aclrtFree(dY);
    aclrtFree(dZ);
    aclrtDestroyStream(stream);
    aclrtDestroyContext(ctx);
    aclrtResetDevice(devId);

    return output;
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
    return 0;
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    // 请补充……
    std::vector<float> output = kernel_mul(x, y);

    std::vector<float> golden(totalLength, valueX * valueY);
    return VerifyResult(output, golden);
}