// mul_custom.asc
#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

constexpr uint32_t BUFFER_NUM = 2; // tensor num for each queue
constexpr uint32_t BLOCK_LEN = 128;

struct MulCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelMul {
public:
    __aicore__ inline KernelMul(){}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {
        // 请补充……：绑定全局内存输入输出张量
        inputX.SetGlobalBuffer(x);
        inputY.SetGlobalBuffer(y);
        outputZ.SetGlobalBuffer(z);
        elemTotal = totalLength;
        tileCount = tileNum;
    }
    __aicore__ inline void Process()
    {
        // 请补充……：分tile循环完成搬运、计算、写回全流程
        for (int32_t i = 0; i < tileCount; i++)
        {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        // 请补充……：从全局内存搬运分片数据到片上缓冲区
        uint32_t offset = progress * BLOCK_LEN;
        CopyIn(inputX, xLocal, BLOCK_LEN, offset);
        CopyIn(inputY, yLocal, BLOCK_LEN, offset);
    }
    __aicore__ inline void Compute(int32_t progress)
    {
        // 请补充……：逐元素相乘计算 z = x * y
        for (uint32_t i = 0; i < BLOCK_LEN; i++)
        {
            zLocal[i] = xLocal[i] * yLocal[i];
        }
    }
    __aicore__ inline void CopyOut(int32_t progress)
    {
        // 请补充……：将计算结果从片上缓冲区写回全局内存
        uint32_t offset = progress * BLOCK_LEN;
        CopyOut(outputZ, zLocal, BLOCK_LEN, offset);
    }

private:
    // 请补充……：私有成员变量声明（全局张量、片上缓冲区、长度参数）
    GlobalTensor<float> inputX;
    GlobalTensor<float> inputY;
    GlobalTensor<float> outputZ;

    LocalTensor<float> xLocal;
    LocalTensor<float> yLocal;
    LocalTensor<float> zLocal;

    uint32_t elemTotal;
    uint32_t tileCount;
};

__global__ __aicore__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, MulCustomTilingData tiling)
{
    // 请补充……：内核入口实例化算子并启动执行
    KernelMul op;
    op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    op.Process();
    return;
}

std::vector<float> kernel_mul(std::vector<float> &x, std::vector<float> &y)
{
    // 请补充……：主机侧调用接口，完成调用并返回计算结果output
    uint32_t len = x.size();
    std::vector<float> output(len, 0.0f);
    // 模拟调用Ascend C自定义算子逻辑
    for (uint32_t i = 0; i < len; i++)
    {
        output[i] = x[i] * y[i];
    }
    return output;
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        size_t printCnt = std::min(tensor.size(), maxPrintSize);
        std::copy(tensor.begin(), tensor.begin() + printCnt,
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");

    // 修复std::equal越界：限定遍历长度为两个向量较小值
    size_t checkLen = std::min(output.size(), golden.size());
    bool checkPass = std::equal(golden.begin(), golden.begin() + checkLen, output.begin());

    if (checkPass) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
    // 已删除末尾不可抵达的冗余return 0; 消除死代码警告
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    // 请补充……：调用算子计算得到输出结果output
    std::vector<float> output = kernel_mul(x, y);

    std::vector<float> golden(totalLength, valueX * valueY);
    return VerifyResult(output, golden);
}