// mul_custom.asc

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

using namespace AscendC;

constexpr uint32_t BUFFER_NUM = 2; // tensor num for each queue
constexpr uint32_t USE_CORE_NUM = 8;

struct MulCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelMul {
public:
    __aicore__ inline KernelMul(){}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {
        this->blockLength = totalLength / USE_CORE_NUM;
        this->tileNum = tileNum;
        this->tileLength = this->blockLength / this->tileNum / BUFFER_NUM;

        uint32_t blockOffset = this->blockLength * GetBlockIdx();

        xGm.SetGlobalBuffer((__gm__ float *)x + blockOffset, this->blockLength);
        yGm.SetGlobalBuffer((__gm__ float *)y + blockOffset, this->blockLength);
        zGm.SetGlobalBuffer((__gm__ float *)z + blockOffset, this->blockLength);

        pipe.InitBuffer(queInX, BUFFER_NUM, this->tileLength * sizeof(float));
        pipe.InitBuffer(queInY, BUFFER_NUM, this->tileLength * sizeof(float));
        pipe.InitBuffer(queOutZ, BUFFER_NUM, this->tileLength * sizeof(float));
    }
    __aicore__ inline void Process()
    {
        uint32_t loopCount = this->tileNum * BUFFER_NUM;
        for (uint32_t i = 0; i < loopCount; ++i) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        LocalTensor<float> xLocal = queInX.AllocTensor<float>();
        LocalTensor<float> yLocal = queInY.AllocTensor<float>();

        DataCopy(xLocal, xGm[progress * this->tileLength], this->tileLength);
        DataCopy(yLocal, yGm[progress * this->tileLength], this->tileLength);

        queInX.EnQue(xLocal);
        queInY.EnQue(yLocal);
    }
    __aicore__ inline void Compute(int32_t progress)
    {
        LocalTensor<float> xLocal = queInX.DeQue<float>();
        LocalTensor<float> yLocal = queInY.DeQue<float>();
        LocalTensor<float> zLocal = queOutZ.AllocTensor<float>();

        Mul(zLocal, xLocal, yLocal, this->tileLength);

        queOutZ.EnQue<float>(zLocal);
        queInX.FreeTensor(xLocal);
        queInY.FreeTensor(yLocal);
    }
    __aicore__ inline void CopyOut(int32_t progress)
    {
        LocalTensor<float> zLocal = queOutZ.DeQue<float>();

        DataCopy(zGm[progress * this->tileLength], zLocal, this->tileLength);

        queOutZ.FreeTensor(zLocal);
    }

private:
    TPipe pipe;
    TQue<QuePosition::VECIN, BUFFER_NUM> queInX;
    TQue<QuePosition::VECIN, BUFFER_NUM> queInY;
    TQue<QuePosition::VECOUT, BUFFER_NUM> queOutZ;

    GlobalTensor<float> xGm;
    GlobalTensor<float> yGm;
    GlobalTensor<float> zGm;

    uint32_t blockLength;
    uint32_t tileNum;
    uint32_t tileLength;
};

__global__ __aicore__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, MulCustomTilingData tiling)
{
    KernelMul op;
    op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    op.Process();
}

#define CHECK_RET(cond, return_expr) \
    do {                             \
        if (!(cond)) {               \
            return_expr;             \
        }                            \
    } while (0)

#define LOG_PRINT(message, ...)         \
    do {                                \
        printf(message, ##__VA_ARGS__); \
    } while (0)

std::vector<float> kernel_mul(std::vector<float> &x, std::vector<float> &y)
{
    uint32_t totalLength = static_cast<uint32_t>(x.size());
    uint32_t dataSize = totalLength * sizeof(float);

    std::vector<float> output(totalLength, 0.0f);

    aclError ret;
    aclrtStream stream = nullptr;
    uint8_t *xDevice = nullptr;
    uint8_t *yDevice = nullptr;
    uint8_t *zDevice = nullptr;

    ret = aclInit(nullptr);
    CHECK_RET(ret == ACL_SUCCESS, LOG_PRINT("aclInit failed. ERROR: %d\n", ret); return std::vector<float>());

    ret = aclrtSetDevice(0);
    CHECK_RET(ret == ACL_SUCCESS, LOG_PRINT("aclrtSetDevice failed. ERROR: %d\n", ret); goto cleanup_init);

    ret = aclrtCreateStream(&stream);
    CHECK_RET(ret == ACL_SUCCESS, LOG_PRINT("aclrtCreateStream failed. ERROR: %d\n", ret); goto cleanup_device);

    ret = aclrtMalloc(reinterpret_cast<void **>(&xDevice), dataSize, ACL_MEM_MALLOC_HUGE_FIRST);
    CHECK_RET(ret == ACL_SUCCESS, LOG_PRINT("aclrtMalloc xDevice failed. ERROR: %d\n", ret); goto cleanup_stream);

    ret = aclrtMalloc(reinterpret_cast<void **>(&yDevice), dataSize, ACL_MEM_MALLOC_HUGE_FIRST);
    CHECK_RET(ret == ACL_SUCCESS, LOG_PRINT("aclrtMalloc yDevice failed. ERROR: %d\n", ret); goto cleanup_x);

    ret = aclrtMalloc(reinterpret_cast<void **>(&zDevice), dataSize, ACL_MEM_MALLOC_HUGE_FIRST);
    CHECK_RET(ret == ACL_SUCCESS, LOG_PRINT("aclrtMalloc zDevice failed. ERROR: %d\n", ret); goto cleanup_y);

    ret = aclrtMemcpy(xDevice, dataSize, x.data(), dataSize, ACL_MEMCPY_HOST_TO_DEVICE);
    CHECK_RET(ret == ACL_SUCCESS, LOG_PRINT("aclrtMemcpy x to device failed. ERROR: %d\n", ret); goto cleanup_z);

    ret = aclrtMemcpy(yDevice, dataSize, y.data(), dataSize, ACL_MEMCPY_HOST_TO_DEVICE);
    CHECK_RET(ret == ACL_SUCCESS, LOG_PRINT("aclrtMemcpy y to device failed. ERROR: %d\n", ret); goto cleanup_z);

    MulCustomTilingData tiling;
    tiling.totalLength = totalLength;
    tiling.tileNum = 8;

    mul_custom<<<USE_CORE_NUM, nullptr, stream>>>(xDevice, yDevice, zDevice, tiling);

    ret = aclrtSynchronizeStream(stream);
    CHECK_RET(ret == ACL_SUCCESS, LOG_PRINT("aclrtSynchronizeStream failed. ERROR: %d\n", ret); goto cleanup_z);

    ret = aclrtMemcpy(output.data(), dataSize, zDevice, dataSize, ACL_MEMCPY_DEVICE_TO_HOST);
    CHECK_RET(ret == ACL_SUCCESS, LOG_PRINT("aclrtMemcpy output to host failed. ERROR: %d\n", ret); goto cleanup_z);

    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFree(zDevice);

    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();

    return output;

cleanup_z:
    aclrtFree(zDevice);
cleanup_y:
    aclrtFree(yDevice);
cleanup_x:
    aclrtFree(xDevice);
cleanup_stream:
    aclrtDestroyStream(stream);
cleanup_device:
    aclrtResetDevice(0);
cleanup_init:
    aclFinalize();
    return std::vector<float>();
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
    return 0;
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    std::vector<float> output = kernel_mul(x, y);

    std::vector<float> golden(totalLength, valueX * valueY);
    return VerifyResult(output, golden);
}
