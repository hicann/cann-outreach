// mul_custom.asc
#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include <cmath>
#include "acl/acl.h"
#include "kernel_operator.h"

using namespace AscendC;

__global__ __vector__ void mul_custom(__gm__ uint8_t* x, __gm__ uint8_t* y, __gm__ uint8_t* z, uint32_t totalLength)
{
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueX;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueZ;
    AscendC::GlobalTensor<float> xGm, yGm, zGm;

    uint32_t blockLength = totalLength / AscendC::GetBlockNum();
    uint32_t coreIdx = AscendC::GetBlockIdx();
    xGm.SetGlobalBuffer((__gm__ float*)x + blockLength * coreIdx, blockLength);
    yGm.SetGlobalBuffer((__gm__ float*)y + blockLength * coreIdx, blockLength);
    zGm.SetGlobalBuffer((__gm__ float*)z + blockLength * coreIdx, blockLength);

    pipe.InitBuffer(inQueueX, 1, blockLength * sizeof(float));
    pipe.InitBuffer(inQueueY, 1, blockLength * sizeof(float));
    pipe.InitBuffer(outQueueZ, 1, blockLength * sizeof(float));

    // CopyIn: GM -> UB
    AscendC::LocalTensor<float> xLocal = inQueueX.AllocTensor<float>();
    AscendC::LocalTensor<float> yLocal = inQueueY.AllocTensor<float>();
    AscendC::DataCopy(xLocal, xGm, blockLength);
    AscendC::DataCopy(yLocal, yGm, blockLength);
    inQueueX.EnQue(xLocal);
    inQueueY.EnQue(yLocal);

    // Compute: z = x * y
    xLocal = inQueueX.DeQue<float>();
    yLocal = inQueueY.DeQue<float>();
    AscendC::LocalTensor<float> zLocal = outQueueZ.AllocTensor<float>();
    AscendC::Mul(zLocal, xLocal, yLocal, blockLength);
    outQueueZ.EnQue<float>(zLocal);
    inQueueX.FreeTensor(xLocal);
    inQueueY.FreeTensor(yLocal);

    // CopyOut: UB -> GM
    zLocal = outQueueZ.DeQue<float>();
    AscendC::DataCopy(zGm, zLocal, blockLength);
    outQueueZ.FreeTensor(zLocal);
}

// 主机端验证函数
uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");

    bool match = true;
    for (size_t i = 0; i < output.size(); i++) {
        if (std::abs(output[i] - golden[i]) > 1e-6f) {
            match = false;
            break;
        }
    }

    if (match) {
        std::cout << "[Success] Case accuracy verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy verification failed!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    uint32_t numBlocks = 8;
    size_t ByteSize = totalLength * sizeof(float);

    std::cout << "=== Mul Custom Test ===" << std::endl;
    std::cout << "Shape: (8, 2048), totalLength: " << totalLength << std::endl;

    // 初始化 ACL
    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    // 分配 Host 内存
    uint8_t* xHost = nullptr;
    uint8_t* yHost = nullptr;
    uint8_t* zHost = nullptr;
    aclrtMallocHost((void**)(&xHost), ByteSize);
    aclrtMallocHost((void**)(&yHost), ByteSize);
    aclrtMallocHost((void**)(&zHost), ByteSize);

    // 初始化输入数据
    float* xData = reinterpret_cast<float*>(xHost);
    float* yData = reinterpret_cast<float*>(yHost);
    for (uint32_t i = 0; i < totalLength; i++) {
        xData[i] = valueX;
        yData[i] = valueY;
    }

    // 分配 Device 内存
    uint8_t* xDevice = nullptr;
    uint8_t* yDevice = nullptr;
    uint8_t* zDevice = nullptr;
    aclrtMalloc((void**)&xDevice, ByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDevice, ByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&zDevice, ByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    // Host -> Device
    aclrtMemcpy(xDevice, ByteSize, xHost, ByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(yDevice, ByteSize, yHost, ByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    // Launch kernel
    mul_custom<<<numBlocks, 0, stream>>>(xDevice, yDevice, zDevice, totalLength);
    aclrtSynchronizeStream(stream);

    // Device -> Host
    aclrtMemcpy(zHost, ByteSize, zDevice, ByteSize, ACL_MEMCPY_DEVICE_TO_HOST);

    // 计算 Golden
    std::vector<float> golden(totalLength, valueX * valueY);
    std::vector<float> output(reinterpret_cast<float*>(zHost), reinterpret_cast<float*>(zHost) + totalLength);

    std::cout << "Input X value: " << valueX << std::endl;
    std::cout << "Input Y value: " << valueY << std::endl;
    std::cout << "Expected result: " << valueX * valueY << std::endl;
    std::cout << "========================" << std::endl;

    // 验证结果
    uint32_t ret = VerifyResult(output, golden);

    // 释放资源
    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(yHost);
    aclrtFreeHost(zHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return ret;
}
