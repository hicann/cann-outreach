// mul_custom.asc

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

constexpr uint32_t BUFFER_NUM = 2; // tensor num for each queue

struct MulCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelMul {
public:
    __aicore__ inline KernelMul(){}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {
        uint32_t blockNum = AscendC::GetBlockNum();
        uint32_t blockIdx = AscendC::GetBlockIdx();
        uint32_t baseLen  = totalLength / blockNum;
        uint32_t remain   = totalLength % blockNum;
        this->blockLength = baseLen + (blockIdx < remain ? 1 : 0);
        uint32_t offset   = blockIdx * baseLen + (blockIdx < remain ? blockIdx : remain);

        this->tileNum     = tileNum;
        this->tileLength  = this->blockLength / tileNum / BUFFER_NUM;

        uint32_t totalTiles = tileNum * BUFFER_NUM;
        this->lastTileLen  = this->blockLength - this->tileLength * (totalTiles - 1);

        xGm.SetGlobalBuffer((__gm__ float *)x + offset, this->blockLength);
        yGm.SetGlobalBuffer((__gm__ float *)y + offset, this->blockLength);
        zGm.SetGlobalBuffer((__gm__ float *)z + offset, this->blockLength);

        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->lastTileLen * sizeof(float));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->lastTileLen * sizeof(float));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->lastTileLen * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        int32_t loopCount = this->tileNum * BUFFER_NUM;
        for (int32_t i = 0; i < loopCount; i++) {
            uint32_t curLen = (i == loopCount - 1) ? this->lastTileLen : this->tileLength;
            CopyIn(i, curLen);
            Compute(i, curLen);
            CopyOut(i, curLen);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress, uint32_t length)
    {
        AscendC::LocalTensor<float> localX = inQueueX.AllocTensor<float>();
        AscendC::LocalTensor<float> localY = inQueueY.AllocTensor<float>();

        AscendC::DataCopy(localX, xGm[progress * this->tileLength], length);
        AscendC::DataCopy(localY, yGm[progress * this->tileLength], length);

        inQueueX.EnQue(localX);
        inQueueY.EnQue(localY);
    }

    __aicore__ inline void Compute(int32_t progress, uint32_t length)
    {
        (void)progress;
        AscendC::LocalTensor<float> localX = inQueueX.DeQue<float>();
        AscendC::LocalTensor<float> localY = inQueueY.DeQue<float>();
        AscendC::LocalTensor<float> localZ = outQueueZ.AllocTensor<float>();

        AscendC::Mul(localZ, localX, localY, length);

        outQueueZ.EnQue(localZ);
        inQueueX.FreeTensor(localX);
        inQueueY.FreeTensor(localY);
    }

    __aicore__ inline void CopyOut(int32_t progress, uint32_t length)
    {
        AscendC::LocalTensor<float> localZ = outQueueZ.DeQue<float>();

        AscendC::DataCopy(zGm[progress * this->tileLength], localZ, length);

        outQueueZ.FreeTensor(localZ);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, BUFFER_NUM> inQueueX;
    AscendC::TQue<AscendC::QuePosition::VECIN, BUFFER_NUM> inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, BUFFER_NUM> outQueueZ;
    AscendC::GlobalTensor<float> xGm;
    AscendC::GlobalTensor<float> yGm;
    AscendC::GlobalTensor<float> zGm;
    uint32_t blockLength;
    uint32_t tileNum;
    uint32_t tileLength;
    uint32_t lastTileLen;
};

__global__ __aicore__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, MulCustomTilingData tiling)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    KernelMul op;
    op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    op.Process();
}

std::vector<float> kernel_mul(std::vector<float> &x, std::vector<float> &y)
{
    if (x.size() != y.size() || x.size() > UINT32_MAX) {
        return std::vector<float>();
    }
    uint32_t totalLength = static_cast<uint32_t>(x.size());
    constexpr uint32_t tileNum = 8;
    MulCustomTilingData tiling{totalLength, tileNum};

    std::vector<float> z(totalLength, 0.0f);
    size_t byteSize = static_cast<size_t>(totalLength) * sizeof(float);

    int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    uint8_t *xDev = nullptr, *yDev = nullptr, *zDev = nullptr;

    auto fail = [&](const char *msg) {
        std::cerr << msg << std::endl;
        if (xDev) aclrtFree(xDev);
        if (yDev) aclrtFree(yDev);
        if (zDev) aclrtFree(zDev);
        if (stream) aclrtDestroyStream(stream);
        aclrtResetDevice(deviceId);
        aclFinalize();
        return std::vector<float>();
    };

    if (aclInit(nullptr) != ACL_SUCCESS) return fail("aclInit failed");
    if (aclrtSetDevice(deviceId) != ACL_SUCCESS) return fail("aclrtSetDevice failed");
    if (aclrtCreateStream(&stream) != ACL_SUCCESS) return fail("aclrtCreateStream failed");

    if (aclrtMalloc(reinterpret_cast<void**>(&xDev), byteSize, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return fail("aclrtMalloc x failed");
    if (aclrtMalloc(reinterpret_cast<void**>(&yDev), byteSize, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return fail("aclrtMalloc y failed");
    if (aclrtMalloc(reinterpret_cast<void**>(&zDev), byteSize, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return fail("aclrtMalloc z failed");

    if (aclrtMemcpy(xDev, byteSize, x.data(), byteSize, ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) return fail("aclrtMemcpy x failed");
    if (aclrtMemcpy(yDev, byteSize, y.data(), byteSize, ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) return fail("aclrtMemcpy y failed");

    constexpr uint32_t blockDim = 8;
    mul_custom<<<blockDim, nullptr, stream>>>(xDev, yDev, zDev, tiling);
    if (aclrtSynchronizeStream(stream) != ACL_SUCCESS) return fail("aclrtSynchronizeStream failed");

    if (aclrtMemcpy(z.data(), byteSize, zDev, byteSize, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) return fail("aclrtMemcpy z failed");

    aclrtFree(xDev);
    aclrtFree(yDev);
    aclrtFree(zDev);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return z;
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (output.size() != golden.size()) {
        std::cout << "[Failed] Size mismatch: output=" << output.size()
                  << " golden=" << golden.size() << std::endl;
        return 1;
    }
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    std::vector<float> output = kernel_mul(x, y);

    std::vector<float> golden(totalLength, valueX * valueY);
    return VerifyResult(output, golden);
}
