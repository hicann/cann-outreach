// mul_custom.asc
#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "kernel_tensor.h"   // 引入Tensor对应头文件

using namespace AscendC;      // 解决GlobalTensor、LocalTensor找不到的问题

constexpr uint32_t BUFFER_NUM = 2; // tensor num for each queue

struct MulCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelMul {
public:
    __aicore__ inline KernelMul(){}
    __aicore__ inline void Init (GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {
        // 绑定全局内存（DDR 显存）的输入输出地址与总长度
        xGm.SetGlobalBuffer ((__gm__ float*)x, totalLength);
        yGm.SetGlobalBuffer((__gm__ float*)y, totalLength);
        zGm.SetGlobalBuffer((__gm__ float*)z, totalLength);

        // 初始化切分参数，计算单个块的元素个数
        // 防护：tileNum 为 0 时默认设为 1，避免除零
        this->tileNum = (tileNum == 0) ? 1 : tileNum;
        this->totalLength = totalLength;
        this->tileSize = totalLength / this->tileNum;
        // 最后一块的实际大小，处理非整除时的尾部数据，避免丢失
        this->lastTileSize = totalLength - this->tileSize * (this->tileNum - 1);
    }

    __aicore__ inline void Process ()
    {
        // 双缓冲（乒乓）流水线：先预取第 0 块数据到片上缓存
        CopyIn (0);
        // 循环处理：搬运下一块数据 与 计算当前块 并行执行，隐藏搬运延迟
        for (int32_t i = 1; i < tileNum; ++i) {
            CopyIn (i);    // 预取下一块输入（用另一个缓存槽）
            Compute (i-1); // 计算上一块数据
            CopyOut (i-1); // 把上一块结果写回全局内存
        }
        // 处理最后一块的计算和输出
        Compute (tileNum - 1);
        CopyOut (tileNum - 1);
    }

private:
    __aicore__ inline void CopyIn (int32_t progress)
    {
        // 切换双缓冲槽位（0/1 交替）
        int32_t bufIdx = progress % BUFFER_NUM;
        // 计算当前块在全局内存的起始偏移
        uint32_t offset = progress * tileSize;
        // 最后一块使用实际剩余长度，避免尾部数据丢失
        uint32_t curSize = (progress == tileNum - 1) ? lastTileSize : tileSize;
        // 把两个输入的当前块，从全局内存搬到片上高速缓存
        DataCopy (xLocal [bufIdx], xGm [offset], curSize);
        DataCopy (yLocal [bufIdx], yGm [offset], curSize);
    }

    __aicore__ inline void Compute (int32_t progress)
    {
        int32_t bufIdx = progress % BUFFER_NUM;
        // 最后一块使用实际剩余长度
        uint32_t curSize = (progress == tileNum - 1) ? lastTileSize : tileSize;
        // Ascend C 硬件矢量乘法指令：逐元素相乘，一次性计算一整块
        Mul (zLocal [bufIdx], xLocal [bufIdx], yLocal [bufIdx], curSize);
    }

    __aicore__ inline void CopyOut (int32_t progress)
    {
        int32_t bufIdx = progress % BUFFER_NUM;
        uint32_t offset = progress * tileSize;
        // 最后一块使用实际剩余长度
        uint32_t curSize = (progress == tileNum - 1) ? lastTileSize : tileSize;
        // 把计算结果从片上缓存搬回全局内存
        DataCopy (zGm [offset], zLocal [bufIdx], curSize);
    }

private:
    // 全局内存张量（对应 NPU 的 DDR 显存，容量大、速度慢）
    GlobalTensor<float> xGm;
    GlobalTensor<float> yGm;
    GlobalTensor<float> zGm;

    // 本地缓存张量（对应 NPU 的片上 UB 内存，容量小、速度极快，双缓冲数组）
    LocalTensor<float> xLocal[BUFFER_NUM];
    LocalTensor<float> yLocal[BUFFER_NUM];
    LocalTensor<float> zLocal[BUFFER_NUM];

    uint32_t totalLength; // 总元素个数
    uint32_t tileNum;     // 数据切分的总块数
    uint32_t tileSize;    // 单个块包含的元素个数
    uint32_t lastTileSize;// 最后一块的实际元素个数（处理非整除边界）
};

__global__ __aicore__ void mul_custom (GM_ADDR x, GM_ADDR y, GM_ADDR z, MulCustomTilingData tiling)
{
    // 算子入口：创建内核对象、初始化、执行计算流水线
    KernelMul kernel;
    kernel.Init (x, y, z, tiling.totalLength, tiling.tileNum);
    kernel.Process ();
}

//------------------------------
// Host 侧 CPU 验证代码（无 CANN 也可运行，验证逻辑正确性）
//------------------------------
std::vector<float> kernel_mul(std::vector<float> &x, std::vector<float> &y)
{
    // 本地 CPU 模拟算子逻辑，逐元素相乘
    std::vector<float> output(x.size());
    for (size_t i = 0; i < x.size(); ++i) {
        output[i] = x[i] * y[i];
    }
    return output;
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
                  std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
}

int main(int argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    // 调用算子（本地为 CPU 模拟，真实 NPU 环境为 ACL 调用算子）
    std::vector<float> output = kernel_mul(x, y);
    std::vector<float> golden(totalLength, valueX * valueY);

    return VerifyResult(output, golden);
}