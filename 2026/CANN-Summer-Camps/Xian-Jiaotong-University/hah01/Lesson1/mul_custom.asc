    if (ret != ACL_SUCCESS) {
        std::cerr
            << "[Failed] aclrtSynchronizeStream failed, error code: "
            << ret
            << std::endl;

        aclrtFree(zDevice);
        aclrtFree(yDevice);
        aclrtFree(xDevice);
        aclrtDestroyStream(stream);
        aclrtResetDevice(deviceId);
        aclFinalize();
        return {};
    }

    std::vector<float> output(
        x.size(),
        0.0f);

    // 输出z：Device -> Host
    ret = aclrtMemcpy(
        output.data(),
        dataSize,
        zDevice,
        dataSize,
        ACL_MEMCPY_DEVICE_TO_HOST);

    if (ret != ACL_SUCCESS) {
        std::cerr
            << "[Failed] Copy output to host failed, error code: "
            << ret
            << std::endl;

        output.clear();
    }

    aclrtFree(zDevice);
    aclrtFree(yDevice);
    aclrtFree(xDevice);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return output;
