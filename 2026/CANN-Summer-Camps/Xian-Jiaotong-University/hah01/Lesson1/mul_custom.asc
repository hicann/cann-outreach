    constexpr int32_t deviceId = 0;
    constexpr uint32_t tileNum = 8;

    const size_t dataSize =
        x.size() * sizeof(float);

    aclError ret = ACL_SUCCESS;
    aclrtStream stream = nullptr;

    uint8_t *xDevice = nullptr;
    uint8_t *yDevice = nullptr;
    uint8_t *zDevice = nullptr;

    // 初始化AscendCL
    ret = aclInit(nullptr);

    if (ret != ACL_SUCCESS) {
        std::cerr
            << "[Failed] aclInit failed, error code: "
            << ret
            << std::endl;
        return {};
    }

    // 设置Device
    ret = aclrtSetDevice(deviceId);

    if (ret != ACL_SUCCESS) {
        std::cerr
            << "[Failed] aclrtSetDevice failed, error code: "
            << ret
            << std::endl;

        aclFinalize();
        return {};
    }

    // 创建Stream
    ret = aclrtCreateStream(&stream);

    if (ret != ACL_SUCCESS) {
        std::cerr
            << "[Failed] aclrtCreateStream failed, error code: "
            << ret
            << std::endl;

        aclrtResetDevice(deviceId);
        aclFinalize();
        return {};
    }

    // 为输入x申请Device内存
    ret = aclrtMalloc(
        reinterpret_cast<void **>(&xDevice),
        dataSize,
        ACL_MEM_MALLOC_HUGE_FIRST);

    if (ret != ACL_SUCCESS) {
        std::cerr
            << "[Failed] aclrtMalloc xDevice failed, error code: "
            << ret
            << std::endl;

        aclrtDestroyStream(stream);
        aclrtResetDevice(deviceId);
        aclFinalize();
        return {};
    }

    // 为输入y申请Device内存
    ret = aclrtMalloc(
        reinterpret_cast<void **>(&yDevice),
        dataSize,
        ACL_MEM_MALLOC_HUGE_FIRST);

    if (ret != ACL_SUCCESS) {
        std::cerr
            << "[Failed] aclrtMalloc yDevice failed, error code: "
            << ret
            << std::endl;

        aclrtFree(xDevice);
        aclrtDestroyStream(stream);
        aclrtResetDevice(deviceId);
        aclFinalize();
        return {};
    }

    // 为输出z申请Device内存
    ret = aclrtMalloc(
        reinterpret_cast<void **>(&zDevice),
        dataSize,
        ACL_MEM_MALLOC_HUGE_FIRST);

    if (ret != ACL_SUCCESS) {
        std::cerr
            << "[Failed] aclrtMalloc zDevice failed, error code: "
            << ret
            << std::endl;

        aclrtFree(yDevice);
        aclrtFree(xDevice);
        aclrtDestroyStream(stream);
        aclrtResetDevice(deviceId);
        aclFinalize();
        return {};
    }

    // 输入x：Host -> Device
    ret = aclrtMemcpy(
        xDevice,
        dataSize,
        x.data(),
        dataSize,
        ACL_MEMCPY_HOST_TO_DEVICE);

    if (ret != ACL_SUCCESS) {
        std::cerr
            << "[Failed] Copy x to device failed, error code: "
            << ret
            << std::endl;

        aclrtFree(zDevice);
        aclrtFree(yDevice);
        aclrtFree(xDevice);
        aclrtDestroyStream(stream);
        aclrtResetDevice(deviceId);
        aclFinalize();
        return {};
