        yDevice,
        dataSize,
        y.data(),
        dataSize,
        ACL_MEMCPY_HOST_TO_DEVICE);

    if (ret != ACL_SUCCESS) {
        std::cerr
            << "[Failed] Copy y to device failed, error code: "
            << ret
