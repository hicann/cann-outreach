private:
<<<<<<< HEAD
    __aicore__ inline void LoadTile(
        uint32_t offset, uint32_t validCount)
    {
        LocalTensor<float> localX =
            queueX.AllocTensor<float>();
        LocalTensor<float> localY =
            queueY.AllocTensor<float>();

        DataCopy(localX, inputX[offset], validCount);
        DataCopy(localY, inputY[offset], validCount);

        queueX.EnQue(localX);
        queueY.EnQue(localY);
    }

    __aicore__ inline void MultiplyTile(
        uint32_t validCount)
    {
        LocalTensor<float> localX =
            queueX.DeQue<float>();
        LocalTensor<float> localY =
            queueY.DeQue<float>();
        LocalTensor<float> localZ =
            queueZ.AllocTensor<float>();

        Mul(
            localZ,
            localX,
            localY,
            static_cast<int32_t>(validCount));

        queueZ.EnQue(localZ);
        queueX.FreeTensor(localX);
        queueY.FreeTensor(localY);
    }

    __aicore__ inline void StoreTile(
        uint32_t offset, uint32_t validCount)
    {
        LocalTensor<float> localZ =
            queueZ.DeQue<float>();

        DataCopy(outputZ[offset], localZ, validCount);

        queueZ.FreeTensor(localZ);
    }

private:
    TPipe pipe;

    TQue<QuePosition::VECIN, BUFFER_NUM> queueX;
    TQue<QuePosition::VECIN, BUFFER_NUM> queueY;
    TQue<QuePosition::VECOUT, BUFFER_NUM> queueZ;

    GlobalTensor<float> inputX;
    GlobalTensor<float> inputY;
    GlobalTensor<float> outputZ;

    uint32_t elementCount = 0;
    uint32_t tileCount = 0;
};

__global__ __aicore__ void mul_custom(
=======
    __aicore__ inline void CopyIn(int32_t progress)
    {
        AscendC::LocalTensor<float> xLocal =
            inQueueX_.AllocTensor<float>();

        AscendC::LocalTensor<float> yLocal =
            inQueueY_.AllocTensor<float>();

        const uint32_t offset =
            static_cast<uint32_t>(progress) * tileLength_;

        AscendC::DataCopy(
            xLocal,
            xGm_[offset],
            tileLength_);

        AscendC::DataCopy(
            yLocal,
            yGm_[offset],
            tileLength_);

        inQueueX_.EnQue(xLocal);
        inQueueY_.EnQue(yLocal);
    }

    __aicore__ inline void Compute(int32_t progress)
    {
        (void)progress;

        AscendC::LocalTensor<float> xLocal =
            inQueueX_.DeQue<float>();

        AscendC::LocalTensor<float> yLocal =
            inQueueY_.DeQue<float>();

        AscendC::LocalTensor<float> zLocal =
            outQueueZ_.AllocTensor<float>();

        AscendC::Mul(
            zLocal,
            xLocal,
            yLocal,
            tileLength_);

        outQueueZ_.EnQue(zLocal);

        inQueueX_.FreeTensor(xLocal);
        inQueueY_.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int32_t progress)
    {
        AscendC::LocalTensor<float> zLocal =
            outQueueZ_.DeQue<float>();

        const uint32_t offset =
            static_cast<uint32_t>(progress) * tileLength_;

        AscendC::DataCopy(
            zGm_[offset],
            zLocal,
            tileLength_);

        outQueueZ_.FreeTensor(zLocal);
    }

private:
    AscendC::GlobalTensor<float> xGm_;
    AscendC::GlobalTensor<float> yGm_;
    AscendC::GlobalTensor<float> zGm_;

    AscendC::TPipe pipe_;

    AscendC::TQue<
        AscendC::QuePosition::VECIN,
        BUFFER_NUM> inQueueX_;

    AscendC::TQue<
        AscendC::QuePosition::VECIN,
        BUFFER_NUM> inQueueY_;

    AscendC::TQue<
        AscendC::QuePosition::VECOUT,
        BUFFER_NUM> outQueueZ_;

    uint32_t blockLength_ = 0;
    uint32_t tileLength_ = 0;
    uint32_t tileNum_ = 0;
};

