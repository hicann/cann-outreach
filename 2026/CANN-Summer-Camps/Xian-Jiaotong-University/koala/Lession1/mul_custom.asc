// mul_custom.asc

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

using namespace AscendC;
constexpr uint32_t BUFFER_NUM = 2; // tensor num for each queue

struct MulCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelMul {
public:
    __aicore__ inline KernelMul(){}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {
        // 1. 绑定GM全局内存地址
        xGm.SetGlobalBuffer((__gm__ float*)x, totalLength);
        yGm.SetGlobalBuffer((__gm__ float*)y, totalLength);
        zGm.SetGlobalBuffer((__gm__ float*)z, totalLength);
        
        // 2. 保存Tiling参数
        this->totalLength = totalLength;
        this->tileNum = tileNum;
        // 计算每个tile处理的元素个数：总长度 / 块数
        this->tileLength = totalLength / tileNum;
        
        // 3. 为队列申请UB内存：每个buffer大小是tileLength个float
        // 注意：float是4字节，所以要乘sizeof(float)
        pipe.InitBuffer(xQueue, BUFFER_NUM, tileLength * sizeof(float));
        pipe.InitBuffer(yQueue, BUFFER_NUM, tileLength * sizeof(float));
        pipe.InitBuffer(zQueue, BUFFER_NUM, tileLength * sizeof(float));
    }
    __aicore__ inline void Process()
    {
        // 循环处理每个tile块：progress从0到tileNum-1
        for (int32_t progress = 0; progress < tileNum; progress++) {
            CopyIn(progress);   // 搬入第progress块
            Compute(progress);  // 计算第progress块
            CopyOut(progress);  // 搬出第progress块
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        // 1. 从队列分配UB本地张量
        LocalTensor<float> xLocal = xQueue.AllocTensor<float>();
        LocalTensor<float> yLocal = yQueue.AllocTensor<float>();
        
        // 2. 计算当前块在GM上的偏移位置：第progress块，偏移progress*tileLength个元素
        uint32_t offset = progress * tileLength;
        
        // 3. 数据搬移：GM → UB
        // DataCopy参数：(目标Local, 源Global[偏移], 搬移元素个数)
        DataCopy(xLocal, xGm[offset], tileLength);
        DataCopy(yLocal, yGm[offset], tileLength);
        
        // 4. 张量入队，通知Compute数据准备好了
        xQueue.EnQue(xLocal);
        yQueue.EnQue(yLocal);
    }
    __aicore__ inline void Compute(int32_t progress)
    {
        // 1. 从队列取出输入张量（出队）
        LocalTensor<float> xLocal = xQueue.DeQue<float>();
        LocalTensor<float> yLocal = yQueue.DeQue<float>();
        // 分配输出张量空间
        LocalTensor<float> zLocal = zQueue.AllocTensor<float>();
        
        // 2. 核心计算：逐元素乘法 z = x * y
        // Mul参数：(目标Local, 源1Local, 源2Local, 计算元素个数)
        Mul(zLocal, xLocal, yLocal, tileLength);
        
        // 3. 输出张量入队，通知CopyOut可以搬出了
        zQueue.EnQue(zLocal);
        // 释放输入张量的空间，给下一个tile用
        xQueue.FreeTensor(xLocal);
        yQueue.FreeTensor(yLocal);
    }
    __aicore__ inline void CopyOut(int32_t progress)
    {
        // 1. 从队列取出计算结果
        LocalTensor<float> zLocal = zQueue.DeQue<float>();
        
        // 2. 计算当前块在GM上的偏移
        uint32_t offset = progress * tileLength;
        
        // 3. 数据搬移：UB → GM
        DataCopy(zGm[offset], zLocal, tileLength);
        
        // 4. 释放输出张量空间
        zQueue.FreeTensor(zLocal);
    }

private:
    // 三个全局内存张量：GM上的输入输出
    GlobalTensor<float> xGm;
    GlobalTensor<float> yGm;
    GlobalTensor<float> zGm;
    
    // 三个队列：双缓冲，每个队列深度是BUFFER_NUM=2
    TQue<QuePosition::VECIN, BUFFER_NUM> xQueue;  // 输入x的队列
    TQue<QuePosition::VECIN, BUFFER_NUM> yQueue;  // 输入y的队列
    TQue<QuePosition::VECOUT, BUFFER_NUM> zQueue; // 输出z的队列
    
    TPipe pipe;  // 流水线管道
    
    // Tiling相关参数
    uint32_t totalLength;  // 总元素个数
    uint32_t tileLength;   // 每个tile处理的元素个数
    uint32_t tileNum;      // 总共有多少个tile
};

__global__ __aicore__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, MulCustomTilingData tiling)
{
    // 实例化算子类
    KernelMul op;
    // 初始化：传入输入输出地址，总长度，分块数
    op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    // 执行处理流程
    op.Process();
}

std::vector<float> kernel_mul(std::vector<float> &x, std::vector<float> &y)
{
    // CPU侧的乘法参考实现：逐元素相乘
    std::vector<float> z(x.size());
    for (size_t i = 0; i < x.size(); i++) {
        z[i] = x[i] * y[i];
    }
    return z;
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
    return 0;
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    // 请补充……
    std::vector<float> output = kernel_mul(x, y);

    std::vector<float> golden(totalLength, valueX * valueY);
    return VerifyResult(output, golden);
}