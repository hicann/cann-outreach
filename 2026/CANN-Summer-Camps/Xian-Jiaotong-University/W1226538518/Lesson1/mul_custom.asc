// mul_custom.asc

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

constexpr uint32_t BUFFER_NUM = 2; // tensor num for each queue

struct MulCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelMul {
public:
    __aicore__ inline KernelMul(){}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {
        // 初始化数据搬运的起始地址
        xGm.SetGlobalBuffer((__gm__ float *)x + block_idx * totalLength / block_num, totalLength / block_num);
        yGm.SetGlobalBuffer((__gm__ float *)y + block_idx * totalLength / block_num, totalLength / block_num);
        zGm.SetGlobalBuffer((__gm__ float *)z + block_idx * totalLength / block_num, totalLength / block_num);

        // 每个核处理的数据长度
        this->totalLength = totalLength / block_num;
        this->tileNum = tileNum;

        // 每个tile处理的数据个数
        tileLength = this->totalLength / tileNum;

        // 分配Local Tensor（UB空间）
        xLocal.SetLocalBuffer(tileLength * BUFFER_NUM, pipe, GetBlockSyncId());
        yLocal.SetLocalBuffer(tileLength * BUFFER_NUM, pipe, GetBlockSyncId());
        zLocal.SetLocalBuffer(tileLength * BUFFER_NUM, pipe, GetBlockSyncId());
    }

    __aicore__ inline void Process()
    {
        // 循环处理所有tile，双Buffer乒乓
        for (int32_t progress = 0; progress < tileNum + BUFFER_NUM - 1; progress++) {
            CopyIn(progress);
            Compute(progress);
            CopyOut(progress);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        // 异步搬运：从GM搬入UB
        // 使用双Buffer交替，当前tile号和buffer索引通过 (progress % BUFFER_NUM) 切换
        LocalTensor<float> xLocalCur = xLocal[progress % BUFFER_NUM * tileLength];
        LocalTensor<float> yLocalCur = yLocal[progress % BUFFER_NUM * tileLength];
        uint32_t offset = (progress < tileNum) ? (progress * tileLength) : (tileNum * tileLength);
        if (progress < tileNum) {
            DataCopy(xLocalCur, xGm[offset], tileLength);
            DataCopy(yLocalCur, yGm[offset], tileLength);
        }
    }

    __aicore__ inline void Compute(int32_t progress)
    {
        // 当progress >= 1时，第一个buffer的数据已搬运完毕，可以开始计算
        if (progress >= 1 && progress < tileNum + 1) {
            LocalTensor<float> xLocalCur = xLocal[(progress - 1) % BUFFER_NUM * tileLength];
            LocalTensor<float> yLocalCur = yLocal[(progress - 1) % BUFFER_NUM * tileLength];
            LocalTensor<float> zLocalCur = zLocal[(progress - 1) % BUFFER_NUM * tileLength];

            // 矢量乘法：zLocal = xLocal * yLocal
            Mul(zLocalCur, xLocalCur, yLocalCur, tileLength);
        }
    }

    __aicore__ inline void CopyOut(int32_t progress)
    {
        // 当progress >= 2时，第一个tile已完成计算，可以搬出到GM
        if (progress >= 2) {
            LocalTensor<float> zLocalCur = zLocal[(progress - 2) % BUFFER_NUM * tileLength];
            uint32_t offset = (progress - 2) * tileLength;
            DataCopy(zGm[offset], zLocalCur, tileLength);
        }
    }

private:
    // GM地址（全局内存）
    GlobalTensor<float> xGm;
    GlobalTensor<float> yGm;
    GlobalTensor<float> zGm;

    // Local Tensor（UB上的本地内存）
    LocalTensor<float> xLocal;
    LocalTensor<float> yLocal;
    LocalTensor<float> zLocal;

    // 流水线管理
    TPipe pipe;

    // Tiling参数
    uint32_t totalLength;
    uint32_t tileNum;
    uint32_t tileLength;
};

__global__ __aicore__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, MulCustomTilingData tiling)
{
    KernelMul kernel;
    kernel.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    kernel.Process();
}

std::vector<float> kernel_mul(std::vector<float> &x, std::vector<float> &y)
{
    // 获取设备信息
    int32_t deviceId = 0;
    aclrtContext context = nullptr;
    aclrtStream stream = nullptr;

    // ACL初始化
    aclInit(nullptr);
    aclrtSetDevice(deviceId);
    aclrtCreateContext(&context, deviceId);
    aclrtCreateStream(&stream);

    // 准备数据
    constexpr uint32_t totalLength = 8 * 2048;  // 16384
    constexpr uint32_t tileNum = 16;            // 每个tile处理1024个float

    // 申请设备内存
    size_t dataSize = totalLength * sizeof(float);
    uint8_t *devX = nullptr;
    uint8_t *devY = nullptr;
    uint8_t *devZ = nullptr;
    aclrtMalloc((void **)&devX, dataSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&devY, dataSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&devZ, dataSize, ACL_MEM_MALLOC_HUGE_FIRST);

    // 拷贝输入数据到设备
    aclrtMemcpy(devX, dataSize, x.data(), dataSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(devY, dataSize, y.data(), dataSize, ACL_MEMCPY_HOST_TO_DEVICE);

    // 设置Tiling参数
    MulCustomTilingData tiling;
    tiling.totalLength = totalLength;
    tiling.tileNum = tileNum;

    // 加载并执行Kernel
    ulQueueKernel("mul_custom", 4, devX, devY, devZ, tiling);
    aclrtSynchronizeStream(stream);

    // 拷贝结果回主机
    std::vector<float> z(totalLength);
    aclrtMemcpy(z.data(), dataSize, devZ, dataSize, ACL_MEMCPY_DEVICE_TO_HOST);

    // 释放资源
    aclrtFree(devX);
    aclrtFree(devY);
    aclrtFree(devZ);
    aclrtDestroyStream(stream);
    aclrtDestroyContext(context);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return z;
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
    return 0;
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    // 调用kernel计算
    std::vector<float> output = kernel_mul(x, y);

    // golden结果：1.2 * 2.3 = 2.76
    std::vector<float> golden(totalLength, valueX * valueY);
    return VerifyResult(output, golden);
}
