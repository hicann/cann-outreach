// mul_custom.asc

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

constexpr uint32_t BUFFER_NUM = 2; // tensor num for each queue

struct MulCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelMul {
public:
    __aicore__ inline KernelMul(){}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {
        // 请补充……
         this->xGm.SetGlobalBuffer((__gm__ float*)x, totalLength);
        this->yGm.SetGlobalBuffer((__gm__ float*)y, totalLength);
        this->zGm.SetGlobalBuffer((__gm__ float*)z, totalLength);
        
        this->tileNum = tileNum;
        this->tileLength = totalLength / tileNum;
        
        this->xQueue.Init(this->xGm, this->tileLength, BUFFER_NUM);
        this->yQueue.Init(this->yGm, this->tileLength, BUFFER_NUM);
        this->zQueue.Init(this->zGm, this->tileLength, BUFFER_NUM);
    }
    __aicore__ inline void Process()
    {
        // 请补充……
        for (int32_t progress = 0; progress < this->tileNum; progress++) {
            CopyIn(progress);
            Compute(progress);
            CopyOut(progress);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        // 请补充……
        this->xQueue.EnQueue(this->xLocal, this->tileLength);
        this->yQueue.EnQueue(this->yLocal, this->tileLength);
    }
    __aicore__ inline void Compute(int32_t progress)
    {
        // 请补充……
        using VecType = typename VecTrait<float>::VecType;
        VecType vx, vy, vz;
        
        constexpr uint32_t vecLen = 8;
        for (uint32_t i = 0; i < this->tileLength; i += vecLen) {
            vx = this->xLocal.Get<VecType>(i);
            vy = this->yLocal.Get<VecType>(i);
            vz = vx * vy;
            this->zLocal.Set<VecType>(i, vz);
        }
    }
    __aicore__ inline void CopyOut(int32_t progress)
    {
        // 请补充……
        this->zQueue.DeQueue(this->zLocal, this->tileLength);
    }

private:
    // 请补充……
    LocalTensor<float> xLocal;
    LocalTensor<float> yLocal;
    LocalTensor<float> zLocal;
    
    GlobalTensor<float> xGm;
    GlobalTensor<float> yGm;
    GlobalTensor<float> zGm;
    
    Queue<float, BUFFER_NUM> xQueue;
    Queue<float, BUFFER_NUM> yQueue;
    Queue<float, BUFFER_NUM> zQueue;
    
    uint32_t tileNum;
    uint32_t tileLength;
};

__global__ __aicore__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, MulCustomTilingData tiling)
{
    // 请补充……
    KernelMul kernel;
    kernel.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    kernel.Process();
}

std::vector<float> kernel_mul(std::vector<float> &x, std::vector<float> &y)
{
    // 请补充……
    uint32_t totalLength = x.size();
    std::vector<float> z(totalLength);
    
    MulCustomTilingData tiling;
    tiling.totalLength = totalLength;

    constexpr uint32_t maxTileSize = 2048;
    tiling.tileNum = (totalLength + maxTileSize - 1) / maxTileSize;
    
    float* xPtr = x.data();
    float* yPtr = y.data();
    float* zPtr = z.data();
    
    mul_custom((GM_ADDR)xPtr, (GM_ADDR)yPtr, (GM_ADDR)zPtr, tiling);
    
    return z;
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
    return 0;
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    // 请补充……
    std::vector<float> output = kernel_mul(x, y);

    std::vector<float> golden(totalLength, valueX * valueY);
    return VerifyResult(output, golden);
}