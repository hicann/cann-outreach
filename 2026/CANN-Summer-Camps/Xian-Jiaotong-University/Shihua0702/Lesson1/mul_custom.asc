// mul_custom.asc

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include <stdexcept>
#include "acl/acl.h"
#include "kernel_operator.h"

constexpr uint32_t BUFFER_NUM = 2; // tensor num for each queue

struct MulCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

#define ACL_CHECK(expr)                                                       \
    do {                                                                      \
        aclError __ret = (expr);                                              \
        if (__ret != ACL_SUCCESS) {                                           \
            std::cerr << "ACL error at " << __FILE__ << ":" << __LINE__       \
                      << " code " << __ret << std::endl;                      \
            throw std::runtime_error("ACL API failed");                       \
        }                                                                     \
    } while(0)

class KernelMul {
public:
    __aicore__ inline KernelMul() {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                uint32_t totalLength, uint32_t tileNum)
    {
        if (tileNum == 0) tileNum = 1;
        this->xGm = x;
        this->yGm = y;
        this->zGm = z;
        this->totalLength = totalLength;
        this->tileNum = tileNum;

        this->baseTileLength = totalLength / tileNum;
        this->lastTileSize = totalLength - baseTileLength * (tileNum - 1);

        uint32_t maxBlockSize = (lastTileSize > baseTileLength) ? lastTileSize : baseTileLength;
        pipe.InitBuffer(inQueX, BUFFER_NUM, maxBlockSize * sizeof(float));
        pipe.InitBuffer(inQueY, BUFFER_NUM, maxBlockSize * sizeof(float));
        pipe.InitBuffer(outQueZ, BUFFER_NUM, maxBlockSize * sizeof(float));
    }
    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < tileNum; ++i) {
            uint32_t curSize = (i == tileNum - 1) ? lastTileSize : baseTileLength;
            CopyIn(i, curSize);
            Compute(i, curSize);
            CopyOut(i, curSize);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress, uint32_t curSize)
    {
        auto xLocal = inQueX.AllocTensor<float>();
        DataCopy(xLocal, (uint8_t*)xGm + progress * baseTileLength * sizeof(float), curSize);
        inQueX.EnQue(xLocal);

        auto yLocal = inQueY.AllocTensor<float>();
        DataCopy(yLocal, (uint8_t*)yGm + progress * baseTileLength * sizeof(float), curSize);
        inQueY.EnQue(yLocal);
    }
    __aicore__ inline void Compute(int32_t progress, uint32_t curSize)
    {
        auto xLocal = inQueX.DeQue<float>();
        auto yLocal = inQueY.DeQue<float>();
        auto zLocal = outQueZ.AllocTensor<float>();

        for (uint32_t i = 0; i < curSize; ++i) {
            zLocal(i) = xLocal(i) * yLocal(i);
        }

        outQueZ.EnQue(zLocal);
        inQueX.Free(xLocal);
        inQueY.Free(yLocal);
    }
    __aicore__ inline void CopyOut(int32_t progress, uint32_t curSize)
    {
        auto zLocal = outQueZ.DeQue<float>();
        DataCopy((uint8_t*)zGm + progress * baseTileLength * sizeof(float), zLocal, curSize);
        outQueZ.Free(zLocal);
    }

private:
    TPipe pipe;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueX, inQueY;
    TQue<QuePosition::VECOUT, BUFFER_NUM> outQueZ;
    GM_ADDR xGm, yGm, zGm;
    uint32_t totalLength, tileNum;
    uint32_t baseTileLength;   
    uint32_t lastTileSize;     
};

__global__ __aicore__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, MulCustomTilingData tiling)
{
    KernelMul op;
    op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    op.Process();
}


std::vector<float> kernel_mul(std::vector<float> &x, std::vector<float> &y)
{
    uint32_t len = x.size();
    if (len != y.size()) {
        std::cerr << "Input sizes do not match!" << std::endl;
        return {};
    }

    MulCustomTilingData tiling{len, 1};  // tileNum=1 不会触发分块边界问题，但我们的代码已支持通用

    void *xDev = nullptr, *yDev = nullptr, *zDev = nullptr;
    size_t size = len * sizeof(float);

    struct DeviceMemGuard {
        void*& ptr;
        DeviceMemGuard(void*& p) : ptr(p) {}
        ~DeviceMemGuard() { if (ptr) aclrtFree(ptr); }
    };

    try {
        ACL_CHECK(aclrtMalloc(&xDev, size, ACL_MEM_MALLOC_HUGE_FIRST));
        DeviceMemGuard guardX(xDev);
        ACL_CHECK(aclrtMalloc(&yDev, size, ACL_MEM_MALLOC_HUGE_FIRST));
        DeviceMemGuard guardY(yDev);
        ACL_CHECK(aclrtMalloc(&zDev, size, ACL_MEM_MALLOC_HUGE_FIRST));
        DeviceMemGuard guardZ(zDev);

        ACL_CHECK(aclrtMemcpy(xDev, size, x.data(), size, ACL_MEMCPY_HOST_TO_DEVICE));
        ACL_CHECK(aclrtMemcpy(yDev, size, y.data(), size, ACL_MEMCPY_HOST_TO_DEVICE));

        void *args[] = {&xDev, &yDev, &zDev, &tiling};
        ACL_CHECK(aclrtLaunchKernel((void*)mul_custom, 1, args, sizeof(args), nullptr));
        ACL_CHECK(aclrtSynchronizeStream(nullptr));

        std::vector<float> z(len);
        ACL_CHECK(aclrtMemcpy(z.data(), size, zDev, size, ACL_MEMCPY_DEVICE_TO_HOST));

        return z;
    } catch (const std::exception& e) {
        std::cerr << "kernel_mul failed: " << e.what() << std::endl;
        
        return {};
    }
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char *argv[])
{
    aclError ret = aclInit(nullptr);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclInit failed: " << ret << std::endl;
        return 1;
    }

    ret = aclrtSetDevice(0);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtSetDevice failed: " << ret << std::endl;
        aclFinalize();
        return 1;
    }

    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    std::vector<float> output = kernel_mul(x, y);
    if (output.empty()) {
        std::cerr << "kernel_mul returned empty, test aborted." << std::endl;
        aclrtResetDevice(0);
        aclFinalize();
        return 1;
    }

    std::vector<float> golden(totalLength, valueX * valueY);
    uint32_t result = VerifyResult(output, golden);

    ret = aclrtResetDevice(0);
    if (ret != ACL_SUCCESS) {
        std::cerr << "Warning: aclrtResetDevice failed with code " << ret << std::endl;
    }
    ret = aclFinalize();
    if (ret != ACL_SUCCESS) {
        std::cerr << "Warning: aclFinalize failed with code " << ret << std::endl;
    }

    return result;
}