// mul_custom.asc

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <cstring>
#include "acl/acl.h"
#include "kernel_operator.h"

using namespace AscendC;

constexpr uint32_t QUEUE_DEPTH = 2;
constexpr uint32_t TILE_COUNT_PER_BLOCK = 8;

struct MulTilingInfo {
    uint32_t elementCount;
    uint32_t tileCount;
};

class VectorMulOperator {
public:
    __aicore__ inline VectorMulOperator() {}
    __aicore__ inline void Setup(GM_ADDR inputA, GM_ADDR inputB, GM_ADDR output,
                                  uint32_t totalElements, uint32_t tilesPerBlock)
    {
        uint32_t blockIdx = GetBlockIdx();
        uint32_t blockTotal = GetBlockNum();

        perBlockLen_ = totalElements / blockTotal;
        tileCount_ = tilesPerBlock;
        singleTileLen_ = perBlockLen_ / tileCount_ / QUEUE_DEPTH;

        uint32_t blockOffset = perBlockLen_ * blockIdx;
        globalA_.SetGlobalBuffer((__gm__ float*)inputA + blockOffset, perBlockLen_);
        globalB_.SetGlobalBuffer((__gm__ float*)inputB + blockOffset, perBlockLen_);
        globalOut_.SetGlobalBuffer((__gm__ float*)output + blockOffset, perBlockLen_);

        uint32_t tileBytes = singleTileLen_ * sizeof(float);
        pipe_.InitBuffer(queueAin_, QUEUE_DEPTH, tileBytes);
        pipe_.InitBuffer(queueBin_, QUEUE_DEPTH, tileBytes);
        pipe_.InitBuffer(queueOut_, QUEUE_DEPTH, tileBytes);
    }

    __aicore__ inline void Run()
    {
        uint32_t totalSteps = tileCount_ * QUEUE_DEPTH;
        for (uint32_t step = 0; step < totalSteps; step++) {
            LoadInputs(step);
            DoMultiply(step);
            StoreResult(step);
        }
    }

private:
    __aicore__ inline void LoadInputs(uint32_t stepIdx)
    {
        LocalTensor<float> tileA = queueAin_.AllocTensor<float>();
        LocalTensor<float> tileB = queueBin_.AllocTensor<float>();
        uint32_t offset = stepIdx * singleTileLen_;
        DataCopy(tileA, globalA_[offset], singleTileLen_);
        DataCopy(tileB, globalB_[offset], singleTileLen_);
        queueAin_.EnQue(tileA);
        queueBin_.EnQue(tileB);
    }

    __aicore__ inline void DoMultiply(uint32_t stepIdx)
    {
        LocalTensor<float> tileA = queueAin_.DeQue<float>();
        LocalTensor<float> tileB = queueBin_.DeQue<float>();
        LocalTensor<float> tileOut = queueOut_.AllocTensor<float>();
        Mul(tileOut, tileA, tileB, singleTileLen_);
        queueOut_.EnQue<float>(tileOut);
        queueAin_.FreeTensor(tileA);
        queueBin_.FreeTensor(tileB);
    }

    __aicore__ inline void StoreResult(uint32_t stepIdx)
    {
        LocalTensor<float> tileOut = queueOut_.DeQue<float>();
        uint32_t offset = stepIdx * singleTileLen_;
        DataCopy(globalOut_[offset], tileOut, singleTileLen_);
        queueOut_.FreeTensor(tileOut);
    }

private:
    TPipe pipe_;
    TQue<QuePosition::VECIN, QUEUE_DEPTH>  queueAin_;
    TQue<QuePosition::VECIN, QUEUE_DEPTH>  queueBin_;
    TQue<QuePosition::VECOUT, QUEUE_DEPTH> queueOut_;
    GlobalTensor<float> globalA_;
    GlobalTensor<float> globalB_;
    GlobalTensor<float> globalOut_;
    uint32_t perBlockLen_ = 0;
    uint32_t tileCount_ = 0;
    uint32_t singleTileLen_ = 0;
};

extern "C" __global__ __vector__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, MulTilingInfo tiling)
{
    VectorMulOperator op;
    op.Setup(x, y, z, tiling.elementCount, tiling.tileCount);
    op.Run();
}

static void SafeRelease(aclrtStream &stream, uint8_t *devX, uint8_t *devY, uint8_t *devZ,
                         int32_t deviceId, bool needReset)
{
    if (devX) aclrtFree(devX);
    if (devY) aclrtFree(devY);
    if (devZ) aclrtFree(devZ);
    if (stream) aclrtDestroyStream(stream);
    if (needReset) aclrtResetDevice(deviceId);
    aclFinalize();
}

std::vector<float> kernel_mul(std::vector<float> &x, std::vector<float> &y)
{
    std::vector<float> result;

    if (x.size() != y.size()) {
        std::cerr << "input tensor size mismatch" << std::endl;
        return result;
    }
    if (x.empty()) return result;

    size_t byteSize = x.size() * sizeof(float);
    result.resize(x.size(), 0.0f);

    const int32_t devId = 0;
    bool devResetNeeded = false;
    uint8_t *devX = nullptr;
    uint8_t *devY = nullptr;
    uint8_t *devZ = nullptr;
    aclrtStream stream = nullptr;

    auto failAndCleanup = [&](const char *msg, aclError err) {
        std::cerr << msg << ": " << err << std::endl;
        SafeRelease(stream, devX, devY, devZ, devId, devResetNeeded);
        return std::vector<float>();
    };

    aclError ret = aclInit(nullptr);
    if (ret != ACL_SUCCESS) return failAndCleanup("aclInit failed", ret);

    ret = aclrtSetDevice(devId);
    if (ret != ACL_SUCCESS) return failAndCleanup("set device failed", ret);
    devResetNeeded = true;

    int64_t vecCoreCount = 0;
    ret = aclrtGetDeviceInfo(devId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &vecCoreCount);
    if (ret != ACL_SUCCESS) return failAndCleanup("get vcore count failed", ret);

    ret = aclrtCreateStream(&stream);
    if (ret != ACL_SUCCESS) return failAndCleanup("create stream failed", ret);

    ret = aclrtMalloc((void**)&devX, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    if (ret != ACL_SUCCESS) return failAndCleanup("malloc x failed", ret);

    ret = aclrtMalloc((void**)&devY, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    if (ret != ACL_SUCCESS) return failAndCleanup("malloc y failed", ret);

    ret = aclrtMalloc((void**)&devZ, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    if (ret != ACL_SUCCESS) return failAndCleanup("malloc z failed", ret);

    ret = aclrtMemcpy(devX, byteSize, x.data(), byteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    if (ret != ACL_SUCCESS) return failAndCleanup("memcpy x H2D failed", ret);

    ret = aclrtMemcpy(devY, byteSize, y.data(), byteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    if (ret != ACL_SUCCESS) return failAndCleanup("memcpy y H2D failed", ret);

    uint32_t blockDim = 1;
    if (vecCoreCount >= 16) blockDim = 16;
    else if (vecCoreCount >= 8) blockDim = 8;
    else if (vecCoreCount >= 4) blockDim = 4;

    MulTilingInfo tiling;
    tiling.elementCount = static_cast<uint32_t>(x.size());
    tiling.tileCount = TILE_COUNT_PER_BLOCK;

    mul_custom<<<blockDim, nullptr, stream>>>(devX, devY, devZ, tiling);

    ret = aclrtSynchronizeStream(stream);
    if (ret != ACL_SUCCESS) return failAndCleanup("sync stream failed", ret);

    ret = aclrtMemcpy(result.data(), byteSize, devZ, byteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    if (ret != ACL_SUCCESS) return failAndCleanup("memcpy D2H failed", ret);

    SafeRelease(stream, devX, devY, devZ, devId, devResetNeeded);
    return result;
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printHead = [](std::vector<float> &vec, const char *label) {
        constexpr int showN = 16;
        std::cout << label << ": ";
        int n = std::min((int)vec.size(), showN);
        for (int i = 0; i < n; i++) {
            std::cout << vec[i] << " ";
        }
        if (vec.size() > (size_t)showN) std::cout << "...";
        std::cout << std::endl;
    };

    printHead(output, "Output");
    printHead(golden, "Golden");

    if (output.size() != golden.size()) {
        std::cout << "[FAIL] size not equal" << std::endl;
        return 1;
    }

    bool ok = true;
    for (size_t i = 0; i < output.size(); i++) {
        float diff = output[i] - golden[i];
        if (diff < 0) diff = -diff;
        if (diff > 1e-5f) {
            std::cout << "[FAIL] mismatch at index " << i
                      << ": output=" << output[i]
                      << " golden=" << golden[i] << std::endl;
            ok = false;
            break;
        }
    }

    if (ok) {
        std::cout << "[PASS] all elements match" << std::endl;
        return 0;
    }
    return 1;
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;

    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    std::vector<float> output = kernel_mul(x, y);
    if (output.size() != totalLength) {
        std::cout << "[FAIL] output size wrong: " << output.size() << std::endl;
        return 1;
    }

    std::vector<float> golden(totalLength, valueX * valueY);
    return VerifyResult(output, golden);
}