// mul_custom.asc

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

constexpr uint32_t BUFFER_NUM = 2; // tensor num for each queue

struct MulCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelMul {
public:
    __aicore__ inline KernelMul() {}
    
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {
        xGm.SetGlobalBuffer((__gm__ float *)x);
        yGm.SetGlobalBuffer((__gm__ float *)y);
        zGm.SetGlobalBuffer((__gm__ float *)z);
        totalLen = totalLength;
        tiles = tileNum;

        // [MODIFIED] 为队列分配内存。此处的 TILE_LEN 是每块内存的大小（字节数）。
        // 为输入和输出各分配 BUFFER_NUM 块内存，以支持流水线。
        pipe.InitBuffer(inQueX, BUFFER_NUM, TILE_LEN * sizeof(float));
        pipe.InitBuffer(inQueY, BUFFER_NUM, TILE_LEN * sizeof(float));
        pipe.InitBuffer(outQueZ, BUFFER_NUM, TILE_LEN * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        for (int32_t i = 0; i < tiles; ++i)
        {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        uint32_t offset = progress * TILE_LEN;
        uint32_t copyLen = (TILE_LEN < (totalLen - offset)) ? TILE_LEN : (totalLen - offset);

        // [MODIFIED] 从输入队列中分配 LocalTensor，用于存放从GM搬入的数据
        AscendC::LocalTensor<float> xLocal = inQueX.AllocTensor<float>();
        AscendC::LocalTensor<float> yLocal = inQueY.AllocTensor<float>();

        // 将数据从全局内存搬入到本地内存
        AscendC::DataCopy(xLocal, xGm[offset], copyLen);
        AscendC::DataCopy(yLocal, yGm[offset], copyLen);

        // 将填充好数据的Tensor入队，供Compute阶段使用
        inQueX.EnQue(xLocal);
        inQueY.EnQue(yLocal);

        curOffset = offset;
        curDataLen = copyLen;
    }

    __aicore__ inline void Compute(int32_t progress)
    {
        // [MODIFIED] 从输入队列中取出Tensor
        AscendC::LocalTensor<float> xLocal = inQueX.DeQue<float>();
        AscendC::LocalTensor<float> yLocal = inQueY.DeQue<float>();

        // [MODIFIED] 从输出队列中分配Tensor，用于存放计算结果
        AscendC::LocalTensor<float> zLocal = outQueZ.AllocTensor<float>();

        // 执行元素级乘法
        for (uint32_t i = 0; i < curDataLen; i++)
        {
            zLocal[i] = xLocal[i] * yLocal[i];
        }

        // 将计算结果入队，供CopyOut阶段使用
        outQueZ.EnQue(zLocal);
    }

    __aicore__ inline void CopyOut(int32_t progress)
    {
        // [MODIFIED] 从输出队列中取出Tensor
        AscendC::LocalTensor<float> zLocal = outQueZ.DeQue<float>();

        // 将结果从本地内存搬出到全局内存
        AscendC::DataCopy(zGm[curOffset], zLocal, curDataLen);
    }

private:
    AscendC::GlobalTensor<float> xGm, yGm, zGm;
    AscendC::TPipe pipe;

    // [MODIFIED] 定义三个队列，分别用于管理输入X、输入Y和输出Z的本地内存
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inQueX;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inQueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_NUM> outQueZ;

    // [MODIFIED] 定义Tile长度（每个Tile处理的元素个数）
    static constexpr uint32_t TILE_LEN = 128U;

    uint32_t curOffset;
    uint32_t curDataLen;
    uint32_t totalLen;
    uint32_t tiles;
};

__global__ __aicore__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, MulCustomTilingData tiling)
{
    KernelMul op;
    op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    op.Process();
}

std::vector<float> kernel_mul(std::vector<float> &x, std::vector<float> &y)
{
    std::vector<float> res(x.size());
    for (size_t i = 0; i < x.size(); ++i)
    {
        res[i] = x[i] * y[i];
    }
    return res;
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
    return 0;
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    std::vector<float> output = kernel_mul(x, y);

    std::vector<float> golden(totalLength, valueX * valueY);
    return VerifyResult(output, golden);
}