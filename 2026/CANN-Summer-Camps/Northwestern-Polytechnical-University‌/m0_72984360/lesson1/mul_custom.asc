#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

using namespace AscendC;

constexpr uint32_t BUFFER_NUM = 2; // tensor num for each queue

struct MulCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelMul {
public:
    __aicore__ inline KernelMul(){}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {
        this->tileNum = tileNum;
        this->totalLength = totalLength;
        this->blockLength = totalLength / tileNum;
        this->tailLength = totalLength % tileNum; 


        xGm.SetGlobalBuffer((__gm__ float *)x, totalLength);
        yGm.SetGlobalBuffer((__gm__ float *)y, totalLength);
        zGm.SetGlobalBuffer((__gm__ float *)z, totalLength);

        
        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->blockLength * sizeof(float));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->blockLength * sizeof(float));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->blockLength * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        int32_t loopCount = this->tileNum;

        for (int32_t i = 0; i < loopCount; i++) {
               
	uint32_t currentLength = (i == loopCount - 1) ? (this->blockLength + this->tailLength) : this->blockLength;
            CopyIn(i, currentLength);
            Compute(i, currentLength);
            CopyOut(i, currentLength);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress, uint32_t currentLength)
    {
        
        LocalTensor<float> xLocal = inQueueX.AllocTensor<float>();
        LocalTensor<float> yLocal = inQueueY.AllocTensor<float>();

        
        DataCopy(xLocal, xGm[progress * this->blockLength], currentLength);
        DataCopy(yLocal, yGm[progress * this->blockLength], currentLength);

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(int32_t progress, uint32_t currentLength)
    {
        
        LocalTensor<float> xLocal = inQueueX.DeQue<float>();
        LocalTensor<float> yLocal = inQueueY.DeQue<float>();

        
        LocalTensor<float> zLocal = outQueueZ.AllocTensor<float>();

        
        Mul(zLocal, xLocal, yLocal, currentLength);

        
        outQueueZ.EnQue<float>(zLocal);

        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int32_t progress, uint32_t currentLength)
    {
        
        LocalTensor<float> zLocal = outQueueZ.DeQue<float>();

        
        DataCopy(zGm[progress * this->blockLength], zLocal, currentLength);

        
        outQueueZ.FreeTensor(zLocal);
    }

private:
    TPipe pipe;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueX, inQueueY;
    TQue<TPosition::VECOUT, BUFFER_NUM> outQueueZ;

    GlobalTensor<float> xGm, yGm, zGm;

    uint32_t blockLength;
    uint32_t tileNum;
    uint32_t totalLength;
    uint32_t tailLength; 
};

__global__ __aicore__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, MulCustomTilingData tiling)
{
    KernelMul op;
    op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    op.Process();
}

std::vector<float> kernel_mul(std::vector<float> &x, std::vector<float> &y)
{
    uint32_t totalLength = x.size();
    uint32_t tileNum = 8;  // 分块数量

   
    std::vector<float> z(totalLength);

    
    float *d_x = nullptr;
    float *d_y = nullptr;
    float *d_z = nullptr;
    aclrtStream stream = nullptr;
    aclError ret = ACL_SUCCESS;

    ret = aclrtMalloc((void **)&d_x, totalLength * sizeof(float), ACL_MEM_MALLOC_NORMAL_ONLY);
    if (ret != ACL_SUCCESS) {
        std::cout << "aclrtMalloc d_x failed, ret = " << ret << std::endl;
        goto cleanup;
    }

    ret = aclrtMalloc((void **)&d_y, totalLength * sizeof(float), ACL_MEM_MALLOC_NORMAL_ONLY);
    if (ret != ACL_SUCCESS) {
        std::cout << "aclrtMalloc d_y failed, ret = " << ret << std::endl;
        goto cleanup;
    }

    ret = aclrtMalloc((void **)&d_z, totalLength * sizeof(float), ACL_MEM_MALLOC_NORMAL_ONLY);
    if (ret != ACL_SUCCESS) {
        std::cout << "aclrtMalloc d_z failed, ret = " << ret << std::endl;
        goto cleanup;
    }

    // 拷贝输入数据到设备
    ret = aclrtMemcpy(d_x, totalLength * sizeof(float), x.data(), totalLength * sizeof(float), ACL_MEMCPY_HOST_TO_DEVICE);
    if (ret != ACL_SUCCESS) {
        std::cout << "aclrtMemcpy x to device failed, ret = " << ret << std::endl;
        goto cleanup;
    }

    ret = aclrtMemcpy(d_y, totalLength * sizeof(float), y.data(), totalLength * sizeof(float), ACL_MEMCPY_HOST_TO_DEVICE);
    if (ret != ACL_SUCCESS) {
        std::cout << "aclrtMemcpy y to device failed, ret = " << ret << std::endl;
        goto cleanup;
    }

    
    ret = aclrtCreateStream(&stream);
    if (ret != ACL_SUCCESS) {
        std::cout << "aclrtCreateStream failed, ret = " << ret << std::endl;
        goto cleanup;
    }

    
    MulCustomTilingData tiling;
    tiling.totalLength = totalLength;
    tiling.tileNum = tileNum;

   
    mul_custom<<<1, nullptr, stream>>>((GM_ADDR)d_x, (GM_ADDR)d_y, (GM_ADDR)d_z, tiling);

   
    ret = aclrtSynchronizeStream(stream);
    if (ret != ACL_SUCCESS) {
        std::cout << "aclrtSynchronizeStream failed, ret = " << ret << std::endl;
        goto cleanup;
    }

        ret = aclrtMemcpy(z.data(), totalLength * sizeof(float), d_z, totalLength * sizeof(float), ACL_MEMCPY_DEVICE_TO_HOST);
    if (ret != ACL_SUCCESS) {
        std::cout << "aclrtMemcpy result to host failed, ret = " << ret << std::endl;
        goto cleanup;
    }

cleanup:
    
    if (stream != nullptr) {
        aclrtDestroyStream(stream);
    }

        if (d_x != nullptr) {
        aclrtFree(d_x);
    }
    if (d_y != nullptr) {
        aclrtFree(d_y);
    }
    if (d_z != nullptr) {
        aclrtFree(d_z);
    }

    return z;
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
    return 0;
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    
    aclError ret = aclInit(nullptr);
    if (ret != ACL_SUCCESS) {
        std::cout << "aclInit failed, ret = " << ret << std::endl;
        return 1;
    }

   
    int32_t deviceId = 0;
    ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) {
        std::cout << "aclrtSetDevice failed, ret = " << ret << std::endl;
        aclFinalize();
        return 1;
    }

    
    std::vector<float> output = kernel_mul(x, y);

    aclrtResetDevice(deviceId);
    aclFinalize();

    std::vector<float> golden(totalLength, valueX * valueY);
    return VerifyResult(output, golden);
}