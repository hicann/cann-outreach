// mul_custom.asc

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

constexpr uint32_t BUFFER_NUM = 2; // tensor num for each queue

struct MulCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelMul {
public:
    __aicore__ inline KernelMul(){}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(x), totalLength);
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), totalLength);
        zGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(z), totalLength);
        this->totalLength = totalLength;
        this->tileNum = tileNum;
        // 修复：向上取整，保证缓冲区大小足够容纳最大 tile
        this->tileLength = (totalLength + tileNum - 1) / tileNum;

        pipe.InitBuffer(queX, BUFFER_NUM, tileLength * sizeof(float));
        pipe.InitBuffer(queY, BUFFER_NUM, tileLength * sizeof(float));
        pipe.InitBuffer(queZ, BUFFER_NUM, tileLength * sizeof(float));
    }
    __aicore__ inline void Process()
    {
        for (int32_t i = 0; i < tileNum; ++i) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
        pipe.Wait();
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        auto localX = queX.AllocTensor<float>();
        auto localY = queY.AllocTensor<float>();

        uint32_t offset = progress * tileLength;
        uint32_t currentLength = (progress == tileNum - 1) ? (totalLength - offset) : tileLength;

        AscendC::DataCopy(localX, xGm[offset], currentLength);
        AscendC::DataCopy(localY, yGm[offset], currentLength);

        queX.EnQue(localX);
        queY.EnQue(localY);
    }
    __aicore__ inline void Compute(int32_t progress)
    {
        auto localX = queX.DeQue<float>();
        auto localY = queY.DeQue<float>();

        auto localZ = queZ.AllocTensor<float>();

        uint32_t offset = progress * tileLength;
        uint32_t currentLength = (progress == tileNum - 1) ? (totalLength - offset) : tileLength;

        AscendC::Mul(localZ, localX, localY, currentLength);

        queX.FreeTensor(localX);
        queY.FreeTensor(localY);
        queZ.EnQue(localZ);
    }
    __aicore__ inline void CopyOut(int32_t progress)
    {
        auto localZ = queZ.DeQue<float>();

        uint32_t offset = progress * tileLength;
        uint32_t currentLength = (progress == tileNum - 1) ? (totalLength - offset) : tileLength;

        AscendC::DataCopy(zGm[offset], localZ, currentLength);

        queZ.FreeTensor(localZ);
    }

private:
    AscendC::GlobalTensor<float> xGm, yGm, zGm;
    AscendC::TQue<AscendC::QuePosition::VECIN, BUFFER_NUM> queX, queY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, BUFFER_NUM> queZ;
    AscendC::TPipe pipe;
    uint32_t totalLength;
    uint32_t tileNum;
    uint32_t tileLength;
};

__global__ __aicore__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, MulCustomTilingData tiling)
{
    KernelMul op;
    op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    op.Process();
}

std::vector<float> kernel_mul(std::vector<float> &x, std::vector<float> &y)
{
    constexpr uint32_t TILE_LENGTH = 256;
    size_t dataSize = x.size() * sizeof(float);

    // 获取当前 context 和 stream（假定已初始化）
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    // 分配 Device 内存
    void *devX = nullptr, *devY = nullptr, *devZ = nullptr;
    aclrtMalloc(&devX, dataSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&devY, dataSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&devZ, dataSize, ACL_MEM_MALLOC_HUGE_FIRST);

    // 拷贝输入到 Device
    aclrtMemcpy(devX, dataSize, x.data(), dataSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(devY, dataSize, y.data(), dataSize, ACL_MEMCPY_HOST_TO_DEVICE);

    // 设置 Tiling 数据
    MulCustomTilingData tiling;
    tiling.totalLength = static_cast<uint32_t>(x.size());
    tiling.tileNum = (tiling.totalLength + TILE_LENGTH - 1) / TILE_LENGTH;  // 向上取整

    // 启动核函数
    AscendC::KernelLaunch(mul_custom, 1, 1, stream,
                          reinterpret_cast<GM_ADDR>(devX),
                          reinterpret_cast<GM_ADDR>(devY),
                          reinterpret_cast<GM_ADDR>(devZ),
                          tiling);

    // 同步
    aclrtSynchronizeStream(stream);

    // 拷贝结果回 Host
    std::vector<float> output(x.size());
    aclrtMemcpy(output.data(), dataSize, devZ, dataSize, ACL_MEMCPY_DEVICE_TO_HOST);

    // 释放资源
    aclrtFree(devX);
    aclrtFree(devY);
    aclrtFree(devZ);
    aclrtDestroyStream(stream);

    return output;
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
    // 删除多余的 return 0; （死代码已移除）
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    // 初始化 ACL
    aclInit(nullptr);
    aclrtContext context;
    aclrtCreateContext(&context, 0);
    aclrtSetCurrentContext(context);

    std::vector<float> output = kernel_mul(x, y);

    // 清理 ACL
    aclrtDestroyContext(context);
    aclFinalize();

    std::vector<float> golden(totalLength, valueX * valueY);
    return VerifyResult(output, golden);
}