// mul_custom.asc

#include <algorithm>
#include <cstdint>
#include <cstdlib>
#include <iostream>
#include <iterator>
#include <limits>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"

constexpr uint32_t BUFFER_NUM = 2; // tensor num for each queue
constexpr uint32_t CORE_NUM = 8;   // 使用 8 个 AI Core 并行处理
constexpr uint32_t TILE_NUM = 8;   // 每个 Core 内部再拆成多个 tile 流水执行

struct MulCustomTilingData
{
    uint32_t totalLength; // 输入 tensor 的元素总数
    uint32_t tileNum;     // 每个 Core 上的基础切分数量
};

class KernelMul {
public:
    __aicore__ inline KernelMul() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {
        // 每个 tile 配合双缓冲执行，所以实际循环次数会乘上 BUFFER_NUM。
        const uint32_t loopTimes = tileNum * BUFFER_NUM;

        // 先按 Core 数量平均切分全量数据；最后一个 Core 可能少处理一些元素。
        const uint32_t avgBlockLen = (totalLength + AscendC::GetBlockNum() - 1) / AscendC::GetBlockNum();
        const uint32_t blockStart = avgBlockLen * AscendC::GetBlockIdx();

        this->blockLen = 0;
        if (blockStart < totalLength) {
            const uint32_t left = totalLength - blockStart;
            this->blockLen = left < avgBlockLen ? left : avgBlockLen;
        }

        this->tileLen = this->blockLen == 0 ? 1 : (this->blockLen + loopTimes - 1) / loopTimes;
        this->loopCount = this->blockLen == 0 ? 0 : (this->blockLen + this->tileLen - 1) / this->tileLen;

        // GlobalTensor 只绑定当前 Core 负责的那一段 GM 地址。
        xGm.SetGlobalBuffer((__gm__ float *)x + blockStart, this->blockLen);
        yGm.SetGlobalBuffer((__gm__ float *)y + blockStart, this->blockLen);
        zGm.SetGlobalBuffer((__gm__ float *)z + blockStart, this->blockLen);

        // 为输入 x、输入 y、输出 z 各申请一个队列，形成 CopyIn -> Compute -> CopyOut 的流水。
        pipe.InitBuffer(queueX, BUFFER_NUM, this->tileLen * sizeof(float));
        pipe.InitBuffer(queueY, BUFFER_NUM, this->tileLen * sizeof(float));
        pipe.InitBuffer(queueZ, BUFFER_NUM, this->tileLen * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        // 按 tile 逐块处理：先从 GM 搬到 Local，再做 Mul，最后写回 GM。
        for (uint32_t task = 0; task < this->loopCount; ++task) {
            const uint32_t len = CalcTaskLen(task);
            CopyIn(task, len);
            Compute(len);
            CopyOut(task, len);
        }
    }

private:
    __aicore__ inline uint32_t CalcTaskLen(uint32_t taskId) const
    {
        // 处理尾块，避免总长度不能整除 tileLen 时越界。
        const uint32_t offset = taskId * this->tileLen;
        const uint32_t remain = this->blockLen - offset;
        return remain < this->tileLen ? remain : this->tileLen;
    }

    __aicore__ inline void CopyIn(uint32_t taskId, uint32_t len)
    {
        AscendC::LocalTensor<float> xLocal = queueX.AllocTensor<float>();
        AscendC::LocalTensor<float> yLocal = queueY.AllocTensor<float>();
        const uint32_t offset = taskId * this->tileLen;

        // 从全局内存 GM 搬运当前 tile 的 x、y 数据到片上 LocalTensor。
        AscendC::DataCopy(xLocal, xGm[offset], len);
        AscendC::DataCopy(yLocal, yGm[offset], len);

        queueX.EnQue(xLocal);
        queueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t len)
    {
        // DeQue 取出 CopyIn 准备好的数据，AllocTensor 申请输出缓存。
        AscendC::LocalTensor<float> xLocal = queueX.DeQue<float>();
        AscendC::LocalTensor<float> yLocal = queueY.DeQue<float>();
        AscendC::LocalTensor<float> zLocal = queueZ.AllocTensor<float>();

        // AscendC::Mul 完成逐元素乘法：z[i] = x[i] * y[i]。
        AscendC::Mul(zLocal, xLocal, yLocal, len);

        queueZ.EnQue(zLocal);
        queueX.FreeTensor(xLocal);
        queueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t taskId, uint32_t len)
    {
        // 将计算结果从输出队列取出，并写回当前 Core 对应的 GM 地址。
        AscendC::LocalTensor<float> zLocal = queueZ.DeQue<float>();
        AscendC::DataCopy(zGm[taskId * this->tileLen], zLocal, len);
        queueZ.FreeTensor(zLocal);
    }

private:
    // pipe 管理片上队列资源，三个队列分别对应输入 x、输入 y 和输出 z。
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, BUFFER_NUM> queueX;
    AscendC::TQue<AscendC::QuePosition::VECIN, BUFFER_NUM> queueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, BUFFER_NUM> queueZ;

    // GM 上的三个 tensor 视图，实际地址已经在 Init 中偏移到当前 Core 的分片。
    AscendC::GlobalTensor<float> xGm;
    AscendC::GlobalTensor<float> yGm;
    AscendC::GlobalTensor<float> zGm;

    // blockLen 是当前 Core 负责的元素数，tileLen 是一次流水处理的元素数。
    uint32_t blockLen = 0;
    uint32_t tileLen = 0;
    uint32_t loopCount = 0;
};

__global__ __aicore__ void mul_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, MulCustomTilingData tiling)
{
    KernelMul kernel;
    kernel.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    kernel.Process();
}

static void CheckAcl(aclError ret, const char *apiName)
{
    // 简单封装 ACL 返回值检查，出错时直接打印具体 API 名称，方便定位。
    if (ret != ACL_SUCCESS) {
        std::cerr << apiName << " failed, error code: " << ret << std::endl;
        std::exit(1);
    }
}

std::vector<float> kernel_mul(std::vector<float> &x, std::vector<float> &y)
{
    // Host 侧先做基础检查，避免后续申请内存或拷贝时出现隐蔽错误。
    if (x.size() != y.size()) {
        std::cerr << "input size mismatch" << std::endl;
        std::exit(1);
    }
    if (x.empty()) {
        return {};
    }
    if (x.size() > std::numeric_limits<uint32_t>::max()) {
        std::cerr << "input size exceeds uint32_t range" << std::endl;
        std::exit(1);
    }
    if (x.size() > std::numeric_limits<size_t>::max() / sizeof(float)) {
        std::cerr << "input byte size overflow" << std::endl;
        std::exit(1);
    }

    const uint32_t totalLength = static_cast<uint32_t>(x.size());
    const size_t dataBytes = x.size() * sizeof(float);
    std::vector<float> output(totalLength, 0.0f);

    // 初始化 ACL 运行时，并创建一个 stream 用来提交 kernel。
    CheckAcl(aclInit(nullptr), "aclInit");
    CheckAcl(aclrtSetDevice(0), "aclrtSetDevice");

    aclrtStream stream = nullptr;
    CheckAcl(aclrtCreateStream(&stream), "aclrtCreateStream");

    void *xDevice = nullptr;
    void *yDevice = nullptr;
    void *zDevice = nullptr;
    CheckAcl(aclrtMalloc(&xDevice, dataBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc x");
    CheckAcl(aclrtMalloc(&yDevice, dataBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc y");
    CheckAcl(aclrtMalloc(&zDevice, dataBytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc z");

    // 把 Host 上的输入数据拷贝到 Device，再启动自定义 AscendC kernel。
    CheckAcl(aclrtMemcpy(xDevice, dataBytes, x.data(), dataBytes, ACL_MEMCPY_HOST_TO_DEVICE), "aclrtMemcpy x");
    CheckAcl(aclrtMemcpy(yDevice, dataBytes, y.data(), dataBytes, ACL_MEMCPY_HOST_TO_DEVICE), "aclrtMemcpy y");

    MulCustomTilingData tiling{totalLength, TILE_NUM};
    mul_custom<<<CORE_NUM, nullptr, stream>>>(xDevice, yDevice, zDevice, tiling);
    CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream");

    // kernel 执行结束后，把结果从 Device 拷回 Host。
    CheckAcl(aclrtMemcpy(output.data(), dataBytes, zDevice, dataBytes, ACL_MEMCPY_DEVICE_TO_HOST), "aclrtMemcpy z");

    // 释放 Device 内存和 ACL 运行时资源。
    CheckAcl(aclrtFree(xDevice), "aclrtFree x");
    CheckAcl(aclrtFree(yDevice), "aclrtFree y");
    CheckAcl(aclrtFree(zDevice), "aclrtFree z");
    CheckAcl(aclrtDestroyStream(stream), "aclrtDestroyStream");
    CheckAcl(aclrtResetDevice(0), "aclrtResetDevice");
    CheckAcl(aclFinalize(), "aclFinalize");

    return output;
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
    return 0;
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    std::vector<float> output = kernel_mul(x, y);

    std::vector<float> golden(totalLength, valueX * valueY);
    return VerifyResult(output, golden);
}
