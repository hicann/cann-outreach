#include "acl/acl.h"
#include "kernel_operator.h"

__global__ __vector__ void hi_ascend_zh()
{
    AscendC::printf("[Block (%ld/%ld)]: Hi Ascend\n", AscendC::GetBlockIdx(), AscendC::GetBlockNum());
}

int32_t main(int argc, char const *argv[])
{
    aclInit(nullptr);
    int32_t intDeviceId = 0;
    aclrtSetDevice(intDeviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    constexpr uint32_t blockDim = 4;
    hi_ascend_zh<<<blockDim, nullptr, stream>>>();
    aclrtSynchronizeStream(stream);
    aclrtDestroyStream(stream);
    aclrtResetDevice(intDeviceId);
    aclFinalize();
    return 0;
}
