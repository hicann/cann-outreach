    \"--header\" \\
    \"/usr/local/Ascend/cann-9.0.0/compiler/tikcpp/ascendc_kernel_cmake/fwk_modules/util/makeself/makeself-header.sh\" \\
    \"--help-header\" \\
    \"./help.info\" \\
    \"--tar-format\" \\
    \"posix\" \\
    \"--gzip\" \\
    \"--complevel\" \\
    \"4\" \\
    \"--nomd5\" \\
    \"--sha256\" \\
    \"./\" \\
    \"custom_opp_ubuntu_aarch64.run\" \\
    \"version:1.0\" \\
    \"./install.sh\""
	if test x"$script" != x; then
	    echo Script run after extraction:
	    echo "    " $script $scriptargs
	fi
	if test x"" = xcopy; then
		echo "Archive will copy itself to a temporary location"
	fi
	if test x"n" = xy; then
