#include "kernel_operator.h"

constexpr uint32_t BLOCK_DIM = 8;
constexpr uint32_t BLOCK_LENGTH = 2048;
constexpr uint32_t BUFFER_NUM = 1;

// ============================================================
// UB Bank Conflict 优化
//
// A2/A3 UB 每行32B。
// x / y / z Buffer之间额外插入32B。
// ============================================================
constexpr uint32_t BANK_PAD_BYTES = 32;


template <typename T>
class KernelSubFast {
public:
    __aicore__ inline KernelSubFast() {}


    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        AscendC::TPipe* pipe)
    {
        /*
         * ====================================================
         * 关键优化1：
         *
         * TPipe不再作为Kernel类成员。
         *
         * 官方建议TPipe在Kernel入口创建，
         * Kernel类只保存指针。
         *
         * 这样更利于Scalar常量折叠和传播。
         * ====================================================
         */
        pipe_ = pipe;


        // ----------------------------------------------------
        // 每Core固定处理2048个元素
        // ----------------------------------------------------
        const uint32_t offset =
            AscendC::GetBlockIdx() *
            BLOCK_LENGTH;


        xGm.SetGlobalBuffer(
            (__gm__ T*)x + offset,
            BLOCK_LENGTH);


        yGm.SetGlobalBuffer(
            (__gm__ T*)y + offset,
            BLOCK_LENGTH);


        zGm.SetGlobalBuffer(
            (__gm__ T*)z + offset,
            BLOCK_LENGTH);


        /*
         * ====================================================
         * UB布局：
         *
         * 原来：
         *
         * xxxxxxxxxxxxxxxx
         * yyyyyyyyyyyyyyyy
         * zzzzzzzzzzzzzzzz
         *
         *
         * 现在：
         *
         * xxxxxxxxxxxxxxxx
         * [32B PAD]
         * yyyyyyyyyyyyyyyy
         * [32B PAD]
         * zzzzzzzzzzzzzzzz
         *
         *
         * FP16：
         *
         * xSize = 2048 * 2 = 4096B
         *
         * x addr ~= 0
         * y addr ~= 4096 + 32
         * z addr ~= 8192 + 64
         *
         *
         * FP32：
         *
         * xSize = 2048 * 4 = 8192B
         *
         * x addr ~= 0
         * y addr ~= 8192 + 32
         * z addr ~= 16384 + 64
         *
         *
         * 防止x/y/z规则间隔导致UB Bank Group冲突。
         * ====================================================
         */


        // x input
        pipe_->InitBuffer(
            inQueueX,
            BUFFER_NUM,
            BLOCK_LENGTH * sizeof(T));


        // x和y之间增加32B padding
        pipe_->InitBuffer(
            bankPad0,
            BANK_PAD_BYTES);


        // y input
        pipe_->InitBuffer(
            inQueueY,
            BUFFER_NUM,
            BLOCK_LENGTH * sizeof(T));


        // y和z之间增加32B padding
        pipe_->InitBuffer(
            bankPad1,
            BANK_PAD_BYTES);


        // output
        pipe_->InitBuffer(
            outQueueZ,
            BUFFER_NUM,
            BLOCK_LENGTH * sizeof(T));
    }


    __aicore__ inline void Process()
    {
        /*
         * ====================================================
         * 保持你已经PASS版本的数据流：
         *
         * CopyIn
         * ↓
         * EnQue / DeQue
         * ↓
         * Sub
         * ↓
         * EnQue / DeQue
         * ↓
         * CopyOut
         *
         * 不再引入任何手工Event。
         * ====================================================
         */


        // ====================================================
        // CopyIn
        // ====================================================

        AscendC::LocalTensor<T> xLocal =
            inQueueX.AllocTensor<T>();


        AscendC::LocalTensor<T> yLocal =
            inQueueY.AllocTensor<T>();


        /*
         * 一次搬完整2048元素。
         */
        AscendC::DataCopy(
            xLocal,
            xGm,
            BLOCK_LENGTH);


        AscendC::DataCopy(
            yLocal,
            yGm,
            BLOCK_LENGTH);


        /*
         * 保持成功版同步机制。
         *
         * 不使用HardEvent。
         */
        inQueueX.EnQue(
            xLocal);


        inQueueY.EnQue(
            yLocal);


        // ====================================================
        // Compute
        // ====================================================

        xLocal =
            inQueueX.DeQue<T>();


        yLocal =
            inQueueY.DeQue<T>();


        AscendC::LocalTensor<T> zLocal =
            outQueueZ.AllocTensor<T>();


        /*
         * ====================================================
         * 核心计算
         *
         * 保持成功版本原样：
         *
         * z = x - y
         *
         * 不使用：
         *   mask
         *   repeat
         *   counter mode
         *   static tensor
         *
         * 避免重新引入精度/兼容风险。
         * ====================================================
         */
        AscendC::Sub(
            zLocal,
            xLocal,
            yLocal,
            BLOCK_LENGTH);


        outQueueZ.EnQue(
            zLocal);


        inQueueX.FreeTensor(
            xLocal);


        inQueueY.FreeTensor(
            yLocal);


        // ====================================================
        // CopyOut
        // ====================================================

        zLocal =
            outQueueZ.DeQue<T>();


        AscendC::DataCopy(
            zGm,
            zLocal,
            BLOCK_LENGTH);


        outQueueZ.FreeTensor(
            zLocal);
    }


private:

    /*
     * ========================================================
     * TPipe只保留指针。
     *
     * 不再：
     *
     * AscendC::TPipe pipe;
     *
     * ========================================================
     */
    AscendC::TPipe* pipe_;


    // --------------------------------------------------------
    // 输入队列
    // --------------------------------------------------------

    AscendC::TQue<
        AscendC::QuePosition::VECIN,
        BUFFER_NUM>
        inQueueX;


    /*
     * 32B物理UB padding
     */
    AscendC::TBuf<
        AscendC::TPosition::VECCALC>
        bankPad0;


    AscendC::TQue<
        AscendC::QuePosition::VECIN,
        BUFFER_NUM>
        inQueueY;


    /*
     * 第二个32B padding
     */
    AscendC::TBuf<
        AscendC::TPosition::VECCALC>
        bankPad1;


    // --------------------------------------------------------
    // 输出队列
    // --------------------------------------------------------

    AscendC::TQue<
        AscendC::QuePosition::VECOUT,
        BUFFER_NUM>
        outQueueZ;


    // --------------------------------------------------------
    // GM Tensor
    // --------------------------------------------------------

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;
};


// ============================================================
// Kernel
// ============================================================

template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z)
{
    /*
     * ========================================================
     * 关键优化：
     *
     * TPipe在Kernel函数中创建。
     *
     * 华为官方推荐这种写法。
     * ========================================================
     */
    AscendC::TPipe pipe;


    KernelSubFast<T> op;


    op.Init(
        x,
        y,
        z,
        &pipe);


    op.Process();
}


// ============================================================
// Host
// ============================================================

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    /*
     * 题目Shape固定：
     *
     * (8, 2048)
     *
     * 继续固定8 Core。
     *
     * 不改已经PASS的并行策略。
     */
    (void)info_y;
    (void)info_z;
    (void)availableCoreNum;


    const TensorInfo& tensorInfo =
        info_x.tensors[0];


    /*
     * dtype：
     *
     * 0 -> float32
     * 1 -> float16
     *
     * 保持成功版本不变。
     */
    if (tensorInfo.dtype == 1) {

        sub_custom<half>
            <<<BLOCK_DIM, nullptr, stream>>>(
                x,
                y,
                z);

    } else {

        sub_custom<float>
            <<<BLOCK_DIM, nullptr, stream>>>(
                x,
                y,
                z);
    }
}