#include <cmath>
#include "kernel_operator.h"
/*
 * Add Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 */

using namespace AscendC;

__global__ __vector__ void add_custom(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, int64_t totalElems)
{
    int64_t blockIdx = GetBlockIdx();
    int64_t blockNum = GetBlockNum();
    int64_t perBlock = totalElems / blockNum;
    int64_t start = blockIdx * perBlock;

    GlobalTensor<half> x1Global, x2Global, yGlobal;
    x1Global.SetGlobalBuffer((__gm__ half*)x1 + start);
    x2Global.SetGlobalBuffer((__gm__ half*)x2 + start);
    yGlobal.SetGlobalBuffer((__gm__ half*)y + start);

    TPipe pipe;
    TQue<QuePosition::VECIN, 1> queIn1;
    TQue<QuePosition::VECIN, 1> queIn2;
    TQue<QuePosition::VECOUT, 1> queOut;
    constexpr int32_t tileLen = 4096;
    pipe.InitBuffer(queIn1, 1, tileLen * sizeof(half));
    pipe.InitBuffer(queIn2, 1, tileLen * sizeof(half));
    pipe.InitBuffer(queOut, 1, tileLen * sizeof(half));

    for (int64_t offset = 0; offset < perBlock; offset += tileLen) {
        int32_t count = static_cast<int32_t>(tileLen);
        if (offset + count > perBlock) {
            count = static_cast<int32_t>(perBlock - offset);
        }

        LocalTensor<half> in1 = queIn1.AllocTensor<half>();
        LocalTensor<half> in2 = queIn2.AllocTensor<half>();
        DataCopy(in1, x1Global[offset], count);
        DataCopy(in2, x2Global[offset], count);
        queIn1.EnQue(in1);
        queIn2.EnQue(in2);

        LocalTensor<half> in1Deq = queIn1.DeQue<half>();
        LocalTensor<half> in2Deq = queIn2.DeQue<half>();
        LocalTensor<half> out = queOut.AllocTensor<half>();
        Add(out, in1Deq, in2Deq, count);
        queOut.EnQue(out);

        queIn1.FreeTensor(in1Deq);
        queIn2.FreeTensor(in2Deq);

        LocalTensor<half> outDeq = queOut.DeQue<half>();
        DataCopy(yGlobal[offset], outDeq, count);
        queOut.FreeTensor(outDeq);
    }
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1, GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y, int64_t availableCoreNum, aclrtStream stream)
{
    int64_t totalElems = 256 * 256;
    if (info_x1.numTensors > 0) {
        const TensorInfo& t = info_x1.tensors[0];
        totalElems = 1;
        for (int64_t i = 0; i < t.numDims; i++) {
            totalElems *= t.shape[i];
        }
    }

    const int64_t chunkElems = 16;
    int64_t maxBlocks = totalElems / chunkElems;
    int64_t blockNum = availableCoreNum;
    if (blockNum > maxBlocks) blockNum = maxBlocks;
    if (blockNum < 1) blockNum = 1;
    while (blockNum > 1 && (maxBlocks % blockNum != 0)) blockNum--;

    add_custom<<<blockNum, nullptr, stream>>>(x1, x2, y, totalElems);
}