#include <cmath>
#include "kernel_operator.h"
/*
 * Add Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 */

using namespace AscendC;

constexpr int32_t TOTAL_ELEMENTS = 256 * 256;   // 65536
constexpr int32_t ELEMS_PER_BLOCK = 16;          // half: 16 elements = 32 bytes (32B aligned)

// Kernel function: each block handles a 32-byte-aligned portion of the data
__global__ __vector__ void add_custom(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    int32_t totalElements, int32_t blockNum)
{
    int32_t coreIdx = GetBlockIdx();
    // Partition data in units of 16 elements (32B) to keep DataCopy count 32B aligned
    int32_t granuleTotal = totalElements / ELEMS_PER_BLOCK;
    int32_t granulePerCore = granuleTotal / blockNum;
    int32_t granuleRem = granuleTotal % blockNum;
    int32_t thisGranule = granulePerCore + (coreIdx < granuleRem ? 1 : 0);
    int32_t thisLen = thisGranule * ELEMS_PER_BLOCK;                    // multiple of 16
    int32_t offset = (coreIdx * granulePerCore +
                      (coreIdx < granuleRem ? coreIdx : granuleRem)) * ELEMS_PER_BLOCK;

    // Set up global tensor views
    GlobalTensor<half> x1Gm;
    GlobalTensor<half> x2Gm;
    GlobalTensor<half> yGm;
    x1Gm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x1) + offset, thisLen);
    x2Gm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x2) + offset, thisLen);
    yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y) + offset, thisLen);

    // Set up local memory and pipe
    TPipe pipe;
    TBuf<QuePosition::VECIN> x1Buf, x2Buf;
    TBuf<QuePosition::VECOUT> yBuf;

    pipe.InitBuffer(x1Buf, thisLen * sizeof(half));
    pipe.InitBuffer(x2Buf, thisLen * sizeof(half));
    pipe.InitBuffer(yBuf, thisLen * sizeof(half));

    // Copy input from Global to Local
    DataCopy(x1Buf.Get<half>(), x1Gm, thisLen);
    DataCopy(x2Buf.Get<half>(), x2Gm, thisLen);

    // Compute: y = x1 + x2 (element-wise)
    Add(yBuf.Get<half>(), x1Buf.Get<half>(), x2Buf.Get<half>(), thisLen);

    // Copy output from Local to Global
    DataCopy(yGm, yBuf.Get<half>(), thisLen);
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1,
                           GM_ADDR x2, const TensorGroupInfo& info_x2,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           int64_t availableCoreNum, aclrtStream stream)
{
    // Calculate block count: use up to availableCoreNum, but no more than 16-elem granules
    int32_t blockNum = static_cast<int32_t>(availableCoreNum);
    int32_t maxBlockNum = TOTAL_ELEMENTS / ELEMS_PER_BLOCK;
    if (blockNum > maxBlockNum) {
        blockNum = maxBlockNum;
    }

    // Launch kernel with multi-core parallelization
    add_custom<<<blockNum, nullptr, stream>>>(x1, x2, y, TOTAL_ELEMENTS, blockNum);
}