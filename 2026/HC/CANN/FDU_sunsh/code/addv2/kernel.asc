#include <cmath>
#include "kernel_operator.h"
/*
 * Add Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 *
 * 本题规格（固定）：x1/x2/y 均为 [256, 256] float16，ND 连续存储。
 * 总元素数 65536（4096 个 32B 对齐块），逐元素相加 y = x1 + x2。
 * 按可用核数将数据切分为 32 字节对齐的连续分块，每核循环搬运/计算/写回。
 */

using namespace AscendC;

constexpr int32_t BUFFER_NUM = 1;
constexpr int32_t TILE_LENGTH = 8192;   // 每次处理元素个数（half，16KB UB 缓冲）
constexpr int32_t ALIGN_ELEM = 16;      // 32B 对齐对应的 half 元素个数

class AddKernel {
public:
    __aicore__ inline AddKernel() {}
    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                uint32_t perCore16, uint32_t tailCoreNum)
    {
        // 大核（前 tailCoreNum 个核）比小核多处理 1 个 32B 块（16 个元素）
        uint32_t coreIdx = GetBlockIdx();
        uint32_t bigLen = (perCore16 + 1) * ALIGN_ELEM;
        uint32_t smallLen = perCore16 * ALIGN_ELEM;
        uint32_t coreStart = 0;
        uint32_t coreLength = 0;
        if (coreIdx < tailCoreNum) {
            coreStart = coreIdx * bigLen;
            coreLength = bigLen;
        } else {
            coreStart = tailCoreNum * bigLen + (coreIdx - tailCoreNum) * smallLen;
            coreLength = smallLen;
        }
        this->coreLength = coreLength;
        this->tileNum = coreLength / TILE_LENGTH;
        this->tailLength = coreLength % TILE_LENGTH;

        x1Gm.SetGlobalBuffer((__gm__ half*)x1 + coreStart, coreLength);
        x2Gm.SetGlobalBuffer((__gm__ half*)x2 + coreStart, coreLength);
        yGm.SetGlobalBuffer((__gm__ half*)y + coreStart, coreLength);

        pipe.InitBuffer(inQueueX, BUFFER_NUM, TILE_LENGTH * sizeof(half));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, TILE_LENGTH * sizeof(half));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, TILE_LENGTH * sizeof(half));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < this->tileNum; i++) {
            CopyIn(i, TILE_LENGTH);
            Compute(TILE_LENGTH);
            CopyOut(i, TILE_LENGTH);
        }
        if (this->tailLength > 0) {
            CopyIn(this->tileNum, this->tailLength);
            Compute(this->tailLength);
            CopyOut(this->tileNum, this->tailLength);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t tileIdx, uint32_t length)
    {
        LocalTensor<half> xLocal = inQueueX.AllocTensor<half>();
        LocalTensor<half> yLocal = inQueueY.AllocTensor<half>();
        DataCopy(xLocal, x1Gm[tileIdx * TILE_LENGTH], length);
        DataCopy(yLocal, x2Gm[tileIdx * TILE_LENGTH], length);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }
    __aicore__ inline void Compute(uint32_t length)
    {
        LocalTensor<half> xLocal = inQueueX.DeQue<half>();
        LocalTensor<half> yLocal = inQueueY.DeQue<half>();
        LocalTensor<half> zLocal = outQueueZ.AllocTensor<half>();
        Add(zLocal, xLocal, yLocal, length);
        outQueueZ.EnQue(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }
    __aicore__ inline void CopyOut(uint32_t tileIdx, uint32_t length)
    {
        LocalTensor<half> zLocal = outQueueZ.DeQue<half>();
        DataCopy(yGm[tileIdx * TILE_LENGTH], zLocal, length);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    TPipe pipe;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueX, inQueueY;
    TQue<QuePosition::VECOUT, BUFFER_NUM> outQueueZ;
    GlobalTensor<half> x1Gm;
    GlobalTensor<half> x2Gm;
    GlobalTensor<half> yGm;
    uint32_t coreLength;
    uint32_t tileNum;
    uint32_t tailLength;
};

__global__ __vector__ void add_custom(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                      uint32_t perCore16, uint32_t tailCoreNum)
{
    AddKernel op;
    op.Init(x1, x2, y, perCore16, tailCoreNum);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1, GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y, int64_t availableCoreNum, aclrtStream stream)
{
    // 固定 shape [256, 256]，总元素数 = 65536；从元数据读取以保持通用
    int64_t totalLength = 1;
    for (int64_t i = 0; i < info_x1.tensors[0].numDims; i++) {
        totalLength *= info_x1.tensors[0].shape[i];
    }

    // 以 32B（16 个 half 元素）为最小分块单位
    int64_t elem16 = totalLength / ALIGN_ELEM;
    int64_t blockNum = availableCoreNum;
    if (blockNum > elem16) {
        blockNum = elem16;
    }
    if (blockNum <= 0) {
        blockNum = 1;
    }

    int64_t perCore16 = elem16 / blockNum;
    int64_t tailCoreNum = elem16 % blockNum;

    add_custom<<<blockNum, nullptr, stream>>>(x1, x2, y,
                                              (uint32_t)perCore16, (uint32_t)tailCoreNum);
}
