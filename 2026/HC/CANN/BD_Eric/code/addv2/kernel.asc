#include "kernel_operator.h"

using namespace AscendC;

/*
 * Add Kernel — Ascend C Direct Invocation
 * y = x1 + x2, element-wise, all tensors shape [256, 256], dtype half.
 *
 * Architecture: SIMD MemBase, single core, tile-based processing.
 * Data flow: GM --DataCopy--> VECIN queues --Add--> VECOUT queue --DataCopy--> GM
 *
 * Uses tiling (TILE_LEN=8192 elements) to keep UB footprint small:
 *   buffer per queue = TILE_LEN * sizeof(half) = 8192 * 2 = 16KB
 *   peak 3 buffers = 48KB  (well within UB limits)
 */

constexpr int32_t TILE_LEN = 8192;

class KernelAdd {
public:
    __aicore__ inline KernelAdd() {}

    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, int64_t totalLen)
    {
        n = static_cast<int32_t>(totalLen);

        // Bind GM_ADDR to GlobalTensors for subscript-based DataCopy
        x1Gm.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(x1), n);
        x2Gm.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(x2), n);
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y), n);

        // Allocate UB buffers: small per-tile size
        pipe.InitBuffer(queX1, 1, TILE_LEN * sizeof(half));
        pipe.InitBuffer(queX2, 1, TILE_LEN * sizeof(half));
        pipe.InitBuffer(queY, 1, TILE_LEN * sizeof(half));
    }

    __aicore__ inline void Process()
    {
        int32_t tileNum = (n + TILE_LEN - 1) / TILE_LEN;
        for (int32_t i = 0; i < tileNum; i++) {
            int32_t count = (i == tileNum - 1) ? (n - i * TILE_LEN) : TILE_LEN;
            CopyIn(i, count);
            Compute(count);
            CopyOut(i, count);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t blockIdx, int32_t count)
    {
        LocalTensor<half> x1Local = queX1.AllocTensor<half>();
        LocalTensor<half> x2Local = queX2.AllocTensor<half>();
        // DataCopy using subscript GlobalTensor slice
        DataCopy(x1Local, x1Gm[blockIdx * TILE_LEN], count);
        DataCopy(x2Local, x2Gm[blockIdx * TILE_LEN], count);
        queX1.EnQue(x1Local);
        queX2.EnQue(x2Local);
    }

    __aicore__ inline void Compute(int32_t count)
    {
        LocalTensor<half> x1Local = queX1.DeQue<half>();
        LocalTensor<half> x2Local = queX2.DeQue<half>();
        LocalTensor<half> yLocal = queY.AllocTensor<half>();
        Add(yLocal, x1Local, x2Local, count);
        queY.EnQue(yLocal);
        queX1.FreeTensor(x1Local);
        queX2.FreeTensor(x2Local);
    }

    __aicore__ inline void CopyOut(int32_t blockIdx, int32_t count)
    {
        LocalTensor<half> yLocal = queY.DeQue<half>();
        DataCopy(yGm[blockIdx * TILE_LEN], yLocal, count);
        queY.FreeTensor(yLocal);
    }

    TPipe pipe;
    TQue<TPosition::VECIN, 1> queX1;
    TQue<TPosition::VECIN, 1> queX2;
    TQue<TPosition::VECOUT, 1> queY;
    GlobalTensor<half> x1Gm;
    GlobalTensor<half> x2Gm;
    GlobalTensor<half> yGm;
    int32_t n;
};

__global__ __vector__ void add_custom(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, int64_t totalLen)
{
    KernelAdd op;
    op.Init(x1, x2, y, totalLen);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1, GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y, int64_t availableCoreNum, aclrtStream stream)
{
    // Compute element count N from x1's shape (256 * 256 = 65536 for this case)
    int64_t N = 1;
    for (int64_t i = 0; i < info_x1.tensors[0].numDims; ++i) {
        N *= info_x1.tensors[0].shape[i];
    }

    // Single core / single block launch
    add_custom<<<1, nullptr, stream>>>(x1, x2, y, N);
}