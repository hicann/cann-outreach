#include <cmath>
#include "kernel_operator.h"

using namespace AscendC;

/*
 * Add Kernel — Ascend C Direct Invocation
 *
 * Fixed-shape Add: x1 + x2 -> y, shape=[256,256], dtype=float16
 * Multi-block parallelization with chunked UB processing.
 *
 * DataCopy signature (Level 2):
 *   DataCopy(dstLocal, srcGlobal, count)   // count = elements, 32B-aligned
 *   DataCopy(dstGlobal, srcLocal, count)
 * Add signature (Level 2):
 *   Add(dstLocal, src0Local, src1Local, count)  // count = elements
 */

constexpr int32_t CHUNK_ELEMS = 4096;   // elements per UB chunk (4096 fp16 = 8KB)

class KernelAdd {
public:
    __aicore__ inline KernelAdd() {}
    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                 int64_t totalLen, int64_t blockLen)
    {
        int64_t blockIdx = GetBlockIdx();
        int64_t start = blockIdx * blockLen;
        int64_t end = (start + blockLen > totalLen) ? totalLen : start + blockLen;
        this->len = end - start;
        if (this->len <= 0) return;
        // Set global tensor views for this block's segment
        gmX1.SetGlobalBuffer((__gm__ half*)x1 + start, this->len);
        gmX2.SetGlobalBuffer((__gm__ half*)x2 + start, this->len);
        gmY.SetGlobalBuffer((__gm__ half*)y + start, this->len);
        // Init UB buffers (1 block each)
        pipe.InitBuffer(inQueueX1, 1, CHUNK_ELEMS * sizeof(half));
        pipe.InitBuffer(inQueueX2, 1, CHUNK_ELEMS * sizeof(half));
        pipe.InitBuffer(outQueueY, 1, CHUNK_ELEMS * sizeof(half));
    }

    __aicore__ inline void Process()
    {
        if (len <= 0) return;
        int64_t offset = 0;
        while (offset < len) {
            int64_t curLen = (len - offset > CHUNK_ELEMS) ? CHUNK_ELEMS : (len - offset);
            // Stage 1: CopyIn GM -> VECIN
            LocalTensor<half> x1Local = inQueueX1.AllocTensor<half>();
            LocalTensor<half> x2Local = inQueueX2.AllocTensor<half>();
            DataCopy(x1Local, gmX1[offset], curLen);
            DataCopy(x2Local, gmX2[offset], curLen);
            inQueueX1.EnQue(x1Local);
            inQueueX2.EnQue(x2Local);
            // Stage 2: Compute Add on VECOUT
            LocalTensor<half> x1Get = inQueueX1.DeQue<half>();
            LocalTensor<half> x2Get = inQueueX2.DeQue<half>();
            LocalTensor<half> yLocal = outQueueY.AllocTensor<half>();
            Add(yLocal, x1Get, x2Get, curLen);
            outQueueY.EnQue(yLocal);
            inQueueX1.FreeTensor(x1Get);
            inQueueX2.FreeTensor(x2Get);
            // Stage 3: CopyOut VECOUT -> GM
            LocalTensor<half> yGet = outQueueY.DeQue<half>();
            DataCopy(gmY[offset], yGet, curLen);
            outQueueY.FreeTensor(yGet);
            offset += curLen;
        }
    }

private:
    TPipe pipe;
    TQue<QuePosition::VECIN, 1> inQueueX1, inQueueX2;
    TQue<QuePosition::VECOUT, 1> outQueueY;
    GlobalTensor<half> gmX1, gmX2, gmY;
    int64_t len;
};

// Kernel entry point — launched on each block
extern "C" __global__ __vector__ void add_custom(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    int64_t totalLength, int64_t blockLength)
{
    KernelAdd op;
    op.Init(x1, x2, y, totalLength, blockLength);
    op.Process();
}

// Largest power of two <= x (x >= 1). Returns 1 for x <= 1.
static inline int64_t FloorPow2(int64_t x)
{
    if (x <= 1) return 1;
    int64_t p = 1;
    while (p <= x) p <<= 1;
    return p >> 1;
}

// Host-side launcher — called from main.asc
extern "C" void run_kernel(
    GM_ADDR x1, const TensorGroupInfo& info_x1,
    GM_ADDR x2, const TensorGroupInfo& info_x2,
    GM_ADDR y, const TensorGroupInfo& info_y,
    int64_t availableCoreNum, aclrtStream stream)
{
    // Compute total length from shape info (fixed [256, 256] for this problem)
    int64_t totalLength = 1;
    for (int64_t d = 0; d < info_x1.tensors[0].numDims; d++) {
        totalLength *= info_x1.tensors[0].shape[d];
    }
    // Use power-of-2 block count to ensure even division and 32B alignment
    int64_t blockNum = FloorPow2(availableCoreNum);
    if (blockNum > totalLength) blockNum = totalLength;
    int64_t blockLength = totalLength / blockNum;
    // Launch kernel
    add_custom<<<blockNum, nullptr, stream>>>(x1, x2, y, totalLength, blockLength);
}