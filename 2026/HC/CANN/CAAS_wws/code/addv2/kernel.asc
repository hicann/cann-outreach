#include <cmath>
#include "kernel_operator.h"
/*
 * Add Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *
 * 赛题规格：x1/x2/y shape=[256,256]，dtype=float16（65536 个元素，连续存储）。
 * 实现 y = x1 + x2：Host 在 run_kernel 中按 availableCoreNum 做均分切分，
 * 每个 block 负责连续 blockLength 个元素，block 内按 tileLength 分块
 * 搬入 UB -> 向量 Add -> 搬回 GM（double buffer 流水）。
 */

using namespace AscendC;

namespace {
constexpr int32_t BUFFER_NUM = 2;      // 输入/输出队列深度（双缓冲）
}

class KernelAdd {
public:
    __aicore__ inline KernelAdd() {}

    __aicore__ inline void Init(
        GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
        uint32_t blockLength, uint32_t tileLength)
    {
        const uint32_t blockOffset = blockLength * AscendC::GetBlockIdx();

        x1Gm.SetGlobalBuffer((__gm__ half*)x1 + blockOffset, blockLength);
        x2Gm.SetGlobalBuffer((__gm__ half*)x2 + blockOffset, blockLength);
        yGm.SetGlobalBuffer((__gm__ half*)y + blockOffset, blockLength);

        pipe.InitBuffer(inQueueX1, BUFFER_NUM, tileLength * sizeof(half));
        pipe.InitBuffer(inQueueX2, BUFFER_NUM, tileLength * sizeof(half));
        pipe.InitBuffer(outQueueY, BUFFER_NUM, tileLength * sizeof(half));

        tileLength_ = tileLength;
        loopCount_ = blockLength / tileLength;
    }

    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < loopCount_; ++i) {
            CopyIn(i);
            Compute();
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t progress)
    {
        LocalTensor<half> x1Local = inQueueX1.AllocTensor<half>();
        LocalTensor<half> x2Local = inQueueX2.AllocTensor<half>();

        const uint32_t offset = progress * tileLength_;
        AscendC::DataCopy(x1Local, x1Gm[offset], tileLength_);
        AscendC::DataCopy(x2Local, x2Gm[offset], tileLength_);

        inQueueX1.EnQue(x1Local);
        inQueueX2.EnQue(x2Local);
    }

    __aicore__ inline void Compute()
    {
        LocalTensor<half> x1Local = inQueueX1.DeQue<half>();
        LocalTensor<half> x2Local = inQueueX2.DeQue<half>();
        LocalTensor<half> yLocal = outQueueY.AllocTensor<half>();

        AscendC::Add(yLocal, x1Local, x2Local, tileLength_);

        outQueueY.EnQue(yLocal);
        inQueueX1.FreeTensor(x1Local);
        inQueueX2.FreeTensor(x2Local);
    }

    __aicore__ inline void CopyOut(uint32_t progress)
    {
        LocalTensor<half> yLocal = outQueueY.DeQue<half>();

        const uint32_t offset = progress * tileLength_;
        AscendC::DataCopy(yGm[offset], yLocal, tileLength_);

        outQueueY.FreeTensor(yLocal);
    }

private:
    TPipe pipe;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueX1;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueX2;
    TQue<QuePosition::VECOUT, BUFFER_NUM> outQueueY;
    GlobalTensor<half> x1Gm;
    GlobalTensor<half> x2Gm;
    GlobalTensor<half> yGm;
    uint32_t tileLength_ = 0;
    uint32_t loopCount_ = 0;
};

extern "C" __global__ __aicore__ void add_custom(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    uint32_t blockLength, uint32_t tileLength)
{
    KernelAdd op;
    op.Init(x1, x2, y, blockLength, tileLength);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1, GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y, int64_t availableCoreNum, aclrtStream stream)
{
    // 赛题固定规格：[256, 256] float16，共 65536 个元素。
    constexpr uint32_t totalLength = 256 * 256;
    // 每 tile 元素数：2048 个 half = 4KB，保证 32 字节对齐且远小于 UB 容量。
    constexpr uint32_t tileLength = 2048;

    // 使用不超过 totalLength / tileLength 的最大 2 的幂作为 blockNum，
    // 确保每个 block 的 blockLength 为 tileLength 的整数倍，可整除、无剩余。
    int64_t maxBlockNum = static_cast<int64_t>(totalLength / tileLength);
    int64_t blockNum = 1;
    int64_t cap = availableCoreNum > 0 ? availableCoreNum : 1;
    if (cap > maxBlockNum) {
        cap = maxBlockNum;
    }
    while (blockNum * 2 <= cap) {
        blockNum *= 2;
    }

    const uint32_t blockLength = totalLength / static_cast<uint32_t>(blockNum);

    add_custom<<<blockNum, nullptr, stream>>>(x1, x2, y, blockLength, tileLength);
}
