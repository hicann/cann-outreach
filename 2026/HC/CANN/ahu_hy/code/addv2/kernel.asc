#include "kernel_operator.h"
using namespace AscendC;

constexpr int32_t TOTAL_LENGTH = 256 * 256;
constexpr int32_t TILE_LENGTH = 2048;
constexpr int32_t TILE_NUM = TOTAL_LENGTH / TILE_LENGTH;
constexpr int32_t BUFFER_NUM = 2;

class AddKernel {
public:
    __aicore__ inline AddKernel() {}

    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y) {
        x1Gm.SetGlobalBuffer((__gm__ half*)x1, TOTAL_LENGTH);
        x2Gm.SetGlobalBuffer((__gm__ half*)x2, TOTAL_LENGTH);
        yGm.SetGlobalBuffer((__gm__ half*)y, TOTAL_LENGTH);
        pipe.InitBuffer(inQueueX1, BUFFER_NUM, TILE_LENGTH * sizeof(half));
        pipe.InitBuffer(inQueueX2, BUFFER_NUM, TILE_LENGTH * sizeof(half));
        pipe.InitBuffer(bufFp32X1, TILE_LENGTH * sizeof(float));
        pipe.InitBuffer(bufFp32X2, TILE_LENGTH * sizeof(float));
        pipe.InitBuffer(bufFp32Y, TILE_LENGTH * sizeof(float));
        pipe.InitBuffer(outQueueY, BUFFER_NUM, TILE_LENGTH * sizeof(half));
    }

    __aicore__ inline void CopyIn(uint32_t tile) {
        LocalTensor<half> x1Local = inQueueX1.AllocTensor<half>();
        LocalTensor<half> x2Local = inQueueX2.AllocTensor<half>();
        DataCopy(x1Local, x1Gm[tile * TILE_LENGTH], TILE_LENGTH);
        DataCopy(x2Local, x2Gm[tile * TILE_LENGTH], TILE_LENGTH);
        inQueueX1.EnQue(x1Local);
        inQueueX2.EnQue(x2Local);
    }

    __aicore__ inline void Compute() {
        LocalTensor<half> x1Local = inQueueX1.DeQue<half>();
        LocalTensor<half> x2Local = inQueueX2.DeQue<half>();

        LocalTensor<float> x1Fp32 = bufFp32X1.Get<float>();
        LocalTensor<float> x2Fp32 = bufFp32X2.Get<float>();
        Cast(x1Fp32, x1Local, RoundMode::CAST_NONE, TILE_LENGTH);
        Cast(x2Fp32, x2Local, RoundMode::CAST_NONE, TILE_LENGTH);

        LocalTensor<float> yFp32 = bufFp32Y.Get<float>();
        Add(yFp32, x1Fp32, x2Fp32, TILE_LENGTH);

        LocalTensor<half> yLocal = outQueueY.AllocTensor<half>();
        Cast(yLocal, yFp32, RoundMode::CAST_NONE, TILE_LENGTH);

        inQueueX1.FreeTensor(x1Local);
        inQueueX2.FreeTensor(x2Local);
        outQueueY.EnQue(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t tile) {
        LocalTensor<half> yLocal = outQueueY.DeQue<half>();
        DataCopy(yGm[tile * TILE_LENGTH], yLocal, TILE_LENGTH);
        outQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void Process() {
        for (uint32_t i = 0; i < TILE_NUM; i++) {
            CopyIn(i);
            Compute();
            CopyOut(i);
        }
    }

private:
    TPipe pipe;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueX1;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueX2;
    TBuf<QuePosition::VECCALC> bufFp32X1;
    TBuf<QuePosition::VECCALC> bufFp32X2;
    TBuf<QuePosition::VECCALC> bufFp32Y;
    TQue<QuePosition::VECOUT, BUFFER_NUM> outQueueY;
    GlobalTensor<half> x1Gm;
    GlobalTensor<half> x2Gm;
    GlobalTensor<half> yGm;
};

__global__ __vector__ void add_custom(GM_ADDR x1, GM_ADDR x2, GM_ADDR y)
{
    AddKernel add;
    add.Init(x1, x2, y);
    add.Process();
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1, GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y, int64_t availableCoreNum, aclrtStream stream)
{
    add_custom<<<1, nullptr, stream>>>(x1, x2, y);
}
