#include <cmath>
#include "kernel_operator.h"

using namespace AscendC;

/*
 * Add Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * Fixed problem: x1/x2/y shape=[256, 256], dtype=float16.
 * totalLength = 65536 elements; each AI core owns a contiguous, equally sized
 * global-memory interval; the interval is processed in 32-byte aligned tiles
 * (2048 half elements per tile) through a double-buffered CopyIn->Compute->CopyOut
 * pipeline.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 */

constexpr int32_t BUFFER_NUM = 2;              // double buffer per queue
constexpr int64_t DEFAULT_TILE_LENGTH = 2048;  // half elements per tile (4096 B, 32-byte aligned)

class KernelAdd {
public:
    __aicore__ inline KernelAdd() {}

    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                int64_t totalLength, int64_t blockNum)
    {
        // Each block owns a disjoint, equally sized GM interval.
        const int64_t blockIdx = GetBlockIdx();
        const int64_t perBlockBase = totalLength / blockNum;
        const int64_t remainder = totalLength % blockNum;
        start_ = blockIdx * perBlockBase + (blockIdx < remainder ? blockIdx : remainder);
        length_ = perBlockBase + (blockIdx < remainder ? 1 : 0);

        tileLength_ = (length_ < DEFAULT_TILE_LENGTH) ? length_ : DEFAULT_TILE_LENGTH;
        // Round down to nearest multiple of 16 half elements (32-byte aligned).
        tileLength_ = (tileLength_ / 16) * 16;
        if (tileLength_ <= 0) {
            tileLength_ = length_;
        }
        tileNum_ = static_cast<int32_t>((length_ + tileLength_ - 1) / tileLength_);

        x1Gm.SetGlobalBuffer((__gm__ half *)x1 + start_, length_);
        x2Gm.SetGlobalBuffer((__gm__ half *)x2 + start_, length_);
        yGm.SetGlobalBuffer((__gm__ half *)y + start_, length_);

        pipe.InitBuffer(inQueueX1, BUFFER_NUM, tileLength_ * sizeof(half));
        pipe.InitBuffer(inQueueX2, BUFFER_NUM, tileLength_ * sizeof(half));
        pipe.InitBuffer(outQueueY, BUFFER_NUM, tileLength_ * sizeof(half));
    }

    __aicore__ inline void Process()
    {
        for (int32_t tile = 0; tile < tileNum_; ++tile) {
            const int64_t offset = static_cast<int64_t>(tile) * tileLength_;
            int64_t copyLen = length_ - offset;
            if (copyLen > tileLength_) {
                copyLen = tileLength_;
            }
            CopyIn(offset, copyLen);
            Compute(copyLen);
            CopyOut(offset, copyLen);
        }
    }

private:
    __aicore__ inline void CopyIn(int64_t offset, int64_t copyLen)
    {
        LocalTensor<half> x1Local = inQueueX1.AllocTensor<half>();
        LocalTensor<half> x2Local = inQueueX2.AllocTensor<half>();
        DataCopy(x1Local, x1Gm[offset], copyLen);
        DataCopy(x2Local, x2Gm[offset], copyLen);
        inQueueX1.EnQue(x1Local);
        inQueueX2.EnQue(x2Local);
    }

    __aicore__ inline void Compute(int64_t copyLen)
    {
        LocalTensor<half> x1Local = inQueueX1.DeQue<half>();
        LocalTensor<half> x2Local = inQueueX2.DeQue<half>();
        LocalTensor<half> yLocal = outQueueY.AllocTensor<half>();
        Add(yLocal, x1Local, x2Local, copyLen);
        outQueueY.EnQue<half>(yLocal);
        inQueueX1.FreeTensor(x1Local);
        inQueueX2.FreeTensor(x2Local);
    }

    __aicore__ inline void CopyOut(int64_t offset, int64_t copyLen)
    {
        LocalTensor<half> yLocal = outQueueY.DeQue<half>();
        DataCopy(yGm[offset], yLocal, copyLen);
        outQueueY.FreeTensor(yLocal);
    }

private:
    TPipe pipe;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueX1;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueX2;
    TQue<TPosition::VECOUT, BUFFER_NUM> outQueueY;
    GlobalTensor<half> x1Gm;
    GlobalTensor<half> x2Gm;
    GlobalTensor<half> yGm;
    int64_t start_ = 0;
    int64_t length_ = 0;
    int64_t tileLength_ = 0;
    int32_t tileNum_ = 0;
};

__global__ __vector__ void add_custom(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                      int64_t totalLength, int64_t blockNum)
{
    KernelAdd op;
    op.Init(x1, x2, y, totalLength, blockNum);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1, GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y, int64_t availableCoreNum, aclrtStream stream)
{
    // Compute the flattened element count from the shape of input x1.
    const TensorInfo& x1Info = info_x1.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < x1Info.numDims; ++i) {
        totalLength *= x1Info.shape[i];
    }

    // Choose a power-of-two block count that fits in the available AI cores
    // and keeps each block's interval reasonably large (>= 1024 elements).
    int64_t blockNum = 1;
    if (availableCoreNum > 0) {
        while (blockNum * 2 <= availableCoreNum && (totalLength / (blockNum * 2)) >= 1024) {
            blockNum *= 2;
        }
    }

    add_custom<<<blockNum, nullptr, stream>>>(x1, x2, y, totalLength, blockNum);
}