#include <cmath>
#include "kernel_operator.h"
/*
 * Add Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 */

using namespace AscendC;

constexpr int64_t TOTAL_LENGTH = 256 * 256;  // 65536 elements, fixed shape [256, 256]

__global__ __vector__ void add_custom(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, int64_t totalLength)
{
    // 每个核处理一块连续数据
    int64_t blockLength = totalLength / GetBlockNum();
    int64_t blockOffset = blockLength * GetBlockIdx();

    TPipe pipe;
    TQue<TPosition::VECIN, 1> inQueueX1;
    TQue<TPosition::VECIN, 1> inQueueX2;
    TQue<TPosition::VECOUT, 1> outQueueY;

    GlobalTensor<half> x1Gm;
    GlobalTensor<half> x2Gm;
    GlobalTensor<half> yGm;
    x1Gm.SetGlobalBuffer((__gm__ half *)x1 + blockOffset, blockLength);
    x2Gm.SetGlobalBuffer((__gm__ half *)x2 + blockOffset, blockLength);
    yGm.SetGlobalBuffer((__gm__ half *)y + blockOffset, blockLength);

    pipe.InitBuffer(inQueueX1, 1, blockLength * sizeof(half));
    pipe.InitBuffer(inQueueX2, 1, blockLength * sizeof(half));
    pipe.InitBuffer(outQueueY, 1, blockLength * sizeof(half));

    // CopyIn: GM -> Local
    LocalTensor<half> x1Local = inQueueX1.AllocTensor<half>();
    LocalTensor<half> x2Local = inQueueX2.AllocTensor<half>();
    DataCopy(x1Local, x1Gm, blockLength);
    DataCopy(x2Local, x2Gm, blockLength);
    inQueueX1.EnQue(x1Local);
    inQueueX2.EnQue(x2Local);

    // Compute: y = x1 + x2
    x1Local = inQueueX1.DeQue<half>();
    x2Local = inQueueX2.DeQue<half>();
    LocalTensor<half> yLocal = outQueueY.AllocTensor<half>();
    Add(yLocal, x1Local, x2Local, blockLength);
    outQueueY.EnQue(yLocal);
    inQueueX1.FreeTensor(x1Local);
    inQueueX2.FreeTensor(x2Local);

    // CopyOut: Local -> GM
    yLocal = outQueueY.DeQue<half>();
    DataCopy(yGm, yLocal, blockLength);
    outQueueY.FreeTensor(yLocal);
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1, GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y, int64_t availableCoreNum, aclrtStream stream)
{
    // 选择不超过 availableCoreNum 的最大 2 的幂作为 blockNum，
    // 保证 65536 能被 blockNum 整除且每块长度 >= 16（half 类型 32 字节对齐）。
    int64_t coreNum = (availableCoreNum > 0) ? availableCoreNum : 1;
    int64_t maxBlocks = TOTAL_LENGTH / 16;  // 每块至少 16 个 half 元素，保持 32 字节对齐
    int64_t blockNum = 1;
    while (blockNum * 2 <= coreNum && blockNum * 2 <= maxBlocks) {
        blockNum *= 2;
    }

    add_custom<<<(uint32_t)blockNum, nullptr, stream>>>(x1, x2, y, TOTAL_LENGTH);
}
