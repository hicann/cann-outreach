#include <cmath>
#include "kernel_operator.h"
/*
 * Add Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *
 * __global__ __vector__ void add_custom(...)
 */

using namespace AscendC;

constexpr int32_t TILE_LENGTH = 8192;  // 每个 tile 参与计算的元素个数（fp16）
constexpr int32_t BUFFER_NUM = 2;      // 双缓冲

class KernelAdd {
public:
    __aicore__ inline KernelAdd() {}

    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                int64_t blockStart, int64_t blockLength,
                                TPipe* pipeIn)
    {
        pipe = pipeIn;
        x1Gm.SetGlobalBuffer((__gm__ half *)x1 + blockStart);
        x2Gm.SetGlobalBuffer((__gm__ half *)x2 + blockStart);
        yGm.SetGlobalBuffer((__gm__ half *)y + blockStart);
        this->blockLength = blockLength;
        this->tileCount = static_cast<int32_t>((blockLength + TILE_LENGTH - 1) / TILE_LENGTH);

        pipe->InitBuffer(inQueX1, BUFFER_NUM, TILE_LENGTH * sizeof(half));
        pipe->InitBuffer(inQueX2, BUFFER_NUM, TILE_LENGTH * sizeof(half));
        pipe->InitBuffer(outQueY, BUFFER_NUM, TILE_LENGTH * sizeof(half));
    }

    __aicore__ inline void Process()
    {
        for (int32_t i = 0; i < tileCount; i++) {
            int64_t offset = static_cast<int64_t>(i) * TILE_LENGTH;
            int32_t curLen = static_cast<int32_t>(
                (offset + TILE_LENGTH <= blockLength) ? TILE_LENGTH : (blockLength - offset));
            CopyIn(i, curLen);
            Compute(curLen);
            CopyOut(i, curLen);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t idx, int32_t curLen)
    {
        LocalTensor<half> x1Local = inQueX1.AllocTensor<half>();
        LocalTensor<half> x2Local = inQueX2.AllocTensor<half>();
        DataCopy(x1Local, x1Gm[static_cast<int64_t>(idx) * TILE_LENGTH], curLen);
        DataCopy(x2Local, x2Gm[static_cast<int64_t>(idx) * TILE_LENGTH], curLen);
        inQueX1.EnQue(x1Local);
        inQueX2.EnQue(x2Local);
    }

    __aicore__ inline void Compute(int32_t curLen)
    {
        LocalTensor<half> x1Local = inQueX1.DeQue<half>();
        LocalTensor<half> x2Local = inQueX2.DeQue<half>();
        LocalTensor<half> yLocal = outQueY.AllocTensor<half>();
        // 按元素求和：dst = src0 + src1，参与计算的元素个数为 curLen
        Add(yLocal, x1Local, x2Local, curLen);
        inQueX1.FreeTensor(x1Local);
        inQueX2.FreeTensor(x2Local);
        outQueY.EnQue(yLocal);
    }

    __aicore__ inline void CopyOut(int32_t idx, int32_t curLen)
    {
        LocalTensor<half> yLocal = outQueY.DeQue<half>();
        DataCopy(yGm[static_cast<int64_t>(idx) * TILE_LENGTH], yLocal, curLen);
        outQueY.FreeTensor(yLocal);
    }

private:
    TPipe* pipe;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueX1;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueX2;
    TQue<QuePosition::VECOUT, BUFFER_NUM> outQueY;
    GlobalTensor<half> x1Gm;
    GlobalTensor<half> x2Gm;
    GlobalTensor<half> yGm;
    int64_t blockLength;
    int32_t tileCount;
};

extern "C" __global__ __vector__ void add_custom(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                                 int64_t totalLength, int64_t blockNum)
{
    if (totalLength <= 0 || blockNum <= 0) {
        return;
    }

    int64_t coreIdx = GetBlockIdx();
    // 将 totalLength 个元素尽量均匀地划分给 blockNum 个核；
    // 每个核的起始偏移和长度对齐到 16 个元素（fp16，32 字节），保证搬运/计算地址对齐。
    int64_t perCore = (totalLength + blockNum - 1) / blockNum;
    perCore = ((perCore + 15) / 16) * 16;

    int64_t blockStart = coreIdx * perCore;
    if (blockStart >= totalLength) {
        return;
    }
    int64_t blockLength = perCore;
    if (blockStart + blockLength > totalLength) {
        blockLength = totalLength - blockStart;
    }
    if (blockLength <= 0) {
        return;
    }

    TPipe pipe;
    KernelAdd op;
    op.Init(x1, x2, y, blockStart, blockLength, &pipe);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1, GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y, int64_t availableCoreNum, aclrtStream stream)
{
    int64_t totalLength = 1;
    for (int64_t i = 0; i < info_x1.tensors[0].numDims; i++) {
        totalLength *= info_x1.tensors[0].shape[i];
    }
    if (totalLength <= 0) {
        return;
    }

    // 每个核至少处理一个 tile；最多使用 availableCoreNum 个核
    int64_t blockNum = (totalLength + TILE_LENGTH - 1) / TILE_LENGTH;
    if (availableCoreNum > 0 && availableCoreNum < blockNum) {
        blockNum = availableCoreNum;
    }
    if (blockNum <= 0) {
        blockNum = 1;
    }

    add_custom<<<blockNum, nullptr, stream>>>(x1, x2, y, totalLength, blockNum);
}
