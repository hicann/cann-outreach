#include <cmath>
#include "kernel_operator.h"
/*
 * Add Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 *
 * Fixed test case: x1/x2/y shape=[256, 256], dtype=float16, 65536 elements.
 * Pipeline: DataCopy (GM->Local) -> Add (vector) -> DataCopy (Local->GM).
 */

namespace {
constexpr int32_t BUFFER_NUM = 2;  // double buffering
constexpr int32_t TILE_LEN = 8192; // elements per tile (8192 * 2B = 16KB, fits UB)
}  // namespace

class KernelAddV2 {
public:
    __aicore__ inline KernelAddV2() {}
    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, int64_t totalLength)
    {
        int64_t blockNum = AscendC::GetBlockNum();
        int64_t blockIdx = AscendC::GetBlockIdx();
        // This block handles contiguous range [start, end)
        int64_t perBlock = (totalLength + blockNum - 1) / blockNum;
        int64_t start = blockIdx * perBlock;
        int64_t end = (start + perBlock > totalLength) ? totalLength : (start + perBlock);
        blockLength = (end > start) ? (end - start) : 0;
        tileNum = static_cast<int32_t>((blockLength + TILE_LEN - 1) / TILE_LEN);

        xGm.SetGlobalBuffer((__gm__ half *)x1 + start, blockLength);
        yGm.SetGlobalBuffer((__gm__ half *)x2 + start, blockLength);
        zGm.SetGlobalBuffer((__gm__ half *)y + start, blockLength);

        pipe.InitBuffer(inQueueX, BUFFER_NUM, TILE_LEN * sizeof(half));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, TILE_LEN * sizeof(half));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, TILE_LEN * sizeof(half));
    }
    __aicore__ inline void Process()
    {
        for (int32_t i = 0; i < tileNum; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline int32_t tileLen(int32_t tileIdx) const
    {
        int32_t remain = static_cast<int32_t>(blockLength - static_cast<int64_t>(tileIdx) * TILE_LEN);
        return (remain > TILE_LEN) ? TILE_LEN : remain;
    }
    __aicore__ inline void CopyIn(int32_t progress)
    {
        int32_t len = tileLen(progress);
        AscendC::LocalTensor<half> xLocal = inQueueX.AllocTensor<half>();
        AscendC::LocalTensor<half> yLocal = inQueueY.AllocTensor<half>();
        AscendC::DataCopy(xLocal, xGm[progress * TILE_LEN], len);
        AscendC::DataCopy(yLocal, yGm[progress * TILE_LEN], len);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }
    __aicore__ inline void Compute(int32_t progress)
    {
        AscendC::LocalTensor<half> xLocal = inQueueX.DeQue<half>();
        AscendC::LocalTensor<half> yLocal = inQueueY.DeQue<half>();
        AscendC::LocalTensor<half> zLocal = outQueueZ.AllocTensor<half>();
        AscendC::Add(zLocal, xLocal, yLocal, tileLen(progress));
        outQueueZ.EnQue<half>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }
    __aicore__ inline void CopyOut(int32_t progress)
    {
        AscendC::LocalTensor<half> zLocal = outQueueZ.DeQue<half>();
        AscendC::DataCopy(zGm[progress * TILE_LEN], zLocal, tileLen(progress));
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inQueueX, inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_NUM> outQueueZ;
    AscendC::GlobalTensor<half> xGm, yGm, zGm;
    int64_t blockLength;
    int32_t tileNum;
};

__global__ __vector__ void addv2_custom(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, int64_t totalLength)
{
    if (totalLength <= 0) {
        return;
    }
    KernelAddV2 op;
    op.Init(x1, x2, y, totalLength);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1, GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y, int64_t availableCoreNum, aclrtStream stream)
{
    // Fixed shape [256, 256] float16; compute element count from shape info.
    int64_t numElements = 1;
    const TensorInfo& tx1 = info_x1.tensors[0];
    for (int64_t i = 0; i < tx1.numDims; i++) {
        numElements *= tx1.shape[i];
    }
    // Cap the number of blocks: totalLength is 65536, TILE_LEN 8192 -> at most 8 blocks.
    int64_t blockNum = (availableCoreNum > 8) ? 8 : availableCoreNum;
    if (blockNum <= 0) {
        blockNum = 1;
    }
    addv2_custom<<<blockNum, nullptr, stream>>>(x1, x2, y, numElements);
}
