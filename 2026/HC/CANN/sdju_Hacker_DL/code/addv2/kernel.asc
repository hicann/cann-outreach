/*
 * AddV2 Kernel — Ascend C Direct Invocation
 * Fixed shape [256, 256], float16, single test case
 *
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8
 *          8=uint16 9=uint32 10=uint64 11=bool
 */

#include "kernel_operator.h"

using namespace AscendC;

constexpr uint32_t TOTAL_ELEMENTS = 256 * 256;  // 65536
constexpr uint32_t TILE_LENGTH = 4096;          // elements per tile (4096 * 2B = 8192B = 256 * 32B, aligned)
constexpr uint32_t BUFFER_NUM = 2;              // double buffer for pipelining

class AddKernel {
public:
    __aicore__ inline AddKernel() {}

    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                uint32_t blockLength)
    {
        totalLength = blockLength;

        // Initialize pipe and queues with double buffering
        pipe.InitBuffer(inQueueX1, BUFFER_NUM, TILE_LENGTH * sizeof(half));
        pipe.InitBuffer(inQueueX2, BUFFER_NUM, TILE_LENGTH * sizeof(half));
        pipe.InitBuffer(outQueueY, BUFFER_NUM, TILE_LENGTH * sizeof(half));

        // Set global buffer base addresses
        x1Global.SetGlobalBuffer((__gm__ half*)x1);
        x2Global.SetGlobalBuffer((__gm__ half*)x2);
        yGlobal.SetGlobalBuffer((__gm__ half*)y);
    }

    __aicore__ inline void Process()
    {
        uint32_t tiles = (totalLength + TILE_LENGTH - 1) / TILE_LENGTH;

        for (uint32_t i = 0; i < tiles; i++) {
            uint32_t currLength = (i == tiles - 1) ?
                (totalLength - i * TILE_LENGTH) : TILE_LENGTH;
            uint32_t offset = i * TILE_LENGTH;

            // Allocate local tensors from queues
            LocalTensor<half> x1Local = inQueueX1.AllocTensor<half>();
            LocalTensor<half> x2Local = inQueueX2.AllocTensor<half>();
            LocalTensor<half> yLocal = outQueueY.AllocTensor<half>();

            // CopyIn: Global Memory → Local Memory (Unified Buffer)
            DataCopy(x1Local, x1Global[offset], currLength);
            DataCopy(x2Local, x2Global[offset], currLength);

            // Enqueue for synchronization, then dequeue
            inQueueX1.EnQue(x1Local);
            inQueueX2.EnQue(x2Local);
            LocalTensor<half> x1Deque = inQueueX1.DeQue<half>();
            LocalTensor<half> x2Deque = inQueueX2.DeQue<half>();

            // Compute: y = x1 + x2 (element-wise vector Add)
            Add(yLocal, x1Deque, x2Deque, currLength);

            // Free input tensors after use
            inQueueX1.FreeTensor(x1Deque);
            inQueueX2.FreeTensor(x2Deque);

            // CopyOut: Local Memory → Global Memory
            DataCopy(yGlobal[offset], yLocal, currLength);

            // Free output tensor
            outQueueY.FreeTensor(yLocal);
        }
    }

private:
    TPipe pipe;
    GlobalTensor<half> x1Global;
    GlobalTensor<half> x2Global;
    GlobalTensor<half> yGlobal;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueX1;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueX2;
    TQue<TPosition::VECOUT, BUFFER_NUM> outQueueY;
    uint32_t totalLength;
};

/**
 * @brief Kernel entry point — launched on NPU cores.
 *
 * Distributes TOTAL_ELEMENTS among cores such that every core's
 * start offset and element count are multiples of 16 (= 32B / sizeof(half)).
 * This guarantees DataCopy never truncates a partial tile.
 */
__global__ __vector__ void add_custom(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                       uint32_t totalElements,
                                       uint32_t coreNum)
{
    uint32_t coreId = GetBlockIdx();

    // Base share rounded down to a multiple of 16 (32B / 2B per half element)
    uint32_t blockLen = (totalElements / coreNum / 16) * 16;
    // Remaining elements, expressed in chunks of 16; handed out one chunk per
    // leading core so all lengths/offsets stay 16-aligned.
    uint32_t remChunks = (totalElements - blockLen * coreNum) / 16;

    uint32_t coreLen = blockLen + (coreId < remChunks ? 16 : 0);
    uint32_t startOffset = coreId * blockLen +
        (coreId < remChunks ? coreId * 16 : remChunks * 16);

    if (coreLen == 0) {
        return;
    }

    AddKernel kernel;
    kernel.Init(
        (GM_ADDR)((__gm__ half*)x1 + startOffset),
        (GM_ADDR)((__gm__ half*)x2 + startOffset),
        (GM_ADDR)((__gm__ half*)y + startOffset),
        coreLen);
    kernel.Process();
}

/**
 * @brief Host-side entry — called from main.asc (and the judge platform).
 *
 * x1, x2, y: GM_ADDR pointers to device memory.
 * info_x1/info_x2/info_y: TensorGroupInfo with shape/dtype metadata.
 * availableCoreNum: number of vector cores on this device.
 * stream: ACL stream for kernel launch.
 */
extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1,
                           GM_ADDR x2, const TensorGroupInfo& info_x2,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           int64_t availableCoreNum, aclrtStream stream)
{
    // Fixed-shape kernel — total elements known at compile time
    constexpr uint32_t totalElements = TOTAL_ELEMENTS;

    // Cap core count: each core must handle at least 16 elements
    uint32_t coreNum = (uint32_t)availableCoreNum;
    if (coreNum > totalElements / 16) {
        coreNum = totalElements / 16;
    }
    if (coreNum == 0) {
        coreNum = 1;
    }

    add_custom<<<coreNum, nullptr, stream>>>(
        x1, x2, y, totalElements, coreNum);
}