#include <cmath>
#include "kernel_operator.h"
using namespace AscendC;

namespace {
constexpr int32_t TOTAL_LEN = 256 * 256;
constexpr int32_t TILE_LEN = 8192;
}  // namespace

__global__ __vector__ void add_custom(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, int32_t totalLength)
{
    int32_t blockIdx = GetBlockIdx();
    int32_t blockNum = GetBlockNum();

    TPipe pipe;
    TQue<QuePosition::VECIN, 2> queIn;
    TQue<QuePosition::VECOUT, 1> queOut;
    pipe.InitBuffer(queIn, 2, TILE_LEN * sizeof(half));
    pipe.InitBuffer(queOut, 1, TILE_LEN * sizeof(half));

    GlobalTensor<half> x1Global;
    GlobalTensor<half> x2Global;
    GlobalTensor<half> yGlobal;
    x1Global.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(x1), totalLength);
    x2Global.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(x2), totalLength);
    yGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y), totalLength);

    for (int32_t offset = blockIdx * TILE_LEN; offset < totalLength;
         offset += blockNum * TILE_LEN) {
        int32_t curLen = (offset + TILE_LEN <= totalLength) ? TILE_LEN : (totalLength - offset);

        LocalTensor<half> x1Local = queIn.AllocTensor<half>();
        LocalTensor<half> x2Local = queIn.AllocTensor<half>();
        LocalTensor<half> yLocal = queOut.AllocTensor<half>();

        DataCopy(x1Local, x1Global[offset], curLen);
        DataCopy(x2Local, x2Global[offset], curLen);
        Add(yLocal, x1Local, x2Local, curLen);
        DataCopy(yGlobal[offset], yLocal, curLen);

        queIn.FreeTensor(x1Local);
        queIn.FreeTensor(x2Local);
        queOut.FreeTensor(yLocal);
    }
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo &info_x1, GM_ADDR x2,
                           const TensorGroupInfo &info_x2, GM_ADDR y,
                           const TensorGroupInfo &info_y, int64_t availableCoreNum,
                           aclrtStream stream)
{
    int32_t totalLength = TOTAL_LEN;
    int32_t blockNum = (availableCoreNum > 0) ? static_cast<int32_t>(availableCoreNum) : 1;
    add_custom<<<blockNum, nullptr, stream>>>(x1, x2, y, totalLength);
}
