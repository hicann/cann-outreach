#include <cstdint>
#include "kernel_operator.h"

using namespace AscendC;

constexpr uint32_t TILE_LEN = 2048;
constexpr uint32_t BUFFER_NUM = 2;
constexpr uint32_t ALIGN_UNIT = 16; // fp16: 16 elements = 32 bytes

class KernelAdd {
public:
    __aicore__ inline KernelAdd() {}

    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                int64_t totalLength)
    {
        uint32_t blockNum = GetBlockNum();
        uint32_t blockIdx = GetBlockIdx();

        // Split into 32-byte aligned units so DataCopy/Add never lose tail elements.
        uint32_t totalUnits = totalLength / ALIGN_UNIT;
        uint32_t blockUnits = (totalUnits + blockNum - 1) / blockNum;
        uint32_t startUnit = blockIdx * blockUnits;
        if (startUnit >= totalUnits) {
            blockLen = 0;
            return;
        }
        uint32_t endUnit = startUnit + blockUnits;
        if (endUnit > totalUnits) {
            endUnit = totalUnits;
        }
        blockOffset = startUnit * ALIGN_UNIT;
        blockLen = (endUnit - startUnit) * ALIGN_UNIT;

        x1Gm.SetGlobalBuffer((__gm__ half *)x1 + blockOffset, blockLen);
        x2Gm.SetGlobalBuffer((__gm__ half *)x2 + blockOffset, blockLen);
        yGm.SetGlobalBuffer((__gm__ half *)y + blockOffset, blockLen);

        pipe.InitBuffer(inQueueX1, BUFFER_NUM, TILE_LEN * sizeof(half));
        pipe.InitBuffer(inQueueX2, BUFFER_NUM, TILE_LEN * sizeof(half));
        pipe.InitBuffer(outQueueY, BUFFER_NUM, TILE_LEN * sizeof(half));

        tileNum = (blockLen + TILE_LEN - 1) / TILE_LEN;
    }

    __aicore__ inline void Process()
    {
        if (blockLen == 0) {
            return;
        }
        for (uint32_t i = 0; i < tileNum; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline uint32_t ActualTile(uint32_t i)
    {
        uint32_t remaining = blockLen - i * TILE_LEN;
        return (remaining < TILE_LEN) ? remaining : TILE_LEN;
    }

    __aicore__ inline void CopyIn(uint32_t i)
    {
        uint32_t actual = ActualTile(i);
        LocalTensor<half> x1Local = inQueueX1.AllocTensor<half>();
        LocalTensor<half> x2Local = inQueueX2.AllocTensor<half>();
        DataCopy(x1Local, x1Gm[i * TILE_LEN], actual);
        DataCopy(x2Local, x2Gm[i * TILE_LEN], actual);
        inQueueX1.EnQue(x1Local);
        inQueueX2.EnQue(x2Local);
    }

    __aicore__ inline void Compute(uint32_t i)
    {
        uint32_t actual = ActualTile(i);
        LocalTensor<half> x1Local = inQueueX1.DeQue<half>();
        LocalTensor<half> x2Local = inQueueX2.DeQue<half>();
        LocalTensor<half> yLocal = outQueueY.AllocTensor<half>();
        Add(yLocal, x1Local, x2Local, actual);
        outQueueY.EnQue<half>(yLocal);
        inQueueX1.FreeTensor(x1Local);
        inQueueX2.FreeTensor(x2Local);
    }

    __aicore__ inline void CopyOut(uint32_t i)
    {
        uint32_t actual = ActualTile(i);
        LocalTensor<half> yLocal = outQueueY.DeQue<half>();
        DataCopy(yGm[i * TILE_LEN], yLocal, actual);
        outQueueY.FreeTensor(yLocal);
    }

    TPipe pipe;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueX1;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueX2;
    TQue<TPosition::VECOUT, BUFFER_NUM> outQueueY;
    GlobalTensor<half> x1Gm;
    GlobalTensor<half> x2Gm;
    GlobalTensor<half> yGm;
    uint32_t blockLen;
    uint32_t blockOffset;
    uint32_t tileNum;
};

__global__ __vector__ void add_custom(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                      int64_t totalLength)
{
    KernelAdd op;
    op.Init(x1, x2, y, totalLength);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1,
                           GM_ADDR x2, const TensorGroupInfo& info_x2,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           int64_t availableCoreNum, aclrtStream stream)
{
    // [256, 256] = 65536 elements total
    int64_t numDims = info_x1.tensors[0].numDims;
    int64_t totalLength = 1;
    for (int64_t d = 0; d < numDims; d++) {
        totalLength *= info_x1.tensors[0].shape[d];
    }
    uint32_t blockNum = static_cast<uint32_t>(availableCoreNum);
    add_custom<<<blockNum, nullptr, stream>>>(x1, x2, y, totalLength);
}