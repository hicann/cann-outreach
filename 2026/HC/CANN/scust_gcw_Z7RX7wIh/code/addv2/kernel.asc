#include <cmath>
#include "kernel_operator.h"
using namespace AscendC;

constexpr int32_t BUFFER_NUM = 2;

class KernelAdd {
public:
    __aicore__ inline KernelAdd() {}
    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                int32_t blockLength, int32_t tileLength) {
        this->blockLength = blockLength;
        this->tileLength = tileLength;
        this->tileNum = blockLength / tileLength;

        x1Gm.SetGlobalBuffer((__gm__ half*)x1 + GetBlockIdx() * blockLength);
        x2Gm.SetGlobalBuffer((__gm__ half*)x2 + GetBlockIdx() * blockLength);
        yGm.SetGlobalBuffer((__gm__ half*)y + GetBlockIdx() * blockLength);

        pipe.InitBuffer(inQueueX1, BUFFER_NUM, tileLength * sizeof(half));
        pipe.InitBuffer(inQueueX2, BUFFER_NUM, tileLength * sizeof(half));
        pipe.InitBuffer(outQueueY, BUFFER_NUM, tileLength * sizeof(half));
    }
    __aicore__ inline void Process() {
        for (int32_t i = 0; i < tileNum; i++) {
            int32_t offset = i * tileLength;
            CopyIn(offset);
            Compute(offset);
            CopyOut(offset);
        }
    }
private:
    __aicore__ inline void CopyIn(int32_t offset) {
        LocalTensor<half> x1Local = inQueueX1.AllocTensor<half>();
        LocalTensor<half> x2Local = inQueueX2.AllocTensor<half>();
        DataCopy(x1Local, x1Gm[offset], tileLength);
        DataCopy(x2Local, x2Gm[offset], tileLength);
        inQueueX1.EnQue(x1Local);
        inQueueX2.EnQue(x2Local);
    }
    __aicore__ inline void Compute(int32_t offset) {
        LocalTensor<half> x1Local = inQueueX1.DeQue<half>();
        LocalTensor<half> x2Local = inQueueX2.DeQue<half>();
        LocalTensor<half> yLocal = outQueueY.AllocTensor<half>();
        Add(yLocal, x1Local, x2Local, tileLength);
        outQueueY.EnQue(yLocal);
        inQueueX1.FreeTensor(x1Local);
        inQueueX2.FreeTensor(x2Local);
    }
    __aicore__ inline void CopyOut(int32_t offset) {
        LocalTensor<half> yLocal = outQueueY.DeQue<half>();
        DataCopy(yGm[offset], yLocal, tileLength);
        outQueueY.FreeTensor(yLocal);
    }
private:
    TPipe pipe;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueX1;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueX2;
    TQue<TPosition::VECOUT, BUFFER_NUM> outQueueY;
    GlobalTensor<half> x1Gm, x2Gm, yGm;
    int32_t blockLength;
    int32_t tileLength;
    int32_t tileNum;
};

extern "C" __global__ __aicore__ void add_custom(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                                  int32_t totalLength, int32_t blockLength,
                                                  int32_t tileLength) {
    if (GetBlockIdx() >= (totalLength + blockLength - 1) / blockLength) {
        return;
    }
    KernelAdd op;
    op.Init(x1, x2, y, blockLength, tileLength);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1,
                           GM_ADDR x2, const TensorGroupInfo& info_x2,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           int64_t availableCoreNum, aclrtStream stream) {
    int32_t totalLength = info_x1.tensors[0].shape[0] * info_x1.tensors[0].shape[1];
    int32_t tileLength = 2048;
    int32_t blockDim = 1;
    while (blockDim * 2 <= availableCoreNum && totalLength % (blockDim * 2) == 0) {
        blockDim *= 2;
    }
    int32_t blockLength = totalLength / blockDim;
    add_custom<<<blockDim, nullptr, stream>>>(x1, x2, y, totalLength, blockLength, tileLength);
}