#include <cmath>
#include "kernel_operator.h"

using namespace AscendC;

constexpr int32_t TILE_LEN = 16384;

class KernelAdd {
public:
    __aicore__ inline KernelAdd(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                int64_t totalLength, int64_t tileLen)
        : totalLength_(totalLength), tileLen_(tileLen)
    {
        x1Gm_.SetGlobalBuffer((__gm__ half *)x1, totalLength);
        x2Gm_.SetGlobalBuffer((__gm__ half *)x2, totalLength);
        yGm_.SetGlobalBuffer((__gm__ half *)y, totalLength);
        pipe_.InitBuffer(inQueueX1_, 1, tileLen * sizeof(half));
        pipe_.InitBuffer(inQueueX2_, 1, tileLen * sizeof(half));
        pipe_.InitBuffer(outQueueY_, 1, tileLen * sizeof(half));
    }

    __aicore__ inline void Process()
    {
        int64_t loops = totalLength_ / tileLen_;
        int64_t tailLen = totalLength_ - loops * tileLen_;
        for (int64_t i = 0; i < loops; i++) {
            CopyIn(i * tileLen_, tileLen_);
            Compute(tileLen_);
            CopyOut(i * tileLen_, tileLen_);
        }
        if (tailLen > 0) {
            CopyIn(loops * tileLen_, tailLen);
            Compute(tailLen);
            CopyOut(loops * tileLen_, tailLen);
        }
    }

private:
    __aicore__ inline void CopyIn(int64_t offset, int64_t len)
    {
        LocalTensor<half> x1Local = inQueueX1_.AllocTensor<half>();
        LocalTensor<half> x2Local = inQueueX2_.AllocTensor<half>();
        DataCopy(x1Local, x1Gm_[offset], len);
        DataCopy(x2Local, x2Gm_[offset], len);
        inQueueX1_.EnQue(x1Local);
        inQueueX2_.EnQue(x2Local);
    }

    __aicore__ inline void Compute(int64_t len)
    {
        LocalTensor<half> x1Local = inQueueX1_.DeQue<half>();
        LocalTensor<half> x2Local = inQueueX2_.DeQue<half>();
        LocalTensor<half> yLocal = outQueueY_.AllocTensor<half>();
        Add(yLocal, x1Local, x2Local, len);
        outQueueY_.EnQue(yLocal);
        inQueueX1_.FreeTensor(x1Local);
        inQueueX2_.FreeTensor(x2Local);
    }

    __aicore__ inline void CopyOut(int64_t offset, int64_t len)
    {
        LocalTensor<half> yLocal = outQueueY_.DeQue<half>();
        DataCopy(yGm_[offset], yLocal, len);
        outQueueY_.FreeTensor(yLocal);
    }

private:
    TPipe pipe_;
    GlobalTensor<half> x1Gm_;
    GlobalTensor<half> x2Gm_;
    GlobalTensor<half> yGm_;
    TQue<QuePosition::VECIN, 1> inQueueX1_;
    TQue<QuePosition::VECIN, 1> inQueueX2_;
    TQue<QuePosition::VECOUT, 1> outQueueY_;
    int64_t totalLength_;
    int64_t tileLen_;
};

__global__ __vector__ void add_custom(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                      int64_t totalLength, int64_t tileLen)
{
    KernelAdd op(x1, x2, y, totalLength, tileLen);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo &info_x1,
                           GM_ADDR x2, const TensorGroupInfo &info_x2,
                           GM_ADDR y, const TensorGroupInfo &info_y,
                           int64_t availableCoreNum, aclrtStream stream) {
    int64_t totalElements = 1;
    for (int64_t i = 0; i < info_x1.tensors[0].numDims; i++) {
        totalElements *= info_x1.tensors[0].shape[i];
    }
    add_custom<<<1, nullptr, stream>>>(x1, x2, y, totalElements, TILE_LEN);
}
