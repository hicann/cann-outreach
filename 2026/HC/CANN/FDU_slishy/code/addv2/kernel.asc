#include <cmath>
#include "kernel_operator.h"
/*
 * Add Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 */

// 每个 queue 的缓冲区个数
constexpr int32_t BUFFER_NUM = 1;
// 每次搬运/计算的元素个数（fp16，8192 元素 = 16KB，3 个 buffer 共 48KB，满足 UB 容量）
constexpr uint32_t TILE_SIZE = 8192;
// 32 字节对齐对应的 fp16 元素个数
constexpr uint32_t ALIGN_ELEM = 16;

class KernelAdd {
public:
    __aicore__ inline KernelAdd() {}
    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                uint32_t totalLength, uint32_t blockNum)
    {
        // 多核均分：每核处理 blockLength 个元素，起始偏移按 32 字节对齐
        uint32_t perCore = (totalLength + blockNum - 1) / blockNum;
        perCore = ((perCore + ALIGN_ELEM - 1) / ALIGN_ELEM) * ALIGN_ELEM;
        uint32_t blockIdx = static_cast<uint32_t>(AscendC::GetBlockIdx());
        uint32_t start = blockIdx * perCore;
        if (start >= totalLength) {
            this->blockLength = 0;
        } else {
            uint32_t end = start + perCore;
            if (end > totalLength) {
                end = totalLength;
            }
            this->blockLength = end - start;
        }
        this->blockOffset = start;
        xGm.SetGlobalBuffer((__gm__ half *)x1 + start);
        yGm.SetGlobalBuffer((__gm__ half *)x2 + start);
        zGm.SetGlobalBuffer((__gm__ half *)y + start);
        pipe.InitBuffer(inQueueX, BUFFER_NUM, TILE_SIZE * sizeof(half));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, TILE_SIZE * sizeof(half));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, TILE_SIZE * sizeof(half));
    }

    __aicore__ inline void Process()
    {
        uint32_t tileNum = (this->blockLength + TILE_SIZE - 1) / TILE_SIZE;
        for (uint32_t i = 0; i < tileNum; i++) {
            uint32_t curLen = TILE_SIZE;
            if (i == tileNum - 1) {
                curLen = this->blockLength - i * TILE_SIZE;
            }
            CopyIn(i * TILE_SIZE, curLen);
            Compute(curLen);
            CopyOut(i * TILE_SIZE, curLen);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset, uint32_t len)
    {
        AscendC::LocalTensor<half> xLocal = inQueueX.AllocTensor<half>();
        AscendC::LocalTensor<half> yLocal = inQueueY.AllocTensor<half>();
        AscendC::DataCopy(xLocal, xGm[offset], len);
        AscendC::DataCopy(yLocal, yGm[offset], len);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }
    __aicore__ inline void Compute(uint32_t len)
    {
        AscendC::LocalTensor<half> xLocal = inQueueX.DeQue<half>();
        AscendC::LocalTensor<half> yLocal = inQueueY.DeQue<half>();
        AscendC::LocalTensor<half> zLocal = outQueueZ.AllocTensor<half>();
        AscendC::Add(zLocal, xLocal, yLocal, len);
        outQueueZ.EnQue(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }
    __aicore__ inline void CopyOut(uint32_t offset, uint32_t len)
    {
        AscendC::LocalTensor<half> zLocal = outQueueZ.DeQue<half>();
        AscendC::DataCopy(zGm[offset], zLocal, len);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, BUFFER_NUM> inQueueX, inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, BUFFER_NUM> outQueueZ;
    AscendC::GlobalTensor<half> xGm;
    AscendC::GlobalTensor<half> yGm;
    AscendC::GlobalTensor<half> zGm;
    uint32_t blockLength = 0;
    uint32_t blockOffset = 0;
};

__global__ __vector__ void add_custom(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                      uint32_t totalLength, uint32_t blockNum)
{
    KernelAdd op;
    op.Init(x1, x2, y, totalLength, blockNum);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1, GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y, int64_t availableCoreNum, aclrtStream stream)
{
    // 读取 shape，计算总元素个数（本题固定 [256, 256]，fp16）
    int64_t totalLength = 1;
    for (int64_t i = 0; i < info_x1.tensors[0].numDims; i++) {
        totalLength *= info_x1.tensors[0].shape[i];
    }
    if (totalLength <= 0) {
        return;
    }
    // 按可用核数切分，最多按 32 字节对齐后的元素块数
    int64_t blockNum = availableCoreNum;
    if (blockNum <= 0) {
        blockNum = 1;
    }
    int64_t maxBlock = (totalLength + ALIGN_ELEM - 1) / ALIGN_ELEM;
    if (blockNum > maxBlock) {
        blockNum = maxBlock;
    }
    add_custom<<<blockNum, nullptr, stream>>>(x1, x2, y, static_cast<uint32_t>(totalLength),
                                              static_cast<uint32_t>(blockNum));
}
