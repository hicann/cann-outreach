#include <cmath>
#include "kernel_operator.h"

using namespace AscendC;

constexpr int32_t ALIGN_UNIT = 16;
constexpr int32_t MAX_BLOCKS = 256;

__global__ __vector__ void add_custom(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, int32_t totalElements)
{
    int32_t blockId = GetBlockIdx();
    int32_t blockNum = GetBlockNum();

    int32_t totalUnits = totalElements / ALIGN_UNIT;

    int32_t perBlockUnits = totalUnits / blockNum;
    int32_t perBlockRemUnits = totalUnits % blockNum;
    int32_t unitStart = blockId * perBlockUnits + (blockId < perBlockRemUnits ? blockId : perBlockRemUnits);
    int32_t unitCount = perBlockUnits + (blockId < perBlockRemUnits ? 1 : 0);

    if (unitCount <= 0) {
        return;
    }

    int32_t start = unitStart * ALIGN_UNIT;
    int32_t count = unitCount * ALIGN_UNIT;
    int32_t sizeInBytes = count * sizeof(half);

    TPipe pipe;
    TQue<QuePosition::VECIN, 1> queX1;
    TQue<QuePosition::VECIN, 1> queX2;
    TQue<QuePosition::VECOUT, 1> queY;

    pipe.InitBuffer(queX1, 1, sizeInBytes);
    pipe.InitBuffer(queX2, 1, sizeInBytes);
    pipe.InitBuffer(queY, 1, sizeInBytes);

    LocalTensor<half> x1Local = queX1.AllocTensor<half>();
    LocalTensor<half> x2Local = queX2.AllocTensor<half>();
    LocalTensor<half> yLocal = queY.AllocTensor<half>();

    GlobalTensor<half> x1Global;
    GlobalTensor<half> x2Global;
    GlobalTensor<half> yGlobal;
    x1Global.SetGlobalBuffer((__gm__ half*)x1);
    x2Global.SetGlobalBuffer((__gm__ half*)x2);
    yGlobal.SetGlobalBuffer((__gm__ half*)y);

    DataCopy(x1Local, x1Global[start], count);
    DataCopy(x2Local, x2Global[start], count);

    Add(yLocal, x1Local, x2Local, count);

    DataCopy(yGlobal[start], yLocal, count);
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1, GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y, int64_t availableCoreNum, aclrtStream stream)
{
    int32_t totalElements = 256 * 256;

    int64_t coreNum = availableCoreNum;
    if (coreNum <= 0) {
        coreNum = 1;
    }
    int32_t blockNum = static_cast<int32_t>(coreNum);
    if (blockNum > MAX_BLOCKS) {
        blockNum = MAX_BLOCKS;
    }

    add_custom<<<blockNum, nullptr, stream>>>(x1, x2, y, totalElements);
}