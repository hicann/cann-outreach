#include <cmath>
#include "kernel_operator.h"

using namespace AscendC;

constexpr int32_t BUFFER_NUM = 2;     // double buffer
constexpr int32_t TILE_LENGTH = 2048; // elements per tile (2048*half = 4096B, 32B aligned)

class AddKernel {
public:
    __aicore__ inline AddKernel() {}

    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, int32_t blockLength)
    {
        this->blockLength = blockLength;
        this->blockOffset = GetBlockIdx() * blockLength;

        x1Gm.SetGlobalBuffer((__gm__ half *)x1);
        x2Gm.SetGlobalBuffer((__gm__ half *)x2);
        yGm.SetGlobalBuffer((__gm__ half *)y);

        pipe.InitBuffer(inQueueX1, BUFFER_NUM, TILE_LENGTH * sizeof(half));
        pipe.InitBuffer(inQueueX2, BUFFER_NUM, TILE_LENGTH * sizeof(half));
        pipe.InitBuffer(outQueueY, BUFFER_NUM, TILE_LENGTH * sizeof(half));
    }

    __aicore__ inline void Process()
    {
        int32_t loopCount = blockLength / TILE_LENGTH;
        for (int32_t i = 0; i < loopCount; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t i)
    {
        LocalTensor<half> x1Local = inQueueX1.AllocTensor<half>();
        LocalTensor<half> x2Local = inQueueX2.AllocTensor<half>();
        DataCopy(x1Local, x1Gm[blockOffset + i * TILE_LENGTH], TILE_LENGTH);
        DataCopy(x2Local, x2Gm[blockOffset + i * TILE_LENGTH], TILE_LENGTH);
        inQueueX1.EnQue(x1Local);
        inQueueX2.EnQue(x2Local);
    }

    __aicore__ inline void Compute(int32_t i)
    {
        LocalTensor<half> x1Local = inQueueX1.DeQue<half>();
        LocalTensor<half> x2Local = inQueueX2.DeQue<half>();
        LocalTensor<half> yLocal = outQueueY.AllocTensor<half>();
        Add(yLocal, x1Local, x2Local, TILE_LENGTH);
        outQueueY.EnQue(yLocal);
        inQueueX1.FreeTensor(x1Local);
        inQueueX2.FreeTensor(x2Local);
    }

    __aicore__ inline void CopyOut(int32_t i)
    {
        LocalTensor<half> yLocal = outQueueY.DeQue<half>();
        DataCopy(yGm[blockOffset + i * TILE_LENGTH], yLocal, TILE_LENGTH);
        outQueueY.FreeTensor(yLocal);
    }

private:
    TPipe pipe;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueX1, inQueueX2;
    TQue<QuePosition::VECOUT, BUFFER_NUM> outQueueY;
    GlobalTensor<half> x1Gm, x2Gm, yGm;
    int32_t blockLength;
    int32_t blockOffset;
};

__global__ __vector__ void add_custom(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, int32_t blockLength)
{
    AddKernel op;
    op.Init(x1, x2, y, blockLength);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1, GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y, int64_t availableCoreNum, aclrtStream stream)
{
    // total element count from shape (fixed [256,256] in this problem)
    int64_t totalLength = 1;
    for (int64_t d = 0; d < info_x1.tensors[0].numDims; d++) {
        totalLength *= info_x1.tensors[0].shape[d];
    }

    // Choose blockNum as a power of two <= min(availableCoreNum, 32) so that
    // totalLength is evenly divided and each block's length stays aligned.
    int32_t maxBlock = static_cast<int32_t>(availableCoreNum);
    if (maxBlock > 32) {
        maxBlock = 32;
    }
    int32_t blockNum = 1;
    while (blockNum * 2 <= maxBlock) {
        blockNum *= 2;
    }
    int32_t blockLength = static_cast<int32_t>(totalLength / blockNum);

    add_custom<<<blockNum, nullptr, stream>>>(x1, x2, y, blockLength);
}
