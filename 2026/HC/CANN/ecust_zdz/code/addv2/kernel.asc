#include <cmath>
#include "kernel_operator.h"
/*
 * AddV2 Kernel — Ascend C Direct Invocation
 * Fixed shape [256, 256] float16 Add: y = x1 + x2
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x1.tensors[0].shape[0]  // first dim of first tensor in input x1
 */

using namespace AscendC;

constexpr int32_t TILE_SIZE = 8192;     // 8192 half elements = 16KB per tile (32B aligned)
constexpr uint8_t  BUFFER_NUM = 2;      // double buffer for pipeline

__global__ __vector__ void add_custom(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, int32_t totalElements)
{
    // Get block index and total block count
    int64_t blockIdx = GetBlockIdx();
    int64_t blockNum = GetBlockNum();

    // Split elements across blocks with 32B alignment (16 half elements)
    int64_t perBlock = (totalElements + blockNum - 1) / blockNum;
    int64_t perBlockAligned = ((perBlock + 15) / 16) * 16;
    int64_t start = blockIdx * perBlockAligned;
    int64_t end = start + perBlockAligned;
    if (end > totalElements) {
        end = totalElements;
    }
    if (start >= end) {
        return;
    }

    // Setup compute pipeline: TPipe with TQue for inputs and output
    TPipe pipe;
    TQue<QuePosition::VECIN, BUFFER_NUM> queX1;
    TQue<QuePosition::VECIN, BUFFER_NUM> queX2;
    TQue<QuePosition::VECOUT, BUFFER_NUM> queY;

    uint32_t bufBytes = TILE_SIZE * sizeof(half);
    pipe.InitBuffer(queX1, BUFFER_NUM, bufBytes);
    pipe.InitBuffer(queX2, BUFFER_NUM, bufBytes);
    pipe.InitBuffer(queY, BUFFER_NUM, bufBytes);

    // Construct GlobalTensors from GM_ADDR for data access
    GlobalTensor<half> x1Gm;
    GlobalTensor<half> x2Gm;
    GlobalTensor<half> yGm;
    x1Gm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x1), totalElements);
    x2Gm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x2), totalElements);
    yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y), totalElements);

    // Process tiles with three-stage pipeline: CopyIn -> Compute -> CopyOut
    for (int64_t offset = start; offset < end; offset += TILE_SIZE) {
        int64_t remaining = end - offset;
        int32_t curSize = (remaining < TILE_SIZE) ? static_cast<int32_t>(remaining) : TILE_SIZE;

        // --- CopyIn: Global Memory -> Local Memory ---
        LocalTensor<half> x1Local = queX1.AllocTensor<half>();
        LocalTensor<half> x2Local = queX2.AllocTensor<half>();
        DataCopy(x1Local, x1Gm[offset], curSize);
        DataCopy(x2Local, x2Gm[offset], curSize);
        queX1.EnQue(x1Local);
        queX2.EnQue(x2Local);

        // --- Compute: y = x1 + x2 (element-wise vector add) ---
        LocalTensor<half> x1Deq = queX1.DeQue<half>();
        LocalTensor<half> x2Deq = queX2.DeQue<half>();
        LocalTensor<half> yLocal = queY.AllocTensor<half>();
        Add(yLocal, x1Deq, x2Deq, curSize);
        queX1.FreeTensor(x1Deq);
        queX2.FreeTensor(x2Deq);
        queY.EnQue(yLocal);

        // --- CopyOut: Local Memory -> Global Memory ---
        LocalTensor<half> yDeq = queY.DeQue<half>();
        DataCopy(yGm[offset], yDeq, curSize);
        queY.FreeTensor(yDeq);
    }
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1,
    GM_ADDR x2, const TensorGroupInfo& info_x2,
    GM_ADDR y, const TensorGroupInfo& info_y,
    int64_t availableCoreNum, aclrtStream stream)
{
    // Compute total element count from input shape
    const TensorInfo& tx1 = info_x1.tensors[0];
    int64_t totalElements = 1;
    for (int64_t i = 0; i < tx1.numDims; i++) {
        totalElements *= tx1.shape[i];
    }

    // Use available cores (capped at reasonable maximum)
    uint32_t blockNum = (availableCoreNum > 0) ? static_cast<uint32_t>(availableCoreNum) : 1u;

    // Launch kernel with the configured number of blocks
    add_custom<<<blockNum, nullptr, stream>>>(x1, x2, y, static_cast<int32_t>(totalElements));
}