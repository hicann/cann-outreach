#include "kernel_operator.h"

using namespace AscendC;

constexpr int32_t TOTAL_LEN  = 256 * 256;   // 65536 fp16 elements
constexpr int32_t BUFFER_NUM = 2;           // double buffering
constexpr int32_t TILE_LEN   = 4096;        // elements per tile (32B aligned: 4096 % 16 == 0)

/**
 * @brief Vector Add kernel: y = x1 + x2
 * Each block processes a contiguous chunk of data. Data flows through a
 * queue-based pipeline (CopyIn -> Compute -> CopyOut) which provides
 * synchronization between the MTE2/Vector/MTE3 hardware units.
 */
class KernelAdd {
public:
    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, int32_t start, int32_t blockLen)
    {
        this->blockLen = blockLen;
        this->tileNum = (blockLen + TILE_LEN - 1) / TILE_LEN;
        this->lastTileLen = blockLen - (tileNum - 1) * TILE_LEN;

        x1Gm.SetGlobalBuffer((__gm__ half*)x1 + start, TOTAL_LEN - start);
        x2Gm.SetGlobalBuffer((__gm__ half*)x2 + start, TOTAL_LEN - start);
        yGm.SetGlobalBuffer((__gm__ half*)y + start, TOTAL_LEN - start);

        pipe.InitBuffer(inQueueX1, BUFFER_NUM, TILE_LEN * sizeof(half));
        pipe.InitBuffer(inQueueX2, BUFFER_NUM, TILE_LEN * sizeof(half));
        pipe.InitBuffer(outQueueY, BUFFER_NUM, TILE_LEN * sizeof(half));
    }

    __aicore__ inline void Process()
    {
        for (int32_t i = 0; i < tileNum; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline int32_t TileLen(int32_t progress) const
    {
        return (progress == tileNum - 1) ? lastTileLen : TILE_LEN;
    }

    __aicore__ inline void CopyIn(int32_t progress)
    {
        LocalTensor<half> x1Local = inQueueX1.AllocTensor<half>();
        LocalTensor<half> x2Local = inQueueX2.AllocTensor<half>();
        DataCopy(x1Local, x1Gm[progress * TILE_LEN], TileLen(progress));
        DataCopy(x2Local, x2Gm[progress * TILE_LEN], TileLen(progress));
        inQueueX1.EnQue(x1Local);
        inQueueX2.EnQue(x2Local);
    }

    __aicore__ inline void Compute(int32_t progress)
    {
        LocalTensor<half> x1Local = inQueueX1.DeQue<half>();
        LocalTensor<half> x2Local = inQueueX2.DeQue<half>();
        LocalTensor<half> yLocal   = outQueueY.AllocTensor<half>();
        Add(yLocal, x1Local, x2Local, TileLen(progress));
        outQueueY.EnQue(yLocal);
        inQueueX1.FreeTensor(x1Local);
        inQueueX2.FreeTensor(x2Local);
    }

    __aicore__ inline void CopyOut(int32_t progress)
    {
        LocalTensor<half> yLocal = outQueueY.DeQue<half>();
        DataCopy(yGm[progress * TILE_LEN], yLocal, TileLen(progress));
        outQueueY.FreeTensor(yLocal);
    }

private:
    TPipe pipe;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueX1, inQueueX2;
    TQue<TPosition::VECOUT, BUFFER_NUM> outQueueY;
    GlobalTensor<half> x1Gm, x2Gm, yGm;
    int32_t blockLen;
    int32_t tileNum;
    int32_t lastTileLen;
};

__global__ __vector__ void add_custom(GM_ADDR x1, GM_ADDR x2, GM_ADDR y)
{
    int32_t blockIdx = GetBlockIdx();
    int32_t blockNum = GetBlockNum();

    // Split TOTAL_LEN across blocks; align perCoreLen to 16-element boundary (32B)
    int32_t perCoreLen = (TOTAL_LEN + blockNum - 1) / blockNum;
    perCoreLen = ((perCoreLen + 15) / 16) * 16;
    int32_t start = blockIdx * perCoreLen;
    if (start >= TOTAL_LEN) {
        return;
    }
    int32_t blockLen = perCoreLen;
    if (start + blockLen > TOTAL_LEN) {
        blockLen = TOTAL_LEN - start;
    }

    KernelAdd op;
    op.Init(x1, x2, y, start, blockLen);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1,
    GM_ADDR x2, const TensorGroupInfo& info_x2,
    GM_ADDR y, const TensorGroupInfo& info_y,
    int64_t availableCoreNum, aclrtStream stream)
{
    // Launch with all available cores (cap at TOTAL_LEN/16 so each block holds >= 32B of data)
    int64_t blockNum = availableCoreNum;
    if (blockNum > TOTAL_LEN / 16) {
        blockNum = TOTAL_LEN / 16;
    }
    if (blockNum <= 0) blockNum = 1;
    add_custom<<<blockNum, nullptr, stream>>>(x1, x2, y);
}
