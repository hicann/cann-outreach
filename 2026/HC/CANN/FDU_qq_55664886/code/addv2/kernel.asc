#include "kernel_operator.h"

using namespace AscendC;

constexpr int32_t BLOCK_LENGTH = 8192;
constexpr int32_t ALIGN_UNIT = 16;

class KernelAdd {
public:
    __aicore__ inline KernelAdd() {}
    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, int32_t length, int32_t offset)
    {
        x1Global.SetGlobalBuffer((__gm__ half *)x1 + offset, length);
        x2Global.SetGlobalBuffer((__gm__ half *)x2 + offset, length);
        yGlobal.SetGlobalBuffer((__gm__ half *)y + offset, length);
        pipe.InitBuffer(inQueueX1, 1, BLOCK_LENGTH * sizeof(half));
        pipe.InitBuffer(inQueueX2, 1, BLOCK_LENGTH * sizeof(half));
        pipe.InitBuffer(outQueueY, 1, BLOCK_LENGTH * sizeof(half));
        this->length = length;
    }
    __aicore__ inline void Process()
    {
        int32_t offset = 0;
        while (offset < length) {
            int32_t curLen = (length - offset >= BLOCK_LENGTH) ? BLOCK_LENGTH : (length - offset);
            LocalTensor<half> x1Local = inQueueX1.AllocTensor<half>();
            LocalTensor<half> x2Local = inQueueX2.AllocTensor<half>();
            DataCopy(x1Local, x1Global[offset], curLen);
            DataCopy(x2Local, x2Global[offset], curLen);
            inQueueX1.EnQue(x1Local);
            inQueueX2.EnQue(x2Local);

            LocalTensor<half> x1In = inQueueX1.DeQue<half>();
            LocalTensor<half> x2In = inQueueX2.DeQue<half>();
            LocalTensor<half> yLocal = outQueueY.AllocTensor<half>();
            Add(yLocal, x1In, x2In, curLen);
            outQueueY.EnQue(yLocal);
            inQueueX1.FreeTensor(x1In);
            inQueueX2.FreeTensor(x2In);

            LocalTensor<half> yOut = outQueueY.DeQue<half>();
            DataCopy(yGlobal[offset], yOut, curLen);
            outQueueY.FreeTensor(yOut);

            offset += curLen;
        }
    }

private:
    TPipe pipe;
    GlobalTensor<half> x1Global;
    GlobalTensor<half> x2Global;
    GlobalTensor<half> yGlobal;
    TQue<QuePosition::VECIN, 1> inQueueX1;
    TQue<QuePosition::VECIN, 1> inQueueX2;
    TQue<QuePosition::VECOUT, 1> outQueueY;
    int32_t length = 0;
};

__global__ __vector__ void add_custom(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, int32_t totalLength, int32_t blockNum)
{
    int32_t totalUnits = totalLength / ALIGN_UNIT;
    int32_t unitsPerCore = totalUnits / blockNum;
    int32_t remUnits = totalUnits % blockNum;
    int32_t b = GetBlockIdx();
    int32_t units = unitsPerCore + (b < remUnits ? 1 : 0);
    if (units <= 0) {
        return;
    }
    int32_t startUnit = b * unitsPerCore + ((b < remUnits) ? b : remUnits);
    KernelAdd op;
    op.Init(x1, x2, y, units * ALIGN_UNIT, startUnit * ALIGN_UNIT);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1, GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y, int64_t availableCoreNum, aclrtStream stream)
{
    int64_t numDims = info_x1.tensors[0].numDims;
    int64_t totalLength = 1;
    for (int64_t i = 0; i < numDims; ++i) {
        totalLength *= info_x1.tensors[0].shape[i];
    }
    int32_t total = static_cast<int32_t>(totalLength);
    if (total <= 0) {
        return;
    }

    int32_t blockNum = static_cast<int32_t>(availableCoreNum);
    if (blockNum <= 0) {
        blockNum = 1;
    }
    constexpr int32_t MAX_BLOCK = 32;
    if (blockNum > MAX_BLOCK) {
        blockNum = MAX_BLOCK;
    }
    if (blockNum > total / ALIGN_UNIT) {
        blockNum = total / ALIGN_UNIT;
    }
    if (blockNum <= 0) {
        blockNum = 1;
    }

    add_custom<<<blockNum, nullptr, stream>>>(x1, x2, y, total, blockNum);
}
