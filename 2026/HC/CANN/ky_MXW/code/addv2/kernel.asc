#include <cmath>
#include "kernel_operator.h"

using namespace AscendC;

constexpr int32_t TOTAL_ELEMENTS = 256 * 256;
constexpr int32_t ALIGN_UNIT = 16;
constexpr int32_t TOTAL_UNITS = TOTAL_ELEMENTS / ALIGN_UNIT;
constexpr int32_t TILE_UNITS = 128;
constexpr int32_t TILE_ELEMENTS = TILE_UNITS * ALIGN_UNIT;

__global__ __vector__ void add_custom(GM_ADDR x1, GM_ADDR x2, GM_ADDR y)
{
    int32_t blockNum = GetBlockNum();
    int32_t blockIdx = GetBlockIdx();

    int32_t perBlock = TOTAL_UNITS / blockNum;
    int32_t rem = TOTAL_UNITS % blockNum;
    int32_t startUnit = blockIdx * perBlock + (blockIdx < rem ? blockIdx : rem);
    int32_t countUnit = perBlock + (blockIdx < rem ? 1 : 0);
    int32_t count = countUnit * ALIGN_UNIT;
    int32_t start = startUnit * ALIGN_UNIT;

    if (count <= 0) return;

    TPipe pipe;
    TQue<TPosition::VECIN, 2> qIn;
    TQue<TPosition::VECOUT, 2> qOut;

    pipe.InitBuffer(qIn, 2, TILE_ELEMENTS * sizeof(half));
    pipe.InitBuffer(qOut, 2, TILE_ELEMENTS * sizeof(half));

    int32_t processed = 0;
    while (processed < count) {
        int32_t tile = (count - processed) < TILE_ELEMENTS ? (count - processed) : TILE_ELEMENTS;

        GlobalTensor<half> x1Tile;
        GlobalTensor<half> x2Tile;
        GlobalTensor<half> yTile;
        x1Tile.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x1) + start + processed, tile);
        x2Tile.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x2) + start + processed, tile);
        yTile.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y) + start + processed, tile);

        LocalTensor<half> inX1 = qIn.AllocTensor<half>();
        LocalTensor<half> inX2 = qIn.AllocTensor<half>();
        DataCopy(inX1, x1Tile, tile);
        DataCopy(inX2, x2Tile, tile);
        qIn.EnQue(inX1);
        qIn.EnQue(inX2);

        LocalTensor<half> x1Local = qIn.DeQue<half>();
        LocalTensor<half> x2Local = qIn.DeQue<half>();
        LocalTensor<half> yLocal = qOut.AllocTensor<half>();
        Add(yLocal, x1Local, x2Local, tile);
        qOut.EnQue(yLocal);

        LocalTensor<half> yDeq = qOut.DeQue<half>();
        DataCopy(yTile, yDeq, tile);
        qOut.FreeTensor(yDeq);

        processed += tile;
    }
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1, GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y, int64_t availableCoreNum, aclrtStream stream)
{
    int32_t blockNum = availableCoreNum;
    int32_t maxBlock = TOTAL_UNITS;
    while (blockNum > maxBlock) blockNum >>= 1;
    if (blockNum <= 0) blockNum = 1;
    add_custom<<<blockNum, nullptr, stream>>>(x1, x2, y);
}