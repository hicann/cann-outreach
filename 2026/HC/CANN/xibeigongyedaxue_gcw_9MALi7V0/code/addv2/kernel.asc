#include <cmath>
#include "kernel_operator.h"
/*
 * Add Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *
 * 固定 shape [256, 256] float16，数据量 65536 元素（128KB）。
 * 按 32 字节对齐粒度（16 个 half 元素）在多个 AI Core 间均分，
 * 每个 Core 内按 tile 循环完成 搬运(DataCopy) -> 向量加(Add) -> 搬运(DataCopy)。
 */

using namespace AscendC;

constexpr int32_t BUFFER_NUM = 1;     // 每个队列的 buffer 数
constexpr int32_t UNIT = 16;          // 16 个 half = 32B，数据搬运对齐粒度
constexpr int32_t TILE_LENGTH = 8192; // 单次搬运/计算的元素个数（8192 * 2B = 16KB）

class KernelAdd {
public:
    __aicore__ inline KernelAdd() {}

    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                int64_t blockStart, int64_t blockLength, int64_t tileLength)
    {
        this->blockLength = static_cast<int32_t>(blockLength);
        this->tileLength = static_cast<int32_t>(tileLength);
        x1Gm.SetGlobalBuffer((__gm__ half *)x1 + blockStart, this->blockLength);
        x2Gm.SetGlobalBuffer((__gm__ half *)x2 + blockStart, this->blockLength);
        yGm.SetGlobalBuffer((__gm__ half *)y + blockStart, this->blockLength);
        pipe.InitBuffer(inQueueX1, BUFFER_NUM, this->tileLength * sizeof(half));
        pipe.InitBuffer(inQueueX2, BUFFER_NUM, this->tileLength * sizeof(half));
        pipe.InitBuffer(outQueueY, BUFFER_NUM, this->tileLength * sizeof(half));
    }

    __aicore__ inline void Process()
    {
        for (int32_t i = 0; i < blockLength; i += tileLength) {
            int32_t curLen = (blockLength - i < tileLength) ? (blockLength - i) : tileLength;
            CopyIn(i, curLen);
            Compute(curLen);
            CopyOut(i, curLen);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t offset, int32_t curLen)
    {
        LocalTensor<half> x1Local = inQueueX1.AllocTensor<half>();
        LocalTensor<half> x2Local = inQueueX2.AllocTensor<half>();
        DataCopy(x1Local, x1Gm[offset], curLen);
        DataCopy(x2Local, x2Gm[offset], curLen);
        inQueueX1.EnQue(x1Local);
        inQueueX2.EnQue(x2Local);
    }

    __aicore__ inline void Compute(int32_t curLen)
    {
        LocalTensor<half> x1Local = inQueueX1.DeQue<half>();
        LocalTensor<half> x2Local = inQueueX2.DeQue<half>();
        LocalTensor<half> yLocal = outQueueY.AllocTensor<half>();
        Add(yLocal, x1Local, x2Local, curLen);
        outQueueY.EnQue(yLocal);
        inQueueX1.FreeTensor(x1Local);
        inQueueX2.FreeTensor(x2Local);
    }

    __aicore__ inline void CopyOut(int32_t offset, int32_t curLen)
    {
        LocalTensor<half> yLocal = outQueueY.DeQue<half>();
        DataCopy(yGm[offset], yLocal, curLen);
        outQueueY.FreeTensor(yLocal);
    }

private:
    TPipe pipe;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueX1;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueX2;
    TQue<TPosition::VECOUT, BUFFER_NUM> outQueueY;
    GlobalTensor<half> x1Gm;
    GlobalTensor<half> x2Gm;
    GlobalTensor<half> yGm;
    int32_t blockLength;
    int32_t tileLength;
};

__global__ __vector__ void add_custom(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, int64_t totalLength)
{
    int64_t blockNum = GetBlockNum();
    int64_t blockIdx = GetBlockIdx();
    int64_t totalUnits = totalLength / UNIT;
    int64_t unitsPerBlock = totalUnits / blockNum;
    int64_t remainderUnits = totalUnits % blockNum;
    // 前 remainderUnits 个核多分 1 个对齐单元，保证各核起始/长度均为 32B 对齐
    int64_t unitStart = blockIdx * unitsPerBlock + ((blockIdx < remainderUnits) ? blockIdx : remainderUnits);
    int64_t unitCount = unitsPerBlock + ((blockIdx < remainderUnits) ? 1 : 0);
    int64_t blockStart = unitStart * UNIT;
    int64_t blockLength = unitCount * UNIT;
    if (blockLength <= 0) {
        return;
    }

    KernelAdd op;
    op.Init(x1, x2, y, blockStart, blockLength, TILE_LENGTH);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1, GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y, int64_t availableCoreNum, aclrtStream stream)
{
    // 按 shape 计算总元素数（本题固定 [256, 256] -> 65536）
    int64_t totalLength = 1;
    for (int64_t i = 0; i < info_x1.tensors[0].numDims; ++i) {
        totalLength *= info_x1.tensors[0].shape[i];
    }
    int64_t totalUnits = totalLength / UNIT;
    int64_t blockNum = availableCoreNum;
    if (blockNum > totalUnits) {
        blockNum = totalUnits;
    }
    if (blockNum < 1) {
        blockNum = 1;
    }
    add_custom<<<blockNum, nullptr, stream>>>(x1, x2, y, totalLength);
}
