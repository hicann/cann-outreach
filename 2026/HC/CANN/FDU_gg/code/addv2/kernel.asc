#include <cmath>
#include "kernel_operator.h"

// Add Kernel — Ascend C Direct Invocation (Vector Add)
// shape=[256,256]  dtype=float16  total=65536 elements

using namespace AscendC;

constexpr uint32_t BUFFER_NUM = 2;       // double-buffer pipeline
constexpr uint32_t TILE_LEN = 1024;       // elements per tile, 32-byte aligned (1024*2=2048B)

class KernelAdd {
public:
    __aicore__ inline KernelAdd() {}

    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, uint32_t totalLength)
    {
        totalLength_ = totalLength;
        x1Gm.SetGlobalBuffer((__gm__ half *)x1, totalLength_);
        x2Gm.SetGlobalBuffer((__gm__ half *)x2, totalLength_);
        yGm.SetGlobalBuffer((__gm__ half *)y, totalLength_);
        // Allocate local buffers for double-buffered TPipe pipeline
        pipe.InitBuffer(inQueueX1, BUFFER_NUM, TILE_LEN * sizeof(half));
        pipe.InitBuffer(inQueueX2, BUFFER_NUM, TILE_LEN * sizeof(half));
        pipe.InitBuffer(outQueueY, BUFFER_NUM, TILE_LEN * sizeof(half));
    }

    __aicore__ inline void Process()
    {
        // Grid-stride loop: distribute tiles across all blocks to handle
        // any blockNum without requiring even division.
        uint32_t blockNum = GetBlockNum();
        if (blockNum == 0) blockNum = 1;
        uint32_t blockIdx = GetBlockIdx();
        uint32_t stride = blockNum * TILE_LEN;

        for (uint32_t idx = blockIdx * TILE_LEN; idx < totalLength_; idx += stride) {
            uint32_t curLen = totalLength_ - idx;
            if (curLen > TILE_LEN) curLen = TILE_LEN;
            CopyIn(idx, curLen);
            Compute(curLen);
            CopyOut(idx, curLen);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset, uint32_t len)
    {
        LocalTensor<half> x1Local = inQueueX1.AllocTensor<half>();
        LocalTensor<half> x2Local = inQueueX2.AllocTensor<half>();
        DataCopy(x1Local, x1Gm[offset], len);
        DataCopy(x2Local, x2Gm[offset], len);
        inQueueX1.EnQue(x1Local);
        inQueueX2.EnQue(x2Local);
    }

    __aicore__ inline void Compute(uint32_t len)
    {
        LocalTensor<half> x1Local = inQueueX1.DeQue<half>();
        LocalTensor<half> x2Local = inQueueX2.DeQue<half>();
        LocalTensor<half> yLocal = outQueueY.AllocTensor<half>();
        Add(yLocal, x1Local, x2Local, len);
        outQueueY.EnQue(yLocal);
        inQueueX1.FreeTensor(x1Local);
        inQueueX2.FreeTensor(x2Local);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t len)
    {
        LocalTensor<half> yLocal = outQueueY.DeQue<half>();
        DataCopy(yGm[offset], yLocal, len);
        outQueueY.FreeTensor(yLocal);
    }

private:
    TPipe pipe;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueX1;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueX2;
    TQue<TPosition::VECOUT, BUFFER_NUM> outQueueY;
    GlobalTensor<half> x1Gm;
    GlobalTensor<half> x2Gm;
    GlobalTensor<half> yGm;
    uint32_t totalLength_ = 0;
};

// -- Kernel entry point (device side) --
__global__ __vector__ void add_custom(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, uint32_t totalLength)
{
    KernelAdd op;
    op.Init(x1, x2, y, totalLength);
    op.Process();
}

// -- Host-side entry (called by the framework via main.asc) --
extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1, GM_ADDR x2,
    const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y,
    int64_t availableCoreNum, aclrtStream stream)
{
    // Compute total number of elements from the first input tensor's shape
    int64_t totalLength = 1;
    const TensorInfo& tx1 = info_x1.tensors[0];
    for (int64_t i = 0; i < tx1.numDims; ++i) {
        totalLength *= tx1.shape[i];
    }
    if (totalLength <= 0) return;

    // Determine block count: use available cores, but cap so each block
    // has at least one complete tile of work.
    uint32_t blockNum = static_cast<uint32_t>(availableCoreNum);
    if (blockNum <= 0) blockNum = 1;
    uint32_t maxBlocks = static_cast<uint32_t>((totalLength + TILE_LEN - 1) / TILE_LEN);
    if (blockNum > maxBlocks) blockNum = maxBlocks;

    add_custom<<<blockNum, nullptr, stream>>>(x1, x2, y,
        static_cast<uint32_t>(totalLength));
}