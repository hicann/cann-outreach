#include "kernel_operator.h"

using namespace AscendC;

constexpr int32_t TOTAL_ELEMENTS = 256 * 256;
constexpr int32_t TILE_ELEMENTS = 2048;

class AddKernel {
public:
    __aicore__ inline AddKernel() {}

    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y) {
        uint32_t blockNum = GetBlockNum();
        uint32_t blockIdx = GetBlockIdx();

        uint32_t totalGroups = TOTAL_ELEMENTS / 16;
        uint32_t groupsPerBlock = totalGroups / blockNum;
        uint32_t remainderGroups = totalGroups % blockNum;
        uint32_t myGroups = groupsPerBlock + (blockIdx < remainderGroups ? 1 : 0);
        uint32_t myGroupOffset = blockIdx * groupsPerBlock +
                                 (blockIdx < remainderGroups ? blockIdx : remainderGroups);

        elemCount = myGroups * 16;
        startOffset = myGroupOffset * 16;

        x1Gm.SetGlobalBuffer((__gm__ half*)x1 + startOffset);
        x2Gm.SetGlobalBuffer((__gm__ half*)x2 + startOffset);
        yGm.SetGlobalBuffer((__gm__ half*)y + startOffset);

        pipe.InitBuffer(bufX1, TILE_ELEMENTS * sizeof(half));
        pipe.InitBuffer(bufX2, TILE_ELEMENTS * sizeof(half));
        pipe.InitBuffer(bufY, TILE_ELEMENTS * sizeof(half));
    }

    __aicore__ inline void Process() {
        uint32_t offset = 0;
        uint32_t remaining = elemCount;

        while (remaining > 0) {
            uint32_t curLen = (remaining > TILE_ELEMENTS) ? TILE_ELEMENTS : remaining;

            LocalTensor<half> x1Local = bufX1.Get<half>();
            LocalTensor<half> x2Local = bufX2.Get<half>();
            LocalTensor<half> yLocal = bufY.Get<half>();

            DataCopy(x1Local, x1Gm[offset], curLen);
            DataCopy(x2Local, x2Gm[offset], curLen);

            Add(yLocal, x1Local, x2Local, curLen);

            DataCopy(yGm[offset], yLocal, curLen);

            offset += curLen;
            remaining -= curLen;
        }
    }

private:
    TPipe pipe;
    TBuf<TPosition::VECCALC> bufX1;
    TBuf<TPosition::VECCALC> bufX2;
    TBuf<TPosition::VECCALC> bufY;
    GlobalTensor<half> x1Gm;
    GlobalTensor<half> x2Gm;
    GlobalTensor<half> yGm;
    uint32_t elemCount;
    uint32_t startOffset;
};

__global__ __vector__ void add_custom(GM_ADDR x1, GM_ADDR x2, GM_ADDR y) {
    AddKernel add;
    add.Init(x1, x2, y);
    add.Process();
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1,
                           GM_ADDR x2, const TensorGroupInfo& info_x2,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           int64_t availableCoreNum, aclrtStream stream) {
    uint32_t blockNum = static_cast<uint32_t>(availableCoreNum);
    add_custom<<<blockNum, nullptr, stream>>>(x1, x2, y);
}