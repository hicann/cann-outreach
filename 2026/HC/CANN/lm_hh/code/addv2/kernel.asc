#include <cmath>
#include "kernel_operator.h"
/*
 * Add Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 *
 * Kernel: y = x1 + x2  (element-wise Add)
 * Fixed shape [256, 256], dtype float16, ND contiguous.
 */

using namespace AscendC;

constexpr int32_t BUFFER_NUM = 2;    // double buffer depth
constexpr int32_t TILE_LENGTH = 8192; // elements processed per tile (half), 32B aligned (8192 * 2B = 16KB)

class KernelAdd {
public:
    __aicore__ inline KernelAdd() {}
    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, int64_t coreStart, int64_t coreLen)
    {
        this->coreLen = coreLen;
        x1Global.SetGlobalBuffer((__gm__ half *)x1 + coreStart, coreLen);
        x2Global.SetGlobalBuffer((__gm__ half *)x2 + coreStart, coreLen);
        yGlobal.SetGlobalBuffer((__gm__ half *)y + coreStart, coreLen);
        pipe.InitBuffer(inQueueX1, BUFFER_NUM, TILE_LENGTH * sizeof(half));
        pipe.InitBuffer(inQueueX2, BUFFER_NUM, TILE_LENGTH * sizeof(half));
        pipe.InitBuffer(outQueueY, BUFFER_NUM, TILE_LENGTH * sizeof(half));
    }
    __aicore__ inline void Process()
    {
        int64_t tileNum = (coreLen + TILE_LENGTH - 1) / TILE_LENGTH;
        for (int64_t i = 0; i < tileNum; ++i) {
            int64_t offset = i * TILE_LENGTH;
            int32_t curLen = (offset + TILE_LENGTH <= coreLen) ? TILE_LENGTH : static_cast<int32_t>(coreLen - offset);
            CopyIn(offset, curLen);
            Compute(offset, curLen);
            CopyOut(offset, curLen);
        }
    }

private:
    __aicore__ inline void CopyIn(int64_t offset, int32_t curLen)
    {
        LocalTensor<half> x1Local = inQueueX1.AllocTensor<half>();
        LocalTensor<half> x2Local = inQueueX2.AllocTensor<half>();
        DataCopy(x1Local, x1Global[offset], curLen);
        DataCopy(x2Local, x2Global[offset], curLen);
        inQueueX1.EnQue(x1Local);
        inQueueX2.EnQue(x2Local);
    }
    __aicore__ inline void Compute(int64_t offset, int32_t curLen)
    {
        LocalTensor<half> x1Local = inQueueX1.DeQue<half>();
        LocalTensor<half> x2Local = inQueueX2.DeQue<half>();
        LocalTensor<half> yLocal = outQueueY.AllocTensor<half>();
        Add(yLocal, x1Local, x2Local, curLen);
        outQueueY.EnQue(yLocal);
        inQueueX1.FreeTensor(x1Local);
        inQueueX2.FreeTensor(x2Local);
    }
    __aicore__ inline void CopyOut(int64_t offset, int32_t curLen)
    {
        LocalTensor<half> yLocal = outQueueY.DeQue<half>();
        DataCopy(yGlobal[offset], yLocal, curLen);
        outQueueY.FreeTensor(yLocal);
    }

private:
    TPipe pipe;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueX1;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueX2;
    TQue<QuePosition::VECOUT, BUFFER_NUM> outQueueY;
    GlobalTensor<half> x1Global;
    GlobalTensor<half> x2Global;
    GlobalTensor<half> yGlobal;
    int64_t coreLen;
};

__global__ __vector__ void add_custom(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, int64_t totalLength)
{
    int64_t blockIdx = GetBlockIdx();
    int64_t blockNum = GetBlockNum();
    int64_t blockLen = (totalLength + blockNum - 1) / blockNum;
    int64_t coreStart = blockIdx * blockLen;
    int64_t coreLen = (coreStart + blockLen <= totalLength) ? blockLen : (totalLength - coreStart);
    if (coreLen <= 0) {
        return;
    }
    KernelAdd op;
    op.Init(x1, x2, y, coreStart, coreLen);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo &info_x1, GM_ADDR x2,
                           const TensorGroupInfo &info_x2, GM_ADDR y, const TensorGroupInfo &info_y,
                           int64_t availableCoreNum, aclrtStream stream)
{
    int64_t totalLength = 1;
    for (int64_t i = 0; i < info_x1.tensors[0].numDims; ++i) {
        totalLength *= info_x1.tensors[0].shape[i];
    }

    // 每个核至少处理一个 TILE_LENGTH，避免启动过多核导致部分核无有效数据。
    // 同时保证每个核处理的数据量是 32 字节（16 个 half）对齐。
    const int64_t unit = 16;
    int64_t units = totalLength / unit;
    int64_t blockNum = availableCoreNum;
    if (blockNum < 1) {
        blockNum = 1;
    }
    int64_t maxBlocks = totalLength / TILE_LENGTH;
    if (maxBlocks < 1) {
        maxBlocks = 1;
    }
    if (blockNum > maxBlocks) {
        blockNum = maxBlocks;
    }
    if (blockNum > units) {
        blockNum = units;
    }
    if (blockNum < 1) {
        blockNum = 1;
    }
    add_custom<<<blockNum, nullptr, stream>>>(x1, x2, y, totalLength);
}
