#include <cmath>
#include "kernel_operator.h"

using namespace AscendC;

constexpr int32_t BUFFER_NUM = 1;
constexpr int32_t QUEUE_DEPTH = 1;
constexpr int32_t TILE_LENGTH = 2048;  // half 元素数, 2048*2=4096字节 (32B对齐)

/*
 * Add Kernel — Ascend C Direct Invocation
 * 固定 shape [256,256] float16 逐元素加法
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64
 *          7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *
 * 使用方法：按 Tile 粒度循环搬运到 Local Memory 后执行向量加法，再写回 GM。
 */

class KernelAddV2 {
public:
    __aicore__ inline KernelAddV2() {}

    __aicore__ inline void Init(
        GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
        int64_t totalLength)
    {
        // GlobalTensor 指向完整 GM 数据区
        x1Gm_.SetGlobalBuffer((__gm__ half*)x1, totalLength);
        x2Gm_.SetGlobalBuffer((__gm__ half*)x2, totalLength);
        yGm_.SetGlobalBuffer((__gm__ half*)y, totalLength);
        totalLength_ = totalLength;

        // 为每个队列分配 Buffer
        pipe_.InitBuffer(inQueueX1_, BUFFER_NUM, TILE_LENGTH * sizeof(half));
        pipe_.InitBuffer(inQueueX2_, BUFFER_NUM, TILE_LENGTH * sizeof(half));
        pipe_.InitBuffer(outQueueY_, BUFFER_NUM, TILE_LENGTH * sizeof(half));
    }

    __aicore__ inline void Process()
    {
        // Block-cyclic 调度：每个 Core 按 Tile 粒度循环处理
        const int64_t blockIdx = GetBlockIdx();
        const int64_t blockNum = GetBlockNum();
        int64_t tileIdx = blockIdx;
        while (tileIdx * TILE_LENGTH < totalLength_) {
            const int64_t offset = tileIdx * TILE_LENGTH;
            // 当前 Tile 的实际元素数（最后一个 Tile 可能不满 TILE_LENGTH）
            tileLen_ = (offset + TILE_LENGTH <= totalLength_)
                ? TILE_LENGTH
                : totalLength_ - offset;

            CopyIn(offset);
            Compute();
            CopyOut(offset);
            tileIdx += blockNum;
        }
    }

private:
    __aicore__ inline void CopyIn(int64_t offset)
    {
        LocalTensor<half> x1Local = inQueueX1_.AllocTensor<half>();
        LocalTensor<half> x2Local = inQueueX2_.AllocTensor<half>();
        DataCopy(x1Local, x1Gm_[offset], static_cast<uint32_t>(tileLen_));
        DataCopy(x2Local, x2Gm_[offset], static_cast<uint32_t>(tileLen_));
        inQueueX1_.EnQue(x1Local);
        inQueueX2_.EnQue(x2Local);
    }

    __aicore__ inline void Compute()
    {
        LocalTensor<half> x1Local = inQueueX1_.DeQue<half>();
        LocalTensor<half> x2Local = inQueueX2_.DeQue<half>();
        LocalTensor<half> yLocal = outQueueY_.AllocTensor<half>();

        // 使用 count 参数确保只计算实际搬运的元素
        Add(yLocal, x1Local, x2Local, static_cast<uint32_t>(tileLen_));

        outQueueY_.EnQue(yLocal);
        inQueueX1_.FreeTensor(x1Local);
        inQueueX2_.FreeTensor(x2Local);
    }

    __aicore__ inline void CopyOut(int64_t offset)
    {
        LocalTensor<half> yLocal = outQueueY_.DeQue<half>();
        DataCopy(yGm_[offset], yLocal, static_cast<uint32_t>(tileLen_));
        outQueueY_.FreeTensor(yLocal);
    }

private:
    TPipe pipe_;
    TQue<TPosition::VECIN, QUEUE_DEPTH> inQueueX1_;
    TQue<TPosition::VECIN, QUEUE_DEPTH> inQueueX2_;
    TQue<TPosition::VECOUT, QUEUE_DEPTH> outQueueY_;
    GlobalTensor<half> x1Gm_;
    GlobalTensor<half> x2Gm_;
    GlobalTensor<half> yGm_;
    int64_t totalLength_ = 0;
    int64_t tileLen_ = 0;
};

// --------------- 核函数入口 ---------------
__global__ __aicore__ void add_custom(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, int64_t totalLength)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    KernelAddV2 op;
    op.Init(x1, x2, y, totalLength);
    op.Process();
}

// --------------- Host 侧入口 ---------------
extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1,
    GM_ADDR x2, const TensorGroupInfo& info_x2,
    GM_ADDR y, const TensorGroupInfo& info_y,
    int64_t availableCoreNum, aclrtStream stream)
{
    // 从 TensorInfo 读取 shape，计算总元素数
    const TensorInfo& t = info_x1.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t.numDims; ++i) {
        totalLength *= t.shape[i];
    }

    // 确定 block 数量
    int64_t blockNum = availableCoreNum;
    if (blockNum <= 0) {
        blockNum = 1;
    }

    add_custom<<<blockNum, nullptr, stream>>>(x1, x2, y, totalLength);
}