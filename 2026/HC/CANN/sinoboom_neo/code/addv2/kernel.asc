#include <cmath>
#include "kernel_operator.h"
/*
 * Add Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 *
 * __global__ __vector__ void add_custom(...)
 * {
 *     // Available APIs: AscendC::TPipe, AscendC::TQue, AscendC::DataCopy, AscendC::Add, ...
 * }
 */

using namespace AscendC;

// TILE_LENGTH: elements per tile (half = 2 bytes → 2048 * 2 = 4096 bytes per buffer).
// 4096 bytes is 32-byte aligned (128 DataBlocks × 32B), satisfying DataCopy alignment.
// BUFFER_NUM = 2 enables double buffering for DMA/compute overlap.
constexpr int32_t TILE_LENGTH = 2048;
constexpr int32_t BUFFER_NUM = 2;

class AddKernel {
public:
    __aicore__ inline AddKernel() {}

    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, int64_t totalLength)
    {
        blockIdx = GetBlockIdx();
        blockNum = GetBlockNum();

        // Map global memory as half (fp16) tensors.
        x1Gm.SetGlobalBuffer((__gm__ half *)x1);
        x2Gm.SetGlobalBuffer((__gm__ half *)x2);
        yGm.SetGlobalBuffer((__gm__ half *)y);

        // The total data is divided into full tiles of TILE_LENGTH elements.
        // Each block processes tiles in a round-robin fashion:
        //   block i processes tiles: i, i+blockNum, i+2*blockNum, ...
        int32_t numTiles = static_cast<int32_t>(totalLength / TILE_LENGTH);
        tileIdx = blockIdx;
        tileStep = blockNum;
        maxTileIdx = numTiles;

        // Allocate double-buffered UB memory for input and output queues.
        pipe.InitBuffer(inQueueX1, BUFFER_NUM, TILE_LENGTH * sizeof(half));
        pipe.InitBuffer(inQueueX2, BUFFER_NUM, TILE_LENGTH * sizeof(half));
        pipe.InitBuffer(outQueueY, BUFFER_NUM, TILE_LENGTH * sizeof(half));
    }

    __aicore__ inline void Process()
    {
        while (tileIdx < maxTileIdx) {
            int64_t offset = static_cast<int64_t>(tileIdx) * TILE_LENGTH;

            // Stage 1: CopyIn — GM → UB (double-buffered via queue)
            LocalTensor<half> x1Local = inQueueX1.AllocTensor<half>();
            LocalTensor<half> x2Local = inQueueX2.AllocTensor<half>();
            DataCopy(x1Local, x1Gm[offset], TILE_LENGTH);
            DataCopy(x2Local, x2Gm[offset], TILE_LENGTH);
            inQueueX1.EnQue(x1Local);
            inQueueX2.EnQue(x2Local);

            // Stage 2: Compute — Add(x1, x2) → y
            x1Local = inQueueX1.DeQue<half>();
            x2Local = inQueueX2.DeQue<half>();
            LocalTensor<half> yLocal = outQueueY.AllocTensor<half>();
            Add(yLocal, x1Local, x2Local, TILE_LENGTH);
            outQueueY.EnQue(yLocal);
            // Input tensors no longer needed; free them.
            inQueueX1.FreeTensor(x1Local);
            inQueueX2.FreeTensor(x2Local);

            // Stage 3: CopyOut — UB → GM
            yLocal = outQueueY.DeQue<half>();
            DataCopy(yGm[offset], yLocal, TILE_LENGTH);
            outQueueY.FreeTensor(yLocal);

            tileIdx += tileStep;
        }
    }

private:
    TPipe pipe;

    // Input queues (VECIN position)
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueX1;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueX2;

    // Output queue (VECOUT position)
    TQue<QuePosition::VECOUT, BUFFER_NUM> outQueueY;

    GlobalTensor<half> x1Gm;
    GlobalTensor<half> x2Gm;
    GlobalTensor<half> yGm;

    int32_t tileIdx;
    int32_t tileStep;
    int32_t maxTileIdx;
    int32_t blockIdx;
    int32_t blockNum;
};

// ── Device kernel ──
// Launched by run_kernel with <<<blockNum, nullptr, stream>>>.
extern "C" __global__ __vector__ void add_custom(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, int64_t totalLength)
{
    AddKernel op;
    op.Init(x1, x2, y, totalLength);
    op.Process();
}

// ── Host entry (called from main.asc) ──
// Reads shape info from TensorGroupInfo, computes total element count (65536 for [256,256] fp16),
// then launches add_custom on the NPU.
extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1, GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y, int64_t availableCoreNum, aclrtStream stream)
{
    // Compute total element count from input x1's shape.
    const TensorInfo& t0 = info_x1.tensors[0];
    int64_t totalLength = 1;
    for (int64_t d = 0; d < t0.numDims; ++d) {
        totalLength *= t0.shape[d];
    }

    // Each tile processes TILE_LENGTH elements. Cap blockNum to the number of tiles
    // to ensure every block processes at least one full tile (no alignment tail issues).
    int64_t blockNum = availableCoreNum;
    if (blockNum <= 0) {
        blockNum = 1;
    }
    int32_t numTiles = static_cast<int32_t>(totalLength / TILE_LENGTH);
    if (numTiles <= 0) {
        numTiles = 1;  // defensive: fixed shape always has 65536 elements (32 tiles)
    }
    if (blockNum > numTiles) {
        blockNum = numTiles;
    }

    add_custom<<<blockNum, nullptr, stream>>>(x1, x2, y, totalLength);
}