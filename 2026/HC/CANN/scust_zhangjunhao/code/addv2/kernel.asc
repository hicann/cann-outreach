#include <cmath>
#include "kernel_operator.h"

using namespace AscendC;

constexpr int32_t BUFFER_NUM = 2;
constexpr int32_t TILE_SIZE = 8192;

class AddKernel {
public:
    __aicore__ inline AddKernel() {}
    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                int64_t coreLen, int64_t coreStart)
    {
        x1Gm.SetGlobalBuffer((__gm__ half*)x1 + coreStart, coreLen);
        x2Gm.SetGlobalBuffer((__gm__ half*)x2 + coreStart, coreLen);
        yGm.SetGlobalBuffer((__gm__ half*)y + coreStart, coreLen);
        len = static_cast<int32_t>(coreLen);

        pipe.InitBuffer(inQueueX1, BUFFER_NUM, TILE_SIZE * sizeof(half));
        pipe.InitBuffer(inQueueX2, BUFFER_NUM, TILE_SIZE * sizeof(half));
        pipe.InitBuffer(outQueueY, BUFFER_NUM, TILE_SIZE * sizeof(half));
    }

    __aicore__ inline void Process()
    {
        int32_t rest = len;
        int32_t offset = 0;

        while (rest > 0) {
            int32_t tile = (rest > TILE_SIZE) ? TILE_SIZE : rest;
            CopyIn(offset, tile);
            Compute(tile);
            CopyOut(offset, tile);
            offset += tile;
            rest -= tile;
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t offset, int32_t tile)
    {
        LocalTensor<half> x1Local = inQueueX1.AllocTensor<half>();
        LocalTensor<half> x2Local = inQueueX2.AllocTensor<half>();
        AscendC::DataCopy(x1Local, x1Gm[offset], tile);
        AscendC::DataCopy(x2Local, x2Gm[offset], tile);
        inQueueX1.EnQue(x1Local);
        inQueueX2.EnQue(x2Local);
    }

    __aicore__ inline void Compute(int32_t tile)
    {
        LocalTensor<half> x1Local = inQueueX1.DeQue<half>();
        LocalTensor<half> x2Local = inQueueX2.DeQue<half>();
        LocalTensor<half> yLocal = outQueueY.AllocTensor<half>();
        AscendC::Add(yLocal, x1Local, x2Local, tile);
        outQueueY.EnQue(yLocal);
        inQueueX1.FreeTensor(x1Local);
        inQueueX2.FreeTensor(x2Local);
    }

    __aicore__ inline void CopyOut(int32_t offset, int32_t tile)
    {
        LocalTensor<half> yLocal = outQueueY.DeQue<half>();
        AscendC::DataCopy(yGm[offset], yLocal, tile);
        outQueueY.FreeTensor(yLocal);
    }

    TPipe pipe;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueX1;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueX2;
    TQue<QuePosition::VECOUT, BUFFER_NUM> outQueueY;
    GlobalTensor<half> x1Gm, x2Gm, yGm;
    int32_t len;
};

__global__ __aicore__ void add_custom(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                      int64_t totalElements)
{
    int32_t coreIdx = GetBlockIdx();
    int32_t coreNum = GetBlockNum();

    int64_t perCoreBase = totalElements / coreNum;
    int64_t remainder = totalElements % coreNum;
    int64_t start = coreIdx * perCoreBase + (coreIdx < remainder ? coreIdx : remainder);
    int64_t len = perCoreBase + (coreIdx < remainder ? 1 : 0);
    if (len <= 0) return;

    AddKernel op;
    op.Init(x1, x2, y, len, start);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1,
                           GM_ADDR x2, const TensorGroupInfo& info_x2,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           int64_t availableCoreNum, aclrtStream stream)
{
    int64_t totalElements = 1;
    const int64_t* shape = info_x1.tensors[0].shape;
    for (int64_t i = 0; i < info_x1.tensors[0].numDims; i++) {
        totalElements *= shape[i];
    }

    int64_t blockNum = 1;
    // 仅当核心数能整除总元素数，且每核元素数为16的倍数（fp16 32字节对齐）
    // 时才使用多核，否则单核处理保证 DataCopy/Add 地址对齐正确。
    if (availableCoreNum > 1 && totalElements % availableCoreNum == 0 &&
        (totalElements / availableCoreNum) % 16 == 0) {
        blockNum = availableCoreNum;
    }

    add_custom<<<blockNum, nullptr, stream>>>(x1, x2, y, totalElements);
}