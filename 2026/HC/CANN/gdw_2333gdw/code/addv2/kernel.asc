#include <cmath>
#include "kernel_operator.h"

using namespace AscendC;

/*
 * Add Kernel — Ascend C Direct Invocation
 * 固定 shape [256, 256] float16，逐元素相加 y = x1 + x2
 * 使用 availableCoreNum 个核并行，每核处理一段连续元素（blockLen 对齐到 32 字节）。
 */

__global__ __vector__ void add_custom(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    int32_t totalElements, int32_t blockLen)
{
    int32_t blockIdx = GetBlockIdx();
    int32_t offset = blockIdx * blockLen;
    int32_t processLen = blockLen;
    if (offset + processLen > totalElements) {
        processLen = totalElements - offset;
    }
    if (processLen <= 0) {
        return;
    }

    // 本地内存管理对象（一个 kernel 只能初始化一个 TPipe）
    TPipe pipe;

    // 分配输入/输出本地缓冲（InitBuffer 自动补齐 32 字节对齐）
    TBuf<TPosition::VECCALC> x1Buf, x2Buf, yBuf;
    pipe.InitBuffer(x1Buf, processLen * sizeof(half));
    pipe.InitBuffer(x2Buf, processLen * sizeof(half));
    pipe.InitBuffer(yBuf, processLen * sizeof(half));

    LocalTensor<half> x1Local = x1Buf.Get<half>();
    LocalTensor<half> x2Local = x2Buf.Get<half>();
    LocalTensor<half> yLocal = yBuf.Get<half>();

    // 全局内存视图：起始地址按元素偏移，元素个数为 processLen
    GlobalTensor<half> x1Global, x2Global, yGlobal;
    x1Global.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(x1) + offset, processLen);
    x2Global.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(x2) + offset, processLen);
    yGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y) + offset, processLen);

    // 数据搬运 GM -> Local
    DataCopy(x1Local, x1Global, processLen);
    DataCopy(x2Local, x2Global, processLen);

    // 向量加法 y = x1 + x2
    Add(yLocal, x1Local, x2Local, processLen);

    // 数据搬运 Local -> GM
    DataCopy(yGlobal, yLocal, processLen);
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1,
                           GM_ADDR x2, const TensorGroupInfo& info_x2,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           int64_t availableCoreNum, aclrtStream stream)
{
    // 读取输入 shape，计算总元素个数（固定用例 [256, 256]）
    int64_t totalElements = 1;
    const TensorInfo& x1Info = info_x1.tensors[0];
    for (int64_t i = 0; i < x1Info.numDims; ++i) {
        totalElements *= x1Info.shape[i];
    }
    if (totalElements <= 0) {
        return;
    }

    // 核数：不超过可用核数与元素总数
    int32_t blockNum = (int32_t)availableCoreNum;
    if (blockNum > totalElements) {
        blockNum = (int32_t)totalElements;
    }

    // 每核处理元素数，向上取整并对齐到 16（half 2 字节 => 32 字节对齐）
    int32_t blockLen = (int32_t)((totalElements + blockNum - 1) / blockNum);
    blockLen = ((blockLen + 15) / 16) * 16;

    // 启动核函数
    add_custom<<<blockNum, nullptr, stream>>>(x1, x2, y, (int32_t)totalElements, blockLen);
}
