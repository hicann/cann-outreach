#include "kernel_operator.h"

using namespace AscendC;

__global__ __vector__ void add_custom(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, int64_t totalElements, int64_t coreNum)
{
    int32_t blockId = GetBlockIdx();

    int64_t chunkCount = totalElements / 16;
    int64_t chunksPerCore = chunkCount / coreNum;
    int64_t remChunks = chunkCount % coreNum;

    int64_t myChunks = chunksPerCore + (blockId < remChunks ? 1 : 0);
    int64_t offset;
    if (blockId < remChunks) {
        offset = blockId * (chunksPerCore + 1) * 16;
    } else {
        offset = (remChunks * (chunksPerCore + 1) + (blockId - remChunks) * chunksPerCore) * 16;
    }

    GlobalTensor<half> x1Global;
    GlobalTensor<half> x2Global;
    GlobalTensor<half> yGlobal;

    x1Global.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x1) + offset);
    x2Global.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(x2) + offset);
    yGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y) + offset);

    TPipe pipe;
    TBuf<TPosition::VECCALC> bufX1;
    TBuf<TPosition::VECCALC> bufX2;
    TBuf<TPosition::VECCALC> bufY;
    pipe.InitBuffer(bufX1, myChunks * 16 * sizeof(half));
    pipe.InitBuffer(bufX2, myChunks * 16 * sizeof(half));
    pipe.InitBuffer(bufY, myChunks * 16 * sizeof(half));

    LocalTensor<half> x1Local = bufX1.Get<half>();
    LocalTensor<half> x2Local = bufX2.Get<half>();
    LocalTensor<half> yLocal = bufY.Get<half>();

    DataCopy(x1Local, x1Global, myChunks * 16);
    DataCopy(x2Local, x2Global, myChunks * 16);

    Add(yLocal, x1Local, x2Local, myChunks * 16);

    DataCopy(yGlobal, yLocal, myChunks * 16);
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1, GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y, int64_t availableCoreNum, aclrtStream stream)
{
    int64_t totalElements = 1;
    for (int64_t i = 0; i < info_x1.tensors[0].numDims; i++) {
        totalElements *= info_x1.tensors[0].shape[i];
    }
    int64_t coreNum = availableCoreNum;
    if (coreNum > totalElements / 16) {
        coreNum = totalElements / 16;
    }
    if (coreNum < 1) {
        coreNum = 1;
    }
    add_custom<<<(uint32_t)coreNum, nullptr, stream>>>(x1, x2, y, totalElements, coreNum);
}