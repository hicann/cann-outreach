#include "kernel_operator.h"

using namespace AscendC;

constexpr int32_t BUFFER_NUM = 1;

class KernelAdd {
public:
    __aicore__ inline KernelAdd() {}
    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, uint32_t blockLength) {
        uint32_t idx = GetBlockIdx();
        this->blockLength = blockLength;
        x1Gm.SetGlobalBuffer((__gm__ half*)x1 + idx * blockLength, blockLength);
        x2Gm.SetGlobalBuffer((__gm__ half*)x2 + idx * blockLength, blockLength);
        yGm.SetGlobalBuffer((__gm__ half*)y + idx * blockLength, blockLength);
        pipe.InitBuffer(inQueX1, BUFFER_NUM, blockLength * sizeof(half));
        pipe.InitBuffer(inQueX2, BUFFER_NUM, blockLength * sizeof(half));
        pipe.InitBuffer(outQueY, BUFFER_NUM, blockLength * sizeof(half));
    }
    __aicore__ inline void Process() {
        CopyIn();
        Compute();
        CopyOut();
    }
private:
    __aicore__ inline void CopyIn() {
        LocalTensor<half> x1Local = inQueX1.AllocTensor<half>();
        LocalTensor<half> x2Local = inQueX2.AllocTensor<half>();
        DataCopy(x1Local, x1Gm, blockLength);
        DataCopy(x2Local, x2Gm, blockLength);
        inQueX1.EnQue(x1Local);
        inQueX2.EnQue(x2Local);
    }
    __aicore__ inline void Compute() {
        LocalTensor<half> x1Local = inQueX1.DeQue<half>();
        LocalTensor<half> x2Local = inQueX2.DeQue<half>();
        LocalTensor<half> yLocal = outQueY.AllocTensor<half>();
        Add(yLocal, x1Local, x2Local, blockLength);
        outQueY.EnQue(yLocal);
        inQueX1.FreeTensor(x1Local);
        inQueX2.FreeTensor(x2Local);
    }
    __aicore__ inline void CopyOut() {
        LocalTensor<half> yLocal = outQueY.DeQue<half>();
        DataCopy(yGm, yLocal, blockLength);
        outQueY.FreeTensor(yLocal);
    }
private:
    TPipe pipe;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueX1, inQueX2;
    TQue<QuePosition::VECOUT, BUFFER_NUM> outQueY;
    GlobalTensor<half> x1Gm, x2Gm, yGm;
    uint32_t blockLength;
};

__global__ __vector__ void add_custom(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, uint32_t blockLength) {
    KernelAdd op;
    op.Init(x1, x2, y, blockLength);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1, GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y, int64_t availableCoreNum, aclrtStream stream)
{
    int64_t totalLength = 1;
    for (int64_t i = 0; i < info_x1.tensors[0].numDims; i++) {
        totalLength *= info_x1.tensors[0].shape[i];
    }

    int64_t blockNum = 1;
    while (blockNum * 2 <= availableCoreNum && blockNum * 2 <= 128) {
        blockNum *= 2;
    }

    uint32_t blockLength = static_cast<uint32_t>(totalLength / blockNum);

    add_custom<<<blockNum, nullptr, stream>>>(x1, x2, y, blockLength);
}