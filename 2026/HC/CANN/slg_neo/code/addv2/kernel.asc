#include <cmath>
#include "kernel_operator.h"
/*
 * AddV2 Kernel — Ascend C Direct Invocation
 * Fixed shape [256, 256] float16, y = x1 + x2 (elementwise).
 *
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 */

using namespace AscendC;

constexpr int32_t BUFFER_NUM = 2;     // double buffer
constexpr int32_t TILE_ELEMS = 4096;  // elements processed per tile

class KernelAddV2 {
public:
    __aicore__ inline KernelAddV2() {}

    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                uint32_t totalLength, uint32_t blockNum)
    {
        uint32_t blockIdx = GetBlockIdx();
        // Per-core element count, rounded up to multiple of 16 so that every
        // DataCopy count keeps 32B alignment for half (2 bytes).
        perCore_ = (totalLength + blockNum - 1) / blockNum;
        perCore_ = (perCore_ + 15) / 16 * 16;
        start_ = blockIdx * perCore_;
        if (start_ >= totalLength) {
            count_ = 0;
            return;
        }
        count_ = (start_ + perCore_ <= totalLength) ? perCore_ : (totalLength - start_);

        x1Gm_.SetGlobalBuffer((__gm__ half *)x1 + start_, count_);
        x2Gm_.SetGlobalBuffer((__gm__ half *)x2 + start_, count_);
        yGm_.SetGlobalBuffer((__gm__ half *)y + start_, count_);

        pipe_.InitBuffer(inQueueX1_, BUFFER_NUM, TILE_ELEMS * sizeof(half));
        pipe_.InitBuffer(inQueueX2_, BUFFER_NUM, TILE_ELEMS * sizeof(half));
        pipe_.InitBuffer(outQueueY_, BUFFER_NUM, TILE_ELEMS * sizeof(half));
    }

    __aicore__ inline void Process()
    {
        if (count_ == 0) {
            return;
        }
        uint32_t tileNum = (count_ + TILE_ELEMS - 1) / TILE_ELEMS;
        for (uint32_t t = 0; t < tileNum; ++t) {
            CopyIn(t);
            Compute(t);
            CopyOut(t);
        }
    }

private:
    __aicore__ inline uint32_t CurLen(uint32_t t) const
    {
        uint32_t offset = t * TILE_ELEMS;
        return (offset + TILE_ELEMS <= count_) ? TILE_ELEMS : (count_ - offset);
    }

    __aicore__ inline void CopyIn(uint32_t t)
    {
        LocalTensor<half> x1Local = inQueueX1_.AllocTensor<half>();
        LocalTensor<half> x2Local = inQueueX2_.AllocTensor<half>();
        uint32_t len = CurLen(t);
        DataCopy(x1Local, x1Gm_[t * TILE_ELEMS], len);
        DataCopy(x2Local, x2Gm_[t * TILE_ELEMS], len);
        inQueueX1_.EnQue(x1Local);
        inQueueX2_.EnQue(x2Local);
    }

    __aicore__ inline void Compute(uint32_t t)
    {
        LocalTensor<half> x1Local = inQueueX1_.DeQue<half>();
        LocalTensor<half> x2Local = inQueueX2_.DeQue<half>();
        LocalTensor<half> yLocal = outQueueY_.AllocTensor<half>();
        uint32_t len = CurLen(t);
        Add(yLocal, x1Local, x2Local, len);
        outQueueY_.EnQue(yLocal);
        inQueueX1_.FreeTensor(x1Local);
        inQueueX2_.FreeTensor(x2Local);
    }

    __aicore__ inline void CopyOut(uint32_t t)
    {
        LocalTensor<half> yLocal = outQueueY_.DeQue<half>();
        uint32_t len = CurLen(t);
        DataCopy(yGm_[t * TILE_ELEMS], yLocal, len);
        outQueueY_.FreeTensor(yLocal);
    }

private:
    TPipe pipe_;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueX1_;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueX2_;
    TQue<TPosition::VECOUT, BUFFER_NUM> outQueueY_;
    GlobalTensor<half> x1Gm_;
    GlobalTensor<half> x2Gm_;
    GlobalTensor<half> yGm_;
    uint32_t start_ = 0;
    uint32_t count_ = 0;
    uint32_t perCore_ = 0;
};

extern "C" __global__ __aicore__ void add_custom(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    uint32_t totalLength, uint32_t blockNum)
{
    KernelAddV2 op;
    op.Init(x1, x2, y, totalLength, blockNum);
    op.Process();
}

extern "C" void run_kernel(
    GM_ADDR x1, const TensorGroupInfo &info_x1,
    GM_ADDR x2, const TensorGroupInfo &info_x2,
    GM_ADDR y, const TensorGroupInfo &info_y,
    int64_t availableCoreNum, aclrtStream stream)
{
    // Compute the total element count from the input shape.
    int64_t totalLength = 1;
    const TensorInfo &tx1 = info_x1.tensors[0];
    for (int64_t d = 0; d < tx1.numDims; ++d) {
        totalLength *= tx1.shape[d];
    }

    int64_t blockNum = availableCoreNum;
    if (blockNum <= 0) {
        blockNum = 1;
    }
    if (blockNum > totalLength) {
        blockNum = totalLength;
    }

    add_custom<<<blockNum, nullptr, stream>>>(
        x1, x2, y, static_cast<uint32_t>(totalLength), static_cast<uint32_t>(blockNum));
}
