#include "kernel_operator.h"

using namespace AscendC;

constexpr int32_t TOTAL_ELEMENTS = 65536;
constexpr int32_t TILE_ELEMENTS = 8192;
constexpr int32_t TILE_NUM = TOTAL_ELEMENTS / TILE_ELEMENTS;

class AddCustom {
public:
    __aicore__ inline AddCustom() {}

    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y) {
        x1Addr = (__gm__ half*)x1;
        x2Addr = (__gm__ half*)x2;
        yAddr = (__gm__ half*)y;

        pipe.InitBuffer(inQueueX1, 1, TILE_ELEMENTS * sizeof(half));
        pipe.InitBuffer(inQueueX2, 1, TILE_ELEMENTS * sizeof(half));
        pipe.InitBuffer(outQueueY, 1, TILE_ELEMENTS * sizeof(half));
    }

    __aicore__ inline void Process() {
        for (int32_t i = 0; i < TILE_NUM; i++) {
            LocalTensor<half> x1Local = inQueueX1.AllocTensor<half>();
            LocalTensor<half> x2Local = inQueueX2.AllocTensor<half>();
            LocalTensor<half> yLocal = outQueueY.AllocTensor<half>();

            int32_t offset = i * TILE_ELEMENTS;

            x1Gm.SetGlobalBuffer(x1Addr + offset, TILE_ELEMENTS);
            x2Gm.SetGlobalBuffer(x2Addr + offset, TILE_ELEMENTS);
            yGm.SetGlobalBuffer(yAddr + offset, TILE_ELEMENTS);

            DataCopy(x1Local, x1Gm, TILE_ELEMENTS);
            DataCopy(x2Local, x2Gm, TILE_ELEMENTS);

            inQueueX1.EnQue(x1Local);
            inQueueX2.EnQue(x2Local);

            x1Local = inQueueX1.DeQue<half>();
            x2Local = inQueueX2.DeQue<half>();

            Add(yLocal, x1Local, x2Local, TILE_ELEMENTS);

            outQueueY.EnQue(yLocal);
            yLocal = outQueueY.DeQue<half>();

            DataCopy(yGm, yLocal, TILE_ELEMENTS);

            inQueueX1.FreeTensor(x1Local);
            inQueueX2.FreeTensor(x2Local);
            outQueueY.FreeTensor(yLocal);
        }
    }

private:
    TPipe pipe;
    TQue<TPosition::VECIN, 1> inQueueX1;
    TQue<TPosition::VECIN, 1> inQueueX2;
    TQue<TPosition::VECOUT, 1> outQueueY;
    GlobalTensor<half> x1Gm;
    GlobalTensor<half> x2Gm;
    GlobalTensor<half> yGm;
    __gm__ half* x1Addr;
    __gm__ half* x2Addr;
    __gm__ half* yAddr;
};

__global__ __vector__ void add_custom(GM_ADDR x1, GM_ADDR x2, GM_ADDR y) {
    AddCustom op;
    op.Init(x1, x2, y);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1,
    GM_ADDR x2, const TensorGroupInfo& info_x2,
    GM_ADDR y, const TensorGroupInfo& info_y,
    int64_t availableCoreNum, aclrtStream stream)
{
    add_custom<<<1, nullptr, stream>>>(x1, x2, y);
}