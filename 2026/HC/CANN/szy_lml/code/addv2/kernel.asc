#include <cmath>
#include "kernel_operator.h"
/*
 * Add Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 *
 * 固定 shape [256,256] fp16 逐元素加法：y = x1 + x2。
 * 多核切分（每核连续分片），片内按 TILE_ELEMENTS 分块，使用 DataCopyPad 支持任意长度（含非 32B 对齐尾块）。
 */

using namespace AscendC;

constexpr int32_t TILE_ELEMENTS = 8192;   // 每片元素数（fp16，16KB）
constexpr int32_t BUFFER_NUM = 2;         // 双缓冲

class KernelAddV2 {
public:
    __aicore__ inline KernelAddV2() {}

    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                int64_t totalElements, int64_t blockDim)
    {
        totalLength = static_cast<int32_t>(totalElements);
        blockDimValue = static_cast<int32_t>(blockDim);
        blockIdx = static_cast<int32_t>(GetBlockIdx());

        x1Global.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(x1));
        x2Global.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(x2));
        yGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y));

        uint32_t tileBytes = static_cast<uint32_t>(TILE_ELEMENTS) * sizeof(half);
        pipe.InitBuffer(inQueueX1, BUFFER_NUM, tileBytes);
        pipe.InitBuffer(inQueueX2, BUFFER_NUM, tileBytes);
        pipe.InitBuffer(outQueueY, BUFFER_NUM, tileBytes);
    }

    __aicore__ inline void Process()
    {
        int32_t perCore = CeilDiv(totalLength, blockDimValue);
        int32_t start = blockIdx * perCore;
        if (start >= totalLength) {
            return;
        }
        int32_t end = start + perCore;
        if (end > totalLength) {
            end = totalLength;
        }

        int32_t cur = start;
        while (cur < end) {
            int32_t len = end - cur;
            if (len > TILE_ELEMENTS) {
                len = TILE_ELEMENTS;
            }
            ProcessTile(cur, len);
            cur += len;
        }
    }

private:
    __aicore__ inline int32_t CeilDiv(int32_t a, int32_t b)
    {
        return (a + b - 1) / b;
    }

    __aicore__ inline void ProcessTile(int32_t offset, int32_t len)
    {
        uint32_t bytes = static_cast<uint32_t>(len) * sizeof(half);
        DataCopyExtParams copyParams {1, bytes, 0, 0, 0};
        DataCopyPadExtParams<half> padParams {false, 0, 0, static_cast<half>(0)};

        LocalTensor<half> x1Local = inQueueX1.AllocTensor<half>();
        LocalTensor<half> x2Local = inQueueX2.AllocTensor<half>();
        DataCopyPad(x1Local, x1Global[offset], copyParams, padParams);
        DataCopyPad(x2Local, x2Global[offset], copyParams, padParams);
        inQueueX1.EnQue(x1Local);
        inQueueX2.EnQue(x2Local);

        LocalTensor<half> x1Cur = inQueueX1.DeQue<half>();
        LocalTensor<half> x2Cur = inQueueX2.DeQue<half>();
        LocalTensor<half> yLocal = outQueueY.AllocTensor<half>();
        Add(yLocal, x1Cur, x2Cur, len);
        outQueueY.EnQue(yLocal);
        inQueueX1.FreeTensor(x1Cur);
        inQueueX2.FreeTensor(x2Cur);

        LocalTensor<half> yCur = outQueueY.DeQue<half>();
        DataCopyPad(yGlobal[offset], yCur, copyParams);
        outQueueY.FreeTensor(yCur);
    }

    TPipe pipe;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueX1;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueX2;
    TQue<TPosition::VECOUT, BUFFER_NUM> outQueueY;
    GlobalTensor<half> x1Global;
    GlobalTensor<half> x2Global;
    GlobalTensor<half> yGlobal;
    int32_t totalLength;
    int32_t blockDimValue;
    int32_t blockIdx;
};

__global__ __aicore__ void addv2_kernel(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                        int64_t totalElements, int64_t blockDim)
{
    KernelAddV2 op;
    op.Init(x1, x2, y, totalElements, blockDim);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1, GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y, int64_t availableCoreNum, aclrtStream stream)
{
    int64_t totalElements = 1;
    const TensorInfo& info = info_x1.tensors[0];
    for (int64_t i = 0; i < info.numDims; ++i) {
        totalElements *= info.shape[i];
    }

    if (info.dtype != 1) {  // 1 = float16
        return;
    }

    int64_t blockDim = availableCoreNum;
    if (blockDim <= 0) {
        blockDim = 1;
    }
    if (blockDim > totalElements) {
        blockDim = totalElements;
    }

    addv2_kernel<<<blockDim, nullptr, stream>>>(x1, x2, y, totalElements, blockDim);
}