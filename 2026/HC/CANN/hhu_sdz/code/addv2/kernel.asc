#include "kernel_operator.h"

using namespace AscendC;

constexpr int32_t TILE_LEN = 1024;
constexpr int32_t BUFFER_NUM = 2;

class KernelAdd {
public:
    __aicore__ inline KernelAdd(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                int64_t blockStart, int64_t blockLength)
        : blockStart_(blockStart), blockLength_(blockLength)
    {
        x1Gm_.SetGlobalBuffer((__gm__ half*)x1);
        x2Gm_.SetGlobalBuffer((__gm__ half*)x2);
        yGm_.SetGlobalBuffer((__gm__ half*)y);

        pipe.InitBuffer(x1Queue_, BUFFER_NUM, TILE_LEN * sizeof(half));
        pipe.InitBuffer(x2Queue_, BUFFER_NUM, TILE_LEN * sizeof(half));
        pipe.InitBuffer(yQueue_, BUFFER_NUM, TILE_LEN * sizeof(half));
    }

    __aicore__ inline void Process()
    {
        int64_t offset = blockStart_;
        int64_t remaining = blockLength_;
        while (remaining > 0) {
            int64_t curLen = (remaining >= TILE_LEN) ? TILE_LEN : remaining;
            CopyIn(offset, curLen);
            Compute(curLen);
            CopyOut(offset, curLen);
            offset += curLen;
            remaining -= curLen;
        }
    }

private:
    __aicore__ inline void CopyIn(int64_t offset, int64_t len)
    {
        LocalTensor<half> x1Local = x1Queue_.AllocTensor<half>();
        LocalTensor<half> x2Local = x2Queue_.AllocTensor<half>();
        DataCopy(x1Local, x1Gm_[offset], len);
        DataCopy(x2Local, x2Gm_[offset], len);
        x1Queue_.EnQue(x1Local);
        x2Queue_.EnQue(x2Local);
    }

    __aicore__ inline void Compute(int64_t len)
    {
        LocalTensor<half> x1Local = x1Queue_.DeQue<half>();
        LocalTensor<half> x2Local = x2Queue_.DeQue<half>();
        LocalTensor<half> yLocal = yQueue_.AllocTensor<half>();
        Add(yLocal, x1Local, x2Local, len);
        yQueue_.EnQue(yLocal);
        x1Queue_.FreeTensor(x1Local);
        x2Queue_.FreeTensor(x2Local);
    }

    __aicore__ inline void CopyOut(int64_t offset, int64_t len)
    {
        LocalTensor<half> yLocal = yQueue_.DeQue<half>();
        DataCopy(yGm_[offset], yLocal, len);
        yQueue_.FreeTensor(yLocal);
    }

private:
    TPipe pipe;
    TQue<QuePosition::VECIN, BUFFER_NUM> x1Queue_;
    TQue<QuePosition::VECIN, BUFFER_NUM> x2Queue_;
    TQue<QuePosition::VECOUT, BUFFER_NUM> yQueue_;
    GlobalTensor<half> x1Gm_;
    GlobalTensor<half> x2Gm_;
    GlobalTensor<half> yGm_;
    int64_t blockStart_;
    int64_t blockLength_;
};

__global__ __vector__ void add_custom(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, int64_t totalLength)
{
    int64_t blockNum = GetBlockNum();
    int64_t coreIdx = GetBlockIdx();
    constexpr int64_t ALIGN_UNIT = 16;
    int64_t totalUnits = totalLength / ALIGN_UNIT;
    int64_t blockUnits = totalUnits / blockNum;
    int64_t remUnits = totalUnits % blockNum;
    int64_t startUnit = coreIdx * blockUnits + ((coreIdx < remUnits) ? coreIdx : remUnits);
    int64_t numUnits = blockUnits + ((coreIdx < remUnits) ? 1 : 0);
    int64_t blockStart = startUnit * ALIGN_UNIT;
    int64_t blockLength = numUnits * ALIGN_UNIT;
    if (blockLength <= 0) {
        return;
    }
    KernelAdd op(x1, x2, y, blockStart, blockLength);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1,
                           GM_ADDR x2, const TensorGroupInfo& info_x2,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           int64_t availableCoreNum, aclrtStream stream)
{
    int64_t totalLength = 1;
    for (int64_t i = 0; i < info_x1.tensors[0].numDims; i++) {
        totalLength *= info_x1.tensors[0].shape[i];
    }
    add_custom<<<availableCoreNum, nullptr, stream>>>(x1, x2, y, totalLength);
}