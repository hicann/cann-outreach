#include <cmath>
#include "kernel_operator.h"

using namespace AscendC;

/*
 * Add Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * Task: fixed shape [256, 256], float16, ND contiguous.
 *   y[i] = x1[i] + x2[i], element-wise vector Add.
 *
 * Multi-core partition uses whole BLOCK_SIZE chunks so that every GM
 * address and copy length stays 32-byte aligned for DataCopy.
 */

constexpr int32_t BUFFER_NUM = 2;   // double buffer
constexpr int32_t BLOCK_SIZE = 1024; // elements per chunk (2048 B)

class KernelAdd {
public:
    __aicore__ inline KernelAdd(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, int64_t totalLength)
    {
        totalLength_ = totalLength;
        x1Gm_.SetGlobalBuffer((__gm__ half *)x1, totalLength_);
        x2Gm_.SetGlobalBuffer((__gm__ half *)x2, totalLength_);
        yGm_.SetGlobalBuffer((__gm__ half *)y, totalLength_);
        pipe_.InitBuffer(inQueX1_, BUFFER_NUM, BLOCK_SIZE * sizeof(half));
        pipe_.InitBuffer(inQueX2_, BUFFER_NUM, BLOCK_SIZE * sizeof(half));
        pipe_.InitBuffer(outQueY_, BUFFER_NUM, BLOCK_SIZE * sizeof(half));
    }

    __aicore__ inline void Process()
    {
        int64_t blockNum = GetBlockNum();
        int64_t blockIdx = GetBlockIdx();
        if (blockNum <= 0) {
            return;
        }

        // Distribute whole chunks (of BLOCK_SIZE elements) across cores.
        int64_t totalChunks = (totalLength_ + BLOCK_SIZE - 1) / BLOCK_SIZE;
        int64_t perBlock = totalChunks / blockNum;
        int64_t rem = totalChunks % blockNum;
        int64_t myChunks = perBlock + (blockIdx < rem ? 1 : 0);
        int64_t chunkStart = blockIdx * perBlock + (blockIdx < rem ? blockIdx : rem);

        for (int64_t c = 0; c < myChunks; ++c) {
            int64_t chunkIdx = chunkStart + c;
            int64_t offset = chunkIdx * BLOCK_SIZE;
            int64_t len = BLOCK_SIZE;
            if (offset + len > totalLength_) {
                len = totalLength_ - offset;
            }
            CopyIn(offset, (int32_t)len);
            Compute(offset, (int32_t)len);
            CopyOut(offset, (int32_t)len);
        }
    }

private:
    __aicore__ inline void CopyIn(int64_t offset, int32_t len)
    {
        LocalTensor<half> x1Local = inQueX1_.AllocTensor<half>();
        LocalTensor<half> x2Local = inQueX2_.AllocTensor<half>();
        DataCopy(x1Local, x1Gm_[offset], len);
        DataCopy(x2Local, x2Gm_[offset], len);
        inQueX1_.EnQue(x1Local);
        inQueX2_.EnQue(x2Local);
    }

    __aicore__ inline void Compute(int64_t offset, int32_t len)
    {
        LocalTensor<half> x1Local = inQueX1_.DeQue<half>();
        LocalTensor<half> x2Local = inQueX2_.DeQue<half>();
        LocalTensor<half> yLocal = outQueY_.AllocTensor<half>();
        Add(yLocal, x1Local, x2Local, len);
        outQueY_.EnQue(yLocal);
        inQueX1_.FreeTensor(x1Local);
        inQueX2_.FreeTensor(x2Local);
    }

    __aicore__ inline void CopyOut(int64_t offset, int32_t len)
    {
        LocalTensor<half> yLocal = outQueY_.DeQue<half>();
        DataCopy(yGm_[offset], yLocal, len);
        outQueY_.FreeTensor(yLocal);
    }

private:
    TPipe pipe_;
    GlobalTensor<half> x1Gm_;
    GlobalTensor<half> x2Gm_;
    GlobalTensor<half> yGm_;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueX1_;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueX2_;
    TQue<TPosition::VECOUT, BUFFER_NUM> outQueY_;
    int64_t totalLength_;
};

extern "C" __global__ __vector__ void add_custom(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                                 int64_t totalLength)
{
    KernelAdd op(x1, x2, y, totalLength);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1, GM_ADDR x2,
                           const TensorGroupInfo& info_x2, GM_ADDR y,
                           const TensorGroupInfo& info_y, int64_t availableCoreNum,
                           aclrtStream stream)
{
    // Compute total element count from x1 shape ([256, 256] -> 65536).
    int64_t totalLength = 1;
    const TensorInfo& x1Info = info_x1.tensors[0];
    for (int64_t i = 0; i < x1Info.numDims; ++i) {
        totalLength *= x1Info.shape[i];
    }
    if (totalLength < 1) {
        totalLength = 1;
    }

    int64_t totalChunks = (totalLength + BLOCK_SIZE - 1) / BLOCK_SIZE;
    int64_t blockNum = availableCoreNum > 0 ? availableCoreNum : 1;
    if (blockNum > totalChunks) {
        blockNum = totalChunks;
    }
    if (blockNum < 1) {
        blockNum = 1;
    }

    add_custom<<<blockNum, nullptr, stream>>>(x1, x2, y, totalLength);
}