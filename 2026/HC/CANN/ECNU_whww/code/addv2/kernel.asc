#include <cmath>
#include "kernel_operator.h"
/*
 * Add Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *
 * 固定 Shape [256, 256]，float16，逐元素 y = x1 + x2。
 * 按 block 切分 GM->Local 搬运，向量 Add 计算，Local->GM 写回，
 * 使用 double buffer 实现搬运/计算流水。
 */

using namespace AscendC;

namespace {
constexpr int32_t BUFFER_NUM = 2;
constexpr int32_t ELEMENTS_PER_BLOCK = 128;
}

class AddKernel {
public:
    __aicore__ inline AddKernel() {}
    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                int64_t coreNum, int64_t totalLength, TPipe* pipeIn)
    {
        pipe = pipeIn;
        coreIdx = GetBlockIdx();

        int64_t totalBlocks = (totalLength + ELEMENTS_PER_BLOCK - 1) / ELEMENTS_PER_BLOCK;
        int64_t blocksPerCore = totalBlocks / coreNum;
        int64_t remainderBlocks = totalBlocks % coreNum;
        blocks = blocksPerCore + (coreIdx < remainderBlocks ? 1 : 0);
        int64_t offsetBlocks = coreIdx * blocksPerCore + (coreIdx < remainderBlocks ? coreIdx : remainderBlocks);
        start = offsetBlocks * ELEMENTS_PER_BLOCK;
        length = totalLength - start;
        if (length > blocks * ELEMENTS_PER_BLOCK) {
            length = blocks * ELEMENTS_PER_BLOCK;
        }

        x1Gm.SetGlobalBuffer((__gm__ half*)x1 + start);
        x2Gm.SetGlobalBuffer((__gm__ half*)x2 + start);
        yGm.SetGlobalBuffer((__gm__ half*)y + start);

        pipe->InitBuffer(inQueX1, BUFFER_NUM, ELEMENTS_PER_BLOCK * sizeof(half));
        pipe->InitBuffer(inQueX2, BUFFER_NUM, ELEMENTS_PER_BLOCK * sizeof(half));
        pipe->InitBuffer(outQueY, BUFFER_NUM, ELEMENTS_PER_BLOCK * sizeof(half));
    }

    __aicore__ inline void Process()
    {
        if (blocks <= 0) {
            return;
        }
        CopyIn(0);
        for (int32_t i = 0; i < blocks; i++) {
            Compute(i);
            if (i != blocks - 1) {
                CopyIn(i + 1);
            }
            CopyOut(i);
        }
    }

private:
    __aicore__ inline int32_t GetCount(int32_t i) const
    {
        int32_t offset = i * ELEMENTS_PER_BLOCK;
        int64_t remaining = length - offset;
        return remaining > ELEMENTS_PER_BLOCK ? ELEMENTS_PER_BLOCK : static_cast<int32_t>(remaining);
    }

    __aicore__ inline void CopyIn(int32_t i)
    {
        LocalTensor<half> x1Local = inQueX1.AllocTensor<half>();
        LocalTensor<half> x2Local = inQueX2.AllocTensor<half>();
        int32_t count = GetCount(i);
        DataCopy(x1Local, x1Gm[i * ELEMENTS_PER_BLOCK], count);
        DataCopy(x2Local, x2Gm[i * ELEMENTS_PER_BLOCK], count);
        inQueX1.EnQue(x1Local);
        inQueX2.EnQue(x2Local);
    }

    __aicore__ inline void Compute(int32_t i)
    {
        LocalTensor<half> x1Local = inQueX1.DeQue<half>();
        LocalTensor<half> x2Local = inQueX2.DeQue<half>();
        LocalTensor<half> yLocal = outQueY.AllocTensor<half>();
        int32_t count = GetCount(i);
        Add(yLocal, x1Local, x2Local, count);
        outQueY.EnQue(yLocal);
        inQueX1.FreeTensor(x1Local);
        inQueX2.FreeTensor(x2Local);
    }

    __aicore__ inline void CopyOut(int32_t i)
    {
        LocalTensor<half> yLocal = outQueY.DeQue<half>();
        int32_t count = GetCount(i);
        DataCopy(yGm[i * ELEMENTS_PER_BLOCK], yLocal, count);
        outQueY.FreeTensor(yLocal);
    }

    TPipe* pipe;
    GlobalTensor<half> x1Gm;
    GlobalTensor<half> x2Gm;
    GlobalTensor<half> yGm;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueX1;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueX2;
    TQue<TPosition::VECOUT, BUFFER_NUM> outQueY;
    int64_t start;
    int64_t length;
    int64_t blocks;
    int64_t coreIdx;
};

__global__ __vector__ void add_custom(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, int64_t totalLength, int64_t coreNum)
{
    TPipe pipe;
    AddKernel op;
    op.Init(x1, x2, y, coreNum, totalLength, &pipe);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1, GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y, int64_t availableCoreNum, aclrtStream stream)
{
    int64_t totalLength = 1;
    for (int64_t i = 0; i < info_x1.tensors[0].numDims; i++) {
        totalLength *= info_x1.tensors[0].shape[i];
    }
    int64_t totalBlocks = (totalLength + ELEMENTS_PER_BLOCK - 1) / ELEMENTS_PER_BLOCK;
    int64_t blockNum = availableCoreNum;
    if (blockNum > totalBlocks) {
        blockNum = totalBlocks;
    }
    int64_t p2 = 1;
    while (p2 * 2 <= blockNum) {
        p2 *= 2;
    }
    blockNum = p2;
    if (blockNum < 1) {
        blockNum = 1;
    }
    add_custom<<<blockNum, nullptr, stream>>>(x1, x2, y, totalLength, blockNum);
}
