#include "kernel_operator.h"

using namespace AscendC;

constexpr int32_t TILE_LEN = 4096;

__global__ __aicore__ void add_custom(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, int64_t totalElems)
{
    int64_t blockNum = GetBlockNum();
    int64_t blockIdx = GetBlockIdx();
    int64_t blockLen16 = (totalElems / blockNum / 16) * 16;
    int64_t remain16 = totalElems - blockLen16 * blockNum;
    int64_t extraBlocks = remain16 / 16;
    int64_t curBlockLen = blockLen16 + (blockIdx < extraBlocks ? 16 : 0);
    int64_t curOffset = blockIdx * blockLen16 + (blockIdx < extraBlocks ? blockIdx * 16 : extraBlocks * 16);

    if (curBlockLen == 0) return;

    __gm__ half* x1Gm = reinterpret_cast<__gm__ half*>(x1) + curOffset;
    __gm__ half* x2Gm = reinterpret_cast<__gm__ half*>(x2) + curOffset;
    __gm__ half* yGm = reinterpret_cast<__gm__ half*>(y) + curOffset;

    TPipe pipe;
    TQue<TPosition::VECIN, 1> queX1, queX2;
    TQue<TPosition::VECOUT, 1> queY;

    pipe.InitBuffer(queX1, 1, TILE_LEN * sizeof(half));
    pipe.InitBuffer(queX2, 1, TILE_LEN * sizeof(half));
    pipe.InitBuffer(queY, 1, TILE_LEN * sizeof(half));

    LocalTensor<half> localX1 = queX1.AllocTensor<half>();
    LocalTensor<half> localX2 = queX2.AllocTensor<half>();
    LocalTensor<half> localY = queY.AllocTensor<half>();

    int32_t tileNum = curBlockLen / TILE_LEN;
    int32_t lastTile = curBlockLen % TILE_LEN;

    for (int32_t i = 0; i < tileNum; i++) {
        GlobalTensor<half> x1GT, x2GT, yGT;
        x1GT.SetGlobalBuffer(x1Gm + i * TILE_LEN, TILE_LEN);
        x2GT.SetGlobalBuffer(x2Gm + i * TILE_LEN, TILE_LEN);
        yGT.SetGlobalBuffer(yGm + i * TILE_LEN, TILE_LEN);

        DataCopy(localX1, x1GT, TILE_LEN);
        DataCopy(localX2, x2GT, TILE_LEN);
        Add(localY, localX1, localX2, TILE_LEN);
        DataCopy(yGT, localY, TILE_LEN);
    }

    if (lastTile > 0) {
        GlobalTensor<half> x1GT, x2GT, yGT;
        x1GT.SetGlobalBuffer(x1Gm + tileNum * TILE_LEN, lastTile);
        x2GT.SetGlobalBuffer(x2Gm + tileNum * TILE_LEN, lastTile);
        yGT.SetGlobalBuffer(yGm + tileNum * TILE_LEN, lastTile);

        DataCopy(localX1, x1GT, lastTile);
        DataCopy(localX2, x2GT, lastTile);
        Add(localY, localX1, localX2, lastTile);
        DataCopy(yGT, localY, lastTile);
    }

    queX1.FreeTensor(localX1);
    queX2.FreeTensor(localX2);
    queY.FreeTensor(localY);
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1, GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y, int64_t availableCoreNum, aclrtStream stream)
{
    int64_t totalElems = 1;
    for (int64_t i = 0; i < info_x1.tensors[0].numDims; i++) {
        totalElems *= info_x1.tensors[0].shape[i];
    }

    add_custom<<<availableCoreNum, nullptr, stream>>>(x1, x2, y, totalElems);
}