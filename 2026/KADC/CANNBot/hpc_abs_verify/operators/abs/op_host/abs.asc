// ============================================================================
// Ascend C Kernel 直调样例 - Abs 算子（Host + Main 入口）
// ============================================================================

#include <cstdint>
#include <iostream>
#include <vector>
#include "acl/acl.h"
#include "../op_kernel/abs_tiling.h"
#include "data_utils.h"

// 引用拆出的纯 kernel 文件（包含 kernel_operator.h）
#include "../op_kernel/abs_kernel.asc"

// ============================================================================
// Host 端代码 - 运行在 CPU 上
// ============================================================================

struct ArgInfo {
    std::string fileName;
    size_t length;
};

// KernelCall 封装 - 处理完整的核函数调用流程（单输入单输出）
void KernelCall(uint32_t blockNum, aclrtStream stream,
    std::vector<ArgInfo> &inputsInfo, std::vector<ArgInfo> &outputsInfo,
    uint8_t *tilingData)
{
    std::vector<uint8_t *> inputHost(inputsInfo.size());
    std::vector<uint8_t *> inputDevice(inputsInfo.size());
    std::vector<uint8_t *> outputHost(outputsInfo.size());
    std::vector<uint8_t *> outputDevice(outputsInfo.size());
    uint8_t *tilingDevice = nullptr;

    aclrtMalloc((void **)&tilingDevice, sizeof(AbsTilingData), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(tilingDevice, sizeof(AbsTilingData), tilingData,
        sizeof(AbsTilingData), ACL_MEMCPY_HOST_TO_DEVICE);

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtMallocHost((void **)&inputHost[i], inputsInfo[i].length);
        aclrtMalloc((void **)&inputDevice[i], inputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile(inputsInfo[i].fileName, inputsInfo[i].length, inputHost[i], inputsInfo[i].length);
        aclrtMemcpy(inputDevice[i], inputsInfo[i].length, inputHost[i],
            inputsInfo[i].length, ACL_MEMCPY_HOST_TO_DEVICE);
    }

    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMallocHost((void **)&outputHost[i], outputsInfo[i].length);
        aclrtMalloc((void **)&outputDevice[i], outputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
    }

    // kernel 入口函数名（单输入单输出）
    abs_kernel<<<blockNum, nullptr, stream>>>(
        inputDevice[0],
        outputDevice[0], tilingDevice);
    aclrtSynchronizeStream(stream);

    aclrtFree(tilingDevice);
    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMemcpy(outputHost[i], outputsInfo[i].length, outputDevice[i],
            outputsInfo[i].length, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile(outputsInfo[i].fileName, outputHost[i], outputsInfo[i].length);
        aclrtFree(outputDevice[i]);
        aclrtFreeHost(outputHost[i]);
    }

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtFree(inputDevice[i]);
        aclrtFreeHost(inputHost[i]);
    }
}

// [PATTERN] ACL 标准初始化流程
int32_t main(int32_t argc, char *argv[])
{
    aclInit(nullptr);
    int32_t deviceId = 0;
    auto ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) {
        printf("aclrtSetDevice failed, ret=%d\n", ret);
        return ret;
    }

    // 获取设备最大核数
    int64_t availableCoreNum = 0;
    ret = aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum);
    if (ret != ACL_SUCCESS) {
        printf("aclrtGetDeviceInfo failed, ret=%d\n", ret);
        aclrtResetDevice(deviceId);
        return ret;
    }

    // 设置参数（单输入单输出）
    uint32_t totalLength = 4096 * 8;
    size_t inputByteSize = totalLength * sizeof(float);
    size_t outputByteSize = totalLength * sizeof(float);

    // 计算 Tiling 数据（按 DESIGN.md §2.1 和 §2.2）
    AbsTilingData tiling;
    tiling.totalLength = totalLength;
    tiling.dtypeSize = sizeof(float);
    
    uint32_t dim0 = totalLength;  // 总元素数
    
    // Step 1: 计算核数（保证每个核至少处理 4KB 数据）
    uint32_t minDtypeBits = sizeof(float) * 8;  // 32 bits for FP32
    uint32_t coreNum = (dim0 * minDtypeBits + MIN_TILING_BITS_SIZE_PER_CORE - 1) / 
                       MIN_TILING_BITS_SIZE_PER_CORE;
    coreNum = std::min(coreNum, (uint32_t)availableCoreNum);
    
    // Step 2: 每个核的基础元素数，对齐到 512 元素
    uint32_t blockFormer;
    uint32_t blockNum;
    
    if (dim0 < ELEM_ALIGN_FACTOR) {
        // 小 shape 场景处理（dim0 < 512）
        coreNum = 1;
        blockFormer = dim0;
        blockNum = 1;
    } else {
        // 正常多核切分
        blockFormer = ((dim0 + coreNum - 1) / coreNum + ELEM_ALIGN_FACTOR - 1) / 
                       ELEM_ALIGN_FACTOR * ELEM_ALIGN_FACTOR;
        blockNum = (dim0 + blockFormer - 1) / blockFormer;
    }
    
    // Step 3: 计算尾部数据
    uint32_t blockTail = dim0 - (blockNum - 1) * blockFormer;
    
    // Step 4: UB 切分（按 256B 对齐）
    // 获取 UB 容量
    uint32_t ubSize = 192 * 1024;  // Atlas A2/A3 UB = 192KB
    uint32_t bufferDivisor = 4 * sizeof(float);  // Double Buffer 下总 buffer 数 = 4
    uint32_t maxElemNum = ubSize / bufferDivisor;
    uint32_t alignFactor = REPEAT_BYTES / sizeof(float);  // FP32=64元素
    uint32_t ubFormer = (maxElemNum / alignFactor) * alignFactor;
    
    // Step 5: 计算 UB 循环次数和尾部大小（区分首 block 和尾 block）
    uint32_t ubLoopOfFormerBlock = (blockFormer + ubFormer - 1) / ubFormer;
    uint32_t ubTailOfFormerBlock = blockFormer - (ubLoopOfFormerBlock - 1) * ubFormer;
    
    uint32_t ubLoopOfTailBlock = (blockTail + ubFormer - 1) / ubFormer;
    uint32_t ubTailOfTailBlock = blockTail - (ubLoopOfTailBlock - 1) * ubFormer;
    
    // 设置 Tiling 结构体
    tiling.blockNum = blockNum;
    tiling.blockFormer = blockFormer;
    tiling.blockTail = blockTail;
    tiling.ubFormer = ubFormer;
    tiling.ubLoopOfFormerBlock = ubLoopOfFormerBlock;
    tiling.ubTailOfFormerBlock = ubTailOfFormerBlock;
    tiling.ubLoopOfTailBlock = ubLoopOfTailBlock;
    tiling.ubTailOfTailBlock = ubTailOfTailBlock;

    // 单输入单输出
    std::vector<ArgInfo> inputsInfo = {
        {"./input/input_x.bin", inputByteSize}
    };
    std::vector<ArgInfo> outputsInfo = {
        {"./output/output.bin", outputByteSize}
    };

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    KernelCall(blockNum, stream, inputsInfo, outputsInfo, (uint8_t *)&tiling);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
