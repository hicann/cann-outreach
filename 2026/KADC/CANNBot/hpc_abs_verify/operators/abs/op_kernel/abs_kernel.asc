// ============================================================================
// Ascend C Kernel 实现 - Abs 算子（纯 kernel，不含 host 代码）
// ============================================================================

#include "kernel_operator.h"
#include "abs_tiling.h"

// Kernel 类 - 封装 NPU 上的计算逻辑
class KernelAbs {
public:
    __aicore__ inline KernelAbs(AscendC::TPipe* pipe)
    {
        pipe_ = pipe;
    };

    // Init - 根据算子修改参数和 Global Tensor（单输入单输出）
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y,
                                const __gm__ AbsTilingData* tiling)
    {
        this->tiling = tiling;
        this->blockIdx = AscendC::GetBlockIdx();
        this->ubFormer = tiling->ubFormer;
        
        // 判断当前 block 是否是最后一个 block
        bool isLastBlock = (blockIdx == tiling->blockNum - 1);
        
        // 获取当前 block 的处理参数
        uint32_t total;
        if (!isLastBlock) {
            // 非最后一个 block：处理完整 blockFormer 元素
            total = tiling->blockFormer;
            ubLoopNum = tiling->ubLoopOfFormerBlock;
            ubTail = tiling->ubTailOfFormerBlock;
        } else {
            // 最后一个 block：处理尾部数据
            total = tiling->blockTail;
            ubLoopNum = tiling->ubLoopOfTailBlock;
            ubTail = tiling->ubTailOfTailBlock;
        }

        // 设置 Global Tensor（单输入单输出）
        xGm.SetGlobalBuffer((__gm__ float *)x + blockIdx * tiling->blockFormer, total);
        yGm.SetGlobalBuffer((__gm__ float *)y + blockIdx * tiling->blockFormer, total);

        // 初始化 UB Buffer（Double Buffer）
        pipe_->InitBuffer(inQueueX, DOUBLE_BUFFER_NUM, tiling->ubFormer * sizeof(float));
        pipe_->InitBuffer(outQueueY, DOUBLE_BUFFER_NUM, tiling->ubFormer * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        // 计算 GM 偏移（基于 blockIdx）
        int64_t offset = blockIdx * tiling->blockFormer;
        
        // 主循环：处理完整的 UB 块
        for (uint32_t i = 0; i < ubLoopNum - 1; i++) {
            CopyIn(offset, ubFormer);
            Compute(ubFormer);
            CopyOut(offset, ubFormer);
            offset += ubFormer;
        }
        
        // 尾部处理：处理最后一个不完整的 UB 块
        if (ubTail > 0) {
            CopyIn(offset, ubTail);
            Compute(ubTail);
            CopyOut(offset, ubTail);
        }
    }

    __aicore__ inline void CopyIn(int64_t offset, uint32_t count)
    {
        // 从 inQueueX 分配 buffer（Double Buffer 自动轮转 Buffer 0/1）
        AscendC::LocalTensor<float> xLocal = inQueueX.AllocTensor<float>();

        // 使用 DataCopyPad 搬运数据（支持非对齐）
        AscendC::DataCopyPad(xLocal, xGm[offset],
            {1, static_cast<uint16_t>(count * sizeof(float)), 0, 0},
            {false, 0, 0, 0});

        // 入队，标记数据就绪（非阻塞）
        inQueueX.EnQue<float>(xLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        // 从 inQueueX 获取输入数据（阻塞，等待 CopyIn 就绪）
        AscendC::LocalTensor<float> xLocal = inQueueX.DeQue<float>();
        
        // 从 outQueueY 分配输出 buffer（Double Buffer 自动轮转）
        AscendC::LocalTensor<float> yLocal = outQueueY.AllocTensor<float>();

        // 计算绝对值
        AscendC::Abs(yLocal, xLocal, count);

        // 入队输出数据，标记计算完成
        outQueueY.EnQue<float>(yLocal);
        
        // 释放输入 buffer
        inQueueX.FreeTensor(xLocal);
    }

    __aicore__ inline void CopyOut(int64_t offset, uint32_t count)
    {
        // 从 outQueueY 获取输出数据（阻塞，等待 Compute 就绪）
        AscendC::LocalTensor<float> yLocal = outQueueY.DeQue<float>();

        // 使用 DataCopyPad 搬运数据到 GM（支持非对齐）
        AscendC::DataCopyPad(yGm[offset], yLocal,
            {1, static_cast<uint16_t>(count * sizeof(float)), 0, 0});
        
        // 释放输出 buffer
        outQueueY.FreeTensor(yLocal);
    }

private:
    AscendC::TPipe* pipe_;
    const __gm__ AbsTilingData* tiling;

    // Global Tensor（单输入单输出）
    AscendC::GlobalTensor<float> xGm;
    AscendC::GlobalTensor<float> yGm;

    // UB Buffer（输入输出各一个 TQue，各开启 Double Buffer）
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueX;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueY;

    uint32_t blockIdx;      // 当前核索引
    uint32_t ubLoopNum;     // UB 循环次数
    uint32_t ubTail;        // UB 尾部元素数
    uint32_t ubFormer;      // UB 单次处理元素数（从 tiling 获取）
};

// 核函数入口
extern "C" __global__ __vector__ void abs_kernel(GM_ADDR x, GM_ADDR y, GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    KernelAbs op(&pipe);
    op.Init(x, y, (__gm__ AbsTilingData*)tiling);
    op.Process();
}
