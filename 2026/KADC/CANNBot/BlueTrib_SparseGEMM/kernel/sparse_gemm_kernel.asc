// sparse_gemm Kernel 实现
// 参考：asc-devkit/examples/01_simd_cpp_api/02_features/03_basic_api/01_matrix_compute/mmad_with_sparse/
//
// [FIX] 审查报告修复项：
// 1. 使用官方示例的 Cube 算子实现模式
// 2. 入口属性改为 __global__ __cube__（Cube 算子专用）
// 3. 使用 SetFlag/WaitFlag 同步（Cube 算子标准方式）
// 4. 从 Tiling 数据动态获取参数
// 5. 修复多核调度逻辑，每个核处理多个 block

#include "kernel_operator.h"
#include "sparse_gemm_tiling.h"

// Cube 块大小（int8_t 类型）
constexpr uint32_t CUBE_BLOCK = 16;
constexpr uint32_t C0_SIZE = 32;
constexpr uint32_t CUBE_BLOCK_SIZE = 16 * 32;

// 稀疏矩阵乘法 Kernel 类
class KernelSparseGemm {
public:
    __aicore__ inline KernelSparseGemm() {}
    
    __aicore__ inline void Init(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* idx, __gm__ uint8_t* c,
                                const SparseGemmTilingData* tiling, uint32_t batchIdx, uint32_t mBlockIdx, uint32_t nBlockIdx)
    {
        // 从 Tiling 数据获取参数（动态获取，非硬编码）
        this->m = tiling->m;
        this->n = tiling->n;
        this->k = tiling->k;
        this->baseM = tiling->baseM;
        this->baseN = tiling->baseN;
        this->baseK = tiling->baseK;
        this->usedCoreNum = tiling->usedCoreNum;
        this->kSparse = tiling->kSparse;
        this->kIndex = tiling->kIndex;
        this->batch = tiling->batch;
        
        // 计算当前核处理的 M/N 范围
        uint32_t mStart = mBlockIdx * baseM;
        uint32_t nStart = nBlockIdx * baseN;
        uint32_t mLen = (mStart + baseM <= m) ? baseM : (m - mStart);
        uint32_t nLen = (nStart + baseN <= n) ? baseN : (n - nStart);
        
        this->curM = mLen;
        this->curN = nLen;
        this->curK = k;
        
        // 计算数据偏移
        uint32_t aOffset = batchIdx * m * k + mStart * k;
        uint32_t bOffset = batchIdx * n * kSparse + nStart * kSparse;
        uint32_t idxOffset = batchIdx * n * kIndex + nStart * kIndex;
        uint32_t cOffset = batchIdx * m * n + mStart * n + nStart;
        
        aGM.SetGlobalBuffer((__gm__ int8_t*)a + aOffset);
        bGM.SetGlobalBuffer((__gm__ int8_t*)b + bOffset);
        idxGM.SetGlobalBuffer((__gm__ uint8_t*)idx + idxOffset);
        // Fixpipe 输出 int32_t，然后在 host 端转换为 float32
        cGM.SetGlobalBuffer((__gm__ int32_t*)c + cOffset);
        
        // 计算块数
        mBlocks = curM / CUBE_BLOCK;
        nBlocks = curN / CUBE_BLOCK;
        kBlocks = curK / C0_SIZE;
        
        // 计算数据大小
        aSize = curM * curK;
        bSize = curK / 2 * curN;
        cSize = curM * curN;
        idxSize = curK / 8 * curN;
    }
    
    __aicore__ inline void Process()
    {
        // 分配 Local Tensor（使用静态地址，参考官方示例）
        AscendC::LocalTensor<int8_t> a1Local(AscendC::TPosition::A1, a1Addr, aSize);
        AscendC::LocalTensor<int8_t> a2Local(AscendC::TPosition::A2, a2Addr, aSize);
        AscendC::LocalTensor<int8_t> b1Local(AscendC::TPosition::B1, b1Addr, bSize);
        AscendC::LocalTensor<uint8_t> idxB1Local(AscendC::TPosition::B1, idxB1Addr, idxSize);
        AscendC::LocalTensor<int8_t> b2Local(AscendC::TPosition::B2, b2Addr, bSize);
        AscendC::LocalTensor<int32_t> cLocal(AscendC::TPosition::CO1, cAddr, cSize);
        
        // 1. CopyIn - 数据搬运到 L1
        CopyIn(a1Local, b1Local, idxB1Local);
        
        // 2. 等待数据搬运完成（MTE2 -> MTE1）
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
        
        // 3. SplitA - A 矩阵 NZ 转 ZN 格式
        SplitA(a1Local, a2Local);
        
        // 4. SplitB - 使用 LoadDataWithSparse 加载稀疏矩阵 B
        SplitB(b2Local, b1Local, idxB1Local);
        
        // 5. 等待数据准备完成（MTE1 -> M）
        AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
        
        // 6. Compute - 稀疏矩阵乘法
        Compute(cLocal, a2Local, b2Local);
        
        // 7. 等待计算完成（M -> MTE3）
        AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
        
        // 8. CopyOut - 结果输出
        CopyOut(cLocal);
    }

private:
    __aicore__ inline void CopyIn(AscendC::LocalTensor<int8_t> a1Local, 
                                  AscendC::LocalTensor<int8_t> b1Local, 
                                  AscendC::LocalTensor<uint8_t> idxB1Local)
    {
        // 搬运 A 矩阵到 L1 (A1)
        AscendC::DataCopy(a1Local, aGM, {1, static_cast<uint16_t>(aSize * sizeof(int8_t) / 32), 0, 0});
        
        // 搬运 B 矩阵（稀疏格式）到 L1 (B1)
        AscendC::DataCopy(b1Local, bGM, {1, static_cast<uint16_t>(bSize * sizeof(int8_t) / 32), 0, 0});
        
        // 搬运 Index 矩阵到 L1 (B1)
        AscendC::DataCopy(idxB1Local, idxGM, {1, static_cast<uint16_t>(idxSize * sizeof(uint8_t) / 32), 0, 0});
    }
    
    __aicore__ inline void SplitA(AscendC::LocalTensor<int8_t> a1Local, 
                                  AscendC::LocalTensor<int8_t> a2Local)
    {
        // A 矩阵 NZ 转 ZN 格式（L1 A1 -> L0 A2）
        uint32_t dstOffset = kBlocks * CUBE_BLOCK_SIZE;
        uint32_t srcOffset = CUBE_BLOCK_SIZE;
        
        AscendC::LoadData2DParams loadDataParams;
        loadDataParams.repeatTimes = kBlocks;
        loadDataParams.srcStride = mBlocks;
        loadDataParams.dstGap = 0;
        loadDataParams.ifTranspose = false;
        
        for (uint32_t i = 0; i < mBlocks; ++i) {
            AscendC::LoadData(a2Local[i * dstOffset], a1Local[i * srcOffset], loadDataParams);
        }
    }
    
    __aicore__ inline void SplitB(AscendC::LocalTensor<int8_t> b2Local, 
                                  AscendC::LocalTensor<int8_t> b1Local, 
                                  AscendC::LocalTensor<uint8_t> idxB1Local)
    {
        // 使用 LoadDataWithSparse 加载稀疏矩阵（L1 B1 -> L0 B2）
        AscendC::LoadData2DParams loadDataParams;
        loadDataParams.repeatTimes = kBlocks * nBlocks / 2;
        loadDataParams.srcStride = 0;
        loadDataParams.ifTranspose = false;
        AscendC::LoadDataWithSparse(b2Local, b1Local, idxB1Local, loadDataParams);
    }
    
    __aicore__ inline void Compute(AscendC::LocalTensor<int32_t> cLocal, 
                                   AscendC::LocalTensor<int8_t> a2Local, 
                                   AscendC::LocalTensor<int8_t> b2Local)
    {
        // 稀疏矩阵乘法（L0 A2 * L0 B2 -> CO1）
        AscendC::MmadWithSparse(cLocal, a2Local, b2Local, 
                                {static_cast<uint16_t>(curM), static_cast<uint16_t>(curN), static_cast<uint16_t>(curK), 
                                 false, 0, false, false, false});
    }
    
    __aicore__ inline void CopyOut(AscendC::LocalTensor<int32_t> cLocal)
    {
        // 使用 Fixpipe 将结果从 CO1 搬运到 GM
        AscendC::FixpipeParamsV220 fixpipeParams;
        fixpipeParams.nSize = static_cast<uint16_t>(curN);
        fixpipeParams.mSize = static_cast<uint16_t>(curM);
        fixpipeParams.srcStride = static_cast<uint16_t>(curM);
        fixpipeParams.dstStride = static_cast<uint16_t>(n);  // 使用原始 N 维度作为输出步长
        fixpipeParams.ndNum = 1;
        fixpipeParams.srcNdStride = 0;
        fixpipeParams.dstNdStride = 0;
        AscendC::Fixpipe(cGM, cLocal, fixpipeParams);
    }

private:
    // Buffer 地址（静态分配，参考官方示例）
    static constexpr uint32_t a1Addr = 0;
    static constexpr uint32_t a2Addr = 0;  // A1 和 A2 共享同一块 L1
    static constexpr uint32_t b1Addr = 128 * 1024;
    static constexpr uint32_t b2Addr = 0;   // B1 和 B2 共享同一块 L1
    static constexpr uint32_t idxB1Addr = 256 * 1024;
    static constexpr uint32_t cAddr = 0;    // CO1 地址
    
    // 矩阵维度
    uint32_t m, n, k;
    uint32_t baseM, baseN, baseK;
    uint32_t usedCoreNum;
    uint32_t kSparse, kIndex;
    uint32_t batch;
    
    // 当前核处理的维度
    uint32_t curM, curN, curK;
    uint32_t mBlocks, nBlocks, kBlocks;
    
    // 数据大小
    uint32_t aSize, bSize, cSize, idxSize;
    
    // Global Tensor
    AscendC::GlobalTensor<int8_t> aGM, bGM;
    AscendC::GlobalTensor<uint8_t> idxGM;
    AscendC::GlobalTensor<int32_t> cGM;
};

// [FIX] 问题2：入口属性改为 __global__ __cube__（Cube 算子专用）
extern "C" __global__ __cube__ void sparse_gemm_custom(__gm__ uint8_t* a, __gm__ uint8_t* b, 
                                                        __gm__ uint8_t* idx, __gm__ uint8_t* c,
                                                        const SparseGemmTilingData tiling)
{
    uint32_t coreIdx = AscendC::GetBlockIdx();
    uint32_t batch = tiling.batch;
    uint32_t mBlocksTotal = (tiling.m + tiling.baseM - 1) / tiling.baseM;
    uint32_t nBlocksTotal = (tiling.n + tiling.baseN - 1) / tiling.baseN;
    uint32_t totalBlocks = mBlocksTotal * nBlocksTotal;
    
    // 计算每个核需要处理的 block 数量
    uint32_t blocksPerCore = (totalBlocks + tiling.usedCoreNum - 1) / tiling.usedCoreNum;
    
    // 每个核处理多个 batch
    for (uint32_t batchIdx = 0; batchIdx < batch; ++batchIdx) {
        // 每个核处理多个 block
        for (uint32_t i = 0; i < blocksPerCore; i++) {
            uint32_t blockIdx = coreIdx * blocksPerCore + i;
            if (blockIdx >= totalBlocks) break;
            
            // 计算 block 的 M/N 索引（蛇形调度）
            uint32_t mBlockIdx = blockIdx / nBlocksTotal;
            uint32_t nBlockIdx = blockIdx % nBlocksTotal;
            
            // 奇数行反向遍历（蛇形调度）
            if (mBlockIdx % 2 == 1) {
                nBlockIdx = nBlocksTotal - 1 - nBlockIdx;
            }
            
            KernelSparseGemm op;
            op.Init(a, b, idx, c, &tiling, batchIdx, mBlockIdx, nBlockIdx);
            op.Process();
        }
        
        // 在每个 batch 之间同步，确保数据正确写入
        AscendC::PipeBarrier<PIPE_ALL>();
    }
}
