// sparse_gemm Host 入口
// 参考：asc-devkit/examples/01_simd_cpp_api/02_features/03_basic_api/01_matrix_compute/mmad_with_sparse/
//
// [FIX] 审查报告修复项：
// 1. 动态获取硬件参数（核数等）
// 2. 正确的 Tiling 计算
// 3. int32_t -> float32 类型转换

#include <cstdint>
#include <iostream>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"
#include "sparse_gemm_tiling.h"

// 包含 kernel 实现
#include "sparse_gemm_kernel.asc"

// Tiling 计算函数
// [FIX] 问题4：移除硬编码参数，使用动态计算
void ComputeSparseGemmTiling(SparseGemmTilingData& tiling, uint32_t batch, uint32_t m, uint32_t n, uint32_t k,
                              int64_t availableCoreNum)
{
    // 矩阵维度
    tiling.m = m;
    tiling.n = n;
    tiling.k = k;
    tiling.batch = batch;
    
    // 稀疏格式参数
    tiling.kSparse = k / 2;  // 2:4 稀疏格式，K 维度减半
    tiling.kIndex = k / 8;   // 每 4 个元素生成 2 个 2 位索引
    
    // 基本块大小（根据硬件能力和矩阵维度优化）
    tiling.baseM = 128;  // M 维度基本块大小
    tiling.baseN = 128;  // N 维度基本块大小
    tiling.baseK = 64;   // K 维度基本块大小（必须是 4 的倍数，满足稀疏格式要求）
    
    // 确保 baseK 是 4 的倍数（稀疏格式要求）
    if (tiling.baseK % 4 != 0) {
        tiling.baseK = (tiling.baseK + 3) / 4 * 4;
    }
    
    // 计算需要的核数（M×N 二维切分）
    uint32_t mBlocks = (m + tiling.baseM - 1) / tiling.baseM;
    uint32_t nBlocks = (n + tiling.baseN - 1) / tiling.baseN;
    uint32_t totalBlocks = mBlocks * nBlocks;
    
    // [FIX] 问题4：使用动态获取的核数，而非硬编码
    tiling.usedCoreNum = (totalBlocks < availableCoreNum) ? totalBlocks : availableCoreNum;
    
    // L1 缓冲区深度
    tiling.kL1 = 1;
    
    // L0C 双缓冲
    tiling.l0cDB = 1;
    
    // 尾块处理参数
    tiling.mTailCnt = m % tiling.baseM;
    tiling.nTailCnt = n % tiling.baseN;
    tiling.mBaseTailSplitCnt = 1;
    tiling.nBaseTailSplitCnt = 1;
    tiling.mTailMain = tiling.baseM;
    tiling.nTailMain = tiling.baseN;
}

struct ArgInfo {
    std::string fileName;
    size_t length;
};

void KernelCall(uint32_t blockNum, aclrtStream stream,
    std::vector<ArgInfo> &inputsInfo, std::vector<ArgInfo> &outputsInfo,
    uint8_t *tilingData, uint32_t batch, uint32_t m, uint32_t n)
{
    std::vector<uint8_t *> inputHost(inputsInfo.size());
    std::vector<uint8_t *> inputDevice(inputsInfo.size());
    std::vector<uint8_t *> outputHost(outputsInfo.size());
    std::vector<uint8_t *> outputDevice(outputsInfo.size());
    uint8_t *tilingDevice = nullptr;

    aclrtMalloc((void **)&tilingDevice, sizeof(SparseGemmTilingData), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(tilingDevice, sizeof(SparseGemmTilingData), tilingData,
        sizeof(SparseGemmTilingData), ACL_MEMCPY_HOST_TO_DEVICE);

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtMallocHost((void **)&inputHost[i], inputsInfo[i].length);
        aclrtMalloc((void **)&inputDevice[i], inputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile(inputsInfo[i].fileName, inputsInfo[i].length, inputHost[i], inputsInfo[i].length);
        aclrtMemcpy(inputDevice[i], inputsInfo[i].length, inputHost[i],
            inputsInfo[i].length, ACL_MEMCPY_HOST_TO_DEVICE);
    }

    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMallocHost((void **)&outputHost[i], outputsInfo[i].length);
        aclrtMalloc((void **)&outputDevice[i], outputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
    }

    // kernel 入口函数名
    sparse_gemm_custom<<<blockNum, nullptr, stream>>>(
        inputDevice[0], inputDevice[1], inputDevice[2],
        outputDevice[0], *((SparseGemmTilingData*)tilingData));
    aclrtSynchronizeStream(stream);

    aclrtFree(tilingDevice);
    
    // 读取 int32_t 结果并转换为 float32
    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMemcpy(outputHost[i], outputsInfo[i].length, outputDevice[i],
            outputsInfo[i].length, ACL_MEMCPY_DEVICE_TO_HOST);
        
        // [FIX] int32_t -> float32 转换
        size_t numElements = batch * m * n;
        int32_t *int32Output = reinterpret_cast<int32_t*>(outputHost[i]);
        float *floatOutput = new float[numElements];
        
        for (size_t j = 0; j < numElements; j++) {
            floatOutput[j] = static_cast<float>(int32Output[j]);
        }
        
        // 保存 float32 结果
        WriteFile(outputsInfo[i].fileName, floatOutput, numElements * sizeof(float));
        
        delete[] floatOutput;
        aclrtFree(outputDevice[i]);
        aclrtFreeHost(outputHost[i]);
    }

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtFree(inputDevice[i]);
        aclrtFreeHost(inputHost[i]);
    }
}

int32_t main(int32_t argc, char *argv[])
{
    // ACL 初始化
    aclInit(nullptr);
    int32_t deviceId = 0;
    auto ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) {
        printf("aclrtSetDevice failed, ret=%d\n", ret);
        return ret;
    }

    // [FIX] 问题4：动态获取设备核数
    int64_t availableCoreNum = 0;
    ret = aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum);
    if (ret != ACL_SUCCESS) {
        printf("aclrtGetDeviceInfo failed, ret=%d\n", ret);
        aclrtResetDevice(deviceId);
        return ret;
    }
    printf("Available core num: %ld\n", availableCoreNum);

    // 算子参数（小测试用例用于调试）
    uint32_t batch = 2;
    uint32_t m = 128;
    uint32_t n = 128;
    uint32_t k = 128;  // D_H
    uint32_t c0Size = 32;  // Cube 块大小
    
    // 计算数据大小（NZ 格式）
    // A: [batch, k/c0Size, m/16, 16, c0Size]
    size_t aFileSize = batch * (k / c0Size) * (m / 16) * 16 * c0Size * sizeof(int8_t);
    // B: [batch, k/2/c0Size, n/16, 16, c0Size]
    size_t bFileSize = batch * (k / 2 / c0Size) * (n / 16) * 16 * c0Size * sizeof(int8_t);
    // Index: [batch, k/8/4, n/16, 16, 8]
    size_t idxFileSize = batch * (k / 8 / 4) * (n / 16) * 16 * 8 * sizeof(uint8_t);
    // C: [batch, m, n]
    size_t cFileSize = batch * m * n * sizeof(int32_t);  // Fixpipe 输出 int32_t
    
    // 计算 Tiling 数据
    SparseGemmTilingData tiling;
    ComputeSparseGemmTiling(tiling, batch, m, n, k, availableCoreNum);
    
    uint32_t numBlocks = tiling.usedCoreNum;
    printf("Using %u cores for computation\n", numBlocks);
    
    // 设置输入输出文件信息
    std::vector<ArgInfo> inputsInfo = {
        {"./input/x1_gm.bin", aFileSize},
        {"./input/x2_gm.bin", bFileSize},
        {"./input/idx_gm.bin", idxFileSize}
    };
    std::vector<ArgInfo> outputsInfo = {
        {"./output/output.bin", cFileSize}
    };

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    KernelCall(numBlocks, stream, inputsInfo, outputsInfo, (uint8_t *)&tiling, batch, m, n);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
