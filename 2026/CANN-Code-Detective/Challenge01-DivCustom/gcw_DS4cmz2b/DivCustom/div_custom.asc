// div_custom.asc

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

using namespace AscendC;

constexpr uint32_t BUFFER_NUM = 2; // tensor num for each queue

struct DivCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelDiv {
public:
    __aicore__ inline KernelDiv(){}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {
        // 记录总长度、tile 数量，并计算每个 tile 需要处理的元素个数
        this->totalLength = totalLength;
        this->tileNum = tileNum;
        this->tileLength = totalLength / tileNum;

        // 为输入 x / y 和输出 z 分别设置 GlobalTensor 的 GM 基地址
        xGm.SetGlobalBuffer((__gm__ float*)x);
        yGm.SetGlobalBuffer((__gm__ float*)y);
        zGm.SetGlobalBuffer((__gm__ float*)z);

        // 为输入/输出 Queue 分配 Unified Buffer，每个 Queue 维护 BUFFER_NUM 个 tensor
        pipe.InitBuffer(inQueueX, BUFFER_NUM, tileLength * sizeof(float));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, tileLength * sizeof(float));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, tileLength * sizeof(float));
    }
    __aicore__ inline void Process()
    {
        // 按 tile 迭代执行 CopyIn -> Compute -> CopyOut 三级流水
        for (int32_t i = 0; i < tileNum; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        // 在 UB 上分配输入 tensor 空间
        LocalTensor<float> xLocal = inQueueX.AllocTensor<float>();
        LocalTensor<float> yLocal = inQueueY.AllocTensor<float>();
        // 将 GM 数据搬入 UB
        DataCopy(xLocal, xGm[progress * tileLength], tileLength);
        DataCopy(yLocal, yGm[progress * tileLength], tileLength);
        // 入队，标记数据已就绪可供 Compute 消费
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }
    __aicore__ inline void Compute(int32_t progress)
    {
        // 出队，获取已就绪的输入数据
        LocalTensor<float> xLocal = inQueueX.DeQue<float>();
        LocalTensor<float> yLocal = inQueueY.DeQue<float>();
        // 分配输出 tensor 空间
        LocalTensor<float> zLocal = outQueueZ.AllocTensor<float>();
        // 执行逐元素除法 z = x / y
        Div(zLocal, xLocal, yLocal, tileLength);
        // 入队，标记计算结果已就绪可供 CopyOut 消费
        outQueueZ.EnQue<float>(zLocal);
        // 释放输入 tensor 空间
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }
    __aicore__ inline void CopyOut(int32_t progress)
    {
        // 出队，获取已计算完成的输出数据
        LocalTensor<float> zLocal = outQueueZ.DeQue<float>();
        // 将结果从 UB 搬回 GM
        DataCopy(zGm[progress * tileLength], zLocal, tileLength);
        // 释放输出 tensor 空间
        outQueueZ.FreeTensor(zLocal);
    }

private:
    TPipe pipe;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueX, inQueueY;
    TQue<TPosition::VECOUT, BUFFER_NUM> outQueueZ;
    GlobalTensor<float> xGm, yGm, zGm;
    uint32_t totalLength;
    uint32_t tileNum;
    uint32_t tileLength;
};

__global__ __aicore__ void div_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, DivCustomTilingData tiling)
{
    // 实例化 KernelDiv，传入 GM 地址与 tiling 参数，执行 Init + Process
    KernelDiv op;
    op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    op.Process();
}

std::vector<float> kernel_div(std::vector<float> &x, std::vector<float> &y)
{
    // 配置 tiling：单核处理，按 8 个 tile 切分
    uint32_t totalLength = x.size();
    uint32_t tileNum = 8;
    DivCustomTilingData tiling;
    tiling.totalLength = totalLength;
    tiling.tileNum = tileNum;

    size_t byteSize = totalLength * sizeof(float);

    // 在 GM 上申请 x、y、z 的设备内存
    void *devX = nullptr;
    void *devY = nullptr;
    void *devZ = nullptr;
    aclrtMalloc(&devX, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&devY, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&devZ, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    // 将 host 数据搬运到 device
    aclrtMemcpy(devX, byteSize, x.data(), byteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(devY, byteSize, y.data(), byteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    // 创建 stream 并启动 kernel（1 个 block，单核执行）
    aclrtStream stream;
    aclrtCreateStream(&stream);
    div_custom<<<1, nullptr, stream>>>((__gm__ uint8_t*)devX, (__gm__ uint8_t*)devY,
                                       (__gm__ uint8_t*)devZ, tiling);

    // 等待 kernel 执行完成
    aclrtSynchronizeStream(stream);

    // 将计算结果搬回 host
    std::vector<float> output(totalLength);
    aclrtMemcpy(output.data(), byteSize, devZ, byteSize, ACL_MEMCPY_DEVICE_TO_HOST);

    // 释放 stream 与 GM 内存
    aclrtDestroyStream(stream);
    aclrtFree(devX);
    aclrtFree(devY);
    aclrtFree(devZ);

    return output;
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    // 初始化 ACL 运行时环境并设置设备
    aclInit(nullptr);
    aclrtSetDevice(0);

    // 执行 kernel 计算并取回结果
    std::vector<float> output = kernel_div(x, y);

    // 释放 ACL 资源
    aclrtResetDevice(0);
    aclFinalize();

    std::vector<float> golden(totalLength, valueX / valueY);
    return VerifyResult(output, golden);
}
