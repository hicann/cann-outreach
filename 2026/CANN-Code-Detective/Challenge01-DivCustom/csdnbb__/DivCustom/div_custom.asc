// div_custom.asc

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

constexpr uint32_t BUFFER_NUM = 2; // Double buffering for every UB queue.
constexpr uint32_t TILE_NUM = 8;
constexpr uint32_t EXPECTED_TOTAL_LENGTH = 8 * 2048;

struct DivCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelDiv {
public:
    __aicore__ inline KernelDiv() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {
        const uint32_t blockNum = AscendC::GetBlockNum();
        ascendc_assert(blockNum != 0 && "block dim cannot be zero");
        ascendc_assert(totalLength % blockNum == 0 && "total length must be divisible by block dim");

        blockLength = totalLength / blockNum;
        this->tileNum = tileNum;
        ascendc_assert(this->tileNum != 0 && "tile num cannot be zero");
        ascendc_assert(blockLength % (this->tileNum * BUFFER_NUM) == 0 &&
            "block length must be divisible by the buffered tile count");

        tileLength = blockLength / this->tileNum / BUFFER_NUM;
        ascendc_assert(tileLength != 0 && "tile length cannot be zero");

        const uint32_t gmOffset = blockLength * AscendC::GetBlockIdx();
        xGm.SetGlobalBuffer((__gm__ float *)x + gmOffset, blockLength);
        yGm.SetGlobalBuffer((__gm__ float *)y + gmOffset, blockLength);
        zGm.SetGlobalBuffer((__gm__ float *)z + gmOffset, blockLength);

        pipe.InitBuffer(inQueueX, BUFFER_NUM, tileLength * sizeof(float));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, tileLength * sizeof(float));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, tileLength * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        const int32_t loopCount = tileNum * BUFFER_NUM;
        for (int32_t i = 0; i < loopCount; ++i) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        AscendC::LocalTensor<float> xLocal = inQueueX.AllocTensor<float>();
        AscendC::LocalTensor<float> yLocal = inQueueY.AllocTensor<float>();

        const uint32_t offset = progress * tileLength;
        AscendC::DataCopy(xLocal, xGm[offset], tileLength);
        AscendC::DataCopy(yLocal, yGm[offset], tileLength);

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(int32_t progress)
    {
        (void)progress;
        AscendC::LocalTensor<float> xLocal = inQueueX.DeQue<float>();
        AscendC::LocalTensor<float> yLocal = inQueueY.DeQue<float>();
        AscendC::LocalTensor<float> zLocal = outQueueZ.AllocTensor<float>();

        AscendC::Div(zLocal, xLocal, yLocal, tileLength);

        outQueueZ.EnQue(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int32_t progress)
    {
        AscendC::LocalTensor<float> zLocal = outQueueZ.DeQue<float>();
        AscendC::DataCopy(zGm[progress * tileLength], zLocal, tileLength);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inQueueX;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_NUM> outQueueZ;
    AscendC::GlobalTensor<float> xGm;
    AscendC::GlobalTensor<float> yGm;
    AscendC::GlobalTensor<float> zGm;
    uint32_t blockLength = 0;
    uint32_t tileNum = 0;
    uint32_t tileLength = 0;
};

__global__ __aicore__ void div_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, DivCustomTilingData tiling)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    KernelDiv op;
    op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    op.Process();
}

bool CheckAcl(aclError result, const char *operation)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    std::cerr << operation << " failed, ACL error code: " << result << std::endl;
    return false;
}

std::vector<float> kernel_div(std::vector<float> &x, std::vector<float> &y)
{
    constexpr uint32_t blockDim = 8;
    if (x.size() != y.size() || x.size() != EXPECTED_TOTAL_LENGTH) {
        std::cerr << "DivCustom expects two float32 tensors of length "
                  << EXPECTED_TOTAL_LENGTH << "." << std::endl;
        return {};
    }

    const uint32_t totalLength = static_cast<uint32_t>(x.size());
    const size_t totalByteSize = static_cast<size_t>(totalLength) * sizeof(float);
    constexpr int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    DivCustomTilingData tiling = {totalLength, TILE_NUM};

    uint8_t *xHost = reinterpret_cast<uint8_t *>(x.data());
    uint8_t *yHost = reinterpret_cast<uint8_t *>(y.data());
    uint8_t *zHost = nullptr;
    uint8_t *xDevice = nullptr;
    uint8_t *yDevice = nullptr;
    uint8_t *zDevice = nullptr;
    bool aclInitialized = false;
    bool deviceSet = false;

    auto cleanup = [&]() {
        if (xDevice != nullptr) {
            aclrtFree(xDevice);
        }
        if (yDevice != nullptr) {
            aclrtFree(yDevice);
        }
        if (zDevice != nullptr) {
            aclrtFree(zDevice);
        }
        if (zHost != nullptr) {
            aclrtFreeHost(zHost);
        }
        if (stream != nullptr) {
            aclrtDestroyStream(stream);
        }
        if (deviceSet) {
            aclrtResetDevice(deviceId);
        }
        if (aclInitialized) {
            aclFinalize();
        }
    };

    // Initialize ACL and allocate runtime resources.
    if (!CheckAcl(aclInit(nullptr), "aclInit")) {
        return {};
    }
    aclInitialized = true;
    if (!CheckAcl(aclrtSetDevice(deviceId), "aclrtSetDevice")) {
        cleanup();
        return {};
    }
    deviceSet = true;
    if (!CheckAcl(aclrtCreateStream(&stream), "aclrtCreateStream") ||
        !CheckAcl(aclrtMallocHost(reinterpret_cast<void **>(&zHost), totalByteSize), "aclrtMallocHost") ||
        !CheckAcl(aclrtMalloc(reinterpret_cast<void **>(&xDevice), totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(x)") ||
        !CheckAcl(aclrtMalloc(reinterpret_cast<void **>(&yDevice), totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(y)") ||
        !CheckAcl(aclrtMalloc(reinterpret_cast<void **>(&zDevice), totalByteSize, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(z)")) {
        cleanup();
        return {};
    }

    // Copy the inputs to GM, run the kernel, and copy the result back.
    if (!CheckAcl(aclrtMemcpy(xDevice, totalByteSize, xHost, totalByteSize, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(x H2D)") ||
        !CheckAcl(aclrtMemcpy(yDevice, totalByteSize, yHost, totalByteSize, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(y H2D)")) {
        cleanup();
        return {};
    }

    div_custom<<<blockDim, nullptr, stream>>>(xDevice, yDevice, zDevice, tiling);
    if (!CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream")) {
        cleanup();
        return {};
    }

    if (!CheckAcl(aclrtMemcpy(zHost, totalByteSize, zDevice, totalByteSize, ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy(z D2H)")) {
        cleanup();
        return {};
    }
    float *zData = reinterpret_cast<float *>(zHost);
    std::vector<float> z(zData, zData + totalLength);

    // Release all host and device resources.
    cleanup();

    return z;
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (output.size() != golden.size()) {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = EXPECTED_TOTAL_LENGTH;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    std::vector<float> output = kernel_div(x, y);
    std::vector<float> golden(totalLength, valueX / valueY);
    return VerifyResult(output, golden);
}
