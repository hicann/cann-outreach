// div_custom.asc
// 逐元素除法算子 DivCustom：z = x / y
// 数据通路：GM(x,y) --CopyIn--> UB(xLocal,yLocal) --Compute(Div)--> UB(zLocal) --CopyOut--> GM(z)
// 采用 Double Buffer（BUFFER_NUM = 2）实现 CopyIn 与 Compute 的流水线重叠

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

using namespace AscendC; // AscendC 算子相关类型（LocalTensor/GlobalTensor/TPipe/TQue 等）均位于该命名空间

constexpr uint32_t BUFFER_NUM = 2;     // 每个队列中的 buffer 数量（Double Buffer）
constexpr uint32_t TILE_LENGTH = 2048; // 单个基础 tile 的元素数：与 UB 容量匹配且为 8 的倍数（满足 Div 对齐）

// Tiling 参数：在 host 侧计算并传给核函数
struct DivCustomTilingData
{
    uint32_t totalLength; // 张量总长度
    uint32_t tileNum;     // tile 数量（向上取整，保证尾部不被丢弃）
    uint32_t tileLength;  // 每个基础 tile 的元素个数（最后一个 tile 可能更短）
};

// ACL 调用错误检查：失败时打印错误码并跳转到 cleanup 统一释放已分配资源，避免资源泄漏
#define ACL_CHECK(call)                                                            \
    do {                                                                           \
        aclError _acl_ret = (call);                                                \
        if (_acl_ret != ACL_SUCCESS) {                                             \
            std::cerr << "[ACL_ERROR] " #call " failed, code=" << _acl_ret         \
                      << " (" << __FILE__ << ":" << __LINE__ << ")" << std::endl;  \
            result.clear();                                                        \
            goto cleanup;                                                          \
        }                                                                          \
    } while (0)

class KernelDiv {
public:
    __aicore__ inline KernelDiv() {}

    // 初始化：绑定 GM 张量，并为每个 UB 队列分配缓冲区
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                uint32_t totalLength, uint32_t tileNum, uint32_t tileLength)
    {
        // 保存分块参数
        this->totalLength = totalLength;
        this->tileNum = tileNum;
        this->tileLength = tileLength;

        // 将设备侧指针绑定到 GM 张量对象（长度以 totalLength 为容量上界）
        xGm.SetGlobalBuffer((__gm__ float *)x, totalLength);
        yGm.SetGlobalBuffer((__gm__ float *)y, totalLength);
        zGm.SetGlobalBuffer((__gm__ float *)z, totalLength);

        // 在 Unified Buffer 上为输入/输出队列分配 BUFFER_NUM 份“最大 tile 长度”的 buffer。
        // 最后一个 tile 可能更短，但缓冲区足以容纳；Double Buffer 让 MTE 搬运与 Vector 计算重叠。
        pipe.InitBuffer(inQueueX, BUFFER_NUM, tileLength * sizeof(float));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, tileLength * sizeof(float));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, tileLength * sizeof(float));
    }

    // 主处理：利用 Double Buffer 让 CopyIn 与 Compute 流水线重叠
    __aicore__ inline void Process()
    {
        if (tileNum == 0) {
            return;
        }
        // 先发出第 0 块搬运，随后在循环中“先预取下一块、再计算当前块”，
        // 使下一块的 GM->UB 搬运（MTE）与当前块的向量计算（Vector）重叠执行。
        CopyIn(0);
        for (int32_t i = 0; i < (int32_t)tileNum - 1; i++) {
            CopyIn(i + 1); // 预取下一块（重叠）
            Compute(i);
            CopyOut(i);
        }
        Compute(tileNum - 1);
        CopyOut(tileNum - 1);
    }

private:
    // 计算第 progress 个 tile 实际处理的元素数；最后一个 tile 取剩余元素，避免静默丢弃尾部
    __aicore__ inline uint32_t CalcTileLength(int32_t progress) const
    {
        if (progress == (int32_t)tileNum - 1) {
            return totalLength - progress * tileLength;
        }
        return tileLength;
    }

    // 搬运输入：从 GM 拷贝当前 tile 的 x、y 到 UB，并入队
    __aicore__ inline void CopyIn(int32_t progress)
    {
        uint32_t cur = CalcTileLength(progress);
        LocalTensor<float> xLocal = inQueueX.AllocTensor<float>();
        LocalTensor<float> yLocal = inQueueY.AllocTensor<float>();

        // 从 GM 的 [progress * tileLength, progress * tileLength + cur) 区间拷贝数据到 UB
        DataCopy(xLocal, xGm[progress * tileLength], cur);
        DataCopy(yLocal, yGm[progress * tileLength], cur);

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    // 计算：出队 x、y，执行逐元素除法 z = x / y，结果入队
    __aicore__ inline void Compute(int32_t progress)
    {
        uint32_t cur = CalcTileLength(progress);
        LocalTensor<float> xLocal = inQueueX.DeQue<float>();
        LocalTensor<float> yLocal = inQueueY.DeQue<float>();
        LocalTensor<float> zLocal = outQueueZ.AllocTensor<float>();

        // 逐元素除法：zLocal = xLocal / yLocal
        // Div 对 float 要求 count 为 8 的倍数，不足时向上对齐计算，但只回拷有效部分（cur）
        uint32_t calcCount = (cur + 7) / 8 * 8;
        Div(zLocal, xLocal, yLocal, calcCount);

        outQueueZ.EnQue(zLocal);

        // 释放输入队列中已用完的 tensor（Double Buffer 另一份由后续 CopyIn 复用）
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    // 搬出结果：出队结果，从 UB 拷回 GM
    __aicore__ inline void CopyOut(int32_t progress)
    {
        uint32_t cur = CalcTileLength(progress);
        LocalTensor<float> zLocal = outQueueZ.DeQue<float>();

        // 从 UB 拷回 GM 对应区间（只搬有效部分）
        DataCopy(zGm[progress * tileLength], zLocal, cur);

        outQueueZ.FreeTensor(zLocal);
    }

private:
    // 队列、管道与 GM 张量，以及分块参数
    TPipe pipe;                                              // 管理 UB 内存的管道
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueX, inQueueY; // 输入队列（Vector 入）
    TQue<QuePosition::VECOUT, BUFFER_NUM> outQueueZ;        // 输出队列（Vector 出）
    GlobalTensor<float> xGm, yGm, zGm;                      // GM 上的输入/输出张量
    uint32_t totalLength;                                   // 张量总长度
    uint32_t tileNum;                                       // tile 数量
    uint32_t tileLength;                                    // 单个基础 tile 的元素个数
};

// 核函数入口：实例化 KernelDiv 并完成初始化与主流程
extern "C" __global__ __aicore__ void div_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, DivCustomTilingData tiling)
{
    KernelDiv op;
    op.Init(x, y, z, tiling.totalLength, tiling.tileNum, tiling.tileLength);
    op.Process();
}

// Host 侧：分配 GM 内存、搬运数据、启动核函数、回拷结果并返回
std::vector<float> kernel_div(std::vector<float> &x, std::vector<float> &y)
{
    uint32_t totalLength = x.size();
    // Tiling：以固定 TILE_LENGTH 为基准“向上取整”分块，保证任意长度输入都不会静默丢弃尾部元素
    uint32_t tileLength = TILE_LENGTH;
    uint32_t tileNum = (totalLength + tileLength - 1) / tileLength; // 向上取整
    DivCustomTilingData tiling{totalLength, tileNum, tileLength};
    uint32_t size = totalLength * sizeof(float);

    aclrtStream stream = nullptr;
    void *xDevice = nullptr, *yDevice = nullptr, *zDevice = nullptr;
    std::vector<float> result; // 失败时清空返回，成功时填充结果

    // 初始化 AscendCL 运行环境（全程带错误检查）
    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(0));
    ACL_CHECK(aclrtCreateStream(&stream));

    // 在 Device 上申请 GM 内存
    ACL_CHECK(aclrtMalloc(&xDevice, size, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(&yDevice, size, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(&zDevice, size, ACL_MEM_MALLOC_HUGE_FIRST));

    // 将输入数据从 Host 拷贝到 Device
    ACL_CHECK(aclrtMemcpy(xDevice, size, x.data(), size, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMemcpy(yDevice, size, y.data(), size, ACL_MEMCPY_HOST_TO_DEVICE));

    // 启动核函数：单核执行（blockDim = 1），l2ctrl 固定为 nullptr
    // 设备指针需转换为 GM_ADDR（即 __gm__ uint8_t*）后传入核函数
    div_custom<<<1, nullptr, stream>>>((GM_ADDR)xDevice, (GM_ADDR)yDevice, (GM_ADDR)zDevice, tiling);
    ACL_CHECK(aclrtSynchronizeStream(stream));

    // 将计算结果从 Device 拷回 Host
    result.assign(totalLength, 0.0f);
    ACL_CHECK(aclrtMemcpy(result.data(), size, zDevice, size, ACL_MEMCPY_DEVICE_TO_HOST));

    // 释放资源（成功路径也走 cleanup，保证释放逻辑唯一）
cleanup:
    if (zDevice != nullptr) {
        aclrtFree(zDevice);
    }
    if (yDevice != nullptr) {
        aclrtFree(yDevice);
    }
    if (xDevice != nullptr) {
        aclrtFree(xDevice);
    }
    if (stream != nullptr) {
        aclrtDestroyStream(stream);
    }
    aclrtResetDevice(0);
    aclFinalize();

    return result;
}

// 验证输出与期望结果是否一致
uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (output.size() != golden.size() ||
        !std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
    std::cout << "[Success] Case accuracy is verification passed." << std::endl;
    return 0;
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    // 调用 kernel_div 在 NPU 上完成逐元素除法
    std::vector<float> output = kernel_div(x, y);

    std::vector<float> golden(totalLength, valueX / valueY);
    return VerifyResult(output, golden);
}
