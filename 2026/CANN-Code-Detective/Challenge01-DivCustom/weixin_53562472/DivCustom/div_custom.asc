// div_custom.asc
//
// 逐元素除法算子(Element-wise Division):z[i] = x[i] / y[i]
// 完整覆盖 AscendC 算子开发核心流程:Tiling 切分 -> 数据搬运(CopyIn)-> 计算(Compute)-> 结果搬出(CopyOut)
//
// 编程范式:
//   GM (x, y) --CopyIn--> UB (xLocal, yLocal) --Compute--> UB (zLocal) --CopyOut--> GM (z)
//
// 关键设计:
//   - 8 个 AI Core 并行:blockDim = 8,每个核处理 blockLength = totalLength / 8 = 2048 个元素
//   - 核内再切 tile:tileNum = 8,配合队列深度 BUFFER_NUM = 2(Double Buffer)
//     每次循环搬运/计算 tileLength = blockLength / tileNum / BUFFER_NUM = 128 个元素
//   - 队列深度为 2 时,相邻两轮迭代的搬运与计算可流水重叠,隐藏数据搬运时延

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

constexpr uint32_t BUFFER_NUM = 2; // tensor num for each queue

struct DivCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelDiv {
public:
    __aicore__ inline KernelDiv(){}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum)
    {
        // 1. 均分数据到每个 AI Core:本核负责的元素数 = 总长度 / 核数
        this->blockLength = totalLength / AscendC::GetBlockNum();
        this->tileNum = tileNum;
        // 2. 核内再按 tile 切分,每个 tile 再均分给 BUFFER_NUM 级流水(Double Buffer)
        this->tileLength = this->blockLength / tileNum / BUFFER_NUM;

        // 3. 绑定 GlobalTensor:按当前核号 GetBlockIdx() 偏移到本核负责的数据段
        xGm.SetGlobalBuffer((__gm__ float *)x + this->blockLength * AscendC::GetBlockIdx(), this->blockLength);
        yGm.SetGlobalBuffer((__gm__ float *)y + this->blockLength * AscendC::GetBlockIdx(), this->blockLength);
        zGm.SetGlobalBuffer((__gm__ float *)z + this->blockLength * AscendC::GetBlockIdx(), this->blockLength);

        // 4. 通过 TPipe 在 UB 上为队列分配缓冲,队列深度 = BUFFER_NUM(Double Buffer)
        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(float));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(float));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(float));
    }
    __aicore__ inline void Process()
    {
        // 主处理循环:共 tileNum * BUFFER_NUM 个分片,逐片执行 CopyIn -> Compute -> CopyOut
        const int32_t loopCount = this->tileNum * BUFFER_NUM;
        for (int32_t i = 0; i < loopCount; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        // 从输入队列分配 UB 上的 LocalTensor
        AscendC::LocalTensor<float> xLocal = inQueueX.AllocTensor<float>();
        AscendC::LocalTensor<float> yLocal = inQueueY.AllocTensor<float>();
        // 将本进度对应的 GM 分片搬入 UB
        AscendC::DataCopy(xLocal, xGm[progress * this->tileLength], this->tileLength);
        AscendC::DataCopy(yLocal, yGm[progress * this->tileLength], this->tileLength);
        // 入队,通知 Compute 阶段输入数据已就绪
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }
    __aicore__ inline void Compute(int32_t progress)
    {
        // 出队,取得已搬运完成的输入张量
        AscendC::LocalTensor<float> xLocal = inQueueX.DeQue<float>();
        AscendC::LocalTensor<float> yLocal = inQueueY.DeQue<float>();
        // 分配输出张量,执行逐元素除法 z = x / y
        AscendC::LocalTensor<float> zLocal = outQueueZ.AllocTensor<float>();
        AscendC::Div(zLocal, xLocal, yLocal, this->tileLength);
        // 结果入队;输入张量用毕,释放回队列供后续复用
        outQueueZ.EnQue<float>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }
    __aicore__ inline void CopyOut(int32_t progress)
    {
        // 出队取得计算结果
        AscendC::LocalTensor<float> zLocal = outQueueZ.DeQue<float>();
        // 将结果从 UB 搬回 GM 中本进度对应的分片
        AscendC::DataCopy(zGm[progress * this->tileLength], zLocal, this->tileLength);
        // 释放输出张量,供下一轮迭代复用
        outQueueZ.FreeTensor(zLocal);
    }

private:
    // TPipe 统一管理 UB 内存;TQue 为输入/输出队列(Double Buffer);GlobalTensor 为 GM 数据视图
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inQueueX, inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_NUM> outQueueZ;
    AscendC::GlobalTensor<float> xGm, yGm, zGm;
    uint32_t blockLength; // 每个核处理的元素总数
    uint32_t tileNum;     // 核内 tile 数
    uint32_t tileLength;  // 每次循环处理的元素数
};

__global__ __aicore__ void div_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, DivCustomTilingData tiling)
{
    // 实例化算子对象,完成初始化后进入主处理流程
    KernelDiv op;
    op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    op.Process();
}

std::vector<float> kernel_div(std::vector<float> &x, std::vector<float> &y)
{
    const uint32_t totalLength = static_cast<uint32_t>(x.size());
    // 并行与切分参数:8 核并行,每核再切 8 个 tile
    constexpr uint32_t blockDim = 8;
    constexpr uint32_t tileNum = 8;

    // 1. 初始化 ACL 运行环境,选定 0 号设备并创建 Stream
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    // 2. 申请 GM 设备内存,并将输入数据从 Host 拷贝到 Device
    uint8_t *xDevice = nullptr;
    uint8_t *yDevice = nullptr;
    uint8_t *zDevice = nullptr;
    const uint32_t dataSize = totalLength * sizeof(float);
    aclrtMalloc((void **)&xDevice, dataSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&yDevice, dataSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&zDevice, dataSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(xDevice, dataSize, x.data(), dataSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(yDevice, dataSize, y.data(), dataSize, ACL_MEMCPY_HOST_TO_DEVICE);

    // 3. 组装 Tiling 参数,以 blockDim 个核启动 kernel,并同步等待执行完成
    DivCustomTilingData tiling = {totalLength, tileNum};
    div_custom<<<blockDim, nullptr, stream>>>(xDevice, yDevice, zDevice, tiling);
    aclrtSynchronizeStream(stream);

    // 4. 将结果从 Device 拷回 Host,释放设备内存与运行环境
    std::vector<float> z(totalLength);
    aclrtMemcpy(z.data(), dataSize, zDevice, dataSize, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFree(zDevice);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return z;
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
    return 0;
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    // 调用 host 函数完成:申请 GM 内存 -> 搬运输入 -> 启动 kernel -> 回拷结果
    std::vector<float> output = kernel_div(x, y);

    std::vector<float> golden(totalLength, valueX / valueY);
    return VerifyResult(output, golden);
}
