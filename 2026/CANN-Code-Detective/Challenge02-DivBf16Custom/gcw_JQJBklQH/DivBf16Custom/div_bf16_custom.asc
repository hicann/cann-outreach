// div_bf16_custom.asc

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include <cstring>
#include <cmath>
#include "acl/acl.h"
#include "kernel_operator.h"

class KernelDivBf16 {
public:
    __aicore__ inline KernelDivBf16() {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength)
    {
        this->totalLength = totalLength;
        xGm.SetGlobalBuffer((__gm__ bfloat16_t *)x, totalLength);
        yGm.SetGlobalBuffer((__gm__ bfloat16_t *)y, totalLength);
        zGm.SetGlobalBuffer((__gm__ bfloat16_t *)z, totalLength);

        // 初始化输入输出队列
        // 本题无需 Tiling，直接使用整个 totalLength 一次性计算
        pipe.InitBuffer(inQueueX, 1, totalLength * sizeof(bfloat16_t));
        pipe.InitBuffer(inQueueY, 1, totalLength * sizeof(bfloat16_t));
        pipe.InitBuffer(outQueueZ, 1, totalLength * sizeof(bfloat16_t));

        // 初始化两个 TBuf 作为类型转换的临时内存（VECCALC 位置），
        // TBuf 只参与计算，通过 Get<float>() 获取，无需 EnQue/DeQue 和 FreeTensor
        pipe.InitBuffer(tmpBuf0, totalLength * sizeof(float));
        pipe.InitBuffer(tmpBuf1, totalLength * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        CopyIn();
        Compute();
        CopyOut();
    }

private:
    __aicore__ inline void CopyIn()
    {
        // 从输入队列申请 UB 缓冲区（bfloat16_t）
        AscendC::LocalTensor<bfloat16_t> xLocal = inQueueX.AllocTensor<bfloat16_t>();
        AscendC::LocalTensor<bfloat16_t> yLocal = inQueueY.AllocTensor<bfloat16_t>();
        // 一次性从 GM 搬运整个 totalLength 到 UB（32 字节对齐，可直接 DataCopy）
        AscendC::DataCopy(xLocal, xGm, totalLength);
        AscendC::DataCopy(yLocal, yGm, totalLength);
        // 入队，标识数据搬运完成，可供 Compute 阶段 DeQue 使用
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        // 从输入队列 DeQue 取回 xLocal、yLocal（bfloat16_t）
        AscendC::LocalTensor<bfloat16_t> xLocal = inQueueX.DeQue<bfloat16_t>();
        AscendC::LocalTensor<bfloat16_t> yLocal = inQueueY.DeQue<bfloat16_t>();
        // 从输出队列申请 zLocal（bfloat16_t）
        AscendC::LocalTensor<bfloat16_t> zLocal = outQueueZ.AllocTensor<bfloat16_t>();

        // 从 TBuf 获取 float 临时内存（无需释放）
        AscendC::LocalTensor<float> tmpTensor0 = tmpBuf0.Get<float>();
        AscendC::LocalTensor<float> tmpTensor1 = tmpBuf1.Get<float>();

        // bfloat16_t → float（CAST_NONE：低精度转高精度，无精度损失）
        AscendC::Cast(tmpTensor0, xLocal, AscendC::RoundMode::CAST_NONE, totalLength);
        AscendC::Cast(tmpTensor1, yLocal, AscendC::RoundMode::CAST_NONE, totalLength);
        // float 除法：tmpTensor0 = tmpTensor0 / tmpTensor1（in-place，dst 复用 src0）
        AscendC::Div(tmpTensor0, tmpTensor0, tmpTensor1, totalLength);
        // float → bfloat16_t（CAST_RINT：向最近的偶数舍入）
        AscendC::Cast(zLocal, tmpTensor0, AscendC::RoundMode::CAST_RINT, totalLength);

        // 计算结果入队供 CopyOut 使用，并释放输入 buffer
        outQueueZ.EnQue<bfloat16_t>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut()
    {
        // 从输出队列 DeQue 取回计算结果 zLocal
        AscendC::LocalTensor<bfloat16_t> zLocal = outQueueZ.DeQue<bfloat16_t>();
        // 一次性从 UB 搬运整个 totalLength 到 GM（32 字节对齐，可直接 DataCopy）
        AscendC::DataCopy(zGm, zLocal, totalLength);
        // 释放输出 buffer
        outQueueZ.FreeTensor(zLocal);
    }

private:
    uint32_t totalLength;
    AscendC::GlobalTensor<bfloat16_t> xGm;
    AscendC::GlobalTensor<bfloat16_t> yGm;
    AscendC::GlobalTensor<bfloat16_t> zGm;
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueX;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueZ;
    // TBuf：类型转换（bfloat16_t ↔ float）所需的临时内存，位于 VECCALC，无需释放
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmpBuf0;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmpBuf1;
};

__global__ __aicore__ void div_bf16_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    KernelDivBf16 op;
    op.Init(x, y, z, totalLength);
    op.Process();
}

// bfloat16 与 float 之间的转换辅助函数，实现为简化计算，不与kernel侧实现完全一致
inline uint16_t FloatToBfloat16Bits(float f)
{
    uint32_t bits;
    std::memcpy(&bits, &f, sizeof(float));
    return static_cast<uint16_t>(bits >> 16);
}

// float → bfloat16：round-to-nearest-even，与 kernel 侧 Cast(CAST_RINT) 舍入模式一致
inline uint16_t FloatToBfloat16BitsRne(float f)
{
    uint32_t bits;
    std::memcpy(&bits, &f, sizeof(float));
    uint16_t upper = static_cast<uint16_t>(bits >> 16);
    uint16_t lower = static_cast<uint16_t>(bits & 0xFFFF);
    // 低位 > 0x8000 时进位；(低位 == 0x8000 且上一位为奇数) 时向偶进位
    if (lower > 0x8000 || (lower == 0x8000 && (upper & 1))) {
        upper++;
    }
    return upper;
}

inline float Bfloat16BitsToFloat(uint16_t bf16)
{
    uint32_t bits = static_cast<uint32_t>(bf16) << 16;
    float f;
    std::memcpy(&f, &bits, sizeof(float));
    return f;
}

// ACL 资源 RAII 守卫：离开作用域时统一释放设备内存、销毁流、复位设备
struct AclGuard {
    aclrtStream stream = nullptr;
    uint8_t *xDevice = nullptr;
    uint8_t *yDevice = nullptr;
    uint8_t *zDevice = nullptr;
    ~AclGuard()
    {
        if (xDevice != nullptr) aclrtFree(xDevice);
        if (yDevice != nullptr) aclrtFree(yDevice);
        if (zDevice != nullptr) aclrtFree(zDevice);
        if (stream != nullptr) aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();
    }
};

// ACL 调用返回值检查宏：失败时打印错误并返回空向量
#define CHECK_ACL(expr) do { \
    aclError _aclRet = (expr); \
    if (_aclRet != ACL_SUCCESS) { \
        std::cout << "[Failed] ACL error " << _aclRet << " at line " << __LINE__ << std::endl; \
        return std::vector<float>(); \
    } \
} while (0)

std::vector<float> kernel_div_bf16(std::vector<float> &x, std::vector<float> &y)
{
    uint32_t totalLength = static_cast<uint32_t>(x.size());

    // 防御性校验：y 长度必须不小于 x，否则后续访问 y[i] 越界
    if (y.size() < totalLength) {
        std::cout << "[Failed] y.size()(" << y.size() << ") < x.size()("
                  << totalLength << ")" << std::endl;
        return std::vector<float>();
    }

    // 将 float 输入转为 bfloat16 (uint16_t) 比特表示
    std::vector<uint16_t> xBf16(totalLength);
    std::vector<uint16_t> yBf16(totalLength);
    for (uint32_t i = 0; i < totalLength; i++) {
        xBf16[i] = FloatToBfloat16Bits(x[i]);
        yBf16[i] = FloatToBfloat16Bits(y[i]);
    }

    // 初始化 ACL；守卫对象负责失败时统一释放资源
    AclGuard guard;
    std::vector<uint16_t> zHost(totalLength, 0);

    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(0));
    CHECK_ACL(aclrtCreateStream(&guard.stream));

    // 分配 device 内存并搬运数据
    uint32_t bufferSize = totalLength * sizeof(uint16_t);
    CHECK_ACL(aclrtMalloc((void **)&guard.xDevice, bufferSize, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void **)&guard.yDevice, bufferSize, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void **)&guard.zDevice, bufferSize, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMemcpy(guard.xDevice, bufferSize, xBf16.data(), bufferSize, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(guard.yDevice, bufferSize, yBf16.data(), bufferSize, ACL_MEMCPY_HOST_TO_DEVICE));

    // 启动 kernel：单核执行
    constexpr uint32_t blockDim = 1;
    div_bf16_custom<<<blockDim, nullptr, guard.stream>>>(guard.xDevice, guard.yDevice, guard.zDevice, totalLength);
    CHECK_ACL(aclrtSynchronizeStream(guard.stream));

    // 回拷结果
    CHECK_ACL(aclrtMemcpy(zHost.data(), bufferSize, guard.zDevice, bufferSize, ACL_MEMCPY_DEVICE_TO_HOST));

    // 将 bfloat16 比特转回 float
    std::vector<float> output(totalLength);
    for (uint32_t i = 0; i < totalLength; i++) {
        output[i] = Bfloat16BitsToFloat(zHost[i]);
    }
    return output;
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    // bfloat16 精度较低，使用容差比较
    bool success = true;
    for (size_t i = 0; i < output.size(); i++) {
        if (std::abs(output[i] - golden[i]) > 1e-3) {
            success = false;
            break;
        }
    }
    if (success) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    std::vector<float> output = kernel_div_bf16(x, y);

    // golden 值需模拟 bfloat16 精度：float → bfloat16 → float → 除法 → bfloat16 → float
    float xBf16 = Bfloat16BitsToFloat(FloatToBfloat16Bits(valueX));
    float yBf16 = Bfloat16BitsToFloat(FloatToBfloat16Bits(valueY));
    float goldenValue = Bfloat16BitsToFloat(FloatToBfloat16BitsRne(xBf16 / yBf16));
    std::vector<float> golden(totalLength, goldenValue);
    return VerifyResult(output, golden);
}
