// div_bf16_custom.asc
// Challenge 02 · DivBf16Custom —— bfloat16 除法算子
// 思路：bfloat16_t --Cast(CAST_NONE)--> float --Div--> float --Cast(CAST_RINT)--> bfloat16_t
// 中间 float 结果用两个 TBuf（tmpBuf0/tmpBuf1）暂存。

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include <cstring>
#include "acl/acl.h"
#include "kernel_operator.h"

using namespace AscendC;

class KernelDivBf16 {
public:
    __aicore__ inline KernelDivBf16() {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength)
    {
        this->totalLength = totalLength;
        xGm.SetGlobalBuffer((__gm__ bfloat16_t *)x, totalLength);
        yGm.SetGlobalBuffer((__gm__ bfloat16_t *)y, totalLength);
        zGm.SetGlobalBuffer((__gm__ bfloat16_t *)z, totalLength);

        // 初始化输入输出队列（本题无 Tiling，单次处理 totalLength 个数据）
        pipe.InitBuffer(inQueueX, 1, totalLength * sizeof(bfloat16_t));
        pipe.InitBuffer(inQueueY, 1, totalLength * sizeof(bfloat16_t));
        pipe.InitBuffer(outQueueZ, 1, totalLength * sizeof(bfloat16_t));

        // 请补充：使用 InitBuffer 初始化两个 TBuf（tmpBuf0、tmpBuf1），
        // 大小为 totalLength * sizeof(float)，位置为 VECCALC
        pipe.InitBuffer(tmpBuf0, totalLength * sizeof(float));
        pipe.InitBuffer(tmpBuf1, totalLength * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        CopyIn();
        Compute();
        CopyOut();
    }

private:
    __aicore__ inline void CopyIn()
    {
        // 请补充：本题无 Tiling，直接使用整个 totalLength 进行 DataCopy
        // 1. AllocTensor 获取 xLocal、yLocal
        LocalTensor<bfloat16_t> xLocal = inQueueX.AllocTensor<bfloat16_t>();
        LocalTensor<bfloat16_t> yLocal = inQueueY.AllocTensor<bfloat16_t>();
        // 2. DataCopy 从 GM 搬运到 UB
        DataCopy(xLocal, xGm, totalLength);
        DataCopy(yLocal, yGm, totalLength);
        // 3. EnQue 入队
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        // 请补充：
        // 1. 从 inQueueX、inQueueY 中 DeQue 获取 xLocal、yLocal（bfloat16_t）
        LocalTensor<bfloat16_t> xLocal = inQueueX.DeQue<bfloat16_t>();
        LocalTensor<bfloat16_t> yLocal = inQueueY.DeQue<bfloat16_t>();
        // 2. 从 outQueueZ 中 AllocTensor 获取 zLocal（bfloat16_t）
        LocalTensor<bfloat16_t> zLocal = outQueueZ.AllocTensor<bfloat16_t>();
        // 3. 从 tmpBuf0、tmpBuf1 中 Get<float> 获取临时 tensor
        LocalTensor<float> tmpTensor0 = tmpBuf0.Get<float>();
        LocalTensor<float> tmpTensor1 = tmpBuf1.Get<float>();
        // 4. 使用 Cast 将 xLocal、yLocal 从 bfloat16_t 转为 float，存入 tmpTensor（CAST_NONE）
        Cast(tmpTensor0, xLocal, RoundMode::CAST_NONE, totalLength);
        Cast(tmpTensor1, yLocal, RoundMode::CAST_NONE, totalLength);
        // 5. 使用 Div 执行 float 除法：tmpTensor0 = tmpTensor0 / tmpTensor1（原地）
        Div(tmpTensor0, tmpTensor0, tmpTensor1, totalLength);
        // 6. 使用 Cast 将结果从 float 转回 bfloat16_t，存入 zLocal（CAST_RINT）
        Cast(zLocal, tmpTensor0, RoundMode::CAST_RINT, totalLength);
        // 7. EnQue(zLocal)，FreeTensor(xLocal)、FreeTensor(yLocal)
        outQueueZ.EnQue(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut()
    {
        // 请补充：本题无 Tiling，直接使用整个 totalLength 进行 DataCopy
        // 1. DeQue 获取 zLocal
        LocalTensor<bfloat16_t> zLocal = outQueueZ.DeQue<bfloat16_t>();
        // 2. DataCopy 从 UB 搬运到 GM
        DataCopy(zGm, zLocal, totalLength);
        // 3. FreeTensor
        outQueueZ.FreeTensor(zLocal);
    }

private:
    uint32_t totalLength;
    GlobalTensor<bfloat16_t> xGm;
    GlobalTensor<bfloat16_t> yGm;
    GlobalTensor<bfloat16_t> zGm;
    TPipe pipe;
    TQue<TPosition::VECIN, 1> inQueueX;
    TQue<TPosition::VECIN, 1> inQueueY;
    TQue<TPosition::VECOUT, 1> outQueueZ;
    // 请补充：声明两个 TBuf<AscendC::TPosition::VECCALC>：tmpBuf0、tmpBuf1
    TBuf<TPosition::VECCALC> tmpBuf0;
    TBuf<TPosition::VECCALC> tmpBuf1;
};

__global__ __aicore__ void div_bf16_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    KernelDivBf16 op;
    op.Init(x, y, z, totalLength);
    op.Process();
}

// bfloat16 与 float 之间的转换辅助函数，实现为简化计算，不与kernel侧实现完全一致
inline uint16_t FloatToBfloat16Bits(float f)
{
    uint32_t bits;
    std::memcpy(&bits, &f, sizeof(float));
    return static_cast<uint16_t>(bits >> 16);
}

inline float Bfloat16BitsToFloat(uint16_t bf16)
{
    uint32_t bits = static_cast<uint32_t>(bf16) << 16;
    float f;
    std::memcpy(&f, &bits, sizeof(float));
    return f;
}

std::vector<float> kernel_div_bf16(std::vector<float> &x, std::vector<float> &y)
{
    uint32_t totalLength = static_cast<uint32_t>(x.size());

    // 将 float 输入转为 bfloat16 (uint16_t) 比特表示
    std::vector<uint16_t> xBf16(totalLength);
    std::vector<uint16_t> yBf16(totalLength);
    for (uint32_t i = 0; i < totalLength; i++) {
        xBf16[i] = FloatToBfloat16Bits(x[i]);
        yBf16[i] = FloatToBfloat16Bits(y[i]);
    }

    // 初始化 ACL
    aclrtStream stream = nullptr;
    uint8_t *xDevice = nullptr;
    uint8_t *yDevice = nullptr;
    uint8_t *zDevice = nullptr;
    std::vector<uint16_t> zHost(totalLength, 0);

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtCreateStream(&stream);

    // 分配 device 内存并搬运数据
    uint32_t bufferSize = totalLength * sizeof(uint16_t);
    aclrtMalloc((void **)&xDevice, bufferSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&yDevice, bufferSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&zDevice, bufferSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(xDevice, bufferSize, xBf16.data(), bufferSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(yDevice, bufferSize, yBf16.data(), bufferSize, ACL_MEMCPY_HOST_TO_DEVICE);

    // 启动 kernel：单核执行
    constexpr uint32_t blockDim = 1;
    div_bf16_custom<<<blockDim, nullptr, stream>>>(xDevice, yDevice, zDevice, totalLength);
    aclrtSynchronizeStream(stream);

    // 回拷结果
    aclrtMemcpy(zHost.data(), bufferSize, zDevice, bufferSize, ACL_MEMCPY_DEVICE_TO_HOST);

    // 将 bfloat16 比特转回 float
    std::vector<float> output(totalLength);
    for (uint32_t i = 0; i < totalLength; i++) {
        output[i] = Bfloat16BitsToFloat(zHost[i]);
    }

    // 释放资源
    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFree(zDevice);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();

    return output;
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    // bfloat16 精度较低，使用容差比较
    bool success = true;
    for (size_t i = 0; i < output.size(); i++) {
        if (std::abs(output[i] - golden[i]) > 1e-3) {
            success = false;
            break;
        }
    }
    if (success) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 2048;
    constexpr float valueX = 1.2f;
    constexpr float valueY = 2.3f;
    std::vector<float> x(totalLength, valueX);
    std::vector<float> y(totalLength, valueY);

    std::vector<float> output = kernel_div_bf16(x, y);

    // golden 值需模拟 bfloat16 精度：float → bfloat16 → float → 除法 → bfloat16 → float
    float xBf16 = Bfloat16BitsToFloat(FloatToBfloat16Bits(valueX));
    float yBf16 = Bfloat16BitsToFloat(FloatToBfloat16Bits(valueY));
    float goldenValue = Bfloat16BitsToFloat(FloatToBfloat16Bits(xBf16 / yBf16));
    std::vector<float> golden(totalLength, goldenValue);
    return VerifyResult(output, golden);
}
