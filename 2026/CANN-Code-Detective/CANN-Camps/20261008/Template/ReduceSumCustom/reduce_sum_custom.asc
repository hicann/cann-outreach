/* !
 * \file reduce_sum_custom.asc
 * \brief CANN训练营 · ReduceSumCustom 代码骨架：SIMT 多线程块归约求和
 *
 * 本题分两步：
 *   1) block 内归约：在 block_reduce() 中用蝶式归约求出各 warp 的和，再合并成本 block 的部分和；
 *   2) 全局归约：在 reduce_sum_custom() 中由最后一个完成的 block 读回全部部分和，汇总成最终结果。
 *
 * 核函数以外的主机侧代码（数据准备、<<<>>> 启动配置、精度校验）已给出，无需修改；
 * 需要你补全的是 block_reduce() 与 reduce_sum_custom() 两个函数的函数体。
 */

#include <iostream>
#include <vector>
#include "acl/acl.h"
#include "simt_api/asc_simt.h"

namespace {
constexpr uint32_t THREAD_COUNT = 1024;
}

