// cosh_custom.asc

#include <cstdint>
#include <iostream>
#include <vector>
#include <cmath>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

using namespace AscendC;

constexpr uint32_t BUFFER_NUM = 2; // tensor num for each queue

struct CoshCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelCosh {
public:
    __aicore__ inline KernelCosh() {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, uint32_t totalLength, uint32_t tileNum)
    {
        // 1. 设置 GM buffer（xGm、yGm）
        xGm.SetGlobalBuffer((__gm__ float *)x);
        yGm.SetGlobalBuffer((__gm__ float *)y);
        // 保存 tiling 参数
        this->totalLength = totalLength;
        this->tileNum = tileNum;
        this->tileSize = totalLength / tileNum;
        // 2. 使用 pipe.InitBuffer 初始化输入队列 inQueueX、输出队列 outQueueY
        pipe.InitBuffer(inQueueX, BUFFER_NUM, tileSize * sizeof(float));
        pipe.InitBuffer(outQueueY, BUFFER_NUM, tileSize * sizeof(float));
        // 3. 使用 pipe.InitBuffer 初始化两个 TBuf（tmpBuf0、tmpBuf1），
        //    位置为 VECCALC，大小为 tileSize * sizeof(float)
        pipe.InitBuffer(tmpBuf0, tileSize * sizeof(float));
        pipe.InitBuffer(tmpBuf1, tileSize * sizeof(float));
    }
    __aicore__ inline void Process()
    {
        // 循环处理每个 tile
        for (int32_t progress = 0; progress < tileNum; progress++) {
            CopyIn(progress);
            Compute(progress);
            CopyOut(progress);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        // 从 Global Memory 拷贝当前 tile 的数据到 Local Memory
        LocalTensor<float> xLocal = inQueueX.AllocTensor<float>();
        DataCopy(xLocal, xGm[progress * tileSize], tileSize);
        inQueueX.EnQue(xLocal);
    }
    __aicore__ inline void Compute(int32_t progress)
    {
        // 计算公式：cosh(x) = (Exp(x) + Exp(-x)) / 2
        // 1. 从 inQueueX 中 DeQue 获取 xLocal
        LocalTensor<float> xLocal = inQueueX.DeQue<float>();
        // 2. 从 outQueueY 中 AllocTensor 获取 yLocal
        LocalTensor<float> yLocal = outQueueY.AllocTensor<float>();
        // 3. 从 tmpBuf0、tmpBuf1 中 Get<float> 获取临时 tensor
        LocalTensor<float> tmpTensor0 = tmpBuf0.Get<float>();
        LocalTensor<float> tmpTensor1 = tmpBuf1.Get<float>();
        // 4. 使用 Exp 计算 tmpTensor0 = Exp(xLocal)
        Exp(tmpTensor0, xLocal, tileSize);
        // 5. 先对 xLocal 取反，再使用 Exp 计算 tmpTensor1 = Exp(-x)
        Muls(tmpTensor1, xLocal, -1.0f, tileSize);
        Exp(tmpTensor1, tmpTensor1, tileSize);
        // 6. 将两个中间结果相加：tmpTensor0 = tmpTensor0 + tmpTensor1
        Add(tmpTensor0, tmpTensor0, tmpTensor1, tileSize);
        // 7. 除以 2：yLocal = tmpTensor0 * 0.5f
        Muls(yLocal, tmpTensor0, 0.5f, tileSize);
        // 8. EnQue(yLocal)，FreeTensor(xLocal)
        outQueueY.EnQue(yLocal);
        inQueueX.FreeTensor(xLocal);
    }
    __aicore__ inline void CopyOut(int32_t progress)
    {
        // 从 Local Memory 拷贝结果到 Global Memory
        LocalTensor<float> yLocal = outQueueY.DeQue<float>();
        DataCopy(yGm[progress * tileSize], yLocal, tileSize);
        outQueueY.FreeTensor(yLocal);
    }

private:
    TPipe pipe;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueX;
    TQue<QuePosition::VECOUT, BUFFER_NUM> outQueueY;
    TBuf<TPosition::VECCALC> tmpBuf0;
    TBuf<TPosition::VECCALC> tmpBuf1;
    GlobalTensor<float> xGm;
    GlobalTensor<float> yGm;
    uint32_t totalLength;
    uint32_t tileNum;
    uint32_t tileSize;
};

__global__ __aicore__ __vector__ void cosh_custom(GM_ADDR x, GM_ADDR y, CoshCustomTilingData tiling)
{
    InitSocState();
    KernelCosh op;
    op.Init(x, y, tiling.totalLength, tiling.tileNum);
    op.Process();
    PipeBarrier<PIPE_ALL>();
}

std::vector<float> kernel_cosh(std::vector<float> &x)
{
    uint32_t totalLength = x.size();
    uint32_t tileNum = 8;

    CoshCustomTilingData tiling;
    tiling.totalLength = totalLength;
    tiling.tileNum = tileNum;

    std::vector<float> y(totalLength, 0.0f);

    // 初始化 ACL
    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    // 分配 Device 内存
    size_t devSize = totalLength * sizeof(float);
    uint8_t *devX = nullptr;
    uint8_t *devY = nullptr;
    aclrtMalloc((void **)&devX, devSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&devY, devSize, ACL_MEM_MALLOC_HUGE_FIRST);

    // 拷贝输入到 Device
    aclrtMemcpy(devX, devSize, x.data(), devSize, ACL_MEMCPY_HOST_TO_DEVICE);

    // 启播 kernel（<<<>>> 是预编译 AscendC kernel 的调用语法）
    constexpr uint32_t numBlocks = 1;
    cosh_custom<<<numBlocks, 0, stream>>>(devX, devY, tiling);

    // 同步并拷贝结果回 Host
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(y.data(), devSize, devY, devSize, ACL_MEMCPY_DEVICE_TO_HOST);

    // 释放资源
    aclrtFree(devX);
    aclrtFree(devY);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return y;
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 5.5f;
    std::vector<float> x(totalLength, valueX);

    // 调用 kernel 进行推理
    std::vector<float> output = kernel_cosh(x);

    std::vector<float> golden(totalLength, std::cosh(valueX));
    return VerifyResult(output, golden);
}
