// cosh_custom.asc

#include <algorithm>
#include <cmath>
#include <cstdint>
#include <iostream>
#include <iterator>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"

constexpr uint32_t BUFFER_NUM = 2; // tensor num for each queue
constexpr uint32_t TILE_LENGTH = 2048;

struct CoshCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelCosh {
public:
    __aicore__ inline KernelCosh() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, uint32_t totalLength, uint32_t tileNum)
    {
        totalLength_ = totalLength;
        tileNum_ = tileNum;
        tileLength_ = totalLength_ / tileNum_;

        // The host launches one AIV core. That core owns the full input and
        // processes it as tileNum_ independent, equally sized tiles.
        xGm_.SetGlobalBuffer((__gm__ float *)x, totalLength_);
        yGm_.SetGlobalBuffer((__gm__ float *)y, totalLength_);

        pipe_.InitBuffer(inQueueX_, BUFFER_NUM, tileLength_ * sizeof(float));
        pipe_.InitBuffer(outQueueY_, BUFFER_NUM, tileLength_ * sizeof(float));

        // tmpBuf0_ stores Exp(x), while tmpBuf1_ stores Exp(-x).
        pipe_.InitBuffer(tmpBuf0_, tileLength_ * sizeof(float));
        pipe_.InitBuffer(tmpBuf1_, tileLength_ * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t progress = 0; progress < tileNum_; ++progress) {
            CopyIn(progress);
            Compute(progress);
            CopyOut(progress);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t progress)
    {
        const uint32_t offset = progress * tileLength_;
        AscendC::LocalTensor<float> xLocal = inQueueX_.AllocTensor<float>();
        AscendC::DataCopy(xLocal, xGm_[offset], tileLength_);
        inQueueX_.EnQue<float>(xLocal);
    }

    __aicore__ inline void Compute(uint32_t progress)
    {
        (void)progress;
        AscendC::LocalTensor<float> xLocal = inQueueX_.DeQue<float>();
        AscendC::LocalTensor<float> yLocal = outQueueY_.AllocTensor<float>();
        AscendC::LocalTensor<float> tmpTensor0 = tmpBuf0_.Get<float>();
        AscendC::LocalTensor<float> tmpTensor1 = tmpBuf1_.Get<float>();

        // cosh(x) = (Exp(x) + Exp(-x)) / 2. Cosh is intentionally not used.
        AscendC::Exp<float>(tmpTensor0, xLocal, tileLength_);
        AscendC::Muls<float>(tmpTensor1, xLocal, -1.0f, tileLength_);
        AscendC::Exp<float>(tmpTensor1, tmpTensor1, tileLength_);
        AscendC::Add<float>(tmpTensor0, tmpTensor0, tmpTensor1, tileLength_);
        AscendC::Muls<float>(yLocal, tmpTensor0, 0.5f, tileLength_);

        outQueueY_.EnQue<float>(yLocal);
        inQueueX_.FreeTensor(xLocal);
    }

    __aicore__ inline void CopyOut(uint32_t progress)
    {
        const uint32_t offset = progress * tileLength_;
        AscendC::LocalTensor<float> yLocal = outQueueY_.DeQue<float>();
        AscendC::DataCopy(yGm_[offset], yLocal, tileLength_);
        outQueueY_.FreeTensor(yLocal);
    }

private:
    uint32_t totalLength_ = 0;
    uint32_t tileNum_ = 0;
    uint32_t tileLength_ = 0;
    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inQueueX_;
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_NUM> outQueueY_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmpBuf0_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmpBuf1_;
    AscendC::GlobalTensor<float> xGm_;
    AscendC::GlobalTensor<float> yGm_;
};

__global__ __aicore__ void cosh_custom(GM_ADDR x, GM_ADDR y, CoshCustomTilingData tiling)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    KernelCosh op;
    op.Init(x, y, tiling.totalLength, tiling.tileNum);
    op.Process();
}

std::vector<float> kernel_cosh(std::vector<float> &x)
{
    const uint32_t totalLength = static_cast<uint32_t>(x.size());
    std::vector<float> output(totalLength, 0.0f);
    if (totalLength == 0) {
        return output;
    }
    if (totalLength % TILE_LENGTH != 0) {
        std::cerr << "totalLength must be a multiple of " << TILE_LENGTH << std::endl;
        return output;
    }

    constexpr int32_t deviceId = 0;
    constexpr uint32_t blockDim = 1;
    const size_t bufferSize = static_cast<size_t>(totalLength) * sizeof(float);
    CoshCustomTilingData tiling{totalLength, totalLength / TILE_LENGTH};

    aclrtStream stream = nullptr;
    uint8_t *xDevice = nullptr;
    uint8_t *yDevice = nullptr;
    bool deviceSet = false;
    aclError ret = aclInit(nullptr);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclInit failed, ret=" << ret << std::endl;
        return output;
    }

    ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtSetDevice failed, ret=" << ret << std::endl;
        aclFinalize();
        return output;
    }
    deviceSet = true;

    ret = aclrtCreateStream(&stream);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtCreateStream failed, ret=" << ret << std::endl;
        goto cleanup;
    }

    ret = aclrtMalloc(reinterpret_cast<void **>(&xDevice), bufferSize, ACL_MEM_MALLOC_HUGE_FIRST);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtMalloc for input failed, ret=" << ret << std::endl;
        goto cleanup;
    }

    ret = aclrtMalloc(reinterpret_cast<void **>(&yDevice), bufferSize, ACL_MEM_MALLOC_HUGE_FIRST);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtMalloc for output failed, ret=" << ret << std::endl;
        goto cleanup;
    }

    ret = aclrtMemcpy(xDevice, bufferSize, x.data(), bufferSize, ACL_MEMCPY_HOST_TO_DEVICE);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtMemcpy host-to-device failed, ret=" << ret << std::endl;
        goto cleanup;
    }

    cosh_custom<<<blockDim, nullptr, stream>>>(xDevice, yDevice, tiling);
    ret = aclrtSynchronizeStream(stream);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtSynchronizeStream failed, ret=" << ret << std::endl;
        goto cleanup;
    }

    ret = aclrtMemcpy(output.data(), bufferSize, yDevice, bufferSize, ACL_MEMCPY_DEVICE_TO_HOST);
    if (ret != ACL_SUCCESS) {
        std::cerr << "aclrtMemcpy device-to-host failed, ret=" << ret << std::endl;
    }

cleanup:
    if (yDevice != nullptr) {
        aclrtFree(yDevice);
    }
    if (xDevice != nullptr) {
        aclrtFree(xDevice);
    }
    if (stream != nullptr) {
        aclrtDestroyStream(stream);
    }
    if (deviceSet) {
        aclrtResetDevice(deviceId);
    }
    aclFinalize();
    return output;
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");

    constexpr float absoluteTolerance = 1e-3f;
    constexpr float relativeTolerance = 1e-5f;
    bool success = output.size() == golden.size();
    for (size_t i = 0; success && i < output.size(); ++i) {
        const float tolerance = absoluteTolerance + relativeTolerance * std::abs(golden[i]);
        if (!std::isfinite(output[i]) || std::abs(output[i] - golden[i]) > tolerance) {
            success = false;
        }
    }

    if (success) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    }
    std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
    return 1;
}

int32_t main(int32_t argc, char *argv[])
{
    (void)argc;
    (void)argv;
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 5.5f;
    std::vector<float> x(totalLength, valueX);

    std::vector<float> output = kernel_cosh(x);

    std::vector<float> golden(totalLength, std::cosh(valueX));
    return VerifyResult(output, golden);
}
