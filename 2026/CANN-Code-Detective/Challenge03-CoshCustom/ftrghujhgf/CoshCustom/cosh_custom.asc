// cosh_custom.asc

#include <cstdint>
#include <iostream>
#include <vector>
#include <cmath>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"
using namespace AscendC;

constexpr uint32_t BUFFER_NUM = 2; // tensor num for each queue

struct CoshCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelCosh {
public:
    __aicore__ inline KernelCosh(){}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, uint32_t totalLength, uint32_t tileNum)
    {
        this->tileNum = tileNum;
        blockLength = totalLength / GetBlockNum();
        tileLength = blockLength / BUFFER_NUM / tileNum;
        
        gmX.SetGlobalBuffer((__gm__ float*)x + blockLength * GetBlockIdx(), blockLength);
        gmY.SetGlobalBuffer((__gm__ float*)y + blockLength * GetBlockIdx(), blockLength);

        pipe.InitBuffer(inX, BUFFER_NUM, tileLength * sizeof(float));
        pipe.InitBuffer(outY, BUFFER_NUM, tileLength * sizeof(float));
        pipe.InitBuffer(buf1, tileLength * sizeof(float));
        pipe.InitBuffer(buf2, tileLength * sizeof(float));
    }
    __aicore__ inline void Process()
    {
        for(int i = 0; i < tileNum * BUFFER_NUM; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        // 请补充……
        LocalTensor<float> x = inX.AllocTensor<float>();
        DataCopy(x, gmX[progress * tileLength], tileLength);
        inX.EnQue(x);
    }
    __aicore__ inline void Compute(int32_t progress)
    {
        LocalTensor<float> x = inX.DeQue<float>();
        LocalTensor<float> y = outY.AllocTensor<float>();
        LocalTensor<float> tmp1 = buf1.Get<float>();
        LocalTensor<float> tmp2 = buf2.Get<float>();
        Exp(tmp1, x, tileLength);
        Muls(x, x, -1.0f, tileLength);
        Exp(tmp2, x, tileLength);
        Add(tmp1, tmp1, tmp2, tileLength);
        Muls(y, tmp1, 0.5f, tileLength);
        outY.EnQue(y);
        inX.FreeTensor(x);
    }
    __aicore__ inline void CopyOut(int32_t progress)
    {
        LocalTensor<float> y = outY.DeQue<float>();
        DataCopy(gmY[progress * tileLength], y, tileLength);
        outY.FreeTensor(y);
    }

private:
    int tileLength, blockLength, tileNum;
    TPipe pipe;
    TQue<TPosition::VECIN, BUFFER_NUM> inX;
    TQue<TPosition::VECOUT, BUFFER_NUM> outY;
    TBuf<TPosition::VECCALC> buf1, buf2;
    GlobalTensor<float> gmX, gmY;
};

__global__ __aicore__ void cosh_custom(GM_ADDR x, GM_ADDR y, CoshCustomTilingData tiling)
{
    KernelCosh op;
    op.Init(x, y, tiling.totalLength, tiling.tileNum);
    op.Process();
}

std::vector<float> kernel_cosh(std::vector<float> &x)
{
    uint32_t totalLength = x.size();
    uint32_t tileNum = 8;
    uint32_t bufferSize = totalLength * sizeof(float);
    uint32_t blockDim = 8;
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtContext context = nullptr;
    aclrtCreateContext(&context, 0);
    aclrtSetCurrentContext(context);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    uint8_t *xDevice = nullptr;
    uint8_t *yDevice = nullptr;
    uint8_t *yHost = nullptr;
    aclrtMallocHost((void **)(&yHost), bufferSize);
    aclrtMalloc((void**)&xDevice, bufferSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDevice, bufferSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(xDevice, bufferSize, x.data(), bufferSize, ACL_MEMCPY_HOST_TO_DEVICE);
    CoshCustomTilingData tiling = {
        .totalLength=totalLength,
        .tileNum=tileNum
    };
    cosh_custom<<<blockDim, nullptr, stream>>>(xDevice, yDevice, tiling);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(yHost, bufferSize, yDevice, bufferSize, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float>ans((float*)yHost, (float*)yHost + totalLength);
    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFreeHost(yHost);
    aclrtDestroyStream(stream);
    aclrtDestroyContext(context); 
    aclrtResetDevice(0);
    aclFinalize();
    printf("RecentErrMsg=%s", aclGetRecentErrMsg());
    return ans;
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 5.5f;
    std::vector<float> x(totalLength, valueX);

    std::vector<float> output = kernel_cosh(x);

    std::vector<float> golden(totalLength, std::cosh(valueX));
    return VerifyResult(output, golden);
}
