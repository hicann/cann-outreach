// cosh_custom.asc

#include <cstdint>
#include <iostream>
#include <vector>
#include <cmath>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

constexpr uint32_t BUFFER_NUM = 2; // tensor num for each queue

struct CoshCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};

class KernelCosh {
public:
    __aicore__ inline KernelCosh(){}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, uint32_t totalLength, uint32_t tileNum)
    {
        // 请补充……
        // 添加注释
        this->tileNum = tileNum;
        this->tileLength =
            totalLength / (tileNum * BUFFER_NUM);
        // 提示：
        // 1. 设置 GM buffer（xGm、yGm）
        xGm.SetGlobalBuffer((__gm__ float*)x, totalLength);
        yGm.SetGlobalBuffer((__gm__ float*)y, totalLength);
        // 2. 使用 pipe.InitBuffer 初始化输入队列 inQueueX、输出队列 outQueueY（BUFFER_NUM 个 buffer）
        pipe.InitBuffer(inQueueX, BUFFER_NUM, tileLength * sizeof(float));
        pipe.InitBuffer(outQueueY, BUFFER_NUM, tileLength * sizeof(float));
        // 3. 使用 pipe.InitBuffer 初始化两个 TBuf（tmpBuf0、tmpBuf1），
        //    位置为 VECCALC，大小为 tileSize * sizeof(float)
        //    用于存放 Exp(x) 与 Exp(-x) 的中间结果
        pipe.InitBuffer(tmpBuf0, tileLength * sizeof(float));
        pipe.InitBuffer(tmpBuf1, tileLength * sizeof(float));
    }
    __aicore__ inline void Process()
    {
        // 请补充……
        int32_t loopCount = this->tileNum * BUFFER_NUM;
        for (int32_t progress = 0; progress < loopCount; progress++) {
            CopyIn(progress);
            Compute(progress);
            CopyOut(progress);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        // 请补充……
        AscendC::LocalTensor<float> xLocal = inQueueX.AllocTensor<float>();
        AscendC::DataCopy(
            xLocal,
            xGm[progress * this->tileLength],
            this->tileLength);
        inQueueX.EnQue(xLocal);
    }
    __aicore__ inline void Compute(int32_t progress)
    {
        // 请补充……
        // 提示：本题必须使用 Exp 接口实现 cosh，不能直接调用 Cosh 接口
        // 计算公式：cosh(x) = (Exp(x) + Exp(-x)) / 2
        // 1. 从 inQueueX 中 DeQue 获取 xLocal
        AscendC::LocalTensor<float> xLocal = inQueueX.DeQue<float>();
        // 2. 从 outQueueY 中 AllocTensor 获取 yLocal
        AscendC::LocalTensor<float> yLocal = outQueueY.AllocTensor<float>();
        // 3. 从 tmpBuf0、tmpBuf1 中 Get<float> 获取临时 tensor：tmpTensor0、tmpTensor1
        AscendC::LocalTensor<float> tmpTensor0 = tmpBuf0.Get<float>();
        AscendC::LocalTensor<float> tmpTensor1 = tmpBuf1.Get<float>();
        // 4. 使用 Exp 计算 tmpTensor0 = Exp(xLocal)
        AscendC::Exp(tmpTensor0, xLocal, tileLength);
        // 5. 先对 xLocal 取反（Muls(xLocal, xLocal, -1.0f)）或使用其他方式得到 -x，
        //    再使用 Exp 计算 tmpTensor1 = Exp(-x)
        AscendC::Muls(xLocal, xLocal, -1.0f, tileLength);
        AscendC::Exp(tmpTensor1, xLocal, tileLength);
        // 6. 将两个中间结果相加：Add(tmpTensor0, tmpTensor0, tmpTensor1)
        AscendC::Add(tmpTensor0, tmpTensor0, tmpTensor1, tileLength);
        // 7. 除以 2：Muls(yLocal, tmpTensor0, 0.5f)
        AscendC::Muls(yLocal, tmpTensor0, 0.5f, tileLength);
        // 8. EnQue(yLocal)，FreeTensor(xLocal)
        outQueueY.EnQue<float>(yLocal);
        inQueueX.FreeTensor(xLocal);
    }
    __aicore__ inline void CopyOut(int32_t progress)
    {
        // 请补充……
        AscendC::LocalTensor<float> yLocal = outQueueY.DeQue<float>();
        AscendC::DataCopy(
            yGm[progress * this->tileLength],
            yLocal,
            this->tileLength);
        outQueueY.FreeTensor(yLocal);
    }

private:
    // 请补充……
    // 提示：除 TPipe、TQue 外，还需声明两个 TBuf<AscendC::TPosition::VECCALC>：tmpBuf0、tmpBuf1
    uint32_t tileNum;
    uint32_t tileLength;
    AscendC::GlobalTensor<float> xGm;
    AscendC::GlobalTensor<float> yGm;
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inQueueX;
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_NUM> outQueueY;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmpBuf0;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmpBuf1;
};

__global__ __aicore__ void cosh_custom(GM_ADDR x, GM_ADDR y, CoshCustomTilingData tiling)
{
    // 请补充……
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);

    KernelCosh op;
    op.Init(x, y, tiling.totalLength, tiling.tileNum);
    op.Process();
}

std::vector<float> kernel_cosh(std::vector<float> &x)
{
    // 请补充……
    uint32_t totalLength = static_cast<uint32_t>(x.size());
    uint32_t bufferSize = totalLength * sizeof(float);

    aclrtStream stream = nullptr;
    uint8_t *xDevice = nullptr;
    uint8_t *yDevice = nullptr;
    std::vector<float> output(totalLength, 0.0f);

    // 初始化 ACL
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtCreateStream(&stream);

    // 分配输入、输出设备内存
    aclrtMalloc(
        reinterpret_cast<void **>(&xDevice),
        bufferSize,
        ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(
        reinterpret_cast<void **>(&yDevice),
        bufferSize,
        ACL_MEM_MALLOC_HUGE_FIRST);

    // 输入数据从 Host 搬到 Device
    aclrtMemcpy(
        xDevice,
        bufferSize,
        x.data(),
        bufferSize,
        ACL_MEMCPY_HOST_TO_DEVICE);

    // totalLength = 8 * 2048，对应 8 个双缓冲处理周期
    constexpr uint32_t tileNum = 8;
    CoshCustomTilingData tiling {
        totalLength,
        tileNum
    };

    // 单核启动 kernel
    constexpr uint32_t blockDim = 1;
    cosh_custom<<<blockDim, nullptr, stream>>>(
        xDevice,
        yDevice,
        tiling);

    aclrtSynchronizeStream(stream);

    // 输出从 Device 搬回 Host
    aclrtMemcpy(
        output.data(),
        bufferSize,
        yDevice,
        bufferSize,
        ACL_MEMCPY_DEVICE_TO_HOST);

    // 释放资源
    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();

    return output;
}

uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr float valueX = 5.5f;
    std::vector<float> x(totalLength, valueX);

    // 请补充……
    std::vector<float> output = kernel_cosh(x);

    std::vector<float> golden(totalLength, std::cosh(valueX));
    return VerifyResult(output, golden);
}
