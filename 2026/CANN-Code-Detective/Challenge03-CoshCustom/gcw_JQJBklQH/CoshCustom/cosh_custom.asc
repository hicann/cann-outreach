// ============================================================================
// cosh_custom.asc —— CoshCustom 双曲余弦算子（Ascend C kernel 直调实现）
//
// 算子描述：
//   输入  x：float32 张量，长度 totalLength = 8 * 2048 = 16384
//   输出  y：float32 张量，长度 totalLength
//   计算  y[i] = (Exp(x[i]) + Exp(-x[i])) / 2，即 cosh(x) = (e^x + e^-x) / 2
//
// 实现要点：
//   1. 按照 Ascend C 核心编程范式：Tiling 切分 → CopyIn → Compute → CopyOut；
//   2. 必须使用 Exp 指令实现，不直接调用 Cosh 接口；
//   3. 中间结果 Exp(x) 与 Exp(-x) 分别存放于两个 TBuf（VECCALC 位置）；
//   4. 多核并行：8 个 AIV 核心，每个核平均分配若干 tile；
//   5. Host 侧通过 ACL 接口完成内存申请/搬运，并用 <<<>>> 内核调用符启动 kernel。
//
// 数据流：
//   GM (x) --CopyIn--> UB (xLocal) --Compute--> UB (yLocal) --CopyOut--> GM (y)
//             EnQue                 EnQue                  DeQue
// ============================================================================

#include <cstdint>
#include <iostream>
#include <vector>
#include <cmath>
#include <algorithm>
#include <iterator>
#include "acl/acl.h"
#include "kernel_operator.h"

using namespace AscendC;

constexpr uint32_t BUFFER_NUM = 2;   // 每个队列的 buffer 数量（Double Buffer，搬运与计算重叠）
constexpr uint32_t TILE_LENGTH = 1024; // 每个 tile 的元素个数（16384 可被其整除，无需尾块处理）

// Tiling 数据结构：Host 侧计算后随 kernel 启动按值传入 Device 侧
struct CoshCustomTilingData
{
    uint32_t totalLength; // 输入/输出的总元素个数
    uint32_t tileNum;     // 所有核合计需要处理的 tile 总数（totalLength / TILE_LENGTH）
};

// KernelCosh：cosh 算子的 kernel 侧实现（单个 AI Core 上的处理逻辑）
class KernelCosh {
public:
    __aicore__ inline KernelCosh(){}

    // 初始化：设置 GM buffer、按核索引切分数据、初始化队列与 TBuf
    // 参数：x/y —— 输入/输出的 GM 起始地址；totalLength —— 总元素个数；
    //       tileNum —— 本核需要处理的 tile 数（已由 kernel 入口按核数平均分配）
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, uint32_t totalLength, uint32_t tileNum)
    {
        // 1. 记录本核负责的 tile 数，并按核索引计算本核数据在 GM 中的起始偏移
        this->tileNum = tileNum;
        uint32_t blockOffset = GetBlockIdx() * tileNum * TILE_LENGTH;

        // 2. 设置 GM buffer（xGm、yGm），仅指向本核负责的数据段
        xGm.SetGlobalBuffer((__gm__ float*)x + blockOffset, tileNum * TILE_LENGTH);
        yGm.SetGlobalBuffer((__gm__ float*)y + blockOffset, tileNum * TILE_LENGTH);

        // 3. 初始化输入队列 inQueueX、输出队列 outQueueY（Double Buffer）
        pipe.InitBuffer(inQueueX, BUFFER_NUM, TILE_LENGTH * sizeof(float));
        pipe.InitBuffer(outQueueY, BUFFER_NUM, TILE_LENGTH * sizeof(float));

        // 4. 初始化两个 TBuf（VECCALC 位置），用于存放 Exp(x) 与 Exp(-x) 的中间结果
        pipe.InitBuffer(tmpBuf0, TILE_LENGTH * sizeof(float));
        pipe.InitBuffer(tmpBuf1, TILE_LENGTH * sizeof(float));
    }
    // 主处理流程：按 tile 迭代执行 CopyIn → Compute → CopyOut 三级流水
    __aicore__ inline void Process()
    {
        for (int32_t i = 0; i < this->tileNum; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    // 搬入阶段：将第 progress 个 tile 的数据从 GM 搬入 Unified Buffer（UB），并 EnQue 入队
    __aicore__ inline void CopyIn(int32_t progress)
    {
        // 从输入队列分配 UB 空间，获得 xLocal
        LocalTensor<float> xLocal = inQueueX.AllocTensor<float>();
        // 按 tile 偏移将 GM 数据搬入 UB（xGm 已指向本核数据段）
        DataCopy(xLocal, xGm[progress * TILE_LENGTH], TILE_LENGTH);
        // 入队，供 Compute 阶段消费
        inQueueX.EnQue(xLocal);
    }
    // 计算阶段：cosh(x) = (Exp(x) + Exp(-x)) / 2（必须使用 Exp 接口，不得直接调用 Cosh）
    //
    // 计算流程：
    //          ┌── Exp ──► tmpTensor0 (tmpBuf0) ──────────────────┐
    //   xLocal ┤                                                    ├── Add ──► Muls(0.5) ──► yLocal
    //          └── Muls(-1) ──► Exp ──► tmpTensor1 (tmpBuf1) ──────┘
    __aicore__ inline void Compute(int32_t progress)
    {
        // 1. 出队获取输入 xLocal；从输出队列分配空间获得 yLocal
        LocalTensor<float> xLocal = inQueueX.DeQue<float>();
        LocalTensor<float> yLocal = outQueueY.AllocTensor<float>();

        // 2. 从两个 TBuf 中获取中间结果 tensor（无需出队，直接 Get 即可）
        LocalTensor<float> tmpTensor0 = tmpBuf0.Get<float>();
        LocalTensor<float> tmpTensor1 = tmpBuf1.Get<float>();

        // 3. tmpTensor0 = Exp(x)
        Exp(tmpTensor0, xLocal, TILE_LENGTH);

        // 4. tmpTensor1 = Exp(-x)：先乘 -1 取反，再求指数
        Muls(tmpTensor1, xLocal, -1.0f, TILE_LENGTH);
        Exp(tmpTensor1, tmpTensor1, TILE_LENGTH);

        // 5. tmpTensor0 = Exp(x) + Exp(-x)
        Add(tmpTensor0, tmpTensor0, tmpTensor1, TILE_LENGTH);

        // 6. yLocal = (Exp(x) + Exp(-x)) / 2，等价于除以 2
        Muls(yLocal, tmpTensor0, 0.5f, TILE_LENGTH);

        // 7. 计算结果入队，供 CopyOut 消费；释放输入 tensor 归还队列
        outQueueY.EnQue<float>(yLocal);
        inQueueX.FreeTensor(xLocal);
    }
    // 搬出阶段：将第 progress 个 tile 的计算结果从 UB 搬回 GM
    __aicore__ inline void CopyOut(int32_t progress)
    {
        // 出队获取计算结果 yLocal
        LocalTensor<float> yLocal = outQueueY.DeQue<float>();
        // 按 tile 偏移写回 GM（yGm 已指向本核数据段）
        DataCopy(yGm[progress * TILE_LENGTH], yLocal, TILE_LENGTH);
        // 释放 tensor，归还输出队列
        outQueueY.FreeTensor(yLocal);
    }

private:
    // TPipe：内存管理对象，用于为队列和 TBuf 分配 UB 空间
    TPipe pipe;
    // 输入/输出队列（Double Buffer）：QuePosition 标识队列位置（VECIN/VECOUT）
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueX;  // 输入队列：存放从 GM 搬入的 x
    TQue<QuePosition::VECOUT, BUFFER_NUM> outQueueY; // 输出队列：存放待搬回 GM 的 y
    // 中间结果缓冲（VECCALC 位置）：tmpBuf0 存放 Exp(x)，tmpBuf1 存放 Exp(-x)
    TBuf<TPosition::VECCALC> tmpBuf0;
    TBuf<TPosition::VECCALC> tmpBuf1;
    // GM 数据：GlobalTensor 管理本核负责的数据段
    GlobalTensor<float> xGm; // 输入 x
    GlobalTensor<float> yGm; // 输出 y
    // 本核负责的 tile 数（由 kernel 入口按核数平均分配）
    uint32_t tileNum = 0;
};

// cosh_custom：kernel 入口函数（核函数），由 Host 侧用 <<<>>> 内核调用符启动
// 参数：x/y —— 输入/输出的 GM 地址；tiling —— Host 侧计算好的切分参数（按值传入）
__global__ __aicore__ void cosh_custom(GM_ADDR x, GM_ADDR y, CoshCustomTilingData tiling)
{
    // 将所有 tile 平均分配到各核执行，并校验切分合法性
    ASSERT(GetBlockNum() != 0 && "block dim can not be zero!");
    ASSERT(tiling.tileNum % GetBlockNum() == 0 && "tile num must be divisible by block num!");
    uint32_t tileNumPerCore = tiling.tileNum / GetBlockNum(); // 本核分得的 tile 数

    // 实例化 KernelCosh，完成初始化后执行主处理流程
    KernelCosh op;
    op.Init(x, y, tiling.totalLength, tileNumPerCore);
    op.Process();
}

// kernel_cosh：Host 侧封装（kernel 直调）
// 完整流程：ACL 初始化 → 申请 GM 内存 → 数据 H2D 搬运 → 启动 kernel → 结果 D2H 回拷 → 资源释放
// 参数：x —— 输入数据（Host 内存）；返回值：kernel 计算结果（Host 内存）
std::vector<float> kernel_cosh(std::vector<float> &x)
{
    // 1. 初始化 ACL 运行时环境：指定设备并创建同步流
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    // 2. 准备 tiling 参数：总元素数与 tile 总数
    uint32_t totalLength = static_cast<uint32_t>(x.size());
    size_t byteSize = totalLength * sizeof(float);
    CoshCustomTilingData tiling;
    tiling.totalLength = totalLength;
    tiling.tileNum = totalLength / TILE_LENGTH;

    // 3. 申请 GM 内存，并将输入数据从 Host 搬运到 Device（H2D）
    void *xDevice = nullptr;
    void *yDevice = nullptr;
    aclrtMalloc((void **)&xDevice, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&yDevice, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(xDevice, byteSize, x.data(), byteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    // 4. 使用内核调用符 <<<>>> 启动 kernel（8 核并行），并同步流等待执行完成；
    //    GM_ADDR 强转将 void* 转换为 kernel 形参所需的 __gm__ uint8_t* 类型
    constexpr uint32_t BLOCK_NUM = 8;
    cosh_custom<<<BLOCK_NUM, nullptr, stream>>>((GM_ADDR)xDevice, (GM_ADDR)yDevice, tiling);
    aclrtSynchronizeStream(stream);

    // 5. 将计算结果从 Device 回拷到 Host（D2H）
    std::vector<float> y(totalLength, 0.0f);
    aclrtMemcpy(y.data(), byteSize, yDevice, byteSize, ACL_MEMCPY_DEVICE_TO_HOST);

    // 6. 释放 GM 内存与运行时资源，按申请的逆序成对释放
    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return y;
}

// VerifyResult：逐元素比对实际输出与金标准结果，并打印前 20 个元素
// 返回 0 表示精度验证通过，1 表示失败
uint32_t VerifyResult(std::vector<float> &output, std::vector<float> &golden)
{
    // 打印 tensor 的前 maxPrintSize 个元素，超出部分以 "..." 省略
    auto printTensor = [](std::vector<float> &tensor, const char *name) {
        constexpr size_t maxPrintSize = 20;
        std::cout << name << ": ";
        std::copy(tensor.begin(), tensor.begin() + std::min(tensor.size(), maxPrintSize),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > maxPrintSize) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    printTensor(output, "Output");
    printTensor(golden, "Golden");
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "[Success] Case accuracy is verification passed." << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy is verification failed!" << std::endl;
        return 1;
    }
}

// main：测试入口
// 构造 16384 个 5.5f 的输入，调用 kernel_cosh 完成端到端执行，
// 再与 CPU 侧 std::cosh 金标准比对验证精度
int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048; // 输入总元素个数
    constexpr float valueX = 5.5f;             // 输入数据统一取值
    std::vector<float> x(totalLength, valueX);

    // 调用 kernel_cosh：内存申请 → H2D → kernel 执行 → D2H，返回计算结果
    std::vector<float> output = kernel_cosh(x);

    // 用 CPU 侧 std::cosh 生成金标准，验证 kernel 计算精度
    std::vector<float> golden(totalLength, std::cosh(valueX));
    return VerifyResult(output, golden);
}
