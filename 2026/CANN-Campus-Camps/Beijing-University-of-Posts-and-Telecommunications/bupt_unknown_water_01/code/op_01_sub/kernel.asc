#include <cmath>
#include "kernel_operator.h"

// ---------------------------------------------------------------------------
// Tiling 参数
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint32_t totalLength;
    uint32_t tileNum;
};

// ---------------------------------------------------------------------------
// 对于本题 8×2048 的小规模 Vector 算子，单 Tile 一次完成。
// 不再为了 double buffer 把一个 block 拆成两个小块。
// ---------------------------------------------------------------------------
constexpr uint32_t BUFFER_NUM = 1;
constexpr uint32_t QUEUE_DEPTH = 1;


// ---------------------------------------------------------------------------
// KernelSub：z = x - y
// ---------------------------------------------------------------------------
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        const SubCustomTilingData& tiling)
    {
        uint32_t totalLength = tiling.totalLength;
        uint32_t tileNum = tiling.tileNum;

        // 当前 Core 负责的数据量
        this->blockLength =
            totalLength / AscendC::GetBlockNum();

        this->tileNum = tileNum;

        // 本版本：
        //
        // totalLength = 16384
        // blockNum    = 8
        // blockLength = 2048
        // tileNum     = 1
        // BUFFER_NUM  = 1
        //
        // tileLength  = 2048
        //
        // 即每个 Core 一次性处理全部 2048 个元素。
        this->tileLength =
            this->blockLength / tileNum / BUFFER_NUM;

        uint32_t blockOffset =
            this->blockLength * AscendC::GetBlockIdx();

        // 设置当前 Core 的 GM 区域
        xGm.SetGlobalBuffer(
            (__gm__ T*)x + blockOffset,
            this->blockLength);

        yGm.SetGlobalBuffer(
            (__gm__ T*)y + blockOffset,
            this->blockLength);

        zGm.SetGlobalBuffer(
            (__gm__ T*)z + blockOffset,
            this->blockLength);

        // 每个队列只需要一个 Buffer
        pipe.InitBuffer(
            inQueueX,
            BUFFER_NUM,
            this->tileLength * sizeof(T));

        pipe.InitBuffer(
            inQueueY,
            BUFFER_NUM,
            this->tileLength * sizeof(T));

        pipe.InitBuffer(
            outQueueZ,
            BUFFER_NUM,
            this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // tileNum = 1
        // BUFFER_NUM = 1
        //
        // 因此整个 Core 只执行一次：
        //
        // GM -> UB
        // UB -> Sub
        // UB -> GM
        int32_t loopCount =
            this->tileNum * BUFFER_NUM;

        for (int32_t i = 0; i < loopCount; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:

    // -----------------------------------------------------------------------
    // GM -> UB
    // -----------------------------------------------------------------------
    __aicore__ inline void CopyIn(int32_t progress)
    {
        AscendC::LocalTensor<T> xLocal =
            inQueueX.AllocTensor<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.AllocTensor<T>();

        uint32_t offset =
            progress * this->tileLength;

        AscendC::DataCopy(
            xLocal,
            xGm[offset],
            this->tileLength);

        AscendC::DataCopy(
            yLocal,
            yGm[offset],
            this->tileLength);

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }


    // -----------------------------------------------------------------------
    // Vector Sub
    // -----------------------------------------------------------------------
    __aicore__ inline void Compute(int32_t progress)
    {
        AscendC::LocalTensor<T> xLocal =
            inQueueX.DeQue<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.DeQue<T>();

        AscendC::LocalTensor<T> zLocal =
            outQueueZ.AllocTensor<T>();

        AscendC::Sub(
            zLocal,
            xLocal,
            yLocal,
            this->tileLength);

        outQueueZ.EnQue<T>(zLocal);

        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }


    // -----------------------------------------------------------------------
    // UB -> GM
    // -----------------------------------------------------------------------
    __aicore__ inline void CopyOut(int32_t progress)
    {
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.DeQue<T>();

        uint32_t offset =
            progress * this->tileLength;

        AscendC::DataCopy(
            zGm[offset],
            zLocal,
            this->tileLength);

        outQueueZ.FreeTensor(zLocal);
    }


private:
    AscendC::TPipe pipe;

    AscendC::TQue<
        AscendC::QuePosition::VECIN,
        QUEUE_DEPTH> inQueueX, inQueueY;

    AscendC::TQue<
        AscendC::QuePosition::VECOUT,
        QUEUE_DEPTH> outQueueZ;

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    uint32_t blockLength;
    uint32_t tileNum;
    uint32_t tileLength;
};


// ---------------------------------------------------------------------------
// Kernel Entry
// ---------------------------------------------------------------------------
template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    KernelSub<T> op;

    op.Init(x, y, z, tiling);
    op.Process();
}


// ---------------------------------------------------------------------------
// Host
// ---------------------------------------------------------------------------
extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    // 本题固定输入为 [8, 2048]。
    //
    // 8 个 Core 正好对应 8 个 block：
    //
    // 16384 / 8 = 2048 elements / Core
    constexpr uint32_t blockDim = 8;

    // 获取 Tensor 信息
    const TensorInfo& t0 = info_x.tensors[0];

    // 计算总元素数量
    int64_t totalLength = 1;

    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }

    // dtype：
    // 0 = float32
    // 1 = float16
    int32_t dtype = t0.dtype;

    // ---------------------------------------------------------------
    // 核心优化
    //
    // 原：
    // tileNum = 1
    // BUFFER_NUM = 2
    //
    // 每 Core：
    // 1024 + 1024
    //
    // 现在：
    // tileNum = 1
    // BUFFER_NUM = 1
    //
    // 每 Core：
    // 2048 一次完成
    // ---------------------------------------------------------------
    constexpr uint32_t tileNum = 1;

    SubCustomTilingData tiling = {
        static_cast<uint32_t>(totalLength),
        tileNum
    };

    if (dtype == 1) {

        sub_custom<half>
            <<<blockDim, nullptr, stream>>>(
                x,
                y,
                z,
                tiling);

    } else {

        sub_custom<float>
            <<<blockDim, nullptr, stream>>>(
                x,
                y,
                z,
                tiling);
    }
}