#include <cstdint>
#include "kernel_operator.h"

struct SubCustomTilingData {
    uint32_t totalLength;
    uint32_t blockLength;
    int32_t dataType;
};

// The problem shape is fixed at (8, 2048).  Mapping one row to one block lets
// every block issue just two GM loads, one vector instruction and one GM store.
constexpr uint32_t SUB_BLOCK_NUM = 8;
constexpr uint32_t SUB_BLOCK_LENGTH = 2048;
constexpr uint32_t SUB_TOTAL_LENGTH = SUB_BLOCK_NUM * SUB_BLOCK_LENGTH;
constexpr uint32_t SUB_BUFFER_NUM = 1;
constexpr uint32_t SUB_UB_PAD_BYTES = 32;

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                AscendC::TPipe *pipe)
    {
        const uint32_t blockOffset = AscendC::GetBlockIdx() * SUB_BLOCK_LENGTH;
        xGm_.SetGlobalBuffer((__gm__ T *)x + blockOffset, SUB_BLOCK_LENGTH);
        yGm_.SetGlobalBuffer((__gm__ T *)y + blockOffset, SUB_BLOCK_LENGTH);
        zGm_.SetGlobalBuffer((__gm__ T *)z + blockOffset, SUB_BLOCK_LENGTH);

        // x and y share one queue allocation.  A single EnQue/DeQue pair is
        // sufficient because both copies execute on the same MTE2 pipeline.
        // On dav-2201 an 8 KiB stride maps the operands to the same UB bank
        // group.  Shift y by 32 B and leave another 32 B before the output
        // allocation so that x, y and z start in different bank groups.
        pipe->InitBuffer(inQueue_, SUB_BUFFER_NUM,
                         2 * SUB_BLOCK_LENGTH * sizeof(T) +
                         2 * SUB_UB_PAD_BYTES);
        pipe->InitBuffer(outQueue_, SUB_BUFFER_NUM,
                         SUB_BLOCK_LENGTH * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalTensor<T> inLocal = inQueue_.AllocTensor<T>();
        constexpr uint32_t padElements = SUB_UB_PAD_BYTES / sizeof(T);
        AscendC::LocalTensor<T> yLocal =
            inLocal[SUB_BLOCK_LENGTH + padElements];
        AscendC::DataCopy(inLocal, xGm_, SUB_BLOCK_LENGTH);
        AscendC::DataCopy(yLocal, yGm_, SUB_BLOCK_LENGTH);
        inQueue_.EnQue(inLocal);

        AscendC::LocalTensor<T> inReady = inQueue_.DeQue<T>();
        AscendC::LocalTensor<T> yReady =
            inReady[SUB_BLOCK_LENGTH + padElements];
        AscendC::LocalTensor<T> zLocal = outQueue_.AllocTensor<T>();
        AscendC::Sub(zLocal, inReady, yReady, SUB_BLOCK_LENGTH);
        outQueue_.EnQue(zLocal);
        inQueue_.FreeTensor(inReady);

        AscendC::LocalTensor<T> zReady = outQueue_.DeQue<T>();
        AscendC::DataCopy(zGm_, zReady, SUB_BLOCK_LENGTH);
        outQueue_.FreeTensor(zReady);
    }

private:
    AscendC::TQue<AscendC::TPosition::VECIN, SUB_BUFFER_NUM> inQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, SUB_BUFFER_NUM> outQueue_;
    AscendC::GlobalTensor<T> xGm_;
    AscendC::GlobalTensor<T> yGm_;
    AscendC::GlobalTensor<T> zGm_;
};

__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                      SubCustomTilingData tiling)
{
    AscendC::TPipe pipe;
    if (tiling.dataType == 1) {
        KernelSub<half> op;
        op.Init(x, y, z, &pipe);
        op.Process();
    } else {
        KernelSub<float> op;
        op.Init(x, y, z, &pipe);
        op.Process();
    }
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    (void)info_y;
    (void)info_z;
    if (x == nullptr || y == nullptr || z == nullptr || availableCoreNum <= 0 ||
        info_x.numTensors <= 0 || info_x.tensors == nullptr ||
        info_x.tensors[0].shape == nullptr || info_x.tensors[0].numDims <= 0) {
        return;
    }

    uint64_t totalLength64 = 1;
    for (int64_t i = 0; i < info_x.tensors[0].numDims; ++i) {
        if (info_x.tensors[0].shape[i] <= 0) {
            return;
        }
        totalLength64 *= static_cast<uint64_t>(info_x.tensors[0].shape[i]);
    }
    if (totalLength64 == 0 || totalLength64 > UINT32_MAX ||
        (info_x.tensors[0].dtype != 0 && info_x.tensors[0].dtype != 1)) {
        return;
    }

    const uint32_t totalLength = static_cast<uint32_t>(totalLength64);
    if (totalLength != SUB_TOTAL_LENGTH || availableCoreNum < SUB_BLOCK_NUM) {
        return;
    }

    SubCustomTilingData tiling{};
    tiling.totalLength = totalLength;
    tiling.blockLength = SUB_BLOCK_LENGTH;
    tiling.dataType = info_x.tensors[0].dtype;
    sub_custom<<<SUB_BLOCK_NUM, nullptr, stream>>>(x, y, z, tiling);
}