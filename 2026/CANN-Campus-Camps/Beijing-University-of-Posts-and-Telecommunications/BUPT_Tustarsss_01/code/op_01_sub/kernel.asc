#include <cmath>
#include "kernel_operator.h"
struct SubCustomTilingData {
    uint32_t totalLength;
    uint32_t tileNum;
};
constexpr uint32_t SUB_BUFFER_NUM = 2;
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling)
    {
        blockLength_ = tiling.totalLength / AscendC::GetBlockNum();
        tileNum_ = tiling.tileNum;
        tileLength_ = blockLength_ / tileNum_ / SUB_BUFFER_NUM;
        const uint32_t offset = blockLength_ * AscendC::GetBlockIdx();
        xGm_.SetGlobalBuffer((__gm__ T*)x + offset, blockLength_);
        yGm_.SetGlobalBuffer((__gm__ T*)y + offset, blockLength_);
        zGm_.SetGlobalBuffer((__gm__ T*)z + offset, blockLength_);
        pipe_.InitBuffer(xQueue_, SUB_BUFFER_NUM, tileLength_ * sizeof(T));
        pipe_.InitBuffer(yQueue_, SUB_BUFFER_NUM, tileLength_ * sizeof(T));
        pipe_.InitBuffer(zQueue_, SUB_BUFFER_NUM, tileLength_ * sizeof(T));
    }
    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < tileNum_ * SUB_BUFFER_NUM; ++i) {
            CopyIn(i);
            Compute();
            CopyOut(i);
        }
    }
private:
    __aicore__ inline void CopyIn(uint32_t progress)
    {
        AscendC::LocalTensor<T> xLocal = xQueue_.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = yQueue_.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm_[progress * tileLength_], tileLength_);
        AscendC::DataCopy(yLocal, yGm_[progress * tileLength_], tileLength_);
        xQueue_.EnQue(xLocal);
        yQueue_.EnQue(yLocal);
    }
    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> xLocal = xQueue_.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = yQueue_.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = zQueue_.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, tileLength_);
        zQueue_.EnQue(zLocal);
        xQueue_.FreeTensor(xLocal);
        yQueue_.FreeTensor(yLocal);
    }
    __aicore__ inline void CopyOut(uint32_t progress)
    {
        AscendC::LocalTensor<T> zLocal = zQueue_.DeQue<T>();
        AscendC::DataCopy(zGm_[progress * tileLength_], zLocal, tileLength_);
        zQueue_.FreeTensor(zLocal);
    }
private:
    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::QuePosition::VECIN, SUB_BUFFER_NUM> xQueue_;
    AscendC::TQue<AscendC::QuePosition::VECIN, SUB_BUFFER_NUM> yQueue_;
    AscendC::TQue<AscendC::QuePosition::VECOUT, SUB_BUFFER_NUM> zQueue_;
    AscendC::GlobalTensor<T> xGm_, yGm_, zGm_;
    uint32_t blockLength_ = 0;
    uint32_t tileNum_ = 0;
    uint32_t tileLength_ = 0;
};
template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y,
                           const TensorGroupInfo& info_y, GM_ADDR z,
                           const TensorGroupInfo& info_z, int64_t availableCoreNum,
                           aclrtStream stream)
{
    (void)info_y;
    (void)info_z;
    const TensorInfo& input = info_x.tensors[0];
    int64_t elementCount = 1;
    for (int64_t i = 0; i < input.numDims; ++i) {
        elementCount *= input.shape[i];
    }
    constexpr uint32_t preferredBlockDim = 8;
    const uint32_t blockDim = static_cast<uint32_t>(availableCoreNum < preferredBlockDim ?
        availableCoreNum : preferredBlockDim);
    if (blockDim == 0) {
        return;
    }
    SubCustomTilingData tiling = {static_cast<uint32_t>(elementCount), 8};
    if (input.dtype == 1) {
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}
