#include <cstdint>
#include "kernel_operator.h"

// TensorInfo / TensorGroupInfo 沿用赛题框架提供的定义。
// 前提：x/y/z 为同 shape、同 dtype 的连续张量，每组使用 tensors[0]。
// dtype 编号沿用原代码：0 = FP32，1 = FP16。
// 非对齐尾部需要目标芯片/CANN 支持 DataCopyPad 的 Ext 参数接口。

struct SubCustomTilingData {
    uint64_t totalLength; // 总元素数
    uint64_t blockLength; // 单核分配跨度，按 32 字节向上对齐
    uint32_t tileLength;  // 单次处理的最大元素数
};

constexpr uint32_t BUFFER_NUM = 2;
constexpr uint32_t QUEUE_DEPTH = 1;
constexpr uint32_t TILE_BYTES = 8 * 1024; // 每个 buffer 最多 8 KiB
constexpr uint32_t MAX_CORE_NUM = 8;     // 保留原来的 8 核上限

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                               const SubCustomTilingData& tiling)
    {
        const uint64_t offset = tiling.blockLength * AscendC::GetBlockIdx();
        this->blockLength = 0;
        this->tileLength = tiling.tileLength;
        if (offset >= tiling.totalLength) {
            return;
        }

        // 最后一个核只处理实际剩余元素，不把 GM 长度向上补齐。
        const uint64_t remaining = tiling.totalLength - offset;
        this->blockLength = remaining < tiling.blockLength ? remaining : tiling.blockLength;
        xGm.SetGlobalBuffer((__gm__ T*)x + offset, this->blockLength);
        yGm.SetGlobalBuffer((__gm__ T*)y + offset, this->blockLength);
        zGm.SetGlobalBuffer((__gm__ T*)z + offset, this->blockLength);

        // 三个队列、每队列两个 buffer，合计最多 48 KiB UB。
        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // 不再固定循环 16 次。尾轮的 count 是实际有效元素数。
        for (uint64_t offset = 0; offset < this->blockLength; offset += this->tileLength) {
            const uint64_t remaining = this->blockLength - offset;
            const uint32_t count = remaining < this->tileLength
                ? static_cast<uint32_t>(remaining) : this->tileLength;
            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
        }
    }

private:
    __aicore__ inline void CopyIn(uint64_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        const uint32_t bytes = count * sizeof(T);
        if (bytes % 32 == 0) {
            AscendC::DataCopy(xLocal, xGm[offset], count);
            AscendC::DataCopy(yLocal, yGm[offset], count);
        } else {
            // blockLen 单位为字节；只读取 GM 中实际存在的数据。
            AscendC::DataCopyExtParams copyParams{1, bytes, 0, 0, 0};
            AscendC::DataCopyPadExtParams<T> padParams{true, 0, 0, static_cast<T>(0)};
            AscendC::DataCopyPad(xLocal, xGm[offset], copyParams, padParams);
            AscendC::DataCopyPad(yLocal, yGm[offset], copyParams, padParams);
        }
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, count);
        outQueueZ.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint64_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        const uint32_t bytes = count * sizeof(T);
        if (bytes % 32 == 0) {
            AscendC::DataCopy(zGm[offset], zLocal, count);
        } else {
            // 只写 count 个有效元素，避免覆盖下一段或越过输出末尾。
            AscendC::DataCopyExtParams copyParams{1, bytes, 0, 0, 0};
            AscendC::DataCopyPad(zGm[offset], zLocal, copyParams);
        }
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueX, inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH> outQueueZ;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;
    uint64_t blockLength;
    uint32_t tileLength;
};

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                    SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    const TensorInfo& t0 = info_x.tensors[0];
    const int32_t dtype = t0.dtype;
    if (availableCoreNum <= 0 || (dtype != 0 && dtype != 1)) {
        return;
    }
    // 沿用赛题前提：输入输出 shape、dtype 一致。
    const uint32_t elementSize = dtype == 1 ? sizeof(half) : sizeof(float);
    const uint64_t maxLength = static_cast<uint64_t>(INT64_MAX) / elementSize;
    uint64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        if (t0.shape[i] <= 0) {
            return;
        }
        const uint64_t dim = static_cast<uint64_t>(t0.shape[i]);
        if (totalLength > maxLength / dim) {
            return;
        }
        totalLength *= dim;
    }

    const uint32_t alignNum = 32 / elementSize;
    const uint32_t maxTileLength = TILE_BYTES / elementSize;
    uint32_t blockDim = availableCoreNum < MAX_CORE_NUM
        ? static_cast<uint32_t>(availableCoreNum) : MAX_CORE_NUM;

    // 小输入减少核数；约按每核至少一份 tile 的工作量选择核数。
    const uint64_t usefulCores = (totalLength + maxTileLength - 1) / maxTileLength;
    if (usefulCores < blockDim) {
        blockDim = static_cast<uint32_t>(usefulCores);
    }
    const uint64_t perCore = (totalLength + blockDim - 1) / blockDim;
    const uint64_t blockLength = (perCore + alignNum - 1) / alignNum * alignNum;
    const uint32_t tileLength = blockLength < maxTileLength
        ? static_cast<uint32_t>(blockLength) : maxTileLength;
    SubCustomTilingData tiling{totalLength, blockLength, tileLength};

    if (dtype == 1) {
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}
