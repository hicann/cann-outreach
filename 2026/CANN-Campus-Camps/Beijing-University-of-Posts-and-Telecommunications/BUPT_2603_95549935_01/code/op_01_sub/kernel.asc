#include <cmath>
#include "kernel_operator.h"

struct SubCustomTilingData {
    uint32_t totalLen;
    uint32_t tileNum;
};

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling) {
        uint32_t totalLen = tiling.totalLen;
        this->blockLen = totalLen / AscendC::GetBlockNum();
        this->tileLen = this->blockLen;

        xGm.SetGlobalBuffer((__gm__ T *)x + this->blockLen * AscendC::GetBlockIdx(), this->blockLen);
        yGm.SetGlobalBuffer((__gm__ T *)y + this->blockLen * AscendC::GetBlockIdx(), this->blockLen);
        zGm.SetGlobalBuffer((__gm__ T *)z + this->blockLen * AscendC::GetBlockIdx(), this->blockLen);

        pipe.InitBuffer(xQue, 1, this->tileLen * sizeof(T));
        pipe.InitBuffer(yQue, 1, this->tileLen * sizeof(T));
        pipe.InitBuffer(zQue, 1, this->tileLen * sizeof(T));
    }

    __aicore__ inline void Process() {
        AscendC::LocalTensor<T> xLocal = xQue.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = yQue.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm[0], this->tileLen);
        AscendC::DataCopy(yLocal, yGm[0], this->tileLen);
        xQue.EnQue(xLocal);
        yQue.EnQue(yLocal);

        AscendC::LocalTensor<T> xCalc = xQue.DeQue<T>();
        AscendC::LocalTensor<T> yCalc = yQue.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = zQue.AllocTensor<T>();
        AscendC::Sub(zLocal, xCalc, yCalc, this->tileLen);
        zQue.EnQue(zLocal);
        xQue.FreeTensor(xCalc);
        yQue.FreeTensor(yCalc);

        AscendC::LocalTensor<T> zAns = zQue.DeQue<T>();
        AscendC::DataCopy(zGm[0], zAns, this->tileLen);
        zQue.FreeTensor(zAns);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> xQue, yQue;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> zQue;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;
    uint32_t blockLen;
    uint32_t tileLen;
};

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling) {
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    constexpr uint32_t blockNum = 8;
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLen = 1;
    for (int32_t i = 0; i < t0.numDims; i++) {
        totalLen *= t0.shape[i];
    }

    SubCustomTilingData tiling = {(uint32_t)totalLen, 1};
    if (t0.dtype == 1) {
        sub_custom<half><<<blockNum, nullptr, stream>>>(x, y, z, tiling);
    } else {
        sub_custom<float><<<blockNum, nullptr, stream>>>(x, y, z, tiling);
    }
}