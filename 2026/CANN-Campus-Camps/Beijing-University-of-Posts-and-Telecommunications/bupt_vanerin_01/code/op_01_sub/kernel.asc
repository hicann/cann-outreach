#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation (裸UB + 显式同步)
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16
 *
 * 性能设计:
 *   1. 裸 UB + 显式同步: TBuf 直接取 UB 地址 + SetFlag/WaitFlag, 跳过 TQue 队列簿记
 *   2. 两次 MTE2 等待合并为一次: 两条 DataCopy 搬入后只等一次 MTE2_V 事件
 *   3. 原地 Sub: 结果写回 x 的 UB 缓冲, 省掉独立输出缓冲(省 1/3 UB)
 *   4. 单遍搬入-计算-搬出: 每核数据量 <= 几 KB, 远小于 UB 192KB, 无需分 tile
 *   5. 多核切分: 每核至少 4KB, blockFormer 按 512 元素对齐, 连续分块
 */

// 多核切分参数
constexpr int64_t TARGET_CORE_NUM = 4;  // 固定 8 核(fp32/fp16 均适用)
constexpr int64_t ELEM_ALIGN = 512;     // 多核切分元素对齐

struct SubCustomTilingData {
    int64_t dim0;         // 元素总数
    int64_t blockNum;     // 启动核数
    int64_t blockFormer;  // 非尾核元素数(512 对齐)
};

static inline int64_t SubCeilDiv(int64_t a, int64_t b) { return (a + b - 1) / b; }
static inline int64_t SubAlignUp(int64_t v, int64_t align) { return SubCeilDiv(v, align) * align; }

static SubCustomTilingData ComputeSubTiling(int64_t dim0, int64_t elemBytes, int64_t availableCoreNum)
{
    SubCustomTilingData tiling;
    tiling.dim0 = dim0;

    int64_t coreNum = TARGET_CORE_NUM;
    if (availableCoreNum > 0 && coreNum > availableCoreNum) {
        coreNum = availableCoreNum;
    }
    tiling.blockFormer = SubAlignUp(SubCeilDiv(dim0, coreNum), ELEM_ALIGN);
    tiling.blockNum = SubCeilDiv(dim0, tiling.blockFormer);
    return tiling;
}

// 核函数主体: 每核单遍裸UB + 显式同步
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling)
    {
        const int64_t blockIdx = AscendC::GetBlockIdx();
        const bool isTailBlock = (blockIdx == tiling.blockNum - 1);

        const int64_t blockOffset = blockIdx * tiling.blockFormer;
        const int64_t blockLen = isTailBlock ? (tiling.dim0 - blockOffset) : tiling.blockFormer;
        this->blockLength_ = static_cast<uint32_t>(blockLen);

        xGm_.SetGlobalBuffer((__gm__ T*)x + blockOffset, blockLen);
        yGm_.SetGlobalBuffer((__gm__ T*)y + blockOffset, blockLen);
        zGm_.SetGlobalBuffer((__gm__ T*)z + blockOffset, blockLen);

        // 只分配 x 和 y 的 UB 缓冲; z 结果原地写回 xLocal, 无需独立输出缓冲
        pipe_.InitBuffer(bufX_, this->blockLength_ * sizeof(T));
        pipe_.InitBuffer(bufY_, this->blockLength_ * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        if (this->blockLength_ == 0) {
            return;
        }
        AscendC::LocalTensor<T> xLocal = bufX_.Get<T>();
        AscendC::LocalTensor<T> yLocal = bufY_.Get<T>();

        // 搬入: 两条 GM->UB 异步发射
        AscendC::DataCopy(xLocal, xGm_, this->blockLength_);
        AscendC::DataCopy(yLocal, yGm_, this->blockLength_);

        // 等搬入全部完成(合并为一次 MTE2 事件等待)
        int32_t evtMte2 = static_cast<int32_t>(GetTPipePtr()->FetchEventID(AscendC::HardEvent::MTE2_V));
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(evtMte2);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(evtMte2);

        // 计算: z = x - y, 结果原地写回 xLocal(逐元素读-算-写, 同地址安全)
        AscendC::Sub(xLocal, xLocal, yLocal, this->blockLength_);

        // 等计算完成后再搬出
        int32_t evtV = static_cast<int32_t>(GetTPipePtr()->FetchEventID(AscendC::HardEvent::V_MTE3));
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(evtV);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(evtV);

        // 搬出: UB -> GM
        AscendC::DataCopy(zGm_, xLocal, this->blockLength_);
    }

private:
    AscendC::TPipe pipe_;
    AscendC::TBuf<AscendC::TPosition::VECIN> bufX_, bufY_;
    AscendC::GlobalTensor<T> xGm_, yGm_, zGm_;
    uint32_t blockLength_;
};

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    const TensorInfo& tensorX = info_x.tensors[0];
    int64_t dim0 = 1;
    for (int64_t i = 0; i < tensorX.numDims; ++i) {
        dim0 *= tensorX.shape[i];
    }
    if (dim0 <= 0) {
        return;
    }

    if (tensorX.dtype == 1) {
        SubCustomTilingData tiling = ComputeSubTiling(dim0, static_cast<int64_t>(sizeof(half)), availableCoreNum);
        sub_custom<half><<<static_cast<uint32_t>(tiling.blockNum), nullptr, stream>>>(x, y, z, tiling);
    } else {
        SubCustomTilingData tiling = ComputeSubTiling(dim0, static_cast<int64_t>(sizeof(float)), availableCoreNum);
        sub_custom<float><<<static_cast<uint32_t>(tiling.blockNum), nullptr, stream>>>(x, y, z, tiling);
    }
}