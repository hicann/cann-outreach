#include "kernel_operator.h"

constexpr uint32_t BLOCK_NUM = 8;
constexpr uint32_t BLOCK_LENGTH = 2048;

struct SubCustomTilingData {
    uint32_t dtype;
};


template <typename T>
__aicore__ inline void SubBody(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z)
{
    constexpr uint32_t BYTE_LENGTH =
        BLOCK_LENGTH * sizeof(T);

    // DataCopyParams 的 blockLen 单位是 32B
    constexpr uint16_t COPY_BLOCK_LEN =
        BYTE_LENGTH / 32;

    // 每次 Vector repeat = 256B
    constexpr uint64_t VECTOR_MASK =
        sizeof(T) == 4 ? 64 : 128;

    constexpr uint8_t REPEAT_TIMES =
        BLOCK_LENGTH / (256 / sizeof(T));

    uint32_t offset =
        AscendC::GetBlockIdx() * BLOCK_LENGTH;

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    xGm.SetGlobalBuffer(
        (__gm__ T*)x + offset,
        BLOCK_LENGTH);

    yGm.SetGlobalBuffer(
        (__gm__ T*)y + offset,
        BLOCK_LENGTH);

    zGm.SetGlobalBuffer(
        (__gm__ T*)z + offset,
        BLOCK_LENGTH);


    // ========================================================
    // Static UB layout
    //
    // [ x ][ y ][ z ]
    // ========================================================

    constexpr uint32_t X_ADDR = 0;
    constexpr uint32_t Y_ADDR = BYTE_LENGTH;
    constexpr uint32_t Z_ADDR = BYTE_LENGTH * 2;

    AscendC::LocalTensor<T> xLocal(
        AscendC::TPosition::VECIN,
        X_ADDR,
        BLOCK_LENGTH);

    AscendC::LocalTensor<T> yLocal(
        AscendC::TPosition::VECIN,
        Y_ADDR,
        BLOCK_LENGTH);

    AscendC::LocalTensor<T> zLocal(
        AscendC::TPosition::VECOUT,
        Z_ADDR,
        BLOCK_LENGTH);


    // ========================================================
    // 显式 DataCopy 参数
    //
    // blockCount = 1
    // blockLen   = 整块连续数据
    //
    // 不再让 count API 计算搬运参数。
    // ========================================================

    AscendC::DataCopyParams copyParams {
        1,
        COPY_BLOCK_LEN,
        0,
        0
    };


    // =========================
    // MTE2
    // =========================

    AscendC::DataCopy(
        xLocal,
        xGm,
        copyParams);

    AscendC::DataCopy(
        yLocal,
        yGm,
        copyParams);


    AscendC::SetFlag<
        AscendC::HardEvent::MTE2_V>(0);

    AscendC::WaitFlag<
        AscendC::HardEvent::MTE2_V>(0);


    // ========================================================
    // Vector
    //
    // 不再：
    //
    // Sub(..., BLOCK_LENGTH)
    //
    // 直接明确告诉硬件：
    //
    // fp32:
    //     mask = 64
    //     repeats = 32
    //
    // fp16:
    //     mask = 128
    //     repeats = 16
    //
    // ========================================================

    AscendC::BinaryRepeatParams repeatParams {
        1, 1, 1,
        8, 8, 8
    };

    AscendC::Sub<T>(
        zLocal,
        xLocal,
        yLocal,
        VECTOR_MASK,
        REPEAT_TIMES,
        repeatParams);


    AscendC::SetFlag<
        AscendC::HardEvent::V_MTE3>(0);

    AscendC::WaitFlag<
        AscendC::HardEvent::V_MTE3>(0);


    // =========================
    // MTE3
    // =========================

    AscendC::DataCopy(
        zGm,
        zLocal,
        copyParams);
}


__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    AscendC::InitSocState();

    if (tiling.dtype == 0) {
        SubBody<float>(x, y, z);
    } else {
        SubBody<half>(x, y, z);
    }
}


extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,

    GM_ADDR y,
    const TensorGroupInfo& info_y,

    GM_ADDR z,
    const TensorGroupInfo& info_z,

    int64_t availableCoreNum,
    aclrtStream stream)
{
    SubCustomTilingData tiling {
        static_cast<uint32_t>(
            info_x.tensors[0].dtype)
    };

    sub_custom<<<BLOCK_NUM, nullptr, stream>>>(
        x,
        y,
        z,
        tiling);
}