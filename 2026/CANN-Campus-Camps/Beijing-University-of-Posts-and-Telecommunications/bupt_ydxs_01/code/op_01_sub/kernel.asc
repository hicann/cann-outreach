#include <cmath>
#include "kernel_operator.h"

// ===========================================================================
// Tiling 参数
// ===========================================================================
struct SubCustomTilingData {
    uint32_t totalLength;   // Tensor 总元素数量
    uint32_t tileNum;       // 每个 Core 的逻辑 Tile 数量
};

// ===========================================================================
// 性能参数
// ===========================================================================

// 双 Buffer
constexpr uint32_t BUFFER_NUM = 2;

// Queue 深度使用 2
constexpr uint32_t QUEUE_DEPTH = 2;

// ===========================================================================
// KernelSub
//
// 功能：
//     z = x - y
//
// 性能优化：
//     1. 减少 Tile 数量
//     2. 增大单次 Vector 计算长度
//     3. 保留 Double Buffer
//     4. 减少 Queue 操作次数
//     5. 保持多 Core 并行
// ===========================================================================
template <typename T>
class KernelSub {
public:

    __aicore__ inline KernelSub()
    {
    }

    // -----------------------------------------------------------------------
    // Init
    // -----------------------------------------------------------------------
    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        const SubCustomTilingData& tiling)
    {
        // -------------------------------------------------------------------
        // 获取 Tiling 参数
        // -------------------------------------------------------------------
        uint32_t totalLength = tiling.totalLength;
        uint32_t tileNum = tiling.tileNum;

        // -------------------------------------------------------------------
        // 获取当前 Core 信息
        // -------------------------------------------------------------------
        uint32_t blockIdx =
            AscendC::GetBlockIdx();

        uint32_t blockNum =
            AscendC::GetBlockNum();

        // -------------------------------------------------------------------
        // 当前 Core 处理的数据长度
        //
        // 保持和原始 Add/Sub 模板一致
        // -------------------------------------------------------------------
        this->blockLength =
            totalLength / blockNum;

        // -------------------------------------------------------------------
        // 保存 Tile 数量
        // -------------------------------------------------------------------
        this->tileNum = tileNum;

        // -------------------------------------------------------------------
        // 每个 Tile 的元素数量
        //
        // 这里采用：
        //
        // blockLength
        // -------------------------------
        // tileNum * BUFFER_NUM
        //
        // 当前 tileNum = 1
        // BUFFER_NUM = 2
        //
        // 即每个 Core 分成两个较大的 Tile。
        // -------------------------------------------------------------------
        this->tileLength =
            this->blockLength /
            this->tileNum /
            BUFFER_NUM;

        // -------------------------------------------------------------------
        // 设置 Global Memory
        // -------------------------------------------------------------------

        xGm.SetGlobalBuffer(
            (__gm__ T*)x +
            blockIdx * this->blockLength,
            this->blockLength);

        yGm.SetGlobalBuffer(
            (__gm__ T*)y +
            blockIdx * this->blockLength,
            this->blockLength);

        zGm.SetGlobalBuffer(
            (__gm__ T*)z +
            blockIdx * this->blockLength,
            this->blockLength);

        // -------------------------------------------------------------------
        // 初始化 Queue
        //
        // 每个 Queue 可以容纳两个 Buffer。
        // -------------------------------------------------------------------

        pipe.InitBuffer(
            inQueueX,
            BUFFER_NUM,
            this->tileLength * sizeof(T));

        pipe.InitBuffer(
            inQueueY,
            BUFFER_NUM,
            this->tileLength * sizeof(T));

        pipe.InitBuffer(
            outQueueZ,
            BUFFER_NUM,
            this->tileLength * sizeof(T));
    }

    // -----------------------------------------------------------------------
    // Process
    // -----------------------------------------------------------------------
    __aicore__ inline void Process()
    {
        // -------------------------------------------------------------------
        // 总处理 Tile 数
        //
        // tileNum = 1
        // BUFFER_NUM = 2
        //
        // loopCount = 2
        // -------------------------------------------------------------------
        int32_t loopCount =
            this->tileNum * BUFFER_NUM;

        // 没有数据直接返回
        if (loopCount <= 0 ||
            this->tileLength == 0) {
            return;
        }

        // -------------------------------------------------------------------
        // 第一个 Tile 预取
        // -------------------------------------------------------------------
        CopyIn(0);

        // -------------------------------------------------------------------
        // 主循环
        //
        // 处理：
        //
        //     Compute
        //     CopyIn next
        //     CopyOut
        //
        // 减少数据搬运与计算之间的空闲。
        // -------------------------------------------------------------------
        for (int32_t i = 0;
             i < loopCount - 1;
             i++)
        {
            // ---------------------------------------------------------------
            // 计算当前 Tile
            // ---------------------------------------------------------------
            Compute(i);

            // ---------------------------------------------------------------
            // 提前搬入下一个 Tile
            // ---------------------------------------------------------------
            CopyIn(i + 1);

            // ---------------------------------------------------------------
            // 输出当前 Tile
            // ---------------------------------------------------------------
            CopyOut(i);
        }

        // -------------------------------------------------------------------
        // 处理最后一个 Tile
        // -------------------------------------------------------------------
        Compute(loopCount - 1);

        CopyOut(loopCount - 1);
    }

private:

    // =======================================================================
    // CopyIn
    //
    // GM -> UB
    // =======================================================================
    __aicore__ inline void CopyIn(
        int32_t progress)
    {
        // -------------------------------------------------------------------
        // 申请 Local Tensor
        // -------------------------------------------------------------------
        AscendC::LocalTensor<T> xLocal =
            inQueueX.AllocTensor<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.AllocTensor<T>();

        // -------------------------------------------------------------------
        // 当前 Tile 起始位置
        // -------------------------------------------------------------------
        uint32_t offset =
            progress * this->tileLength;

        // -------------------------------------------------------------------
        // X：GM -> UB
        // -------------------------------------------------------------------
        AscendC::DataCopy(
            xLocal,
            xGm[offset],
            this->tileLength);

        // -------------------------------------------------------------------
        // Y：GM -> UB
        // -------------------------------------------------------------------
        AscendC::DataCopy(
            yLocal,
            yGm[offset],
            this->tileLength);

        // -------------------------------------------------------------------
        // 放入 Queue
        // -------------------------------------------------------------------
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    // =======================================================================
    // Compute
    //
    // z = x - y
    // =======================================================================
    __aicore__ inline void Compute(
        int32_t progress)
    {
        // -------------------------------------------------------------------
        // 获取输入
        // -------------------------------------------------------------------
        AscendC::LocalTensor<T> xLocal =
            inQueueX.DeQue<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.DeQue<T>();

        // -------------------------------------------------------------------
        // 申请输出 Tensor
        // -------------------------------------------------------------------
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.AllocTensor<T>();

        // -------------------------------------------------------------------
        // Vector Sub
        //
        // zLocal[i] = xLocal[i] - yLocal[i]
        // -------------------------------------------------------------------
        AscendC::Sub(
            zLocal,
            xLocal,
            yLocal,
            this->tileLength);

        // -------------------------------------------------------------------
        // 输出入队
        // -------------------------------------------------------------------
        outQueueZ.EnQue<T>(zLocal);

        // -------------------------------------------------------------------
        // 释放输入 Tensor
        // -------------------------------------------------------------------
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    // =======================================================================
    // CopyOut
    //
    // UB -> GM
    // =======================================================================
    __aicore__ inline void CopyOut(
        int32_t progress)
    {
        // -------------------------------------------------------------------
        // 获取结果
        // -------------------------------------------------------------------
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.DeQue<T>();

        // -------------------------------------------------------------------
        // 计算输出位置
        // -------------------------------------------------------------------
        uint32_t offset =
            progress * this->tileLength;

        // -------------------------------------------------------------------
        // UB -> GM
        // -------------------------------------------------------------------
        AscendC::DataCopy(
            zGm[offset],
            zLocal,
            this->tileLength);

        // -------------------------------------------------------------------
        // 释放结果 Tensor
        // -------------------------------------------------------------------
        outQueueZ.FreeTensor(zLocal);
    }

private:

    // =======================================================================
    // Pipe
    // =======================================================================
    AscendC::TPipe pipe;

    // =======================================================================
    // 输入 Queue
    // =======================================================================
    AscendC::TQue<
        AscendC::QuePosition::VECIN,
        QUEUE_DEPTH> inQueueX;

    AscendC::TQue<
        AscendC::QuePosition::VECIN,
        QUEUE_DEPTH> inQueueY;

    // =======================================================================
    // 输出 Queue
    // =======================================================================
    AscendC::TQue<
        AscendC::QuePosition::VECOUT,
        QUEUE_DEPTH> outQueueZ;

    // =======================================================================
    // Global Memory
    // =======================================================================
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    // =======================================================================
    // 当前 Core 参数
    // =======================================================================

    // 当前 Core 处理的数据长度
    uint32_t blockLength;

    // 当前 Core 的 Tile 数量
    uint32_t tileNum;

    // 每个 Tile 的数据长度
    uint32_t tileLength;
};


// ===========================================================================
// Kernel 入口
// ===========================================================================

template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    KernelSub<T> op;

    op.Init(
        x,
        y,
        z,
        tiling);

    op.Process();
}


// ===========================================================================
// Host 侧 run_kernel
// ===========================================================================

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    // -----------------------------------------------------------------------
    // AI Core 数量
    //
    // 当前保持原始模板中的 8。
    //
    // 原因：
    // 在不知道测试数据规模的情况下，直接使用 availableCoreNum
    // 可能导致 totalLength 无法整除 Core 数。
    // -----------------------------------------------------------------------
    constexpr uint32_t blockDim = 8;

    // -----------------------------------------------------------------------
    // 获取输入 Tensor
    // -----------------------------------------------------------------------
    const TensorInfo& t0 =
        info_x.tensors[0];

    // -----------------------------------------------------------------------
    // 计算 Tensor 总元素数量
    // -----------------------------------------------------------------------
    int64_t totalLength = 1;

    for (int64_t i = 0;
         i < t0.numDims;
         i++)
    {
        totalLength *= t0.shape[i];
    }

    // -----------------------------------------------------------------------
    // dtype
    //
    // 0 -> FP32
    // 1 -> FP16
    // -----------------------------------------------------------------------
    int32_t dtype =
        t0.dtype;

    // -----------------------------------------------------------------------
    // 性能优化：
    //
    // 原来：
    //     tileNum = 8
    //
    // 第一版优化：
    //     tileNum = 4
    //
    // 当前：
    //     tileNum = 1
    //
    // 配合 BUFFER_NUM = 2，
    // 每个 Core 只需要处理两个大 Tile。
    // -----------------------------------------------------------------------
    uint32_t tileNum = 1;

    // -----------------------------------------------------------------------
    // 构造 Tiling
    // -----------------------------------------------------------------------
    SubCustomTilingData tiling = {
        static_cast<uint32_t>(totalLength),
        tileNum
    };

    // -----------------------------------------------------------------------
    // FP16
    // -----------------------------------------------------------------------
    if (dtype == 1)
    {
        sub_custom<half>
            <<<blockDim, nullptr, stream>>>(
                x,
                y,
                z,
                tiling);
    }

    // -----------------------------------------------------------------------
    // FP32
    // -----------------------------------------------------------------------
    else
    {
        sub_custom<float>
            <<<blockDim, nullptr, stream>>>(
                x,
                y,
                z,
                tiling);
    }
}