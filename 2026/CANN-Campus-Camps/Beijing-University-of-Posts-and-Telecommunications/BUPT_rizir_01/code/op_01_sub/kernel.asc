#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 *
 * __global__ __vector__ void sub_custom(...)
 * {
 *     // TODO: implement your kernel logic
 *     // Available APIs: AscendC::TPipe, AscendC::TQue, AscendC::DataCopy, AscendC::Add, ...
 * }
 */
struct SubCustomTilingData{
    uint32_t totLen;
    uint32_t tileNum;
};

constexpr uint32_t BUFFER_NUM = 2;
constexpr uint32_t QUEUE_DEPTH = 1;

template<typename T>
class KernelSub{
public:
    __aicore__ inline KernelSub() {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
    {
        uint32_t totLen = tiling.totLen;
        uint32_t tileNum = tiling.tileNum;
        this->blockLen = totLen / AscendC::GetBlockNum();
        this->tileNum = tileNum;
        this->tileLen = this->blockLen / tileNum / BUFFER_NUM;
        xGm.SetGlobalBuffer((__gm__ T *)x + this->blockLen * AscendC::GetBlockIdx(), this->blockLen);
        yGm.SetGlobalBuffer((__gm__ T *)y + this->blockLen * AscendC::GetBlockIdx(), this->blockLen);
        zGm.SetGlobalBuffer((__gm__ T *)z + this->blockLen * AscendC::GetBlockIdx(), this->blockLen);
        // 为队列分配 UB 内存（单核内分块处理的基础）
        pipe.InitBuffer(inQX, BUFFER_NUM, this->tileLen * sizeof(T));
        pipe.InitBuffer(inQY, BUFFER_NUM, this->tileLen * sizeof(T));
        pipe.InitBuffer(outQZ, BUFFER_NUM, this->tileLen * sizeof(T));

    }
    __aicore__ inline void Process()
    {
        int32_t loopCnt = this->tileNum * BUFFER_NUM;
        for(int32_t i = 0; i < loopCnt; ++i){
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }
private:
    __aicore__ inline void CopyIn(int32_t pidx)
    {
        AscendC::LocalTensor<T> xLocal = inQX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQY.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm[pidx * this->tileLen], this->tileLen);
        AscendC::DataCopy(yLocal, yGm[pidx * this->tileLen], this->tileLen);
        inQX.EnQue(xLocal);
        inQY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(int32_t pidx)
    {
        AscendC::LocalTensor<T> xLocal = inQX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQZ.AllocTensor<T>();
        AscendC::Sub(zLocal, xLocal, yLocal, this->tileLen);
        outQZ.EnQue<T>(zLocal);
        inQX.FreeTensor(xLocal);
        inQY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int32_t pidx)
    {
        AscendC::LocalTensor<T> zLocal = outQZ.DeQue<T>();
        AscendC::DataCopy(zGm[pidx * this->tileLen], zLocal, this->tileLen);
        outQZ.FreeTensor(zLocal);
    }
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQX, inQY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH> outQZ;
    AscendC::GlobalTensor<T> xGm, yGm, zGm;

    uint32_t blockLen, tileNum, tileLen;
};

template <typename T>
__global__ __vector__ void sub_custom(__gm__ uint8_t* __restrict__ x, __gm__ uint8_t* __restrict__ y, __gm__ uint8_t* __restrict__ z, SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    // TODO: define your launch kernel.
    //   sub_custom<<<blockNum, nullptr, stream>>>(...);
    constexpr uint32_t blockDim = 8;
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totLen = 1;
    for(int64_t i = 0; i < t0.numDims; ++i){
        totLen *= t0.shape[i];
    }
    int32_t dtype = t0.dtype;
    uint32_t tileNum = 8;

    SubCustomTilingData tiling = {(uint32_t)totLen, tileNum};
    if(dtype == 1){
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }else{
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}
