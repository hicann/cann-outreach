#include <cmath>
#include <algorithm>
#include "kernel_operator.h"

// ---------------------------------------------------------------------------
// Tiling 参数：由 host 侧 run_kernel 按 availableCoreNum 动态计算并传给核函数
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint32_t totalLength;   // 数据总长度（元素个数）
    uint32_t formerNum;     // 处理大块数据的核心数
    uint32_t formerLength;  // 大块核心处理的元素个数（32字节对齐）
    uint32_t tailLength;    // 尾块核心处理的元素个数（32字节对齐）
};

constexpr uint32_t BUFFER_NUM = 1;   // 单缓冲模式，针对片内完整放下的小尺寸数据
constexpr uint32_t QUEUE_DEPTH = 1;

// ---------------------------------------------------------------------------
// KernelSub：z = x - y，支持 float / half 等类型的高性能矢量减法实现
// ---------------------------------------------------------------------------
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling, AscendC::TPipe* pipeIn)
    {
        this->pipe = pipeIn;
        uint32_t coreIdx = AscendC::GetBlockIdx();
        if (coreIdx < tiling.formerNum) {
            this->blockLength = tiling.formerLength;
            this->blockOffset = coreIdx * tiling.formerLength;
        } else {
            this->blockLength = tiling.tailLength;
            this->blockOffset = tiling.formerNum * tiling.formerLength + (coreIdx - tiling.formerNum) * tiling.tailLength;
        }

        if (this->blockLength == 0) {
            return;
        }

        // 设置每个核的 Global Memory 起始地址（32B / 512B 严格对齐）
        xGm.SetGlobalBuffer((__gm__ T *)x + this->blockOffset, this->blockLength);
        yGm.SetGlobalBuffer((__gm__ T *)y + this->blockOffset, this->blockLength);
        zGm.SetGlobalBuffer((__gm__ T *)z + this->blockOffset, this->blockLength);

        // 为队列分配 UB 内存（单核一次性分配，极小化队列管理开销）
        pipe->InitBuffer(inQueueX, BUFFER_NUM, this->blockLength * sizeof(T));
        pipe->InitBuffer(inQueueY, BUFFER_NUM, this->blockLength * sizeof(T));
        pipe->InitBuffer(outQueueZ, BUFFER_NUM, this->blockLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        if (this->blockLength == 0) {
            return;
        }
        // 单块直通，无循环分支开销
        CopyIn();
        Compute();
        CopyOut();
    }

private:
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        // 从 Global Memory 搬入数据到 Local Memory（一次性大块突发传输）
        AscendC::DataCopy(xLocal, xGm, this->blockLength);
        AscendC::DataCopy(yLocal, yGm, this->blockLength);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        // 执行矢量减法计算
        AscendC::Sub(zLocal, xLocal, yLocal, this->blockLength);
        outQueueZ.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        // 将结果从 Local Memory 搬出到 Global Memory
        AscendC::DataCopy(zGm, zLocal, this->blockLength);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe* pipe;  // 保存外部传入的 TPipe 指针，提升编译器 Scalar 优化空间
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueX, inQueueY;  // 输入数据队列管理对象
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH> outQueueZ;          // 输出数据队列管理对象
    AscendC::GlobalTensor<T> xGm, yGm, zGm; // 管理输入输出 Global Memory 地址的对象

    uint32_t blockLength = 0; // 当前核的计算数据长度
    uint32_t blockOffset = 0; // 当前核在 Global Memory 中的起始偏移
};

// ---------------------------------------------------------------------------
// 核函数入口：实例化 TPipe 与 KernelSub<T> 并执行
// ---------------------------------------------------------------------------
template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    AscendC::TPipe pipe;  // 在核函数入口处定义 TPipe，避免类内成员破坏 Scalar 常量传播
    KernelSub<T> op;
    op.Init(x, y, z, tiling, &pipe);
    op.Process();
}

// ---------------------------------------------------------------------------
// host 侧启动函数：利用 availableCoreNum 进行全核负载均衡切分
// ---------------------------------------------------------------------------
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    // 1. 取总元素数（x/y/z 形状一致）
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }
    int32_t dtype = t0.dtype;

    // 2. 依据数据类型确定 32 字节对齐粒度（float32 为 8，float16 为 16）
    uint32_t alignNum = (dtype == 1) ? 16 : 8;
    uint32_t totalBlocks = static_cast<uint32_t>(totalLength) / alignNum;

    // 3. 动态使用硬件全部可用的 Vector Core 数量（彻底消除固定 8 核的算力闲置）
    uint32_t blockDim = (availableCoreNum > 0) ? static_cast<uint32_t>(availableCoreNum) : 8;
    blockDim = std::min(blockDim, totalBlocks);
    if (blockDim == 0) {
        blockDim = 1;
    }

    // 4. 多核负载均衡切分（Former/Tail 经典高性能策略）
    uint32_t blocksPerCore = totalBlocks / blockDim;
    uint32_t remainBlocks = totalBlocks % blockDim;

    uint32_t formerNum = (remainBlocks == 0) ? blockDim : remainBlocks;
    uint32_t formerLength = (remainBlocks == 0) ? (blocksPerCore * alignNum) : ((blocksPerCore + 1) * alignNum);
    uint32_t tailLength = blocksPerCore * alignNum;

    SubCustomTilingData tiling = {
        static_cast<uint32_t>(totalLength),
        formerNum,
        formerLength,
        tailLength
    };

    if (dtype == 1) {
        // fp16：half 实例
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        // fp32 及其他类型默认走 float 实例
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}



