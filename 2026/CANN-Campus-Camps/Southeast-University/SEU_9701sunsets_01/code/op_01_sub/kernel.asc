#include <cmath>
#include "kernel_operator.h"

using namespace AscendC;

constexpr int32_t BUFFER_NUM = 2;
constexpr int32_t TILE_LENGTH = 1024;

struct SubCustomTilingData {
    uint32_t totalLength;
    uint32_t tileLength;
    uint32_t tileNum;
    uint32_t dtype;
};

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
    {
        totalLength = tiling.totalLength;
        tileLength = tiling.tileLength;
        tileNum = tiling.tileNum;

        xGm.SetGlobalBuffer((__gm__ T *)x, totalLength);
        yGm.SetGlobalBuffer((__gm__ T *)y, totalLength);
        zGm.SetGlobalBuffer((__gm__ T *)z, totalLength);

        pipe.InitBuffer(inQueueX, BUFFER_NUM, tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < tileNum; ++i) {
            uint32_t offset = i * tileLength;
            uint32_t len = (offset + tileLength <= totalLength) ? tileLength : (totalLength - offset);

            CopyIn(offset, len);
            Compute(len);
            CopyOut(offset, len);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset, uint32_t len)
    {
        LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();

        DataCopy(xLocal, xGm[offset], len);
        DataCopy(yLocal, yGm[offset], len);

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t len)
    {
        LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();

        Sub(zLocal, xLocal, yLocal, len);

        outQueueZ.EnQue(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t len)
    {
        LocalTensor<T> zLocal = outQueueZ.DeQue<T>();

        DataCopy(zGm[offset], zLocal, len);

        outQueueZ.FreeTensor(zLocal);
    }

private:
    TPipe pipe;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueX;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueY;
    TQue<QuePosition::VECOUT, BUFFER_NUM> outQueueZ;

    GlobalTensor<T> xGm;
    GlobalTensor<T> yGm;
    GlobalTensor<T> zGm;

    uint32_t totalLength;
    uint32_t tileLength;
    uint32_t tileNum;
};

__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    if (tiling.dtype == 1) {
        KernelSub<half> op;
        op.Init(x, y, z, tiling);
        op.Process();
    } else {
        KernelSub<float> op;
        op.Init(x, y, z, tiling);
        op.Process();
    }
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    (void)info_y;
    (void)info_z;
    (void)availableCoreNum;

    uint32_t totalLength = 1;
    for (int64_t i = 0; i < info_x.tensors[0].numDims; ++i) {
        totalLength *= static_cast<uint32_t>(info_x.tensors[0].shape[i]);
    }

    SubCustomTilingData tiling;
    tiling.totalLength = totalLength;
    tiling.tileLength = TILE_LENGTH;
    tiling.tileNum = (totalLength + TILE_LENGTH - 1) / TILE_LENGTH;
    tiling.dtype = static_cast<uint32_t>(info_x.tensors[0].dtype);

    sub_custom<<<1, nullptr, stream>>>(x, y, z, tiling);
}