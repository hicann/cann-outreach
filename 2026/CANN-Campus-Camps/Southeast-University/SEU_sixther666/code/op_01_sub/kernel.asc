#include <cmath>
#include <cstdint>
#include "kernel_operator.h"

struct SubCustomTilingData {
    uint32_t totalLength;   // 总元素数
    uint32_t blockLength;   // 每个核处理的元素数
    uint32_t tileLength;    // 每个 tile 处理的元素数
    uint32_t tileNum;       // 每个核的 tile 数
    int32_t dtype;          // 0 = fp32, 1 = fp16
};

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        const SubCustomTilingData &tiling)
    {
        blockLength = tiling.blockLength;
        tileLength = tiling.tileLength;
        tileNum = tiling.tileNum;

        uint32_t blockOffset =
            static_cast<uint32_t>(AscendC::GetBlockIdx()) * blockLength;

        xGm.SetGlobalBuffer(
            reinterpret_cast<__gm__ T *>(x) + blockOffset,
            blockLength);

        yGm.SetGlobalBuffer(
            reinterpret_cast<__gm__ T *>(y) + blockOffset,
            blockLength);

        zGm.SetGlobalBuffer(
            reinterpret_cast<__gm__ T *>(z) + blockOffset,
            blockLength);

        /*
         * 每次只需要保存一个 tile。
         *
         * fp32:
         *   2048 * 4 = 8192 bytes / tensor
         *
         * fp16:
         *   2048 * 2 = 4096 bytes / tensor
         */
        pipe.InitBuffer(inQueueX, 1, tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, 1, tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, 1, tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < tileNum; ++i) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t progress)
    {
        AscendC::LocalTensor<T> xLocal =
            inQueueX.template AllocTensor<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.template AllocTensor<T>();

        uint32_t offset = progress * tileLength;

        AscendC::DataCopy(
            xLocal,
            xGm[offset],
            tileLength);

        AscendC::DataCopy(
            yLocal,
            yGm[offset],
            tileLength);

        inQueueX.template EnQue<T>(xLocal);
        inQueueY.template EnQue<T>(yLocal);
    }

    __aicore__ inline void Compute(uint32_t progress)
    {
        AscendC::LocalTensor<T> xLocal =
            inQueueX.template DeQue<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.template DeQue<T>();

        AscendC::LocalTensor<T> zLocal =
            outQueueZ.template AllocTensor<T>();

        // z = x - y
        AscendC::Sub(
            zLocal,
            xLocal,
            yLocal,
            static_cast<int32_t>(tileLength));

        outQueueZ.template EnQue<T>(zLocal);

        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t progress)
    {
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.template DeQue<T>();

        uint32_t offset = progress * tileLength;

        AscendC::DataCopy(
            zGm[offset],
            zLocal,
            tileLength);

        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;

    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueX;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueZ;

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    uint32_t blockLength;
    uint32_t tileLength;
    uint32_t tileNum;
};


/*
 * Device Kernel
 */
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    if (tiling.dtype == 0) {
        // float32
        KernelSub<float> op;
        op.Init(x, y, z, tiling);
        op.Process();
    } else if (tiling.dtype == 1) {
        // float16
        KernelSub<half> op;
        op.Init(x, y, z, tiling);
        op.Process();
    }
}


/*
 * Host invocation
 */
extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    /*
     * 题目 shape 固定为 (8, 2048)，这里仍从 TensorInfo
     * 动态计算元素总数，避免把 16384 写死。
     */
    if (info_x.numTensors <= 0 ||
        info_x.tensors == nullptr ||
        info_x.tensors[0].shape == nullptr) {
        return;
    }

    const TensorInfo &tensorX = info_x.tensors[0];

    int64_t totalLength64 = 1;

    for (int64_t i = 0; i < tensorX.numDims; ++i) {
        totalLength64 *= tensorX.shape[i];
    }

    if (totalLength64 <= 0) {
        return;
    }

    uint32_t totalLength =
        static_cast<uint32_t>(totalLength64);

    /*
     * 题目支持:
     * dtype = 0 -> float32
     * dtype = 1 -> float16
     */
    int32_t dtype = tensorX.dtype;

    if (dtype != 0 && dtype != 1) {
        return;
    }

    /*
     * Shape = (8, 2048)
     *
     * 优先使用 8 个核：
     *
     * 8 cores:
     *   每核 2048 elements
     *   每核 1 tile
     *
     * 如果实际可用核数不足，则选择 4 / 2 / 1，
     * 保证 16384 可以被 blockNum 整除。
     */
    uint32_t blockNum = 1;

    if (availableCoreNum >= 8 &&
        totalLength % 8 == 0) {
        blockNum = 8;
    } else if (availableCoreNum >= 4 &&
               totalLength % 4 == 0) {
        blockNum = 4;
    } else if (availableCoreNum >= 2 &&
               totalLength % 2 == 0) {
        blockNum = 2;
    }

    uint32_t blockLength = totalLength / blockNum;

    /*
     * 以输入的一行 2048 个元素作为一个 tile。
     *
     * (8, 2048) 因此：
     *
     * blockNum = 8:
     *   blockLength = 2048
     *   tileNum = 1
     *
     * blockNum = 4:
     *   blockLength = 4096
     *   tileNum = 2
     *
     * ...
     */
    constexpr uint32_t TILE_LENGTH = 2048;

    SubCustomTilingData tiling;

    tiling.totalLength = totalLength;
    tiling.blockLength = blockLength;
    tiling.tileLength = TILE_LENGTH;
    tiling.tileNum = blockLength / TILE_LENGTH;
    tiling.dtype = dtype;

    sub_custom<<<blockNum, nullptr, stream>>>(
        x,
        y,
        z,
        tiling);
}