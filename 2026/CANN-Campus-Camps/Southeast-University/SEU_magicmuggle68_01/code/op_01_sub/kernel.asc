#include <cmath>
#include "kernel_operator.h"

// Host 侧传递给核函数的 Tiling 参数
struct SubCustomTilingData {
    uint32_t totalLength;  // 输入张量的总元素数
    uint32_t tileNum;      // 每个核内部的 Tile 数量
};

constexpr uint32_t BUFFER_NUM = 2;
constexpr uint32_t QUEUE_DEPTH = 1;

// 实现 z = x - y
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        const SubCustomTilingData& tiling)
    {
        uint32_t totalLength = tiling.totalLength;

        // 每个核负责的元素数量
        this->blockLength =
            totalLength / AscendC::GetBlockNum();

        this->tileNum = tiling.tileNum;

        // 每次循环处理的元素数量
        this->tileLength =
            this->blockLength / this->tileNum / BUFFER_NUM;

        // 当前核所负责的 GM 数据起始位置
        uint32_t blockOffset =
            this->blockLength * AscendC::GetBlockIdx();

        xGm.SetGlobalBuffer(
            reinterpret_cast<__gm__ T*>(x) + blockOffset,
            this->blockLength);

        yGm.SetGlobalBuffer(
            reinterpret_cast<__gm__ T*>(y) + blockOffset,
            this->blockLength);

        zGm.SetGlobalBuffer(
            reinterpret_cast<__gm__ T*>(z) + blockOffset,
            this->blockLength);

        // 为输入、输出队列分配 UB 空间
        pipe.InitBuffer(
            inQueueX,
            BUFFER_NUM,
            this->tileLength * sizeof(T));

        pipe.InitBuffer(
            inQueueY,
            BUFFER_NUM,
            this->tileLength * sizeof(T));

        pipe.InitBuffer(
            outQueueZ,
            BUFFER_NUM,
            this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // tileLength 除以了 BUFFER_NUM，因此循环次数要乘回来
        int32_t loopCount =
            static_cast<int32_t>(this->tileNum * BUFFER_NUM);

        for (int32_t i = 0; i < loopCount; ++i) {
            CopyIn(i);
            Compute();
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        // 在 UB 中申请输入空间
        AscendC::LocalTensor<T> xLocal =
            inQueueX.AllocTensor<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.AllocTensor<T>();

        uint32_t offset =
            static_cast<uint32_t>(progress) * this->tileLength;

        // GM -> UB
        AscendC::DataCopy(
            xLocal,
            xGm[offset],
            this->tileLength);

        AscendC::DataCopy(
            yLocal,
            yGm[offset],
            this->tileLength);

        // 通知计算阶段输入数据已就绪
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        // 从输入队列取出数据
        AscendC::LocalTensor<T> xLocal =
            inQueueX.DeQue<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.DeQue<T>();

        // 为计算结果申请 UB 空间
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.AllocTensor<T>();

        // 核心计算：
        // zLocal = xLocal - yLocal
        AscendC::Sub(
            zLocal,
            xLocal,
            yLocal,
            this->tileLength);

        // 通知搬出阶段结果已就绪
        outQueueZ.EnQue<T>(zLocal);

        // 输入数据已经使用完毕
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int32_t progress)
    {
        // 获取计算完成的数据
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.DeQue<T>();

        uint32_t offset =
            static_cast<uint32_t>(progress) * this->tileLength;

        // UB -> GM
        AscendC::DataCopy(
            zGm[offset],
            zLocal,
            this->tileLength);

        outQueueZ.FreeTensor(zLocal);
    }

private:
    // UB 内存和流水管理对象
    AscendC::TPipe pipe;

    // 输入队列
    AscendC::TQue<
        AscendC::QuePosition::VECIN,
        QUEUE_DEPTH> inQueueX;

    AscendC::TQue<
        AscendC::QuePosition::VECIN,
        QUEUE_DEPTH> inQueueY;

    // 输出队列
    AscendC::TQue<
        AscendC::QuePosition::VECOUT,
        QUEUE_DEPTH> outQueueZ;

    // GM 中的输入和输出张量
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    uint32_t blockLength;
    uint32_t tileNum;
    uint32_t tileLength;
};

// Device 侧核函数入口
template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

// Host 侧启动函数
extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    // 固定启动 8 个核
    constexpr uint32_t blockDim = 8;
    constexpr uint32_t tileNum = 8;

    // 读取 x 的形状，计算总元素数
    const TensorInfo& inputInfo = info_x.tensors[0];

    int64_t totalLength = 1;
    for (int64_t i = 0; i < inputInfo.numDims; ++i) {
        totalLength *= inputInfo.shape[i];
    }

    SubCustomTilingData tiling = {
        static_cast<uint32_t>(totalLength),
        tileNum
    };

    // 根据输入类型选择对应的模板实例
    if (inputInfo.dtype == 1) {
        // dtype = 1：FP16
        sub_custom<half><<<blockDim, nullptr, stream>>>(
            x, y, z, tiling);
    } else {
        // dtype = 0：FP32
        sub_custom<float><<<blockDim, nullptr, stream>>>(
            x, y, z, tiling);
    }
}