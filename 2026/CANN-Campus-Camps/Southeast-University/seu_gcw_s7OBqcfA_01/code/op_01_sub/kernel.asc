#include <cmath>
#include "kernel_operator.h"

struct SubCustomTilingData {
    uint32_t totalLength;
    uint32_t tileNum;
};

constexpr uint32_t BUFFER_NUM = 2;
constexpr uint32_t QUEUE_DEPTH = 1;

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        const SubCustomTilingData& tiling)
    {
        uint32_t totalLength = tiling.totalLength;
        uint32_t tileNum = tiling.tileNum;

        // 每个 AI Core 负责多少个元素
        this->blockLength =
            totalLength / AscendC::GetBlockNum();

        // 每个核内部再切成 tileNum × BUFFER_NUM 块
        this->tileNum = tileNum;
        this->tileLength =
            this->blockLength / tileNum / BUFFER_NUM;

        // 当前核对应的 GM 起始位置
        uint32_t blockOffset =
            this->blockLength * AscendC::GetBlockIdx();

        xGm.SetGlobalBuffer(
            (__gm__ T*)x + blockOffset,
            this->blockLength);

        yGm.SetGlobalBuffer(
            (__gm__ T*)y + blockOffset,
            this->blockLength);

        zGm.SetGlobalBuffer(
            (__gm__ T*)z + blockOffset,
            this->blockLength);

        // 在片上 Unified Buffer 中申请队列空间
        pipe.InitBuffer(
            inQueueX,
            BUFFER_NUM,
            this->tileLength * sizeof(T));

        pipe.InitBuffer(
            inQueueY,
            BUFFER_NUM,
            this->tileLength * sizeof(T));

        pipe.InitBuffer(
            outQueueZ,
            BUFFER_NUM,
            this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        int32_t loopCount =
            this->tileNum * BUFFER_NUM;

        for (int32_t i = 0; i < loopCount; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        // 从输入队列申请 LocalTensor
        AscendC::LocalTensor<T> xLocal =
            inQueueX.AllocTensor<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.AllocTensor<T>();

        uint32_t offset =
            progress * this->tileLength;

        // GM -> UB
        AscendC::DataCopy(
            xLocal,
            xGm[offset],
            this->tileLength);

        AscendC::DataCopy(
            yLocal,
            yGm[offset],
            this->tileLength);

        // 放进队列，交给 Compute
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(int32_t progress)
    {
        // 从输入队列取出数据
        AscendC::LocalTensor<T> xLocal =
            inQueueX.DeQue<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.DeQue<T>();

        // 为结果申请 LocalTensor
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.AllocTensor<T>();

        // 核心计算：z = x - y
        AscendC::Sub(
            zLocal,
            xLocal,
            yLocal,
            this->tileLength);

        // 结果交给 CopyOut
        outQueueZ.EnQue(zLocal);

        // 释放输入 LocalTensor
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int32_t progress)
    {
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.DeQue<T>();

        uint32_t offset =
            progress * this->tileLength;

        // UB -> GM
        AscendC::DataCopy(
            zGm[offset],
            zLocal,
            this->tileLength);

        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;

    AscendC::TQue<
        AscendC::QuePosition::VECIN,
        QUEUE_DEPTH> inQueueX;

    AscendC::TQue<
        AscendC::QuePosition::VECIN,
        QUEUE_DEPTH> inQueueY;

    AscendC::TQue<
        AscendC::QuePosition::VECOUT,
        QUEUE_DEPTH> outQueueZ;

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    uint32_t blockLength;
    uint32_t tileNum;
    uint32_t tileLength;
};

template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    constexpr uint32_t blockDim = 8;

    // 根据输入形状计算元素总数
    const TensorInfo& t0 = info_x.tensors[0];

    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }

    int32_t dtype = t0.dtype;
    uint32_t tileNum = 8;

    SubCustomTilingData tiling = {
        static_cast<uint32_t>(totalLength),
        tileNum
    };

    // dtype == 1 表示 FP16
    if (dtype == 1) {
        sub_custom<half>
            <<<blockDim, nullptr, stream>>>(
                x, y, z, tiling);
    } else {
        sub_custom<float>
            <<<blockDim, nullptr, stream>>>(
                x, y, z, tiling);
    }
}