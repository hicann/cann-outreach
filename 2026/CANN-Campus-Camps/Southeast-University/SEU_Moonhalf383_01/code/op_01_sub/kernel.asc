#include "kernel_operator.h"
#include <cmath>
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * 参考实现（sub_custom：z = x − y，逐元素，float32）
 *   - 总元素数从货物清单（TensorGroupInfo）读出：8 × 2048 = 16384
 *   - 切分：每核 blockLength 个元素（向上对齐到 8 = fp32 的 32 字节对齐）
 *   - 核内：按 TILE_LENGTH=2048 分块，走 CopyIn → Compute(Sub) → CopyOut 流水
 *   - 队列：TQue(VECIN/VECOUT) + BUFFER_NUM=2 双缓冲，为"搬入下一块"与"计算当前块"
 *     的硬件级重叠留出空间（依赖 MTE/VEC 指令异步执行，与官方 Add 样例同构）
 */

constexpr int32_t BUFFER_NUM = 2;      // 双缓冲：为"搬入下一块"与"计算当前块"的硬件级重叠留出空间
constexpr uint32_t ALIGN_NUM = 8;      // fp32 下 32 字节 = 8 个元素
constexpr uint32_t TILE_LENGTH = 2048; // 每块 2048 个元素（8KB），UB 完全放得下

__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                      uint32_t blockLength, uint32_t totalLength)
{
    uint32_t blockIdx = AscendC::GetBlockIdx();
    if (blockIdx * blockLength >= totalLength) {
        return; // 没分到数据的核心直接退出（保险，正常切分不会走到）
    }
    uint32_t coreOffset = blockIdx * blockLength;
    uint32_t coreLength = blockLength;
    if (coreOffset + coreLength > totalLength) {
        coreLength = totalLength - coreOffset; // 最后一个核心只处理剩余的尾巴
    }

    // ---- 1. 绑定 Global Memory（大仓库）：每个核心只看自己负责的那段 ----
    AscendC::GlobalTensor<float> xGm, yGm, zGm;
    xGm.SetGlobalBuffer((__gm__ float *)x + coreOffset, coreLength);
    yGm.SetGlobalBuffer((__gm__ float *)y + coreOffset, coreLength);
    zGm.SetGlobalBuffer((__gm__ float *)z + coreOffset, coreLength);

    // ---- 2. 准备工作台（UB）与队列 ----
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> queXin;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> queYin;
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_NUM> queZout;
    pipe.InitBuffer(queXin, BUFFER_NUM, TILE_LENGTH * sizeof(float));
    pipe.InitBuffer(queYin, BUFFER_NUM, TILE_LENGTH * sizeof(float));
    pipe.InitBuffer(queZout, BUFFER_NUM, TILE_LENGTH * sizeof(float));

    uint32_t tileNum = (coreLength + TILE_LENGTH - 1) / TILE_LENGTH;

    for (uint32_t i = 0; i < tileNum; i++) {
        uint32_t curLen = TILE_LENGTH;
        if (i == tileNum - 1) {
            curLen = coreLength - (tileNum - 1) * TILE_LENGTH; // 尾块必为 8 的倍数
        }

        // ---- 3. CopyIn：GM → UB ----
        AscendC::LocalTensor<float> xLocal = queXin.AllocTensor<float>();
        AscendC::LocalTensor<float> yLocal = queYin.AllocTensor<float>();
        AscendC::DataCopy(xLocal, xGm[i * TILE_LENGTH], curLen);
        AscendC::DataCopy(yLocal, yGm[i * TILE_LENGTH], curLen);
        queXin.EnQue(xLocal);
        queYin.EnQue(yLocal);

        // ---- 4. Compute：z = x - y（一条向量指令处理一整块）----
        xLocal = queXin.DeQue<float>();
        yLocal = queYin.DeQue<float>();
        AscendC::LocalTensor<float> zLocal = queZout.AllocTensor<float>();
        AscendC::Sub(zLocal, xLocal, yLocal, curLen);
        queXin.FreeTensor(xLocal);
        queYin.FreeTensor(yLocal);
        queZout.EnQue(zLocal);

        // ---- 5. CopyOut：UB → GM ----
        zLocal = queZout.DeQue<float>();
        AscendC::DataCopy(zGm[i * TILE_LENGTH], zLocal, curLen);
        queZout.FreeTensor(zLocal);
    }
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo &info_x, GM_ADDR y,
                           const TensorGroupInfo &info_y, GM_ADDR z,
                           const TensorGroupInfo &info_z,
                           int64_t availableCoreNum, aclrtStream stream) {
    // 1. 从货物清单算总元素数：各维度相乘（本例 8 × 2048 = 16384）
    const TensorInfo &tx = info_x.tensors[0];
    uint32_t totalLength = 1;
    for (int64_t d = 0; d < tx.numDims; ++d) {
        totalLength *= (uint32_t)tx.shape[d];
    }

    // 2. 规划切分：每核 blockLength 个元素（向上取整并对齐到 8，保证 32 字节对齐）
    uint32_t coreNum = (uint32_t)(availableCoreNum > 0 ? availableCoreNum : 1);
    uint32_t blockLength = (totalLength + coreNum - 1) / coreNum;
    blockLength = (blockLength + ALIGN_NUM - 1) / ALIGN_NUM * ALIGN_NUM;
    uint32_t blockNum = (totalLength + blockLength - 1) / blockLength; // 实际用几个核

    // 3. 点火：blockNum 个向量核心同时执行 sub_custom（异步，任务扔上 stream 立即返回）
    sub_custom<<<blockNum, nullptr, stream>>>(x, y, z, blockLength, totalLength);
}
