#include <cstdint>
#include <cmath>
#include "kernel_operator.h"

/*
 * Sub Kernel — Ascend C Direct Invocation
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo {
 *       const int64_t* shape;
 *       int64_t numDims;
 *       int32_t dtype;
 *   };
 *
 *   struct TensorGroupInfo {
 *       const TensorInfo* tensors;
 *       int64_t numTensors;
 *   };
 *
 * dtype:
 *   0 = float32
 *   1 = float16
 *   2 = bfloat16
 *   3 = int8
 *   4 = int16
 *   5 = int32
 *   ...
 */

constexpr uint32_t BUFFER_NUM = 2;
constexpr uint32_t TILE_NUM = 8;
constexpr uint32_t MAX_BLOCK_NUM = 8;

/*
 * Host -> Kernel tiling data
 */
struct SubCustomTilingData {
    uint32_t totalLength;
    uint32_t tileNum;
    uint32_t dtype;
};


/*
 * Kernel implementation.
 *
 * T:
 *   float : dtype == 0
 *   half  : dtype == 1
 */
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub()
    {
    }

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        uint32_t totalLength,
        uint32_t tileNum)
    {
        /*
         * totalLength is split equally among Vector Cores.
         *
         * For the required shape:
         *
         * totalLength = 8 * 2048 = 16384
         * blockNum    = 8
         * blockLength = 2048
         *
         * tileNum     = 8
         * BUFFER_NUM  = 2
         *
         * tileLength = 2048 / 8 / 2 = 128
         */
        this->blockLength =
            totalLength / AscendC::GetBlockNum();

        this->tileNum = tileNum;

        this->tileLength =
            this->blockLength /
            this->tileNum /
            BUFFER_NUM;

        /*
         * Each Vector Core processes its own continuous segment.
         */
        uint32_t blockOffset =
            this->blockLength *
            AscendC::GetBlockIdx();

        xGm.SetGlobalBuffer(
            (__gm__ T *)x + blockOffset,
            this->blockLength);

        yGm.SetGlobalBuffer(
            (__gm__ T *)y + blockOffset,
            this->blockLength);

        zGm.SetGlobalBuffer(
            (__gm__ T *)z + blockOffset,
            this->blockLength);

        /*
         * Allocate UB buffers.
         *
         * BUFFER_NUM = 2 enables double buffering.
         */
        pipe.InitBuffer(
            inQueueX,
            BUFFER_NUM,
            this->tileLength * sizeof(T));

        pipe.InitBuffer(
            inQueueY,
            BUFFER_NUM,
            this->tileLength * sizeof(T));

        pipe.InitBuffer(
            outQueueZ,
            BUFFER_NUM,
            this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        /*
         * tileNum logical tiles,
         * each tile contains BUFFER_NUM sub-tiles.
         */
        int32_t loopCount =
            static_cast<int32_t>(
                this->tileNum * BUFFER_NUM);

        for (int32_t i = 0; i < loopCount; ++i) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    /*
     * GM -> UB
     */
    __aicore__ inline void CopyIn(int32_t progress)
    {
        AscendC::LocalTensor<T> xLocal =
            inQueueX.AllocTensor<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.AllocTensor<T>();

        uint32_t offset =
            static_cast<uint32_t>(progress) *
            this->tileLength;

        AscendC::DataCopy(
            xLocal,
            xGm[offset],
            this->tileLength);

        AscendC::DataCopy(
            yLocal,
            yGm[offset],
            this->tileLength);

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    /*
     * UB vector computation
     *
     * z = x - y
     */
    __aicore__ inline void Compute(int32_t progress)
    {
        AscendC::LocalTensor<T> xLocal =
            inQueueX.DeQue<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.DeQue<T>();

        AscendC::LocalTensor<T> zLocal =
            outQueueZ.AllocTensor<T>();

        /*
         * Vector subtraction:
         *
         * zLocal[i] = xLocal[i] - yLocal[i]
         */
        AscendC::Sub(
            zLocal,
            xLocal,
            yLocal,
            this->tileLength);

        outQueueZ.EnQue(zLocal);

        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    /*
     * UB -> GM
     */
    __aicore__ inline void CopyOut(int32_t progress)
    {
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.DeQue<T>();

        uint32_t offset =
            static_cast<uint32_t>(progress) *
            this->tileLength;

        AscendC::DataCopy(
            zGm[offset],
            zLocal,
            this->tileLength);

        outQueueZ.FreeTensor(zLocal);
    }

private:
    /*
     * Pipeline manager
     */
    AscendC::TPipe pipe;

    /*
     * VECIN queues
     */
    AscendC::TQue<
        AscendC::TPosition::VECIN,
        BUFFER_NUM> inQueueX;

    AscendC::TQue<
        AscendC::TPosition::VECIN,
        BUFFER_NUM> inQueueY;

    /*
     * VECOUT queue
     */
    AscendC::TQue<
        AscendC::TPosition::VECOUT,
        BUFFER_NUM> outQueueZ;

    /*
     * Global Memory tensors
     */
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    /*
     * Tiling parameters
     */
    uint32_t blockLength;
    uint32_t tileNum;
    uint32_t tileLength;
};


/*
 * Device kernel entry.
 *
 * dtype is passed through tiling:
 *
 * 0 -> float32
 * 1 -> float16
 */
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    if (tiling.dtype == 0) {
        /*
         * float32
         */
        KernelSub<float> op;

        op.Init(
            x,
            y,
            z,
            tiling.totalLength,
            tiling.tileNum);

        op.Process();
    } else if (tiling.dtype == 1) {
        /*
         * float16
         */
        KernelSub<half> op;

        op.Init(
            x,
            y,
            z,
            tiling.totalLength,
            tiling.tileNum);

        op.Process();
    }
}


/*
 * Host-side kernel launcher.
 */
extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    /*
     * Basic validation.
     */
    if (availableCoreNum <= 0) {
        return;
    }

    if (info_x.numTensors <= 0 ||
        info_y.numTensors <= 0 ||
        info_z.numTensors <= 0) {
        return;
    }

    if (info_x.tensors == nullptr ||
        info_y.tensors == nullptr ||
        info_z.tensors == nullptr) {
        return;
    }

    const TensorInfo& xInfo = info_x.tensors[0];
    const TensorInfo& yInfo = info_y.tensors[0];
    const TensorInfo& zInfo = info_z.tensors[0];

    /*
     * This problem requires all tensors to have the same dtype.
     */
    if (xInfo.dtype != yInfo.dtype ||
        xInfo.dtype != zInfo.dtype) {
        return;
    }

    /*
     * Only float32 / float16 are supported.
     *
     * 0 = fp32
     * 1 = fp16
     */
    if (xInfo.dtype != 0 &&
        xInfo.dtype != 1) {
        return;
    }

    if (xInfo.shape == nullptr ||
        xInfo.numDims <= 0) {
        return;
    }

    /*
     * Calculate total number of elements from input shape.
     *
     * Required shape:
     *   (8, 2048)
     *
     * totalLength = 16384
     */
    uint64_t totalLength64 = 1;

    for (int64_t i = 0; i < xInfo.numDims; ++i) {
        if (xInfo.shape[i] <= 0) {
            return;
        }

        totalLength64 *=
            static_cast<uint64_t>(
                xInfo.shape[i]);
    }

    /*
     * TilingData uses uint32_t.
     * The specified problem size is far below this limit.
     */
    if (totalLength64 == 0 ||
        totalLength64 > 0xFFFFFFFFULL) {
        return;
    }

    uint32_t totalLength =
        static_cast<uint32_t>(
            totalLength64);

    /*
     * Prefer 8 Vector Cores, matching the first dimension
     * of the required tensor (8, 2048).
     */
    uint32_t blockNum;

    if (availableCoreNum >=
        static_cast<int64_t>(MAX_BLOCK_NUM)) {
        blockNum = MAX_BLOCK_NUM;
    } else {
        blockNum =
            static_cast<uint32_t>(
                availableCoreNum);
    }

    /*
     * Make sure every core receives the same amount of data.
     *
     * For normal validation environments blockNum will be 8.
     * This fallback makes the launcher safer if fewer cores
     * are exposed.
     */
    while (blockNum > 1 &&
           (totalLength % blockNum) != 0) {
        --blockNum;
    }

    if (blockNum == 0) {
        return;
    }

    uint32_t blockLength =
        totalLength / blockNum;

    /*
     * DataCopy requires the copied data to satisfy the
     * corresponding alignment constraints.
     *
     * fp32:
     *   32 bytes / 4 = 8 elements
     *
     * fp16:
     *   32 bytes / 2 = 16 elements
     */
    uint32_t alignElements =
        (xInfo.dtype == 0) ? 8U : 16U;

    /*
     * Start from 8 logical tiles and reduce it only if the
     * block size cannot be evenly divided.
     */
    uint32_t tileNum = TILE_NUM;

    while (tileNum > 1) {
        uint32_t denominator =
            tileNum *
            BUFFER_NUM *
            alignElements;

        if ((blockLength % denominator) == 0) {
            break;
        }

        --tileNum;
    }

    /*
     * Verify the final tile is still 32-byte aligned.
     */
    uint32_t finalDenominator =
        tileNum *
        BUFFER_NUM *
        alignElements;

    if ((blockLength % finalDenominator) != 0) {
        return;
    }

    /*
     * Build tiling parameters.
     */
    SubCustomTilingData tiling;

    tiling.totalLength = totalLength;
    tiling.tileNum = tileNum;
    tiling.dtype =
        static_cast<uint32_t>(
            xInfo.dtype);

    /*
     * Launch Vector Core kernel.
     */
    sub_custom<<<blockNum, nullptr, stream>>>(
        x,
        y,
        z,
        tiling);
}
