#include <cmath>
#include "kernel_operator.h"

constexpr uint32_t SUB_CORE_NUM     = 8;
constexpr uint32_t SUB_BLOCK_LENGTH = 2048;
constexpr uint32_t SUB_TILE_LENGTH  = 1024;

/*
 * Two-tile static UB layout.
 * For fp32 each tile is exactly 4KB:
 *   ping: x0 bank0, y0 bank1
 *   pong: x1 bank2, y1 bank3
 *
 * zLocal is intentionally eliminated:
 * Ascend C Sub supports dst == src1 for half/float.
 * We compute yLocal = xLocal - yLocal, then copy yLocal to z GM.
 */
constexpr uint32_t UB_X0 = 0x0000;
constexpr uint32_t UB_Y0 = 0x1000;
constexpr uint32_t UB_X1 = 0x2000;
constexpr uint32_t UB_Y1 = 0x3000;

struct SubCustomTilingData {
    uint32_t reserved;
};

template <typename T, uint8_t REPEAT_TIMES>
__aicore__ inline void SubBody(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    const uint32_t gmOffset = AscendC::GetBlockIdx() << 11;

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    xGm.SetGlobalBuffer(
        reinterpret_cast<__gm__ T *>(x) + gmOffset,
        SUB_BLOCK_LENGTH);
    yGm.SetGlobalBuffer(
        reinterpret_cast<__gm__ T *>(y) + gmOffset,
        SUB_BLOCK_LENGTH);
    zGm.SetGlobalBuffer(
        reinterpret_cast<__gm__ T *>(z) + gmOffset,
        SUB_BLOCK_LENGTH);

    AscendC::LocalTensor<T> x0(
        AscendC::TPosition::VECCALC, UB_X0, SUB_TILE_LENGTH);
    AscendC::LocalTensor<T> y0(
        AscendC::TPosition::VECCALC, UB_Y0, SUB_TILE_LENGTH);
    AscendC::LocalTensor<T> x1(
        AscendC::TPosition::VECCALC, UB_X1, SUB_TILE_LENGTH);
    AscendC::LocalTensor<T> y1(
        AscendC::TPosition::VECCALC, UB_Y1, SUB_TILE_LENGTH);

    // ---- MTE2 ping ----
    AscendC::DataCopy(x0, xGm, SUB_TILE_LENGTH);
    AscendC::DataCopy(y0, yGm, SUB_TILE_LENGTH);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(0);

    // ---- MTE2 pong ----
    // Queued immediately so it overlaps with ping Vector/MTE3 work.
    AscendC::DataCopy(x1, xGm[SUB_TILE_LENGTH], SUB_TILE_LENGTH);
    AscendC::DataCopy(y1, yGm[SUB_TILE_LENGTH], SUB_TILE_LENGTH);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(1);

    // ---- Vector ping ----
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(0);

    // In-place on src1: y0 = x0 - y0.
    AscendC::Sub<T, false>(
        y0,
        x0,
        y0,
        AscendC::MASK_PLACEHOLDER,
        REPEAT_TIMES,
        {1, 1, 1, 8, 8, 8});

    // ---- MTE3 ping ----
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(0);
    AscendC::DataCopy(zGm, y0, SUB_TILE_LENGTH);

    // ---- Vector pong ----
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(1);

    // In-place on src1: y1 = x1 - y1.
    AscendC::Sub<T, false>(
        y1,
        x1,
        y1,
        AscendC::MASK_PLACEHOLDER,
        REPEAT_TIMES,
        {1, 1, 1, 8, 8, 8});

    // ---- MTE3 pong ----
    // Event 0 can be reused because the first V_MTE3 pair was consumed.
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(0);
    AscendC::DataCopy(zGm[SUB_TILE_LENGTH], y1, SUB_TILE_LENGTH);

    // Drain only the final output DMA before kernel exit.
    AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(2);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_S>(2);
}

__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    (void)tiling;
    AscendC::InitSocState();
    SubBody<float, 16>(x, y, z);
}

__global__ __vector__ void sub_custom_fp16(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    (void)tiling;
    AscendC::InitSocState();
    SubBody<half, 8>(x, y, z);
}

extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR y, const TensorGroupInfo& info_y,
    GM_ADDR z, const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    (void)info_y;
    (void)info_z;
    (void)availableCoreNum;

    SubCustomTilingData tiling = {0};

    if (info_x.tensors[0].dtype == 1) {
        sub_custom_fp16<<<SUB_CORE_NUM, nullptr, stream>>>(x, y, z, tiling);
    } else {
        sub_custom<<<SUB_CORE_NUM, nullptr, stream>>>(x, y, z, tiling);
    }
}