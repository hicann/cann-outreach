#include <cmath>
#include "kernel_operator.h"

using namespace AscendC;

constexpr uint32_t BUFFER_NUM = 2;
constexpr uint32_t TILE_NUM = 8;

/*
 * Tiling 参数
 */
struct SubCustomTilingData {
    uint32_t totalLength;   // 总元素数量
    uint32_t tileNum;       // 每个核上的 tile 数
    uint32_t dataType;      // 0: fp32, 1: fp16
};

/*
 * Kernel 主体
 */
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        uint32_t totalLength,
        uint32_t tileNum)
    {
        // 每个 Vector Core 处理的数据量
        blockLength = totalLength / AscendC::GetBlockNum();

        this->tileNum = tileNum;

        // 双缓冲，所以实际循环为 tileNum * BUFFER_NUM
        tileLength = blockLength / tileNum / BUFFER_NUM;

        // 当前核负责的 GM 起始位置
        xGm.SetGlobalBuffer(
            (__gm__ T *)x +
                blockLength * AscendC::GetBlockIdx(),
            blockLength);

        yGm.SetGlobalBuffer(
            (__gm__ T *)y +
                blockLength * AscendC::GetBlockIdx(),
            blockLength);

        zGm.SetGlobalBuffer(
            (__gm__ T *)z +
                blockLength * AscendC::GetBlockIdx(),
            blockLength);

        // UB 队列
        pipe.InitBuffer(
            inQueueX,
            BUFFER_NUM,
            tileLength * sizeof(T));

        pipe.InitBuffer(
            inQueueY,
            BUFFER_NUM,
            tileLength * sizeof(T));

        pipe.InitBuffer(
            outQueueZ,
            BUFFER_NUM,
            tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        uint32_t loopCount = tileNum * BUFFER_NUM;

        for (uint32_t i = 0; i < loopCount; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    /*
     * GM -> UB
     */
    __aicore__ inline void CopyIn(uint32_t progress)
    {
        LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();

        DataCopy(
            xLocal,
            xGm[progress * tileLength],
            tileLength);

        DataCopy(
            yLocal,
            yGm[progress * tileLength],
            tileLength);

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    /*
     * z = x - y
     */
    __aicore__ inline void Compute(uint32_t progress)
    {
        LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        LocalTensor<T> yLocal = inQueueY.DeQue<T>();

        LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();

        AscendC::Sub(
            zLocal,
            xLocal,
            yLocal,
            tileLength);

        outQueueZ.EnQue(zLocal);

        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    /*
     * UB -> GM
     */
    __aicore__ inline void CopyOut(uint32_t progress)
    {
        LocalTensor<T> zLocal = outQueueZ.DeQue<T>();

        DataCopy(
            zGm[progress * tileLength],
            zLocal,
            tileLength);

        outQueueZ.FreeTensor(zLocal);
    }

private:
    TPipe pipe;

    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueX;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueY;
    TQue<QuePosition::VECOUT, BUFFER_NUM> outQueueZ;

    GlobalTensor<T> xGm;
    GlobalTensor<T> yGm;
    GlobalTensor<T> zGm;

    uint32_t blockLength;
    uint32_t tileNum;
    uint32_t tileLength;
};


/*
 * Device Kernel
 *
 * dtype:
 * 0 -> float32
 * 1 -> float16
 */
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    if (tiling.dataType == 0) {
        KernelSub<float> op;
        op.Init(
            x,
            y,
            z,
            tiling.totalLength,
            tiling.tileNum);
        op.Process();
    } else {
        KernelSub<half> op;
        op.Init(
            x,
            y,
            z,
            tiling.totalLength,
            tiling.tileNum);
        op.Process();
    }
}


/*
 * Host 侧 Kernel 启动入口
 */
extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    // 本题 shape 固定为 (8, 2048)
    // 这里仍然从 TensorInfo 中动态计算元素总数
    uint32_t totalLength = 1;

    for (int32_t i = 0; i < info_x.tensors[0].numDims; i++) {
        totalLength *=
            static_cast<uint32_t>(
                info_x.tensors[0].shape[i]);
    }

    /*
     * 尽量使用 8 个 Vector Core。
     * 为避免 totalLength 无法整除 coreNum，
     * 从 8/4/2/1 中选一个。
     */
    uint32_t blockNum = 1;

    if (availableCoreNum >= 8 && totalLength % 8 == 0) {
        blockNum = 8;
    } else if (availableCoreNum >= 4 && totalLength % 4 == 0) {
        blockNum = 4;
    } else if (availableCoreNum >= 2 && totalLength % 2 == 0) {
        blockNum = 2;
    }

    SubCustomTilingData tiling;

    tiling.totalLength = totalLength;
    tiling.tileNum = TILE_NUM;

    // 题面规定：
    // dtype 0 = fp32
    // dtype 1 = fp16
    tiling.dataType =
        static_cast<uint32_t>(
            info_x.tensors[0].dtype);

    sub_custom<<<blockNum, nullptr, stream>>>(
        x,
        y,
        z,
        tiling);
}