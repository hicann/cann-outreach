#include <cmath>
#include "kernel_operator.h"

/*
 * Sub Kernel — Ascend C Direct Invocation
 * z = x - y
 *
 * 编译目标：dav-2201
 * 参考：华为官方 Ascend C 保姆级教程 Add 算子模式
 */

// ============================================================================
// 1. Tiling 参数结构体
// ============================================================================
struct SubCustomTilingData {
    int32_t totalElements;   // 总元素数
    int32_t dataType;        // 0=fp32, 1=fp16
};

// ============================================================================
// 2. Kernel 主体类
// ============================================================================
constexpr int32_t BUFFER_NUM  = 2;
constexpr int32_t TILE_LENGTH = 2048; // 每块元素数（固定值，32B 对齐）

// 对齐 helper：把 n 向上对齐到 align 的倍数
__aicore__ inline int32_t AlignUp(int32_t n, int32_t align) {
    return ((n + align - 1) / align) * align;
}

template <typename DTYPE>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    // Init
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, int32_t totalElements)
    {
        // --- Pipe & Queue ---
        pipe.InitBuffer(queueX_, BUFFER_NUM, sizeof(DTYPE) * TILE_LENGTH);
        pipe.InitBuffer(queueY_, BUFFER_NUM, sizeof(DTYPE) * TILE_LENGTH);
        pipe.InitBuffer(queueZ_, BUFFER_NUM, sizeof(DTYPE) * TILE_LENGTH);

        // --- GlobalTensor ---
        xGm_.SetGlobalBuffer((__gm__ DTYPE*)x);
        yGm_.SetGlobalBuffer((__gm__ DTYPE*)y);
        zGm_.SetGlobalBuffer((__gm__ DTYPE*)z);

        // --- 32B 向量化对齐的元素数 ---
        // fp32: 32/4=8, fp16: 32/2=16
        alignElements_ = 32 / sizeof(DTYPE);

        // --- Tiling ---
        blockNum_ = AscendC::GetBlockNum();
        blockIdx_ = (int32_t)AscendC::GetBlockIdx();

        // perCore 按核均分，然后**向上对齐**到 alignElements_
        int32_t perCoreRaw = (totalElements + blockNum_ - 1) / blockNum_;
        perCore_ = AlignUp(perCoreRaw, alignElements_);

        coreOffset_ = perCore_ * blockIdx_;
        // 边界保护：如果这个核的起始位置已经超出 totalElements，coreLen_ 设为 0
        if (coreOffset_ >= totalElements) {
            coreLen_ = 0;
        } else {
            int32_t coreLenRaw = (coreOffset_ + perCore_ > totalElements)
                                  ? (totalElements - coreOffset_)
                                  : perCore_;
            coreLen_ = AlignUp(coreLenRaw, alignElements_);
        }

        tileLen_ = TILE_LENGTH;
        tileNum_ = (coreLen_ + tileLen_ - 1) / tileLen_;
    }

    // Process
    __aicore__ inline void Process()
    {
        if (coreLen_ <= 0) {
            return;  // 这个核没有活干
        }

        for (int32_t i = 0; i < tileNum_; ++i) {
            CopyIn(i);
            Compute();
            CopyOut();
        }
    }

private:
    // --- Pipe / Queue ---
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN,  BUFFER_NUM> queueX_;
    AscendC::TQue<AscendC::TPosition::VECIN,  BUFFER_NUM> queueY_;
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_NUM> queueZ_;

    // --- GlobalTensor ---
    AscendC::GlobalTensor<DTYPE> xGm_;
    AscendC::GlobalTensor<DTYPE> yGm_;
    AscendC::GlobalTensor<DTYPE> zGm_;

    // --- tiling 成员 ---
    int32_t blockNum_     = 0;
    int32_t blockIdx_     = 0;
    int32_t perCore_      = 0;
    int32_t coreOffset_   = 0;
    int32_t coreLen_      = 0;
    int32_t tileLen_      = TILE_LENGTH;
    int32_t tileNum_      = 0;
    int32_t alignElements_= 1;
    int32_t currentOutIdx_= 0;

    // --- CopyIn ---
    __aicore__ inline void CopyIn(int32_t tileIdx)
    {
        int32_t offset = coreOffset_ + tileIdx * tileLen_;
        // 最后一块可能不足 tileLen_，对齐处理
        int32_t rawLen = (offset + tileLen_ > coreOffset_ + coreLen_)
                         ? (coreOffset_ + coreLen_ - offset)
                         : tileLen_;
        currentRealLen_ = AlignUp(rawLen, alignElements_);

        AscendC::LocalTensor<DTYPE> xLocal = queueX_.AllocTensor<DTYPE>();
        AscendC::LocalTensor<DTYPE> yLocal = queueY_.AllocTensor<DTYPE>();

        AscendC::DataCopy(xLocal, xGm_[offset], currentRealLen_);
        AscendC::DataCopy(yLocal, yGm_[offset], currentRealLen_);

        queueX_.EnQue(xLocal);
        queueY_.EnQue(yLocal);
    }

    // --- Compute ---
    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<DTYPE> xLocal = queueX_.DeQue<DTYPE>();
        AscendC::LocalTensor<DTYPE> yLocal = queueY_.DeQue<DTYPE>();
        AscendC::LocalTensor<DTYPE> zLocal = queueZ_.AllocTensor<DTYPE>();

        AscendC::Sub(zLocal, xLocal, yLocal, currentRealLen_);

        queueZ_.EnQue(zLocal);
        queueX_.FreeTensor(xLocal);
        queueY_.FreeTensor(yLocal);
    }

    // --- CopyOut ---
    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<DTYPE> zLocal = queueZ_.DeQue<DTYPE>();

        int32_t offset = coreOffset_ + currentOutIdx_ * tileLen_;
        AscendC::DataCopy(zGm_[offset], zLocal, currentRealLen_);

        queueZ_.FreeTensor(zLocal);
        currentOutIdx_++;
    }

    // 当前 tile 的对齐后长度
    int32_t currentRealLen_ = 0;
};

// ============================================================================
// 3. Kernel 入口
// ============================================================================
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    if (tiling.dataType == 0) {
        KernelSub<float> op;
        op.Init(x, y, z, tiling.totalElements);
        op.Process();
    } else if (tiling.dataType == 1) {
        KernelSub<half> op;
        op.Init(x, y, z, tiling.totalElements);
        op.Process();
    }
}

// ============================================================================
// 4. host 侧 launch
// ============================================================================
extern "C" void run_kernel(GM_ADDR x,
                           const TensorGroupInfo& info_x,
                           GM_ADDR y,
                           const TensorGroupInfo& info_y,
                           GM_ADDR z,
                           const TensorGroupInfo& info_z,
                           int64_t availableCoreNum,
                           aclrtStream stream)
{
    const TensorInfo& tx = info_x.tensors[0];
    int32_t totalElements = 1;
    for (int64_t i = 0; i < tx.numDims; ++i) {
        totalElements *= (int32_t)tx.shape[i];
    }

    SubCustomTilingData tiling;
    tiling.totalElements = totalElements;
    tiling.dataType      = tx.dtype;

    int32_t blockNum = (int32_t)std::min(availableCoreNum, (int64_t)totalElements);
    sub_custom<<<blockNum, nullptr, stream>>>(x, y, z, tiling);
}
