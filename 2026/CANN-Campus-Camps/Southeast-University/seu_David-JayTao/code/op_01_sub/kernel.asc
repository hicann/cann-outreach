#include <cmath>
#include "kernel_operator.h"

// ============================================================================
// 基本配置
// ============================================================================

// Double Buffer：每个 Queue 同时准备两块 Local Memory
constexpr uint32_t BUFFER_NUM = 2;

// 每个 AI Core 再切成 8 个 tile
constexpr uint32_t TILE_NUM = 8;

// ============================================================================
// Tiling 参数：Host 告诉 Kernel “数据怎么切”
// ============================================================================
struct SubCustomTilingData {
    uint32_t totalLength;
    uint32_t tileNum;
};

// ============================================================================
// Kernel 主体
// ============================================================================
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    // ------------------------------------------------------------------------
    // 初始化：
    // 1. 算出当前 AI Core 要负责多少数据
    // 2. 找到当前 Core 对应的 GM 起始地址
    // 3. 给三个 Queue 分配 Local Memory
    // ------------------------------------------------------------------------
    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        uint32_t totalLength,
        uint32_t tileNum)
    {
        // 整个 Tensor 被所有启动的 AI Core 平分
        this->blockLength = totalLength / AscendC::GetBlockNum();

        // 一个 Core 内部再切成 tile
        this->tileNum = tileNum;

        // Double Buffer 后，每一个真正处理的小块长度
        this->tileLength =
            this->blockLength / this->tileNum / BUFFER_NUM;

        // 当前 Core 的编号
        uint32_t blockIdx = AscendC::GetBlockIdx();

        // 每个 Core 只看自己负责的那一段 Global Memory
        xGm.SetGlobalBuffer(
            (__gm__ T *)x + blockIdx * this->blockLength,
            this->blockLength);

        yGm.SetGlobalBuffer(
            (__gm__ T *)y + blockIdx * this->blockLength,
            this->blockLength);

        zGm.SetGlobalBuffer(
            (__gm__ T *)z + blockIdx * this->blockLength,
            this->blockLength);

        // 给输入 / 输出 Queue 分配 Local Memory
        pipe.InitBuffer(
            inQueueX,
            BUFFER_NUM,
            this->tileLength * sizeof(T));

        pipe.InitBuffer(
            inQueueY,
            BUFFER_NUM,
            this->tileLength * sizeof(T));

        pipe.InitBuffer(
            outQueueZ,
            BUFFER_NUM,
            this->tileLength * sizeof(T));
    }

    // ------------------------------------------------------------------------
    // 整个流水线：
    // CopyIn -> Compute -> CopyOut
    // ------------------------------------------------------------------------
    __aicore__ inline void Process()
    {
        // tileNum=8，Double Buffer=2
        // 所以当前 Core 总共实际处理 16 个小块
        int32_t loopCount = this->tileNum * BUFFER_NUM;

        for (int32_t i = 0; i < loopCount; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    // ------------------------------------------------------------------------
    // Stage 1：GM -> Local Memory
    // ------------------------------------------------------------------------
    __aicore__ inline void CopyIn(int32_t progress)
    {
        // 从输入 Queue 申请两块 LocalTensor
        AscendC::LocalTensor<T> xLocal =
            inQueueX.AllocTensor<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.AllocTensor<T>();

        // 把当前 tile 从 Global Memory 搬到 Local Memory
        AscendC::DataCopy(
            xLocal,
            xGm[progress * this->tileLength],
            this->tileLength);

        AscendC::DataCopy(
            yLocal,
            yGm[progress * this->tileLength],
            this->tileLength);

        // 搬完以后放进 VECIN Queue
        // 告诉 Compute：“数据准备好了”
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    // ------------------------------------------------------------------------
    // Stage 2：真正的 z = x - y
    // ------------------------------------------------------------------------
    __aicore__ inline void Compute(int32_t progress)
    {
        // 从输入 Queue 取出已经搬好的数据
        AscendC::LocalTensor<T> xLocal =
            inQueueX.DeQue<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.DeQue<T>();

        // 给结果申请一块 LocalTensor
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.AllocTensor<T>();

        // ================================================================
        // 整道 Sub 题最核心的一行
        // zLocal = xLocal - yLocal
        // ================================================================
        AscendC::Sub(
            zLocal,
            xLocal,
            yLocal,
            this->tileLength);

        // 结果放进输出 Queue
        // 告诉 CopyOut：“结果算好了”
        outQueueZ.EnQue(zLocal);

        // 输入 LocalTensor 用完，释放
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    // ------------------------------------------------------------------------
    // Stage 3：Local Memory -> GM
    // ------------------------------------------------------------------------
    __aicore__ inline void CopyOut(int32_t progress)
    {
        // 从输出 Queue 取出计算结果
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.DeQue<T>();

        // 把结果搬回 Global Memory
        AscendC::DataCopy(
            zGm[progress * this->tileLength],
            zLocal,
            this->tileLength);

        // LocalTensor 用完释放
        outQueueZ.FreeTensor(zLocal);
    }

private:
    // 管理 Local Memory 的 Pipe
    AscendC::TPipe pipe;

    // CopyIn -> Compute 的输入队列
    AscendC::TQue<
        AscendC::TPosition::VECIN,
        BUFFER_NUM> inQueueX, inQueueY;

    // Compute -> CopyOut 的输出队列
    AscendC::TQue<
        AscendC::TPosition::VECOUT,
        BUFFER_NUM> outQueueZ;

    // 三个 Global Memory Tensor
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    // Tiling 参数
    uint32_t blockLength = 0;
    uint32_t tileNum = 0;
    uint32_t tileLength = 0;
};

// ============================================================================
// NPU Kernel 入口
// ============================================================================

template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    KernelSub<T> op;

    op.Init(
        x,
        y,
        z,
        tiling.totalLength,
        tiling.tileNum);

    op.Process();
}

// ============================================================================
// Host 侧 Kernel 启动函数
// ============================================================================

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    // ------------------------------------------------------------------------
    // 1. 根据 shape 计算 Tensor 总元素数
    // (8, 2048) -> 16384
    // ------------------------------------------------------------------------
    uint32_t totalLength = 1;

    for (int64_t i = 0;
         i < info_x.tensors[0].numDims;
         i++) {
        totalLength *=
            static_cast<uint32_t>(
                info_x.tensors[0].shape[i]);
    }

    // ------------------------------------------------------------------------
    // 2. 选择 AI Core 数
    //
    // 这个题固定 shape=(8, 2048)，优先使用 8 个 Core
    // ------------------------------------------------------------------------
    uint32_t blockNum = 1;

    if (availableCoreNum >= 8) {
        blockNum = 8;
    } else if (availableCoreNum >= 4) {
        blockNum = 4;
    } else if (availableCoreNum >= 2) {
        blockNum = 2;
    }

    // ------------------------------------------------------------------------
    // 3. Host -> Kernel 的 Tiling 参数
    // ------------------------------------------------------------------------
    SubCustomTilingData tiling = {
        totalLength,
        TILE_NUM
    };

    // ------------------------------------------------------------------------
    // 4. 根据 dtype 启动不同模板 Kernel
    //
    // dtype:
    // 0 = float32
    // 1 = float16
    // ------------------------------------------------------------------------
    int32_t dtype = info_x.tensors[0].dtype;

    if (dtype == 0) {
        sub_custom<float>
            <<<blockNum, nullptr, stream>>>(
                x,
                y,
                z,
                tiling);
    } else if (dtype == 1) {
        sub_custom<half>
            <<<blockNum, nullptr, stream>>>(
                x,
                y,
                z,
                tiling);
    }
}