#include <cmath>
#include "kernel_operator.h"

// ============================================================
// Tiling 参数
// ============================================================

struct SubCustomTilingData {
    uint32_t totalLength;   // 总元素个数
    uint32_t tileNum;       // 单核内部切多少组
};

constexpr uint32_t BUFFER_NUM = 2;
constexpr uint32_t QUEUE_DEPTH = 1;


// ============================================================
// KernelSub
// z = x - y
// ============================================================

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        const SubCustomTilingData& tiling)
    {
        uint32_t totalLength = tiling.totalLength;

        // 每个核负责的元素数
        this->blockLength =
            totalLength / AscendC::GetBlockNum();

        this->tileNum = tiling.tileNum;

        // 因为使用双 Buffer，
        // 实际循环 tileNum * BUFFER_NUM 次
        this->tileLength =
            this->blockLength / this->tileNum / BUFFER_NUM;

        // 每个核负责不同的 GM 区域
        uint32_t offset =
            this->blockLength * AscendC::GetBlockIdx();

        xGm.SetGlobalBuffer(
            (__gm__ T*)x + offset,
            this->blockLength);

        yGm.SetGlobalBuffer(
            (__gm__ T*)y + offset,
            this->blockLength);

        zGm.SetGlobalBuffer(
            (__gm__ T*)z + offset,
            this->blockLength);

        // 分配 UB Buffer
        pipe.InitBuffer(
            inQueueX,
            BUFFER_NUM,
            this->tileLength * sizeof(T));

        pipe.InitBuffer(
            inQueueY,
            BUFFER_NUM,
            this->tileLength * sizeof(T));

        pipe.InitBuffer(
            outQueueZ,
            BUFFER_NUM,
            this->tileLength * sizeof(T));
    }


    __aicore__ inline void Process()
    {
        // tileNum 个 tile，每个 tile 又对应两个 buffer
        int32_t loopCount =
            this->tileNum * BUFFER_NUM;

        for (int32_t i = 0; i < loopCount; ++i) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }


private:

    // ========================================================
    // GM -> UB
    // ========================================================

    __aicore__ inline void CopyIn(int32_t progress)
    {
        AscendC::LocalTensor<T> xLocal =
            inQueueX.AllocTensor<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.AllocTensor<T>();

        uint32_t offset =
            progress * this->tileLength;

        AscendC::DataCopy(
            xLocal,
            xGm[offset],
            this->tileLength);

        AscendC::DataCopy(
            yLocal,
            yGm[offset],
            this->tileLength);

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }


    // ========================================================
    // z = x - y
    // ========================================================

    __aicore__ inline void Compute(int32_t progress)
    {
        AscendC::LocalTensor<T> xLocal =
            inQueueX.DeQue<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.DeQue<T>();

        AscendC::LocalTensor<T> zLocal =
            outQueueZ.AllocTensor<T>();

        // 核心计算
        AscendC::Sub(
            zLocal,
            xLocal,
            yLocal,
            this->tileLength);

        outQueueZ.EnQue<T>(zLocal);

        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }


    // ========================================================
    // UB -> GM
    // ========================================================

    __aicore__ inline void CopyOut(int32_t progress)
    {
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.DeQue<T>();

        uint32_t offset =
            progress * this->tileLength;

        AscendC::DataCopy(
            zGm[offset],
            zLocal,
            this->tileLength);

        outQueueZ.FreeTensor(zLocal);
    }


private:
    AscendC::TPipe pipe;

    AscendC::TQue<
        AscendC::QuePosition::VECIN,
        QUEUE_DEPTH> inQueueX, inQueueY;

    AscendC::TQue<
        AscendC::QuePosition::VECOUT,
        QUEUE_DEPTH> outQueueZ;

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    uint32_t blockLength;
    uint32_t tileNum;
    uint32_t tileLength;
};


// ============================================================
// Ascend C Kernel 入口
// ============================================================

template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    KernelSub<T> op;

    op.Init(
        x,
        y,
        z,
        tiling);

    op.Process();
}


// ============================================================
// Host 启动函数
// ============================================================

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,

    GM_ADDR y,
    const TensorGroupInfo& info_y,

    GM_ADDR z,
    const TensorGroupInfo& info_z,

    int64_t availableCoreNum,
    aclrtStream stream)
{
    /*
     * 题目固定 shape:
     *
     *   (8, 2048)
     *
     * totalLength = 16384
     *
     * 使用 8 个核：
     *
     * 每核 = 16384 / 8
     *      = 2048 elements
     */

    constexpr uint32_t blockDim = 8;

    // --------------------------------------------------------
    // 计算 Tensor 总元素数
    // --------------------------------------------------------

    const TensorInfo& t0 =
        info_x.tensors[0];

    int64_t totalLength = 1;

    for (int64_t i = 0; i < t0.numDims; ++i) {
        totalLength *= t0.shape[i];
    }

    // dtype:
    // 0 = float32
    // 1 = float16
    int32_t dtype = t0.dtype;

    /*
     * 每个核：
     *
     * blockLength = 2048
     *
     * tileNum = 8
     * BUFFER_NUM = 2
     *
     * tileLength
     * = 2048 / 8 / 2
     * = 128
     *
     * fp32:
     * 128 * 4 = 512 Bytes
     *
     * fp16:
     * 128 * 2 = 256 Bytes
     *
     * 都满足 32 Byte 对齐。
     */
    uint32_t tileNum = 8;

    SubCustomTilingData tiling = {
        static_cast<uint32_t>(totalLength),
        tileNum
    };


    // --------------------------------------------------------
    // 根据 dtype 启动不同模板 Kernel
    // --------------------------------------------------------

    if (dtype == 1) {

        // float16
        sub_custom<half>
            <<<blockDim, nullptr, stream>>>(
                x,
                y,
                z,
                tiling);

    } else {

        // float32
        sub_custom<float>
            <<<blockDim, nullptr, stream>>>(
                x,
                y,
                z,
                tiling);
    }
}