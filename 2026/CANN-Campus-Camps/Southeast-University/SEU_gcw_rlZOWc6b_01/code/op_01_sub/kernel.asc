#include <cmath>
#include "kernel_operator.h"

struct SubCustomTilingData {
    int64_t totalLength;
    int64_t tileNum;
};

class KernelSub {
public:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> xQue;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> yQue;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> zQue;
    int64_t blockSize;

    __aicore__ void Init(SubCustomTilingData tiling) {
        blockSize = tiling.totalLength / tiling.tileNum;
        pipe.InitBuffer(xQue, 1, blockSize * sizeof(float));
        pipe.InitBuffer(yQue, 1, blockSize * sizeof(float));
        pipe.InitBuffer(zQue, 1, blockSize * sizeof(float));
    }

    __aicore__ void Process(GM_ADDR x, GM_ADDR y, GM_ADDR z) {
        int64_t blockIdx = AscendC::GetBlockIdx();

        AscendC::GlobalTensor<float> xGm, yGm, zGm;
        xGm.SetGlobalBuffer((__gm__ float*)x + blockIdx * blockSize, blockSize);
        yGm.SetGlobalBuffer((__gm__ float*)y + blockIdx * blockSize, blockSize);
        zGm.SetGlobalBuffer((__gm__ float*)z + blockIdx * blockSize, blockSize);

        // CopyIn: GM -> UB
        AscendC::LocalTensor<float> xLocal = xQue.AllocTensor<float>();
        AscendC::LocalTensor<float> yLocal = yQue.AllocTensor<float>();
        AscendC::DataCopy(xLocal, xGm, blockSize);
        AscendC::DataCopy(yLocal, yGm, blockSize);
        xQue.EnQue(xLocal);
        yQue.EnQue(yLocal);

        // Compute: DeQue input, Alloc output, vector sub, EnQue
        AscendC::LocalTensor<float> xBuf = xQue.DeQue<float>();
        AscendC::LocalTensor<float> yBuf = yQue.DeQue<float>();
        AscendC::LocalTensor<float> zBuf = zQue.AllocTensor<float>();

        AscendC::Sub(zBuf, xBuf, yBuf, blockSize);

        xQue.FreeTensor(xBuf);
        yQue.FreeTensor(yBuf);
        zQue.EnQue(zBuf);

        // CopyOut: UB -> GM
        AscendC::LocalTensor<float> zResult = zQue.DeQue<float>();
        AscendC::DataCopy(zGm, zResult, blockSize);
        zQue.FreeTensor(zResult);
    }
};

__global__ __aicore__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling) {
    KernelSub op;
    op.Init(tiling);
    op.Process(x, y, z);
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream) {
    int64_t totalLength = info_x.tensors[0].shape[0] * info_x.tensors[0].shape[1];
    int64_t maxCoreNum = info_x.tensors[0].shape[0];

    int64_t cap = (availableCoreNum > 0) ? std::min(availableCoreNum, maxCoreNum) : 1;
    if (cap <= 0) cap = 1;

    // 归一到 <= cap 的最大 2 的幂，保证整除和对齐
    int64_t tileNum = 1;
    while (tileNum * 2 <= cap) {
        tileNum *= 2;
    }

    SubCustomTilingData tiling;
    tiling.totalLength = totalLength;
    tiling.tileNum = tileNum;

    sub_custom<<<tileNum, nullptr, stream>>>(x, y, z, tiling);
}
