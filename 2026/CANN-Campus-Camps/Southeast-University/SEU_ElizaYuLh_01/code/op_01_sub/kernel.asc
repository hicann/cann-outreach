#include <cstdint>
#include "kernel_operator.h"

/*
 * Sub operator: z = x - y
 *
 * Input/output layout in this exercise:
 *   x: (8, 2048)
 *   y: (8, 2048)
 *   z: (8, 2048)
 *
 * The implementation uses the standard Ascend C vector programming model:
 *   GM -> VECIN(UB) -> Sub -> VECOUT(UB) -> GM
 *
 * This file is #included by main.asc, so it must not contain main() or
 * include guards.
 */

struct SubCustomTilingData {
    uint32_t totalLength;   // total number of elements
    uint32_t blockLength;   // number of elements handled by one vector core
    uint32_t tileLength;    // number of elements handled by one UB tile
};

namespace {
constexpr uint32_t BUFFER_NUM = 1;

// Keep the tile size reasonably small so that the three UB tensors fit in UB.
// 512 elements = 2 KiB for FP32 and 1 KiB for FP16 per tensor.
constexpr uint32_t DEFAULT_TILE_LENGTH = 512;

// Pick the largest power-of-two divisor of totalLength that does not exceed
// the available vector-core count. For the exercise's 8*2048=16384 elements,
// this gives 8/16/32 cores -> 2048/1024/512 elements per core respectively.
static uint32_t ChooseBlockNum(uint32_t totalLength, int64_t availableCoreNum)
{
    if (totalLength == 0 || availableCoreNum <= 0) {
        return 1;
    }

    uint32_t limit = static_cast<uint32_t>(availableCoreNum);
    uint32_t best = 1;
    for (uint32_t n = 1; n <= limit; n <<= 1) {
        if ((totalLength % n) == 0) {
            best = n;
        }
        if (n > (limit >> 1)) {
            break;
        }
    }
    return best;
}

static uint32_t CeilDiv(uint32_t a, uint32_t b)
{
    return (a + b - 1) / b;
}
} // namespace

/* ============================== FP32 ============================== */
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                uint32_t blockLength, uint32_t tileLength)
    {
        const uint32_t blockIdx = static_cast<uint32_t>(AscendC::GetBlockIdx());

        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x) + blockIdx * blockLength,
                            blockLength);
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(y) + blockIdx * blockLength,
                            blockLength);
        zGm.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(z) + blockIdx * blockLength,
                            blockLength);

        this->blockLength = blockLength;
        this->tileLength = tileLength;

        pipe.InitBuffer(inQueueX, BUFFER_NUM, tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // Every block owns a contiguous range of blockLength elements.
        // The host-side tiling chooses blockLength so that it is divisible by
        // DEFAULT_TILE_LENGTH for the assignment's input shape.
        uint32_t offset = 0;
        while (offset < blockLength) {
            uint32_t currentLength = blockLength - offset;
            if (currentLength > tileLength) {
                currentLength = tileLength;
            }

            CopyIn(offset, currentLength);
            Compute(currentLength);
            CopyOut(offset, currentLength);
            offset += currentLength;
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset, uint32_t length)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();

        AscendC::DataCopy(xLocal, xGm[offset], length);
        AscendC::DataCopy(yLocal, yGm[offset], length);

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t length)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();

        AscendC::Sub(zLocal, xLocal, yLocal, length);

        outQueueZ.EnQue(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t length)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopy(zGm[offset], zLocal, length);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, BUFFER_NUM> inQueueX;
    AscendC::TQue<AscendC::QuePosition::VECIN, BUFFER_NUM> inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, BUFFER_NUM> outQueueZ;

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    uint32_t blockLength = 0;
    uint32_t tileLength = DEFAULT_TILE_LENGTH;
};

extern "C" __global__ __vector__ __aicore__ void sub_custom(
    GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t blockLength, uint32_t tileLength)
{
    KernelSub<float> op;
    op.Init(x, y, z, blockLength, tileLength);
    op.Process();
}

extern "C" __global__ __vector__ __aicore__ void sub_custom_f16(
    GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t blockLength, uint32_t tileLength)
{
    KernelSub<half> op;
    op.Init(x, y, z, blockLength, tileLength);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                            GM_ADDR y, const TensorGroupInfo& info_y,
                            GM_ADDR z, const TensorGroupInfo& info_z,
                            int64_t availableCoreNum, aclrtStream stream)
{
    (void)info_y;
    (void)info_z;

    // This exercise has exactly one input tensor for x/y and one output tensor
    // for z. Compute the total element count from the runtime shape instead of
    // hard-coding 8*2048.
    if (info_x.numTensors <= 0 || info_x.tensors == nullptr ||
        info_x.tensors[0].numDims <= 0 || info_x.tensors[0].shape == nullptr) {
        return;
    }

    uint64_t totalLength64 = 1;
    for (int64_t i = 0; i < info_x.tensors[0].numDims; ++i) {
        if (info_x.tensors[0].shape[i] <= 0) {
            return;
        }
        totalLength64 *= static_cast<uint64_t>(info_x.tensors[0].shape[i]);
    }

    if (totalLength64 == 0 || totalLength64 > 0xFFFFFFFFULL) {
        return;
    }

    const uint32_t totalLength = static_cast<uint32_t>(totalLength64);
    const uint32_t blockNum = ChooseBlockNum(totalLength, availableCoreNum);
    const uint32_t blockLength = CeilDiv(totalLength, blockNum);

    // For this assignment totalLength=16384, so the selected blockLength is
    // always a multiple of 512 for the usual 8/16/32 Vector Core devices.
    // For a smaller tensor, use the whole tensor as one block.
    uint32_t tileLength = DEFAULT_TILE_LENGTH;
    if (blockLength < tileLength) {
        tileLength = blockLength;
    }

    const int32_t dtype = info_x.tensors[0].dtype;

    // The provided verifier uses FP32. FP16 is implemented as well because the
    // problem specification allows both float32 and float16.
    if (dtype == 0) {
        sub_custom<<<blockNum, nullptr, stream>>>(x, y, z, blockLength, tileLength);
    } else if (dtype == 1) {
        sub_custom_f16<<<blockNum, nullptr, stream>>>(x, y, z, blockLength, tileLength);
    }
}
