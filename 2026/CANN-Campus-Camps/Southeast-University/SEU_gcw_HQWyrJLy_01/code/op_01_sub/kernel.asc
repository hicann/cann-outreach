#include <cmath>
#include <cstdint>
#include "kernel_operator.h"

using namespace AscendC;

// Double Buffer：每个队列准备两块缓存
constexpr uint32_t BUFFER_NUM = 2;

// 每个 AI Core 内部划分为 8 个 tile
constexpr uint32_t TILE_NUM = 8;


// ============================================================
// 1. Tiling 参数结构体
// ============================================================

struct SubCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileNum;
};


// ============================================================
// 2. Sub 算子主体
// ============================================================

template <typename T>
class KernelSub
{
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        uint32_t totalLength,
        uint32_t tileNum)
    {
        // ----------------------------------------------------
        // 第一级切分：
        // 把整个 Tensor 分给不同的 AI Core
        // ----------------------------------------------------
        this->blockLength = totalLength / AscendC::GetBlockNum();

        // ----------------------------------------------------
        // 第二级切分：
        // 每个 Core 再分成 tile，并使用 Double Buffer
        // ----------------------------------------------------
        this->tileNum = tileNum;

        this->tileLength =
            this->blockLength / this->tileNum / BUFFER_NUM;

        // ----------------------------------------------------
        // 每个 Core 只绑定自己负责的 GM 数据区域
        // ----------------------------------------------------
        xGm.SetGlobalBuffer(
            (__gm__ T *)x +
                this->blockLength * AscendC::GetBlockIdx(),
            this->blockLength);

        yGm.SetGlobalBuffer(
            (__gm__ T *)y +
                this->blockLength * AscendC::GetBlockIdx(),
            this->blockLength);

        zGm.SetGlobalBuffer(
            (__gm__ T *)z +
                this->blockLength * AscendC::GetBlockIdx(),
            this->blockLength);

        // ----------------------------------------------------
        // 为输入 / 输出 Queue 分配 Local Memory
        // ----------------------------------------------------
        pipe.InitBuffer(
            inQueueX,
            BUFFER_NUM,
            this->tileLength * sizeof(T));

        pipe.InitBuffer(
            inQueueY,
            BUFFER_NUM,
            this->tileLength * sizeof(T));

        pipe.InitBuffer(
            outQueueZ,
            BUFFER_NUM,
            this->tileLength * sizeof(T));
    }


    // ========================================================
    // 核心处理流程
    // ========================================================

    __aicore__ inline void Process()
    {
        // 因为使用了 Double Buffer，
        // 实际循环次数为 tileNum * 2
        int32_t loopCount = this->tileNum * BUFFER_NUM;

        for (int32_t i = 0; i < loopCount; ++i)
        {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }


private:

    // ========================================================
    // 3. CopyIn
    // GM -> Local Memory
    // ========================================================

    __aicore__ inline void CopyIn(int32_t progress)
    {
        // 从输入队列申请 LocalTensor
        LocalTensor<T> xLocal =
            inQueueX.AllocTensor<T>();

        LocalTensor<T> yLocal =
            inQueueY.AllocTensor<T>();

        // 把当前 tile 从 GM 搬到 Local Memory
        DataCopy(
            xLocal,
            xGm[progress * this->tileLength],
            this->tileLength);

        DataCopy(
            yLocal,
            yGm[progress * this->tileLength],
            this->tileLength);

        // 放入输入队列，交给 Compute 使用
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }


    // ========================================================
    // 4. Compute
    // z = x - y
    // ========================================================

    __aicore__ inline void Compute(int32_t progress)
    {
        // 从输入 Queue 中获取数据
        LocalTensor<T> xLocal =
            inQueueX.DeQue<T>();

        LocalTensor<T> yLocal =
            inQueueY.DeQue<T>();

        // 为输出结果申请 LocalTensor
        LocalTensor<T> zLocal =
            outQueueZ.AllocTensor<T>();

        // ----------------------------------------------------
        // 整道题真正的核心
        //
        // z = x - y
        // ----------------------------------------------------
        AscendC::Sub(
            zLocal,
            xLocal,
            yLocal,
            this->tileLength);

        // 把结果放入输出 Queue
        outQueueZ.EnQue(zLocal);

        // 输入数据已经用完，释放
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }


    // ========================================================
    // 5. CopyOut
    // Local Memory -> GM
    // ========================================================

    __aicore__ inline void CopyOut(int32_t progress)
    {
        // 从输出 Queue 获取结果
        LocalTensor<T> zLocal =
            outQueueZ.DeQue<T>();

        // 把结果写回 z 的 GM
        DataCopy(
            zGm[progress * this->tileLength],
            zLocal,
            this->tileLength);

        // 释放输出 LocalTensor
        outQueueZ.FreeTensor(zLocal);
    }


private:

    // --------------------------------------------------------
    // Ascend C 流水线管理器
    // --------------------------------------------------------
    TPipe pipe;

    // --------------------------------------------------------
    // 两个输入 Queue
    // --------------------------------------------------------
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueX;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueY;

    // --------------------------------------------------------
    // 一个输出 Queue
    // --------------------------------------------------------
    TQue<TPosition::VECOUT, BUFFER_NUM> outQueueZ;

    // --------------------------------------------------------
    // Global Memory Tensor
    // --------------------------------------------------------
    GlobalTensor<T> xGm;
    GlobalTensor<T> yGm;
    GlobalTensor<T> zGm;

    // --------------------------------------------------------
    // Tiling 参数
    // --------------------------------------------------------
    uint32_t blockLength;
    uint32_t tileNum;
    uint32_t tileLength;
};


// ============================================================
// 6. NPU Kernel 入口
// ============================================================

template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    KernelSub<T> op;

    op.Init(
        x,
        y,
        z,
        tiling.totalLength,
        tiling.tileNum);

    op.Process();
}


// ============================================================
// 7. Host 侧 Kernel 启动入口
// ============================================================

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    // --------------------------------------------------------
    // 计算 Tensor 总元素数量
    //
    // 对本题：
    // 8 * 2048 = 16384
    // --------------------------------------------------------
    int64_t totalLength = 1;

    for (int64_t i = 0;
         i < info_x.tensors[0].numDims;
         ++i)
    {
        totalLength *=
            info_x.tensors[0].shape[i];
    }

    // --------------------------------------------------------
    // 根据实际可用 AI Core 数量确定 blockNum
    //
    // 对 (8, 2048) 来说：
    // 优先使用 8 个 Core
    // --------------------------------------------------------
    uint32_t blockNum = 1;

    if (availableCoreNum >= 8)
    {
        blockNum = 8;
    }
    else if (availableCoreNum >= 4)
    {
        blockNum = 4;
    }
    else if (availableCoreNum >= 2)
    {
        blockNum = 2;
    }

    // --------------------------------------------------------
    // 准备 tiling 参数
    // --------------------------------------------------------
    SubCustomTilingData tiling = {
        static_cast<uint32_t>(totalLength),
        TILE_NUM
    };

    // --------------------------------------------------------
    // dtype:
    //
    // 0 = fp32
    // 1 = fp16
    //
    // 根据输入类型启动不同模板 Kernel
    // --------------------------------------------------------
    int32_t dtype =
        info_x.tensors[0].dtype;

    if (dtype == 0)
    {
        sub_custom<float>
            <<<blockNum, nullptr, stream>>>(
                x,
                y,
                z,
                tiling);
    }
    else if (dtype == 1)
    {
        sub_custom<half>
            <<<blockNum, nullptr, stream>>>(
                x,
                y,
                z,
                tiling);
    }

    // 防止未使用参数警告
    (void)info_y;
    (void)info_z;
}