#include <cmath>
#include "kernel_operator.h"

// Shape is fixed by the challenge: (8, 2048) = 16384 elements.
struct SubCustomTilingData {
    uint32_t totalLength;
};

constexpr uint32_t TOTAL_LENGTH = 16384;

// Static-Tensor UB layout.
// The 0x100 gap between X's 16KB boundary and Y follows the bank-conflict
// avoidance idea used by Ascend C best practices. The same addresses are safe
// for all BLOCK_LENGTH <= 4096 used below.
constexpr uint32_t X_UB_ADDR = 0x00000;
constexpr uint32_t Y_UB_ADDR = 0x04100;
constexpr uint32_t Z_UB_ADDR = 0x10000;

template <typename T, uint32_t BLOCK_LENGTH>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z)
    {
        const uint32_t offset = BLOCK_LENGTH * AscendC::GetBlockIdx();
        xGm.SetGlobalBuffer((__gm__ T*)x + offset, BLOCK_LENGTH);
        yGm.SetGlobalBuffer((__gm__ T*)y + offset, BLOCK_LENGTH);
        zGm.SetGlobalBuffer((__gm__ T*)z + offset, BLOCK_LENGTH);
    }

    __aicore__ inline void Process()
    {
        // Static Tensor Programming: no TPipe/TQue/InitBuffer/Alloc/Free.
        AscendC::LocalTensor<T> xLocal(AscendC::TPosition::VECCALC, X_UB_ADDR, BLOCK_LENGTH);
        AscendC::LocalTensor<T> yLocal(AscendC::TPosition::VECCALC, Y_UB_ADDR, BLOCK_LENGTH);
        AscendC::LocalTensor<T> zLocal(AscendC::TPosition::VECCALC, Z_UB_ADDR, BLOCK_LENGTH);

        AscendC::DataCopy(xLocal, xGm, BLOCK_LENGTH);
        AscendC::DataCopy(yLocal, yGm, BLOCK_LENGTH);

        // MTE2 -> Vector dependency: both input copies must finish first.
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(0);

        // BLOCK_LENGTH is chosen so that the byte count is always a whole
        // number of 256-byte vector repeats for both fp16 and fp32.
        constexpr uint64_t MASK = 256 / sizeof(T);          // fp32:64, fp16:128
        constexpr uint8_t REPEAT_TIMES =
            static_cast<uint8_t>((BLOCK_LENGTH * sizeof(T)) / 256);
        AscendC::Sub<T>(zLocal, xLocal, yLocal, MASK, REPEAT_TIMES,
                        {1, 1, 1, 8, 8, 8});

        // Vector -> MTE3 dependency before writing result back to GM.
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(1);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(1);
        AscendC::DataCopy(zGm, zLocal, BLOCK_LENGTH);
    }

private:
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;
};

template <typename T, uint32_t BLOCK_LENGTH>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    // Mandatory when TPipe is not used: initialize mask/atomic/global state.
    AscendC::InitSocState();
    KernelSub<T, BLOCK_LENGTH> op;
    op.Init(x, y, z);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    SubCustomTilingData tiling = {TOTAL_LENGTH};
    const int32_t dtype = info_x.tensors[0].dtype;

    // Use the largest power-of-two core count up to 32. This keeps every
    // per-core chunk exactly 256B-aligned and avoids tail handling entirely.
    if (dtype == 1) {
        if (availableCoreNum >= 32) {
            sub_custom<half, 512><<<32, nullptr, stream>>>(x, y, z, tiling);
        } else if (availableCoreNum >= 16) {
            sub_custom<half, 1024><<<16, nullptr, stream>>>(x, y, z, tiling);
        } else if (availableCoreNum >= 8) {
            sub_custom<half, 2048><<<8, nullptr, stream>>>(x, y, z, tiling);
        } else {
            sub_custom<half, 4096><<<4, nullptr, stream>>>(x, y, z, tiling);
        }
    } else {
        if (availableCoreNum >= 32) {
            sub_custom<float, 512><<<32, nullptr, stream>>>(x, y, z, tiling);
        } else if (availableCoreNum >= 16) {
            sub_custom<float, 1024><<<16, nullptr, stream>>>(x, y, z, tiling);
        } else if (availableCoreNum >= 8) {
            sub_custom<float, 2048><<<8, nullptr, stream>>>(x, y, z, tiling);
        } else {
            sub_custom<float, 4096><<<4, nullptr, stream>>>(x, y, z, tiling);
        }
    }
}
