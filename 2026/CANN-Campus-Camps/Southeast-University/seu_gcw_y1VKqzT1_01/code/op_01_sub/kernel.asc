#include <cmath>
#include "kernel_operator.h"

/*
 * Sub Kernel — Ascend C Direct Invocation
 *
 * z = x - y
 *
 * TensorGroupInfo / TensorInfo are predefined by the platform.
 */

// ============================================================
// 1. Tiling 参数
// ============================================================

struct SubCustomTilingData {
    uint32_t totalLength;   // 总元素数量
    uint32_t tileLength;    // 每次处理的元素数量
    uint32_t dtype;         // 0 = fp32, 1 = fp16
};


// ============================================================
// 2. Kernel 主体
// ============================================================

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        const SubCustomTilingData& tiling)
    {
        totalLength = tiling.totalLength;
        tileLength = tiling.tileLength;

        // 当前实际启动的 AI Core 数量
        uint32_t blockNum = AscendC::GetBlockNum();

        // 每个 AI Core 负责的数据量
        blockLength = totalLength / blockNum;

        // 当前 Core 在整个 Tensor 中的起始位置
        uint32_t blockOffset =
            AscendC::GetBlockIdx() * blockLength;

        // 将 GM 地址绑定到 GlobalTensor
        xGlobal.SetGlobalBuffer(
            (__gm__ T*)x + blockOffset,
            blockLength);

        yGlobal.SetGlobalBuffer(
            (__gm__ T*)y + blockOffset,
            blockLength);

        zGlobal.SetGlobalBuffer(
            (__gm__ T*)z + blockOffset,
            blockLength);

        // 每次只申请一个 tile 的 UB 空间
        pipe.InitBuffer(
            xQueue,
            1,
            tileLength * sizeof(T));

        pipe.InitBuffer(
            yQueue,
            1,
            tileLength * sizeof(T));

        pipe.InitBuffer(
            zQueue,
            1,
            tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        uint32_t tileCount = blockLength / tileLength;

        for (uint32_t i = 0; i < tileCount; ++i) {
            CopyIn(i);
            Compute();
            CopyOut(i);
        }
    }

private:

    // ========================================================
    // GM -> UB
    // ========================================================

    __aicore__ inline void CopyIn(uint32_t progress)
    {
        AscendC::LocalTensor<T> xLocal =
            xQueue.AllocTensor<T>();

        AscendC::LocalTensor<T> yLocal =
            yQueue.AllocTensor<T>();

        uint32_t offset = progress * tileLength;

        AscendC::DataCopy(
            xLocal,
            xGlobal[offset],
            tileLength);

        AscendC::DataCopy(
            yLocal,
            yGlobal[offset],
            tileLength);

        xQueue.EnQue(xLocal);
        yQueue.EnQue(yLocal);
    }


    // ========================================================
    // z = x - y
    // ========================================================

    __aicore__ inline void Compute()
    {
        AscendC::LocalTensor<T> xLocal =
            xQueue.DeQue<T>();

        AscendC::LocalTensor<T> yLocal =
            yQueue.DeQue<T>();

        AscendC::LocalTensor<T> zLocal =
            zQueue.AllocTensor<T>();

        // 核心计算
        AscendC::Sub(
            zLocal,
            xLocal,
            yLocal,
            tileLength);

        zQueue.EnQue(zLocal);

        xQueue.FreeTensor(xLocal);
        yQueue.FreeTensor(yLocal);
    }


    // ========================================================
    // UB -> GM
    // ========================================================

    __aicore__ inline void CopyOut(uint32_t progress)
    {
        AscendC::LocalTensor<T> zLocal =
            zQueue.DeQue<T>();

        uint32_t offset = progress * tileLength;

        AscendC::DataCopy(
            zGlobal[offset],
            zLocal,
            tileLength);

        zQueue.FreeTensor(zLocal);
    }


private:

    AscendC::TPipe pipe;

    // 两个输入队列
    AscendC::TQue<
        AscendC::TPosition::VECIN,
        1> xQueue;

    AscendC::TQue<
        AscendC::TPosition::VECIN,
        1> yQueue;

    // 一个输出队列
    AscendC::TQue<
        AscendC::TPosition::VECOUT,
        1> zQueue;

    // Global Memory Tensor
    AscendC::GlobalTensor<T> xGlobal;
    AscendC::GlobalTensor<T> yGlobal;
    AscendC::GlobalTensor<T> zGlobal;

    uint32_t totalLength;
    uint32_t blockLength;
    uint32_t tileLength;
};


// ============================================================
// 3. Kernel 入口
// ============================================================

__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    // float32
    if (tiling.dtype == 0) {
        KernelSub<float> op;

        op.Init(
            x,
            y,
            z,
            tiling);

        op.Process();
    }

    // float16
    else if (tiling.dtype == 1) {
        KernelSub<half> op;

        op.Init(
            x,
            y,
            z,
            tiling);

        op.Process();
    }
}


// ============================================================
// 4. Host 侧启动 Kernel
// ============================================================

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    // --------------------------------------------------------
    // 计算 Tensor 总元素数量
    //
    // 题目：
    // shape = (8, 2048)
    //
    // 所以：
    // totalLength = 8 * 2048 = 16384
    // --------------------------------------------------------

    uint32_t totalLength = 1;

    const TensorInfo& tensorInfo = info_x.tensors[0];

    for (int64_t i = 0; i < tensorInfo.numDims; ++i) {
        totalLength *=
            static_cast<uint32_t>(
                tensorInfo.shape[i]);
    }


    // --------------------------------------------------------
    // dtype
    //
    // 0 = float32
    // 1 = float16
    // --------------------------------------------------------

    uint32_t dtype =
        static_cast<uint32_t>(
            tensorInfo.dtype);


    // --------------------------------------------------------
    // 选择 AI Core 数量
    //
    // 本题总长度 16384。
    //
    // 使用 8 Core 时：
    //
    // 每 Core：
    // 16384 / 8 = 2048
    //
    // 正好对应输入的 8 行。
    // --------------------------------------------------------

    uint32_t blockNum = 1;

    if (availableCoreNum >= 8) {
        blockNum = 8;
    }
    else if (availableCoreNum >= 4) {
        blockNum = 4;
    }
    else if (availableCoreNum >= 2) {
        blockNum = 2;
    }


    // --------------------------------------------------------
    // Tiling
    //
    // 每次处理 256 个元素。
    //
    // 8 Core：
    // 2048 / 256 = 8 tiles / Core
    // --------------------------------------------------------

    constexpr uint32_t TILE_LENGTH = 256;

    SubCustomTilingData tiling;

    tiling.totalLength = totalLength;
    tiling.tileLength = TILE_LENGTH;
    tiling.dtype = dtype;


    // --------------------------------------------------------
    // 启动 NPU Kernel
    // --------------------------------------------------------

    sub_custom<<<blockNum, nullptr, stream>>>(
        x,
        y,
        z,
        tiling);
}