#include "kernel_operator.h"

constexpr uint32_t TOTAL_LENGTH = 8 * 2048;
constexpr uint32_t CORE_NUM = 8;
constexpr uint32_t BLOCK_LENGTH = TOTAL_LENGTH / CORE_NUM;


// ============================================================
// Static UB implementation
// ============================================================

template <typename T, uint32_t VECTOR_MASK>
__aicore__ inline void SubStaticImpl(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z)
{
    const uint32_t blockIdx = AscendC::GetBlockIdx();
    const uint32_t offset = blockIdx * BLOCK_LENGTH;

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    xGm.SetGlobalBuffer(
        reinterpret_cast<__gm__ T*>(x) + offset,
        BLOCK_LENGTH);

    yGm.SetGlobalBuffer(
        reinterpret_cast<__gm__ T*>(y) + offset,
        BLOCK_LENGTH);

    zGm.SetGlobalBuffer(
        reinterpret_cast<__gm__ T*>(z) + offset,
        BLOCK_LENGTH);


    // --------------------------------------------------------
    // Static UB layout
    //
    // | xLocal | yLocal | zLocal |
    // --------------------------------------------------------

    constexpr uint32_t BLOCK_BYTES =
        BLOCK_LENGTH * sizeof(T);

    constexpr uint32_t X_ADDR = 0;
    constexpr uint32_t Y_ADDR = BLOCK_BYTES;
    constexpr uint32_t Z_ADDR = BLOCK_BYTES * 2;

    AscendC::LocalTensor<T> xLocal(
        AscendC::TPosition::VECCALC,
        X_ADDR,
        BLOCK_LENGTH);

    AscendC::LocalTensor<T> yLocal(
        AscendC::TPosition::VECCALC,
        Y_ADDR,
        BLOCK_LENGTH);

    AscendC::LocalTensor<T> zLocal(
        AscendC::TPosition::VECCALC,
        Z_ADDR,
        BLOCK_LENGTH);


    // ========================================================
    // MTE2: GM -> UB
    // ========================================================

    AscendC::DataCopy(
        xLocal,
        xGm,
        BLOCK_LENGTH);

    AscendC::DataCopy(
        yLocal,
        yGm,
        BLOCK_LENGTH);


    // MTE2 -> Vector dependency
    AscendC::SetFlag<
        AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    AscendC::WaitFlag<
        AscendC::HardEvent::MTE2_V>(EVENT_ID0);


    // ========================================================
    // Vector
    // ========================================================

    constexpr uint8_t REPEAT_TIMES =
        static_cast<uint8_t>(
            BLOCK_LENGTH / VECTOR_MASK);

    AscendC::Sub(
        zLocal,
        xLocal,
        yLocal,
        static_cast<uint64_t>(VECTOR_MASK),
        REPEAT_TIMES,
        {1, 1, 1, 8, 8, 8});


    // Vector -> MTE3 dependency
    AscendC::SetFlag<
        AscendC::HardEvent::V_MTE3>(EVENT_ID0);

    AscendC::WaitFlag<
        AscendC::HardEvent::V_MTE3>(EVENT_ID0);


    // ========================================================
    // MTE3: UB -> GM
    // ========================================================

    AscendC::DataCopy(
        zGm,
        zLocal,
        BLOCK_LENGTH);
}


// ============================================================
// fp16
//
// 256 B Vector repeat
// 256 / sizeof(half) = 128 elements
// 2048 / 128 = 16 repeats
// ============================================================

__global__ __vector__ void sub_fp16(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z)
{
    SubStaticImpl<half, 128>(x, y, z);
}


// ============================================================
// fp32
//
// 256 B Vector repeat
// 256 / sizeof(float) = 64 elements
// 2048 / 64 = 32 repeats
// ============================================================

__global__ __vector__ void sub_fp32(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z)
{
    SubStaticImpl<float, 64>(x, y, z);
}


// ============================================================
// Host
// ============================================================

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    (void)info_y;
    (void)info_z;

    if (info_x.numTensors <= 0 ||
        info_x.tensors == nullptr ||
        availableCoreNum < CORE_NUM) {
        return;
    }

    const int32_t dtype =
        info_x.tensors[0].dtype;

    if (dtype == 0) {
        sub_fp32<<<CORE_NUM, nullptr, stream>>>(
            x, y, z);
    } else if (dtype == 1) {
        sub_fp16<<<CORE_NUM, nullptr, stream>>>(
            x, y, z);
    }
}