#include <cmath>
#include "kernel_operator.h"

// ---------------------------------------------------------------------------
// Tiling 参数：由 host 侧 run_kernel 计算后按值传给核函数
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint32_t totalLength; // 待处理数据总长度，单位为元素个数
    uint32_t tileNum;     // 单核内进一步切分的 Tile 数量
};

constexpr uint32_t BUFFER_NUM = 1;
constexpr uint32_t QUEUE_DEPTH = 2;

// ---------------------------------------------------------------------------
// KernelSub：完成 z = x - y
// 每个核按照 tileNum × BUFFER_NUM 分块循环计算
// 模板化实现，支持 float、half 等数据类型
// ---------------------------------------------------------------------------
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        const SubCustomTilingData& tiling)
    {
        uint32_t totalLength = tiling.totalLength;
        uint32_t tileNum = tiling.tileNum;

        // 每个核负责处理的元素数量
        //this->blockLength =
        //    totalLength / AscendC::GetBlockNum();
        this->blockLength =
            totalLength / AscendC::GetBlockNum();

        this->tileNum = 1;
        this->tileLength = this->blockLength;
        // 每个核内部的 Tile 数量
        //this->tileNum = tileNum;

        // 每次循环实际处理的元素数量
        //this->tileLength =
        //    this->blockLength / tileNum / BUFFER_NUM;

        // 根据当前核编号，确定该核负责的数据起始位置
        xGm.SetGlobalBuffer(
            (__gm__ T*)x +
                this->blockLength * AscendC::GetBlockIdx(),
            this->blockLength);

        yGm.SetGlobalBuffer(
            (__gm__ T*)y +
                this->blockLength * AscendC::GetBlockIdx(),
            this->blockLength);

        zGm.SetGlobalBuffer(
            (__gm__ T*)z +
                this->blockLength * AscendC::GetBlockIdx(),
            this->blockLength);

        // 为三个队列分配片上 Unified Buffer 空间
        pipe.InitBuffer(
            inQueueX,
            BUFFER_NUM,
            this->tileLength * sizeof(T));

        pipe.InitBuffer(
            inQueueY,
            BUFFER_NUM,
            this->tileLength * sizeof(T));

        pipe.InitBuffer(
            outQueueZ,
            BUFFER_NUM,
            this->tileLength * sizeof(T));
    }
    __aicore__ inline void Process()
    {
        CopyIn(0);
        Compute(0);
        CopyOut(0);
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        // 从输入队列申请 LocalTensor
        AscendC::LocalTensor<T> xLocal =
            inQueueX.AllocTensor<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.AllocTensor<T>();

        // 当前 Tile 在本核数据范围内的起始偏移
        uint32_t tileOffset =
            progress * this->tileLength;

        // 从 Global Memory 搬到 Local Memory
        AscendC::DataCopy(
            xLocal,
            xGm[tileOffset],
            this->tileLength);

        AscendC::DataCopy(
            yLocal,
            yGm[tileOffset],
            this->tileLength);

        // 放入输入队列，通知 Compute 阶段
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(int32_t progress)
    {
        // 从输入队列取出当前 Tile
        AscendC::LocalTensor<T> xLocal =
            inQueueX.DeQue<T>();

        AscendC::LocalTensor<T> yLocal =
            inQueueY.DeQue<T>();

        // 为输出结果申请 LocalTensor
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.AllocTensor<T>();

        // 核心计算：
        // zLocal[i] = xLocal[i] - yLocal[i]
        AscendC::Sub(
            zLocal,
            xLocal,
            yLocal,
            this->tileLength);

        // 将结果放入输出队列
        outQueueZ.EnQue<T>(zLocal);

        // 当前两个输入 Tile 已经计算完毕，可以释放
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int32_t progress)
    {
        // 从输出队列获取计算结果
        AscendC::LocalTensor<T> zLocal =
            outQueueZ.DeQue<T>();

        // 当前 Tile 在本核数据范围内的起始偏移
        uint32_t tileOffset =
            progress * this->tileLength;

        // 将结果从 Local Memory 写回 Global Memory
        AscendC::DataCopy(
            zGm[tileOffset],
            zLocal,
            this->tileLength);

        // 搬出完成，释放输出 LocalTensor
        outQueueZ.FreeTensor(zLocal);
    }

private:
    // 管理片上存储和流水线资源
    AscendC::TPipe pipe;

    // 两个输入队列，分别传递 x 和 y
    AscendC::TQue<
        AscendC::QuePosition::VECIN,
        QUEUE_DEPTH> inQueueX, inQueueY;

    // 一个输出队列，传递 z
    AscendC::TQue<
        AscendC::QuePosition::VECOUT,
        QUEUE_DEPTH> outQueueZ;

    // Global Memory 中的输入和输出 Tensor
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    uint32_t blockLength; // 每个核处理的元素数
    uint32_t tileNum;     // 每个核的 Tile 数量
    uint32_t tileLength;  // 每次循环处理的元素数
};

// ---------------------------------------------------------------------------
// Device 侧核函数入口
// T 由 Host 侧根据输入数据类型选择
// ---------------------------------------------------------------------------
template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

// ---------------------------------------------------------------------------
// Host 侧启动函数
// 读取输入 Shape、确定数据类型、生成 Tiling 并启动核函数
// ---------------------------------------------------------------------------
extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    // 本题参考实现固定使用8个核
    constexpr uint32_t blockDim = 8;

    // 获取输入x的Tensor信息
    const TensorInfo& t0 = info_x.tensors[0];

    // Shape各维度相乘，得到总元素数
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }

    // 获取输入数据类型
    // 题目给出的类型约定：0=FP32、1=FP16、2=BF16……
    int32_t dtype = t0.dtype;

    // 每个核内部设置1个Tile
    uint32_t tileNum = 1;

    // 构造Tiling参数
    SubCustomTilingData tiling = {
        static_cast<uint32_t>(totalLength),
        tileNum
    };

    if (dtype == 1) {
        // FP16输入：启动half版本
        sub_custom<half>
            <<<blockDim, nullptr, stream>>>(
                x, y, z, tiling);
    } else {
        // FP32以及其他测试类型：启动float版本
        sub_custom<float>
            <<<blockDim, nullptr, stream>>>(
                x, y, z, tiling);
    }
}