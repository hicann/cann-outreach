#include <cmath>
#include <cstdint>
#include "kernel_operator.h"

using namespace AscendC;

constexpr int32_t BUFFER_NUM = 2;      // double buffer
constexpr uint32_t TILE_LENGTH = 256;  // elements per pipeline iteration
constexpr uint32_t ALIGN_UNIT = 32;    // element-level alignment (32B / sizeof(elem) safe for fp32 & fp16)

struct SubCustomTilingData {
    uint32_t totalLength;  // total element count of the tensor
    uint32_t blockLength;  // aligned element count per core (multiple of ALIGN_UNIT)
    uint32_t tileLength;   // element count processed per pipeline iteration
    int32_t  dtype;        // 0=float32, 1=float16
};

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling)
    {
        this->totalLength = tiling.totalLength;
        this->blockLength = tiling.blockLength;
        this->tileLength = tiling.tileLength;

        uint32_t coreIdx = GetBlockIdx();
        uint32_t offset = coreIdx * this->blockLength;
        this->processLength = (offset >= this->totalLength)
                                  ? 0
                                  : ((this->totalLength - offset) < this->blockLength
                                         ? (this->totalLength - offset)
                                         : this->blockLength);

        xGm.SetGlobalBuffer((__gm__ T*)x + offset, (int32_t)this->processLength);
        yGm.SetGlobalBuffer((__gm__ T*)y + offset, (int32_t)this->processLength);
        zGm.SetGlobalBuffer((__gm__ T*)z + offset, (int32_t)this->processLength);

        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        if (this->processLength == 0) {
            return;
        }
        uint32_t loopCount = (this->processLength + this->tileLength - 1) / this->tileLength;
        for (uint32_t i = 0; i < loopCount; ++i) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline uint32_t CurLength(uint32_t idx) const
    {
        uint32_t remain = this->processLength - idx * this->tileLength;
        return (remain < this->tileLength) ? remain : this->tileLength;
    }

    __aicore__ inline void CopyIn(uint32_t idx)
    {
        uint32_t len = CurLength(idx);
        LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        DataCopy(xLocal, xGm[idx * this->tileLength], (int32_t)len);
        DataCopy(yLocal, yGm[idx * this->tileLength], (int32_t)len);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t idx)
    {
        uint32_t len = CurLength(idx);
        LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        Sub(zLocal, xLocal, yLocal, (int32_t)len);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
        outQueueZ.EnQue(zLocal);
    }

    __aicore__ inline void CopyOut(uint32_t idx)
    {
        uint32_t len = CurLength(idx);
        LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        DataCopy(zGm[idx * this->tileLength], zLocal, (int32_t)len);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    TPipe pipe;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueX;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueY;
    TQue<QuePosition::VECOUT, BUFFER_NUM> outQueueZ;
    GlobalTensor<T> xGm;
    GlobalTensor<T> yGm;
    GlobalTensor<T> zGm;
    uint32_t totalLength;
    uint32_t blockLength;
    uint32_t tileLength;
    uint32_t processLength;
};

__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    if (tiling.dtype == 0) {
        KernelSub<float> op;
        op.Init(x, y, z, tiling);
        op.Process();
    } else {
        KernelSub<half> op;
        op.Init(x, y, z, tiling);
        op.Process();
    }
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    uint64_t totalLength = 1;
    for (int64_t d = 0; d < info_x.tensors[0].numDims; ++d) {
        totalLength *= (uint64_t)info_x.tensors[0].shape[d];
    }
    int32_t dtype = info_x.tensors[0].dtype;

    SubCustomTilingData tiling;
    tiling.totalLength = (uint32_t)totalLength;
    tiling.tileLength = TILE_LENGTH;
    tiling.dtype = dtype;

    int64_t maxBlocks = (int64_t)((totalLength + ALIGN_UNIT - 1) / ALIGN_UNIT);
    int64_t blockNum = (availableCoreNum < maxBlocks) ? availableCoreNum : maxBlocks;
    if (blockNum < 1) {
        blockNum = 1;
    }

    uint64_t blockLength = (totalLength + (uint64_t)blockNum - 1) / (uint64_t)blockNum;
    blockLength = ((blockLength + ALIGN_UNIT - 1) / ALIGN_UNIT) * ALIGN_UNIT;
    tiling.blockLength = (uint32_t)blockLength;

    sub_custom<<<(uint32_t)blockNum, nullptr, stream>>>(x, y, z, tiling);
}
