#include <cmath>
#include "kernel_operator.h"
/*
 * ============================================================================
 * op_01_sub  Sub 减法算子 —— Ascend C 直接调用（Direct Invocation）实现【提速版】
 * ============================================================================
 * 功能：z = x - y，x / y / z 均为 (8, 2048) 的 float32 张量，ND 布局。
 *
 * 本文件被 main.asc #include，禁止添加 main()、#pragma once 或 include guard。
 *
 * 平台约定（结构体定义在 main.asc 中）：
 *   struct TensorInfo      { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64
 *          7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   用法示例：info_x.tensors[0].shape[0]   // 取输入 x 第一个张量的第 0 维
 *
 * 【相比初版的三处提速改造】
 * ① 双缓冲软件流水（BUFFER_NUM = 2，每核多 tile）：
 *    循环中提前发起下一个 tile 的 CopyIn（MTE2），使 GM→UB 搬运、Vector 计算、
 *    UB→GM 回拷三级并行重叠。初版单缓冲下三者严格串行：搬运完才计算、
 *    计算完才回拷，Vector 引擎和 MTE3 引擎大量空转。
 * ② 尾块均分（负载均衡）：
 *    初版把剩余元素全部压给最后一核（例：48 核时尾核 592 元素 vs 普通核 336，
 *    最长核决定整体耗时，约 1.76 倍不均衡）；新版把余数按 8 元素块均分给
 *    前 remainder8 个核，任意两核负载差 ≤ 8 元素（总长非 8 对齐时 ≤ 15）。
 * ③ 计算长度恒为 8 的倍数：各段长度天然 32B 对齐，仅在 <8 元素的极端尾块
 *    做一次向上对齐，无无效计算、无多余回拷。
 * ============================================================================
 */
// ---------------------------------------------------------------------------
// Tiling 参数：由 host 侧 run_kernel 计算后按值传给核函数
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint32_t totalLength;   // 张量总元素数（本任务固定 8*2048 = 16384）
    uint32_t coreNum;       // 参与计算的 block（AICore）数
    uint32_t perCoreLen8;   // 每核基础元素数（已按 8 元素对齐 = 32B，保证 GM/UB 地址对齐）
                            // 余数由核内负载均衡逻辑均分，不再全部压给最后一核
    uint32_t tileLen8;      // 每核内部单个 tile 的元素数（8 对齐），双缓冲流水粒度
};

// 双缓冲：每个队列 2 块 buffer，队列深度 2，实现 MTE2 / Vector / MTE3 三级重叠
constexpr uint32_t BUFFER_NUM  = 2;   // 每个 queue 中的 tensor 数量（双缓冲）
constexpr uint32_t QUEUE_DEPTH = 2;   // TQue 队列深度（与缓冲数一致）

// ---------------------------------------------------------------------------
// KernelSub：z = x - y，多 tile + 双缓冲软件流水，尾块均分到各核
// ---------------------------------------------------------------------------
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    /**
     * @brief 初始化：均分负载、绑定 GM 全局内存、规划 tile、分配 UB 双缓冲
     */
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling)
    {
        const uint32_t coreIdx = AscendC::GetBlockIdx();
        this->totalLength = tiling.totalLength;
        this->coreNum     = tiling.coreNum;
        this->tileLen8    = tiling.tileLen8;

        // 1) 负载均衡切分：余数 = totalLength - coreNum * perCoreLen8（范围 0..8*coreNum-1）
        //    - 完整 8 元素块（remainder8 块）均分给前 remainder8 个核，各多 8 个元素；
        //    - 不足 8 的残余（leftover，0..7 个元素）并入最后一核，保证元素全覆盖。
        //    任意两核负载差 ≤ 8（总长非 8 对齐时 ≤ 15），远优于初版"尾块全压最后一核"。
        const uint32_t perCoreLen8 = tiling.perCoreLen8;
        uint32_t coreDataNum;
        if (perCoreLen8 == 0) {                       // 总元素 < 8 的极端情况：单核全收
            this->offset = 0;
            coreDataNum  = (coreIdx == 0) ? this->totalLength : 0;
        } else {
            const uint32_t remainderUnits = this->totalLength - perCoreLen8 * this->coreNum;
            const uint32_t remainder8     = remainderUnits / 8;
            const uint32_t leftover       = remainderUnits % 8;
            if (coreIdx < remainder8) {
                this->offset = coreIdx * (perCoreLen8 + 8);
                coreDataNum  = perCoreLen8 + 8;
            } else {
                this->offset = remainder8 * (perCoreLen8 + 8) + (coreIdx - remainder8) * perCoreLen8;
                coreDataNum  = perCoreLen8 + ((coreIdx == this->coreNum - 1) ? leftover : 0);
            }
        }
        this->coreDataNum = coreDataNum;

        // 2) 本核 tile 规划：完整 tile 数 + 可能存在的尾 tile（长度 < tileLen8）
        this->fullTileNum = coreDataNum / this->tileLen8;
        this->tailLen8    = coreDataNum - this->fullTileNum * this->tileLen8;
        this->totalTiles  = this->fullTileNum + (this->tailLen8 > 0 ? 1 : 0);

        // 3) 将全局内存张量绑定到本核专属区间（GM 绝对偏移 = offset）
        xGm.SetGlobalBuffer((__gm__ float*)x + this->offset, coreDataNum);
        yGm.SetGlobalBuffer((__gm__ float*)y + this->offset, coreDataNum);
        zGm.SetGlobalBuffer((__gm__ float*)z + this->offset, coreDataNum);

        // 4) UB 双缓冲：每个队列 2 块，单块按最大 tile 长度（tileLen8）计
        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLen8 * sizeof(float));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLen8 * sizeof(float));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLen8 * sizeof(float));
    }

    /**
     * @brief 流水线总调度：预取首 tile，循环中提前预取下一 tile，三级并行重叠
     */
    __aicore__ inline void Process()
    {
        if (this->coreDataNum == 0) {
            return;   // 空核（数据量小于核数时）直接退出，避免越界访问
        }
        CopyIn(0);
        for (uint32_t t = 0; t < this->totalTiles; t++) {
            if (t + 1 < this->totalTiles) {
                CopyIn(t + 1);   // 提前发起下一 tile 搬运：与当前 tile 计算/回拷重叠
            }
            Compute(t);
            CopyOut(t);
        }
    }

private:
    /** 第 t 个 tile 的有效元素数（尾 tile 可能更短） */
    __aicore__ inline uint32_t TileLen(uint32_t t) const
    {
        return (t < this->fullTileNum) ? this->tileLen8 : this->tailLen8;
    }

    /**
     * @brief CopyIn：搬运本核第 t 个 tile 到本地输入队列（异步，MTE2 引擎）
     */
    __aicore__ inline void CopyIn(uint32_t t)
    {
        AscendC::LocalTensor<float> xLocal = inQueueX.AllocTensor<float>();
        AscendC::LocalTensor<float> yLocal = inQueueY.AllocTensor<float>();
        AscendC::DataCopy(xLocal, xGm[t * this->tileLen8], TileLen(t));
        AscendC::DataCopy(yLocal, yGm[t * this->tileLen8], TileLen(t));
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    /**
     * @brief Compute：取出两路输入，调用矢量减法 Sub 完成 z = x - y
     */
    __aicore__ inline void Compute(uint32_t t)
    {
        const uint32_t len       = TileLen(t);
        const uint32_t calcCount = (len + 7) / 8 * 8;   // 仅极端尾块需向上 8 对齐
        AscendC::LocalTensor<float> xLocal = inQueueX.DeQue<float>();
        AscendC::LocalTensor<float> yLocal = inQueueY.DeQue<float>();
        AscendC::LocalTensor<float> zLocal = outQueueZ.AllocTensor<float>();
        AscendC::Sub(zLocal, xLocal, yLocal, calcCount);
        outQueueZ.EnQue<float>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    /**
     * @brief CopyOut：把本地计算结果回写 GM（异步，MTE3 引擎），只写有效元素
     */
    __aicore__ inline void CopyOut(uint32_t t)
    {
        AscendC::LocalTensor<float> zLocal = outQueueZ.DeQue<float>();
        AscendC::DataCopy(zGm[t * this->tileLen8], zLocal, TileLen(t));
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;                                                  // 流水线内存管理器
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH>  inQueueX;    // 输入 x 向量队列
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH>  inQueueY;    // 输入 y 向量队列
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH> outQueueZ;   // 输出 z 向量队列
    AscendC::GlobalTensor<float> xGm, yGm, zGm;                           // GM 全局内存张量
    uint32_t totalLength;   // 张量总元素数
    uint32_t coreNum;       // 参与计算的核数
    uint32_t coreDataNum;   // 本核处理的元素数
    uint32_t tileLen8;      // tile 长度（元素）
    uint32_t fullTileNum;   // 完整 tile 数
    uint32_t tailLen8;      // 尾 tile 长度（元素，可能为 0）
    uint32_t totalTiles;    // 本核总 tile 数
    uint32_t offset;        // 本核 GM 起始偏移（元素）
};

// ---------------------------------------------------------------------------
// 核函数入口：实例化 KernelSub 并执行（host 通过 <<< >>> 启动）
// ---------------------------------------------------------------------------
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub op;
    op.Init(x, y, z, tiling);
    op.Process();
}

// ---------------------------------------------------------------------------
// host 侧启动函数（平台约定的导出入口）：从 TensorGroupInfo 推导 tiling 并启动核函数
// ---------------------------------------------------------------------------
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    // 1. 取总元素数（x / y / z 形状一致），由 shape 连乘得到
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }

    // 2. 核数：不超过可用核数；同时保证每核至少 8 个元素（32B 对齐）
    int64_t maxCores = totalLength / 8;
    if (maxCores < 1) {
        maxCores = 1;
    }
    uint32_t coreNum = (availableCoreNum < maxCores) ? (uint32_t)availableCoreNum : (uint32_t)maxCores;

    // 3. 每核基础长度向下对齐到 8；余数由核内负载均衡逻辑均分
    //    （任意两核负载差 ≤ 8 元素，优于初版"尾块全压最后一核"）
    uint32_t perCoreLen8 = (uint32_t)((totalLength / coreNum / 8) * 8);

    // 4. tile 长度：默认每核 2 个 tile 以启用双缓冲流水；
    //    - 下限 8 元素（32B 对齐下限）
    //    - 上限 4096 元素（16KB）：双缓冲 3 队列 ≈ 96KB，稳定落在 UB 容量内
    uint32_t tileLen8 = perCoreLen8 / 2;
    if (tileLen8 < 8) {
        tileLen8 = 8;
    }
    if (tileLen8 > 4096) {
        tileLen8 = 4096;
    }
    tileLen8 = (tileLen8 / 8) * 8;   // 保持 8 元素（32B）对齐

    SubCustomTilingData tiling = {(uint32_t)totalLength, coreNum, perCoreLen8, tileLen8};
    sub_custom<<<coreNum, nullptr, stream>>>(x, y, z, tiling);
}




