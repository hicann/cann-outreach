
#include <cmath>
#include "kernel_operator.h"

// ---------------------------------------------------------------------------
// Tiling 参数：由 host 侧 run_kernel 计算后按值传给核函数
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint32_t totalLength;  // 数据总元素个数（如 8 * 2048 = 16384）
    uint32_t blockLength;  // 每核处理的元素数
    uint32_t tileNum;      // 核内分块数
    uint32_t tileLength;   // 每块（除以 BUFFER_NUM 后）的元素数
};

// 【性能优化】保持 double buffer，但 tileNum 由 host 侧压到最小
constexpr uint32_t BUFFER_NUM = 2;

// ---------------------------------------------------------------------------
// KernelSub：z = x - y，多核切分 + 核内分块 + Double Buffer 流水
// ---------------------------------------------------------------------------
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                const SubCustomTilingData& tiling)
    {
        this->blockLength = tiling.blockLength;
        this->tileNum     = tiling.tileNum;
        this->tileLength  = tiling.tileLength;

        // 设置当前核的 Global Memory 起始地址（按核号偏移）
        uint32_t blockIdx = AscendC::GetBlockIdx();
        xGm.SetGlobalBuffer((__gm__ float *)x + this->blockLength * blockIdx, this->blockLength);
        yGm.SetGlobalBuffer((__gm__ float *)y + this->blockLength * blockIdx, this->blockLength);
        zGm.SetGlobalBuffer((__gm__ float *)z + this->blockLength * blockIdx, this->blockLength);

        // 为输入/输出队列分配 UB 内存（BUFFER_NUM 个缓冲实现乒乓）
        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(float));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(float));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        // 循环次数 = tileNum × BUFFER_NUM（本用例下为 2 次）
        int32_t loopCount = this->tileNum * BUFFER_NUM;
        for (int32_t i = 0; i < loopCount; i++) {
            CopyIn(i);    // 搬入第 i 块数据
            Compute(i);   // 计算第 i 块数据
            CopyOut(i);   // 搬出第 i 块结果
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        AscendC::LocalTensor<float> xLocal = inQueueX.AllocTensor<float>();
        AscendC::LocalTensor<float> yLocal = inQueueY.AllocTensor<float>();
        // Global Memory -> Local Memory（UB），单次 4KB 大块搬运，MTE 效率更高
        AscendC::DataCopy(xLocal, xGm[progress * this->tileLength], this->tileLength);
        AscendC::DataCopy(yLocal, yGm[progress * this->tileLength], this->tileLength);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(int32_t progress)
    {
        AscendC::LocalTensor<float> xLocal = inQueueX.DeQue<float>();
        AscendC::LocalTensor<float> yLocal = inQueueY.DeQue<float>();
        AscendC::LocalTensor<float> zLocal = outQueueZ.AllocTensor<float>();
        // 矢量减法：z = x - y
        AscendC::Sub(zLocal, xLocal, yLocal, this->tileLength);
        outQueueZ.EnQue<float>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int32_t progress)
    {
        AscendC::LocalTensor<float> zLocal = outQueueZ.DeQue<float>();
        // Local Memory -> Global Memory
        AscendC::DataCopy(zGm[progress * this->tileLength], zLocal, this->tileLength);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;
    // 【注意】模板参数用 BUFFER_NUM，保证队列深度与缓冲数一致，真正启用双缓冲流水
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inQueueX, inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_NUM> outQueueZ;
    AscendC::GlobalTensor<float> xGm, yGm, zGm;

    uint32_t blockLength;  // 每核处理的元素数
    uint32_t tileNum;      // 核内分块数
    uint32_t tileLength;   // 每块元素数
};

// ---------------------------------------------------------------------------
// 核函数入口：实例化 KernelSub 并执行
// ---------------------------------------------------------------------------
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub op;
    op.Init(x, y, z, tiling);
    op.Process();
}

// ---------------------------------------------------------------------------
// host 侧启动函数：从 TensorGroupInfo 推导 tiling 并启动核函数
// ---------------------------------------------------------------------------
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    // 1. 计算总元素数
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }

    // 2. 核数：跟随 availableCoreNum，上限 8，且保证能整除总长度
    uint32_t blockDim = (availableCoreNum > 0) ? static_cast<uint32_t>(availableCoreNum) : 1;
    if (blockDim > 8) blockDim = 8;
    while (blockDim > 1 && totalLength % blockDim != 0) {
        blockDim--;
    }

    uint32_t blockLength = static_cast<uint32_t>(totalLength / blockDim);

    // 3. 【性能优化】尽量减少循环次数：tileNum 取最小，使 tileLength 尽量大（上限 2048 元素 = 8KB）
    //    本用例：blockLength = 2048 → tileNum = 1，tileLength = 1024，loopCount = 2
    constexpr uint32_t MAX_TILE_LENGTH = 2048;
    uint32_t tileNum = 1;
    while (tileNum < blockLength && (blockLength / (tileNum * BUFFER_NUM)) > MAX_TILE_LENGTH) {
        tileNum++;
    }
    // 保证 blockLength 能被 tileNum × BUFFER_NUM 整除
    while (tileNum > 1 && (blockLength % (tileNum * BUFFER_NUM)) != 0) {
        tileNum--;
    }
    uint32_t tileLength = blockLength / tileNum / BUFFER_NUM;

    // 4. 打包 tiling 并启动
    SubCustomTilingData tiling = {static_cast<uint32_t>(totalLength), blockLength, tileNum, tileLength};
    sub_custom<<<blockDim, nullptr, stream>>>(x, y, z, tiling);
}
