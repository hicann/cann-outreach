#include <cmath>
#include "kernel_operator.h"

using namespace AscendC;

/*
 * 对于本题 8 x 2048 = 16384 个元素，
 * 单个 Core 尽量处理较大的连续数据块，
 * 减少 CopyIn / Compute / CopyOut 的循环次数。
 *
 * 这里采用单 Buffer：
 * 当前 Process() 是严格的
 * CopyIn -> Compute -> CopyOut
 * 没有形成真正的双缓冲流水，
 * 因此 BUFFER_NUM = 1 可以减少 UB 占用。
 */
constexpr uint32_t BUFFER_NUM = 1;

/*
 * 单个 tile 最大元素数。
 *
 * FP32:
 * 2048 * 4 = 8192 Bytes
 *
 * FP16:
 * 2048 * 2 = 4096 Bytes
 *
 * 对本题来说这个大小比较合适。
 */
constexpr uint32_t MAX_TILE_LENGTH = 2048;

struct SubCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileLength;
    uint32_t tileNum;
};


/*
 * ============================================================
 * FP32 Kernel
 * ============================================================
 */
class KernelSubFp32
{
public:
    __aicore__ inline KernelSubFp32()
    {
    }

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        uint32_t totalLength,
        uint32_t tileLength,
        uint32_t tileNum)
    {
        this->tileLength = tileLength;
        this->tileNum = tileNum;

        uint32_t blockNum = GetBlockNum();
        uint32_t blockIdx = GetBlockIdx();

        /*
         * run_kernel 已经保证 totalLength 能够被 blockNum 整除。
         */
        uint32_t blockLength = totalLength / blockNum;

        /*
         * 当前 Core 对应自己的连续 GM 区域。
         */
        xGm.SetGlobalBuffer(
            (__gm__ float*)x + blockIdx * blockLength,
            blockLength);

        yGm.SetGlobalBuffer(
            (__gm__ float*)y + blockIdx * blockLength,
            blockLength);

        zGm.SetGlobalBuffer(
            (__gm__ float*)z + blockIdx * blockLength,
            blockLength);

        /*
         * 单 Buffer。
         *
         * 当前 Process 没有并行流水，因此没有必要为同一个
         * Queue 同时保留两个 tile。
         */
        pipe.InitBuffer(
            inQueueX,
            BUFFER_NUM,
            tileLength * sizeof(float));

        pipe.InitBuffer(
            inQueueY,
            BUFFER_NUM,
            tileLength * sizeof(float));

        pipe.InitBuffer(
            outQueueZ,
            BUFFER_NUM,
            tileLength * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        /*
         * tileNum 尽可能小。
         *
         * 对本题正常情况：
         *
         * totalLength = 16384
         * blockNum    = 8
         * blockLength = 2048
         * tileNum     = 1
         *
         * 所以这里只循环一次。
         */
        for (uint32_t i = 0; i < tileNum; ++i)
        {
            CopyIn(i);
            Compute();
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t progress)
    {
        LocalTensor<float> xLocal =
            inQueueX.AllocTensor<float>();

        LocalTensor<float> yLocal =
            inQueueY.AllocTensor<float>();

        /*
         * 连续 GM -> UB。
         */
        DataCopy(
            xLocal,
            xGm[progress * tileLength],
            tileLength);

        DataCopy(
            yLocal,
            yGm[progress * tileLength],
            tileLength);

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        LocalTensor<float> xLocal =
            inQueueX.DeQue<float>();

        LocalTensor<float> yLocal =
            inQueueY.DeQue<float>();

        LocalTensor<float> zLocal =
            outQueueZ.AllocTensor<float>();

        /*
         * Vector Sub：
         *
         * z = x - y
         *
         * 一次处理整个 tile。
         */
        Sub(
            zLocal,
            xLocal,
            yLocal,
            tileLength);

        outQueueZ.EnQue(zLocal);

        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t progress)
    {
        LocalTensor<float> zLocal =
            outQueueZ.DeQue<float>();

        /*
         * 连续 UB -> GM。
         */
        DataCopy(
            zGm[progress * tileLength],
            zLocal,
            tileLength);

        outQueueZ.FreeTensor(zLocal);
    }

private:
    TPipe pipe;

    TQue<TPosition::VECIN, BUFFER_NUM> inQueueX;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueY;
    TQue<TPosition::VECOUT, BUFFER_NUM> outQueueZ;

    GlobalTensor<float> xGm;
    GlobalTensor<float> yGm;
    GlobalTensor<float> zGm;

    uint32_t tileLength;
    uint32_t tileNum;
};


/*
 * ============================================================
 * FP16 Kernel
 * ============================================================
 */
class KernelSubFp16
{
public:
    __aicore__ inline KernelSubFp16()
    {
    }

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        uint32_t totalLength,
        uint32_t tileLength,
        uint32_t tileNum)
    {
        this->tileLength = tileLength;
        this->tileNum = tileNum;

        uint32_t blockNum = GetBlockNum();
        uint32_t blockIdx = GetBlockIdx();

        /*
         * 当前 Core 对应的连续数据块。
         */
        uint32_t blockLength = totalLength / blockNum;

        xGm.SetGlobalBuffer(
            (__gm__ half*)x + blockIdx * blockLength,
            blockLength);

        yGm.SetGlobalBuffer(
            (__gm__ half*)y + blockIdx * blockLength,
            blockLength);

        zGm.SetGlobalBuffer(
            (__gm__ half*)z + blockIdx * blockLength,
            blockLength);

        /*
         * FP16 一个元素 2 Bytes。
         */
        pipe.InitBuffer(
            inQueueX,
            BUFFER_NUM,
            tileLength * sizeof(half));

        pipe.InitBuffer(
            inQueueY,
            BUFFER_NUM,
            tileLength * sizeof(half));

        pipe.InitBuffer(
            outQueueZ,
            BUFFER_NUM,
            tileLength * sizeof(half));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < tileNum; ++i)
        {
            CopyIn(i);
            Compute();
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t progress)
    {
        LocalTensor<half> xLocal =
            inQueueX.AllocTensor<half>();

        LocalTensor<half> yLocal =
            inQueueY.AllocTensor<half>();

        /*
         * 连续 GM -> UB。
         */
        DataCopy(
            xLocal,
            xGm[progress * tileLength],
            tileLength);

        DataCopy(
            yLocal,
            yGm[progress * tileLength],
            tileLength);

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        LocalTensor<half> xLocal =
            inQueueX.DeQue<half>();

        LocalTensor<half> yLocal =
            inQueueY.DeQue<half>();

        LocalTensor<half> zLocal =
            outQueueZ.AllocTensor<half>();

        /*
         * Vector Sub：
         *
         * z = x - y
         */
        Sub(
            zLocal,
            xLocal,
            yLocal,
            tileLength);

        outQueueZ.EnQue(zLocal);

        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t progress)
    {
        LocalTensor<half> zLocal =
            outQueueZ.DeQue<half>();

        /*
         * 连续 UB -> GM。
         */
        DataCopy(
            zGm[progress * tileLength],
            zLocal,
            tileLength);

        outQueueZ.FreeTensor(zLocal);
    }

private:
    TPipe pipe;

    TQue<TPosition::VECIN, BUFFER_NUM> inQueueX;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueY;
    TQue<TPosition::VECOUT, BUFFER_NUM> outQueueZ;

    GlobalTensor<half> xGm;
    GlobalTensor<half> yGm;
    GlobalTensor<half> zGm;

    uint32_t tileLength;
    uint32_t tileNum;
};


/*
 * ============================================================
 * FP32 Kernel Entry
 * ============================================================
 */
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    KernelSubFp32 op;

    op.Init(
        x,
        y,
        z,
        tiling.totalLength,
        tiling.tileLength,
        tiling.tileNum);

    op.Process();
}


/*
 * ============================================================
 * FP16 Kernel Entry
 * ============================================================
 */
__global__ __vector__ void sub_custom_fp16(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    KernelSubFp16 op;

    op.Init(
        x,
        y,
        z,
        tiling.totalLength,
        tiling.tileLength,
        tiling.tileNum);

    op.Process();
}


/*
 * ============================================================
 * Host Kernel Launch
 * ============================================================
 */
extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    /*
     * 本题只需要使用 x 的 TensorInfo。
     *
     * y / z 的 shape 与 x 相同，因此这里不需要重复读取。
     */
    (void)info_y;
    (void)info_z;

    const TensorInfo& tensorX = info_x.tensors[0];

    /*
     * 计算总元素数量。
     */
    uint32_t totalLength = 1;

    for (int64_t i = 0; i < tensorX.numDims; ++i)
    {
        totalLength *=
            static_cast<uint32_t>(tensorX.shape[i]);
    }

    /*
     * ========================================================
     * Core 数优化
     * ========================================================
     *
     * 本题数据量只有：
     *
     *     8 * 2048 = 16384
     *
     * 没有必要把所有可用 Core 全部打开。
     *
     * 对本题，最多使用 8 个 Core。
     *
     * 这样正常情况下：
     *
     *     16384 / 8 = 2048 elements / Core
     *
     * 正好对应一个较大的 tile。
     */
    uint32_t blockNum =
        static_cast<uint32_t>(availableCoreNum);

    if (blockNum == 0)
    {
        blockNum = 1;
    }

    /*
     * 本题最多使用 8 个 Core。
     */
    if (blockNum > 8)
    {
        blockNum = 8;
    }

    /*
     * Core 数不能超过元素数量。
     */
    if (blockNum > totalLength)
    {
        blockNum = totalLength;
    }

    /*
     * 尽量使用能够整除 totalLength 的 Core 数。
     *
     * 对 16384：
     *
     * availableCoreNum >= 8
     *     -> 8 Core
     *
     * availableCoreNum = 4
     *     -> 4 Core
     *
     * availableCoreNum = 3
     *     -> 2 Core
     */
    while (blockNum > 1 &&
           totalLength % blockNum != 0)
    {
        --blockNum;
    }

    uint32_t blockLength =
        totalLength / blockNum;

    /*
     * ========================================================
     * Tile 优化
     * ========================================================
     *
     * 原代码固定：
     *
     *     tileNum = 8
     *
     * 导致：
     *
     *     2048 / 8 = 256 elements/tile
     *
     * 每个 Core 需要处理 8 个 tile。
     *
     * 现在让单个 tile 尽量接近 2048 个元素。
     *
     * 对本题：
     *
     *     blockLength = 2048
     *
     * 因此：
     *
     *     tileLength = 2048
     *     tileNum    = 1
     *
     * 大幅减少循环、Queue 和 DataCopy 次数。
     */
    uint32_t tileNum = 1;

    if (blockLength > MAX_TILE_LENGTH)
    {
        /*
         * 计算最少需要多少个 tile，
         * 使得每个 tile 不超过 MAX_TILE_LENGTH。
         */
        tileNum =
            (blockLength + MAX_TILE_LENGTH - 1) /
            MAX_TILE_LENGTH;
    }

    /*
     * 为了让每个 tile 长度完全相等，
     * tileNum 必须能够整除 blockLength。
     */
    while (tileNum > 1 &&
           blockLength % tileNum != 0)
    {
        ++tileNum;
    }

    uint32_t tileLength =
        blockLength / tileNum;

    /*
     * ========================================================
     * Tiling Data
     * ========================================================
     */
    SubCustomTilingData tiling;

    tiling.totalLength = totalLength;
    tiling.tileLength = tileLength;
    tiling.tileNum = tileNum;

    /*
     * ========================================================
     * Data Type
     * ========================================================
     *
     * dtype == 0 : float32
     * dtype == 1 : float16
     *
     * 保持原题模板的 dtype 判断方式。
     */
    int32_t dtype = tensorX.dtype;

    if (dtype == 0)
    {
        sub_custom<<<
            blockNum,
            nullptr,
            stream>>>(
            x,
            y,
            z,
            tiling);
    }
    else if (dtype == 1)
    {
        sub_custom_fp16<<<
            blockNum,
            nullptr,
            stream>>>(
            x,
            y,
            z,
            tiling);
    }
}