#include <cmath>
#include "kernel_operator.h"

// ---------------------------------------------------------------------------
// Tiling 参数：host侧run_kernel计算，值传递给device核函数
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint32_t totalLength;   // 张量全部元素数量
    uint32_t tileNum;       // 单核内部切分tile块数目
};

constexpr uint32_t BUFFER_NUM = 2;
constexpr uint32_t QUEUE_DEPTH = 1;

// ---------------------------------------------------------------------------
// KernelSub 矢量减法算子：z = x - y
// 多核并行，单核内部再切分多块，TPipe+TQue完成GM‑UB搬运与计算
// ---------------------------------------------------------------------------
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling)
    {
        uint32_t fullElemCnt = tiling.totalLength;
        uint32_t perCoreTileCnt = tiling.tileNum;

        // 获取当前核编号
        uint32_t coreIdx = AscendC::GetBlockIdx();
        uint32_t coreCount = AscendC::GetBlockNum();

        // 每个核承担的元素总量
        this->coreWorkElem = fullElemCnt / coreCount;
        this->tileCnt = perCoreTileCnt;
        // 每一块处理元素大小
        this->perTileElem = this->coreWorkElem / perCoreTileCnt / BUFFER_NUM;

        // 给每个核设置GM缓冲区，偏移到本核处理区间
        xGm.SetGlobalBuffer((__gm__ float *)x + coreIdx * this->coreWorkElem, this->coreWorkElem);
        yGm.SetGlobalBuffer((__gm__ float *)y + coreIdx * this->coreWorkElem, this->coreWorkElem);
        zGm.SetGlobalBuffer((__gm__ float *)z + coreIdx * this->coreWorkElem, this->coreWorkElem);

        // UB队列内存分配
        pipe.InitBuffer(inXQueue, BUFFER_NUM, this->perTileElem * sizeof(float));
        pipe.InitBuffer(inYQueue, BUFFER_NUM, this->perTileElem * sizeof(float));
        pipe.InitBuffer(outZQueue, BUFFER_NUM, this->perTileElem * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        int32_t totalTask = static_cast<int32_t>(this->tileCnt * BUFFER_NUM);
        for (int32_t taskId = 0; taskId < totalTask; taskId++) {
            CopyInData(taskId);
            DoCompute(taskId);
            CopyOutData(taskId);
        }
    }

private:
    __aicore__ inline void CopyInData(int32_t taskId)
    {
        AscendC::LocalTensor<float> xBuf = inXQueue.AllocTensor<float>();
        AscendC::LocalTensor<float> yBuf = inYQueue.AllocTensor<float>();

        uint32_t gmOffset = static_cast<uint32_t>(taskId) * this->perTileElem;
        AscendC::DataCopy(xBuf, xGm[gmOffset], this->perTileElem);
        AscendC::DataCopy(yBuf, yGm[gmOffset], this->perTileElem);

        inXQueue.EnQue(xBuf);
        inYQueue.EnQue(yBuf);
    }

    __aicore__ inline void DoCompute(int32_t taskId)
    {
        AscendC::LocalTensor<float> inputX = inXQueue.DeQue<float>();
        AscendC::LocalTensor<float> inputY = inYQueue.DeQue<float>();
        AscendC::LocalTensor<float> outputZ = outZQueue.AllocTensor<float>();

        // 执行矢量减法 z = x - y
        AscendC::Sub(outputZ, inputX, inputY, this->perTileElem);

        outZQueue.EnQue(outputZ);
        // 释放输入UB内存
        inXQueue.FreeTensor(inputX);
        inYQueue.FreeTensor(inputY);
    }

    __aicore__ inline void CopyOutData(int32_t taskId)
    {
        AscendC::LocalTensor<float> resBuf = outZQueue.DeQue<float>();
        uint32_t gmOffset = static_cast<uint32_t>(taskId) * this->perTileElem;
        AscendC::DataCopy(zGm[gmOffset], resBuf, this->perTileElem);
        outZQueue.FreeTensor(resBuf);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, QUEUE_DEPTH> inXQueue, inYQueue;
    AscendC::TQue<AscendC::TPosition::VECOUT, QUEUE_DEPTH> outZQueue;

    AscendC::GlobalTensor<float> xGm, yGm, zGm;

    uint32_t coreWorkElem;   // 当前核处理总元素数
    uint32_t tileCnt;        // 单核tile块数量
    uint32_t perTileElem;    // 单块tile元素数目
};

// ---------------------------------------------------------------------------
// device核入口函数，赛题规定签名不可修改
// ---------------------------------------------------------------------------
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub kernelObj;
    kernelObj.Init(x, y, z, tiling);
    kernelObj.Process();
}

// ---------------------------------------------------------------------------
// host侧启动函数，严格匹配题目函数签名
// ---------------------------------------------------------------------------
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    constexpr uint32_t BLOCK_DIM = 8;
    const TensorInfo& tensorMeta = info_x.tensors[0];

    int64_t elemTotal = 1;
    // 遍历张量所有维度相乘求总元素
    for (int64_t dimIdx = 0; dimIdx < tensorMeta.numDims; dimIdx++) {
        elemTotal = elemTotal * tensorMeta.shape[dimIdx];
    }

    uint32_t tileNumber = 8;
    SubCustomTilingData tilingParam{static_cast<uint32_t>(elemTotal), tileNumber};
    sub_custom<<<BLOCK_DIM, nullptr, stream>>>(x, y, z, tilingParam);
}
