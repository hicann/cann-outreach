#include <cmath>
#include "kernel_operator.h"
/*
 * Sub Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined in main.asc):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *   Usage: info_x.tensors[0].shape[0]  // first dim of first tensor in input x
 */

// ---------------------------------------------------------------------------
// Tiling 参数：由 host 侧 run_kernel 计算后按值传给核函数
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint32_t totalLength; // 张量总元素数
    uint32_t coreNum;     // block 数
    uint32_t perCoreLen8; // 每核基础元素数（8 元素对齐 = 32B，保证 GM/UB 地址对齐）
                          // 最后一核可能多处理剩余尾块，不会丢弃尾部数据
};

constexpr uint32_t BUFFER_NUM = 1;   // tensor num for each queue
constexpr uint32_t QUEUE_DEPTH = 1;

// ---------------------------------------------------------------------------
// KernelSub：z = x - y，每核单 tile 计算，尾块由最后一核收尾
// ---------------------------------------------------------------------------
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling)
    {
        // 每核 8 对齐偏移；最后一核收尾：coreDataNum = totalLength - 前面核已覆盖量
        this->offset = AscendC::GetBlockIdx() * tiling.perCoreLen8;
        if (AscendC::GetBlockIdx() == tiling.coreNum - 1) {
            this->coreDataNum = tiling.totalLength - this->offset;
        } else {
            this->coreDataNum = tiling.perCoreLen8;
        }
        // fp32 矢量指令要求长度 8 的倍数：计算长度向上对齐（多余部分不写回 GM）
        this->calcCount = (this->coreDataNum + 7) / 8 * 8;

        xGm.SetGlobalBuffer((__gm__ float*)x + this->offset, this->coreDataNum);
        yGm.SetGlobalBuffer((__gm__ float*)y + this->offset, this->coreDataNum);
        zGm.SetGlobalBuffer((__gm__ float*)z + this->offset, this->coreDataNum);
        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->calcCount * sizeof(float));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->calcCount * sizeof(float));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->calcCount * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        if (this->coreDataNum == 0) {
            return; // 空核（数据量小于核数时）直接退出
        }
        CopyIn(0);
        Compute(0);
        CopyOut(0);
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        AscendC::LocalTensor<float> xLocal = inQueueX.AllocTensor<float>();
        AscendC::LocalTensor<float> yLocal = inQueueY.AllocTensor<float>();
        AscendC::DataCopy(xLocal, xGm, this->coreDataNum);
        AscendC::DataCopy(yLocal, yGm, this->coreDataNum);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(int32_t progress)
    {
        AscendC::LocalTensor<float> xLocal = inQueueX.DeQue<float>();
        AscendC::LocalTensor<float> yLocal = inQueueY.DeQue<float>();
        AscendC::LocalTensor<float> zLocal = outQueueZ.AllocTensor<float>();
        // z = x - y；按 calcCount 计算（对齐到 8），只回拷 coreDataNum 个有效元素
        AscendC::Sub(zLocal, xLocal, yLocal, this->calcCount);
        outQueueZ.EnQue<float>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int32_t progress)
    {
        AscendC::LocalTensor<float> zLocal = outQueueZ.DeQue<float>();
        AscendC::DataCopy(zGm, zLocal, this->coreDataNum);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueX;
    AscendC::TQue<AscendC::QuePosition::VECIN, QUEUE_DEPTH> inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, QUEUE_DEPTH> outQueueZ;
    AscendC::GlobalTensor<float> xGm, yGm, zGm;
    uint32_t coreDataNum; // 本核处理的元素数
    uint32_t calcCount;   // 计算长度（8 对齐）
    uint32_t offset;      // 本核 GM 起始偏移（元素）
};

// ---------------------------------------------------------------------------
// 核函数入口：实例化 KernelSub 并执行
// ---------------------------------------------------------------------------
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub op;
    op.Init(x, y, z, tiling);
    op.Process();
}

// ---------------------------------------------------------------------------
// host 侧启动函数：从 TensorGroupInfo 推导 tiling 并启动核函数
// ---------------------------------------------------------------------------
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    // 1. 取总元素数（x/y/z 形状一致）
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }

    // 2. 核数：不超过可用核数；保证每核至少 8 个元素（32B 对齐）
    int64_t maxCores = totalLength / 8;
    if (maxCores < 1) {
        maxCores = 1;
    }
    uint32_t coreNum = (availableCoreNum < maxCores) ? (uint32_t)availableCoreNum : (uint32_t)maxCores;

    // 3. 每核基础长度向下对齐到 8；最后一核收尾，尾块不丢弃
    uint32_t perCoreLen8 = (uint32_t)((totalLength / coreNum / 8) * 8);

    SubCustomTilingData tiling = {(uint32_t)totalLength, coreNum, perCoreLen8};
    sub_custom<<<coreNum, nullptr, stream>>>(x, y, z, tiling);
}
