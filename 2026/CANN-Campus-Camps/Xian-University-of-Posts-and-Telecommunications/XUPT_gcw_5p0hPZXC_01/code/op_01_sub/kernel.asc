#include <cmath>
#include "kernel_operator.h"


struct SubCustomTilingData
{
    uint32_t totalLength;
    uint32_t dtype;
};


template <typename T>
class KernelSub
{
public:
    __aicore__ inline KernelSub()
    {
    }

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        uint32_t totalLength)
    {
        uint32_t blockNum =
            AscendC::GetBlockNum();

        uint32_t blockIdx =
            AscendC::GetBlockIdx();

        /*
         * 本题：
         *
         * totalLength = 16384
         * blockNum    = 8
         * blockLength = 2048
         */
        blockLength =
            totalLength / blockNum;

        xGm.SetGlobalBuffer(
            reinterpret_cast<__gm__ T*>(x)
                + blockIdx * blockLength,
            blockLength);

        yGm.SetGlobalBuffer(
            reinterpret_cast<__gm__ T*>(y)
                + blockIdx * blockLength,
            blockLength);

        zGm.SetGlobalBuffer(
            reinterpret_cast<__gm__ T*>(z)
                + blockIdx * blockLength,
            blockLength);

        /*
         * Local Memory:
         *
         * xLocal
         * yLocal
         * zLocal
         *
         * 一共三块。
         */
        pipe.InitBuffer(
            localBuf,
            blockLength * sizeof(T) * 3);
    }


    __aicore__ inline void Process()
    {
        /*
         * Local Memory 布局：
         *
         * ┌──────────────┐
         * │    xLocal    │
         * ├──────────────┤
         * │    yLocal    │
         * ├──────────────┤
         * │    zLocal    │
         * └──────────────┘
         */

        AscendC::LocalTensor<T> xLocal =
            localBuf.Get<T>(blockLength);

        AscendC::LocalTensor<T> yLocal =
            localBuf.GetWithOffset<T>(
                blockLength,
                blockLength * sizeof(T));

        AscendC::LocalTensor<T> zLocal =
            localBuf.GetWithOffset<T>(
                blockLength,
                blockLength * sizeof(T) * 2);


        /*
         * 1. GM -> Local
         */
        AscendC::DataCopy(
            xLocal,
            xGm,
            blockLength);

        AscendC::DataCopy(
            yLocal,
            yGm,
            blockLength);


        /*
         * 2. z = -y
         *
         * 使用 Muls：
         *
         * zLocal = yLocal * (-1)
         */
        T negOne = static_cast<T>(-1);

        AscendC::Muls(
            zLocal,
            yLocal,
            negOne,
            blockLength);


        /*
         * 3. z = x + z
         *
         * 此时：
         *
         * z = x + (-y)
         *   = x - y
         */
        AscendC::Add(
            zLocal,
            xLocal,
            zLocal,
            blockLength);


        /*
         * 4. Local -> GM
         */
        AscendC::DataCopy(
            zGm,
            zLocal,
            blockLength);
    }


private:

    AscendC::TPipe pipe;

    AscendC::TBuf<
        AscendC::TPosition::VECCALC> localBuf;

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    uint32_t blockLength = 0;
};


__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    if (tiling.dtype == 0)
    {
        KernelSub<float> op;

        op.Init(
            x,
            y,
            z,
            tiling.totalLength);

        op.Process();
    }
    else
    {
        KernelSub<half> op;

        op.Init(
            x,
            y,
            z,
            tiling.totalLength);

        op.Process();
    }
}


extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    const TensorInfo& tensorInfo =
        info_x.tensors[0];

    uint32_t totalLength = 1;

    for (int64_t i = 0;
         i < tensorInfo.numDims;
         ++i)
    {
        totalLength *=
            static_cast<uint32_t>(
                tensorInfo.shape[i]);
    }


    /*
     * 本题固定：
     *
     * (8, 2048)
     *
     * 16384 / 8 = 2048
     */
    uint32_t coreNum =
        static_cast<uint32_t>(
            availableCoreNum);

    if (coreNum > 8)
    {
        coreNum = 8;
    }

    if (coreNum == 0)
    {
        return;
    }


    /*
     * 保证每个 Core 数据完整。
     */
    if (totalLength % coreNum != 0)
    {
        coreNum = 1;
    }


    uint32_t dtype =
        static_cast<uint32_t>(
            tensorInfo.dtype);


    SubCustomTilingData tiling;

    tiling.totalLength = totalLength;
    tiling.dtype = dtype;


    sub_custom<<<
        coreNum,
        nullptr,
        stream>>>(
            x,
            y,
            z,
            tiling);
}