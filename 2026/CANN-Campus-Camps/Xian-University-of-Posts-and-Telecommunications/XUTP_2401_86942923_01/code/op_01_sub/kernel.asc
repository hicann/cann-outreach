#include <cmath>
#include "kernel_operator.h"

// ---------------------------------------------------------------------------
// Tiling 参数：所有计算均在 Host 完成，减少核内运算
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint32_t blockLength;   // 每个核处理的数据长度（元素个数）
    uint32_t tileLength;    // 每个缓冲块长度（元素个数）
    uint32_t tileNum;       // 单核内分块数（固定为1，此处仅占位）
};

constexpr uint32_t BUFFER_NUM = 2;   // 双缓冲
constexpr uint32_t QUEUE_DEPTH = 2;  // 队列深度匹配

// ---------------------------------------------------------------------------
// KernelSub：z = x - y，采用三重流水线（预取 + 计算 + 搬出）
// ---------------------------------------------------------------------------
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling)
    {
        // 直接使用 Host 传过来的值，不做除法
        this->blockLength = tiling.blockLength;
        this->tileLength   = tiling.tileLength;
        this->tileNum      = tiling.tileNum;

        uint32_t offset = this->blockLength * AscendC::GetBlockIdx();
        xGm.SetGlobalBuffer((__gm__ float *)x + offset, this->blockLength);
        yGm.SetGlobalBuffer((__gm__ float *)y + offset, this->blockLength);
        zGm.SetGlobalBuffer((__gm__ float *)z + offset, this->blockLength);

        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(float));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(float));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        int32_t loopCount = this->tileNum * BUFFER_NUM;  // = 2

        // 预取第 0 块输入
        CopyIn(0);

        for (int32_t i = 0; i < loopCount; i++) {
            // 1. 搬出上一块结果（第 i-1 块）
            if (i > 0) {
                CopyOut(i - 1);
            }
            // 2. 预取下一块输入（第 i+1 块）
            if (i + 1 < loopCount) {
                CopyIn(i + 1);
            }
            // 3. 计算当前块（第 i 块）
            Compute(i);
        }
        // 搬出最后一块
        CopyOut(loopCount - 1);
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        AscendC::LocalTensor<float> xLocal = inQueueX.AllocTensor<float>();
        AscendC::LocalTensor<float> yLocal = inQueueY.AllocTensor<float>();
        AscendC::DataCopy(xLocal, xGm[progress * this->tileLength], this->tileLength);
        AscendC::DataCopy(yLocal, yGm[progress * this->tileLength], this->tileLength);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(int32_t progress)
    {
        AscendC::LocalTensor<float> xLocal = inQueueX.DeQue<float>();
        AscendC::LocalTensor<float> yLocal = inQueueY.DeQue<float>();
        AscendC::LocalTensor<float> zLocal = outQueueZ.AllocTensor<float>();
        AscendC::Sub(zLocal, xLocal, yLocal, this->tileLength);
        outQueueZ.EnQue<float>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int32_t progress)
    {
        AscendC::LocalTensor<float> zLocal = outQueueZ.DeQue<float>();
        AscendC::DataCopy(zGm[progress * this->tileLength], zLocal, this->tileLength);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, QUEUE_DEPTH> inQueueX, inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, QUEUE_DEPTH> outQueueZ;
    AscendC::GlobalTensor<float> xGm, yGm, zGm;

    uint32_t blockLength;
    uint32_t tileLength;
    uint32_t tileNum;
};

// ---------------------------------------------------------------------------
// 核函数入口
// ---------------------------------------------------------------------------
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub op;
    op.Init(x, y, z, tiling);
    op.Process();
}

// ---------------------------------------------------------------------------
// Host 侧启动函数（计算 Tiling 并传值）
// ---------------------------------------------------------------------------
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    constexpr uint32_t blockDim = 8;
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }

    // 每个核处理的数据长度
    uint32_t blockLength = static_cast<uint32_t>(totalLength / blockDim);
    // 固定 tileNum = 1，每个核的数据再分成 BUFFER_NUM 个缓冲块
    uint32_t tileNum = 1;
    uint32_t tileLength = blockLength / tileNum / BUFFER_NUM;

    SubCustomTilingData tiling = {blockLength, tileLength, tileNum};
    sub_custom<<<blockDim, nullptr, stream>>>(x, y, z, tiling);
}