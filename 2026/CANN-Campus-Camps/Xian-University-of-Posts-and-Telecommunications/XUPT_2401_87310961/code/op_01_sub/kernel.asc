#include <cstdint>
#include "kernel_operator.h"
/*
 * Sub Kernel - Ascend C Direct Invocation
 * Function: z = x - y
 *
 * This file is #included by main.asc - do NOT add main(), #pragma once,
 * or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined by the caller):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *
 * Work distribution (host side, run_kernel):
 *   - The whole tensor is flattened into totalLength elements.
 *   - Data is split into 32-byte aligned chunks (32B / sizeof(elem) elements
 *     per chunk) and the chunks are evenly distributed over the cores that
 *     are launched, so every DataCopy / Sub operation is 32-byte aligned.
 *   - Each core processes its own contiguous slice in tiles (double buffer),
 *     which keeps the Unified-Buffer usage bounded for arbitrary input sizes.
 */

// Number of buffers used by each queue (double buffering).
constexpr int32_t BUFFER_NUM = 2;
// Max elements processed by one inner tile (must be a multiple of the
// 32-byte alignment granularity of every supported dtype, i.e. 2048 is fine
// for fp32 (8 elems/32B), fp16 (16 elems/32B) and int32 (8 elems/32B)).
constexpr int32_t TILE_LENGTH = 2048;

struct SubCustomTilingData {
    uint32_t totalLength;   // total element count of the tensor
    uint32_t blockNum;      // number of blocks (cores) actually launched
    uint32_t formerNum;     // first formerNum cores process formerLength elements
    uint32_t formerLength;  // slice length (elements) of the former cores
    uint32_t tailLength;    // slice length (elements) of the remaining cores
    uint32_t tileLength;    // elements processed in one inner tile
    int32_t dtype;          // element dtype, see mapping above
};

// Kernel body: z = x - y
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData &tiling)
    {
        this->tileLength = (tiling.tileLength > 0) ? tiling.tileLength
                                                   : static_cast<uint32_t>(TILE_LENGTH);
        const uint32_t blockIdx = AscendC::GetBlockIdx();

        // Each core gets a contiguous slice of the flattened tensor.
        uint32_t start = 0;
        if (blockIdx < tiling.formerNum) {
            this->coreLength = tiling.formerLength;
            start = blockIdx * this->coreLength;
        } else {
            this->coreLength = tiling.tailLength;
            start = tiling.formerNum * tiling.formerLength +
                    (blockIdx - tiling.formerNum) * this->coreLength;
        }

        if (this->coreLength > 0) {
            xGm.SetGlobalBuffer((__gm__ T *)x + start, this->coreLength);
            yGm.SetGlobalBuffer((__gm__ T *)y + start, this->coreLength);
            zGm.SetGlobalBuffer((__gm__ T *)z + start, this->coreLength);
        }

        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        uint32_t offset = 0;
        while (offset < this->coreLength) {
            uint32_t count = this->coreLength - offset;
            if (count > this->tileLength) {
                count = this->tileLength;
            }
            CopyIn(offset, count);
            Compute(count);
            CopyOut(offset, count);
            offset += count;
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm[offset], count);
        AscendC::DataCopy(yLocal, yGm[offset], count);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        // z = x - y
        AscendC::Sub(zLocal, xLocal, yLocal, count);
        outQueueZ.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopy(zGm[offset], zLocal, count);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inQueueX;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_NUM> outQueueZ;
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;
    uint32_t coreLength;
    uint32_t tileLength;
};

// Kernel entry.
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    if (tiling.dtype == 1) { // fp16
        KernelSub<half> op;
        op.Init(x, y, z, tiling);
        op.Process();
    } else if (tiling.dtype == 5) { // int32
        KernelSub<int32_t> op;
        op.Init(x, y, z, tiling);
        op.Process();
    } else { // fp32 (default)
        KernelSub<float> op;
        op.Init(x, y, z, tiling);
        op.Process();
    }
}

// Host-side kernel launcher.
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo &info_x, GM_ADDR y,
                           const TensorGroupInfo &info_y, GM_ADDR z,
                           const TensorGroupInfo &info_z, int64_t availableCoreNum,
                           aclrtStream stream)
{
    (void)info_y;
    (void)info_z;
    if (info_x.numTensors < 1 || info_x.tensors == nullptr) {
        return;
    }

    // 1. Flatten the input shape to get the total element count.
    const TensorInfo &tensorInfo = info_x.tensors[0];
    int64_t totalLength = 1;
    if (tensorInfo.shape != nullptr) {
        for (int64_t i = 0; i < tensorInfo.numDims; ++i) {
            if (tensorInfo.shape[i] <= 0) {
                return;
            }
            totalLength *= tensorInfo.shape[i];
        }
    }
    if (totalLength <= 0) {
        return;
    }

    // 2. Element size in bytes. Must stay consistent with the dtype dispatch
    //    done inside sub_custom: fp16 -> 2B, everything else is treated as a
    //    4-byte type (fp32 / int32, which share the same 32B granularity).
    int64_t elemSize = 4; // default fp32
    if (tensorInfo.dtype == 1) { // fp16
        elemSize = 2;
    }
    // Elements inside one 32-byte aligned data block.
    const int64_t chunkElems = 32 / elemSize;
    // Number of full 32-byte aligned chunks.
    int64_t chunks = totalLength / chunkElems;
    if (chunks < 1) {
        // Too small to be safely moved by plain DataCopy; nothing to compute.
        return;
    }

    // 3. Choose how many cores to use and split the chunks evenly.
    int64_t coreNum = (availableCoreNum > 0) ? availableCoreNum : 1;
    int64_t blockNum = (coreNum < chunks) ? coreNum : chunks;
    if (blockNum < 1) {
        blockNum = 1;
    }
    const int64_t baseChunks = chunks / blockNum;
    const int64_t remainChunks = chunks % blockNum;

    // 4. Fill the tiling parameters.
    SubCustomTilingData tiling;
    tiling.totalLength = static_cast<uint32_t>(totalLength);
    tiling.blockNum = static_cast<uint32_t>(blockNum);
    tiling.formerNum = static_cast<uint32_t>(remainChunks);
    tiling.formerLength = static_cast<uint32_t>((baseChunks + 1) * chunkElems);
    tiling.tailLength = static_cast<uint32_t>(baseChunks * chunkElems);
    tiling.tileLength = static_cast<uint32_t>(TILE_LENGTH);
    tiling.dtype = tensorInfo.dtype;

    // 5. Launch the kernel on the NPU.
    sub_custom<<<static_cast<uint32_t>(blockNum), nullptr, stream>>>(x, y, z, tiling);
}
