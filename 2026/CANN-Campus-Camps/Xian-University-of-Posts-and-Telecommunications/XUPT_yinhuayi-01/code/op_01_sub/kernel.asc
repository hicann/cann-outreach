#include "kernel_operator.h"
#include <cstdint>

using namespace AscendC;

constexpr uint32_t BUFFER_NUM = 1;
constexpr uint32_t QUEUE_DEPTH = 1;

struct SubCustomTilingData {
    uint32_t totalLength;
    uint32_t blockLength;
    int32_t dtype;
};

template <typename T>
class KernelSub {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling)
    {
        blockLength_ = tiling.blockLength;
        uint32_t offset = GetBlockIdx() * blockLength_;

        xGm_.SetGlobalBuffer((__gm__ T*)x + offset, blockLength_);
        yGm_.SetGlobalBuffer((__gm__ T*)y + offset, blockLength_);
        zGm_.SetGlobalBuffer((__gm__ T*)z + offset, blockLength_);

        pipe_.InitBuffer(inQueueX_, BUFFER_NUM, blockLength_ * sizeof(T));
        pipe_.InitBuffer(inQueueY_, BUFFER_NUM, blockLength_ * sizeof(T));
        pipe_.InitBuffer(outQueueZ_, BUFFER_NUM, blockLength_ * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        LocalTensor<T> xLocal = inQueueX_.AllocTensor<T>();
        LocalTensor<T> yLocal = inQueueY_.AllocTensor<T>();
        LocalTensor<T> zLocal = outQueueZ_.AllocTensor<T>();

        DataCopy(xLocal, xGm_, blockLength_);
        DataCopy(yLocal, yGm_, blockLength_);

        inQueueX_.EnQue(xLocal);
        inQueueY_.EnQue(yLocal);

        xLocal = inQueueX_.DeQue<T>();
        yLocal = inQueueY_.DeQue<T>();

        Sub(zLocal, xLocal, yLocal, blockLength_);

        outQueueZ_.EnQue(zLocal);
        zLocal = outQueueZ_.DeQue<T>();

        DataCopy(zGm_, zLocal, blockLength_);

        inQueueX_.FreeTensor(xLocal);
        inQueueY_.FreeTensor(yLocal);
        outQueueZ_.FreeTensor(zLocal);
    }

private:
    TPipe pipe_;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueX_;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueY_;
    TQue<QuePosition::VECOUT, BUFFER_NUM> outQueueZ_;
    GlobalTensor<T> xGm_;
    GlobalTensor<T> yGm_;
    GlobalTensor<T> zGm_;
    uint32_t blockLength_ = 0;
};

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    (void)info_y;
    (void)info_z;
    (void)availableCoreNum;

    int64_t total = 1;
    for (int64_t i = 0; i < info_x.tensors[0].numDims; ++i) {
        total *= info_x.tensors[0].shape[i];
    }

    uint32_t totalLength = static_cast<uint32_t>(total);
    constexpr uint32_t blockDim = 8;

    SubCustomTilingData tiling;
    tiling.totalLength = totalLength;
    tiling.blockLength = totalLength / blockDim;
    tiling.dtype = info_x.tensors[0].dtype;

    if (tiling.dtype == 1) {
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}