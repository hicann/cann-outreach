#include <cmath>
#include "kernel_operator.h"
using namespace AscendC;

//1、tiling结构体，题目强制要求
struct SubCustomTilingData {
    int32_t totalLength;
    int32_t tileNum;
    int32_t tileLength;
};

//2、算子类
class KernelSub {
public:
    __aicore__ inline void Init(SubCustomTilingData tiling)
    {
        tileNum = tiling.tileNum;
        tileLength = tiling.tileLength;
        const int32_t BUF_NUM = 2;
        pipe.InitBuffer(inQueueX, BUF_NUM, tileLength * sizeof(float));
        pipe.InitBuffer(inQueueY, BUF_NUM, tileLength * sizeof(float));
        pipe.InitBuffer(outQueueZ, BUF_NUM, tileLength * sizeof(float));
    }

    __aicore__ inline void Process(GM_ADDR xGm, GM_ADDR yGm, GM_ADDR zGm, int32_t coreId, int32_t coreTotal)
    {
        GlobalTensor<float> xGbuf, yGbuf, zGbuf;
        LocalTensor<float> xUb, yUb, zUb;
        //遍历当前核心负责的所有tile
        for(int32_t i = coreId; i < tileNum; i += coreTotal)
        {
            //搬运1块输入
            xUb = inQueueX.AllocTensor<float>();
            yUb = inQueueY.AllocTensor<float>();
            xGbuf.SetGlobalBuffer((__gm__ float *)xGm + i * tileLength, tileLength);
            yGbuf.SetGlobalBuffer((__gm__ float *)yGm + i * tileLength, tileLength);
            DataCopy(xUb, xGbuf, tileLength);
            DataCopy(yUb, yGbuf, tileLength);
            inQueueX.EnQue(xUb);
            inQueueY.EnQue(yUb);

            //取出，计算减法
            xUb = inQueueX.DeQue<float>();
            yUb = inQueueY.DeQue<float>();
            zUb = outQueueZ.AllocTensor<float>();
            Sub(zUb, xUb, yUb, tileLength);
            outQueueZ.EnQue(zUb);
            inQueueX.FreeTensor(xUb);
            inQueueY.FreeTensor(yUb);

            //结果写回GM
            zUb = outQueueZ.DeQue<float>();
            zGbuf.SetGlobalBuffer((__gm__ float *)zGm + i * tileLength, tileLength);
            DataCopy(zGbuf, zUb, tileLength);
            outQueueZ.FreeTensor(zUb);
        }
    }

private:
    int32_t tileNum;
    int32_t tileLength;
    TPipe pipe;
    TQue<QuePosition::VECIN,2> inQueueX;
    TQue<QuePosition::VECIN,2> inQueueY;
    TQue<QuePosition::VECOUT,2> outQueueZ;
};

//3、核函数入口，签名严格匹配题目
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub op;
    op.Init(tiling);
    int32_t coreIdx = GetBlockIdx();
    int32_t coreCnt = GetBlockNum();
    op.Process(x,y,z,coreIdx,coreCnt);
}

//4、Host启动函数，参数完全和题目一致
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    int64_t totalElem = 1;
    for(int64_t i = 0; i < info_x.tensors[0].numDims; i++)
    {
        totalElem *= info_x.tensors[0].shape[i];
    }
    SubCustomTilingData tilingData;
    tilingData.totalLength = static_cast<int32_t>(totalElem);
    const int32_t TILE_LEN = 1024;
    tilingData.tileLength = TILE_LEN;
    tilingData.tileNum = (tilingData.totalLength + TILE_LEN -1)/TILE_LEN;
    int32_t blockNum = static_cast<int32_t>(availableCoreNum);
    sub_custom<<<blockNum, nullptr, stream>>>(x, y, z, tilingData);
}
