#include <cmath>
#include "kernel_operator.h"

using namespace AscendC;

constexpr uint32_t BUFFER_NUM = 2;

struct SubCustomTilingData
{
    uint32_t totalLength;
    uint32_t tileLength;
    uint32_t tileNum;
};

/*
 * =========================
 * FP32 Kernel
 * =========================
 */
class KernelSubFp32
{
public:
    __aicore__ inline KernelSubFp32()
    {
    }

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        uint32_t totalLength,
        uint32_t tileLength,
        uint32_t tileNum)
    {
        this->tileLength = tileLength;
        this->tileNum = tileNum;

        uint32_t blockNum = GetBlockNum();
        uint32_t blockIdx = GetBlockIdx();

        uint32_t blockLength = totalLength / blockNum;

        xGm.SetGlobalBuffer(
            (__gm__ float*)x + blockIdx * blockLength,
            blockLength);

        yGm.SetGlobalBuffer(
            (__gm__ float*)y + blockIdx * blockLength,
            blockLength);

        zGm.SetGlobalBuffer(
            (__gm__ float*)z + blockIdx * blockLength,
            blockLength);

        pipe.InitBuffer(
            inQueueX,
            BUFFER_NUM,
            tileLength * sizeof(float));

        pipe.InitBuffer(
            inQueueY,
            BUFFER_NUM,
            tileLength * sizeof(float));

        pipe.InitBuffer(
            outQueueZ,
            BUFFER_NUM,
            tileLength * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < tileNum; ++i)
        {
            CopyIn(i);
            Compute();
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t progress)
    {
        LocalTensor<float> xLocal =
            inQueueX.AllocTensor<float>();

        LocalTensor<float> yLocal =
            inQueueY.AllocTensor<float>();

        DataCopy(
            xLocal,
            xGm[progress * tileLength],
            tileLength);

        DataCopy(
            yLocal,
            yGm[progress * tileLength],
            tileLength);

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        LocalTensor<float> xLocal =
            inQueueX.DeQue<float>();

        LocalTensor<float> yLocal =
            inQueueY.DeQue<float>();

        LocalTensor<float> zLocal =
            outQueueZ.AllocTensor<float>();

        Sub(
            zLocal,
            xLocal,
            yLocal,
            tileLength);

        outQueueZ.EnQue(zLocal);

        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t progress)
    {
        LocalTensor<float> zLocal =
            outQueueZ.DeQue<float>();

        DataCopy(
            zGm[progress * tileLength],
            zLocal,
            tileLength);

        outQueueZ.FreeTensor(zLocal);
    }

private:
    TPipe pipe;

    TQue<TPosition::VECIN, BUFFER_NUM> inQueueX;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueY;
    TQue<TPosition::VECOUT, BUFFER_NUM> outQueueZ;

    GlobalTensor<float> xGm;
    GlobalTensor<float> yGm;
    GlobalTensor<float> zGm;

    uint32_t tileLength;
    uint32_t tileNum;
};


/*
 * =========================
 * FP16 Kernel
 * =========================
 */
class KernelSubFp16
{
public:
    __aicore__ inline KernelSubFp16()
    {
    }

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        uint32_t totalLength,
        uint32_t tileLength,
        uint32_t tileNum)
    {
        this->tileLength = tileLength;
        this->tileNum = tileNum;

        uint32_t blockNum = GetBlockNum();
        uint32_t blockIdx = GetBlockIdx();

        uint32_t blockLength = totalLength / blockNum;

        xGm.SetGlobalBuffer(
            (__gm__ half*)x + blockIdx * blockLength,
            blockLength);

        yGm.SetGlobalBuffer(
            (__gm__ half*)y + blockIdx * blockLength,
            blockLength);

        zGm.SetGlobalBuffer(
            (__gm__ half*)z + blockIdx * blockLength,
            blockLength);

        pipe.InitBuffer(
            inQueueX,
            BUFFER_NUM,
            tileLength * sizeof(half));

        pipe.InitBuffer(
            inQueueY,
            BUFFER_NUM,
            tileLength * sizeof(half));

        pipe.InitBuffer(
            outQueueZ,
            BUFFER_NUM,
            tileLength * sizeof(half));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < tileNum; ++i)
        {
            CopyIn(i);
            Compute();
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t progress)
    {
        LocalTensor<half> xLocal =
            inQueueX.AllocTensor<half>();

        LocalTensor<half> yLocal =
            inQueueY.AllocTensor<half>();

        DataCopy(
            xLocal,
            xGm[progress * tileLength],
            tileLength);

        DataCopy(
            yLocal,
            yGm[progress * tileLength],
            tileLength);

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        LocalTensor<half> xLocal =
            inQueueX.DeQue<half>();

        LocalTensor<half> yLocal =
            inQueueY.DeQue<half>();

        LocalTensor<half> zLocal =
            outQueueZ.AllocTensor<half>();

        Sub(
            zLocal,
            xLocal,
            yLocal,
            tileLength);

        outQueueZ.EnQue(zLocal);

        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t progress)
    {
        LocalTensor<half> zLocal =
            outQueueZ.DeQue<half>();

        DataCopy(
            zGm[progress * tileLength],
            zLocal,
            tileLength);

        outQueueZ.FreeTensor(zLocal);
    }

private:
    TPipe pipe;

    TQue<TPosition::VECIN, BUFFER_NUM> inQueueX;
    TQue<TPosition::VECIN, BUFFER_NUM> inQueueY;
    TQue<TPosition::VECOUT, BUFFER_NUM> outQueueZ;

    GlobalTensor<half> xGm;
    GlobalTensor<half> yGm;
    GlobalTensor<half> zGm;

    uint32_t tileLength;
    uint32_t tileNum;
};


/*
 * =========================
 * Kernel Entry
 * =========================
 */
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    KernelSubFp32 op;

    op.Init(
        x,
        y,
        z,
        tiling.totalLength,
        tiling.tileLength,
        tiling.tileNum);

    op.Process();
}


__global__ __vector__ void sub_custom_fp16(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    KernelSubFp16 op;

    op.Init(
        x,
        y,
        z,
        tiling.totalLength,
        tiling.tileLength,
        tiling.tileNum);

    op.Process();
}


/*
 * =========================
 * Host Launch
 * =========================
 */
extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    (void)info_y;
    (void)info_z;

    /*
     * 本题固定输入：
     * shape = (8, 2048)
     *
     * totalLength = 8 * 2048 = 16384
     */
    const TensorInfo& tensorX = info_x.tensors[0];

    uint32_t totalLength = 1;

    for (int64_t i = 0; i < tensorX.numDims; ++i)
    {
        totalLength *= static_cast<uint32_t>(tensorX.shape[i]);
    }

    /*
     * 使用可用核数进行多核切分。
     *
     * 16384 个元素，fp32/fp16 都可以整除常见核数。
     */
    uint32_t blockNum =
        static_cast<uint32_t>(availableCoreNum);

    if (blockNum == 0)
    {
        blockNum = 1;
    }

    if (blockNum > totalLength)
    {
        blockNum = totalLength;
    }

    /*
     * 保证每个 block 的元素数量能够均匀切分。
     *
     * 本题 totalLength = 16384，因此常见 availableCoreNum
     * 都可以正常工作。
     */
    while (blockNum > 1 &&
           totalLength % blockNum != 0)
    {
        --blockNum;
    }

    uint32_t blockLength = totalLength / blockNum;

    /*
     * 每个 block 再切成若干 tile。
     *
     * 这里选择 8 个 tile。
     * 如果 blockLength 小于 8，则退化为 blockLength。
     */
    uint32_t tileNum = 8;

    if (blockLength < tileNum)
    {
        tileNum = blockLength;
    }

    while (tileNum > 1 &&
           blockLength % tileNum != 0)
    {
        --tileNum;
    }

    uint32_t tileLength = blockLength / tileNum;

    SubCustomTilingData tiling;
    tiling.totalLength = totalLength;
    tiling.tileLength = tileLength;
    tiling.tileNum = tileNum;

    /*
     * dtype:
     * 0 = float32
     * 1 = float16
     */
    int32_t dtype = tensorX.dtype;

    if (dtype == 0)
    {
        sub_custom<<<blockNum, nullptr, stream>>>(
            x,
            y,
            z,
            tiling);
    }
    else if (dtype == 1)
    {
        sub_custom_fp16<<<blockNum, nullptr, stream>>>(
            x,
            y,
            z,
            tiling);
    }
}