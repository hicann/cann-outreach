#include "kernel_operator.h"

using namespace AscendC;

#define BUFFER_NUM 2

// ==================== 1. tiling 参数结构体 ====================
struct SubCustomTilingData {
    uint32_t totalLength;     // 总元素个数 8*2048 = 16384
    uint32_t tileNum;         // 单核内循环次数
    uint32_t tileLength;      // 每次循环处理的元素个数
};

// ==================== 2. 核函数主体类 ====================
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                const SubCustomTilingData& tiling) {
        this->totalLength = tiling.totalLength;
        this->tileNum = tiling.tileNum;
        this->tileLength = tiling.tileLength;

        xGm.SetGlobalBuffer((__gm__ float*)x + GetBlockIdx() * tileLength * tileNum, totalLength);
        yGm.SetGlobalBuffer((__gm__ float*)y + GetBlockIdx() * tileLength * tileNum, totalLength);
        zGm.SetGlobalBuffer((__gm__ float*)z + GetBlockIdx() * tileLength * tileNum, totalLength);

        pipe.InitBuffer(inQueueX, BUFFER_NUM, tileLength * sizeof(float));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, tileLength * sizeof(float));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, tileLength * sizeof(float));
    }

    __aicore__ inline void Process() {
        // 主循环，尾块处理通过 tileLength 计算
        for (int32_t i = 0; i < tileNum; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress) {
        LocalTensor<float> xLocal = inQueueX.AllocTensor<float>();
        LocalTensor<float> yLocal = inQueueY.AllocTensor<float>();
        DataCopy(xLocal, xGm[progress * tileLength], tileLength);
        DataCopy(yLocal, yGm[progress * tileLength], tileLength);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(int32_t progress) {
        LocalTensor<float> xLocal = inQueueX.DeQue<float>();
        LocalTensor<float> yLocal = inQueueY.DeQue<float>();
        LocalTensor<float> zLocal = outQueueZ.AllocTensor<float>();

        // 核心：矢量减法 z = x - y
        Sub(zLocal, xLocal, yLocal, tileLength);

        outQueueZ.EnQue<float>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int32_t progress) {
        LocalTensor<float> zLocal = outQueueZ.DeQue<float>();
        DataCopy(zGm[progress * tileLength], zLocal, tileLength);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    TPipe pipe;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueX, inQueueY;
    TQue<QuePosition::VECOUT, BUFFER_NUM> outQueueZ;

    GlobalTensor<float> xGm, yGm, zGm;

    uint32_t totalLength;
    uint32_t tileNum;
    uint32_t tileLength;
};

// ==================== 3. 核函数入口 ====================
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z,
                                      SubCustomTilingData tiling) {
    KernelSub kernel;
    kernel.Init(x, y, z, tiling);
    kernel.Process();
}

// ==================== 4. host 侧核函数启动 ====================
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream) {
    // shape: (8, 2048) → 一维长度
    uint32_t totalLength = 8 * 2048;   // 16384

    uint32_t blockDim = 8;             // 8 行数据，每核处理一行
    uint32_t tileNum = 1;              // 单核内不拆分
    uint32_t tileLength = totalLength / blockDim;   // 2048

    SubCustomTilingData tiling = { totalLength, tileNum, tileLength };

    sub_custom<<<blockDim, nullptr, stream>>>(x, y, z, tiling);
}
