#include "kernel_operator.h"
#include <cstdint>

using namespace AscendC;

constexpr uint32_t BUFFER_NUM = 2;
constexpr uint32_t QUEUE_DEPTH = 2;
constexpr uint32_t MAX_TILE_ELEMS = 4096;

struct SubCustomTilingData {
    uint32_t totalLength;
    uint32_t tileNum;
};

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength, uint32_t tileNum) {
        uint32_t alignElems = 32U / sizeof(T);
        uint32_t blockNum = AscendC::GetBlockNum();
        if (blockNum == 0) blockNum = 1;
        // 每块长度按 32 字节对齐，保证每块 GM 起始地址必然 32 字节对齐，DataCopy 不再越界/乱码
        uint32_t blockLengthAligned = (totalLength + blockNum - 1) / blockNum;
        blockLengthAligned = (blockLengthAligned + alignElems - 1) / alignElems * alignElems;
        uint32_t blockIdx = AscendC::GetBlockIdx();
        this->blockOffset = blockIdx * blockLengthAligned;

        this->blockLength = blockLengthAligned;
        if (this->blockOffset < totalLength) {
            uint32_t end = this->blockOffset + blockLengthAligned;
            this->blockValidLength = (end > totalLength) ? (totalLength - this->blockOffset) : blockLengthAligned;
        } else {
            this->blockValidLength = 0;
        }

        // tile 尽量一次搬完整块，减少循环与同步开销，同时保证 32 字节对齐且不超 UB 容量
        this->tileLength = blockLengthAligned;
        if (this->tileLength > MAX_TILE_ELEMS) this->tileLength = MAX_TILE_ELEMS;
        this->tileLength = (this->tileLength + alignElems - 1) / alignElems * alignElems;
        if (this->tileLength == 0) this->tileLength = alignElems;

        xGm.SetGlobalBuffer((__gm__ T*)x + this->blockOffset, this->blockLength);
        yGm.SetGlobalBuffer((__gm__ T*)y + this->blockOffset, this->blockLength);
        zGm.SetGlobalBuffer((__gm__ T*)z + this->blockOffset, this->blockLength);
        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileLength * sizeof(T));
    }
    __aicore__ inline void Process() {
        uint32_t alignElems = 32U / sizeof(T);
        uint32_t loopCount = (this->blockValidLength + this->tileLength - 1) / this->tileLength;
        for (uint32_t i = 0; i < loopCount; i++) {
            uint32_t offset = i * this->tileLength;
            // 尾块重叠：最后一次搬运把 offset 对齐到 32 字节边界，确保覆盖到末尾且不越界
            if (offset + this->tileLength > this->blockValidLength) {
                if (this->blockValidLength >= this->tileLength) {
                    offset = (this->blockValidLength - this->tileLength) / alignElems * alignElems;
                } else {
                    offset = 0;
                }
            }
            CopyIn(offset);
            Compute(offset);
            CopyOut(offset);
        }
    }
private:
    __aicore__ inline void CopyIn(uint32_t offset) {
        LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        DataCopy(xLocal, xGm[offset], this->tileLength);
        DataCopy(yLocal, yGm[offset], this->tileLength);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }
    __aicore__ inline void Compute(uint32_t offset) {
        LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        Sub(zLocal, xLocal, yLocal, this->tileLength);
        outQueueZ.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }
    __aicore__ inline void CopyOut(uint32_t offset) {
        LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        DataCopy(zGm[offset], zLocal, this->tileLength);
        outQueueZ.FreeTensor(zLocal);
    }
private:
    TPipe pipe;
    TQue<TPosition::VECIN, QUEUE_DEPTH> inQueueX, inQueueY;
    TQue<TPosition::VECOUT, QUEUE_DEPTH> outQueueZ;
    GlobalTensor<T> xGm, yGm, zGm;
    uint32_t blockOffset;
    uint32_t blockLength;
    uint32_t blockValidLength;
    uint32_t tileLength;
};

template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    KernelSub<T> op;
    op.Init(x, y, z, tiling.totalLength, tiling.tileNum);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream) {
    int32_t dtype = info_x.tensors[0].dtype;
    int64_t total = 1;
    for (int64_t i = 0; i < info_x.tensors[0].numDims; i++) {
        total *= info_x.tensors[0].shape[i];
    }
    uint32_t totalLength = (uint32_t)total;
    SubCustomTilingData tiling{totalLength, 1};
    uint32_t blockDim = 8;
    if (dtype == 1) {
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}
