#include "kernel_operator.h"
#include "data_utils.h"     // TensorGroupInfo / ACL 头（若报重复包含，删掉此行即可）
#include <cstdint>

using namespace AscendC;

constexpr int32_t TOTAL_LENGTH = 8 * 2048;   // 与 main.asc 的 (8,2048) 一致，共 16384 个元素
constexpr int32_t BUFFER_NUM   = 2;          // 双缓冲深度
constexpr int32_t TILE_LENGTH  = 256;        // 每块 256 个 float = 1024 字节，满足 32B 对齐

// ============================================================
// 1. tiling 参数结构体
// ============================================================
struct SubCustomTilingData {
    int32_t totalLength;   // 总元素数
    int32_t blockLength;   // 单核处理元素数
    int32_t tileNum;       // 核内分块数
    int32_t tileLength;    // 每块元素数
};

// ============================================================
// 2. 核函数主体类
// ============================================================
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
    {
        blockLength = tiling.blockLength;
        tileNum     = tiling.tileNum;
        tileLength  = tiling.tileLength;

        // 多核切分：按核号偏移，每个核处理自己那段
        int32_t blockIdx = static_cast<int32_t>(GetBlockIdx());
        xGm.SetGlobalBuffer((__gm__ float *)x + blockLength * blockIdx, blockLength);
        yGm.SetGlobalBuffer((__gm__ float *)y + blockLength * blockIdx, blockLength);
        zGm.SetGlobalBuffer((__gm__ float *)z + blockLength * blockIdx, blockLength);

        // UB 上开辟队列空间（双缓冲）
        pipe.InitBuffer(inQueueX,  BUFFER_NUM, tileLength * sizeof(float));
        pipe.InitBuffer(inQueueY,  BUFFER_NUM, tileLength * sizeof(float));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, tileLength * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        // 三级流水跑 tileNum 轮；双缓冲的并行由队列深度=2 保证
        for (int32_t i = 0; i < tileNum; i++) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        LocalTensor<float> xLocal = inQueueX.AllocTensor<float>();
        LocalTensor<float> yLocal = inQueueY.AllocTensor<float>();
        DataCopy(xLocal, xGm[progress * tileLength], tileLength);
        DataCopy(yLocal, yGm[progress * tileLength], tileLength);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(int32_t progress)
    {
        LocalTensor<float> xLocal = inQueueX.DeQue<float>();
        LocalTensor<float> yLocal = inQueueY.DeQue<float>();
        LocalTensor<float> zLocal = outQueueZ.AllocTensor<float>();
        Sub(zLocal, xLocal, yLocal, tileLength);        // z = x - y
        outQueueZ.EnQue(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(int32_t progress)
    {
        LocalTensor<float> zLocal = outQueueZ.DeQue<float>();
        DataCopy(zGm[progress * tileLength], zLocal, tileLength);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    TPipe pipe;
    TQue<QuePosition::VECIN,  BUFFER_NUM> inQueueX;
    TQue<QuePosition::VECIN,  BUFFER_NUM> inQueueY;
    TQue<QuePosition::VECOUT, BUFFER_NUM> outQueueZ;
    GlobalTensor<float> xGm;
    GlobalTensor<float> yGm;
    GlobalTensor<float> zGm;
    int32_t blockLength;
    int32_t tileNum;
    int32_t tileLength;
};

// ============================================================
// 3. 核函数入口
// ============================================================
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub op;
    op.Init(x, y, z, tiling);
    op.Process();
}

// ============================================================
// 4. host 侧核函数启动
// ============================================================
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           GM_ADDR z, const TensorGroupInfo& info_z,
                           int64_t availableCoreNum, aclrtStream stream)
{
    // 形状固定 (8,2048)、dtype 固定 float32（main.asc: 65536B/16384=4B），info_* 无需读取
    (void)info_x; (void)info_y; (void)info_z;

    int32_t avail = (availableCoreNum > 0) ? static_cast<int32_t>(availableCoreNum) : 1;

    // 核数取不超过 avail 的最大 2 的幂（且每核 >= 16 个元素）
    // -> 16384/coreNum 必然整除，避免尾块丢失
    int32_t coreNum = 1;
    while (coreNum * 2 <= avail && coreNum * 16 <= TOTAL_LENGTH) {
        coreNum *= 2;
    }

    SubCustomTilingData tiling;
    tiling.totalLength = TOTAL_LENGTH;
    tiling.blockLength = TOTAL_LENGTH / coreNum;                  // 整除
    tiling.tileLength  = (TILE_LENGTH < tiling.blockLength) ? TILE_LENGTH : tiling.blockLength;
    tiling.tileNum     = tiling.blockLength / tiling.tileLength;  // 整除

    sub_custom<<<coreNum, stream>>>(x, y, z, tiling);
}

