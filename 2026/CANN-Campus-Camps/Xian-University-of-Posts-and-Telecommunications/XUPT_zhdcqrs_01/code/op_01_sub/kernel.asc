#include "kernel_operator.h"
#include <cstdint>

using namespace AscendC;

constexpr uint32_t TOTAL_LENGTH = 8 * 2048;
constexpr uint32_t BLOCK_DIM = 8;
constexpr uint32_t BLOCK_LENGTH = TOTAL_LENGTH / BLOCK_DIM;
constexpr uint32_t BUFFER_NUM = 1;

struct SubCustomTilingData {
    uint32_t totalLength;
    uint32_t blockLength;
    int32_t dtype;
};

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub()
    {
    }

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        TPipe* pipe)
    {
        pipe_ = pipe;

        constexpr uint32_t bufferSize =
            BLOCK_LENGTH * sizeof(T);

        const uint32_t offset =
            GetBlockIdx() * BLOCK_LENGTH;

        xGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ T*>(x) + offset,
            BLOCK_LENGTH);

        yGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ T*>(y) + offset,
            BLOCK_LENGTH);

        zGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ T*>(z) + offset,
            BLOCK_LENGTH);

        pipe_->InitBuffer(
            inQueueX_,
            BUFFER_NUM,
            bufferSize);

        pipe_->InitBuffer(
            inQueueY_,
            BUFFER_NUM,
            bufferSize);

        pipe_->InitBuffer(
            outQueueZ_,
            BUFFER_NUM,
            bufferSize);
    }

    __aicore__ inline void Process()
    {
        LocalTensor<T> xLocal =
            inQueueX_.AllocTensor<T>();

        LocalTensor<T> yLocal =
            inQueueY_.AllocTensor<T>();

        LocalTensor<T> zLocal =
            outQueueZ_.AllocTensor<T>();

        // GM -> UB
        DataCopy(xLocal, xGm_, BLOCK_LENGTH);
        DataCopy(yLocal, yGm_, BLOCK_LENGTH);

        inQueueX_.EnQue(xLocal);
        inQueueY_.EnQue(yLocal);

        xLocal = inQueueX_.DeQue<T>();
        yLocal = inQueueY_.DeQue<T>();

        // 一次向量计算
        Sub(zLocal, xLocal, yLocal, BLOCK_LENGTH);

        outQueueZ_.EnQue(zLocal);
        zLocal = outQueueZ_.DeQue<T>();

        // UB -> GM
        DataCopy(zGm_, zLocal, BLOCK_LENGTH);

        inQueueX_.FreeTensor(xLocal);
        inQueueY_.FreeTensor(yLocal);
        outQueueZ_.FreeTensor(zLocal);
    }

private:
    TPipe* pipe_;

    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueX_;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueY_;
    TQue<QuePosition::VECOUT, BUFFER_NUM> outQueueZ_;

    GlobalTensor<T> xGm_;
    GlobalTensor<T> yGm_;
    GlobalTensor<T> zGm_;
};

template <typename T>
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);

    // 避免未使用参数警告
    (void)tiling;

    // TPipe 放到 KernelSub 类外
    TPipe pipe;

    KernelSub<T> op;
    op.Init(x, y, z, &pipe);
    op.Process();
}

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    (void)info_y;
    (void)info_z;
    (void)availableCoreNum;

    SubCustomTilingData tiling {};
    tiling.totalLength = TOTAL_LENGTH;
    tiling.blockLength = BLOCK_LENGTH;
    tiling.dtype = info_x.tensors[0].dtype;

    if (tiling.dtype == 1) {
        sub_custom<half>
            <<<BLOCK_DIM, nullptr, stream>>>(
                x, y, z, tiling);
    } else {
        sub_custom<float>
            <<<BLOCK_DIM, nullptr, stream>>>(
                x, y, z, tiling);
    }
}