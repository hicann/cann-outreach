#include <cmath>
#include "kernel_operator.h"

// ---------------------------------------------------------------------------
// Tiling 参数：由 host 侧 run_kernel 计算后按值传给核函数
// ---------------------------------------------------------------------------
struct SubCustomTilingData {
    uint32_t totalLength; // 待处理数据总长度（单位：元素个数），例如 8 * 2048 = 16384
    uint32_t tileNum;     // 保留字段（兼容 host），实际由 kernel 内部单块化处理
};

constexpr uint32_t BUFFER_NUM = 1;    // 单块化下用单缓冲（inX+inY+outZ = 3 缓冲，省 UB 给整块）
constexpr uint32_t QUEUE_DEPTH = 1;
constexpr uint32_t TILE_LEN = 128;    // 回退分块的块长（half/float 均 32 字节对齐）
constexpr uint32_t MAX_UB_BYTES = 196608; // 单核 UB 预算（3 缓冲合计 192KB，UB 为 256KB）

// ---------------------------------------------------------------------------
// KernelSub：z = x - y
// 每核基础对齐切分，最后一个核吃全部余量；数据能放 UB 时整块一次处理（大幅减少循环开销）
// 模板参数 T 支持 float32(float) / float16(half)
// ---------------------------------------------------------------------------
template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, const SubCustomTilingData& tiling)
    {
        uint32_t blockNum = AscendC::GetBlockNum();
        uint32_t coreId = AscendC::GetBlockIdx();
        uint32_t totalLength = tiling.totalLength;
        // 每核基础对齐切分（前 N-1 核 alignedBlock，最后一个核吃全部余量）
        uint32_t base = totalLength / blockNum;
        uint32_t alignedBlock = (base / TILE_LEN) * TILE_LEN;
        uint32_t startIdx = alignedBlock * coreId;
        uint32_t blockLength = alignedBlock;
        if (coreId == blockNum - 1) {
            blockLength = (startIdx < totalLength) ? (totalLength - startIdx) : 0;
        }
        // 单块化决策：本核对齐部分能放 UB 则整块一次搬入搬出，否则回退 TILE_LEN 分块
        uint32_t alignedLen = (blockLength / TILE_LEN) * TILE_LEN;
        uint32_t chunk = alignedLen;
        if (chunk == 0 || chunk * static_cast<uint32_t>(sizeof(T)) * 3 > MAX_UB_BYTES) {
            chunk = TILE_LEN;
        }
        this->startIdx = startIdx;
        this->blockLength = blockLength;
        this->alignedLen = alignedLen;
        this->chunkLen = chunk;
        // 设置每个核的 Global Memory 起始地址（关键的多核切分逻辑）
        xGm.SetGlobalBuffer((__gm__ T *)x + startIdx, blockLength);
        yGm.SetGlobalBuffer((__gm__ T *)y + startIdx, blockLength);
        zGm.SetGlobalBuffer((__gm__ T *)z + startIdx, blockLength);
        // 为队列分配 UB 内存
        pipe.InitBuffer(inQueueX, BUFFER_NUM, chunk * sizeof(T));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, chunk * sizeof(T));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, chunk * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        uint32_t mainCount = this->alignedLen / this->chunkLen; // 对齐部分的块数
        for (uint32_t i = 0; i < mainCount; i++) {
            CopyIn(i * this->chunkLen, this->chunkLen);
            Compute(this->chunkLen);
            CopyOut(i * this->chunkLen, this->chunkLen);
        }
        uint32_t tail = this->blockLength - this->alignedLen; // 非对齐残余（< TILE_LEN）
        if (tail > 0) {
            // 尾块：仅最后一个核可能出现。按 TILE_LEN 整块读取/写出，越界落在 GM 对齐填充区，安全。
            CopyIn(this->alignedLen, TILE_LEN);
            Compute(TILE_LEN);
            CopyOut(this->alignedLen, TILE_LEN);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset, uint32_t cnt)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.AllocTensor<T>();
        AscendC::DataCopy(xLocal, xGm[offset], cnt);
        AscendC::DataCopy(yLocal, yGm[offset], cnt);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute(uint32_t cnt)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = inQueueY.DeQue<T>();
        AscendC::LocalTensor<T> zLocal = outQueueZ.AllocTensor<T>();
        // 执行矢量减法计算：z = x - y
        AscendC::Sub(zLocal, xLocal, yLocal, cnt);
        outQueueZ.EnQue<T>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t cnt)
    {
        AscendC::LocalTensor<T> zLocal = outQueueZ.DeQue<T>();
        AscendC::DataCopy(zGm[offset], zLocal, cnt);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;  // TPipe 内存管理对象
    AscendC::TQue<AscendC::TPosition::VECIN, QUEUE_DEPTH> inQueueX, inQueueY;  // 输入数据队列管理对象，VECIN 位置
    AscendC::TQue<AscendC::TPosition::VECOUT, QUEUE_DEPTH> outQueueZ;  // 输出数据队列管理对象，VECOUT 位置
    AscendC::GlobalTensor<T> xGm, yGm, zGm; // 管理输入输出 Global Memory 地址的对象，其中 xGm、yGm 为输入，zGm 为输出

    uint32_t blockLength; // 本核实际长度
    uint32_t alignedLen;  // blockLength 对齐到 TILE_LEN 的部分
    uint32_t chunkLen;    // 每次处理的块长（能单块则整块，否则 TILE_LEN）
    uint32_t startIdx;    // 本核起始下标
};

// ---------------------------------------------------------------------------
// 核函数入口：实例化 KernelSub 并执行（模板支持 float / half）
// ---------------------------------------------------------------------------
template <typename T>
__global__ __vector__ void sub_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, SubCustomTilingData tiling)
{
    KernelSub<T> op;
    op.Init(x, y, z, tiling);
    op.Process();
}

// ---------------------------------------------------------------------------
// host 侧启动函数：从 TensorGroupInfo 推导 tiling，按 dtype 分发并启动核函数
// ---------------------------------------------------------------------------
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y, const TensorGroupInfo& info_y, GM_ADDR z, const TensorGroupInfo& info_z, int64_t availableCoreNum, aclrtStream stream)
{
    constexpr uint32_t blockDim = 8;
    // 1. 取总元素数（x/y/z 形状一致）
    const TensorInfo& t0 = info_x.tensors[0];
    int64_t totalLength = 1;
    for (int64_t i = 0; i < t0.numDims; i++) {
        totalLength *= t0.shape[i];
    }
    // tileNum 为保留字段，实际由 kernel 内部单块化处理
    uint32_t tileNum = 8;

    SubCustomTilingData tiling = {(uint32_t)totalLength, tileNum};

    // 2. 按数据类型分发：0=float32, 1=float16
    if (info_x.tensors[0].dtype == 1) {
        sub_custom<half><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    } else {
        sub_custom<float><<<blockDim, nullptr, stream>>>(x, y, z, tiling);
    }
}
