#include <cmath>
#include "kernel_operator.h"

constexpr int32_t BUFFER_NUM = 1;
constexpr int32_t QUEUE_DEPTH = 1;

struct SubCustomTilingData {
    uint32_t blockLength;
    int32_t dtype;  // 0=fp32, 1=fp16
};

template <typename T>
class KernelSub {
public:
    __aicore__ inline KernelSub() {}

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        uint32_t blockLength)
    {
        this->blockLength = blockLength;

        uint32_t offset =
            AscendC::GetBlockIdx() * blockLength;

        xGm.SetGlobalBuffer(
            (__gm__ T*)x + offset,
            blockLength);

        yGm.SetGlobalBuffer(
            (__gm__ T*)y + offset,
            blockLength);

        zGm.SetGlobalBuffer(
            (__gm__ T*)z + offset,
            blockLength);

        pipe.InitBuffer(
            inQueueX,
            BUFFER_NUM,
            blockLength * sizeof(T));

        pipe.InitBuffer(
            inQueueY,
            BUFFER_NUM,
            blockLength * sizeof(T));

        pipe.InitBuffer(
            outQueueZ,
            BUFFER_NUM,
            blockLength * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        CopyIn();
        Compute();
        CopyOut();
    }

private:
    __aicore__ inline void CopyIn()
    {
        auto xLocal = inQueueX.AllocTensor<T>();
        auto yLocal = inQueueY.AllocTensor<T>();

        AscendC::DataCopy(
            xLocal, xGm, blockLength);

        AscendC::DataCopy(
            yLocal, yGm, blockLength);

        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }

    __aicore__ inline void Compute()
    {
        auto xLocal = inQueueX.DeQue<T>();
        auto yLocal = inQueueY.DeQue<T>();
        auto zLocal = outQueueZ.AllocTensor<T>();

        AscendC::Sub(
            zLocal,
            xLocal,
            yLocal,
            blockLength);

        outQueueZ.EnQue(zLocal);

        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut()
    {
        auto zLocal = outQueueZ.DeQue<T>();

        AscendC::DataCopy(
            zGm,
            zLocal,
            blockLength);

        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;

    AscendC::TQue<
        AscendC::TPosition::VECIN,
        QUEUE_DEPTH> inQueueX;

    AscendC::TQue<
        AscendC::TPosition::VECIN,
        QUEUE_DEPTH> inQueueY;

    AscendC::TQue<
        AscendC::TPosition::VECOUT,
        QUEUE_DEPTH> outQueueZ;

    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    uint32_t blockLength;
};

__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    if (tiling.dtype == 0) {
        KernelSub<float> op;
        op.Init(x, y, z, tiling.blockLength);
        op.Process();
    } else {
        KernelSub<half> op;
        op.Init(x, y, z, tiling.blockLength);
        op.Process();
    }
}

extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    constexpr uint32_t TOTAL_LENGTH = 8 * 2048;

    uint32_t blockNum;

    if (availableCoreNum >= 8) {
        blockNum = 8;
    } else if (availableCoreNum >= 4) {
        blockNum = 4;
    } else if (availableCoreNum >= 2) {
        blockNum = 2;
    } else {
        blockNum = 1;
    }

    SubCustomTilingData tiling;
    tiling.blockLength = TOTAL_LENGTH / blockNum;
    tiling.dtype = info_x.tensors[0].dtype;

    sub_custom<<<blockNum, nullptr, stream>>>(
        x, y, z, tiling);
}