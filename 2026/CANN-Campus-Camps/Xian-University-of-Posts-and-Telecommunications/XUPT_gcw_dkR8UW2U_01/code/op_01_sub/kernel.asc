#include <cmath>
#include "kernel_operator.h"


/*
 * 本题固定：
 *
 * x : (8, 2048)
 * y : (8, 2048)
 * z : (8, 2048)
 *
 * totalLength = 16384
 *
 * 采用 8 Core：
 *
 * 每个 Core = 2048 elements
 *
 * 每个 Core 一次性完成：
 *
 * GM(x) ──DataCopy──> Local x
 * GM(y) ──DataCopy──> Local y
 *                     ↓
 *                  Sub
 *                     ↓
 * GM(z) <──DataCopy── Local z
 *
 * 不再进行多 Tile 循环。
 */


struct SubCustomTilingData
{
    uint32_t totalLength;
    uint32_t dtype;
};


template <typename T>
class KernelSub
{
public:
    __aicore__ inline KernelSub()
    {
    }

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        uint32_t totalLength)
    {
        const uint32_t blockNum =
            AscendC::GetBlockNum();

        const uint32_t blockIdx =
            AscendC::GetBlockIdx();

        /*
         * 本题：
         *
         * 16384 / 8 = 2048
         */
        blockLength =
            totalLength / blockNum;

        /*
         * 设置 GM。
         */
        xGm.SetGlobalBuffer(
            reinterpret_cast<__gm__ T*>(x)
                + blockIdx * blockLength,
            blockLength);

        yGm.SetGlobalBuffer(
            reinterpret_cast<__gm__ T*>(y)
                + blockIdx * blockLength,
            blockLength);

        zGm.SetGlobalBuffer(
            reinterpret_cast<__gm__ T*>(z)
                + blockIdx * blockLength,
            blockLength);

        /*
         * 一次性申请：
         *
         * xLocal
         * yLocal
         * zLocal
         *
         * 三块连续 Local Memory。
         */
        pipe.InitBuffer(
            localBuf,
            blockLength * sizeof(T) * 3);
    }


    __aicore__ inline void Process()
    {
        /*
         * 从同一块 TBuf 中切出三块空间。
         *
         * x: [0, blockLength)
         * y: [blockLength, 2*blockLength)
         * z: [2*blockLength, 3*blockLength)
         */
        AscendC::LocalTensor<T> xLocal =
            localBuf.Get<T>(blockLength);

        AscendC::LocalTensor<T> yLocal =
            localBuf.GetWithOffset<T>(
                blockLength,
                blockLength * sizeof(T));

        AscendC::LocalTensor<T> zLocal =
            localBuf.GetWithOffset<T>(
                blockLength,
                blockLength * sizeof(T) * 2);


        /*
         * Copy In
         *
         * 一次性搬入整个 Core 对应的数据。
         */
        AscendC::DataCopy(
            xLocal,
            xGm,
            blockLength);

        AscendC::DataCopy(
            yLocal,
            yGm,
            blockLength);


        /*
         * 核心计算：
         *
         * z = x - y
         */
        AscendC::Sub(
            zLocal,
            xLocal,
            yLocal,
            blockLength);


        /*
         * Copy Out
         */
        AscendC::DataCopy(
            zGm,
            zLocal,
            blockLength);
    }


private:

    AscendC::TPipe pipe;

    /*
     * 一个连续 TBuf。
     *
     * fp32：
     *
     * 2048 × 4 × 3
     * = 24576 Bytes
     *
     * fp16：
     *
     * 2048 × 2 × 3
     * = 12288 Bytes
     */
    AscendC::TBuf<
        AscendC::TPosition::VECCALC> localBuf;


    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> zGm;

    uint32_t blockLength = 0;
};


/*
 * Kernel Entry
 */
__global__ __vector__ void sub_custom(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    SubCustomTilingData tiling)
{
    /*
     * dtype:
     *
     * 0 = float32
     * 1 = float16
     */
    if (tiling.dtype == 0)
    {
        KernelSub<float> op;

        op.Init(
            x,
            y,
            z,
            tiling.totalLength);

        op.Process();
    }
    else
    {
        KernelSub<half> op;

        op.Init(
            x,
            y,
            z,
            tiling.totalLength);

        op.Process();
    }
}


/*
 * Host 侧 Direct Invocation
 */
extern "C" void run_kernel(
    GM_ADDR x,
    const TensorGroupInfo& info_x,
    GM_ADDR y,
    const TensorGroupInfo& info_y,
    GM_ADDR z,
    const TensorGroupInfo& info_z,
    int64_t availableCoreNum,
    aclrtStream stream)
{
    /*
     * 获取 Tensor Shape。
     */
    const TensorInfo& tensorInfo =
        info_x.tensors[0];


    uint32_t totalLength = 1;

    for (int64_t i = 0;
         i < tensorInfo.numDims;
         ++i)
    {
        totalLength *=
            static_cast<uint32_t>(
                tensorInfo.shape[i]);
    }


    /*
     * 本题：
     *
     * Shape = (8, 2048)
     * totalLength = 16384
     *
     * 直接使用 8 Core。
     *
     * 如果平台提供的 Core 少于 8，
     * 则使用 availableCoreNum。
     */
    uint32_t coreNum =
        static_cast<uint32_t>(
            availableCoreNum);

    if (coreNum > 8)
    {
        coreNum = 8;
    }

    if (coreNum == 0)
    {
        return;
    }


    /*
     * 确保每个 Core 都能够获得完整的数据块。
     *
     * 本题 16384 可以被 8 整除。
     */
    if (totalLength % coreNum != 0)
    {
        coreNum = 1;
    }


    /*
     * dtype：
     *
     * 0 = float32
     * 1 = float16
     */
    uint32_t dtype =
        static_cast<uint32_t>(
            tensorInfo.dtype);


    SubCustomTilingData tiling;

    tiling.totalLength = totalLength;
    tiling.dtype = dtype;


    /*
     * Direct Invocation
     */
    sub_custom<<<
        coreNum,
        nullptr,
        stream>>>(
            x,
            y,
            z,
            tiling);
}