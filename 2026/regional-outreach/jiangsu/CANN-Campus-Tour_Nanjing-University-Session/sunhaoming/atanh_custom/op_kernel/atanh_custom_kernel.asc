// ============================================================================
// Ascend C Kernel 实现 - atanh 算子（一元逐元素，float16）
// ============================================================================
//
// atanh(x) = 0.5 * ln((1 + x) / (1 - x)), x ∈ (-1, 1)
//
// 使用 AscendC 内置 AtanhImpl 高精度实现。
// 对 float16 类型，内部提升到 float32 计算后再转回 half，
// 需要 4 倍输入大小的临时缓冲区（float32 类型）。
// ============================================================================

#include "kernel_operator.h"
#include "atanh_custom_tiling.h"

// AscendC 内置高精度 atanh 实现（位于 highlevel API）
// 对 half 类型：内部提升到 float32 计算，需要 4× 输入大小的 tmpBuffer
#include "highlevel_api/impl/math/atanh/atanh_common_impl.h"

using namespace AscendC;

class KernelAtanh {
public:
    __aicore__ inline KernelAtanh(TPipe* pipe)
    {
        pipe_ = pipe;
    };

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y,
                                const __gm__ AtanhTilingData* tiling)
    {
        this->tiling = tiling;
        uint32_t blockIdx = AscendC::GetBlockIdx();
        if (blockIdx < tiling->blockNum - 1) {
            total = tiling->numPerCore;
            tileNum = total / TILE_LENGTH;
            tailTileElementNum = TILE_LENGTH;
        } else {
            total = tiling->tailNumLastCore;
            tileNum = (total + (TILE_LENGTH - 1)) / TILE_LENGTH;
            tailTileElementNum = total - TILE_LENGTH * (tileNum - 1);
        }

        xGm.SetGlobalBuffer((__gm__ half *)x + blockIdx * tiling->numPerCore, total);
        yGm.SetGlobalBuffer((__gm__ half *)y + blockIdx * tiling->numPerCore, total);

        pipe_->InitBuffer(inQueueX, 1, TILE_LENGTH * sizeof(half));
        pipe_->InitBuffer(outQueueY, 1, TILE_LENGTH * sizeof(half));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < tileNum; i++) {
            uint32_t count = (i == tileNum - 1) ? tailTileElementNum : TILE_LENGTH;
            CopyIn(count);
            Compute(count);
            CopyOut(count);
        }
    }

    __aicore__ inline void CopyIn(uint32_t count)
    {
        LocalTensor<half> xLocal = inQueueX.AllocTensor<half>();
        DataCopyPad(xLocal, xGm,
            {1, static_cast<uint16_t>(count * sizeof(half)), 0, 0},
            {false, 0, 0, 0});
        inQueueX.EnQue(xLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        LocalTensor<half> xLocal = inQueueX.DeQue<half>();
        LocalTensor<half> yLocal = outQueueY.AllocTensor<half>();

        // 使用 AscendC 内置 AtanhImpl（内部自动分配 tmpBuffer）
        // 对 half 类型自动提升到 float32 计算，保证精度
        AtanhImpl<half>(yLocal, xLocal, count);

        outQueueY.EnQue<half>(yLocal);
        inQueueX.FreeTensor(xLocal);
    }

    __aicore__ inline void CopyOut(uint32_t count)
    {
        LocalTensor<half> yLocal = outQueueY.DeQue<half>();
        DataCopyPad(yGm, yLocal,
            {1, static_cast<uint16_t>(count * sizeof(half)), 0, 0});
        outQueueY.FreeTensor(yLocal);
    }

private:
    TPipe* pipe_;
    const __gm__ AtanhTilingData* tiling;

    GlobalTensor<half> xGm;
    GlobalTensor<half> yGm;

    TQue<TPosition::VECIN, 1> inQueueX;
    TQue<TPosition::VECOUT, 1> outQueueY;

    uint32_t total;
    uint32_t tileNum;
    uint32_t tailTileElementNum;
};

// 核函数入口
extern "C" __global__ __vector__ void atanh_custom_kernel(GM_ADDR x, GM_ADDR y, GM_ADDR tiling)
{
    TPipe pipe;
    KernelAtanh op(&pipe);
    op.Init(x, y, (__gm__ AtanhTilingData*)tiling);
    op.Process();
}
