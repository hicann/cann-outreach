// relu_custom Kernel 实现
// 功能: y = max(0, x), element-wise ReLU for float16
// 数据格式: ND (连续内存布局)
// shape: 4D, e.g. [N4, N3, N2, N1]

#include "kernel_operator.h"
#include "relu_custom_tiling.h"

using namespace AscendC;

constexpr int32_t BUFFER_NUM = 2;  // 双缓冲

class KernelReluCustom {
public:
    __aicore__ inline void Init(GM_ADDR xGmAddr, GM_ADDR yGmAddr,
                                 const ReluCustomTilingData &tiling)
    {
        // 计算当前 block 处理的数据范围
        uint32_t blockIdx = AscendC::GetBlockIdx();
        int32_t perCoreElements = (tiling.totalElements + tiling.usedCoreNum - 1) / tiling.usedCoreNum;
        myStart = blockIdx * perCoreElements;
        myEnd = (myStart + perCoreElements > tiling.totalElements) ?
                 tiling.totalElements : myStart + perCoreElements;
        myLength = myEnd - myStart;

        if (myLength <= 0) return;

        // 初始化 GM 指针
        xGm.SetGlobalBuffer((__gm__ half *)xGmAddr + myStart);
        yGm.SetGlobalBuffer((__gm__ half *)yGmAddr + myStart);

        // 初始化 UB 队列（双缓冲）
        pipe.InitBuffer(inQueueX, BUFFER_NUM, tiling.tileLen * sizeof(half));
        pipe.InitBuffer(outQueueY, BUFFER_NUM, tiling.tileLen * sizeof(half));

        // 保存 tiling 参数
        tileLen = tiling.tileLen;
        loopCount = (myLength + tileLen - 1) / tileLen;
    }

    __aicore__ inline void Process()
    {
        if (myLength <= 0) return;

        int32_t remaining = myLength;
        for (int32_t i = 0; i < loopCount; i++) {
            int32_t offset = i * tileLen;
            int32_t curLen = (remaining > tileLen) ? tileLen : remaining;
            remaining -= curLen;

            int32_t alignLen = (curLen + 15) / 16 * 16;  // 32B 对齐

            // --- CopyIn: GM → UB ---
            LocalTensor<half> xLocal = inQueueX.AllocTensor<half>();
            DataCopyPad(xLocal, xGm[offset], {curLen, curLen, alignLen, 0, 0});
            inQueueX.EnQue(xLocal);

            // --- Compute: ReLU ---
            xLocal = inQueueX.DeQue<half>();
            LocalTensor<half> yLocal = outQueueY.AllocTensor<half>();

            // ReLU: y = max(0, x)
            Relu(yLocal, xLocal, curLen);

            inQueueX.FreeTensor(xLocal);
            outQueueY.EnQue(yLocal);

            // --- CopyOut: UB → GM ---
            yLocal = outQueueY.DeQue<half>();
            DataCopyPad(yGm[offset], yLocal, {curLen, curLen, alignLen, 0, 0});
            outQueueY.FreeTensor(yLocal);
        }
    }

private:
    GlobalTensor<half> xGm;
    GlobalTensor<half> yGm;

    TPipe pipe;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueX;
    TQue<QuePosition::VECOUT, BUFFER_NUM> outQueueY;

    int32_t tileLen;
    int32_t loopCount;
    int32_t myStart;
    int32_t myEnd;
    int32_t myLength;
};

// Kernel 入口函数 — 纯向量算子：__global__ __vector__
extern "C" __global__ __vector__ void relu_custom_kernel(GM_ADDR xGmAddr, GM_ADDR yGmAddr,
                                                          GM_ADDR tilingAddr)
{
    ReluCustomTilingData tiling;
    AscendC::GetTiling(tiling, tilingAddr);

    uint32_t blockIdx = AscendC::GetBlockIdx();
    if (blockIdx >= tiling.usedCoreNum) return;

    KernelReluCustom kernel;
    kernel.Init(xGmAddr, yGmAddr, tiling);
    kernel.Process();
}
