// relu_custom Host 侧封装：ACL 内存管理 + Tiling 计算 + Kernel 启动 + main
// shape: 4D [N4,N3,N2,N1], ND 格式展平为一维连续处理

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>
#include <cstdint>

#include "acl/acl.h"
#include "kernel/relu_custom_tiling.h"

// 获取 Vector Core 数量
int64_t GetVectorCoreNum()
{
    int32_t deviceId = 0;
    aclrtGetDevice(&deviceId);
    int64_t vectorCoreNum = 8;
    aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &vectorCoreNum);
    return vectorCoreNum;
}

// 获取可用 UB 大小
int32_t GetUbAvailableSize()
{
    return 180 * 1024;  // 保守值
}

// ======================== 测试数据生成 ========================

void GenerateTestData(half *data, int32_t numElements)
{
    for (int32_t i = 0; i < numElements; i++) {
        float val = (rand() / (float)RAND_MAX * 2.0f - 1.0f) * 10.0f;
        data[i] = static_cast<half>(val);
    }
}

void GeneratePositiveData(half *data, int32_t numElements)
{
    for (int32_t i = 0; i < numElements; i++) {
        data[i] = static_cast<half>((rand() / (float)RAND_MAX) * 10.0f);
    }
}

void GenerateNegativeData(half *data, int32_t numElements)
{
    for (int32_t i = 0; i < numElements; i++) {
        data[i] = static_cast<half>((rand() / (float)RAND_MAX - 1.0f) * 10.0f);
    }
}

void GenerateMixedWithZeroData(half *data, int32_t numElements)
{
    for (int32_t i = 0; i < numElements; i++) {
        if (i % 5 == 0) {
            data[i] = static_cast<half>(0.0f);
        } else {
            data[i] = static_cast<half>((rand() / (float)RAND_MAX * 2.0f - 1.0f) * 10.0f);
        }
    }
}

// ======================== Golden ========================

void ComputeReluGolden(const half *x, half *y, int32_t numElements)
{
    for (int32_t i = 0; i < numElements; i++) {
        float val = static_cast<float>(x[i]);
        y[i] = static_cast<half>(val > 0.0f ? val : 0.0f);
    }
}

// ======================== 验证 ========================

bool VerifyResult(const half *expected, const half *actual, int32_t numElements,
                  float atol = 1e-3f, float rtol = 1e-3f)
{
    float maxDiff = 0.0f;
    int32_t errCount = 0;
    for (int32_t i = 0; i < numElements; i++) {
        float e = static_cast<float>(expected[i]);
        float a = static_cast<float>(actual[i]);
        float diff = fabsf(e - a);
        float maxAbs = fmaxf(fabsf(e), fabsf(a));
        if (diff > atol && diff > rtol * maxAbs) {
            if (errCount < 10) {
                printf("  FAIL[%d]: expected=%f, actual=%f, diff=%f\n", i, e, a, diff);
            }
            errCount++;
        }
        if (diff > maxDiff) maxDiff = diff;
    }
    printf("  MaxDiff: %e, Errors: %d/%d\n", maxDiff, errCount, numElements);
    return (errCount == 0);
}

// ======================== 测试用例执行器 ========================

int32_t Flatten4D(int32_t n4, int32_t n3, int32_t n2, int32_t n1)
{
    return n4 * n3 * n2 * n1;
}

bool RunTestCase(const char *testName,
                 int32_t n4, int32_t n3, int32_t n2, int32_t n1,
                 void (*genData)(half *, int32_t))
{
    int32_t numElements = Flatten4D(n4, n3, n2, n1);
    printf("\n===== Test: %s [%d,%d,%d,%d] =====\n", testName, n4, n3, n2, n1);

    half *hX   = new half[numElements];
    half *hY   = new half[numElements];
    half *hGolden = new half[numElements];

    genData(hX, numElements);
    ComputeReluGolden(hX, hGolden, numElements);

    half *dX = nullptr;
    half *dY = nullptr;

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    size_t dataSize = numElements * sizeof(half);
    aclrtMalloc((void **)&dX, dataSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&dY, dataSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(dX, dataSize, hX, dataSize, ACL_MEMCPY_HOST_TO_DEVICE);

    // Tiling
    ReluCustomTilingData tiling;
    int64_t coreNum = GetVectorCoreNum();
    int32_t ubSize = GetUbAvailableSize();
    ComputeReluCustomTiling(tiling, numElements, coreNum, ubSize);

    size_t tilingSize = sizeof(ReluCustomTilingData);
    void *dTiling = nullptr;
    aclrtMalloc(&dTiling, tilingSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(dTiling, tilingSize, &tiling, tilingSize, ACL_MEMCPY_HOST_TO_DEVICE);

    // Kernel 启动
    relu_custom_kernel<<<dX, dY, dTiling, stream>>>(tiling.usedCoreNum);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(hY, dataSize, dY, dataSize, ACL_MEMCPY_DEVICE_TO_HOST);

    bool pass = VerifyResult(hGolden, hY, numElements);

    aclrtFree(dX);
    aclrtFree(dY);
    aclrtFree(dTiling);
    aclrtDestroyStream(stream);
    delete[] hX;
    delete[] hY;
    delete[] hGolden;

    printf("  Result: %s\n", pass ? "PASS" : "FAIL");
    return pass;
}

// ======================== main ========================

int main()
{
    printf("========================================\n");
    printf("  relu_custom 算子测试 (4D, float16)\n");
    printf("========================================\n");

    aclInit(nullptr);
    aclrtSetDevice(0);
    srand(42);

    int32_t passCount = 0;
    int32_t totalCount = 0;

    passCount += RunTestCase("T1 Random_Small", 1, 1, 1, 128, GenerateTestData) ? 1 : 0;
    totalCount++;
    passCount += RunTestCase("T2 Random_Medium", 1, 4, 32, 64, GenerateTestData) ? 1 : 0;
    totalCount++;
    passCount += RunTestCase("T3 Random_Large", 2, 8, 64, 128, GenerateTestData) ? 1 : 0;
    totalCount++;
    passCount += RunTestCase("T4 All_Positive", 1, 4, 32, 64, GeneratePositiveData) ? 1 : 0;
    totalCount++;
    passCount += RunTestCase("T5 All_Negative", 1, 4, 32, 64, GenerateNegativeData) ? 1 : 0;
    totalCount++;
    passCount += RunTestCase("T6 Mixed_Zero", 1, 4, 32, 64, GenerateMixedWithZeroData) ? 1 : 0;
    totalCount++;

    printf("\n========================================\n");
    printf("  结果: %d/%d PASS\n", passCount, totalCount);
    printf("========================================\n");

    aclrtResetDevice(0);
    aclFinalize();

    return (passCount == totalCount) ? 0 : 1;
}
