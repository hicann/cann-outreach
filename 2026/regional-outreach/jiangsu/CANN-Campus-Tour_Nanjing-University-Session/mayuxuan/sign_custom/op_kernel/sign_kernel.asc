 *
 * @file sign_kernel.asc
 * @brief Sign 算子 — Ascend C Kernel
 *
 * 功能: sign(x) =  1.0 (x > 0), 0.0 (x == 0), -1.0 (x < 0)
 *
 * 原理: sign(x) = x / max(|x|, TINY)
 *   TINY = 2^(-24) (half 最小正子规格数), 对所有非零 |x| 有 |x| >= TINY
 *   故 max(|x|, TINY) = |x| (非零), 或 TINY (零值)
 *   则 Div(x, |x|) = ±1 (非零), Div(0, TINY) = 0 (零值)
 *
 * 数据流: CopyIn(GM→UB) → Abs → Max → Div → CopyOut(UB→GM)
 * 仅用 3 条向量指令: Abs + Max + Div, 无需 Compare/Select, 纯算术实现
 *
 * 支持: half, ND, in-place (x==y 同地址) 或 out-of-place (x!=y)
 * 硬件: Ascend910 (dav-2201)
 */

#include "kernel_operator.h"
#include "sign_tiling.h"

using namespace AscendC;

class KernelSign {
public:
    __aicore__ inline KernelSign(AscendC::TPipe* pipe) { pipe_ = pipe; }

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y,
                                const __gm__ SignTilingData* tiling)
    {
        this->tiling = tiling;
        blockIdx = AscendC::GetBlockIdx();

        if (blockIdx < tiling->blockNum - 1) {
            total = tiling->numPerBlock;
            tileNum = total / TILE_LENGTH;
            tailCnt = TILE_LENGTH;
        } else {
            total = tiling->tailNumLastBlock;
            tileNum = (total + TILE_LENGTH - 1) / TILE_LENGTH;
            tailCnt = total - TILE_LENGTH * (tileNum - 1);
        }

        xGm.SetGlobalBuffer((__gm__ half*)x + blockIdx * tiling->numPerBlock, total);
        yGm.SetGlobalBuffer((__gm__ half*)y + blockIdx * tiling->numPerBlock, total);

        uint32_t bufB = TILE_LENGTH * sizeof(half);
        pipe_->InitBuffer(inQ, DOUBLE_BUFFER, bufB);
        pipe_->InitBuffer(outQ, DOUBLE_BUFFER, bufB);
        pipe_->InitBuffer(absB, bufB);
        pipe_->InitBuffer(denB, bufB);
        pipe_->InitBuffer(tnyB, bufB);
    }

    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < tileNum; i++) {
            uint32_t cnt = (i == tileNum - 1) ? tailCnt : TILE_LENGTH;
            CopyIn(i * TILE_LENGTH, cnt);
            Compute(cnt);
            CopyOut(i * TILE_LENGTH, cnt);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t off, uint32_t cnt)
    {
        LocalTensor<half> xL = inQ.AllocTensor<half>();
        DataCopyPad(xL, xGm[off],
            {1, static_cast<uint16_t>(cnt * sizeof(half)), 0, 0},
            {false, 0, 0, 0});
        inQ.EnQue(xL);
    }

    __aicore__ inline void Compute(uint32_t cnt)
    {
        LocalTensor<half> xL = inQ.DeQue<half>();
        LocalTensor<half> yL = outQ.AllocTensor<half>();
        LocalTensor<half> tAbs = absB.Get<half>();
        LocalTensor<half> tDen = denB.Get<half>();
        LocalTensor<half> tTny = tnyB.Get<half>();

        int32_t iCnt = static_cast<int32_t>(cnt);

        Abs<half>(tAbs, xL, iCnt);                          // |x|

        Duplicate<half>(tTny, (half)(1.0f / 16777216.0f),    // TINY = 2^(-24)
                        iCnt);

        Max<half>(tDen, tAbs, tTny, iCnt);                   // max(|x|, TINY)

        Div<half>(yL, xL, tDen, iCnt);                       // x / max(|x|, TINY)

        outQ.EnQue(yL);
        inQ.FreeTensor(xL);
    }

    __aicore__ inline void CopyOut(uint32_t off, uint32_t cnt)
    {
        LocalTensor<half> yL = outQ.DeQue<half>();
        DataCopyPad(yGm[off], yL,
            {1, static_cast<uint16_t>(cnt * sizeof(half)), 0, 0});
        outQ.FreeTensor(yL);
    }

private:
    AscendC::TPipe* pipe_;
    const __gm__ SignTilingData* tiling;
    uint32_t blockIdx, total, tileNum, tailCnt;

    GlobalTensor<half> xGm;
    GlobalTensor<half> yGm;

    TQue<TPosition::VECIN, 1> inQ;
    TQue<TPosition::VECOUT, 1> outQ;
    TBuf<TPosition::VECCALC> absB, denB, tnyB;
};

extern "C" __global__ __vector__ void sign_kernel(GM_ADDR x, GM_ADDR y, GM_ADDR tiling)
{
    TPipe pipe;
    KernelSign op(&pipe);
    op.Init(x, y, (__gm__ SignTilingData*)tiling);
    op.Process();
}
