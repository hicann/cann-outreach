 *
 * Sign 算子 — Host 端 + main 入口
 * 直调验证 sign(x) = 1.0 / 0.0 / -1.0 逐元素符号
 *
 * 支持 in-place: x == y (同地址) 或 out-of-place: x != y
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include "acl/acl.h"
#include "../op_kernel/sign_tiling.h"
#include "data_utils.h"

#include "../op_kernel/sign_kernel.asc"

void KernelCall(uint32_t blockNum, aclrtStream stream,
    std::vector<ArgInfo>& inputsInfo, std::vector<ArgInfo>& outputsInfo,
    uint8_t* tilingData)
{
    std::vector<uint8_t*> inputsHost(inputsInfo.size());
    std::vector<uint8_t*> inputsDevice(inputsInfo.size());
    std::vector<uint8_t*> outputsHost(outputsInfo.size());
    std::vector<uint8_t*> outputsDevice(outputsInfo.size());
    uint8_t* tilingDevice = nullptr;

    aclrtMalloc((void**)&tilingDevice, sizeof(SignTilingData),
                ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(tilingDevice, sizeof(SignTilingData), tilingData,
                sizeof(SignTilingData), ACL_MEMCPY_HOST_TO_DEVICE);

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtMallocHost((void**)&inputsHost[i], inputsInfo[i].length);
        aclrtMalloc((void**)&inputsDevice[i], inputsInfo[i].length,
                    ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile(inputsInfo[i].fileName, inputsInfo[i].length,
                 inputsHost[i], inputsInfo[i].length);
        aclrtMemcpy(inputsDevice[i], inputsInfo[i].length,
                    inputsHost[i], inputsInfo[i].length,
                    ACL_MEMCPY_HOST_TO_DEVICE);
    }

    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMallocHost((void**)&outputsHost[i], outputsInfo[i].length);
        aclrtMalloc((void**)&outputsDevice[i], outputsInfo[i].length,
                    ACL_MEM_MALLOC_HUGE_FIRST);
    }

    // kernel 调用: sign(x, y)
    sign_kernel<<<blockNum, nullptr, stream>>>(
        inputsDevice[0],   /* x */
        outputsDevice[0],  /* y (可同地址 in-place) */
        tilingDevice);

    aclrtSynchronizeStream(stream);

    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMemcpy(outputsHost[i], outputsInfo[i].length,
                    outputsDevice[i], outputsInfo[i].length,
                    ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile(outputsInfo[i].fileName, outputsHost[i],
                  outputsInfo[i].length);
        aclrtFree(outputsDevice[i]);
        aclrtFreeHost(outputsHost[i]);
    }

    aclrtFree(tilingDevice);
    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtFree(inputsDevice[i]);
        aclrtFreeHost(inputsHost[i]);
    }
}

int32_t main(int32_t argc, char* argv[])
{
    // ACL 初始化
    aclInit(nullptr);
    int32_t deviceId = 0;
    auto ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) {
        printf("aclrtSetDevice failed, ret=%d\n", ret);
        return ret;
    }

    // 获取 AI Core 数
    int64_t availableCoreNum = 0;
    ret = aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM,
                             &availableCoreNum);
    if (ret != ACL_SUCCESS) {
        printf("aclrtGetDeviceInfo failed, ret=%d\n", ret);
        aclrtResetDevice(deviceId);
        return ret;
    }

    // 4D ND shape: [N4, N3, N2, N1], dtype=half
    // 示例 shape: [4, 64, 256, 32] = 2097152 元素
    uint32_t n4 = 4, n3 = 64, n2 = 256, n1 = 32;
    uint32_t totalLength = n4 * n3 * n2 * n1;
    size_t byteSize = totalLength * sizeof(half);

    printf("Sign shape=[%u, %u, %u, %u], totalElements=%u, dtype=half\n",
           n4, n3, n2, n1, totalLength);

    // Tiling 计算
    SignTilingData tiling;
    tiling.totalLength = totalLength;

    uint64_t totalTiles = (totalLength + TILE_LENGTH - 1) / TILE_LENGTH;
    uint64_t tilesPerCore = (totalTiles + availableCoreNum - 1) / availableCoreNum;
    uint32_t blockNum = tiling.blockNum =
        (totalTiles + tilesPerCore - 1) / tilesPerCore;
    tiling.numPerBlock = tilesPerCore * TILE_LENGTH;
    tiling.tailNumLastBlock =
        totalLength - tiling.numPerBlock * (blockNum - 1);

    printf("BlockNum=%u (avail cores=%ld), numPerBlock=%lu, tail=%lu\n",
           blockNum, availableCoreNum, tiling.numPerBlock, tiling.tailNumLastBlock);

    // 文件参数
    std::vector<ArgInfo> inputsInfo = {
        {"./input/input_x.bin", byteSize}
    };
    std::vector<ArgInfo> outputsInfo = {
        {"./output/output.bin", byteSize}
    };

    // 执行
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    KernelCall(blockNum, stream, inputsInfo, outputsInfo, (uint8_t*)&tiling);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    printf("Done. output: ./output/output.bin\n");
    return 0;
}
