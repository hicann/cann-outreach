 *
 * InplaceRsqrt — Ascend C Kernel
 * 功能: self = 1 / sqrt(self)  (in-place, 覆盖输入张量)
 *
 * 数据流: CopyIn(GM→UB) → Sqrt → FillOnes → Div(1/sqrt) → CopyOut(UB→GM)
 * 优化: 全程向量化，批处理，无标量循环
 */

#include "kernel_operator.h"
#include "inplace_rsqrt_tiling.h"

using namespace AscendC;

class KernelInplaceRsqrt {
public:
    __aicore__ inline KernelInplaceRsqrt(AscendC::TPipe* pipe)
    {
        pipe_ = pipe;
    };

    __aicore__ inline void Init(GM_ADDR self,
                                const __gm__ InplaceRsqrtTilingData* tiling)
    {
        this->tiling = tiling;
        uint32_t blockIdx = AscendC::GetBlockIdx();

        if (blockIdx < tiling->blockNum - 1) {
            total = tiling->numPerBlock;
            tileNum = total / TILE_LENGTH;
            tailTileElementNum = TILE_LENGTH;
        } else {
            total = tiling->tailNumLastBlock;
            tileNum = (total + TILE_LENGTH - 1) / TILE_LENGTH;
            tailTileElementNum = total - TILE_LENGTH * (tileNum - 1);
        }

        // In-place: selfGm 既是输入也是输出
        selfGm.SetGlobalBuffer((__gm__ half*)self + blockIdx * tiling->numPerBlock, total);

        // 分配 UB Buffer（3路: self 输入→输出, sqrt 中间值, ones 常量）
        pipe_->InitBuffer(inQueueSelf, DOUBLE_BUFFER, TILE_LENGTH * sizeof(half));
        pipe_->InitBuffer(outQueueSelf, DOUBLE_BUFFER, TILE_LENGTH * sizeof(half));
        pipe_->InitBuffer(sqrtBuf, TILE_LENGTH * sizeof(half));
        pipe_->InitBuffer(onesBuf, TILE_LENGTH * sizeof(half));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < tileNum; i++) {
            uint32_t count = (i == tileNum - 1) ? tailTileElementNum : TILE_LENGTH;
            CopyIn(count);
            Compute(count);
            CopyOut(count);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t count)
    {
        LocalTensor<half> selfLocal = inQueueSelf.AllocTensor<half>();

        // 从 GM 搬运到 UB，使用 DataCopyPad 保证非对齐安全
        DataCopyParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = count * sizeof(half);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;

        DataCopyPadParams padParams;
        padParams.isPad = false;
        padParams.leftPadding = 0;
        padParams.rightPadding = 0;

        DataCopyPad(selfLocal, selfGm, copyParams, padParams);

        inQueueSelf.EnQue(selfLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        LocalTensor<half> selfLocal = inQueueSelf.DeQue<half>();
        LocalTensor<half> sqrtLocal = sqrtBuf.Get<half>();
        LocalTensor<half> onesLocal = onesBuf.Get<half>();
        LocalTensor<half> outLocal = outQueueSelf.AllocTensor<half>();

        // Step 1: sqrt(x)
        Sqrt<half>(sqrtLocal, selfLocal, static_cast<int32_t>(count));

        // Step 2: ones = 1.0 (填充常量)
        Duplicate<half>(onesLocal, (half)1.0, static_cast<int32_t>(count));

        // Step 3: out = ones / sqrt = 1 / sqrt(x)
        Div<half>(outLocal, onesLocal, sqrtLocal, static_cast<int32_t>(count));

        outQueueSelf.EnQue(outLocal);
        inQueueSelf.FreeTensor(selfLocal);
    }

    __aicore__ inline void CopyOut(uint32_t count)
    {
        LocalTensor<half> outLocal = outQueueSelf.DeQue<half>();

        // 将结果写回 GM（覆盖原位）
        DataCopyParams copyParams;
        copyParams.blockCount = 1;
        copyParams.blockLen = count * sizeof(half);
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;

        DataCopyPad(selfGm, outLocal, copyParams);

        outQueueSelf.FreeTensor(outLocal);
    }

private:
    AscendC::TPipe* pipe_;
    const __gm__ InplaceRsqrtTilingData* tiling;

    GlobalTensor<half> selfGm;          // 输入/输出（in-place）

    TQue<TPosition::VECIN, 1> inQueueSelf;     // 输入队列（double buffer）
    TQue<TPosition::VECOUT, 1> outQueueSelf;   // 输出队列（double buffer）
    TBuf<TPosition::VECCALC> sqrtBuf;           // sqrt 中间结果
    TBuf<TPosition::VECCALC> onesBuf;           // 常量 1.0 填充

    uint32_t total;
    uint32_t tileNum;
    uint32_t tailTileElementNum;
};

// 核函数入口
extern "C" __global__ __vector__ void inplace_rsqrt_kernel(
    GM_ADDR self, GM_ADDR tiling)
{
    TPipe pipe;
    KernelInplaceRsqrt op(&pipe);
    op.Init(self, (__gm__ InplaceRsqrtTilingData*)tiling);
    op.Process();
}
