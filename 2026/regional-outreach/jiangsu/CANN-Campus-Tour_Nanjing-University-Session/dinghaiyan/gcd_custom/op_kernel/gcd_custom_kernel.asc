/* Generated By CANNBot */

// ============================================================================
// Ascend C Kernel 实现 - Gcd 算子（纯 kernel，不含 host 代码）
// ============================================================================
//
// 算子说明：
//   out[i] = gcd(|self[i]|, |other[i]|) — 对两个 float16 输入逐元素求最大公约数
//
// 算法：欧几里得算法（Euclidean Algorithm）向量化实现
//   a_f32 = |self|, b_f32 = |other|       // 提升到 float32 避免溢出
//   for i in 0..MAX_GCD_ITER:
//     b_f32 = max(b_f32, FLT_EPSILON)      // 防除零
//     r_f32 = a_f32 - floor(a_f32/b_f32) * b_f32  // float 取模
//     a_f32 = b_f32; b_f32 = r_f32
//   out = cast_f32_to_f16(a_f32)
//
// 为什么用 float32 计算：
//   float16 的 m 尾数仅 11bit，除法易溢出（65504 / 6e-8 ≈ 1e12 > 65504）
//   float32 无此问题（max ≈ 3.4e38），23bit 尾数也提供更好的精度
//
// 边界：gcd(x, 0) 由 Host 层通过 torch.where 纠正
//
// 核函数参数：
//   self:     第一个输入 GM（float16）
//   other:    第二个输入 GM（float16）
//   out:      输出 GM（float16）
//   tiling:   Tiling 参数
//
// UB 分配（TILE_LENGTH=4096）：
//   输入队列 half:  3 × 2 (double) × 8KB = 48KB
//   计算缓冲 float: 4 × 16KB = 64KB
//   总计: 112KB  (UB 256KB，安全)
// ============================================================================

#include "kernel_operator.h"
#include "gcd_custom_tiling.h"

// Kernel 类
class KernelGcd {
public:
    __aicore__ inline KernelGcd(AscendC::TPipe* pipe)
    {
        pipe_ = pipe;
    };

    __aicore__ inline void Init(GM_ADDR self, GM_ADDR other, GM_ADDR out,
                                const __gm__ GcdTilingData* tiling)
    {
        this->tiling = tiling;
        uint32_t blockIdx = AscendC::GetBlockIdx();
        if (blockIdx < tiling->blockNum - 1) {
            total = tiling->numPerCore;
            tileNum = total / TILE_LENGTH;
            tailTileElementNum = TILE_LENGTH;
        } else {
            total = tiling->tailNumLastCore;
            tileNum = (total + (TILE_LENGTH - 1)) / TILE_LENGTH;
            tailTileElementNum = total - TILE_LENGTH * (tileNum - 1);
        }

        // Global Tensor：双输入单输出
        selfGm.SetGlobalBuffer((__gm__ half *)self + blockIdx * tiling->numPerCore, total);
        otherGm.SetGlobalBuffer((__gm__ half *)other + blockIdx * tiling->numPerCore, total);
        outGm.SetGlobalBuffer((__gm__ half *)out + blockIdx * tiling->numPerCore, total);

        // UB Buffer：
        //   输入/输出队列 — half, 双缓冲
        pipe_->InitBuffer(inQueueSelf, DOUBLE_BUFFER, TILE_LENGTH * sizeof(half));
        pipe_->InitBuffer(inQueueOther, DOUBLE_BUFFER, TILE_LENGTH * sizeof(half));
        pipe_->InitBuffer(outQueueOut, DOUBLE_BUFFER, TILE_LENGTH * sizeof(half));
        //   float32 计算暂存 — 4 个 TBuf
        pipe_->InitBuffer(tmpBufA, TILE_LENGTH * sizeof(float));   // a_f32
        pipe_->InitBuffer(tmpBufB, TILE_LENGTH * sizeof(float));   // b_f32
        pipe_->InitBuffer(tmpBufC, TILE_LENGTH * sizeof(float));   // tmp1
        pipe_->InitBuffer(tmpBufD, TILE_LENGTH * sizeof(float));   // tmp2
    }

    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < tileNum; i++) {
            uint32_t count = (i == tileNum - 1) ? tailTileElementNum : TILE_LENGTH;
            CopyIn(count);
            Compute(count);
            CopyOut(count);
        }
    }

    __aicore__ inline void CopyIn(uint32_t count)
    {
        AscendC::LocalTensor<half> selfLocal = inQueueSelf.AllocTensor<half>();
        AscendC::LocalTensor<half> otherLocal = inQueueOther.AllocTensor<half>();

        AscendC::DataCopyPad(selfLocal, selfGm,
            {1, static_cast<uint16_t>(count * sizeof(half)), 0, 0},
            {false, 0, 0, 0});
        AscendC::DataCopyPad(otherLocal, otherGm,
            {1, static_cast<uint16_t>(count * sizeof(half)), 0, 0},
            {false, 0, 0, 0});

        inQueueSelf.EnQue(selfLocal);
        inQueueOther.EnQue(otherLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        AscendC::LocalTensor<half> selfLocal = inQueueSelf.DeQue<half>();
        AscendC::LocalTensor<half> otherLocal = inQueueOther.DeQue<half>();
        AscendC::LocalTensor<half> outLocal = outQueueOut.AllocTensor<half>();

        // 获取 float32 计算缓冲
        AscendC::LocalTensor<float> aBuf = tmpBufA.Get<float>();
        AscendC::LocalTensor<float> bBuf = tmpBufB.Get<float>();
        AscendC::LocalTensor<float> tmp1 = tmpBufC.Get<float>();
        AscendC::LocalTensor<float> tmp2 = tmpBufD.Get<float>();

        // 1. half → float32 提升
        AscendC::Cast(aBuf, selfLocal, AscendC::RoundMode::CAST_NONE, count);
        AscendC::Cast(bBuf, otherLocal, AscendC::RoundMode::CAST_NONE, count);

        // 2. 取绝对值 (float32)
        AscendC::Abs(aBuf, aBuf, count);   // a = |self|
        AscendC::Abs(bBuf, bBuf, count);   // b = |other|

        // 3. 欧几里得算法迭代 (float32，无溢出风险)
        const float FLT_EPSILON = 1e-10f;  // 防除零阈值

        for (uint32_t iter = 0; iter < MAX_GCD_ITER; iter++) {
            // 保护：b = max(b, EPSILON)
            AscendC::Max(bBuf, bBuf, FLT_EPSILON, count);

            // r = a - floor(a / b) * b
            AscendC::Div(tmp1, aBuf, bBuf, count);      // tmp1 = a / b
            AscendC::Floor(tmp1, tmp1, count);           // tmp1 = floor(a / b)
            AscendC::Mul(tmp2, tmp1, bBuf, count);       // tmp2 = floor(a/b) * b
            AscendC::Sub(tmp1, aBuf, tmp2, count);       // tmp1 = r = a - floor(a/b)*b

            // 欧几里得交换: a ← b, b ← r
            AscendC::Copy(aBuf, bBuf, count);            // a = old_b
            AscendC::Copy(bBuf, tmp1, count);            // b = r
        }

        // 4. float32 → half (截断取整)
        AscendC::Cast(outLocal, aBuf, AscendC::RoundMode::CAST_NONE, count);

        outQueueOut.EnQue<half>(outLocal);
        inQueueSelf.FreeTensor(selfLocal);
        inQueueOther.FreeTensor(otherLocal);
    }

    __aicore__ inline void CopyOut(uint32_t count)
    {
        AscendC::LocalTensor<half> outLocal = outQueueOut.DeQue<half>();
        AscendC::DataCopyPad(outGm, outLocal,
            {1, static_cast<uint16_t>(count * sizeof(half)), 0, 0});
        outQueueOut.FreeTensor(outLocal);
    }

private:
    AscendC::TPipe* pipe_;
    const __gm__ GcdTilingData* tiling;

    AscendC::GlobalTensor<half> selfGm;
    AscendC::GlobalTensor<half> otherGm;
    AscendC::GlobalTensor<half> outGm;

    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueSelf;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueOther;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueOut;

    AscendC::TBuf<AscendC::TPosition::VECCALC> tmpBufA;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmpBufB;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmpBufC;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmpBufD;

    uint32_t total;
    uint32_t tileNum;
    uint32_t tailTileElementNum;
};

// 核函数入口
extern "C" __global__ __vector__ void gcd_custom_kernel(
    GM_ADDR self, GM_ADDR other, GM_ADDR out, GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    KernelGcd op(&pipe);
    op.Init(self, other, out, (__gm__ GcdTilingData*)tiling);
    op.Process();
}
