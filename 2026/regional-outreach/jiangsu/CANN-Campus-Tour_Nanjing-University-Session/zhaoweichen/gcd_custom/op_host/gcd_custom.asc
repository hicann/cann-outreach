/* Generated By CANNBot */

// ============================================================================
// Host + Main 入口 - Gcd 算子
// ============================================================================
//
// 策略：host 读取原始数据 → 按 broadcast 规则扩展为等长数据 → 传给 kernel
//
// 用法: ./gcd_custom s4 s3 s2 s1  o4 o3 o2 o1
//   例: ./gcd_custom 4 2 1 8  4 1 6 8
//       → self=[4,2,1,8], other=[4,1,6,8], broadcast→out=[4,2,6,8]
// ============================================================================

#include <cstdint>
#include <cstdlib>
#include <iostream>
#include <vector>
#include <string>
#include <cstring>
#include "acl/acl.h"
#include "../op_kernel/gcd_custom_tiling.h"
#include "data_utils.h"

#include "../op_kernel/gcd_custom_kernel.asc"

// ============================================================================
// Host 端：broadcast 扩展工具
// ============================================================================

// 将原始数据按 broadcast 规则扩展到目标 shape
// srcShape: 原始 4D shape, dstShape: 目标 4D shape (broadcast 结果)
// srcData: 原始数据 (srcLen 个 half), dstData: 输出缓冲区 (dstLen 个 half)
void ExpandBroadcast(const int32_t srcShape[MAX_DIMS], const int32_t dstShape[MAX_DIMS],
                     const uint8_t* srcData, uint8_t* dstData,
                     int32_t srcLen, int32_t dstLen)
{
    int32_t srcStrides[MAX_DIMS];
    int32_t dstStrides[MAX_DIMS];
    ComputeStrides(srcShape, srcStrides);
    ComputeStrides(dstShape, dstStrides);

    const half* src = reinterpret_cast<const half*>(srcData);
    half* dst = reinterpret_cast<half*>(dstData);

    for (int32_t pos = 0; pos < dstLen; pos++) {
        // 将 dst flat pos 解为 4D 索引
        int32_t rem = pos;
        int32_t d_n1 = rem % dstShape[3]; rem /= dstShape[3];
        int32_t d_n2 = rem % dstShape[2]; rem /= dstShape[2];
        int32_t d_n3 = rem % dstShape[1];
        int32_t d_n4 = rem / dstShape[1];

        // broadcast 映射
        int32_t s_n4 = (srcShape[0] == 1) ? 0 : d_n4;
        int32_t s_n3 = (srcShape[1] == 1) ? 0 : d_n3;
        int32_t s_n2 = (srcShape[2] == 1) ? 0 : d_n2;
        int32_t s_n1 = (srcShape[3] == 1) ? 0 : d_n1;

        int32_t srcIdx = FlatIndex(srcStrides, s_n4, s_n3, s_n2, s_n1);
        dst[pos] = src[srcIdx];
    }
}

// ============================================================================
// 核函数调用封装
// ============================================================================
void KernelCall(uint32_t blockNum, aclrtStream stream,
                uint8_t* selfDevice, uint8_t* otherDevice, uint8_t* outDevice,
                size_t byteSize, uint8_t* tilingDevice)
{
    gcd_custom_kernel<<<blockNum, nullptr, stream>>>(
        selfDevice, otherDevice, outDevice, tilingDevice);
    aclrtSynchronizeStream(stream);
}

// ============================================================================
// Main 入口
// ============================================================================
int32_t main(int32_t argc, char *argv[])
{
    if (argc < 9) {
        printf("Usage: %s s4 s3 s2 s1  o4 o3 o2 o1\n", argv[0]);
        printf("  e.g. %s 4 2 1 8  4 1 6 8\n", argv[0]);
        return 1;
    }

    // ---- 1. 解析 shape 参数 ----
    int32_t selfShape[MAX_DIMS], otherShape[MAX_DIMS], outShape[MAX_DIMS];
    selfShape[0]  = std::stoi(argv[1]); selfShape[1]  = std::stoi(argv[2]);
    selfShape[2]  = std::stoi(argv[3]); selfShape[3]  = std::stoi(argv[4]);
    otherShape[0] = std::stoi(argv[5]); otherShape[1] = std::stoi(argv[6]);
    otherShape[2] = std::stoi(argv[7]); otherShape[3] = std::stoi(argv[8]);

    ComputeBroadcastShape(selfShape, otherShape, outShape);
    for (int i = 0; i < MAX_DIMS; i++) {
        if (outShape[i] == -1) {
            printf("ERROR: broadcast incompatible at dim %d\n", i);
            return 1;
        }
    }

    int32_t selfLen   = selfShape[0]  * selfShape[1]  * selfShape[2]  * selfShape[3];
    int32_t otherLen  = otherShape[0] * otherShape[1] * otherShape[2] * otherShape[3];
    int32_t outLen    = outShape[0]   * outShape[1]   * outShape[2]   * outShape[3];

    printf("self  shape = [%d,%d,%d,%d] (%d elements)\n",
           selfShape[0], selfShape[1], selfShape[2], selfShape[3], selfLen);
    printf("other shape = [%d,%d,%d,%d] (%d elements)\n",
           otherShape[0], otherShape[1], otherShape[2], otherShape[3], otherLen);
    printf("out   shape = [%d,%d,%d,%d] (%d elements)\n",
           outShape[0], outShape[1], outShape[2], outShape[3], outLen);

    size_t selfByteSize   = static_cast<size_t>(selfLen)  * sizeof(uint16_t);
    size_t otherByteSize  = static_cast<size_t>(otherLen) * sizeof(uint16_t);
    size_t outByteSize    = static_cast<size_t>(outLen)   * sizeof(uint16_t);

    // ---- 2. 读取原始数据（未扩展） ----
    std::vector<uint8_t> selfOrig(selfByteSize);
    std::vector<uint8_t> otherOrig(otherByteSize);
    ReadFile("./input/input_self.bin",  selfByteSize,  selfOrig.data(),  selfByteSize);
    ReadFile("./input/input_other.bin", otherByteSize, otherOrig.data(), otherByteSize);

    // ---- 3. Host 侧 broadcast 扩展 ----
    std::vector<uint8_t> selfExpanded(outByteSize);
    std::vector<uint8_t> otherExpanded(outByteSize);
    ExpandBroadcast(selfShape, outShape, selfOrig.data(), selfExpanded.data(), selfLen, outLen);
    ExpandBroadcast(otherShape, outShape, otherOrig.data(), otherExpanded.data(), otherLen, outLen);

    // ---- 4. ACL 初始化 ----
    aclInit(nullptr);
    int32_t deviceId = 0;
    auto ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) { printf("aclrtSetDevice failed, ret=%d\n", ret); return ret; }

    int64_t availableCoreNum = 0;
    ret = aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum);
    if (ret != ACL_SUCCESS) { printf("aclrtGetDeviceInfo failed\n"); aclrtResetDevice(deviceId); return ret; }

    // ---- 5. Tiling 计算 ----
    GcdTilingData tiling;
    tiling.totalLength = static_cast<uint64_t>(outLen);
    uint64_t totalTiles = (outLen + TILE_LENGTH - 1) / TILE_LENGTH;
    uint64_t tilesPerCore = (totalTiles + availableCoreNum - 1) / availableCoreNum;
    tiling.blockNum = (totalTiles + tilesPerCore - 1) / tilesPerCore;
    tiling.numPerCore = tilesPerCore * TILE_LENGTH;
    tiling.tailNumLastCore = outLen - tiling.numPerCore * (tiling.blockNum - 1);

    printf("blockNum=%u, numPerCore=%lu, tailNumLastCore=%lu\n",
           tiling.blockNum, tiling.numPerCore, tiling.tailNumLastCore);

    // ---- 6. 分配 Device 内存并拷贝 ----
    uint8_t *selfDev = nullptr, *otherDev = nullptr, *outDev = nullptr, *tilingDev = nullptr;
    aclrtMalloc((void**)&selfDev,   outByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&otherDev,  outByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outDev,    outByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&tilingDev, sizeof(GcdTilingData), ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(selfDev,   outByteSize, selfExpanded.data(),  outByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(otherDev,  outByteSize, otherExpanded.data(), outByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(tilingDev, sizeof(GcdTilingData), &tiling, sizeof(GcdTilingData), ACL_MEMCPY_HOST_TO_DEVICE);

    // ---- 7. 启动 Kernel ----
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    KernelCall(tiling.blockNum, stream, selfDev, otherDev, outDev, outByteSize, tilingDev);

    // ---- 8. 回写输出 ----
    std::vector<uint8_t> outputHost(outByteSize);
    aclrtMemcpy(outputHost.data(), outByteSize, outDev, outByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outputHost.data(), outByteSize);

    // ---- 9. 清理 ----
    aclrtFree(selfDev);    aclrtFree(otherDev);
    aclrtFree(outDev);     aclrtFree(tilingDev);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    printf("Done. Output written to output/output.bin\n");
    return 0;
}
