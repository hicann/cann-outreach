/* Generated By CANNBot */

// ============================================================================
// Ascend C Kernel 实现 - Gcd 算子
// ============================================================================
//
// 算子功能:  out = gcd(self, other)  逐元素最大公约数
// 数据类型:  float16 (half)
// 输入:      2 个等长 GM_ADDR (self, other) — host 已做 broadcast 预扩展
// 输出:      1 个 GM_ADDR (out)
//
// 使用标准 CopyIn → Compute → CopyOut queue 模式
// ============================================================================

#include "kernel_operator.h"
#include "gcd_custom_tiling.h"

using namespace AscendC;

class KernelGcd {
public:
    __aicore__ inline KernelGcd(TPipe* pipe)
    {
        pipe_ = pipe;
    };

    __aicore__ inline void Init(GM_ADDR self, GM_ADDR other, GM_ADDR out,
                                const __gm__ GcdTilingData* tiling)
    {
        this->tiling = tiling;
        uint32_t blockIdx = GetBlockIdx();

        // 计算本 block 负责的元素范围
        if (blockIdx < tiling->blockNum - 1) {
            total = tiling->numPerCore;
            tileNum = total / TILE_LENGTH;
            tailTileElementNum = TILE_LENGTH;
        } else {
            total = tiling->tailNumLastCore;
            tileNum = (total + TILE_LENGTH - 1) / TILE_LENGTH;
            tailTileElementNum = total - TILE_LENGTH * (tileNum - 1);
        }

        // GlobalTensor 偏移到本 block 的起始位置
        uint32_t offset = blockIdx * tiling->numPerCore;
        selfGm.SetGlobalBuffer((__gm__ half*)self + offset, total);
        otherGm.SetGlobalBuffer((__gm__ half*)other + offset, total);
        outGm.SetGlobalBuffer((__gm__ half*)out + offset, total);

        // UB Buffer：每个 queue 存放一个 tile 的数据
        pipe_->InitBuffer(inQueueSelf, DOUBLE_BUFFER, TILE_LENGTH * sizeof(half));
        pipe_->InitBuffer(inQueueOther, DOUBLE_BUFFER, TILE_LENGTH * sizeof(half));
        pipe_->InitBuffer(outQueueZ, DOUBLE_BUFFER, TILE_LENGTH * sizeof(half));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < tileNum; i++) {
            uint32_t count = (i == tileNum - 1) ? tailTileElementNum : TILE_LENGTH;
            CopyIn(count);
            Compute(count);
            CopyOut(count);
        }
    }

    __aicore__ inline void CopyIn(uint32_t count)
    {
        LocalTensor<half> selfLocal = inQueueSelf.AllocTensor<half>();
        LocalTensor<half> otherLocal = inQueueOther.AllocTensor<half>();

        uint16_t bytes = static_cast<uint16_t>(count * sizeof(half));
        DataCopyPad(selfLocal, selfGm, {1, bytes, 0, 0}, {false, 0, 0, 0});
        DataCopyPad(otherLocal, otherGm, {1, bytes, 0, 0}, {false, 0, 0, 0});

        inQueueSelf.EnQue(selfLocal);
        inQueueOther.EnQue(otherLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        LocalTensor<half> selfLocal = inQueueSelf.DeQue<half>();
        LocalTensor<half> otherLocal = inQueueOther.DeQue<half>();
        LocalTensor<half> outLocal = outQueueZ.AllocTensor<half>();

        // 逐元素 GCD
        for (uint32_t i = 0; i < count; i++) {
            half a = selfLocal.GetValue(i);
            half b = otherLocal.GetValue(i);
            half c = gcd_half(a, b);
            outLocal.SetValue(i, c);
        }

        outQueueZ.EnQue<half>(outLocal);
        inQueueSelf.FreeTensor(selfLocal);
        inQueueOther.FreeTensor(otherLocal);
    }

    __aicore__ inline void CopyOut(uint32_t count)
    {
        LocalTensor<half> outLocal = outQueueZ.DeQue<half>();
        uint16_t bytes = static_cast<uint16_t>(count * sizeof(half));
        DataCopyPad(outGm, outLocal, {1, bytes, 0, 0});
        outQueueZ.FreeTensor(outLocal);
    }

private:
    // GCD: half → int32 Euclid → half
    __aicore__ inline half gcd_half(half a, half b)
    {
        int32_t ia = static_cast<int32_t>(static_cast<float>(a));
        int32_t ib = static_cast<int32_t>(static_cast<float>(b));
        ia = (ia < 0) ? -ia : ia;
        ib = (ib < 0) ? -ib : ib;

        while (ib != 0) {
            int32_t temp = ib;
            ib = ia % ib;
            ia = temp;
        }
        return static_cast<half>(static_cast<float>(ia));
    }

    TPipe* pipe_;
    const __gm__ GcdTilingData* tiling;

    GlobalTensor<half> selfGm;
    GlobalTensor<half> otherGm;
    GlobalTensor<half> outGm;

    TQue<TPosition::VECIN, 1> inQueueSelf;
    TQue<TPosition::VECIN, 1> inQueueOther;
    TQue<TPosition::VECOUT, 1> outQueueZ;

    uint32_t total;
    uint32_t tileNum;
    uint32_t tailTileElementNum;
};

// 核函数入口
extern "C" __global__ __vector__ void gcd_custom_kernel(
    GM_ADDR self, GM_ADDR other, GM_ADDR out, GM_ADDR tiling)
{
    TPipe pipe;
    KernelGcd op(&pipe);
    op.Init(self, other, out, (__gm__ GcdTilingData*)tiling);
    op.Process();
}
