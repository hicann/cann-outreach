/* Generated By CANNBot */

// ============================================================================
// Ascend C Kernel 实现 - Gcd 算子（纯 kernel 代码）
// ============================================================================
//
// 算子类型: Elementwise 逐元素二元算子
// 数据类型: FP16 (half) → 内部转为 float 计算
// 数学定义: z = gcd(self, other)
//
// 实现:
//   1. Cast half → float
//   2. 取绝对值
//   3. Euclidean 算法: 固定 16 次迭代
//      - 每次: q = trunc(a / b), r = a - q * b
//        trunc 通过 float→int32(TRUNC)→float 实现
//      - 当 b > 0: a = b, b = r（用 Compare + Select 实现条件更新）
//   4. Cast float → half
// ============================================================================

#include "kernel_operator.h"
#include "gcd_custom_tiling.h"

// Kernel 类
class KernelGcd {
public:
    __aicore__ inline KernelGcd(AscendC::TPipe* pipe)
    {
        pipe_ = pipe;
    };

    __aicore__ inline void Init(GM_ADDR self, GM_ADDR other, GM_ADDR out,
                                const __gm__ GcdTilingData* tiling)
    {
        this->tiling = tiling;
        uint32_t blockIdx = AscendC::GetBlockIdx();
        if (blockIdx < tiling->blockNum - 1) {
            total = tiling->numPerCore;
            tileNum = total / TILE_LENGTH;
            tailTileElementNum = TILE_LENGTH;
        } else {
            total = tiling->tailNumLastCore;
            tileNum = (total + (TILE_LENGTH - 1)) / TILE_LENGTH;
            tailTileElementNum = total - TILE_LENGTH * (tileNum - 1);
        }

        // 二元算子：2 个输入 + 1 个输出
        selfGm.SetGlobalBuffer((__gm__ half*)self + blockIdx * tiling->numPerCore, total);
        otherGm.SetGlobalBuffer((__gm__ half*)other + blockIdx * tiling->numPerCore, total);
        outGm.SetGlobalBuffer((__gm__ half*)out + blockIdx * tiling->numPerCore, total);

        // Buffer 规划 (TILE_LENGTH=2048):
        //   inQueueSelf, inQueueOther: half 输入 (DB: 2048*2*2 = 8KB each)
        //   outQueueOut: half 输出 (DB: 2048*2*2 = 8KB)
        //   a, b, tmpQ, tmpR: float 工作区 (2048*4 = 8KB each)
        //   cmp: uint8 比较结果 (2048*1 = 2KB)
        //   zero: float 常量零 (2048*4 = 8KB)
        //   tmpI32: int32 中间值用于 trunc (2048*4 = 8KB)
        //   总计 ≈ 68KB, UB 容量 248KB 充裕
        pipe_->InitBuffer(inQueueSelf, DOUBLE_BUFFER, TILE_LENGTH * sizeof(half));
        pipe_->InitBuffer(inQueueOther, DOUBLE_BUFFER, TILE_LENGTH * sizeof(half));
        pipe_->InitBuffer(outQueueOut, DOUBLE_BUFFER, TILE_LENGTH * sizeof(half));
        pipe_->InitBuffer(tmpBufA, TILE_LENGTH * sizeof(float));
        pipe_->InitBuffer(tmpBufB, TILE_LENGTH * sizeof(float));
        pipe_->InitBuffer(tmpBufQ, TILE_LENGTH * sizeof(float));
        pipe_->InitBuffer(tmpBufR, TILE_LENGTH * sizeof(float));
        pipe_->InitBuffer(cmpBuf, TILE_LENGTH * sizeof(uint8_t));
        pipe_->InitBuffer(zeroBuf, TILE_LENGTH * sizeof(float));
        pipe_->InitBuffer(tmpI32Buf, TILE_LENGTH * sizeof(int32_t));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < tileNum; i++) {
            uint32_t count = (i == tileNum - 1) ? tailTileElementNum : TILE_LENGTH;
            CopyIn(count);
            Compute(count);
            CopyOut(count);
        }
    }

    __aicore__ inline void CopyIn(uint32_t count)
    {
        AscendC::LocalTensor<half> selfLocal = inQueueSelf.AllocTensor<half>();
        AscendC::LocalTensor<half> otherLocal = inQueueOther.AllocTensor<half>();

        AscendC::DataCopyPad(selfLocal, selfGm,
            {1, static_cast<uint16_t>(count * sizeof(half)), 0, 0},
            {false, 0, 0, 0});
        AscendC::DataCopyPad(otherLocal, otherGm,
            {1, static_cast<uint16_t>(count * sizeof(half)), 0, 0},
            {false, 0, 0, 0});

        inQueueSelf.EnQue(selfLocal);
        inQueueOther.EnQue(otherLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        AscendC::LocalTensor<half> selfLocal = inQueueSelf.DeQue<half>();
        AscendC::LocalTensor<half> otherLocal = inQueueOther.DeQue<half>();
        AscendC::LocalTensor<half> outLocal = outQueueOut.AllocTensor<half>();

        // 工作 buffer
        AscendC::LocalTensor<float> a = tmpBufA.Get<float>();
        AscendC::LocalTensor<float> b = tmpBufB.Get<float>();
        AscendC::LocalTensor<float> tmpQ = tmpBufQ.Get<float>();
        AscendC::LocalTensor<float> tmpR = tmpBufR.Get<float>();
        AscendC::LocalTensor<uint8_t> cmp = cmpBuf.Get<uint8_t>();
        AscendC::LocalTensor<float> zero = zeroBuf.Get<float>();
        AscendC::LocalTensor<int32_t> tmpI32 = tmpI32Buf.Get<int32_t>();

        // 初始化 zero = 0.0f
        AscendC::Duplicate(zero, (float)0.0f, count);

        // Step 1: Cast half → float
        AscendC::Cast<float>(a, selfLocal, AscendC::RoundMode::CAST_NONE, count);
        AscendC::Cast<float>(b, otherLocal, AscendC::RoundMode::CAST_NONE, count);

        // Step 2: 取绝对值
        AscendC::Abs(a, a, count);
        AscendC::Abs(b, b, count);

        // Step 3: Euclidean 算法（16 次迭代）
        // 核心: trunc(a/b) = Cast<int32>(Cast<float>(a/b, TRUNC))
        // r = a - trunc(a/b) * b
        for (int iter = 0; iter < 16; iter++) {
            // cmp = (b > 0)
            AscendC::Compare(cmp, b, zero, AscendC::CMPMODE::GT, count);

            // tmpQ = a / b  (float)
            AscendC::Div(tmpQ, a, b, count);

            // trunc(tmpQ) = Cast<int32>(tmpQ, TRUNC)
            AscendC::Cast<int32_t>(tmpI32, tmpQ, AscendC::RoundMode::CAST_TRUNC, count);
            // tmpQ = (float)trunc_result
            AscendC::Cast<float>(tmpQ, tmpI32, AscendC::RoundMode::CAST_NONE, count);

            // tmpR = a - tmpQ * b = a - trunc(a/b) * b = a % b
            AscendC::Mul(tmpR, tmpQ, b, count);
            AscendC::Sub(tmpR, a, tmpR, count);

            // a_next = (b > 0) ? b : a
            AscendC::Select(a, cmp, b, a, AscendC::SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
            // b_next = (b > 0) ? r : b (= 0, 终止条件)
            AscendC::Select(b, cmp, tmpR, b, AscendC::SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
        }

        // Step 4: Cast float → half
        AscendC::Cast<half>(outLocal, a, AscendC::RoundMode::CAST_NONE, count);

        outQueueOut.EnQue<half>(outLocal);
        inQueueSelf.FreeTensor(selfLocal);
        inQueueOther.FreeTensor(otherLocal);
    }

    __aicore__ inline void CopyOut(uint32_t count)
    {
        AscendC::LocalTensor<half> outLocal = outQueueOut.DeQue<half>();
        AscendC::DataCopyPad(outGm, outLocal,
            {1, static_cast<uint16_t>(count * sizeof(half)), 0, 0});
        outQueueOut.FreeTensor(outLocal);
    }

private:
    AscendC::TPipe* pipe_;
    const __gm__ GcdTilingData* tiling;

    AscendC::GlobalTensor<half> selfGm;
    AscendC::GlobalTensor<half> otherGm;
    AscendC::GlobalTensor<half> outGm;

    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueSelf;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueOther;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueOut;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmpBufA;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmpBufB;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmpBufQ;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmpBufR;
    AscendC::TBuf<AscendC::TPosition::VECCALC> cmpBuf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> zeroBuf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmpI32Buf;
    uint32_t total;
    uint32_t tileNum;
    uint32_t tailTileElementNum;
};

// 核函数入口
__global__ __vector__ void gcd_custom_kernel(GM_ADDR self, GM_ADDR other,
                                              GM_ADDR out, GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    KernelGcd op(&pipe);
    op.Init(self, other, out, (__gm__ GcdTilingData*)tiling);
    op.Process();
}
