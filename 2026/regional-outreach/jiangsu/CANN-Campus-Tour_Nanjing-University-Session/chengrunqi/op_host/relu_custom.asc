// ============================================================================
// Ascend C Kernel 直调样例 - Relu 算子（Host + Main 入口）
// ============================================================================
//
// ReLU: z[i] = max(0, x[i])
// 支持 FP16，支持 4 维 ND 格式，典型 Shape:
//   - [1, 1, 1, 128]     → 128   元素
//   - [1, 4, 32, 64]    → 8192  元素
//   - [8, 16, 32, 32]   → 131072 元素
// ============================================================================

#include <cstdint>
#include <iostream>
#include <vector>
#include <string>
#include "acl/acl.h"
#include "../op_kernel/relu_custom_tiling.h"
#include "data_utils.h"

#include "../op_kernel/relu_custom_kernel.asc"

struct ArgInfo {
    std::string fileName;
    size_t length;
};

void KernelCall(uint32_t blockNum, aclrtStream stream,
    std::vector<ArgInfo> &inputsInfo, std::vector<ArgInfo> &outputsInfo,
    uint8_t *tilingData)
{
    std::vector<uint8_t *> inputHost(inputsInfo.size());
    std::vector<uint8_t *> inputDevice(inputsInfo.size());
    std::vector<uint8_t *> outputHost(outputsInfo.size());
    std::vector<uint8_t *> outputDevice(outputsInfo.size());
    uint8_t *tilingDevice = nullptr;

    aclrtMalloc((void **)&tilingDevice, sizeof(ReluTilingData), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(tilingDevice, sizeof(ReluTilingData), tilingData,
        sizeof(ReluTilingData), ACL_MEMCPY_HOST_TO_DEVICE);

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtMallocHost((void **)&inputHost[i], inputsInfo[i].length);
        aclrtMalloc((void **)&inputDevice[i], inputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile(inputsInfo[i].fileName, inputsInfo[i].length, inputHost[i], inputsInfo[i].length);
        aclrtMemcpy(inputDevice[i], inputsInfo[i].length, inputHost[i],
            inputsInfo[i].length, ACL_MEMCPY_HOST_TO_DEVICE);
    }

    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMallocHost((void **)&outputHost[i], outputsInfo[i].length);
        aclrtMalloc((void **)&outputDevice[i], outputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
    }

    relu_custom_kernel<<<blockNum, nullptr, stream>>>(
        inputDevice[0], outputDevice[0], tilingDevice);
    aclrtSynchronizeStream(stream);

    aclrtFree(tilingDevice);
    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMemcpy(outputHost[i], outputsInfo[i].length, outputDevice[i],
            outputsInfo[i].length, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile(outputsInfo[i].fileName, outputHost[i], outputsInfo[i].length);
        aclrtFree(outputDevice[i]);
        aclrtFreeHost(outputHost[i]);
    }

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtFree(inputDevice[i]);
        aclrtFreeHost(inputHost[i]);
    }
}

struct Shape4D {
    int64_t n4, n3, n2, n1;
    uint64_t totalElements() const { return n4 * n3 * n2 * n1; }
};

int RunShape(const Shape4D &shape, const std::string &shapeName, int32_t deviceId,
             int64_t availableCoreNum, aclrtStream stream)
{
    uint64_t totalLength = shape.totalElements();
    printf("\n=== Shape [%s]: [%ld,%ld,%ld,%ld], %lu elements ===\n",
           shapeName.c_str(), shape.n4, shape.n3, shape.n2, shape.n1, totalLength);

    size_t byteSize = totalLength * sizeof(half);

    ReluTilingData tiling;
    tiling.totalLength = totalLength;
    uint64_t totalTiles = (totalLength + TILE_LENGTH - 1) / TILE_LENGTH;
    uint64_t tilesPerCore = (totalTiles + availableCoreNum - 1) / availableCoreNum;
    uint32_t blockNum = tiling.blockNum = (totalTiles + tilesPerCore - 1) / tilesPerCore;
    tiling.numPerCore = tilesPerCore * TILE_LENGTH;
    tiling.tailNumLastCore = totalLength - tiling.numPerCore * (blockNum - 1);

    printf("  blockNum=%u, numPerCore=%lu, tailNumLastCore=%lu\n",
           blockNum, tiling.numPerCore, tiling.tailNumLastCore);

    std::string inputFile = std::string("./input/input_x_") + shapeName + ".bin";
    std::string outputFile = std::string("./output/output_") + shapeName + ".bin";

    std::vector<ArgInfo> inputsInfo = {{inputFile, byteSize}};
    std::vector<ArgInfo> outputsInfo = {{outputFile, byteSize}};

    KernelCall(blockNum, stream, inputsInfo, outputsInfo, (uint8_t *)&tiling);
    printf("  Kernel done for shape [%s]\n", shapeName.c_str());
    return 0;
}

int32_t main(int32_t argc, char *argv[])
{
    aclInit(nullptr);
    int32_t deviceId = 0;
    auto ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) {
        printf("aclrtSetDevice failed, ret=%d\n", ret);
        return ret;
    }

    int64_t availableCoreNum = 0;
    ret = aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum);
    if (ret != ACL_SUCCESS) {
        printf("aclrtGetDeviceInfo failed, ret=%d\n", ret);
        aclrtResetDevice(deviceId);
        return ret;
    }
    printf("Available cores: %ld\n", availableCoreNum);

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    Shape4D shapes[] = {
        {1, 1, 1, 128},
        {1, 4, 32, 64},
        {8, 16, 32, 32},
    };
    const char *shapeNames[] = {"1_1_1_128", "1_4_32_64", "8_16_32_32"};

    for (int i = 0; i < 3; i++) {
        RunShape(shapes[i], shapeNames[i], deviceId, availableCoreNum, stream);
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    printf("\n=== All shapes completed ===\n");
    return 0;
}
