/* Generated By CANNBot */

// ============================================================================
// Ascend C Kernel 实现 - Relu 算子
// ============================================================================
//
// ReLU: z[i] = max(0, x[i])
// 支持 FP16 数据类型，逐元素计算。
// 输入: x (half)
// 输出: z (half)
// ============================================================================

#include "kernel_operator.h"
#include "relu_custom_tiling.h"

using half = __half;

class KernelRelu {
public:
    __aicore__ inline KernelRelu(AscendC::TPipe* pipe)
    {
        pipe_ = pipe;
    };

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR z,
                                const __gm__ ReluTilingData* tiling)
    {
        this->tiling = tiling;
        uint32_t blockIdx = AscendC::GetBlockIdx();
        if (blockIdx < tiling->blockNum - 1) {
            total = tiling->numPerCore;
            tileNum = total / TILE_LENGTH;
            tailTileElementNum = TILE_LENGTH;
        } else {
            total = tiling->tailNumLastCore;
            tileNum = (total + (TILE_LENGTH - 1)) / TILE_LENGTH;
            tailTileElementNum = total - TILE_LENGTH * (tileNum - 1);
        }

        // 单输入 x、单输出 z
        xGm.SetGlobalBuffer((__gm__ half*)x + blockIdx * tiling->numPerCore, total);
        zGm.SetGlobalBuffer((__gm__ half*)z + blockIdx * tiling->numPerCore, total);

        // UB Buffer: 1 输入 + 1 输出，各 DOUBLE_BUFFER 份
        pipe_->InitBuffer(inQueueX, DOUBLE_BUFFER, TILE_LENGTH * sizeof(half));
        pipe_->InitBuffer(outQueueZ, DOUBLE_BUFFER, TILE_LENGTH * sizeof(half));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < tileNum; i++) {
            uint32_t count = (i == tileNum - 1) ? tailTileElementNum : TILE_LENGTH;
            CopyIn(count);
            Compute(count);
            CopyOut(count);
        }
    }

    __aicore__ inline void CopyIn(uint32_t count)
    {
        AscendC::LocalTensor<half> xLocal = inQueueX.AllocTensor<half>();
        AscendC::DataCopyPad(xLocal, xGm,
            {1, static_cast<uint16_t>(count * sizeof(half)), 0, 0},
            {false, 0, 0, 0});
        inQueueX.EnQue(xLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        AscendC::LocalTensor<half> xLocal = inQueueX.DeQue<half>();
        AscendC::LocalTensor<half> zLocal = outQueueZ.AllocTensor<half>();

        // ReLU: z[i] = max(0, x[i])
        AscendC::Relu(zLocal, xLocal, count);

        outQueueZ.EnQue<half>(zLocal);
        inQueueX.FreeTensor(xLocal);
    }

    __aicore__ inline void CopyOut(uint32_t count)
    {
        AscendC::LocalTensor<half> zLocal = outQueueZ.DeQue<half>();
        AscendC::DataCopyPad(zGm, zLocal,
            {1, static_cast<uint16_t>(count * sizeof(half)), 0, 0});
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe* pipe_;
    const __gm__ ReluTilingData* tiling;

    AscendC::GlobalTensor<half> xGm;
    AscendC::GlobalTensor<half> zGm;

    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueX;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueZ;

    uint32_t total;
    uint32_t tileNum;
    uint32_t tailTileElementNum;
};

extern "C" __global__ __vector__ void relu_custom_kernel(GM_ADDR x, GM_ADDR z, GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    KernelRelu op(&pipe);
    op.Init(x, z, (__gm__ ReluTilingData*)tiling);
    op.Process();
}
