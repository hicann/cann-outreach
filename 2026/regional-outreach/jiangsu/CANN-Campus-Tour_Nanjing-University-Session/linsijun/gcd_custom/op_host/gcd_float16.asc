// ============================================================================
// Ascend C Kernel 直调样例 - Gcd Float16 算子（Host + Main 入口）
// ============================================================================
//
// 功能: 对两个 float16 输入逐元素求最大公约数
//       支持 Broadcast: self 和 other 可具有不同 4D shape，
//       程序自动扩展至 broadcast shape 后再调用 kernel。
//
// 支持的测试 Shape (4D):
//   [A] self=[1,1,1,128],  other=[1,1,1,128]  → out=[1,1,1,128]   (简单相同)
//   [B] self=[1,1,1,128],  other=[1,1,4,1]    → out=[1,1,4,128]   (N2 broadcast)
//   [C] self=[2,1,1,128],  other=[1,4,1,1]    → out=[2,4,1,128]   (N3+N1 broadcast)
//   [D] self=[1,1,32,1],   other=[1,1,1,4096] → out=[1,1,32,4096] (N1+N2 broadcast)
// ============================================================================

#include <cstdint>
#include <iostream>
#include <vector>
#include <cstring>
#include <algorithm>
#include "acl/acl.h"
#include "../op_kernel/gcd_float16_tiling.h"
#include "data_utils.h"

// 引用拆出的纯 kernel 文件（包含 kernel_operator.h）
#include "../op_kernel/gcd_float16_kernel.asc"

using half = AscendC::half;

// ============================================================================
// Broadcast 工具函数 - 计算 4D broadcast shape 并扩展数据
// ============================================================================

// 计算 4D broadcast 输出形状
// 遵循 NumPy broadcast 语义: 从后往前对齐，维度为 1 或相等时兼容
inline void ComputeBroadcastShape4D(
    const int32_t selfShape[4], const int32_t otherShape[4],
    int32_t outShape[4])
{
    for (int i = 0; i < 4; i++) {
        // NumPy broadcast: max of the two dims
        // 兼容条件: dim==1 → 广播扩展, dim相等 → 保持不变, 其他 → 不兼容 (取max触发运行时错误)
        int32_t s = selfShape[i];
        int32_t o = otherShape[i];
        if (s != o && s != 1 && o != 1) {
            fprintf(stderr, "ERROR: Broadcast incompatible at dim %d: self=%d, other=%d\n", i, s, o);
            exit(1);
        }
        outShape[i] = (s > o) ? s : o;
    }
}

// 计算 broadcast 后的总元素数
inline int64_t ShapeToSize4D(const int32_t shape[4])
{
    return static_cast<int64_t>(shape[0]) *
           static_cast<int64_t>(shape[1]) *
           static_cast<int64_t>(shape[2]) *
           static_cast<int64_t>(shape[3]);
}

// 将输入数据从原始 shape broadcast-expand 到目标 shape
// 输入: srcData 指针 (原始数据, layout=ND)
//       srcShape[4] 原始 shape
//       dstShape[4] 目标 broadcast shape
// 输出: dstBuf 指针 (已分配好 dstSize 字节)
inline void BroadcastExpand4D(const half* srcData, const int32_t srcShape[4],
                               const int32_t dstShape[4], half* dstBuf)
{
    int64_t srcStrides[4];
    srcStrides[3] = 1;
    srcStrides[2] = srcShape[3];
    srcStrides[1] = srcShape[2] * srcShape[3];
    srcStrides[0] = srcShape[1] * srcShape[2] * srcShape[3];

    for (int i0 = 0; i0 < dstShape[0]; i0++) {
        int si0 = (srcShape[0] == 1) ? 0 : i0;
        for (int i1 = 0; i1 < dstShape[1]; i1++) {
            int si1 = (srcShape[1] == 1) ? 0 : i1;
            for (int i2 = 0; i2 < dstShape[2]; i2++) {
                int si2 = (srcShape[2] == 1) ? 0 : i2;
                for (int i3 = 0; i3 < dstShape[3]; i3++) {
                    int si3 = (srcShape[3] == 1) ? 0 : i3;
                    int64_t srcIdx = si0 * srcStrides[0] + si1 * srcStrides[1]
                                   + si2 * srcStrides[2] + si3;
                    int64_t dstIdx = ((i0 * dstShape[1] + i1) * dstShape[2] + i2) * dstShape[3] + i3;
                    dstBuf[dstIdx] = srcData[srcIdx];
                }
            }
        }
    }
}

// ============================================================================
// Host 端代码 - 运行在 CPU 上
// ============================================================================

struct ArgInfo {
    std::string fileName;
    size_t length;
};

struct ShapeDesc {
    int32_t dims[4];
    std::string name;
};

// KernelCall 封装 - 处理完整的核函数调用流程
void KernelCall(uint32_t blockNum, aclrtStream stream,
    std::vector<ArgInfo> &inputsInfo, std::vector<ArgInfo> &outputsInfo,
    uint8_t *tilingData)
{
    std::vector<uint8_t *> inputHost(inputsInfo.size());
    std::vector<uint8_t *> inputDevice(inputsInfo.size());
    std::vector<uint8_t *> outputHost(outputsInfo.size());
    std::vector<uint8_t *> outputDevice(outputsInfo.size());
    uint8_t *tilingDevice = nullptr;

    aclrtMalloc((void **)&tilingDevice, sizeof(GcdFloat16TilingData), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(tilingDevice, sizeof(GcdFloat16TilingData), tilingData,
        sizeof(GcdFloat16TilingData), ACL_MEMCPY_HOST_TO_DEVICE);

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtMallocHost((void **)&inputHost[i], inputsInfo[i].length);
        aclrtMalloc((void **)&inputDevice[i], inputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile(inputsInfo[i].fileName, inputsInfo[i].length, inputHost[i], inputsInfo[i].length);
        aclrtMemcpy(inputDevice[i], inputsInfo[i].length, inputHost[i],
            inputsInfo[i].length, ACL_MEMCPY_HOST_TO_DEVICE);
    }

    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMallocHost((void **)&outputHost[i], outputsInfo[i].length);
        aclrtMalloc((void **)&outputDevice[i], outputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
    }

    // 核函数入口: gcd_float16_kernel
    // 签名: __global__ __vector__ void gcd_float16_kernel(GM_ADDR self, GM_ADDR other, GM_ADDR out, GM_ADDR tiling)
    gcd_float16_kernel<<<blockNum, nullptr, stream>>>(
        inputDevice[0], inputDevice[1], outputDevice[0], tilingDevice);
    aclrtSynchronizeStream(stream);

    aclrtFree(tilingDevice);
    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMemcpy(outputHost[i], outputsInfo[i].length, outputDevice[i],
            outputsInfo[i].length, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile(outputsInfo[i].fileName, outputHost[i], outputsInfo[i].length);
        aclrtFree(outputDevice[i]);
        aclrtFreeHost(outputHost[i]);
    }

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtFree(inputDevice[i]);
        aclrtFreeHost(inputHost[i]);
    }
}

// 将 shape 描述符转为字符串
std::string ShapeStr(const int32_t shape[4])
{
    char buf[64];
    snprintf(buf, sizeof(buf), "[%d,%d,%d,%d]", shape[0], shape[1], shape[2], shape[3]);
    return std::string(buf);
}

// ACL 标准初始化流程
int32_t main(int32_t argc, char *argv[])
{
    aclInit(nullptr);
    int32_t deviceId = 0;
    auto ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) {
        printf("aclrtSetDevice failed, ret=%d\n", ret);
        return ret;
    }

    // 获取设备最大核数
    int64_t availableCoreNum = 0;
    ret = aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum);
    if (ret != ACL_SUCCESS) {
        printf("aclrtGetDeviceInfo failed, ret=%d\n", ret);
        aclrtResetDevice(deviceId);
        return ret;
    }

    // ============================================
    // 测试用例: 多组 4D broadcast shape
    // ============================================
    // [A] self=[1,1,1,128], other=[1,1,1,128] → out=[1,1,1,128] (same shape)
    // [B] self=[1,1,1,128], other=[1,1,4,1]   → out=[1,1,4,128] (N2 broadcast)
    // [C] self=[2,1,1,128], other=[1,4,1,1]   → out=[2,4,1,128] (N3+N1 broadcast)
    // ============================================

    // 创建测试输入数据的目录
    system("mkdir -p input output");

    struct TestCase {
        std::string name;
        int32_t selfShape[4];
        int32_t otherShape[4];
    };

    TestCase testCases[] = {
        {"A",  {1, 1, 1, 128}, {1, 1, 1, 128}},
        {"B",  {1, 1, 1, 128}, {1, 1, 4, 1}},
        {"C",  {2, 1, 1, 128}, {1, 4, 1, 1}},
    };
    int numCases = sizeof(testCases) / sizeof(testCases[0]);

    for (int tc = 0; tc < numCases; tc++) {
        const auto& testCase = testCases[tc];

        // 计算 broadcast shape
        int32_t outShape[4];
        ComputeBroadcastShape4D(testCase.selfShape, testCase.otherShape, outShape);

        int64_t selfSize  = ShapeToSize4D(testCase.selfShape);
        int64_t otherSize = ShapeToSize4D(testCase.otherShape);
        int64_t outSize   = ShapeToSize4D(outShape);

        printf("\n=== Test Case %s ===\n", testCase.name.c_str());
        printf("  self:  %s (%ld elements)\n",  ShapeStr(testCase.selfShape).c_str(),  selfSize);
        printf("  other: %s (%ld elements)\n",   ShapeStr(testCase.otherShape).c_str(), otherSize);
        printf("  out:   %s (%ld elements)\n",   ShapeStr(outShape).c_str(),           outSize);

        // 检查广播后的数据量与原始数据量
        if (selfSize != outSize) {
            printf("  → self needs broadcast expand (%ld → %ld)\n", selfSize, outSize);
        }
        if (otherSize != outSize) {
            printf("  → other needs broadcast expand (%ld → %ld)\n", otherSize, outSize);
        }

        // 生成输入数据
        half* selfHost  = new half[selfSize];
        half* otherHost = new half[otherSize];
        half* outGolden = new half[outSize];

        // 填充原始数据: 使用接近整数的 float16 值确保 GCD 有意义
        for (int64_t i = 0; i < selfSize; i++) {
            // 随机生成 1~100 的整数 (表示为 float16)
            int val = (rand() % 100) + 1;
            if (rand() % 3 == 0) val = -val;  // 混入负数
            selfHost[i] = static_cast<half>(static_cast<float>(val));
        }
        for (int64_t i = 0; i < otherSize; i++) {
            int val = (rand() % 100) + 1;
            if (rand() % 3 == 0) val = -val;
            otherHost[i] = static_cast<half>(static_cast<float>(val));
        }
        // 混入特殊边界值
        if (selfSize > 0)  selfHost[0]  = static_cast<half>(0.0f);   // zero
        if (otherSize > 0) otherHost[0] = static_cast<half>(12.0f);  // gcd(0,12)=12
        if (selfSize > 1)  selfHost[1]  = static_cast<half>(48.0f);
        if (otherSize > 1) otherHost[1] = static_cast<half>(36.0f);  // gcd(48,36)=12
        if (selfSize > 2)  selfHost[2]  = static_cast<half>(17.0f);
        if (otherSize > 2) otherHost[2] = static_cast<half>(1.0f);   // gcd(17,1)=1
        // 浮点值: 7.5 = 15/2, 2.5 = 5/2 → gcd = 2.5
        if (selfSize > 3)  selfHost[3]  = static_cast<half>(7.5f);
        if (otherSize > 3) otherHost[3] = static_cast<half>(2.5f);

        // 如果需要 broadcast 扩展
        half* selfExpanded  = nullptr;
        half* otherExpanded = nullptr;
        half* selfFinal     = selfHost;
        half* otherFinal    = otherHost;

        if (selfSize != outSize) {
            selfExpanded = new half[outSize];
            BroadcastExpand4D(selfHost, testCase.selfShape, outShape, selfExpanded);
            selfFinal = selfExpanded;
        }
        if (otherSize != outSize) {
            otherExpanded = new half[outSize];
            BroadcastExpand4D(otherHost, testCase.otherShape, outShape, otherExpanded);
            otherFinal = otherExpanded;
        }

        // 计算 Golden: 逐元素 gcd
        for (int64_t i = 0; i < outSize; i++) {
            float a = static_cast<float>(selfFinal[i]);
            float b = static_cast<float>(otherFinal[i]);
            a = (a < 0) ? -a : a;
            b = (b < 0) ? -b : b;
            // 欧几里得算法
            while (b > 1e-6f) {
                float tmp = b;
                b = a - static_cast<float>(static_cast<int64_t>(a / b)) * b;
                a = tmp;
            }
            outGolden[i] = static_cast<half>(a);
        }

        // 写入二进制文件
        std::string caseDir = "input/" + testCase.name;
        std::string outDir  = "output/" + testCase.name;
        std::string mkdirCmd = "mkdir -p " + caseDir + " " + outDir;
        system(mkdirCmd.c_str());

        std::string selfPath  = caseDir + "/self.bin";
        std::string otherPath = caseDir + "/other.bin";
        std::string outPath   = outDir + "/golden.bin";

        WriteFile(selfPath,  reinterpret_cast<uint8_t*>(selfHost),  selfSize * sizeof(half));
        WriteFile(otherPath, reinterpret_cast<uint8_t*>(otherHost), otherSize * sizeof(half));
        WriteFile(outPath,   reinterpret_cast<uint8_t*>(outGolden), outSize * sizeof(half));

        delete[] selfHost;
        delete[] otherHost;
        delete[] outGolden;
        if (selfExpanded)  delete[] selfExpanded;
        if (otherExpanded) delete[] otherExpanded;
    }

    // ============================================
    // 运行测试 (使用最大测试 case 的 expanded buffer 大小)
    // ============================================

    // 选择 Case C (最大) 验证 kernel
    const auto& runCase = testCases[2];  // Case C
    int32_t runOutShape[4];
    ComputeBroadcastShape4D(runCase.selfShape, runCase.otherShape, runOutShape);
    int64_t runOutSize = ShapeToSize4D(runOutShape);

    size_t byteSize = runOutSize * sizeof(half);

    // 从文件加载已 broadcast-expanded 的数据并写入 expanded 文件
    half* selfExpBuf  = new half[byteSize / sizeof(half)];
    half* otherExpBuf = new half[byteSize / sizeof(half)];

    half* selfOrig = new half[ShapeToSize4D(runCase.selfShape)];
    half* otherOrig = new half[ShapeToSize4D(runCase.otherShape)];

    ReadFile("input/C/self.bin",  ShapeToSize4D(runCase.selfShape) * sizeof(half),
             reinterpret_cast<uint8_t*>(selfOrig),  ShapeToSize4D(runCase.selfShape) * sizeof(half));
    ReadFile("input/C/other.bin", ShapeToSize4D(runCase.otherShape) * sizeof(half),
             reinterpret_cast<uint8_t*>(otherOrig), ShapeToSize4D(runCase.otherShape) * sizeof(half));

    BroadcastExpand4D(selfOrig,  runCase.selfShape,  runOutShape, selfExpBuf);
    BroadcastExpand4D(otherOrig, runCase.otherShape, runOutShape, otherExpBuf);

    // 写入 expand 后的输入文件 (供 kernel 读取)
    WriteFile("input/expanded_self.bin",  reinterpret_cast<uint8_t*>(selfExpBuf),  byteSize);
    WriteFile("input/expanded_other.bin", reinterpret_cast<uint8_t*>(otherExpBuf), byteSize);

    delete[] selfOrig;
    delete[] otherOrig;

    // 设置 Tiling 数据 (基于 expand 后的总元素数)
    GcdFloat16TilingData tiling;
    tiling.totalLength = runOutSize;
    uint64_t totalTiles = (runOutSize + TILE_LENGTH - 1) / TILE_LENGTH;
    uint64_t tilesPerCore = (totalTiles + availableCoreNum - 1) / availableCoreNum;
    uint32_t blockNum = tiling.blockNum = (totalTiles + tilesPerCore - 1) / tilesPerCore;
    tiling.numPerCore = tilesPerCore * TILE_LENGTH;
    tiling.tailNumLastCore = runOutSize - tiling.numPerCore * (blockNum - 1);

    printf("\n=== Running Kernel (Test Case C: %s broadcast to %s) ===\n",
           ShapeStr(runCase.selfShape).c_str(), ShapeStr(runOutShape).c_str());
    printf("  totalElements=%ld, TILE_LENGTH=%d, blockNum=%d\n",
           runOutSize, TILE_LENGTH, blockNum);

    // 输入输出文件信息
    std::vector<ArgInfo> inputsInfo = {
        {"input/expanded_self.bin",  byteSize},
        {"input/expanded_other.bin", byteSize}
    };
    std::vector<ArgInfo> outputsInfo = {
        {"output/output.bin", byteSize}
    };

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    KernelCall(blockNum, stream, inputsInfo, outputsInfo, (uint8_t *)&tiling);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    // 清理 expanded 数据
    delete[] selfExpBuf;
    delete[] otherExpBuf;

    return 0;
}
