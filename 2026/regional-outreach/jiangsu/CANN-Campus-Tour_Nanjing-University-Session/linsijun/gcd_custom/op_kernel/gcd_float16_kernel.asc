/* Generated By CANNBot */

// ============================================================================
// Ascend C Kernel 实现 - Gcd Float16 算子（纯 kernel，不含 host 代码）
// ============================================================================
//
// 功能: 对两个 float16 输入逐元素求最大公约数 (GCD)
//       for each i: out[i] = gcd(self[i], other[i])
//
// 算法: 向量化固定迭代欧几里得算法
//   gcd(a, b):
//     1. a = abs(a), b = abs(b)
//     2. 确保 a >= b
//     3. 重复 MAX_ITER 次:
//        remainder = a % b  (对 float16 用 a - b * floor(a/b))
//        a, b = b, remainder
//        确保 a >= b
//     4. 输出 a
//
// 输入:
//   self:  float16 输入张量 (已在 host 端 broadcast-expand)
//   other: float16 输入张量 (已在 host 端 broadcast-expand)
// 输出:
//   out:   float16 输出张量 (broadcast 后形状)
// ============================================================================

#include "kernel_operator.h"
#include "gcd_float16_tiling.h"

using half = AscendC::half;

// Kernel 类 - 封装 NPU 上的计算逻辑
class KernelGcdFloat16 {
public:
    __aicore__ inline KernelGcdFloat16(AscendC::TPipe* pipe)
    {
        pipe_ = pipe;
    };

    __aicore__ inline void Init(GM_ADDR self, GM_ADDR other, GM_ADDR out,
                                const __gm__ GcdFloat16TilingData* tiling)
    {
        this->tiling = tiling;
        uint32_t blockIdx = AscendC::GetBlockIdx();
        if (blockIdx < tiling->blockNum - 1) {
            total = tiling->numPerCore;
            tileNum = total / TILE_LENGTH;
            tailTileElementNum = TILE_LENGTH;
        } else {
            total = tiling->tailNumLastCore;
            tileNum = (total + (TILE_LENGTH - 1)) / TILE_LENGTH;
            tailTileElementNum = total - TILE_LENGTH * (tileNum - 1);
        }

        // Global Tensor: 2输入1输出
        selfGm.SetGlobalBuffer((__gm__ half*)self + blockIdx * tiling->numPerCore, total);
        otherGm.SetGlobalBuffer((__gm__ half*)other + blockIdx * tiling->numPerCore, total);
        outGm.SetGlobalBuffer((__gm__ half*)out + blockIdx * tiling->numPerCore, total);

        // UB Buffer: float16 双缓冲
        pipe_->InitBuffer(inQueueSelf, DOUBLE_BUFFER, TILE_LENGTH * sizeof(half));
        pipe_->InitBuffer(inQueueOther, DOUBLE_BUFFER, TILE_LENGTH * sizeof(half));
        pipe_->InitBuffer(outQueue, DOUBLE_BUFFER, TILE_LENGTH * sizeof(half));
        // 临时工作 Buffer
        pipe_->InitBuffer(tmpBuf, TILE_LENGTH * sizeof(half));
        pipe_->InitBuffer(maskBuf, TILE_LENGTH * sizeof(uint8_t));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < tileNum; i++) {
            uint32_t count = (i == tileNum - 1) ? tailTileElementNum : TILE_LENGTH;
            CopyIn(count);
            Compute(count);
            CopyOut(count);
        }
    }

    __aicore__ inline void CopyIn(uint32_t count)
    {
        AscendC::LocalTensor<half> selfLocal = inQueueSelf.AllocTensor<half>();
        AscendC::LocalTensor<half> otherLocal = inQueueOther.AllocTensor<half>();

        AscendC::DataCopyPad(selfLocal, selfGm,
            {1, static_cast<uint16_t>(count * sizeof(half)), 0, 0},
            {false, 0, 0, 0});
        AscendC::DataCopyPad(otherLocal, otherGm,
            {1, static_cast<uint16_t>(count * sizeof(half)), 0, 0},
            {false, 0, 0, 0});

        inQueueSelf.EnQue(selfLocal);
        inQueueOther.EnQue(otherLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        AscendC::LocalTensor<half> selfLocal = inQueueSelf.DeQue<half>();
        AscendC::LocalTensor<half> otherLocal = inQueueOther.DeQue<half>();
        AscendC::LocalTensor<half> outLocal = outQueue.AllocTensor<half>();

        // ---- Step 1: 取绝对值 ----
        AscendC::Abs(selfLocal, selfLocal, count);
        AscendC::Abs(otherLocal, otherLocal, count);

        // ---- Step 2: 确保 a >= b (per element) ----
        // a = max(self, other), b = min(self, other)
        AscendC::LocalTensor<half> aLocal = outLocal;     // 复用 out buffer
        AscendC::LocalTensor<half> bLocal = selfLocal;    // 复用 self buffer
        AscendC::LocalTensor<half> tmpLocal = tmpBuf.Get<half>();    // 临时工作区
        AscendC::LocalTensor<uint8_t> maskLocal = maskBuf.Get<uint8_t>();

        AscendC::Max(aLocal, selfLocal, otherLocal, count);
        AscendC::Min(bLocal, selfLocal, otherLocal, count);

        // ---- Step 3: 固定迭代欧几里得算法 ----
        AscendC::LocalTensor<half> bPrevLocal = otherLocal;  // 复用 other buffer 存 bPrev
        AscendC::LocalTensor<half> remainderLocal = tmpLocal; // 同一块 buffer 复用

        for (uint32_t iter = 0; iter < GCD_MAX_ITER; iter++) {
            // 保存当前 b 到 bPrev (用于后续判断是否 b==0)
            AscendC::Copy(bPrevLocal, bLocal, count);

            // quotient = floor(a / b)
            AscendC::Div(tmpLocal, aLocal, bLocal, count);        // tmp = a / b
            AscendC::Floor(tmpLocal, tmpLocal, count);            // tmp = floor(a/b)

            // remainder = a - b * quotient
            AscendC::Mul(remainderLocal, bLocal, tmpLocal, count); // remainder = b * quotient
            AscendC::Sub(remainderLocal, aLocal, remainderLocal, count); // remainder = a - that

            // 创建 mask: bPrev != 0 的位置才更新
            // 对于 bPrev == 0 的位置, remainder 保持为 a (已收敛, gcd=a)
            AscendC::Compare(maskLocal, bPrevLocal, zeroLocal, AscendC::CMPMODE::NE, count);
            AscendC::Sel(remainderLocal, maskLocal, remainderLocal, aLocal, count);

            // 交换并确保 a >= b: new pair = (bPrev, remainder)
            // a = max(bPrev, remainder), b = min(bPrev, remainder)
            AscendC::Max(aLocal, bPrevLocal, remainderLocal, count);
            AscendC::Min(bLocal, bPrevLocal, remainderLocal, count);
        }

        // Step 4: 结果在 aLocal (= outLocal) 中
        // (当 a=0 输出 0, 当 b=0 输出 gcd=a 已在算法中保持)

        inQueueSelf.FreeTensor(selfLocal);
        inQueueOther.FreeTensor(otherLocal);
        outQueue.EnQue<half>(outLocal);
    }

    __aicore__ inline void CopyOut(uint32_t count)
    {
        AscendC::LocalTensor<half> outLocal = outQueue.DeQue<half>();
        AscendC::DataCopyPad(outGm, outLocal,
            {1, static_cast<uint16_t>(count * sizeof(half)), 0, 0});
        outQueue.FreeTensor(outLocal);
    }

private:
    AscendC::TPipe* pipe_;
    const __gm__ GcdFloat16TilingData* tiling;

    AscendC::GlobalTensor<half> selfGm;
    AscendC::GlobalTensor<half> otherGm;
    AscendC::GlobalTensor<half> outGm;

    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueSelf, inQueueOther;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueue;

    AscendC::LocalTensor<half> zeroLocal;  // 全零向量
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmpBuf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> maskBuf;

    uint32_t total;
    uint32_t tileNum;
    uint32_t tailTileElementNum;
};

// 核函数入口
// Host 端已将 self/other 扩展为 broadcast 后的相同 shape
extern "C" __global__ __vector__ void gcd_float16_kernel(GM_ADDR self, GM_ADDR other, GM_ADDR out, GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    KernelGcdFloat16 op(&pipe);
    op.Init(self, other, out, (__gm__ GcdFloat16TilingData*)tiling);
    op.Process();
}
