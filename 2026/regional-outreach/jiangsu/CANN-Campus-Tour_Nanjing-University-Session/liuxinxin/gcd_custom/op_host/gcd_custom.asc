// ============================================================================
// Ascend C Kernel 直调 - Gcd 算子 Host + Main 入口
// ============================================================================
//
// 支持 4D broadcast:
//   ./gcd_custom <self_N4> <self_N3> <self_N2> <self_N1>
//                 <other_N4> <other_N3> <other_N2> <other_N1>
//   ./gcd_custom 2 4 8 16 2 4 8 16   ← 同 shape
//   ./gcd_custom 1 4 8 16 2 4 8 16   ← self 在第0维 broadcast
//   ./gcd_custom 2 1 8 16 2 4 8 1    ← 双 broadcast
//   ./gcd_custom 1 1 1 1  2 4 8 16   ← self 全 broadcast
// ============================================================================

#include <cstdint>
#include <iostream>
#include <vector>
#include <cstdlib>
#include <cstring>
#include "acl/acl.h"
#include "../op_kernel/gcd_custom_tiling.h"
#include "data_utils.h"

#include "../op_kernel/gcd_custom_kernel.asc"

struct ArgInfo { std::string fileName; size_t length; };
struct Shape4D { int64_t d[4]; };

// 4D broadcast: 将 src 展开到 dstShape
void BroadcastExpand(const half* src, const Shape4D& srcShape,
                     half* dst, const Shape4D& dstShape)
{
    int64_t total = dstShape.d[0] * dstShape.d[1] * dstShape.d[2] * dstShape.d[3];
    int64_t stride3 = 1;
    int64_t stride2 = dstShape.d[3];
    int64_t stride1 = dstShape.d[2] * stride2;
    int64_t stride0 = dstShape.d[1] * stride1;

    for (int64_t i0 = 0; i0 < dstShape.d[0]; i0++) {
        int64_t s0 = (srcShape.d[0] == 1) ? 0 : i0;
        for (int64_t i1 = 0; i1 < dstShape.d[1]; i1++) {
            int64_t s1 = (srcShape.d[1] == 1) ? 0 : i1;
            for (int64_t i2 = 0; i2 < dstShape.d[2]; i2++) {
                int64_t s2 = (srcShape.d[2] == 1) ? 0 : i2;
                for (int64_t i3 = 0; i3 < dstShape.d[3]; i3++) {
                    int64_t s3 = (srcShape.d[3] == 1) ? 0 : i3;
                    int64_t srcIdx = ((s0 * srcShape.d[1] + s1) * srcShape.d[2] + s2) * srcShape.d[3] + s3;
                    int64_t dstIdx = (i0 * stride0 + i1 * stride1 + i2 * stride2 + i3 * stride3);
                    dst[dstIdx] = src[srcIdx];
                }
            }
        }
    }
}

// 计算 broadcast 后的输出 shape
Shape4D BroadcastShape(const Shape4D& a, const Shape4D& b)
{
    Shape4D result;
    for (int i = 0; i < 4; i++) {
        int64_t dimA = a.d[i];
        int64_t dimB = b.d[i];
        if (dimA != dimB && dimA != 1 && dimB != 1) {
            printf("ERROR: Incompatible shapes for broadcast at dim %d: %ld vs %ld\n",
                   i, dimA, dimB);
            exit(1);
        }
        result.d[i] = (dimA > dimB) ? dimA : dimB;
    }
    return result;
}

void KernelCall(uint32_t blockNum, aclrtStream stream,
    std::vector<ArgInfo> &inputsInfo, std::vector<ArgInfo> &outputsInfo,
    uint8_t *tilingData)
{
    std::vector<uint8_t *> inputHost(inputsInfo.size());
    std::vector<uint8_t *> inputDevice(inputsInfo.size());
    std::vector<uint8_t *> outputHost(outputsInfo.size());
    std::vector<uint8_t *> outputDevice(outputsInfo.size());
    uint8_t *tilingDevice = nullptr;

    aclrtMalloc((void **)&tilingDevice, sizeof(GcdTilingData), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(tilingDevice, sizeof(GcdTilingData), tilingData,
        sizeof(GcdTilingData), ACL_MEMCPY_HOST_TO_DEVICE);

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtMallocHost((void **)&inputHost[i], inputsInfo[i].length);
        aclrtMalloc((void **)&inputDevice[i], inputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile(inputsInfo[i].fileName, inputsInfo[i].length, inputHost[i], inputsInfo[i].length);
        aclrtMemcpy(inputDevice[i], inputsInfo[i].length, inputHost[i],
            inputsInfo[i].length, ACL_MEMCPY_HOST_TO_DEVICE);
    }

    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMallocHost((void **)&outputHost[i], outputsInfo[i].length);
        aclrtMalloc((void **)&outputDevice[i], outputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
    }

    // Gcd kernel: 2 个输入 (self, other) + 1 个输出 (out)
    gcd_custom_kernel<<<blockNum, nullptr, stream>>>(
        inputDevice[0], inputDevice[1],
        outputDevice[0], tilingDevice);
    aclrtSynchronizeStream(stream);

    aclrtFree(tilingDevice);
    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMemcpy(outputHost[i], outputsInfo[i].length, outputDevice[i],
            outputsInfo[i].length, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile(outputsInfo[i].fileName, outputHost[i], outputsInfo[i].length);
        aclrtFree(outputDevice[i]);
        aclrtFreeHost(outputHost[i]);
    }

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtFree(inputDevice[i]);
        aclrtFreeHost(inputHost[i]);
    }
}

int32_t main(int32_t argc, char *argv[])
{
    if (argc < 9) {
        printf("Usage: %s <self_N4> <self_N3> <self_N2> <self_N1> "
               "<other_N4> <other_N3> <other_N2> <other_N1>\n", argv[0]);
        printf("Example: %s 2 4 8 16 2 4 8 16\n", argv[0]);
        printf("         %s 1 4 1 16 2 4 8 16\n", argv[0]);
        return 1;
    }

    Shape4D selfShape  = {std::atoll(argv[1]), std::atoll(argv[2]),
                          std::atoll(argv[3]), std::atoll(argv[4])};
    Shape4D otherShape = {std::atoll(argv[5]), std::atoll(argv[6]),
                          std::atoll(argv[7]), std::atoll(argv[8])};

    // 计算 broadcast 后输出 shape
    Shape4D outShape = BroadcastShape(selfShape, otherShape);
    uint64_t totalLength = outShape.d[0] * outShape.d[1] * outShape.d[2] * outShape.d[3];

    printf("Self shape:  [%ld,%ld,%ld,%ld]\n",  selfShape.d[0],  selfShape.d[1],  selfShape.d[2],  selfShape.d[3]);
    printf("Other shape: [%ld,%ld,%ld,%ld]\n", otherShape.d[0], otherShape.d[1], otherShape.d[2], otherShape.d[3]);
    printf("Out shape:   [%ld,%ld,%ld,%ld] (total=%lu)\n", outShape.d[0], outShape.d[1], outShape.d[2], outShape.d[3], totalLength);

    aclInit(nullptr);
    int32_t deviceId = 0;
    auto ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) { printf("aclrtSetDevice failed, ret=%d\n", ret); return ret; }

    int64_t availableCoreNum = 0;
    ret = aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum);
    if (ret != ACL_SUCCESS) { printf("aclrtGetDeviceInfo failed\n"); aclrtResetDevice(deviceId); return ret; }

    size_t selfByteSize  = selfShape.d[0] * selfShape.d[1] * selfShape.d[2] * selfShape.d[3] * sizeof(half);
    size_t otherByteSize = otherShape.d[0] * otherShape.d[1] * otherShape.d[2] * otherShape.d[3] * sizeof(half);
    size_t outByteSize   = totalLength * sizeof(half);

    // 读取原始输入
    half* selfHost = (half*)malloc(selfByteSize);
    half* otherHost = (half*)malloc(otherByteSize);
    ReadFile("./input/input_self.bin", selfByteSize, selfHost, selfByteSize);
    ReadFile("./input/input_other.bin", otherByteSize, otherHost, otherByteSize);

    // Broadcast 展开
    half* selfExpanded = (half*)malloc(outByteSize);
    half* otherExpanded = (half*)malloc(outByteSize);
    BroadcastExpand(selfHost, selfShape, selfExpanded, outShape);
    BroadcastExpand(otherHost, otherShape, otherExpanded, outShape);

    // 写回展开后的输入文件（供精度验证使用）
    WriteFile("./input/input_self_expanded.bin", selfExpanded, outByteSize);
    WriteFile("./input/input_other_expanded.bin", otherExpanded, outByteSize);

    // Tiling 计算
    GcdTilingData tiling;
    tiling.totalLength = totalLength;
    uint64_t totalTiles = (totalLength + TILE_LENGTH - 1) / TILE_LENGTH;
    uint64_t tilesPerCore = (totalTiles + availableCoreNum - 1) / availableCoreNum;
    uint32_t blockNum = tiling.blockNum = (totalTiles + tilesPerCore - 1) / tilesPerCore;
    tiling.numPerCore = tilesPerCore * TILE_LENGTH;
    tiling.tailNumLastCore = totalLength - tiling.numPerCore * (blockNum - 1);

    printf("Tiling: blockNum=%u, numPerCore=%lu, tailNumLastCore=%lu\n",
           blockNum, tiling.numPerCore, tiling.tailNumLastCore);

    // 将 broadcast 展开后的数据作为 kernel 输入
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    // 手动管理 device 内存（不使用 KernelCall 的 ReadFile 路径）
    uint8_t *selfDevice = nullptr, *otherDevice = nullptr;
    uint8_t *outDevice = nullptr, *tilingDevice = nullptr;
    aclrtMalloc((void**)&selfDevice, outByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&otherDevice, outByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&outDevice, outByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&tilingDevice, sizeof(GcdTilingData), ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(selfDevice, outByteSize, selfExpanded, outByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(otherDevice, outByteSize, otherExpanded, outByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(tilingDevice, sizeof(GcdTilingData), &tiling, sizeof(GcdTilingData), ACL_MEMCPY_HOST_TO_DEVICE);

    gcd_custom_kernel<<<blockNum, nullptr, stream>>>(
        selfDevice, otherDevice, outDevice, tilingDevice);
    aclrtSynchronizeStream(stream);

    half* outHost = (half*)malloc(outByteSize);
    aclrtMemcpy(outHost, outByteSize, outDevice, outByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outHost, outByteSize);

    aclrtFree(selfDevice); aclrtFree(otherDevice); aclrtFree(outDevice); aclrtFree(tilingDevice);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    free(selfHost); free(otherHost); free(selfExpanded); free(otherExpanded); free(outHost);

    printf("Done. Output written to output/output.bin\n");
    return 0;
}
