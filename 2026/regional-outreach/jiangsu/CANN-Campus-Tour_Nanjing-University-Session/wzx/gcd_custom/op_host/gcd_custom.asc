// ============================================================================
// Ascend C Kernel 直调样例 - GCD 算子（最大公约数）
// 功能：计算两个 float16 张量的逐元素最大公约数
// 支持 4D 形状的 broadcast 语义
// ============================================================================
//
// 文件结构说明：
//   op_kernel/gcd_custom_tiling.h   - Tiling 常量 + 结构体（纯 C/C++，kernel 和 host 共用）
//   op_kernel/gcd_custom_kernel.asc - Kernel 实现（KernelGcd 类 + gcd_custom_kernel 核函数入口）
//   op_host/gcd_custom.asc          - 本文件：Host 端代码 + main 入口
// ============================================================================

#include <cstdint>
#include <iostream>
#include <vector>
#include <cstring>
#include "acl/acl.h"
#include "../op_kernel/gcd_custom_tiling.h"
#include "data_utils.h"

// 引用拆出的纯 kernel 文件（包含 kernel_operator.h）
#include "../op_kernel/gcd_custom_kernel.asc"

// ============================================================================
// Host 端代码 - 运行在 CPU 上
// ============================================================================

struct ArgInfo {
    std::string fileName;
    size_t length;
};

// 计算 broadcast 后的形状（NumPy 风格）
// shape1, shape2 均为 4 维，返回值 broadcast_shape 也为 4 维
void ComputeBroadcastShape(const int64_t shape1[4], const int64_t shape2[4],
                           int64_t broadcastShape[4], int64_t &totalElements)
{
    totalElements = 1;
    for (int i = 0; i < 4; i++) {
        if (shape1[i] != shape2[i] && shape1[i] != 1 && shape2[i] != 1) {
            printf("ERROR: shapes are not broadcastable at dim %d: %ld vs %ld\n",
                   i, shape1[i], shape2[i]);
            exit(1);
        }
        broadcastShape[i] = (shape1[i] > shape2[i]) ? shape1[i] : shape2[i];
        totalElements *= broadcastShape[i];
    }
}

// 将输入按照 broadcast 规则展开到输出缓冲区
// input: 原始输入数据（flat 按行优先）
// inputShape: 原始形状 [4 维]
// broadcastShape: 目标 broadcast 形状 [4 维]
// output: 展开后的输出缓冲区（已分配）
void ExpandForBroadcast(const half *input, const int64_t inputShape[4],
                        const int64_t broadcastShape[4], half *output)
{
    // 计算各维度的 stride（行优先：dim0 is the outermost = N4, dim3 is the innermost = N1）
    int64_t inputStrides[4];
    int64_t outputStrides[4];
    inputStrides[3] = 1;
    outputStrides[3] = 1;
    for (int i = 2; i >= 0; i--) {
        inputStrides[i] = inputStrides[i + 1] * inputShape[i + 1];
        outputStrides[i] = outputStrides[i + 1] * broadcastShape[i + 1];
    }

    // 遍历所有输出位置，从 input 中取数（取模对应 broadcast 语义）
    for (int64_t i0 = 0; i0 < broadcastShape[0]; i0++) {
        for (int64_t i1 = 0; i1 < broadcastShape[1]; i1++) {
            for (int64_t i2 = 0; i2 < broadcastShape[2]; i2++) {
                for (int64_t i3 = 0; i3 < broadcastShape[3]; i3++) {
                    int64_t outIdx = i0 * outputStrides[0] + i1 * outputStrides[1]
                                   + i2 * outputStrides[2] + i3;
                    int64_t inIdx = (i0 % inputShape[0]) * inputStrides[0]
                                  + (i1 % inputShape[1]) * inputStrides[1]
                                  + (i2 % inputShape[2]) * inputStrides[2]
                                  + (i3 % inputShape[3]);
                    output[outIdx] = input[inIdx];
                }
            }
        }
    }
}

// KernelCall 封装 - 处理完整的核函数调用流程
void KernelCall(uint32_t blockNum, aclrtStream stream,
    std::vector<ArgInfo> &inputsInfo, std::vector<ArgInfo> &outputsInfo,
    uint8_t *tilingData)
{
    std::vector<uint8_t *> inputHost(inputsInfo.size());
    std::vector<uint8_t *> inputDevice(inputsInfo.size());
    std::vector<uint8_t *> outputHost(outputsInfo.size());
    std::vector<uint8_t *> outputDevice(outputsInfo.size());
    uint8_t *tilingDevice = nullptr;

    aclrtMalloc((void **)&tilingDevice, sizeof(GcdTilingData), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(tilingDevice, sizeof(GcdTilingData), tilingData,
        sizeof(GcdTilingData), ACL_MEMCPY_HOST_TO_DEVICE);

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtMallocHost((void **)&inputHost[i], inputsInfo[i].length);
        aclrtMalloc((void **)&inputDevice[i], inputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile(inputsInfo[i].fileName, inputsInfo[i].length, inputHost[i], inputsInfo[i].length);
        aclrtMemcpy(inputDevice[i], inputsInfo[i].length, inputHost[i],
            inputsInfo[i].length, ACL_MEMCPY_HOST_TO_DEVICE);
    }

    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMallocHost((void **)&outputHost[i], outputsInfo[i].length);
        aclrtMalloc((void **)&outputDevice[i], outputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
    }

    // 调用 kernel 入口
    // gcd_custom_kernel 签名: (GM_ADDR self, GM_ADDR other, GM_ADDR out, GM_ADDR tiling)
    gcd_custom_kernel<<<blockNum, nullptr, stream>>>(
        inputDevice[0],
        inputDevice[1],
        outputDevice[0],
        tilingDevice);
    aclrtSynchronizeStream(stream);

    aclrtFree(tilingDevice);
    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMemcpy(outputHost[i], outputsInfo[i].length, outputDevice[i],
            outputsInfo[i].length, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile(outputsInfo[i].fileName, outputHost[i], outputsInfo[i].length);
        aclrtFree(outputDevice[i]);
        aclrtFreeHost(outputHost[i]);
    }

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtFree(inputDevice[i]);
        aclrtFreeHost(inputHost[i]);
    }
}

// ACL 标准初始化流程
int32_t main(int32_t argc, char *argv[])
{
    aclInit(nullptr);
    int32_t deviceId = 0;
    auto ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) {
        printf("aclrtSetDevice failed, ret=%d\n", ret);
        return ret;
    }

    // 获取设备最大核数
    int64_t availableCoreNum = 0;
    ret = aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum);
    if (ret != ACL_SUCCESS) {
        printf("aclrtGetDeviceInfo failed, ret=%d\n", ret);
        aclrtResetDevice(deviceId);
        return ret;
    }

    // =====================================================================
    // 默认 4D 测试形状: [4, 3, 2, 8] 和 [4, 1, 2, 1]
    // self:  [4, 3, 2, 8] = 192 个元素
    // other: [4, 1, 2, 1] =   8 个元素（broadcast 到 [4, 3, 2, 8]）
    // out:   [4, 3, 2, 8] = 192 个元素
    // 用户可通过命令行传入 totalElements，但 broadcast 测试默认使用固定形状
    // =====================================================================
    int64_t selfShape[4] = {4, 3, 2, 8};
    int64_t otherShape[4] = {4, 1, 2, 1};
    int64_t outShape[4];
    int64_t totalLength = 0;

    ComputeBroadcastShape(selfShape, otherShape, outShape, totalLength);
    size_t selfByteSize = selfShape[0] * selfShape[1] * selfShape[2] * selfShape[3] * sizeof(half);
    size_t otherByteSize = otherShape[0] * otherShape[1] * otherShape[2] * otherShape[3] * sizeof(half);
    size_t outByteSize = totalLength * sizeof(half);

    printf("Shapes:\n");
    printf("  self:  [%ld, %ld, %ld, %ld] (%zu elements)\n",
           selfShape[0], selfShape[1], selfShape[2], selfShape[3],
           selfByteSize / sizeof(half));
    printf("  other: [%ld, %ld, %ld, %ld] (%zu elements)\n",
           otherShape[0], otherShape[1], otherShape[2], otherShape[3],
           otherByteSize / sizeof(half));
    printf("  out:   [%ld, %ld, %ld, %ld] (%ld elements)\n",
           outShape[0], outShape[1], outShape[2], outShape[3], totalLength);

    // 设置 Tiling 数据
    GcdTilingData tiling;
    tiling.totalLength = totalLength;
    uint64_t totalTiles = (totalLength + TILE_LENGTH - 1) / TILE_LENGTH;
    uint64_t tilesPerCore = (totalTiles + availableCoreNum - 1) / availableCoreNum;
    uint32_t blockNum = tiling.blockNum = (totalTiles + tilesPerCore - 1) / tilesPerCore;
    tiling.numPerCore = tilesPerCore * TILE_LENGTH;
    tiling.tailNumLastCore = totalLength - tiling.numPerCore * (blockNum - 1);

    // 输入/输出文件
    std::vector<ArgInfo> inputsInfo = {
        {"./input/input_self.bin", outByteSize},    // 已 broadcast 展开
        {"./input/input_other.bin", outByteSize}    // 已 broadcast 展开
    };
    std::vector<ArgInfo> outputsInfo = {
        {"./output/output.bin", outByteSize}
    };

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    KernelCall(blockNum, stream, inputsInfo, outputsInfo, (uint8_t *)&tiling);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
