/* Generated By CANNBot */

// ============================================================================
// Ascend C Kernel 实现 - GCD 算子（求最大公约数）
// 功能：计算两个 float16 张量的逐元素最大公约数
// 输入：self (float16), other (float16)  输出：out (float16)
// 广播语义：self 和 other 满足 broadcast 关系
// ============================================================================

#include "kernel_operator.h"
#include "gcd_custom_tiling.h"

// ============================================================================
// 内部工具函数 - 计算两个 int32 的最大公约数（Euclidean 算法）
// ============================================================================
__aicore__ inline int32_t gcd_int32(int32_t a, int32_t b)
{
    // 取绝对值
    a = (a < 0) ? -a : a;
    b = (b < 0) ? -b : b;

    if (a == 0) return b;
    if (b == 0) return a;

    // Euclidean 算法
    int32_t temp;
    while (b != 0) {
        temp = b;
        b = a % b;
        a = temp;
    }
    return a;
}

// ============================================================================
// 内部工具函数 - 计算两个 half 的最大公约数
// 先将 half 转换为 int32（截断小数部分），计算 GCD 后再转回 half
// ============================================================================
__aicore__ inline half gcd_half(half a, half b)
{
    int32_t ai = static_cast<int32_t>(static_cast<float>(a));
    int32_t bi = static_cast<int32_t>(static_cast<float>(b));
    int32_t result = gcd_int32(ai, bi);
    return static_cast<half>(static_cast<float>(result));
}

// Kernel 类 - 封装 NPU 上的计算逻辑
class KernelGcd {
public:
    __aicore__ inline KernelGcd(AscendC::TPipe* pipe)
    {
        pipe_ = pipe;
    };

    __aicore__ inline void Init(GM_ADDR self, GM_ADDR other, GM_ADDR out,
                                const __gm__ GcdTilingData* tiling)
    {
        this->tiling = tiling;
        uint32_t blockIdx = AscendC::GetBlockIdx();
        if (blockIdx < tiling->blockNum - 1) {
            total = tiling->numPerCore;
            tileNum = total / TILE_LENGTH;
            tailTileElementNum = TILE_LENGTH;
        } else {
            total = tiling->tailNumLastCore;
            tileNum = (total + (TILE_LENGTH - 1)) / TILE_LENGTH;
            tailTileElementNum = total - TILE_LENGTH * (tileNum - 1);
        }

        // 输入 self 和 other、输出 out 的 Global Tensor（float16）
        selfGm.SetGlobalBuffer((__gm__ half *)self + blockIdx * tiling->numPerCore, total);
        otherGm.SetGlobalBuffer((__gm__ half *)other + blockIdx * tiling->numPerCore, total);
        outGm.SetGlobalBuffer((__gm__ half *)out + blockIdx * tiling->numPerCore, total);

        // UB Buffer：2 个输入 queue（self, other）+ 1 个输出 queue（out）
        pipe_->InitBuffer(inQueueSelf, DOUBLE_BUFFER, TILE_LENGTH * sizeof(half));
        pipe_->InitBuffer(inQueueOther, DOUBLE_BUFFER, TILE_LENGTH * sizeof(half));
        pipe_->InitBuffer(outQueueOut, DOUBLE_BUFFER, TILE_LENGTH * sizeof(half));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < tileNum; i++) {
            uint32_t count = (i == tileNum - 1) ? tailTileElementNum : TILE_LENGTH;
            CopyIn(count);
            Compute(count);
            CopyOut(count);
        }
    }

    __aicore__ inline void CopyIn(uint32_t count)
    {
        // 搬运 self 数据
        AscendC::LocalTensor<half> selfLocal = inQueueSelf.AllocTensor<half>();
        AscendC::DataCopyPad(selfLocal, selfGm,
            {1, static_cast<uint16_t>(count * sizeof(half)), 0, 0},
            {false, 0, 0, 0});
        inQueueSelf.EnQue(selfLocal);

        // 搬运 other 数据
        AscendC::LocalTensor<half> otherLocal = inQueueOther.AllocTensor<half>();
        AscendC::DataCopyPad(otherLocal, otherGm,
            {1, static_cast<uint16_t>(count * sizeof(half)), 0, 0},
            {false, 0, 0, 0});
        inQueueOther.EnQue(otherLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        AscendC::LocalTensor<half> selfLocal = inQueueSelf.DeQue<half>();
        AscendC::LocalTensor<half> otherLocal = inQueueOther.DeQue<half>();
        AscendC::LocalTensor<half> outLocal = outQueueOut.AllocTensor<half>();

        // 逐元素计算 GCD：out[i] = gcd(self[i], other[i])
        for (uint32_t i = 0; i < count; i++) {
            outLocal.SetValue(i, gcd_half(selfLocal.GetValue(i), otherLocal.GetValue(i)));
        }

        outQueueOut.EnQue<half>(outLocal);
        inQueueSelf.FreeTensor(selfLocal);
        inQueueOther.FreeTensor(otherLocal);
    }

    __aicore__ inline void CopyOut(uint32_t count)
    {
        AscendC::LocalTensor<half> outLocal = outQueueOut.DeQue<half>();

        AscendC::DataCopyPad(outGm, outLocal,
            {1, static_cast<uint16_t>(count * sizeof(half)), 0, 0});

        outQueueOut.FreeTensor(outLocal);
    }

private:
    AscendC::TPipe* pipe_;
    const __gm__ GcdTilingData* tiling;

    AscendC::GlobalTensor<half> selfGm;
    AscendC::GlobalTensor<half> otherGm;
    AscendC::GlobalTensor<half> outGm;

    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueSelf;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueOther;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueOut;

    uint32_t total;
    uint32_t tileNum;
    uint32_t tailTileElementNum;
};

// 核函数入口
// 签名: (GM_ADDR self, GM_ADDR other, GM_ADDR out, GM_ADDR tiling)
extern "C" __global__ __vector__ void gcd_custom_kernel(GM_ADDR self, GM_ADDR other,
                                                         GM_ADDR out, GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    KernelGcd op(&pipe);
    op.Init(self, other, out, (__gm__ GcdTilingData*)tiling);
    op.Process();
}
