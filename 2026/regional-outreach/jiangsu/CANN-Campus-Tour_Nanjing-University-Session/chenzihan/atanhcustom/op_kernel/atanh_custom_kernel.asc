/* Generated By CANNBot */

// ============================================================================
// Ascend C Kernel 实现 - Atanh 算子（纯 kernel）
// ============================================================================
//
// 算子说明：对 float16 输入逐元素计算反双曲正切 y = atanh(x)
// 使用 DAV_2201 内置 Atanh() API（自动管理临时缓冲区）
// 支持 4D 任意 shape，Format=ND
// ============================================================================

#include "kernel_operator.h"
#include "atanh_custom_tiling.h"

using namespace AscendC;

// Kernel 类
class KernelAtanh {
public:
    __aicore__ inline KernelAtanh(TPipe* pipe)
    {
        pipe_ = pipe;
    };

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y,
                                const __gm__ AtanhTilingData* tiling)
    {
        this->tiling = tiling;
        uint32_t blockIdx = GetBlockIdx();
        // 处理 tailNumLastCore == numPerCore 的均匀分配场景
        bool isTailBlock = (blockIdx == tiling->blockNum - 1) 
                        && (tiling->tailNumLastCore != tiling->numPerCore);
        if (isTailBlock) {
            total = tiling->tailNumLastCore;
            tileNum = (total + (TILE_LENGTH - 1)) / TILE_LENGTH;
            tailTileElementNum = total - TILE_LENGTH * (tileNum - 1);
        } else {
            total = tiling->numPerCore;
            tileNum = total / TILE_LENGTH;
            tailTileElementNum = TILE_LENGTH;
        }

        // Global Tensor - 指向当前 block 的数据起始位置
        xGm.SetGlobalBuffer((__gm__ half *)x + blockIdx * tiling->numPerCore, total);
        yGm.SetGlobalBuffer((__gm__ half *)y + blockIdx * tiling->numPerCore, total);

        // UB Buffer
        pipe_->InitBuffer(inQueueX, 1, TILE_LENGTH * sizeof(half));
        pipe_->InitBuffer(outQueueY, 1, TILE_LENGTH * sizeof(half));

        // LCM 临时缓冲区（供 Atanh API 重用，避免多 tile 时 PopStackBuffer 耗尽）
        pipe_->InitBuffer(sharedBuf, TILE_LENGTH * sizeof(half) * 3);
    }

    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < tileNum; i++) {
            uint32_t count = (i == tileNum - 1) ? tailTileElementNum : TILE_LENGTH;
            CopyIn(i, count);
            Compute(i, count);
            CopyOut(i, count);
        }
    }

    __aicore__ inline void CopyIn(uint32_t tileIdx, uint32_t count)
    {
        LocalTensor<half> xLocal = inQueueX.AllocTensor<half>();
        // 直接按位置读取 xGm，不依赖 DataCopyPad 自动前进
        for (uint32_t i = 0; i < count; i++) {
            xLocal(i) = xGm(tileIdx * TILE_LENGTH + i);
        }
        inQueueX.EnQue(xLocal);
    }

    __aicore__ inline void Compute(uint32_t tileIdx, uint32_t count)
    {
        LocalTensor<half> xLocal = inQueueX.DeQue<half>();
        LocalTensor<half> yLocal = outQueueY.AllocTensor<half>();
        LocalTensor<uint8_t> tmp = sharedBuf.Get<uint8_t>();

        // 使用 DAV_2201 内置 Atanh API（传入显式共享缓冲区）
        // atanh(x) = 0.5 * ln((1 + x) / (1 - x))
        Atanh(yLocal, xLocal, tmp, count);

        outQueueY.EnQue<half>(yLocal);
        inQueueX.FreeTensor(xLocal);
    }

    __aicore__ inline void CopyOut(uint32_t tileIdx, uint32_t count)
    {
        LocalTensor<half> yLocal = outQueueY.DeQue<half>();
        // 直接按位置写入 yGm
        for (uint32_t i = 0; i < count; i++) {
            yGm(tileIdx * TILE_LENGTH + i) = yLocal(i);
        }
        outQueueY.FreeTensor(yLocal);
    }

private:
    TPipe* pipe_;
    const __gm__ AtanhTilingData* tiling;

    GlobalTensor<half> xGm;
    GlobalTensor<half> yGm;

    TQue<TPosition::VECIN, 1> inQueueX;
    TQue<TPosition::VECOUT, 1> outQueueY;

    // LCM 临时缓冲区（Atanh API 的 sharedTmpBuffer，一次性分配，多 tile 重用）
    TBuf<TPosition::LCM> sharedBuf;

    uint32_t total;
    uint32_t tileNum;
    uint32_t tailTileElementNum;
};

// 核函数入口
extern "C" __global__ __vector__ void atanh_custom_kernel(GM_ADDR x, GM_ADDR y, GM_ADDR tiling)
{
    TPipe pipe;
    KernelAtanh op(&pipe);
    op.Init(x, y, (__gm__ AtanhTilingData*)tiling);
    op.Process();
}
